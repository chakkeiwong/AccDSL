# Python caches
__pycache__/
*.py[cod]

# Local agent and credential directories
/.agents/
/.aws/
/.codex/

# Operating-system download metadata
*:Zone.Identifier
.DS_Store

# Transient LaTeX build files; retain PDFs and recorded review/build logs.
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# Rebuilds and font caches; canonical manuscript PDFs remain under docs/.
/.build/

# Process-local lock; preserve the controller's recorded state and evidence.
/data/accounting-master/runner.lock
