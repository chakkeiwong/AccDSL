          "id": "MA04b",
          "input": {"measure": "M@1", "family": "F@1/V@1", "outcomes": [{"id": "a@1", "region": "A", "rate": "1", "mass": "1/2"}, {"id": "b@1", "region": "B", "rate": "1", "mass": "1/2"}], "projection": "rate"},
          "expected": {"disposition": "EVALUATED", "reason_codes": ["PROJECTION_COLLISION_RETAINED"], "projected_event_probability": "1", "elementary_outcomes_preserved": ["a@1", "b@1"], "next_permissible_operation": "condition_or_update"}
        }
      ]
    },
    {
      "id": "MA05_identity_version_and_purpose",
      "question": "Do family/version and measure-purpose mismatches block silent reuse?",
      "cases": [
        {
          "id": "MA05a",
          "input": {"attached_family": "F@1/V@1", "requested_family": "F@2/V@1", "model": "M@1", "support_change": ["d@1"]},
          "expected": {"disposition": "REQUEST_INVALID", "reason_codes": ["FAMILY_VERSION_MISMATCH", "SUPPORT_CHANGED"], "next_permissible_operation": "align_or_update_measure", "family_effect": "no_reuse"}
        },
        {
          "id": "MA05b",
          "input": {"attached_model": "M@1", "attached_purpose": "scenario", "requested_purpose": "pricing"},
