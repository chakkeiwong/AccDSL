      "question": "Do marginal equality and display projections preserve joint dependence and elementary identity?",
      "cases": [
        {
          "id": "MA04a",
          "input": {"family": "F@1/V@1", "coordinates": ["x", "y"], "marginal_x": {"0": "1/2", "1": "1/2"}, "marginal_y": {"0": "1/2", "1": "1/2"}, "joint": null},
          "expected": {"disposition": "RETAINED_ONLY", "reason_codes": ["JOINT_DEPENDENCE_UNSPECIFIED"], "probability": null, "unresolved_obligations": ["Provide a joint law or preserve all compatible couplings"], "next_permissible_operation": "attach_measure"}
        },
