          "id": "MA03c",
          "input": {"measure": "M@1", "family": "F@1/V@1", "event_id": "A@1", "selector": ["a@1", "b@1"], "same_description_as": "A@1"},
          "expected": {"disposition": "EVALUATED", "reason_codes": ["IDEMPOTENT_EVENT_REFERENCE"], "event_probability": "5/6", "next_permissible_operation": "condition_or_update"}
        }
      ]
    },
    {
