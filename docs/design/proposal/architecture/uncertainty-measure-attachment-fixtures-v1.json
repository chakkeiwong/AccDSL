    "default_normalization": "reject non-unit finite laws; never renormalize"
  },
  "support_records": {
    "family@1": {"kind": "history_family", "id": "F@1", "view": "V@1", "coordinates": ["region", "rate"], "support": ["a@1", "b@1", "c@1"]},
    "family@2": {"kind": "history_family", "id": "F@2", "view": "V@1", "coordinates": ["region", "rate"], "support": ["a@1", "b@1", "c@1", "d@1"]},
    "model@finite-1": {"kind": "measure_model", "id": "M@1", "version": 1, "measure_kind": "finite_joint", "purpose": "scenario"},
    "model@pricing-1": {"kind": "measure_model", "id": "M@P", "version": 1, "measure_kind": "finite_joint", "purpose": "pricing"},
    "model@continuous-1": {"kind": "measure_model", "id": "M@C", "version": 1, "measure_kind": "continuous_joint", "purpose": "scenario"},
    "event@A": {"kind": "event", "id": "A@1", "selector": ["a@1", "b@1"], "family": "F@1", "view": "V@1"},
    "event@B": {"kind": "event", "id": "B@1", "selector": ["b@1", "c@1"], "family": "F@1", "view": "V@1"},
    "event@partition": {"kind": "event_partition", "id": "P@1", "cells": ["a@1", "b@1"], "coverage": "missing c@1"},
    "event@projection": {"kind": "projection", "id": "rate_projection@1", "from": ["a@1", "b@1"], "to": ["rate=1"]}
  },
  "groups": [
    {
      "id": "MA01_unweighted_preservation",
      "question": "Can an explicit future domain remain admissible without a probability law?",
