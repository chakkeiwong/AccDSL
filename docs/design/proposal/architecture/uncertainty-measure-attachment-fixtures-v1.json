        }
      ]
    },
    {
      "id": "MA06_continuous_and_mixed_support",
      "question": "Does unsupported continuous evaluation remain explicit rather than fabricated?",
      "cases": [
        {
          "id": "MA06a",
          "input": {"family": "F@1/V@1", "model": "M@C", "measure_kind": "continuous_joint", "domain": {"rate": ["-1/10", "1/10"]}, "density": "k*(1-rate^2)", "event": "rate >= 0", "normalization_proof": null},
          "expected": {"disposition": "UNSUPPORTED", "reason_codes": ["CONTINUOUS_EVALUATOR_UNAVAILABLE", "NORMALIZATION_UNPROVEN"], "probability": null, "preserved_expression": "k*(1-rate^2)", "unresolved_obligations": ["Supply normalization and a validated evaluator"], "next_permissible_operation": "provide_evaluator_or_retain_symbolic"}
        },
        {
          "id": "MA06b",
          "input": {"family": "F@1/V@1", "model": "M@C", "measure_kind": "mixed_joint", "domain": {"atom": ["a@1"], "continuous": ["0", "1"]}, "event": "atom or x>1/2", "density": "unspecified"},
          "expected": {"disposition": "UNSUPPORTED", "reason_codes": ["MIXED_MEASURE_REPRESENTATION_UNSUPPORTED"], "probability": null, "unresolved_obligations": ["Declare atom masses, continuous measure and evaluator separately"], "next_permissible_operation": "specify_mixed_model"}
        }
      ]
