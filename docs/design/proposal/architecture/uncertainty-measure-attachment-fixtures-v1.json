          "id": "MA01a",
          "input": {
            "family_id": "F@1", "family_version": 1, "view_id": "V@1", "view_version": 1,
            "model_id": null, "model_version": null, "measure_kind": null, "purpose": "scenario",
            "coordinates": ["rate_change"], "sample_space": {"kind": "continuous_domain", "domain": ["-1/10", "1/10"]},
            "mass_or_density": null, "dependence": "unspecified", "operation": "attach_measure",
            "provenance": "authored_future_domain@1", "information_cutoff": "2026-03-01T00:00:00Z"
          },
          "expected": {
            "disposition": "RETAINED_ONLY", "reason_codes": ["NO_MEASURE_PROVIDED"],
            "preserved_records": ["authored_future_domain@1"], "probability": null,
            "unresolved_obligations": ["Provide a declared joint measure before probability operations"],
            "next_permissible_operation": "attach_measure", "family_effect": "unchanged"
          }
        },
        {
          "id": "MA01b",
          "input": {
            "family_id": "F@1", "family_version": 1, "view_id": "V@1", "view_version": 1,
            "model_id": null, "model_version": null, "measure_kind": "finite_joint", "purpose": "scenario",
            "coordinates": ["scenario"], "sample_space": {"kind": "finite", "outcomes": ["s1@1", "s2@1", "s3@1"]},
            "mass_or_density": null, "dependence": "unspecified", "operation": "infer_from_branch_count",
            "provenance": "branch_count@1", "information_cutoff": "2026-03-01T00:00:00Z"
          },
          "expected": {
            "disposition": "REQUEST_INVALID", "reason_codes": ["COUNT_IS_NOT_A_MEASURE"],
            "preserved_records": ["branch_count@1"], "probability": null,
            "unresolved_obligations": ["Supply explicit masses or density with provenance"],
            "next_permissible_operation": "revise_request", "family_effect": "unchanged"
          }
        }
      ]
    },
    {
      "id": "MA02_finite_joint_validity",
      "question": "Do finite laws enforce identity, non-negativity and exact unit mass?",
      "law": {"outcomes": ["a@1", "b@1", "c@1"], "masses": {"a@1": "1/2", "b@1": "1/3", "c@1": "1/6"}},
      "cases": [
        {
          "id": "MA02a",
          "input": {"family_id": "F@1", "family_version": 1, "view_id": "V@1", "view_version": 1, "model_id": "M@1", "model_version": 1, "measure_kind": "finite_joint", "purpose": "scenario", "sample_space": ["a@1", "b@1", "c@1"], "masses": {"a@1": "1/2", "b@1": "1/3", "c@1": "1/6"}, "dependencies": ["family@1", "model@finite-1"]},
          "expected": {"disposition": "ATTACHED_ASSUMPTION", "reason_codes": [], "probability_total": "1", "preserved_records": ["family@1", "model@finite-1"], "unresolved_obligations": [], "next_permissible_operation": "evaluate_event", "family_effect": "measure_attached"}
        },
        {
          "id": "MA02b",
          "input": {"family_id": "F@1", "family_version": 1, "view_id": "V@1", "view_version": 1, "model_id": "M@1", "model_version": 1, "measure_kind": "finite_joint", "purpose": "scenario", "sample_space": ["a@1", "b@1", "c@1"], "masses": {"a@1": "1/2", "b@1": "-1/3", "c@1": "5/6"}, "dependencies": ["family@1", "model@finite-1"]},
          "expected": {"disposition": "REQUEST_INVALID", "reason_codes": ["NEGATIVE_MASS"], "preserved_records": ["family@1", "model@finite-1"], "unresolved_obligations": ["Replace negative mass and revalidate total"], "next_permissible_operation": "revise_request", "family_effect": "unchanged"}
        },
        {
          "id": "MA02c",
          "input": {"family_id": "F@1", "family_version": 1, "view_id": "V@1", "view_version": 1, "model_id": "M@1", "model_version": 1, "measure_kind": "finite_joint", "purpose": "scenario", "sample_space": ["a@1", "b@1", "c@1"], "masses": {"a@1": "1/2", "b@1": "1/3", "c@1": "1/3"}, "dependencies": ["family@1", "model@finite-1"]},
          "expected": {"disposition": "REQUEST_INVALID", "reason_codes": ["NON_UNIT_MASS"], "probability_total": "7/6", "preserved_records": ["family@1", "model@finite-1"], "unresolved_obligations": ["Do not renormalize; correct or explain the missing support"], "next_permissible_operation": "revise_request", "family_effect": "unchanged"}
        },
        {
          "id": "MA02d",
          "input": {"family_id": "F@1", "family_version": 1, "view_id": "V@1", "view_version": 1, "model_id": "M@1", "model_version": 1, "measure_kind": "finite_joint", "purpose": "scenario", "sample_space": ["a@1", "a@1", "b@1", "c@1"], "masses": {"a@1": "1/2", "b@1": "1/3", "c@1": "1/6"}, "dependencies": ["family@1", "model@finite-1"]},
          "expected": {"disposition": "REQUEST_INVALID", "reason_codes": ["DUPLICATE_ELEMENTARY_ID"], "preserved_records": ["family@1", "model@finite-1"], "unresolved_obligations": ["Give each elementary outcome one immutable identity"], "next_permissible_operation": "revise_request", "family_effect": "unchanged"}
        }
      ]
    },
    {
      "id": "MA03_overlapping_events",
      "question": "Are overlapping named events evaluated once against one joint law?",
      "law": {"outcomes": ["a@1", "b@1", "c@1"], "masses": {"a@1": "1/2", "b@1": "1/3", "c@1": "1/6"}},
      "cases": [
        {
          "id": "MA03a",
          "input": {"measure": "M@1", "family": "F@1/V@1", "event_a": ["a@1", "b@1"], "event_b": ["b@1", "c@1"]},
          "expected": {"disposition": "EVALUATED", "event_a_probability": "5/6", "event_b_probability": "1/2", "intersection_probability": "1/3", "union_probability": "1", "reason_codes": [], "next_permissible_operation": "condition_or_update"}
        },
        {
          "id": "MA03b",
          "input": {"measure": "M@1", "family": "F@1/V@1", "partition_id": "P@1", "cells": [["a@1"], ["b@1"]], "coverage": "missing c@1", "disjoint": true},
          "expected": {"disposition": "REQUEST_INVALID", "reason_codes": ["PARTITION_COVERAGE_UNPROVEN"], "preserved_records": ["event_partition@1"], "unresolved_obligations": ["Supply coverage of the declared support before treating cells as exhaustive"], "next_permissible_operation": "revise_event", "family_effect": "unchanged"}
