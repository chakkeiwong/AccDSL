{UTF-8}
OE Quarterly Net Income=
	Quarterly Net Income
	~	dollars/quarter
	~	The quarterly net income reported on the owners' equity statement.
	|

OE Net Income=
	IS Net Income
	~	dollars/Year
	~	The value of net income that has flowed into the stock of retained \
		earnings over the reporting period.
	|

Reported Dividends=
	Drained Reported Dividends*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported dividends is calculated based on the size \
		of the outflow from the accumulated reporting stock and the length of the \
		reporting period.
	|

Drained Reported Issuance of Shares=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Issuance of Shares/TIME STEP , \
		0 )
	~	dollars/Year
	~	Once it is time to report share issuance, the entire stock of accumulated \
		reported issuance of shares must be drained in one time step.
	|

Initial Accumulated Reported Dividends=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Accumulated Reported Dividends= INTEG (
	New Reported Dividends-Drained Reported Dividends,
		Initial Accumulated Reported Dividends)
	~	dollars
	~	This stock represents all of the Dividends that have been paid so far this \
		reporting period. It must wait until the end of the period to be reported \
		on the owners' equity statement.
	|

OE Dividends=SAMPLE IF TRUE(
	Check Reporting=0, Reported Dividends , 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

Removal of Reported Paid in Capital=
	IF THEN ELSE( Check Reporting=0, OE Previous Reported Paid in Capital/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is active the entire contents of the previous BS \
		Retained Earnings stock is removed from the chain.
	|

Removal of Reported Retained Earnings=
	IF THEN ELSE( Check Reporting=0, OE Previous Reported Retained Earnings/TIME STEP, 0\
		)
	~	dollars/Year
	~	When the reporting flag is active the entire contents of the previous BS \
		Retained Earnings stock is removed from the chain.
	|

Accumulated Reported Issuance of Shares= INTEG (
	New Reported Issuance of Shares-Drained Reported Issuance of Shares,
		Initial Accumulated Reported Issuance of Shares)
	~	dollars
	~	This stock represents all of the share issuances that have been undertaken \
		so far this reporting period. It must wait until the end of the period to \
		be reported on the owners' equity statement.
	|

OE Quarterly Dividends=SAMPLE IF TRUE(
	Check Reporting=0, Reported Dividends/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

OE Quarterly Issuance of Shares=SAMPLE IF TRUE(
	Check Reporting=0, Reported Issuance of Shares/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

OE Reported Paid in Capital= INTEG (
	Latest Reported Paid in Capital-Aging of Reported Paid in Capital,
		Initial BS Additional Paid In Capital)
	~	dollars
	~	This is the most recently reported level of BS Paid in Capital
	|

OE Reported Retained Earnings= INTEG (
	Latest Reported Retained Earnings-Aging of Reported Retained Earnings,
		Initial BS Retained Earnings)
	~	dollars
	~	This is the most recently reported level of BS Retained Earnings
	|

New Reported Dividends=
	Dividends Paid
	~	dollars/Year
	~	Dividends are reported when they are paid to shareholders.
	|

OE Issuance of Shares=SAMPLE IF TRUE(
	Check Reporting=0, Reported Issuance of Shares , 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

Drained Reported Dividends=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Dividends/TIME STEP , 0 )
	~	dollars/Year
	~	Once it is time to report dividends, the entire stock of accumulated \
		reported dividends must be drained in one time step.
	|

Aging of Reported Paid in Capital=
	IF THEN ELSE( Check Reporting=0, OE Reported Paid in Capital/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is activated the entire contents of the reported \
		BS Retained Earnings stock move down the chain in a single time step.
	|

Aging of Reported Retained Earnings=
	IF THEN ELSE( Check Reporting=0, OE Reported Retained Earnings/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is activated the entire contents of the reported \
		BS Retained Earnings stock move down the chain in a single time step.
	|

Reported Issuance of Shares=
	Drained Reported Issuance of Shares*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported issuance of shares is calculated based on \
		the size of the outflow from the accumulated reporting stock and the \
		length of the reporting period.
	|

New Reported Issuance of Shares=
	Capital Inflow from Share Issuance
	~	dollars/Year
	~	Dividends are reported when they are paid to shareholders.
	|

Latest Reported Paid in Capital=
	IF THEN ELSE( Check Reporting=0, BS Additional Paid In Capital/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag activates the current value of BS Paid in Capital \
		is stored in the stock of reported BS Retained Earnings over a single time \
		step.
	|

Latest Reported Retained Earnings=
	IF THEN ELSE( Check Reporting=0, BS Retained Earnings/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag activates the current value of BS Retained \
		Earnings is stored in the stock of reported BS Retained Earnings over a \
		single time step.
	|

Initial Accumulated Reported Issuance of Shares=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

OE Previous Reported Retained Earnings= INTEG (
	Aging of Reported Retained Earnings-Removal of Reported Retained Earnings,
		Initial BS Retained Earnings)
	~	dollars
	~	This is the level of BS Retained Earnings one reporting period previously
	|

OE Previous Reported Paid in Capital= INTEG (
	Aging of Reported Paid in Capital-Removal of Reported Paid in Capital,
		Initial BS Additional Paid In Capital)
	~	dollars
	~	This is the level of BS Paid in Capital one reporting period previously
	|

Reported BS Net Intangible Assets=SAMPLE IF TRUE(
	Check Reporting=0,BS Net Intangible Assets,0)
	~	dollars
	~	The value of intangibles on the balance sheet is the difference between \
		the historical cost and the total accumulated amortization.
	|

Reported BS Net Plant Property and Equipment=SAMPLE IF TRUE(
	Check Reporting=0,BS Net Plant Property and Equipment,0)
	~	dollars
	~	The value of PPE on the balance sheet is the difference between the \
		historical cost and the total accumulated depreciation.
	|

Reported BS Retained Earnings=SAMPLE IF TRUE(
	Check Reporting=0,BS Retained Earnings,0)
	~	dollars
	~	The stock of retained earnings of the firm is increased by net income and \
		decreased by dividends.
	|

Reported BS Accounts Payable=SAMPLE IF TRUE(
	Check Reporting=0,BS Accounts Payable,0)
	~	dollars
	~	The level of accounts payable on the reporting date.
	|

Reported BS Total Assets=
	Reported BS Total Current Assets+Reported BS Total Long Term Assets
	~	dollars
	~	The sum of all the assets on the balance sheet.
	|

Reported BS Accounts Receivable=SAMPLE IF TRUE(
	Check Reporting=0,BS Accounts Receivable,0)
	~	dollars
	~	The stock of customer accounts receivable.
	|

Reported BS Total Current Liabilities=
	Reported BS Accrued Wages+Reported BS Accounts Payable+Reported BS Short Term Debt
	~	dollars
	~	The sum of the components of current liabilities on the balance sheet.
	|

Reported BS Accrued Wages=SAMPLE IF TRUE(
	Check Reporting=0,BS Accrued Wages,0)
	~	dollars
	~	Wages accrue in this stock until they are paid by the firm.
	|

Reported BS Total Liabilities=
	Reported BS Total Current Liabilities+Reported BS Total Long Term Liabilities
	~	dollars
	~	The sum of all the liabilities on the balance sheet.
	|

Reported BS Accumulated Amortization=SAMPLE IF TRUE(
	Check Reporting=0,BS Accumulated Amortization,0)
	~	dollars
	~	Amortization that accumulates over time must be recorded so that it can be \
		displayed on the balance sheet.
	|

Reported BS Accumulated Depreciation=SAMPLE IF TRUE(
	Check Reporting=0,BS Accumulated Depreciation,0)
	~	dollars
	~	Depreciation that accumulates over time must be recorded so that it can be \
		displayed on the balance sheet.
	|

Reported BS Additional Paid In Capital=SAMPLE IF TRUE(
	Check Reporting=0,BS Additional Paid In Capital,0)
	~	dollars
	~	The total value of the funds that the firm has been paid for issuing its \
		shares.
	|

Reported BS Cash=SAMPLE IF TRUE(
	Check Reporting=0, BS Cash , 0)
	~	dollars
	~	This is the accumulated balance of cash on hand for the firm.
	|

Reported BS Inventory=SAMPLE IF TRUE(
	Check Reporting=0,BS Inventory,0)
	~	dollars
	~	Inventory on the balance sheet is increased by the cost of any materials \
		and labor, and decreased when the goods are shipped.
	|

Reported BS Total Long Term Assets=
	Reported BS Net Plant Property and Equipment+Reported BS Net Intangible Assets
	~	dollars
	~	The sum of the components of long term assets on the balance sheet.
	|

Reported BS Long Term Debt=SAMPLE IF TRUE(
	Check Reporting=0,BS Long Term Debt,0)
	~	dollars
	~	This stock accumulates all of the debt held by the firm that does not need \
		to be fully repaid soon.
	|

Reported Gap Between Assets and Liabilities and Equity=
	Reported BS Total Assets-Reported BS Total Liabilities and Equity
	~	dollars
	~	This should always equal zero in order for the balance sheet identity to \
		hold.
	|

Reported BS Total Liabilities and Equity=
	Reported BS Total Liabilities+Reported BS Total Equity
	~	dollars
	~	The sum of liabilities and equity on the balance sheet is reported in \
		order to test the balance sheet equation, which says that assets must \
		always equal liabilities plus equity.
	|

Reported BS Short Term Debt=SAMPLE IF TRUE(
	Check Reporting=0,BS Short Term Debt,0)
	~	dollars
	~	The balance of debt that will be repaid within a short period of time.
	|

Reported BS Total Current Assets=
	Reported BS Cash+Reported BS Accounts Receivable+Reported BS Inventory
	~	dollars
	~	The sum of the components of current assets on the balance sheet.
	|

Reported BS Total Equity=
	Reported BS Additional Paid In Capital+Reported BS Retained Earnings
	~	dollars
	~	The sum of the components of equity on the balance sheet.
	|

Reported BS Total Long Term Liabilities=
	Reported BS Long Term Debt
	~	dollars
	~	The sum of the components of long term liabilities on the balance sheet.
	|

Quarterly Cost of Goods Sold=SAMPLE IF TRUE(
	Check Reporting=0, Reported Cost of Goods Sold/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

Quarterly Depreciation=SAMPLE IF TRUE(
	Check Reporting=0, Reported Depreciation/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

IS Cost of Goods Sold=SAMPLE IF TRUE(
	Check Reporting=0, Reported Cost of Goods Sold , 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

Quarterly Earnings per Share=
	SAMPLE IF TRUE(Check Reporting=0,Quarterly Net Income/Shares Outstanding,0)
	~	dollars/(quarter*share)
	~	The earnings of the firm per share of stock outstanding is a common \
		measure of the value of a firm's stock.
	|

Dividends Paid=
	IF THEN ELSE(MODULO(Time,Dividend Payment Frequency)<=(Dividend Payment Delay+TIME STEP\
		):AND:MODULO(Time,Dividend Payment Frequency)>=Dividend Payment Delay, Total Dividend Payment
	/TIME STEP, 0)
	~	dollars/Year
	~	Once the dividend payment date occurs all of the declared dividends are \
		paid out of the stock of retained earnings.
	|

Quarterly Interest Expense=SAMPLE IF TRUE(
	Check Reporting=0, Reported Interest Expense/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

Quarterly Marketing Expense=SAMPLE IF TRUE(
	Check Reporting=0, Reported Marketing Expense/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

IS Interest Expense=SAMPLE IF TRUE(
	Check Reporting=0 , Reported Interest Expense, 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

IS Marketing Expense=SAMPLE IF TRUE(
	Check Reporting=0 , Reported Marketing Expense , 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

Quarterly Research and Development Expense=SAMPLE IF TRUE(
	Check Reporting=0, Reported Research and Development Expense/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

Quarterly Revenue=SAMPLE IF TRUE(
	Check Reporting=0, Reported Revenue/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

Quarterly Selling General and Administrative Expense=SAMPLE IF TRUE(
	Check Reporting=0, Reported Selling General and Administrative Expense/Quarters per Year
	, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

Quarterly Tax Expense=SAMPLE IF TRUE(
	Check Reporting=0, Reported Tax Expense/Quarters per Year, 0)
	~	dollars/quarter
	~	The most recent value of the quarterly tax expense.
	|

IS Selling General and Administrative Expense=SAMPLE IF TRUE(
	Check Reporting=0 , Reported Selling General and Administrative Expense , 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

IS Tax Expense=SAMPLE IF TRUE(
	Check Reporting=0 , Reported Tax Expense, 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

Quarterly Amortization=SAMPLE IF TRUE(
	Check Reporting=0, Reported Amortization/Quarters per Year, 0)
	~	dollars/quarter
	~	If the model is set to quarterly reporting then this variable should be \
		used
	|

IS Amortization=SAMPLE IF TRUE(
	Check Reporting=0 , Reported Amortization, 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

Short Term Debt Repayment=
	BS Short Term Debt/Definition of Current
	~	dollars/Year
	~	The cash payment of short term debt is assumed to occur over some average \
		length of time.
	|

IS Depreciation=SAMPLE IF TRUE(
	Check Reporting=0, Reported Depreciation, 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

IS Research and Development Expense=SAMPLE IF TRUE(
	Check Reporting=0 , Reported Research and Development Expense, 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

IS Earnings per Share=SAMPLE IF TRUE(
	Check Reporting=0, IS Net Income/Shares Outstanding, 0)
	~	dollars/Year/share
	~	The earnings of the firm per share of stock outstanding is a common \
		measure of the value of a firm's stock.
	|

IS Revenue=SAMPLE IF TRUE(
	Check Reporting=0 , Reported Revenue , 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

Dividend Payment Frequency=
	1
	~	Years
	~	The length of time between dividend payments.
	|

Quarterly Earnings Before Taxes=
	Quarterly Operating Profit-Quarterly Interest Expense
	~	dollars/quarter
	~	The total earnings before taxes is often used as a simple basis to \
		calculate a corporation's effective tax rate.
	|

Quarterly Gross Profit=
	Quarterly Revenue-Quarterly Cost of Goods Sold
	~	dollars/quarter
	~	The gross profit of an enterprise is a measure of its revenue minus its \
		cost of goods sold.
	|

Quarterly Net Income=
	Quarterly Earnings Before Taxes-Quarterly Tax Expense
	~	dollars/quarter
	~	Net income is the bottom line income number on the income statement and is \
		the most closely watched indicator of corporate performance.  It is \
		calculated as revenue minus all expenses on the income statement.
	|

Quarterly Operating Profit=
	Quarterly Gross Profit-Quarterly Total Operating Expenses
	~	dollars/quarter
	~	The operating profit of an enterprise can be calculated as its revenue \
		minus all of its expenses before interest and taxes, or as its gross \
		profit minus to total operating expenses.
	|

Quarterly Total Operating Expenses=
	Quarterly Marketing Expense+Quarterly Research and Development Expense+Quarterly Selling General and Administrative Expense\
		+Quarterly Depreciation+Quarterly Amortization
	~	dollars/quarter
	~	It is common to total the operating expenses of a business for reporting \
		on the income statement.
	|

Quarters per Year=
	4
	~	quarters/Year
	~	The number of quarters in a year is used to adjust values reported in \
		those two units.
	|

Annual Reporting Switch=
	1
	~	Dmnl [0,1,1]
	~	This switch determines whether the model uses an annual or quarterly \
		reporting period.
	|

Operating Cash Outflows=
	Cash Material Purchases+Payment of Accounts Payable+Wages Paid to Workers+Marketing Expense\
		+Research and Development Expense+Reported Tax Expense
	~	dollars/Year
	~	The cash flow going out of the firm from operating activities is due to \
		the cash payment of the various operating expenses.
	|

Increase in Retained Earnings from Net Income=
	Net Income Flow
	~	dollars/Year
	~	Retained earnings is increased once net income has been reported.
	|

Reported Revenue=
	Drained Reported Revenue*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported revenue is calculated based on the size \
		of the outflow from the accumulated reporting stock and the length of the \
		reporting period.
	|

Reporting Period=
	IF THEN ELSE(Annual Reporting Switch=1, 1, 0.25)
	~	Year
	~	The frequency of the reporting period could be annual or quarterly.
	|

BS Additional Paid In Capital= INTEG (
	Capital Inflow from Share Issuance,
		Initial BS Additional Paid In Capital)
	~	dollars
	~	The total value of the funds that the firm has been paid for issuing its \
		shares.
	|

Gap Between Assets and Liabilities and Equity=
	BS Total Assets-BS Total Liabilities and Equity
	~	dollars
	~	This should always equal zero in order for the balance sheet identity to \
		hold.
	|

Initial Shares Outstanding=
	10000
	~	shares
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The initial number of shares outstanding should be \
		brought into the model.
	|

Average Cost per Inventory Unit=
	BS Inventory/Units in Inventory
	~	dollars/unit
	~	While the vast majority of firms use the first in first out or FIFO method \
		to calculate the value of their inventory, the potentially very large \
		number of coflow stocks needed to track every inventory cost layer is \
		prohibitive and against the spirit of most system dynamics models.  We \
		have chosen to model the average cost method instead, but this decision \
		may be important if the cost of manufacturing inventory changes very \
		rapidly or is very important for your modelling purposes.
	|

BS Total Equity=
	BS Additional Paid In Capital+BS Retained Earnings
	~	dollars
	~	The sum of the components of equity on the balance sheet.
	|

Initial BS Additional Paid In Capital=
	500
	~	dollars
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The initial value for this stock of equity should be \
		brought into the model.
	|

BS Retained Earnings= INTEG (
	Increase in Retained Earnings from Net Income-Dividends Paid,
		Initial BS Retained Earnings)
	~	dollars
	~	The stock of retained earnings of the firm is increased by net income and \
		decreased by dividends.
	|

Cost of Goods Sold=
	Inventory Units Shipped*Average Cost per Inventory Unit
	~	dollars/Year
	~	The cost of goods sold is recorded only once the goods have been shipped \
		to the customer so that this expense can be matched with the revenue it \
		generated.
	|

Dividend per Share=
	Total Dividend Payment/Shares Outstanding
	~	dollars/share
	~	The indicated dividend per share, based on the total cash spent on \
		dividends and the number of shares outstanding.
	|

Share Price=
	20
	~	dollars/share
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The share price of the firm's equity should be \
		determined by the model.
	|

Initial BS Inventory=
	(Cost of Material Purchases+Cost of Labor Used to Create Inventory)*Units in Inventory\
		/Inventory Units Shipped
	~	dollars
	~	This will initialize the stock of the value of inventory in dynamic \
		equilibrium.
	|

Initial BS Retained Earnings=
	Initial BS Cash+Initial BS Accounts Receivable+Initial BS Inventory+Initial BS Net Plant Property and Equipment\
		+Initial BS Net Intangible Assets-Initial BS Accounts Payable-Initial BS Accrued Wages\
		-Initial BS Short Term Debt-Initial BS Long Term Debt-Initial BS Additional Paid In Capital
	~	dollars
	~	The initial value of retained earnings is implied by the balance sheet \
		equation and the intiial vlues of all of the assets, liabilities, and \
		equity on the balance sheet.
	|

Total Dividend Payment=
	50
	~	dollars
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The decision to issue dividends must be determined \
		through some decision rule.
	|

Shares Issued=
	0
	~	shares/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The decision to issue shares must be determined through \
		some decision rule.
	|

Capital Inflow from Share Issuance=
	Share Price*Shares Issued
	~	dollars/Year
	~	The capital raised through the issuance of shares increases a stock of \
		capital in the equity section of the firm's balance sheet.
	|

Units in Inventory=
	500
	~	units
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The number of units in inventory should be calculated \
		somewhere in the model of a business.
	|

Shares Outstanding= INTEG (
	Share Issuance,
		Initial Shares Outstanding)
	~	shares
	~	The number of shares that the firm has issued to the market.
	|

Dividend Payment Delay=
	0.083
	~	Years
	~	The length of time in fractions of a year that indicates when dividends \
		will be paid.
	|

Net Income Flow=
	New Reported Revenue-New Reported Cost of Goods Sold-New Reported Marketing Expense-\
		New Reported Research and Development Expense
	-New Reported Selling General and Administrative Expense-New Reported Depreciation-New Reported Amortization\
		-New Reported Interest Expense-Reported Tax Expense
	~	dollars/Year
	~	The flow of net income into the firm occurs as that value is accumulated, \
		not just when it is reported.
	|

Inventory Consumption=
	Cost of Goods Sold
	~	dollars/Year
	~	The value of inventory on the balance sheet decreases with the cost of \
		goods sold.
	|

Share Issuance=
	Shares Issued
	~	shares/Year
	~	The accumulation of shares outstanding occurs as shares are issued to the \
		public.
	|

CF Investing Cash Flow=SAMPLE IF TRUE(
	Reported Investing Cash Flow <> 0 , Reported Investing Cash Flow , 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

CF Operating Cash Flow=
	Net Income Adjusted for Non Cash Expenses+Cash Flow from Changes to Balance Sheet Items
	~	dollars/Year
	~	This is the reported cash flow from operations using the indirect method.
	|

CF Total Cash Flow=
	CF Operating Cash Flow+CF Investing Cash Flow+CF Financing Cash Flow
	~	dollars/Year
	~	The sum of each of the three reported cash flow categories.
	|

Accumulated Reported Financing Cash Flow= INTEG (
	New Reported Financing Cash Flow-Drained Reported Financing Cash Flow,
		Initial Accumulated Reported Financing Cash Flow)
	~	dollars
	~	This stock represents all of the Financing Cash Flows that have occurred \
		so far this reporting period. It must wait until the end of the period to \
		be reported on the indirect cash flow statement.
	|

Change in BS Accounts Receivable=
	Reported BS Accounts Receivable for CF-Previous BS Accounts Receivable for CF
	~	dollars
	~	This is the change in total BS Accounts Receivable over the most recent \
		reporting period.
	|

Accumulated Reported Investing Cash Flow= INTEG (
	New Reported Investing Cash Flow-Drained Reported Investing Cash Flow,
		Initial Accumulated Reported Investing Cash Flow)
	~	dollars
	~	This stock represents all of the Investing Cash Flows that have occurred \
		so far this reporting period. It must wait until the end of the period to \
		be reported on the indirect cash flow statement.
	|

Change in BS Inventory=
	Reported BS Inventory for CF-Previous BS Inventory for CF
	~	dollars
	~	This is the change in total BS Inventory over the most recent reporting \
		period.
	|

Drained Reported Marketing Expense=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Marketing Expense/TIME STEP , 0\
		 )
	~	dollars/Year
	~	Once it is time to report Marketing Expense, the entire stock of \
		accumulated reported Marketing Expense must be drained in one time step.
	|

Collections from Customers=
	BS Accounts Receivable/Average Receivable Collection Time
	~	dollars/Year
	~	Customers pay for their orders with a delay indicated by the average \
		collection time.
	|

Initial BS Cash=
	Operating Cash Outflows*Target for Months of Operating Cash Outflows on Hand/Months per Year
	~	dollars
	~	The stock of cash is initialized so that it is at whatever target the firm \
		establishes.
	|

Aging of Reported BS Accounts Payable=
	IF THEN ELSE( Check Reporting=0, Reported BS Accounts Payable for CF/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is activated the entire contents of the reported \
		BS Accounts Payable stock move down the chain in a single time step.
	|

Aging of Reported BS Accounts Receivable=
	IF THEN ELSE( Check Reporting=0, Reported BS Accounts Receivable for CF/TIME STEP, 0\
		)
	~	dollars/Year
	~	When the reporting flag is activated the entire contents of the reported \
		BS Accounts Receivable stock move down the chain in a single time step.
	|

Aging of Reported BS Accrued Wages=
	IF THEN ELSE( Check Reporting=0, Reported BS Accrued Wages for CF/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is activated the entire contents of the reported \
		BS Accrued Wages stock move down the chain in a single time step.
	|

Aging of Reported BS Inventory=
	IF THEN ELSE( Check Reporting=0, Reported BS Inventory for CF/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is activated the entire contents of the reported \
		BS Inventory stock move down the chain in a single time step.
	|

Removal of Reported BS Accounts Payable=
	IF THEN ELSE( Check Reporting=0, Previous BS Accounts Payable for CF/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is active the entire contents of the previous BS \
		Accounts Payable stock is removed from the chain.
	|

Operating Cash Inflows=
	Cash Sales+Collections from Customers
	~	dollars/Year
	~	The cash flow coming into the firm from operating activities is primarily \
		caused by sales to customers.
	|

Total Cash Flow=
	Total Operating Cash Flow+Total Investing Cash Flow+Total Financing Cash Flow
	~	dollars/Year
	~	This variable is the total cash flow using the direct method.
	|

Average Receivable Collection Time=
	Days of Credit Terms Offered to Customers/Days per Year
	~	Years
	~	The length of time in years that customers are given to pay for their \
		orders.
	|

Reported BS Accounts Payable for CF= INTEG (
	Latest Reported BS Accounts Payable-Aging of Reported BS Accounts Payable,
		Initial BS Accounts Payable)
	~	dollars
	~	This is the most recently reported level of BS Accounts Payable
	|

Reported BS Accounts Receivable for CF= INTEG (
	Latest Reported BS Accounts Receivable-Aging of Reported BS Accounts Receivable,
		Initial BS Accounts Receivable)
	~	dollars
	~	This is the most recently reported level of BS Accounts Receivable
	|

Reported BS Accrued Wages for CF= INTEG (
	Latest Reported BS Accrued Wages-Aging of Reported BS Accrued Wages,
		Initial BS Accrued Wages)
	~	dollars
	~	This is the most recently reported level of BS Accrued Wages
	|

Inventory Creation=
	Cost of Labor Used to Create Inventory+Cost of Material Purchases
	~	dollars/Year
	~	Inventory on the balance sheet is valued at its cost to manufacture, which \
		comes from both the cost of labor and the cost of materials.
	|

BS Accounts Receivable= INTEG (
	Sales on Credit-Collections from Customers,
		Initial BS Accounts Receivable)
	~	dollars
	~	The stock of customer accounts receivable.
	|

Cash Material Purchases=
	Cost of Material Purchases*Fraction of Material Purchases Paid in Cash
	~	dollars/Year
	~	The amount of cash spent to purchase materials.
	|

Investing Cash Inflows=
	0
	~	dollars/Year
	~	The cash flow coming into the firm from investing activities is caused by \
		sales of PPE or intangible assets as well as investments in financial \
		instruments. None of those flows are instituted in this model.
	|

Investing Cash Outflows=
	Amount Spent on Intangible Assets+Amount Spent on Long Term Assets
	~	dollars/Year
	~	The cash flow going out of the firm from investing activities is caused by \
		the purchases of tangible and intangible long term assets, as well as the \
		purchase of financial instruments.
	|

CF Financing Cash Flow=SAMPLE IF TRUE(
	Reported Financing Cash Flow <> 0 , Reported Financing Cash Flow , 0)
	~	dollars/Year
	~	This variable will hold the most recent reported value so that decisions \
		can be made based on it.
	|

BS Cash= INTEG (
	Cash Inflow-Cash Outflow,
		Initial BS Cash)
	~	dollars
	~	This is the accumulated balance of cash on hand for the firm.
	|

BS Inventory= INTEG (
	Inventory Creation-Inventory Consumption,
		Initial BS Inventory)
	~	dollars
	~	Inventory on the balance sheet is increased by the cost of any materials \
		and labor, and decreased when the goods are shipped.
	|

Drained Reported Depreciation=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Depreciation/TIME STEP , 0 )
	~	dollars/Year
	~	Once it is time to report depreciation, the entire stock of accumulated \
		reported depreciation must be drained in one time step.
	|

Drained Reported Financing Cash Flow=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Financing Cash Flow/TIME STEP ,\
		 0 )
	~	dollars/Year
	~	Once it is time to report Financing Cash Flow, the entire stock of \
		accumulated reported Financing Cash Flow must be drained in one time step.
	|

Drained Reported Interest Expense=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Interest Expense/TIME STEP , 0 \
		)
	~	dollars/Year
	~	Once it is time to report Interest Expenses, the entire stock of \
		accumulated reported Interest Expense must be drained in one time step.
	|

Drained Reported Investing Cash Flow=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Investing Cash Flow/TIME STEP ,\
		 0 )
	~	dollars/Year
	~	Once it is time to report Investing Cash Flow, the entire stock of \
		accumulated reported Investing Cash Flow must be drained in one time step.
	|

Initial BS Accounts Receivable=
	Sales on Credit*Average Receivable Collection Time
	~	dollars
	~	This initializes the stock of accounts receivable in dynamic equilibrium \
		using little's law.
	|

Drained Reported Research and Development Expense=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Research and Development Expense\
		/TIME STEP , 0 )
	~	dollars/Year
	~	Once it is time to report Research and Development Expense, the entire \
		stock of accumulated reported Research and Development Expense must be \
		drained in one time step.
	|

Drained Reported Revenue=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Revenue/TIME STEP , 0 )
	~	dollars/Year
	~	Once it is time to report revenue the entire stock of accumulated reported \
		revenue must be drained in one time step.
	|

Drained Reported Selling General and Administrative Expense=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Selling General and Administrative Expense\
		/TIME STEP , 0 )
	~	dollars/Year
	~	Once it is time to report Selling General and Administrative Expense, the \
		entire stock of accumulated reported Selling General and Administrative \
		Expense must be drained in one time step.
	|

Financing Cash Inflows=
	New Debt Issued+Cash Collected from Share Issuance
	~	dollars/Year
	~	The cash flow coming into the firm from financing activities is caused by \
		sales of the firm's stock and by increases to the debt issued by the firm.
	|

Financing Cash Outflows=
	Short Term Debt Repayment+Dividends Paid
	~	dollars/Year
	~	The cash flow going out of the firm from financing activities occurs when \
		the firm pays dividends, repays a loan, or repurchases stock.
	|

Previous BS Inventory for CF= INTEG (
	Aging of Reported BS Inventory-Removal of Reported BS Inventory,
		Initial BS Inventory)
	~	dollars
	~	This is the level of BS Inventory one reporting period previously
	|

Latest Reported BS Accounts Payable=
	IF THEN ELSE( Check Reporting=0, BS Accounts Payable/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag activates the current value of BS Accounts Payable \
		is stored in the stock of reported BS Accounts Payable over a single time \
		step.
	|

Latest Reported BS Accounts Receivable=
	IF THEN ELSE( Check Reporting=0, BS Accounts Receivable/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag activates the current value of BS Accounts \
		Receivable is stored in the stock of reported BS Accounts Receivable over \
		a single time step.
	|

Latest Reported BS Accrued Wages=
	IF THEN ELSE( Check Reporting=0, BS Accrued Wages/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag activates the current value of BS Accrued Wages is \
		stored in the stock of reported BS Accrued Wages over a single time step.
	|

Latest Reported BS Inventory=
	IF THEN ELSE( Check Reporting=0, BS Inventory/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag activates the current value of BS inventory is \
		stored in the stock of reported BS inventory over a single time step.
	|

Removal of Reported BS Inventory=
	IF THEN ELSE( Check Reporting=0, Previous BS Inventory for CF/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is active the entire contents of the previous BS \
		Inventory stock is removed from the chain.
	|

Cash Collected from Share Issuance=
	Share Price*Shares Issued
	~	dollars/Year
	~	The flow of cash collected from sales of the firm's shares.
	|

Cash Flow from Changes to Balance Sheet Items=
	Cash Flow from Changes to Current Assets+Cash Flow from Changes to Current Liabilities
	~	dollars/Year
	~	The changes to certain current assets and liabilities impacts net income \
		differently from cash flow from operations.  These differences are \
		adjusted for in the indirect cash flow statement.
	|

Cash Flow from Changes to Current Assets=
	-(Change in BS Accounts Receivable+Change in BS Inventory)/One Year
	~	dollars/Year
	~	The difference between the balance sheet accounts must be transformed into \
		a cash flow so that it can be used to calculate the operating cash flows \
		using the indirect method. Any increases in current assets imply a \
		decrease in cash flow.
	|

Cash Flow from Changes to Current Liabilities=
	(Change in BS Accounts Payable+Change in BS Accrued Wages)/One Year
	~	dollars/Year
	~	The difference between the balance sheet accounts must be transformed into \
		a cash flow so that it can be used to calculate the operating cash flows \
		using the indirect method. Any increases in current liabilities imply an \
		increase in cash flow.
	|

Cash Inflow=
	Operating Cash Inflows+Investing Cash Inflows+Financing Cash Inflows
	~	dollars/Year
	~	The inflows of cash into the firm come from three sources, operations, \
		investing, and financing.
	|

Inventory Units Shipped=
	5000
	~	units/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The number of inventory units shipped should be \
		calculated somewhere in the model of a business.
	|

Cash Outflow=
	Operating Cash Outflows+Investing Cash Outflows+Financing Cash Outflows
	~	dollars/Year
	~	The firm uses cash for three types of activities, operations, investing, \
		and financing.
	|

Cash Sales=
	New Reported Revenue*Fraction of Sales Collected in Cash
	~	dollars/Year
	~	This is the fraction of revenue that is collected in cash rather than \
		billed to customers.
	|

Reported Financing Cash Flow=
	Drained Reported Financing Cash Flow*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported Financing Cash Flow is calculated based \
		on the size of the outflow from the accumulated reporting stock and the \
		length of the reporting period.
	|

New Reported Investing Cash Flow=
	Total Investing Cash Flow
	~	dollars/Year
	~	Investing cash flows that occur over the course of the year must be \
		accumulated so that their total can be reported.
	|

Drained Reported Amortization=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Amortization/TIME STEP , 0 )
	~	dollars/Year
	~	Once it is time to report amortization, the entire stock of accumulated \
		reported amortization must be drained in one time step.
	|

Drained Reported Cost of Goods Sold=
	IF THEN ELSE(Check Reporting=0, Accumulated Reported Cost of Goods Sold/TIME STEP , \
		0 )
	~	dollars/Year
	~	Once it is time to report cost of goods sold, the entire stock of \
		accumulated reported cost of goods sold must be drained in one time step.
	|

Change in BS Accounts Payable =
	Reported BS Accounts Payable for CF-Previous BS Accounts Payable for CF
	~	dollars
	~	This is the change in total BS Accounts Payable over the most recent \
		reporting period.
	|

Reported Investing Cash Flow=
	Drained Reported Investing Cash Flow*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported Investing Cash Flow is calculated based \
		on the size of the outflow from the accumulated reporting stock and the \
		length of the reporting period.
	|

Change in BS Accrued Wages=
	Reported BS Accrued Wages for CF-Previous BS Accrued Wages for CF
	~	dollars
	~	This is the change in total BS Accrued Wages over the most recent \
		reporting period.
	|

Sales on Credit=
	New Reported Revenue*(1-Fraction of Sales Collected in Cash)
	~	dollars/Year
	~	Customers are typically billed after their inventory is delivered and \
		revenue is recorded.
	|

One Year=
	1
	~	Year
	~	This variable enables us to turn the difference between two balance sheet \
		accounts into an equally sized cash flow.
	|

Target for Months of Operating Cash Outflows on Hand=
	3
	~	Months
	~	A simple heuristic for the desired cash balance is to carry a certain \
		number of months of cash expenses on hand.
	|

Previous BS Accounts Payable for CF = INTEG (
	Aging of Reported BS Accounts Payable-Removal of Reported BS Accounts Payable,
		Initial BS Accounts Payable )
	~	dollars
	~	This is the level of BS Accounts Payable one reporting period previously
	|

Cost of Labor Used to Create Inventory=
	700
	~	dollars/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The cost of labor used to create inventory should be \
		calculated somewhere in the model of a business.
	|

Previous BS Accrued Wages for CF= INTEG (
	Aging of Reported BS Accrued Wages-Removal of Reported BS Accrued Wages,
		Initial BS Accrued Wages)
	~	dollars
	~	This is the level of BS Accrued Wages one reporting period previously
	|

Total Operating Cash Flow=
	Operating Cash Inflows-Operating Cash Outflows
	~	dollars/Year
	~	The direct method for calculating total operating cash flows adds the \
		actual cash inflows and outflows from all of the operating activities.
	|

Price per Inventory Unit=
	10
	~	dollars/unit
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The price per inventory unit should be calculated \
		somewhere in the model of a business.
	|

Fraction of Sales Collected in Cash=
	0.2
	~	Dmnl [0,1]
	~	This constant separated revenue into the fraction that is collected in \
		cash and the fraction that is billed through accounts receivable.
	|

Removal of Reported BS Accounts Receivable=
	IF THEN ELSE( Check Reporting=0, Previous BS Accounts Receivable for CF/TIME STEP, 0\
		)
	~	dollars/Year
	~	When the reporting flag is active the entire contents of the previous BS \
		Accounts Receivable stock is removed from the chain.
	|

Removal of Reported BS Accrued Wages=
	IF THEN ELSE( Check Reporting=0, Previous BS Accrued Wages for CF/TIME STEP, 0)
	~	dollars/Year
	~	When the reporting flag is active the entire contents of the previous BS \
		Accrued Wages stock is removed from the chain.
	|

Total Financing Cash Flow=
	Financing Cash Inflows-Financing Cash Outflows
	~	dollars/Year
	~	The financing cash flows sum together in this variable that is the same \
		under both the direct and indirect method.
	|

Initial Accumulated Reported Financing Cash Flow=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Total Investing Cash Flow=
	Investing Cash Inflows-Investing Cash Outflows
	~	dollars/Year
	~	The investing cash flows sum together in this variable that is the same \
		under both the direct and indirect method.
	|

Initial Accumulated Reported Investing Cash Flow=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

New Reported Financing Cash Flow=
	Total Financing Cash Flow
	~	dollars/Year
	~	Financing cash flows that occur over the course of the year must be \
		accumulated so that their total can be reported.
	|

Reported BS Inventory for CF= INTEG (
	Latest Reported BS Inventory-Aging of Reported BS Inventory,
		Initial BS Inventory)
	~	dollars
	~	This is the most recently reported level of BS Inventory
	|

Net Income Adjusted for Non Cash Expenses=
	SAMPLE IF TRUE(Check Reporting = TIME STEP,IS Net Income+IS Depreciation+IS Amortization\
		,0)
	~	dollars/Year
	~	Under the indirect method cash flow from operations is reconciled with net \
		income by first adding back any non-cash expenses.
	|

Previous BS Accounts Receivable for CF= INTEG (
	Aging of Reported BS Accounts Receivable-Removal of Reported BS Accounts Receivable,
		Initial BS Accounts Receivable)
	~	dollars
	~	This is the level of BS Accounts Receivable one reporting period previously
	|

Weeks per Year=
	52
	~	weeks/Year
	~	A variable to help in the integration of concepts typically measures using \
		different time units.
	|

Frequency of Payment of Wages=
	Weeks Between Wage Payments/Weeks per Year
	~	Years
	~	This variable translates the weeks between wage payments into a variable \
		measured in years.
	|

Initial BS Accounts Payable=
	Average Supplier Credit Terms*Cost of Material Purchases*(1-Fraction of Material Purchases Paid in Cash\
		)
	~	dollars
	~	Accounts payable are initialized in dynamic equilibrium following little's \
		law.
	|

Initial BS Accrued Wages=
	(Selling General and Administrative Salary Costs+Cost of Labor Used to Create Inventory\
		)*Frequency of Payment of Wages
	~	dollars
	~	The stock of accrued wages is initialized in dynamic equilibrium following \
		little's law.
	|

Cost of Material Purchases=
	100
	~	dollars/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The cost of material purchases should be calculated \
		somewhere in the model of a business.
	|

BS Accounts Payable= INTEG (
	Material Purchases on Credit-Payment of Accounts Payable,
		Initial BS Accounts Payable)
	~	dollars
	~	The total amount that the company will need to pay to suppliers for \
		previous materials purchases.
	|

Initial BS Long Term Debt=
	New Debt Issued*(Average Loan Term-Definition of Current)/(1-Debt Interest Rate*(Average Loan Term\
		-Definition of Current))
	~	dollars
	~	This quantity initializes the stock of long term debt in dynamic \
		equilibrium.
	|

Days of Credit Terms Offered to Customers=
	90
	~	days
	~	The number of days that customers are given to pay for their orders.
	|

Days per Year=
	365
	~	days/Year
	~	A variable to help in the integration of concepts typically measures using \
		different time units.
	|

Initial BS Short Term Debt=
	Definition of Current*Initial BS Long Term Debt/((1-Definition of Current*Debt Interest Rate\
		)*(Average Loan Term-Definition of Current))
	~	dollars
	~	This quantity initializes the stock of short term debt in dynamic \
		equilibrium.
	|

Weeks Between Wage Payments=
	2
	~	weeks
	~	The frequency of the payment of wages in the company
	|

Marketing Expense=
	50
	~	dollars/Year
	~	The flow of value consumed in marketing the firms goods and services.  The \
		accounting model does not separate the cash flows from value flows for \
		marketing, so if this is important for your purpose you will want to add a \
		marketing accrual stock to short term assets or liabilities.
	|

Average Supplier Credit Terms=
	Supplier Credit Terms in Days/Days per Year
	~	Years
	~	The average length of time that suppliers allow the firm to repay their \
		accounts over.
	|

BS Accrued Wages= INTEG (
	Value of Wages Earned By Workers-Wages Paid to Workers,
		Initial BS Accrued Wages)
	~	dollars
	~	Wages accrue in this stock until they are paid by the firm.
	|

Months per Year=
	12
	~	Months/Year
	~	A variable to help in the integration of concepts typically measures using \
		different time units.
	|

New Debt Issued=
	500
	~	dollars/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The decision to issue debt must be determined through \
		some decision rule.
	|

Payment of Accounts Payable=
	BS Accounts Payable/Average Supplier Credit Terms
	~	dollars/Year
	~	Accounts payable are repaid over some average length of time.
	|

Supplier Credit Terms in Days=
	45
	~	days
	~	The number of days on average that the firm is given to pay its suppliers.
	|

Research and Development Expense=
	150
	~	dollars/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The cost of research and development should be \
		calculated somewhere in the model of a business.
	|

Fraction of Material Purchases Paid in Cash=
	0.1
	~	Dmnl [0,1]
	~	If some portion of materials are paid in cash at the time of purchase then \
		this variable will enable that to be captured by the model.
	|

Wages Paid to Workers=
	BS Accrued Wages/Frequency of Payment of Wages
	~	dollars/Year
	~	Wages are paid after a short delay.
	|

Value of Wages Earned By Workers=
	Cost of Labor Used to Create Inventory+Selling General and Administrative Salary Costs
	~	dollars/Year
	~	All of the wages consumed by the company will flow into the stock of \
		accrued wages until they are paid.
	|

Material Purchases on Credit=
	Cost of Material Purchases*(1-Fraction of Material Purchases Paid in Cash)
	~	dollars/Year
	~	Only the portion of material purchases done for credit will flow into the \
		stock of accounts payable.
	|

Reported Gross Profit=
	Reported Revenue-Reported Cost of Goods Sold
	~	dollars/Year
	~	The instantaneous value of cost of goods sold, for calculating the \
		instantaneous value of the tax rate.
	|

Initial Historical Cost of Intangible Assets=
	Initial BS Accumulated Amortization+Initial BS Net Intangible Assets
	~	dollars
	~	To achieve dynamic equilibrium the initial value of the historical cost of \
		intangible assets must be equal to the total net intangibles plus the \
		total accumulated amortization.
	|

Initial Accumulated Reported Selling General and Administrative Expense=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Initial Amortization Discontinuation=
	Amount Spent on Intangible Assets
	~	dollars/Year
	~	Dynamic equilibrium for the amortization structures requires that all \
		flows be initialized to the same value.
	|

Initial BS Accumulated Amortization=
	Amount Spent on Intangible Assets*Intangible Asset Average Amortization Time/2
	~	dollars
	~	Since dynamic equilibrium for the amortization structures requires that \
		all flows be initialized to the same value exactly half of the total \
		historical cost of intangible assets should be in each of the stocks of \
		net value and accumulated amortization.  Little's law determines the total \
		level as the inflow times the average residency time.
	|

Initial BS Accumulated Depreciation=
	Amount Spent on Long Term Assets*Tangible Asset Average Depreciation Time/2
	~	dollars
	~	Since dynamic equilibrium for the depreciation structures requires that \
		all flows be initialized to the same value exactly half of the total \
		historical cost of tangible assets should be in each of the stocks of net \
		value and accumulated depreciation. Little's law determines the total \
		level as the inflow times the average residency time.
	|

Accumulated Reported Selling General and Administrative Expense= INTEG (
	New Reported Selling General and Administrative Expense-Drained Reported Selling General and Administrative Expense\
		,
		Initial Accumulated Reported Selling General and Administrative Expense)
	~	dollars
	~	This stock represents all of the Selling General and Administrative \
		Expense that has been consumed so far this reporting period. It must wait \
		until the end of the period to be reported on the income statement.
	|

Initial BS Net Intangible Assets=
	Amount Spent on Intangible Assets*Intangible Asset Average Amortization Time/2
	~	dollars
	~	Since dynamic equilibrium for the amortization structures requires that \
		all flows be initialized to the same value exactly half of the total \
		historical cost of intangible assets should be in each of the stocks of \
		net value and accumulated amortization.  Little's law determines the total \
		level as the inflow times the average residency time.
	|

Initial BS Net Plant Property and Equipment=
	Amount Spent on Long Term Assets*Tangible Asset Average Depreciation Time/2
	~	dollars
	~	Since dynamic equilibrium for the depreciation structures requires that \
		all flows be initialized to the same value exactly half of the total \
		historical cost of tangible assets should be in each of the stocks of net \
		value and accumulated depreciation. Little's law determines the total \
		level as the inflow times the average residency time.
	|

Average Loan Term=
	10
	~	Year
	~	The average length of time it takes for the firm to fully repay its long \
		term loans.
	|

Selling General and Administrative Salary Costs=
	500
	~	dollars/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The cost of selling general and administrative employee \
		salaries should be calculated somewhere in the model of a business.
	|

Borrowing=
	New Debt Issued
	~	dollars/Year
	~	New long term debt flows into the stock whenever the company needs to \
		borrow.
	|

Interest on Long Term Debt=
	BS Long Term Debt*Debt Interest Rate
	~	dollars/Year
	~	The interest on debt accrues as a fraction of its current balance.
	|

Interest on Short Term Debt=
	BS Short Term Debt*Debt Interest Rate
	~	dollars/Year
	~	The interest on debt accrues as a fraction of its current balance.
	|

Tax Rate=
	0.2
	~	Dmnl
	~	A fractional tax rate as a percentage of the earnings before taxes.
	|

Reported Earnings Before Taxes=
	Reported Operating Profit-Reported Interest Expense
	~	dollars/Year
	~	The instantaneous value of earnings before taxes, for calculating the \
		instantaneous value of the tax rate.
	|

IS Net Income=
	IS Earnings Before Taxes-IS Tax Expense
	~	dollars/Year
	~	Net income is the bottom line income number on the income statement and is \
		the most closely watched indicator of corporate performance.  It is \
		calculated as revenue minus all expenses on the income statement.
	|

IS Operating Profit=
	IS Gross Profit-IS Total Operating Expenses
	~	dollars/Year
	~	The operating profit of an enterprise can be calculated as its revenue \
		minus all of its expenses before interest and taxes, or as its gross \
		profit minus to total operating expenses.
	|

Definition of Current=
	1
	~	Year
	~	The definition of a current asset of liability in accounting is the \
		greater of one year or the operating cycle of the business.  In most cases \
		one year is used.
	|

Reported Net Income=
	Reported Earnings Before Taxes-Reported Tax Expense
	~	dollars/Year
	~	The instantaneous value of net income
	|

BS Long Term Debt= INTEG (
	Borrowing+Interest on Long Term Debt-Debt Becoming Current,
		Initial BS Long Term Debt)
	~	dollars
	~	This stock accumulates all of the debt held by the firm that does not need \
		to be fully repaid soon.
	|

IS Gross Profit=
	IS Revenue-IS Cost of Goods Sold
	~	dollars/Year
	~	The gross profit of an enterprise is a measure of its revenue minus its \
		cost of goods sold.
	|

Reported Tax Expense=
	MAX(Reported Earnings Before Taxes*Tax Rate,0)
	~	dollars/Year
	~	A simple formulation for instantaneous taxes due.
	|

BS Short Term Debt= INTEG (
	Debt Becoming Current+Interest on Short Term Debt-Short Term Debt Repayment,
		Initial BS Short Term Debt)
	~	dollars
	~	The balance of debt that will be repaid within a short period of time.
	|

Debt Becoming Current=
	BS Long Term Debt/MAX(Average Loan Term-Definition of Current,TIME STEP)
	~	dollars/Year
	~	Long term debt moves to the stock of short term debt when it is one year \
		away from maturity.  Because of computational difficulties with tracking \
		which debt instrument accrues interest we propose a simple first order \
		delay for this formulation rather than a fixed delay. We maintain \
		numerical stability by making sure that the denominator never becomes \
		negative for very short loan terms or very long definitions of current.
	|

Debt Interest Rate=
	0.07
	~	Dmnl/Year
	~	The average annual interest rate accrued on the debt held by the company.
	|

Initial Depreciation Discontinuation=
	Amount Spent on Long Term Assets
	~	dollars/Year
	~	Dynamic equilibrium for the depreciation structures requires that all \
		flows be initialized to the same value.
	|

Reported Operating Profit=
	Reported Gross Profit-(Reported Selling General and Administrative Expense+Reported Research and Development Expense\
		+Reported Marketing Expense+Reported Depreciation+Reported Amortization
	)
	~	dollars/Year
	~	The instantaneous value of operating profit, for calculating the \
		instantaneous value of the tax rate.
	|

Reported Selling General and Administrative Expense=
	Drained Reported Selling General and Administrative Expense*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported Selling General and Administrative \
		Expense is calculated based on the size of the outflow from the \
		accumulated reporting stock and the length of the reporting period.
	|

IS Total Operating Expenses=
	IS Marketing Expense+IS Research and Development Expense+IS Selling General and Administrative Expense\
		+IS Depreciation+IS Amortization
	~	dollars/Year
	~	It is common to total the operating expenses of a business for reporting \
		on the income statement.
	|

New Reported Selling General and Administrative Expense=
	Selling General and Administrative Salary Costs
	~	dollars/Year
	~	The Selling General and Administrative expense is reported when it has \
		been consumed. This is typically a little before salaries are paid.
	|

BS Accumulated Depreciation= INTEG (
	Depreciation-Discontinuation of Depreciation Accumulation,
		Initial BS Accumulated Depreciation)
	~	dollars
	~	Depreciation that accumulates over time must be recorded so that it can be \
		displayed on the balance sheet.
	|

Initial Historical Cost of PPE=
	Initial BS Accumulated Depreciation+Initial BS Net Plant Property and Equipment
	~	dollars
	~	To achieve dynamic equilibrium the initial value of the historical cost of \
		PPE must be equal to the total net PPE  plus the total accumulated \
		depreciation.
	|

BS Net Intangible Assets= INTEG (
	Intangible Asset Purchases-Amortization,
		Initial BS Net Intangible Assets)
	~	dollars
	~	The value of intangibles on the balance sheet is the difference between \
		the historical cost and the total accumulated amortization.
	|

Amortization=
	Historical Cost of Intangible Assets/Intangible Asset Average Amortization Time
	~	dollars/Year
	~	Annual amortization is calculated using the straight line method, which is \
		equivalent to basing the outflow from the stock of net intangible assets \
		on the historical cost rather than the current level.
	|

Amount Spent on Intangible Assets=
	500
	~	dollars/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The decision to invest in intangibles must be determined \
		through some decision rule.
	|

Amount Spent on Long Term Assets=
	1000
	~	dollars/Year
	~	This is one location where the accounting model interfaces with the model \
		of the business.  The decision to invest in long term assets must be \
		determined through some decision rule.
	|

Discontinuation of Depreciation Accumulation=
	Discontinuation of Depreciation
	~	dollars/Year
	~	When an item of PPE has been fully depreciated its value is removed from \
		the stock of accumulated depreciation.
	|

Discontinuation of Amortization Accumulation=
	Discontinuation of Amortization
	~	dollars/Year
	~	When an item of intangible assets has been fully amortized its value is \
		removed from the stock of accumulated amortization.
	|

Discontinuation of Depreciation=
	DELAY FIXED( Increase in Historical Cost of PPE , Tangible Asset Average Depreciation Time\
		 , Initial Depreciation Discontinuation )
	~	dollars/Year
	~	Once the historical costs have spent enough time in the stock to be fully \
		depreciated they move out of that stock so as to no longer impact annual \
		depreciation.
	|

Intangible Asset Average Amortization Time=
	10
	~	Year
	~	This is the length of time over which intangible assets are fully \
		amortized on average.
	|

Intangible Asset Purchases=
	Amount Spent on Intangible Assets
	~	dollars/Year
	~	Every dollar spent to purchase intangible assets will flow into the stock \
		of the net value of intangible assets.
	|

Historical Cost of Plant Property and Equipment= INTEG (
	Increase in Historical Cost of PPE-Discontinuation of Depreciation,
		Initial Historical Cost of PPE)
	~	dollars
	~	This stock tracks the historical cost of plant property and equipment \
		because the historical cost is what controls the annual depreciation \
		expense. Once PPE is fully depreciated it moves out of this stock and no \
		longer influences annual depreciation.
	|

BS Net Plant Property and Equipment= INTEG (
	Capital Expenditure-Depreciation,
		Initial BS Net Plant Property and Equipment)
	~	dollars
	~	The value of PPE on the balance sheet is the difference between the \
		historical cost and the total accumulated depreciation.
	|

BS Accumulated Amortization= INTEG (
	Amortization-Discontinuation of Amortization Accumulation,
		Initial BS Accumulated Amortization)
	~	dollars
	~	Amortization that accumulates over time must be recorded so that it can be \
		displayed on the balance sheet.
	|

Capital Expenditure=
	Amount Spent on Long Term Assets
	~	dollars/Year
	~	Every dollar spent to purchase long term assets will flow into the stock \
		of the net value of plant property and equipment.
	|

Tangible Asset Average Depreciation Time=
	15
	~	Year
	~	This is the length of time over which tangible assets are fully \
		depreciated on average.
	|

Historical Cost of Intangible Assets= INTEG (
	Increase in Historical Cost of Intangible Assets-Discontinuation of Amortization,
		Initial Historical Cost of Intangible Assets
		)
	~	dollars
	~	This stock tracks the historical cost of intangible assets because the \
		historical cost is what controls the annual amortization expense. Once \
		intangibles are fully depreciated it moves out of this stock and no longer \
		influences annual amortization.
	|

Discontinuation of Amortization=
	DELAY FIXED(Increase in Historical Cost of Intangible Assets, Intangible Asset Average Amortization Time\
		, Initial Amortization Discontinuation)
	~	dollars/Year
	~	Once the historical costs have spent enough time in the stock to be fully \
		amortized they move out of that stock so as to no longer impact annual \
		amortization.
	|

Increase in Historical Cost of PPE=
	Capital Expenditure
	~	dollars/Year
	~	The cost of PPE increases with every dollar spent on capital expenditure.
	|

Increase in Historical Cost of Intangible Assets=
	Intangible Asset Purchases
	~	dollars/Year
	~	The cost of intangible assets increases with every dollar spent on \
		intangible asset purchases.
	|

Depreciation=
	Historical Cost of Plant Property and Equipment/Tangible Asset Average Depreciation Time
	~	dollars/Year
	~	Annual depreciation is calculated using the straight line method, which is \
		equivalent to basing the outflow from the stock of PPE on the historical \
		cost rather than the current level.
	|

Accumulated Reported Amortization= INTEG (
	New Reported Amortization-Drained Reported Amortization,
		Initial Accumulated Reported Amortization)
	~	dollars
	~	This stock represents all of the amortization that has been created so far \
		this reporting period. It must wait until the end of the period to be \
		reported on the income statement.
	|

Accumulated Reported Cost of Goods Sold= INTEG (
	New Reported Cost of Goods Sold-Drained Reported Cost of Goods Sold,
		Initial Accumulated Reported Cost of Goods Sold)
	~	dollars
	~	This stock represents all of the cost of goods sold that has been consumed \
		so far this reporting period. It must wait until the end of the period to \
		be reported on the income statement.
	|

Accumulated Reported Depreciation= INTEG (
	New Reported Depreciation-Drained Reported Depreciation,
		Initial Accumulated Reported Depreciation)
	~	dollars
	~	This stock represents all of the Depreciation that has been consumed so \
		far this reporting period. It must wait until the end of the period to be \
		reported on the income statement.
	|

Accumulated Reported Interest Expense= INTEG (
	New Reported Interest Expense-Drained Reported Interest Expense,
		Initial Accumulated Reported Interest Expense)
	~	dollars
	~	This stock represents all of the Interest Expense that has been accrued so \
		far this reporting period. It must wait until the end of the period to be \
		reported on the income statement.
	|

Accumulated Reported Marketing Expense= INTEG (
	New Reported Marketing Expense-Drained Reported Marketing Expense,
		Initial Accumulated Reported Marketing Expense)
	~	dollars
	~	This stock represents all of the Marketing Expense that has been consumed \
		so far this reporting period. It must wait until the end of the period to \
		be reported on the income statement.
	|

Accumulated Reported Research and Development Expense= INTEG (
	New Reported Research and Development Expense-Drained Reported Research and Development Expense\
		,
		Initial Accumulated Reported Research and Development Expense)
	~	dollars
	~	This stock represents all of the Research and Development Expense that has \
		been consumed so far this reporting period. It must wait until the end of \
		the period to be reported on the income statement.
	|

Accumulated Reported Revenue= INTEG (
	New Reported Revenue-Drained Reported Revenue,
		Initial Accumulated Reported Revenue
		)
	~	dollars
	~	This stock represents all of the revenue that has been earned so far this \
		reporting period. It must wait until the end of the period to be reported \
		on the income statement.
	|

Initial Accumulated Reported Research and Development Expense=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Initial Accumulated Reported Revenue=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Reported Amortization=
	Drained Reported Amortization*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported amortization is calculated based on the \
		size of the outflow from the accumulated reporting stock and the length of \
		the reporting period.
	|

Reported Cost of Goods Sold=
	Drained Reported Cost of Goods Sold*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported cost of goods sold is calculated based on \
		the size of the outflow from the accumulated reporting stock and the \
		length of the reporting period.
	|

Reported Depreciation=
	Drained Reported Depreciation*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported depreciation is calculated based on the \
		size of the outflow from the accumulated reporting stock and the length of \
		the reporting period.
	|

IS Earnings Before Taxes=
	IS Operating Profit-IS Interest Expense
	~	dollars/Year
	~	The total earnings before taxes is often used as a simple basis to \
		calculate a corporation's effective tax rate.
	|

New Reported Marketing Expense=
	Marketing Expense
	~	dollars/Year
	~	The marketing expense is reported when it has been consumed. This is \
		typically after the promotions have run.
	|

Check Reporting=
	MODULO(Time, Reporting Period)
	~	Year
	~	This variable checks to see whether the current time step is the correct \
		time to report results.
	|

New Reported Amortization=
	Amortization
	~	dollars/Year
	~	Amortization of intangible assets is reported using a straight line \
		method, and is conceptually very similar to depreciation
	|

New Reported Cost of Goods Sold=
	Cost of Goods Sold
	~	dollars/Year
	~	The cost of goods sold are reported when the goods are transferred to the \
		customer.
	|

New Reported Depreciation=
	Depreciation
	~	dollars/Year
	~	Depreciation on tangible long term assets occurs on a straight line basis.
	|

New Reported Interest Expense=
	Interest on Long Term Debt+Interest on Short Term Debt
	~	dollars/Year
	~	Interest Expenses are reported as loans remain outstanding, accruing \
		interest at the rate they bear.
	|

New Reported Revenue=
	Price per Inventory Unit*Inventory Units Shipped
	~	dollars/Year
	~	Revenue is reported when the good is transferred to the customer.
	|

Initial Accumulated Reported Marketing Expense=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

New Reported Research and Development Expense=
	Research and Development Expense
	~	dollars/Year
	~	The expense from research and development is reported roughly in time with \
		when the cash outflows from paying researchers and product designers \
		occur, since research and development costs are not allowed to be \
		capitalized under US GAAP.
	|

Initial Accumulated Reported Depreciation=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Initial Accumulated Reported Interest Expense=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Reported Interest Expense=
	Drained Reported Interest Expense*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported Interest Expense is calculated based on \
		the size of the outflow from the accumulated reporting stock and the \
		length of the reporting period.
	|

Initial Accumulated Reported Cost of Goods Sold=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Initial Accumulated Reported Amortization=
	0
	~	dollars
	~	The initial value of the reported variable should always be zero.
	|

Reported Marketing Expense=
	Drained Reported Marketing Expense*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported Marketing Expense is calculated based on \
		the size of the outflow from the accumulated reporting stock and the \
		length of the reporting period.
	|

Reported Research and Development Expense=
	Drained Reported Research and Development Expense*TIME STEP/Reporting Period
	~	dollars/Year
	~	The annualized value of reported Research and Development Expense is \
		calculated based on the size of the outflow from the accumulated reporting \
		stock and the length of the reporting period.
	|

BS Total Assets=
	BS Total Current Assets+BS Total Long Term Assets
	~	dollars
	~	The sum of all the assets on the balance sheet.
	|

BS Total Current Assets=
	BS Cash+BS Accounts Receivable+BS Inventory
	~	dollars
	~	The sum of the components of current assets on the balance sheet.
	|

BS Total Current Liabilities=
	BS Accrued Wages+BS Accounts Payable+BS Short Term Debt
	~	dollars
	~	The sum of the components of current liabilities on the balance sheet.
	|

BS Total Liabilities=
	BS Total Current Liabilities+BS Total Long Term Liabilities
	~	dollars
	~	The sum of all the liabilities on the balance sheet.
	|

BS Total Liabilities and Equity=
	BS Total Liabilities+BS Total Equity
	~	dollars
	~	The sum of liabilities and equity on the balance sheet is reported in \
		order to test the balance sheet equation, which says that assets must \
		always equal liabilities plus equity.
	|

BS Total Long Term Assets=
	BS Net Plant Property and Equipment+BS Net Intangible Assets
	~	dollars
	~	The sum of the components of long term assets on the balance sheet.
	|

BS Total Long Term Liabilities=
	BS Long Term Debt
	~	dollars
	~	The sum of the components of long term liabilities on the balance sheet.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.03125
	~	Year [0,?]
	~	The time step for the simulation.
	|

