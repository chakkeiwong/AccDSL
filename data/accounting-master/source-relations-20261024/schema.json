{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "const": "SourceMeasurementRelationsDraft/1"
    },
    "state_request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "profile": {
          "const": "SourceConstrainedCompanyStateDraft/1"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "target": {
              "enum": [
                "CompanyOperationsDraft/1",
                "RetainedCompanyProgramDraft/1"
              ]
            },
            "view": {
              "enum": [
                "annual",
                "interim",
                "combined"
              ]
            },
            "readiness_request_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "readiness_result_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "target",
            "view",
            "readiness_request_sha256",
            "readiness_result_sha256"
          ],
          "additionalProperties": false
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "fiscal_year",
                  "interim"
                ]
              },
              "source_anchor": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "schema": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "schema",
                  "digest"
                ],
                "additionalProperties": false
              },
              "source_period": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              },
              "end_exclusive": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              }
            },
            "required": [
              "id",
              "kind",
              "source_anchor",
              "source_period",
              "start",
              "end_exclusive"
            ],
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "observation_ref": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "schema": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "schema",
                  "digest"
                ],
                "additionalProperties": false
              },
              "period_id": {
                "type": "string",
                "minLength": 1
              },
              "measurement_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              },
              "context": {
                "type": "object",
                "properties": {
                  "issuer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "perimeter": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "period": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "measurement_kind": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "issuer",
                  "perimeter",
                  "basis",
                  "period",
                  "unit",
                  "measurement_kind"
                ],
                "additionalProperties": false
              },
              "interpretation": {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "display_only",
                      "assumed_rounding"
                    ]
                  },
                  "assumption_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "mode",
                  "assumption_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "observation_ref",
              "period_id",
              "measurement_date",
              "context",
              "interpretation"
            ],
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "rule": {
                "const": "nearest_ties_away_from_zero"
              },
              "quantum": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)/[1-9][0-9]*$"
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "const": "proposed_not_admitted"
              }
            },
            "required": [
              "id",
              "rule",
              "quantum",
              "provenance",
              "disposition"
            ],
            "additionalProperties": false
          }
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "profile",
        "name",
        "source",
        "periods",
        "bindings",
        "assumptions",
        "requirement_ids"
      ],
      "additionalProperties": false
    },
    "state_result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledgers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "enum": [
              "annual",
              "interim"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "group",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ledger_group": {
            "enum": [
              "annual",
              "interim"
            ]
          },
          "source_pointer": {
            "type": "string",
            "pattern": "^/relations/(?:0|[1-9][0-9]*)$"
          },
          "source_record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "coefficient": {
                  "type": "string",
                  "pattern": "^(?:0|-?[1-9][0-9]*)/[1-9][0-9]*$"
                },
                "observation_ref": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "schema": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "schema",
                    "digest"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "coefficient",
                "observation_ref"
              ],
              "additionalProperties": false
            }
          },
          "target_ref": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "schema",
              "digest"
            ],
            "additionalProperties": false
          },
          "measurement_identity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provenance": {
                    "type": "string",
                    "minLength": 1
                  },
                  "disposition": {
                    "const": "proposed_not_admitted"
                  }
                },
                "required": [
                  "id",
                  "provenance",
                  "disposition"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "ledger_group",
          "source_pointer",
          "source_record_sha256",
          "terms",
          "target_ref",
          "measurement_identity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile",
    "state_request",
    "state_result_sha256",
    "ledgers",
    "relations"
  ],
  "additionalProperties": false
}
