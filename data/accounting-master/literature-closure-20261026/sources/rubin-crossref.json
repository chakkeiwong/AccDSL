[[2014,8,8]],"date-time":"2014-08-08T00:00:00Z","timestamp":1407456000000},"content-version":"vor","delay-in-days":14313,"URL":"http:\/\/onlinelibrary.wiley.com\/termsAndConditions#vor"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["ETS Research Bulletin Series"],"published-print":{"date-parts":[[1975,6]]},"abstract":"<jats:title>ABSTRACT<\/jats:title><jats:p>Two results are presented concerning inference when data may be missing. First, ignoring the process that causes missing data when making sampling distribution inferences about the parameter of the data, \u03b8, is generally appropriate if and only if the missing data are \u201cmissing at random\u201d and the observed data are \u201cobserved at random,\u201d and then such inferences are generally conditional on the observed pattern of missing data. Second, ignoring the process that causes missing data when making Bayesian inferences about \u03b8 is generally appropriate if and only if the missing data are missing at random and the parameter of the missing data is \u201cindependent\u201d of \u03b8. Examples and discussion indicating the implications of these results are included.<\/jats:p>","DOI":"10.1002\/j.2333-8504.1975.tb01053.x","type":"journal-article","created":{"date-parts":[[2014,8,8]],"date-time":"2014-08-08T18:25:36Z","timestamp":1407522336000},"source":"Crossref","is-referenced-by-count":20,"title":["INFERENCE AND MISSING DATA"],"prefix":"10.1002","volume":"1975","author":[{"given":"Donald B.","family":"Rubin","sequence":"first","affiliation":[{"name":"Educational Testing Service"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"311","published-online":{"date-parts":[[2014,8,8]]},"reference":[{"key":"e_1_2_1_2_1","doi-asserted-by":"publisher","DOI":"10.2307\/2282773"},{"key":"e_1_2_1_3_1","doi-asserted-by":"publisher","DOI":"10.1080\/01621459.1957.10501379"},{"key":"e_1_2_1_4_1","volume-title":"Bayesian Inference in Statistical Analysis.","aut