book_invariant "BookStateInvariantText/1" "BookStateInvariant/1";
context {"book":"legal-beta","case_id":"synthetic-cycle-beta","currency":"USD","entity":"Operating-beta","mode":"synthetic"};
totals "MethodCollectionTotals/1" "declared.claim_state" "1";
