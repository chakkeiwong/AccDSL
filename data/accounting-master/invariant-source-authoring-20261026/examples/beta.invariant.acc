field "assessed_remaining" {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} state "declared-operating-premise:assessed_remaining" field "/assessed_remaining";
field "overdue" {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} state "declared-operating-premise:overdue" field "/overdue";
end_collection;
collection "seen" seen;
field "id" {"context":{},"kind":"text"} state "declared-operating-premise:seen_id" value;
end_collection;
unique "claims_unique" "claims" "identity";
references "sale_seen" "claims" "sale_event" "seen" "id";
each "claim_rows" "claims";
begin_rules "MethodRequirements/3" "declared.claim_state" "1";
input "as_of" {"context":{},"kind":"date"} state "declared-operating-premise:as_of";
input "assessed" {"context":{},"kind":"boolean"} state "declared-operating-premise:assessed";
input "assessed_remaining" {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} state "declared-operating-premise:assessed_remaining";
input "assessment_date" {"context":{},"kind":"date"} state "declared-operating-premise:assessment_date";
input "due" {"context":{},"kind":"date"} state "declared-operating-premise:due";
input "issued" {"context":{},"kind":"date"} state "declared-operating-premise:issued";
input "overdue" {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} state "declared-operating-premise:overdue";
input "remaining" {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} state "declared-operating-premise:remaining";
guarded "remaining_nonnegative" invalid unresolved [] ["remaining"] [] (const {"context":{},"kind":"boolean"} true) (le (const {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} "0/1") (ref "remaining"));
guarded "assessed_remaining_nonnegative" invalid unresolved [] ["assessed_remaining"] [] (const {"context":{},"kind":"boolean"} true) (le (const {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} "0/1") (ref "assessed_remaining"));
guarded "overdue_nonnegative" invalid unresolved [] ["overdue"] [] (const {"context":{},"kind":"boolean"} true) (le (const {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} "0/1") (ref "overdue"));
guarded "issued_before_due" invalid unresolved [] ["issued","due"] [] (const {"context":{},"kind":"boolean"} true) (le (ref "issued") (ref "due"));
guarded "issued_by_now" invalid unresolved [] ["issued","as_of"] [] (const {"context":{},"kind":"boolean"} true) (le (ref "issued") (ref "as_of"));
guarded "assessment_after_issue" invalid unresolved ["assessed"] ["issued","assessment_date"] [] (ref "assessed") (le (ref "issued") (ref "assessment_date"));
guarded "assessment_by_now" invalid unresolved ["assessed"] ["assessment_date","as_of"] [] (ref "assessed") (le (ref "assessment_date") (ref "as_of"));
guarded "unassessed_assessed_remaining" invalid unresolved ["assessed"] ["assessed_remaining"] [] (not (ref "assessed")) (eq (ref "assessed_remaining") (const {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} "0/1"));
guarded "unassessed_overdue" invalid unresolved ["assessed"] ["overdue"] [] (not (ref "assessed")) (eq (ref "overdue") (const {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} "0/1"));
guarded "overdue_after_due" invalid unresolved ["assessed","due","assessment_date"] ["overdue","assessed_remaining"] [] (all (ref "assessed") (lt (ref "due") (ref "assessment_date"))) (eq (ref "overdue") (ref "assessed_remaining"));
guarded "zero_by_due" invalid unresolved ["assessed","assessment_date","due"] ["overdue"] [] (all (ref "assessed") (le (ref "assessment_date") (ref "due"))) (eq (ref "overdue") (const {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} "0/1"));
required_known [];
residual "Supplied internal state only; customer selection and event generation separate";
end_rules;
row_binding "due" row "due";
row_binding "issued" row "issued";
row_binding "remaining" row "remaining";
row_binding "assessed" row "assessed";
row_binding "assessment_date" row "assessment_date";
row_binding "assessed_remaining" row "assessed_remaining";
row_binding "overdue" row "overdue";
row_binding "as_of" global "as_of";
end_each;
begin_assessment;
begin_rules "MethodRequirements/3" "declared.claim_total" "1";
input "claim_total" {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} state "declared-operating-premise:claim_total";
input "receivable" {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} state "declared-operating-premise:receivable";
guarded "claim_receivable_sum" invalid unresolved [] ["claim_total","receivable"] [] (const {"context":{},"kind":"boolean"} true) (eq (ref "claim_total") (ref "receivable"));
required_known [];
residual "Synthetic fixed-unit-cost operating method; no source or accounting admission.";
end_rules;
end_assessment;
total_binding "claim_total" sum "claims" "remaining";
total_binding "receivable" global "receivable";
snapshot_residual "Internal collection membership is not disclosed-history completeness";
totals_residual "No source or accounting admission";
residual "Actual history, source admission, event selection and policy applicability remain separate";
end_invariant;
