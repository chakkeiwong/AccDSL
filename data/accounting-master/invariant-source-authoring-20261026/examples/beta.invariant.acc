collection "claims" memory_map "/claims";
field "identity" {"context":{},"kind":"text"} state "declared-operating-premise:identity" key;
field "customer" {"context":{},"kind":"text"} state "declared-operating-premise:customer" field "/customer";
field "due" {"context":{},"kind":"date"} state "declared-operating-premise:due" field "/due";
field "issued" {"context":{},"kind":"date"} state "declared-operating-premise:issued" field "/issued";
field "sale_event" {"context":{},"kind":"text"} state "declared-operating-premise:sale_event" field "/sale_event";
field "remaining" {"context":{"book":"legal-beta","case_id":"synthetic-cycle-beta","entity":"Operating-beta","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"} state "declared-operating-premise:remaining" field "/remaining";
