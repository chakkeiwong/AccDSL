{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "name",
    "assumption",
    "projection",
    "source",
    "context",
    "share",
    "claims",
    "facility",
    "loan",
    "tax",
    "events"
  ],
  "properties": {
    "profile": {
      "const": "FundedYearInputsDraft/1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "assumption": {
      "type": "string",
      "minLength": 1
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "digest"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "book",
        "currency"
      ],
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "book": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "share": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "d"
      ],
      "properties": {
        "n": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$"
        },
        "d": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ledger",
          "origin",
          "recognised",
          "settlement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ledger": {
            "enum": [
              "receivable",
              "payable"
            ]
          },
          "origin": {
            "enum": [
              "opening",
              "delivery",
              "purchase"
            ]
          },
          "recognised": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "d"
            ],
            "properties": {
              "n": {
                "type": "string",
                "pattern": "^(0|-?[1-9][0-9]*)$"
              },
              "d": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          },
          "settlement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "d"
            ],
            "properties": {
              "n": {
                "type": "string",
                "pattern": "^(0|-?[1-9][0-9]*)$"
              },
              "d": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          }
        }
      }
    },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "limit",
        "drawn",
        "reserved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "d"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "drawn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "d"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "reserved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "d"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "loan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facility_id",
        "principal",
        "annual_rate",
        "day_count",
        "fee",
        "interest_cash_class"
      ],
      "properties": {
        "facility_id": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "d"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "annual_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "d"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "day_count": {
          "const": "ACT365_calendar"
        },
        "fee": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "d"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "interest_cash_class": {
          "const": "operating"
        }
      }
    },
    "tax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rate",
        "method"
      ],
      "properties": {
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "d"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "method": {
          "const": "immediate_deductible"
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "at"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              {
                "const": "unknown"
              }
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
