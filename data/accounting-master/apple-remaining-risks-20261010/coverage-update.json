      }
    },
    {
      "source": "annual",
      "index": 23,
      "heading": "The Company expects its quarterly net sales and results of operations to fluctuate.",
      "start": 89800,
      "heading_end": 89883,
      "body_end": 92212,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
        "path": "data/accounting-master/apple-remaining-risks-20261010/source-claim-supplement.json",
        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 24,
      "heading": "The Company’s financial performance is subject to risks associated with changes in the value of the U.S. dollar relative to local currencies.",
      "start": 92212,
      "heading_end": 92353,
      "body_end": 94261,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
        "path": "data/accounting-master/apple-remaining-risks-20261010/source-claim-supplement.json",
        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 25,
      "heading": "The Company is exposed to credit risk and fluctuations in the values of its investment portfolio.",
      "start": 94261,
      "heading_end": 94358,
      "body_end": 95010,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
        "path": "data/accounting-master/apple-remaining-risks-20261010/source-claim-supplement.json",
        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 26,
      "heading": "The Company is exposed to credit risk on its trade accounts receivable, vendor non-trade receivables and prepayments related to long-term supply agreements, and this risk is heightened during periods when economic conditions worsen.",
