      }
    },
    {
      "source": "annual",
      "index": 18,
      "heading": "The Company’s business, results of operations and financial condition could be adversely impacted by unfavorable results of legal proceedings or government investigations.",
      "start": 73705,
      "heading_end": 73876,
      "body_end": 77030,
      "retention_status": "complete body retained"
    },
    {
      "source": "annual",
      "index": 19,
      "heading": "The Company is subject to complex and changing laws and regulations worldwide, which exposes the Company to potential liabilities, increased costs and other adverse effects on the Company’s business.",
      "start": 77030,
      "heading_end": 77229,
      "body_end": 80470,
      "retention_status": "complete body retained"
    },
    {
      "source": "annual",
      "index": 20,
      "heading": "Expectations relating to environmental, social and governance considerations and related reporting obligations expose the Company to potential liabilities, increased costs, reputational harm, and other adverse effects on the Company’s business.",
      "start": 80470,
      "heading_end": 80714,
      "body_end": 82217,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
