        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 12,
      "heading": "The Company’s success depends largely on the talents and efforts of its team members, the continued service and availability of highly skilled employees, including key personnel, and the Company’s ability to nurture its distinctive and inclusive culture.",
      "start": 63033,
      "heading_end": 63287,
      "body_end": 64423,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
