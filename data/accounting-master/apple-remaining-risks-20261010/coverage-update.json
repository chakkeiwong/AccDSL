      "heading_end": 95242,
      "body_end": 96833,
      "retention_status": "complete body retained"
    },
    {
      "source": "annual",
      "index": 27,
      "heading": "The Company is subject to changes in tax rates, the adoption of new U.S. or international tax legislation and exposure to additional tax liabilities.",
