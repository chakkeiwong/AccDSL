        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 13,
      "heading": "The Company depends on the performance of carriers, wholesalers, retailers and other resellers.",
      "start": 64423,
      "heading_end": 64518,
      "body_end": 65866,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
        "path": "data/accounting-master/apple-remaining-risks-20261010/source-claim-supplement.json",
        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 14,
      "heading": "The Company’s business and reputation are impacted by information technology system failures and network disruptions.",
      "start": 65866,
      "heading_end": 65983,
      "body_end": 67016,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
