        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 15,
      "heading": "Losses or unauthorized access to or releases of confidential information, including personal information, could subject the Company to significant reputational, financial, legal and operational consequences.",
      "start": 67016,
      "heading_end": 67223,
      "body_end": 71510,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
        "path": "data/accounting-master/apple-remaining-risks-20261010/source-claim-supplement.json",
        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 16,
      "heading": "Investment in new business strategies and acquisitions could disrupt the Company’s ongoing business, present risks not originally contemplated and materially adversely affect the Company’s business, reputation, results of operations and financial condition.",
      "start": 71510,
      "heading_end": 71767,
      "body_end": 72874,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
        "path": "data/accounting-master/apple-remaining-risks-20261010/source-claim-supplement.json",
        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 17,
      "heading": "The Company’s retail stores are subject to numerous risks and uncertainties.",
      "start": 72874,
      "heading_end": 72950,
      "body_end": 73666,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
