        "sha256": "e20b5f5d5eed65ff131b9d8a8335df4dd8714041932906ddce5c39ff0017c9a4"
      }
    },
    {
      "source": "annual",
      "index": 8,
      "heading": "The Company is exposed to the risk of write-downs on the value of its inventory and other assets, in addition to purchase commitment cancellation risk.",
      "start": 53732,
      "heading_end": 53883,
      "body_end": 55473,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-quality-inventory-20261010",
      "added_evidence": {
        "path": "data/accounting-master/apple-quality-inventory-20261010/source-claim-supplement.json",
        "sha256": "e20b5f5d5eed65ff131b9d8a8335df4dd8714041932906ddce5c39ff0017c9a4"
      }
    },
    {
      "source": "annual",
      "index": 9,
      "heading": "The Company relies on access to third-party intellectual property, which may not be available to the Company on commercially reasonable terms, or at all.",
      "start": 55473,
      "heading_end": 55626,
      "body_end": 57061,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
