  "records": [
    {
      "source": "annual",
      "index": 1,
      "heading": "The Company’s operations and performance depend significantly on global and regional economic conditions and adverse economic conditions can materially adversely affect the Company’s business, results of operations and financial condition.",
      "start": 31617,
      "heading_end": 31856,
      "body_end": 33890,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-competition-transition-20261010"
    },
    {
      "source": "annual",
      "index": 2,
      "heading": "The Company’s business can be impacted by political events, trade and other international disputes, geopolitical tensions, conflict, terrorism, natural disasters, public health issues, industrial accidents and other business interruptions.",
      "start": 33890,
      "heading_end": 34129,
      "body_end": 39480,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-competition-transition-20261010"
    },
    {
      "source": "annual",
      "index": 3,
      "heading": "Global markets for the Company’s products and services are highly competitive and subject to rapid technological change, and the Company may be unable to compete effectively in these markets.",
      "start": 39480,
      "heading_end": 39671,
      "body_end": 43581,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-competition-transition-20261010"
    },
    {
      "source": "annual",
      "index": 4,
      "heading": "To remain competitive and stimulate customer demand, the Company must successfully manage frequent introductions and transitions of products and services.",
      "start": 43597,
      "heading_end": 43751,
      "body_end": 45310,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-competition-transition-20261010"
    },
    {
      "source": "annual",
      "index": 5,
      "heading": "The Company depends on component and product manufacturing and logistical services provided by outsourcing partners, many of which are located outside of the U.S.",
      "start": 45310,
      "heading_end": 45472,
      "body_end": 48431,
      "retention_status": "complete body retained"
    },
    {
      "source": "annual",
      "index": 6,
      "heading": "Future operating results depend upon the Company’s ability to obtain components in sufficient quantities on commercially reasonable terms.",
      "start": 48431,
      "heading_end": 48569,
      "body_end": 51341,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-component-availability-20261010",
      "added_evidence": {
        "path": "data/accounting-master/apple-component-availability-20261010/source-claim-supplement.json",
        "sha256": "d712c58f9080f922419a5c3122ff8c3ca88fc44474505b73ce701c8e785e1f41"
      }
    },
    {
      "source": "annual",
      "index": 7,
      "heading": "The Company’s products and services may be affected from time to time by design and manufacturing defects that could materially adversely affect the Company’s business and result in harm to the Company’s reputation.",
      "start": 51341,
      "heading_end": 51556,
      "body_end": 53732,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-quality-inventory-20261010",
      "added_evidence": {
