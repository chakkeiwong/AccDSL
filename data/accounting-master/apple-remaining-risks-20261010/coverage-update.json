        "sha256": "81d6a0f186233502292971b20868921a63084b1f0a00ff9a77d80b1c0ea25a84"
      }
    },
    {
      "source": "annual",
      "index": 11,
      "heading": "Failure to obtain or create digital content that appeals to the Company’s customers, or to make such content available on commercially reasonable terms, could have a material adverse impact on the Company’s business, results of operations and financial condition.",
      "start": 61082,
      "heading_end": 61345,
      "body_end": 63033,
      "retention_status": "complete body retained",
      "new_unit": "data/accounting-master/apple-remaining-risks-20261010",
      "added_evidence": {
