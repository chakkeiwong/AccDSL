ordered_eligibility "OrderedEligibilityText/1" "OrderedEventEligibility/1" "collect";
context {"book":"legal-alpha","case_id":"synthetic-cycle-alpha","currency":"USD","entity":"Operating-alpha","mode":"synthetic"};
full_input "approved" {"context":{},"kind":"boolean"};
full_input "amount" {"context":{"book":"legal-alpha","case_id":"synthetic-cycle-alpha","entity":"Operating-alpha","mode":"synthetic"},"dimensions":{"currency:USD":1},"kind":"rational","scale":"1/1"};
full_input "claim_id" {"context":{},"kind":"text"};
full_input "customer" {"context":{},"kind":"text"};
residual "Finite declared lifecycle; full state invariants are separate prerequisites";
residual "No accounting, source or general language admission";
stage "approval" "applicability_not_selected";
bind "approved" (event_metadata "date");
begin_rules "MethodRequirements/3" "eligibility.approval" "1";
input "approved" {"context":{},"kind":"boolean"} state "Explicit binding evaluated against the current full intent and typed book";
guarded "approval" unsupported unresolved [] ["approved"] [] (const {"context":{},"kind":"boolean"} true) (ref "approved");
required_known [];
residual "Selected synthetic contract; lifecycle invariants and accounting admission remain separate";
end_rules;
end_stage;
stage "unsealed_day" "assessment_day_sealed";
bind "cursor" (memory_leaf "/collection_clock/cursor");
bind "day" (event_metadata "date");
begin_rules "MethodRequirements/3" "eligibility.unsealed_day" "1";
input "cursor" {"context":{},"kind":"date"} state "Explicit binding evaluated against the current full intent and typed book";
input "day" {"context":{},"kind":"date"} state "Explicit binding evaluated against the current full intent and typed book";
guarded "unsealed_day" invalid unresolved [] ["cursor","day"] [] (const {"context":{},"kind":"boolean"} true) (le (ref "cursor") (ref "day"));
required_known [];
residual "Selected synthetic contract; lifecycle invariants and accounting admission remain separate";
end_rules;
end_stage;
stage "claim_exists" "unknown_claim";
bind "exists" (map_contains "/claims" "claim_id");
begin_rules "MethodRequirements/3" "eligibility.claim_exists" "1";
input "exists" {"context":{},"kind":"boolean"} state "Explicit binding evaluated against the current full intent and typed book";
guarded "claim_exists" invalid unresolved [] ["exists"] [] (const {"context":{},"kind":"boolean"} true) (ref "exists");
required_known [];
residual "Selected synthetic contract; lifecycle invariants and accounting admission remain separate";
end_rules;
end_stage;
stage "customer_matches" "claim_customer_mismatch";
bind "customer" (event_input "customer");
bind "owner" (map_field "/claims" "claim_id" "customer" "claim_exists");
begin_rules "MethodRequirements/3" "eligibility.customer_matches" "1";
input "customer" {"context":{},"kind":"text"} state "Explicit binding evaluated against the current full intent and typed book";
input "owner" {"context":{},"kind":"text"} state "Explicit binding evaluated against the current full intent and typed book";
guarded "customer_matches" invalid unresolved [] ["customer","owner"] [] (const {"context":{},"kind":"boolean"} true) (eq (ref "customer") (ref "owner"));
required_known [];
residual "Selected synthetic contract; lifecycle invariants and accounting admission remain separate";
end_rules;
end_stage;
end_eligibility;
