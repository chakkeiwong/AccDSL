ordered_eligibility "OrderedEligibilityText/1" "OrderedEventEligibility/1" "assess";
context {"book":"legal-beta","case_id":"synthetic-cycle-beta","currency":"USD","entity":"Operating-beta","mode":"synthetic"};
full_input "approved" {"context":{},"kind":"boolean"};
full_input "start" {"context":{},"kind":"date"};
full_input "end_exclusive" {"context":{},"kind":"date"};
residual "Finite declared lifecycle; full state invariants are separate prerequisites";
residual "No accounting, source or general language admission";
stage "approval" "applicability_not_selected";
bind "approved" (event_input "approved");
begin_rules "MethodRequirements/3" "eligibility.approval" "1";
input "approved" {"context":{},"kind":"boolean"} state "Explicit binding evaluated against the current full intent and typed book";
guarded "approval" unsupported unresolved [] ["approved"] [] (const {"context":{},"kind":"boolean"} true) (ref "approved");
required_known [];
residual "Selected synthetic contract; lifecycle invariants and accounting admission remain separate";
end_rules;
end_stage;
stage "assessment_cursor" "assessment_cursor";
bind "start" (event_input "start");
bind "cursor" (memory_leaf "/collection_clock/cursor");
begin_rules "MethodRequirements/3" "eligibility.assessment_cursor" "1";
input "cursor" {"context":{},"kind":"date"} state "Explicit binding evaluated against the current full intent and typed book";
input "start" {"context":{},"kind":"date"} state "Explicit binding evaluated against the current full intent and typed book";
guarded "assessment_cursor" invalid unresolved [] ["start","cursor"] [] (const {"context":{},"kind":"boolean"} true) (eq (ref "start") (ref "cursor"));
required_known [];
residual "Selected synthetic contract; lifecycle invariants and accounting admission remain separate";
end_rules;
end_stage;
stage "assessment_window" "assessment_window";
bind "start" (event_input "start");
bind "end" (event_input "end_exclusive");
bind "adjacent" (calendar_adjacent (event_metadata "date") (event_input "end_exclusive"));
begin_rules "MethodRequirements/3" "eligibility.assessment_window" "1";
input "adjacent" {"context":{},"kind":"boolean"} state "Explicit binding evaluated against the current full intent and typed book";
input "end" {"context":{},"kind":"date"} state "Explicit binding evaluated against the current full intent and typed book";
input "start" {"context":{},"kind":"date"} state "Explicit binding evaluated against the current full intent and typed book";
guarded "assessment_window" invalid unresolved [] ["start","end","adjacent"] [] (const {"context":{},"kind":"boolean"} true) (all (lt (ref "start") (ref "end")) (ref "adjacent"));
required_known [];
residual "Selected synthetic contract; lifecycle invariants and accounting admission remain separate";
end_rules;
end_stage;
stage "period_end" "assessment_crosses_period";
bind "end" (event_input "end_exclusive");
bind "period" (period_end);
begin_rules "MethodRequirements/3" "eligibility.period_end" "1";
input "end" {"context":{},"kind":"date"} state "Explicit binding evaluated against the current full intent and typed book";
input "period" {"context":{},"kind":"date"} state "Explicit binding evaluated against the current full intent and typed book";
guarded "period_end" invalid unresolved [] ["end","period"] [] (const {"context":{},"kind":"boolean"} true) (le (ref "end") (ref "period"));
required_known [];
residual "Selected synthetic contract; lifecycle invariants and accounting admission remain separate";
end_rules;
end_stage;
end_eligibility;
