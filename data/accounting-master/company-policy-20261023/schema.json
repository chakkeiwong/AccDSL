{
  "type": "object",
  "properties": {
    "profile": {
      "const": "SettlementPolicyDraft/1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "year_index": {
      "type": "integer",
      "minimum": 0
    },
    "delivery_operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collection_operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fraction": {
      "type": "string",
      "pattern": "^(unknown|(?:0|-?[1-9][0-9]*)/[1-9][0-9]*)$"
    },
    "installment_shares": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(unknown|(?:0|-?[1-9][0-9]*)/[1-9][0-9]*)$"
      }
    },
    "rounding": {
      "const": "exact_rational_no_rounding"
    },
    "scope": {
      "const": "named_delivery_claims_only"
    },
    "real_behavior_evidence": {
      "const": false
    }
  },
  "required": [
    "profile",
    "policy_id",
    "parent_path_sha256",
    "year_index",
    "delivery_operations",
    "collection_operations",
    "claim_ids",
    "fraction",
    "installment_shares",
    "rounding",
    "scope",
    "real_behavior_evidence"
  ],
  "additionalProperties": false
}
