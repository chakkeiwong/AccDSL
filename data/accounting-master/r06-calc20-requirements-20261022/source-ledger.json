      "id": "status-index",
      "source": "01-product",
      "section": "Supporting documents",
      "quote": "Supporting documents for draft specifications:",
      "normalized_character_span": [
        624,
        670
      ]
    },
    {
      "id": "status-history",
      "source": "03-history",
      "section": "Requirements release row",
      "quote": "2019-02-06 Supports Public Working Draft",
      "normalized_character_span": [
        437,
        477
      ]
    },
    {
      "id": "title",
      "source": "02-requirements",
      "section": "Title",
      "quote": "Requirements Document 6 February 2019",
      "normalized_character_span": [
        68,
        105
      ]
    },
    {
      "id": "modelling-validation",
      "source": "02-requirements",
      "section": "1",
      "quote": "In practice, the modeling and validation use cases are often in conflict, as the desire to avoid calculation inconsistencies being reported may require calculation relationships to be altered, or removed altogether.",
      "normalized_character_span": [
        3667,
        3882
      ]
    },
    {
      "id": "concept-weights",
      "source": "02-requirements",
      "section": "3.1.1",
      "quote": "Concept roll up calculations need only support addition and subtraction; they do not need to support weighted addition and subtraction (weights other than +1 and -1).",
      "normalized_character_span": [
        6980,
        7146
      ]
    },
    {
      "id": "concept-aspects",
      "source": "02-requirements",
      "section": "3.1.1",
      "quote": "Concept roll up calculations should apply between facts with the same aspects and aspect values (as defined in OIM) except for the concept core aspect.",
      "normalized_character_span": [
        7147,
        7298
      ]
    },
    {
      "id": "typed-nil-distinct",
      "source": "02-requirements",
      "section": "3.1.1",
      "quote": "a typed dimension with a nil value should be considered different to the absence of that dimension.",
      "normalized_character_span": [
        7409,
        7508
      ]
    },
    {
      "id": "type-constraints",
      "source": "02-requirements",
      "section": "3.1.1",
      "quote": "Between concepts with different period type Involving non-numeric concepts Between concepts of different base datatypes Note that this excludes relationships between integer-based types and decimal-based types Between concepts based on xsd:float or xsd:double .",
      "normalized_character_span": [
        7575,
        7836
      ]
    },
    {
      "id": "alternative-hierarchies",
      "source": "02-requirements",
      "section": "3.1.2.2",
      "quote": "A dimension may have more than one domain hierarchy associated with it. This implies a need for segregated domain-member hierarchies.",
      "normalized_character_span": [
        8911,
        9044
      ]
    },
    {
      "id": "eps-aggregation",
      "source": "02-requirements",
      "section": "3.1.2.3.1",
      "quote": "earnings per share for continuing and discontinued operations can be aggregated to get total earnings per share for a given class of share, but it would not make sense to aggregate earnings per share across share classes.",
      "normalized_character_span": [
        10506,
        10727
      ]
    },
    {
      "id": "dimension-permission",
      "source": "02-requirements",
      "section": "3.1.2.4",
      "quote": "Aggregation should only be performed where a calculation indicates that a dimension is aggregatable across a specified domain.",
      "normalized_character_span": [
        11095,
        11221
      ]
    },
    {
      "id": "typed-modes",
      "source": "02-requirements",
      "section": "3.1.3",
      "quote": "Does not aggregate Aggregates to a fact for which that dimension is absent Aggegration to a typed dimension with a nil value is out of scope",
      "normalized_character_span": [
        11916,
        12056
      ]
    },
    {
      "id": "rollforward",
      "source": "02-requirements",
      "section": "3.1.4",
      "quote": "It must be possible to define calculation relationships between an opening balance, a set of in-period changes (which may make a positive or negative contribution), and a closing balance.",
      "normalized_character_span": [
        12724,
        12911
      ]
    },
    {
      "id": "rollforward-periods",
      "source": "02-requirements",
      "section": "3.1.4",
      "quote": "The opening and closing balance will be modelled using the same concept (with an \"instant\" period type), and the change items will have \"duration\" period type.",
      "normalized_character_span": [
        13094,
        13253
      ]
    },
    {
      "id": "consecutive-periods",
      "source": "02-requirements",
      "section": "3.1.4.2",
      "quote": "Roll-forward calculations should be applied where duration values can be inferred from a set of consecutive shorter periods.",
      "normalized_character_span": [
        13710,
        13834
      ]
    },
    {
      "id": "combined-types",
      "source": "02-requirements",
      "section": "3.2",
      "quote": "It must be possible to support such calculations, even where the intermediate sub-total is not reported.",
      "normalized_character_span": [
        14822,
        14926
      ]
    },
    {
      "id": "duplicate-precision",
      "source": "02-requirements",
      "section": "3.3.1",
      "quote": "calculations involving consistent duplicates should proceed using the value with the most precise value.",
      "normalized_character_span": [
        17231,
        17335
      ]
    },
    {
      "id": "interval-rounding",
      "source": "02-requirements",
      "section": "3.3.2",
      "quote": "Calculation checking should be perfomed using interval arithmetic. It must be possible to specify the rounding method used at the report-level. If specified, it should also apply to duplicates checking.",
      "normalized_character_span": [
        18243,
        18445
      ]
    },
    {
      "id": "generous-intervals",
      "source": "02-requirements",
      "section": "3.3.2",
      "quote": "The default should be to use \"generous\" intervals, which assume that a half value may be rounded either way",
      "normalized_character_span": [
        18446,
        18553
      ]
    },
    {
      "id": "missing-contributors",
      "source": "02-requirements",
      "section": "3.3.3",
      "quote": "if not all contributing items to a calculation defined in a taxonomy are included in a report, should they be assumed to be zero or unknown?",
      "normalized_character_span": [
        18852,
        18992
      ]
    },
    {
      "id": "section-completeness",
      "source": "02-requirements",
      "section": "3.3.3",
      "quote": "It must be possible for a report preparer to indicate that sets of facts form a \"section\" for the purposes of associating them with, and asserting that they are complete with respect to, relevant calculation relationships.",
      "normalized_character_span": [
        20071,
        20293
      ]
    },
    {
      "id": "nil-unknown",
      "source": "02-requirements",
      "section": "3.3.4",
      "quote": "Nil values should be interpreted as being an unknown value. This means that a calculation involving a nil fact cannot be performed, and attempting such a calculation should result in an error.",
      "normalized_character_span": [
        20327,
        20519
      ]
    },
    {
      "id": "unreported-subtotal",
      "source": "02-requirements",
      "section": "3.4",
      "quote": "It must be possible to validate a calculation even when not all intermediate subtotals are present. A processor should attempt to obtain a value for such items using the calculations defined for them.",
      "normalized_character_span": [
        20860,
        21060
      ]
    },
    {
      "id": "base-reuse",
      "source": "02-requirements",
      "section": "3.5",
      "quote": "Although re-use, rather than recreation, of calculation relationships is generally desirable, the solution should support either approach.",
      "normalized_character_span": [
        22746,
        22884
      ]
    },
    {
      "id": "balance-override",
      "source": "02-requirements",
      "section": "3.6.1",
      "quote": "but it should be possible to explicitly disable this check on a per-calculation basis.",
      "normalized_character_span": [
        23706,
        23792
      ]
    },
    {
      "id": "oim-scope",
      "source": "02-requirements",
      "section": "3.8",
      "quote": "The solution must operate exclusively on the information available in an Open Information Model report, and its supporting taxonomy.",
      "normalized_character_span": [
        25519,
        25651
      ]
    },
    {
      "id": "formula-source-claim",
      "source": "02-requirements",
      "section": "4",
      "quote": "XBRL Formula specification already provides the capability to validate the calculation types described in Section 3.1",
      "normalized_character_span": [
        25814,
        25931
      ]
    },
    {
      "id": "entity-unit-exclusion",
      "source": "02-requirements",
      "section": "5.1",
      "quote": "it is not necessary to support calculations across the entity (scheme and identifier) or unit aspects",
      "normalized_character_span": [
        26410,
        26511
      ]
    },
    {
      "id": "lexicographic-exclusion",
      "source": "02-requirements",
      "section": "5.2",
      "quote": "The group decided to not pursue this approach, as there are counter examples where this approach is not taken.",
      "normalized_character_span": [
        27041,
        27151
      ]
    },
    {
      "id": "weighted-member-modelling",
      "source": "02-requirements",
      "section": "5.3.1",
      "quote": "The group was of the view that the preferred modelling of this table would be to have separate concepts (metrics) representing the columns.",
      "normalized_character_span": [
        28336,
        28475
      ]
    },
    {
      "id": "typed-nil-exclusion",
      "source": "02-requirements",
      "section": "5.4",
      "quote": "Some implementations use a nil value on a typed dimension to represent a total, but clearer examples are needed to justify including this functionality as a requirement.",
      "normalized_character_span": [
        29587,
        29756
      ]
    },
    {
      "id": "filing-indicator-exclusion",
      "source": "02-requirements",
      "section": "5.5",
      "quote": "filing indicators are associated with tables defined in a taxonomy, rather than specific facts in a report, so completeness issues may still arise.",
      "normalized_character_span": [
        29990,
        30137
      ]
    },
    {
      "id": "formula-conversion",
      "source": "02-requirements",
      "section": "5.6",
      "quote": "but accepted that this may not be possible (or may require additional extension functions).",
      "normalized_character_span": [
        30715,
        30806
      ]
    },
    {
      "id": "history-first",
      "source": "02-requirements",
      "section": "Appendix B",
      "quote": "6 February 2019 Paul Warren First published version",
      "normalized_character_span": [
        33209,
        33260
      ]
    },
    {
      "id": "prior-11-exclusion",
      "source": "prior-11-requirements",
      "section": "4.1",
      "quote": "It should not attempt to introduce any new functionality, such as the ability to check cross-period or other cross-dimensional calculations.",
      "normalized_character_span": [
        9057,
        9197
      ]
    },
    {
      "id": "prior-11-intersection",
      "source": "prior-recommendation",
      "section": "5.5",
      "quote": "Where consistent duplicates are present, the calculation is performed using the intersection of fact value intervals for all facts within the set.",
      "normalized_character_span": [
        22462,
        22608
      ]
    }
  ],
