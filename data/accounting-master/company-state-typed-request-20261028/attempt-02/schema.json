{
  "type": "object",
  "properties": {
    "profile": {
      "const": "CompanyStateInspectionRequest/1"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "path_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "book": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity",
        "book",
        "currency"
      ],
      "additionalProperties": false
    },
    "information": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "use",
        "view"
      ],
      "additionalProperties": false
    },
    "joins": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "annual_report"
              },
              "period_start": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            },
            "required": [
              "id",
              "kind",
              "period_start"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "event_prefix"
              },
              "year_index": {
                "type": "integer",
                "minimum": 0
              },
              "operation_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "year_index",
              "operation_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "claim_history"
              },
              "claim_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "claim_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "asset_history"
              },
              "asset_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "asset_id"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "profile",
    "owner",
    "path_sha256",
    "source_sha256",
    "context",
    "information",
    "joins",
    "queries"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
