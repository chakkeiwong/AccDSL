{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "const": "RetainedCompanyInputReadinessDraft/1"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuer": {
      "const": "Apple"
    },
    "package_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "schema",
        "digest"
      ],
      "additionalProperties": false
    },
    "view_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "schema",
        "digest"
      ],
      "additionalProperties": false
    },
    "target": {
      "enum": [
        "CompanyOperationsDraft/1",
        "RetainedCompanyProgramDraft/1"
      ]
    },
    "target_implementation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "information_mode": {
      "const": "named_retained_sources"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "enum": [
              "identity",
              "context",
              "period",
              "information",
              "opening",
              "cash",
              "claims",
              "inventory",
              "assets",
              "debt",
              "funding",
              "tax",
              "behavior",
              "returns",
              "report_carry"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "const": "proposed_not_admitted"
          }
        },
        "required": [
          "id",
          "requirement_id",
          "statement",
          "provenance",
          "disposition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile",
    "packet_sha256",
    "issuer",
    "package_ref",
    "view_ref",
    "target",
    "target_implementation_sha256",
    "information_mode",
    "assumptions"
  ],
  "additionalProperties": false
}
