            end;
            input "previous_id";
              type {"kind":"text","context":{}};
              role state;
              source_ref "explicit query binding:previous_id";
            end;
            input "identity";
              type {"kind":"text","context":{}};
              role state;
              source_ref "explicit query binding:identity";
