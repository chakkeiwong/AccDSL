          path ["memory_definition","root","fields","claims"];
          values {"node":"record","fields":{"customer":{"node":"scalar","type":{"kind":"text","context":{}}},"due":{"node":"scalar","type":{"kind":"date","context":{}}},"issued":{"node":"scalar","type":{"kind":"date","context":{}}},"sale_event":{"node":"scalar","type":{"kind":"text","context":{}}},"remaining":{"node":"scalar","type":{"kind":"rational","context":{"entity":"Operating-alpha","book":"legal-alpha","case_id":"synthetic-cycle-alpha","mode":"synthetic"},"dimensions":{"currency:USD":1},"scale":"1/1"}},"assessed":{"node":"scalar","type":{"kind":"boolean","context":{}}},"assessment_date":{"node":"scalar","type":{"kind":"date","context":{}}},"assessed_remaining":{"node":"scalar","type":{"kind":"rational","context":{"entity":"Operating-alpha","book":"legal-alpha","case_id":"synthetic-cycle-alpha","mode":"synthetic"},"dimensions":{"currency:USD":1},"scale":"1/1"}},"overdue":{"node":"scalar","type":{"kind":"rational","context":{"entity":"Operating-alpha","book":"legal-alpha","case_id":"synthetic-cycle-alpha","mode":"synthetic"},"dimensions":{"currency:USD":1},"scale":"1/1"}},"current_term":{"node":"scalar","type":{"kind":"text","context":{}}},"latest_assessment":{"node":"scalar","type":{"kind":"text","context":{}}},"terms":{"node":"map","max_items":32,"values":{"node":"record","fields":{"due":{"node":"scalar","type":{"kind":"date","context":{}}},"effective":{"node":"scalar","type":{"kind":"date","context":{}}},"event_id":{"node":"scalar","type":{"kind":"text","context":{}}},"predecessor":{"node":"scalar","type":{"kind":"text","context":{}}},"premise":{"node":"scalar","type":{"kind":"text","context":{}}}}}},"assessments":{"node":"map","max_items":64,"values":{"node":"record","fields":{"term_id":{"node":"scalar","type":{"kind":"text","context":{}}},"as_of":{"node":"scalar","type":{"kind":"date","context":{}}},"remaining":{"node":"scalar","type":{"kind":"rational","context":{"entity":"Operating-alpha","book":"legal-alpha","case_id":"synthetic-cycle-alpha","mode":"syn