      template "QueryGuardedInvariant/1";
        context {"entity":"Operating-alpha","book":"legal-alpha","currency":"USD","case_id":"synthetic-cycle-alpha","mode":"synthetic"};
        manifest "MethodRequirements/3";
          method_id "finite.query.invariant";
          version "1";
          inputs;
            input "has_previous";
              type {"kind":"boolean","context":{}};
