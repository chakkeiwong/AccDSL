            end;
            requirements;
              requirement;
                id "positive_cost";
                guard (const {"kind":"boolean","context":{}} true);
                guard_requires [];
                predicate (lt (const {"kind":"rational","context":{"entity":"Operating-alpha","book":"legal-alpha","case_id":"synthetic-cycle-alpha","mode":"synthetic"},"dimensions":{"currency:USD":1,"goods:unit":-1},"scale":"1/1"} "0/1") (ref "cost"));
                requires ["cost"];
                admission_refs [];
