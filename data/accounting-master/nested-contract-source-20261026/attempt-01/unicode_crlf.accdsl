            version "1";
            inputs;
              input "cost";
                type {"kind":"rational","context":{"entity":"Operating-alpha","book":"legal-alpha","case_id":"synthetic-cycle-alpha","mode":"synthetic"},"dimensions":{"currency:USD":1,"goods:unit":-1},"scale":"1/1"};
                role state;
