'''
    out.joinpath("result.md").write_text(result_text)
    print(json.dumps({"passed":bool(passed), "tests":{k:{x:v[x] for x in ("methods","failures","errors","skips","passed")} for k,v in reports.items()}, "obligations":status, "protected":protected["passed"], "stable":stable}))
    return 0 if passed else 1


