    args = parser.parse_args(argv)
    out = Path(args.output_dir).resolve()
    if out != ROOT / "data/accounting-master/deliverables/P06":
        parser.error("use the declared P06 output directory")
    started = time.monotonic(); started_utc = datetime.now(timezone.utc).isoformat()
    phase_inventory = str(Path(args.execution_inventory).parent.parent / "phase-entry-inventory.json")
    try:
        approved = approval_reference(ROOT, args.approved_plan)
        protected = protection(ROOT, phase_inventory, args.execution_inventory)
    except (OSError, ValueError) as exc:
        parser.error(str(exc))
    code_before = {p: digest(ROOT / p) for p in SOURCES}
    os.environ["CUDA_VISIBLE_DEVICES"] = "-1"
    reports = {name: run_suite(name) for name in ("test_accounting_p06", "test_accounting_p03", "test_accounting_p04")}
    observations = probes()
    status = {"required": len(OBLIGATIONS), "observed": len(observations), "missing": sorted(set(OBLIGATIONS) - {x["id"] for x in observations}), "uncatalogued": sorted({x["id"] for x in observations} - set(OBLIGATIONS)), "duplicate_ids": [k for k, v in Counter(x["id"] for x in observations).items() if v != 1], "failed_observations": [x["id"] for x in observations if x.get("passed") is not True]}
    code_after = {p: digest(ROOT / p) for p in SOURCES}
    protected = finish_protection(ROOT, protected)
    stable = all(code_before[p] == code_after[p] for p in SOURCES)
    passed = (all(x["passed"] for x in reports.values()) and all(x.get("passed") for x in observations) and not status["missing"] and not status["uncatalogued"] and not status["duplicate_ids"] and protected["passed"] and stable and not args.inject_failure)
    command_args = sys.argv[1:] if argv is None else argv
    command = shlex.join(["CUDA_VISIBLE_DEVICES=-1", "python3", "-B", "scripts/check_accounting_p06.py"] + command_args)
    payload = {"schema_version":"accdsl.p06.conformance.v1", "passed": bool(passed), "profile":"context-chronology-resolution-v1", "obligation_status":status, "observations":observations, "tests":reports, "protection":protected, "code_stable_during_check":stable, "provenance":{"approved_plan":approved, "phase_entry_inventory":phase_inventory, "execution_inventory":args.execution_inventory}, "hashes":code_after, "manifest":{"git_commit":"unavailable: existing marker is not a usable repository", "command":command, "working_directory":str(ROOT), "executable":sys.executable, "environment":{"python":platform.python_version()}, "hardware":"CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported", "random_seeds":"N/A: exact deterministic fixtures", "data_version":"p06-context-chronology-cases-v1", "started_utc":started_utc, "wall_seconds":round(time.monotonic()-started, 6), "plan":args.approved_plan, "plan_sha256":approved["sha256"], "approved_plan_hash":approved["plan_hash"], "execution_inventory":args.execution_inventory, "outputs":OUTPUTS, "result":OUTPUTS[1], "phase_contribution_files":SOURCES + OUTPUTS}, "requirement_coverage":{"MC02":"context-aware mappings and explicit mismatch rejection", "MC05":"finite partition membership and overlap checks", "MC06":"chronology, availability and YTD selection", "MC07":"revision-compatible cumulative subtraction", "MC10":"six category uncertainty admission", "MC11":"query-bound unhedged bullet debt grouping", "MC14":"approximation certificate and error evidence"}, "acceptance":{"engineering":bool(passed), "accounting_validity":"not established", "forecast_validity":"not established", "human_acceptance":"pending", "whole_gap_closure":False}}
    out.mkdir(parents=True, exist_ok=True)
    out.joinpath("conformance.json").write_text(json.dumps(payload, indent=2, default=str) + "\n")
    decision = "PASS" if passed else "FAIL"
    result_text = f'''# P06 context, chronology, and resolution result

{decision}: {reports["test_accounting_p06"]["methods"]} P06 tests, {reports["test_accounting_p03"]["methods"]} P03 regression tests, and {reports["test_accounting_p04"]["methods"]} P04 regression tests executed. The conformance file records every test outcome, independent criterion probe, source hash, inventory comparison, command, and manifest.

The implementation supplies explicit context mappings, finite partition enumeration, supersession-DAG evidence selection, date-only next-local-midnight handling, revision-compatible YTD subtraction, six category-specific uncertainty admission, information-view guards, and query-signature-bound fixed-rate unhedged bullet-debt resolution. Exact Fraction arithmetic is used throughout the supported scalar path. An approximation is accepted only with a fixed-rate scope, declared tolerance, and a triangle-inequality error certificate.

