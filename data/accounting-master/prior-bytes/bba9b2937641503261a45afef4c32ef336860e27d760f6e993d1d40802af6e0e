def digest(path: Path) -> str | None:
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError:
        return None


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate key: " + key)
        result[key] = value
    return result


def inventory(root: Path, relative: str) -> dict[str, str]:
    path = Path(relative)
    if path.is_absolute() or ".." in path.parts or path.as_posix() != relative:
        raise ValueError("inventory path must be repository-relative")
    data = json.loads((root / path).read_text(), object_pairs_hook=unique_object)
    if not isinstance(data, dict) or not data:
        raise ValueError("inventory must be a nonempty path-to-SHA256 object")
    for name, value in data.items():
        p = Path(name)
        if p.is_absolute() or ".." in p.parts or p.as_posix() != name or not isinstance(value, str) or len(value) != 64:
            raise ValueError("invalid inventory entry: " + str(name))
    return data


def approval_reference(root: Path, relative: str) -> dict[str, str]:
    raw = (root / relative).read_bytes()
    record = json.loads(raw, object_pairs_hook=unique_object)
    if not isinstance(record, dict):
        raise ValueError("approved plan is not an object")
    for name, verdict in (("plan", "PLAN"), ("review", "AGREE")):
        section = record.get(name)
        if not isinstance(section, dict) or section.get("verdict") != verdict:
            raise ValueError(f"approved plan lacks {name} {verdict}")
        if not isinstance(section.get("summary"), str) or any(not isinstance(section.get(k), list) for k in ("steps", "assumptions", "checks", "evidence", "issues", "residuals", "next_actions")):
            raise ValueError("malformed approved plan")
    if record["review"].get("issues") != []:
        raise ValueError("approved plan has review issues")
    plan_hash = hashlib.sha256(json.dumps(record["plan"], sort_keys=True, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode()).hexdigest()
    if record.get("plan_hash") != plan_hash:
        raise ValueError("approved plan hash mismatch")
    return {"path": relative, "sha256": hashlib.sha256(raw).hexdigest(), "plan_hash": plan_hash}


def protection(root: Path, phase_inventory: str, execution_inventory: str) -> dict:
    historical = inventory(root, phase_inventory)
    execution = inventory(root, execution_inventory)
    protected = sorted((set(historical) | set(execution)) - WRITABLE)
    before = {p: digest(root / p) for p in protected}
    changed = [p for p in protected if before[p] != execution.get(p)]
    missing = [p for p, h in before.items() if h is None]
    return {"historical_inventory": phase_inventory, "execution_inventory": execution_inventory,
            "inventory_hashes": {phase_inventory: digest(root / phase_inventory), execution_inventory: digest(root / execution_inventory)},
            "excluded_phase_files": sorted(WRITABLE), "before": before, "execution_baseline": {p: execution.get(p) for p in protected},
            "changed_since_execution_entry": changed, "missing_before_check": missing,
            "historical_differences": [p for p in sorted(set(historical) & set(execution)) if historical[p] != execution[p]]}


def finish_protection(root: Path, report: dict) -> dict:
    report["after"] = {p: digest(root / p) for p in report["before"]}
    report["changed_during_check"] = [p for p in report["before"] if report["before"][p] != report["after"][p]]
    report["changed_inventory_records"] = [p for p, h in report["inventory_hashes"].items() if h is None or digest(root / p) != h]
    report["passed"] = not any(report[k] for k in ("changed_since_execution_entry", "missing_before_check", "changed_during_check", "changed_inventory_records"))
    return report


def run_suite(module_name: str) -> dict:
    sys.path.insert(0, str(ROOT / "tests"))
    stream = io.StringIO()
    try:
        module = __import__(module_name)
        suite = unittest.defaultTestLoader.loadTestsFromModule(module)
        result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)
        return {"module": module_name, "methods": result.testsRun, "failures": len(result.failures), "errors": len(result.errors), "skips": len(result.skipped), "passed": bool(result.wasSuccessful() and result.testsRun > 0 and not result.skipped), "output": stream.getvalue()}
    except Exception as exc:
        return {"module": module_name, "methods": 0, "failures": 0, "errors": 1, "skips": 0, "passed": False, "output": stream.getvalue() + repr(exc)}


def probes() -> list[dict]:
    """Independent criterion probes; expected values are computed here, not imported from tests."""
    from context_chronology_v1 import (Context, MappingRule, P06Error, check_partition, compatible_context,
                                        resolve_bullet_debt, select_evidence, subtract_cumulative, admit_uncertainty)
    rows = []
    def observe(identifier, fn):
        try:
            value = fn()
            rows.append({"id": identifier, "passed": bool(value is not False), "observed": value})
        except Exception as exc:
            rows.append({"id": identifier, "passed": False, "error": type(exc).__name__ + ": " + str(exc)})
    base = {"concept":"x", "entity":"A", "perimeter":"A", "perimeter_version":"1", "basis":"G", "measurement":"m", "unit":"USD", "currency":"USD", "calendar":"gregorian", "dimensions":{}, "gross_net":"gross"}
    observe("MC02", lambda: compatible_context(Context.from_dict(base), Context.from_dict({**base, "concept":"y"}), [MappingRule("x", "y", provenance=("probe",))])["kind"] == "equivalent")
    observe("MC05", lambda: check_partition(["a", "b"], {"left":["a"], "right":["b"]})["complete"])
    assertions = [{"id":"old", "available":"2025-01-01", "ingested":"2025-01-01", "supersedes":[], "source":"s"}, {"id":"new", "available":"2026-01-01", "ingested":"2026-01-01", "supersedes":["old"], "source":"s"}]
    observe("MC06", lambda: select_evidence(assertions, "2026-12-31", timezone_name="UTC", date_only_policy="next_local_midnight")["selected_ids"] == ["new"])
    observe("MC07", lambda: subtract_cumulative({"kind":"cumulative","amount":260,"concept":"x","context":{},"calendar":"g","revision_id":"r","period":{"start":"2025-01-01","end":"2025-12-31"}}, {"kind":"cumulative","amount":110,"concept":"x","context":{},"calendar":"g","revision_id":"r","period":{"start":"2025-01-01","end":"2025-06-30"}})["amount"] == 150)
    admission = {"id":"r","kind":"ExtractionReading","scope":"s","provenance":["p"],"dependencies":[],"source":"d","locator":"p1","review_decision":"Accept"}
    observe("MC10", lambda: admit_uncertainty(admission)["kind"] == "ExtractionReading")
    debt = [{"id":"a","principal":"100","rate":"1/20","maturity":"2"}, {"id":"b","principal":"50","rate":"7/100","maturity":"2"}]
    query = {"contract":"c","context":"x","evidence_view":"latest_available","horizon":"1","scenario":"base","requested_outputs":["interest"],"accrual_convention":"simple_actual_fraction","group_by":["rate","maturity","reset","hedge"]}
    observe("MC11", lambda: resolve_bullet_debt(debt, query)["outputs"]["interest"] == Fraction(17, 2))
    observe("MC14", lambda: (lambda x: x["approximation"]["bound"] == "3/2")(resolve_bullet_debt(debt, query, approximation={"target_rate":"0.06","tolerance":"2","error_bound":"3/2","scope":"fixed_rate_interest","evidence":["probe"]})))
    return rows


