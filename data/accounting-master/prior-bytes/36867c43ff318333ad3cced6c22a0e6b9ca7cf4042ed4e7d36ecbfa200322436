class P03Tests(unittest.TestCase):
    def record(self, case, **values):
        OBSERVATIONS.append(dict(id=case, passed=True, **values))

    def success(self, source, program, b, case, expected):
        before=ir.binding_projection(b); original=ir.binding_projection(program)
        a=compile_source(source,b); t=ir.compile_program(program,b)
        self.assertTrue(a.ok,[d.as_dict() for d in a.diagnostics]);self.assertTrue(t.ok,[d.as_dict() for d in t.diagnostics])
        self.assertEqual(a.semantic_projection,t.semantic_projection)
        self.assertEqual(a.binding_records,t.binding_records)
        self.assertEqual(before,ir.binding_projection(b));self.assertEqual(original,ir.binding_projection(program))
        self.assertEqual(a.ir,compile_source(source,b).ir)
        fields={v['name']:v['expression'] for v in a.ir['contracts'][0]['fields']}
        symbol=a.ir['symbols'][0]['id']; rates=[]
        for alpha in (1,0):
            ev=lambda eid:ir.evaluate_expression(a.ir,eid,{symbol:F(alpha)})
            principal=ev(fields['principal']); weight=ev(fields['fixed_fraction']); fixed=ev(fields['fixed_rate'])
            stress=ev(a.ir['scenarios'][0]['drivers'][0]['expression'])
            rates.append(principal*(weight*fixed+(1-weight)*stress))
        self.assertEqual(rates,list(map(F,expected)))
        fam=a.ir['historyFamilies'][0]
        self.assertEqual((fam['feasibility'],fam['coverage'],fam['completed_cells'],fam['unresolved_cells'],fam['witnesses'],fam['solver_results']),
                         ('Unknown','PartialSearch',0,1,[],[]))
        self.record(case,source=source,input_sha256=a.input_sha256,typed_sha256=t.input_sha256,
                    ir=a.ir,bindings=a.binding_records,source_map=dict(a.source_map),typed_source_map=dict(t.source_map),
                    expected_interest=list(map(str,expected)),observed_interest=list(map(str,rates)))
        return a

    def test_positive_pairs(self):
        for case,source,program,b,expect in [
          ('borrowing_baseline',BASE,typed(),bindings(),(5,7)),
          ('borrowing_stress_09',BASE.replace('0.07 per year','0.09 per year'),typed(stress=F(9,100)),bindings(),(5,9)),
          ('borrowing_principal_200',BASE.replace('= 100 USD','= 200 USD'),typed(200),bindings(200),(10,14)),
          ('renamed_independent',RENAMED,typed(150,F(8,100),True),bindings(150,True),(F(15,2),12)),
          ('borrowing_let_arithmetic',arithmetic_source(),typed(arithmetic=True),bindings(),(5,7))]:
            with self.subTest(case=case):
                result=self.success(source,program,b,case,expect)
                if case=='borrowing_let_arithmetic':
                    self.assertEqual(len(result.ir['historyFamilies'][0]['constraints']),1)
                    self.assertEqual([len(a['constraints']) for a in result.ir['alternatives']],[2,2])

