        r.ir['historyFamilies'][0]['constraints']=[]
        check=ir.validate_ir(r.ir,bindings());self.assertFalse(check.ok)
        self.assertEqual(check.diagnostics[0].code,'FamilyMembership')
        self.record('lost_global_constraint',diagnostics=[d.as_dict() for d in check.diagnostics])


