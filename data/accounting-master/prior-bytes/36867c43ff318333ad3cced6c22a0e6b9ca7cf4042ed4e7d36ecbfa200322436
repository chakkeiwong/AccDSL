                self.assertEqual(result.diagnostics[0].code,code)
                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])

    def test_typed_rejections(self):
        p=typed(); contract=next(d for d in p.declarations if isinstance(d,ir.ContractDecl))
        replacements={
          'typed_missing_rate_unit':('fixed_rate',ir.Literal(F(1,20)),'MissingRateUnit'),
          'typed_unknown_reference':('fixed_fraction',ir.Ref('absent'),'UnknownReference'),
          'typed_unsupported_call':('fixed_fraction',ir.Call('sqrt',[ir.Ref('alpha')]),'UnsupportedExpression'),
          'typed_float':('fixed_rate',ir.Literal(0.05,unit='per year'),'UnsupportedLiteral'),
          'typed_invalid_bounds':('fixed_fraction',ir.Binary('+',ir.Ref('alpha'),ir.Literal(F(1))),'ContractDomain'),
        }
        for name,(field,value,code) in replacements.items():
            with self.subTest(case=name):
                bad=replace(contract,fields=[(k,value if k==field else v) for k,v in contract.fields])
                result=ir.compile_program(replace(p,declarations=[bad if d is contract else d for d in p.declarations]),bindings())
                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)
                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])

