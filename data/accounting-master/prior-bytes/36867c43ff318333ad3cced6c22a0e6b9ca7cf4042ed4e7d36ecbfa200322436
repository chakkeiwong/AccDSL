def bindings(principal=100, renamed=False):
    """Explicit synthetic evidence, separately authored from source and expected IR."""
    p = F(principal); stamp = '2026-01-01T00:00:00Z'
    book, symbol = ('Statutory', 'share') if renamed else ('Local', 'alpha')
    names = ('fixed', 'floating') if renamed else ('allFixed', 'allFloating')
    package_path = ROOT / 'docs/design/fixtures/demo-debt-package.json'
    return ir.CompileBindings(
        packages=[ir.PackageBinding('DemoDebt', '1', hashlib.sha256(package_path.read_bytes()).hexdigest(),
            'DemoDebt', '2025-01-01', '2028-01-01', ['reset','accrue_and_pay','close','statements'],
            ['builtin:Core0@1','DemoCalendar@1'], ['fixture:demo-debt-package.json'])],
        readings=[ir.ReadingBinding('synthetic-note-7', f'Synthetic disclosed debt {p} USD; split undisclosed', p,
            'USD', '2025-12-31', 'fixture:p03-synthetic', 'synthetic-2025', stamp, stamp,
            'synthetic-author', stamp, 'Explicit synthetic acceptance, not human approval', stamp,
            system_as_of=stamp, action='Accept')],
        openings=[ir.OpeningBinding('after-2025-close', '2025-12-31',
            {'Cash':p-5, 'Debt':-p, 'InterestExpense':0, 'Retained':5}, book=book)],
        reports=[ir.ReportBinding('DemoDebt.statements.v1','DemoDebt.statements.v1',
            'interest_operating','close',['accrue_and_pay'])],
        assumptions=[ir.AssumptionBinding(k, 'Synthetic explicit '+k, information_cutoff=stamp,
            valid_start='2026-01-01',valid_end='2027-01-01')
            for k in ('alternative','constraint','contract-rate','scenario')],
        admissions=[ir.SymbolAdmission(symbol,'synthetic-note-7',REASON,'synthetic-author',stamp)],
        alternatives=[ir.AlternativeBinding(n,'synthetic-author',stamp,'Synthetic endpoint') for n in names],
        calendar_id='DemoCalendar@1',calendar_name='Gregorian',horizon_start='2026-01-01',
        horizon_end='2027-01-01',symbol_uncertainty='HistoricalFact',
        entity_perimeter='Beta-only' if renamed else 'Acme-only')


def typed(principal=100, stress=F(7,100), renamed=False, arithmetic=False):
    mod, ver, src, ent, book, opening, obs, sym, contract, a1, a0, scenario, report = (
        ('FinancingStudy','2','disclosure','Beta','Statutory','carried','borrowing','share','facility',
         'fixed','floating','shock','financials') if renamed else
        ('BorrowingExample','1','note7','Acme','Local','after2025','debt','alpha','loans',
         'allFixed','allFloating','rateShock','statements'))
    ds = [ir.SourceDecl(src,'synthetic-note-7'),ir.EntityDecl(ent,'USD'),ir.BookDecl(book,ent,'DemoDebt','1')]
    ds += [ir.AccountDecl(n,r,book) for n,r in [('Cash','Asset'),('Debt','Liability'),('InterestExpense','Expense'),('Retained','Equity')]]
    ds += [ir.OpeningDecl(opening,book,'after-2025-close'),
           ir.ObservationDecl(obs,'Money<USD>','2025-12-31',ir.Literal(F(principal),unit='USD'),src),
           ir.SymbolDecl(sym,'Real',ir.Literal(F(0)),ir.Literal(F(1)),REASON)]
    fraction = ir.Ref(sym)
    if arithmetic:
        ds += [ir.LetDecl('mix',ir.Binary('/',ir.Binary('*',ir.Ref(sym),ir.Literal(F(2))),ir.Literal(F(2)))),
               ir.ConstraintDecl('limit',ir.Binary('and',ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0))),
                    ir.Binary('<=',ir.Ref(sym),ir.Literal(F(1)))))]
        fraction=ir.Ref('mix')
    ds += [ir.ContractDecl(contract,'DebtMix',book,[('principal',ir.Call('value',[ir.Ref(obs)])),
           ('fixed_fraction',fraction),('fixed_rate',ir.Literal(F(1,20),unit='per year')),
           ('initial_floating_rate',ir.Literal(F(1,20),unit='per year'))])]
    for name,value in ((a1,1),(a0,0)):
        conds=[ir.Binary('==',ir.Ref(sym),ir.Literal(F(value)))]
        if arithmetic: conds += [ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0)))]
        ds.append(ir.AlternativeDecl(name,conds))
    ds += [ir.ScenarioDecl(scenario,[('market_rate',ir.Call('constant',[ir.Literal(F(stress),unit='per year')]))]),
           ir.ReportDecl(report,book,ir.External('DemoDebt.statements.v1'))]
    return ir.Program(mod,ver,ds,[ir.UseDecl('DemoDebt','1')])


