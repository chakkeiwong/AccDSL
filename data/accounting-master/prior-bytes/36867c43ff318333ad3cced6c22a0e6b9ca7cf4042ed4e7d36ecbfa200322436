    def test_schema_valid_corruptions(self):
        base=compile_source(BASE,bindings());self.assertTrue(base.ok)
        schema=json.loads((ROOT/'docs/design/spec/core-ir.schema.json').read_text())
        for name,(change,code) in IR_NEGATIVES.items():
            with self.subTest(case=name):
                bad=copy.deepcopy(base.ir);change(bad)
                jsonschema.Draft202012Validator(schema).validate(bad)
                result=ir.validate_ir(bad,bindings())
                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)
                self.record(name,schema_valid=True,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])

    def test_no_expected_fixture_input(self):
        original=Path.read_text
        def guarded(path,*a,**kw):
            if path.name in {'borrowing.ir.json','borrowing.expected.json','borrowings.json','core-ir-demo.json'}:
                raise AssertionError('Compiler tried reading expected fixture')
            return original(path,*a,**kw)
        with patch.object(Path,'read_text',guarded):
            self.assertTrue(ir.compile_program(typed(),bindings()).ok)
            self.assertTrue(compile_source(BASE,bindings()).ok)
        self.record('no_expected_fixture_input')


    def test_authored_fields_and_legacy_validation(self):
        from core_semantics import validate
        authored=json.loads((ROOT/'docs/design/fixtures/core-ir-demo.json').read_text())
        registry=json.loads((ROOT/'docs/design/fixtures/core-demo-registry.json').read_text())
        schema=json.loads((ROOT/'docs/design/spec/core-ir.schema.json').read_text())
        legacy=validate(authored,registry,schema,ROOT)
        self.assertEqual(legacy['status'],'passed',legacy)
        generated=compile_source(BASE,bindings()).ir
        for name in ('entity','perimeter','concept','basis','measurement','time','unit','currency','dimensions'):
            self.assertEqual(authored['contexts'][0][name],generated['contexts'][0][name])
        for name in ('lower','upper','kind','lower_closed','upper_closed'):
            self.assertEqual(authored['observations'][0]['domain'][name],generated['observations'][0]['domain'][name])
        for name in ('closing_policy','cash_flow_policy','required_operations'):
            self.assertEqual(authored['reportMappings'][0][name],generated['reportMappings'][0][name])
        for alpha in (0,1):
            for field in ('principal','fixed_fraction','fixed_rate','initial_floating_rate'):
                values=[]
                for doc in (authored,generated):
                    eid=next(f['expression'] for f in doc['contracts'][0]['fields'] if f['name']==field)
                    values.append(ir.evaluate_expression(doc,eid,{'alpha':F(alpha)}))
                self.assertEqual(*values)
        self.record('authored_fields_and_legacy',legacy=legacy)

    def test_unicode_and_global_preservation(self):
        left=compile_source(BASE+'\nlet caption = "caf\u00e9";',bindings())
        right=compile_source(BASE+'\nlet caption = "cafe\u0301";',bindings())
        self.assertTrue(left.ok); self.assertTrue(right.ok)
        self.assertEqual(left.semantic_projection,right.semantic_projection)
        self.assertNotEqual(left.input_sha256,right.input_sha256)
        self.record('unicode_normalization')
