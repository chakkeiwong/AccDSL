class CompileBindings:
    packages: tuple[PackageBinding, ...] = ()
    readings: tuple[ReadingBinding, ...] = ()
    openings: tuple[OpeningBinding, ...] = ()
    reports: tuple[ReportBinding, ...] = ()
    assumptions: tuple[AssumptionBinding, ...] = ()
