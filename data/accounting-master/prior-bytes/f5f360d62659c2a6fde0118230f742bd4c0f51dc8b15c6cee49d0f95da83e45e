def _empty_ir() -> dict[str, Any]:
    keys = [
        "models", "contexts", "sourceSpans", "documents", "observations", "narratives",
        "coverageUnits", "mappings", "partitions", "entities", "controls", "books", "accounts",
        "symbols", "choices", "expressions", "constraints", "assumptions", "alternatives",
        "contracts", "postings", "states", "events", "rules", "packages", "measurements",
        "journals", "scenarios", "informationViews", "reviewDecisions", "evidenceViews",
        "modelScopes", "historyFamilies", "probabilityModels", "reportMappings", "resultCells",
        "branchResults", "runs", "diagnostics",
    ]
    out = {k: [] for k in keys}
    out["schema_version"] = "0.1"
    return out


def _diag(code: str, message: str, location: str, capability: Optional[str] = None,
          span: Optional[tuple[int, int]] = None) -> _Failure:
    return _Failure(Diagnostic(code, message, location, capability=capability, span=span))


class _Compiler:
    def __init__(self, program: Program, bindings: CompileBindings,
                 source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,
                 input_text: Optional[str] = None):
        self.program = program
        self.bindings = bindings
        self.source_spans = source_spans or {}
        self.input_text = input_text
        self.ir = _empty_ir()
        self.source_map: dict[str, dict[str, Any]] = {}
        self.expr_rows: dict[str, dict[str, Any]] = {}
        self.expr_info: dict[str, tuple[str, Optional[str], Any]] = {}
        self.decls: dict[str, Any] = {}
        self.lets: dict[str, LetDecl] = {}
        self.let_ids: dict[str, str] = {}
        self.lowering_lets: set[str] = set()
        self.observations: dict[str, ObservationDecl] = {}
        self.symbols: dict[str, SymbolDecl] = {}
        self.sources: dict[str, SourceDecl] = {}
        self.entities: dict[str, EntityDecl] = {}
        self.books: dict[str, BookDecl] = {}
        self.accounts: dict[str, AccountDecl] = {}
        self.openings: dict[str, OpeningDecl] = {}
        self.contracts: dict[str, ContractDecl] = {}
        self.alternatives: dict[str, AlternativeDecl] = {}
        self.scenarios: dict[str, ScenarioDecl] = {}
        self.reports: dict[str, ReportDecl] = {}
        self.constraints: dict[str, ConstraintDecl] = {}
        self.package: Optional[PackageBinding] = None
        self.entity: Optional[EntityDecl] = None
        self.book: Optional[BookDecl] = None
        self.scope_id = f"scope:{_clean_id(program.module)}@{_clean_id(program.version)}"
        self.model_id = f"{program.module}@{program.version}"

    def fail(self, code: str, message: str, location: str, capability: Optional[str] = None,
             node: Any = None) -> None:
        span = None
        if node is not None and id(node) in self.source_spans:
            item = self.source_spans[id(node)]
            span = (item.get("start", 0), item.get("end", 0))
        raise _diag(code, message, location, capability, span)

    def collect(self) -> None:
        if not self.program.module or not self.program.version:
            self.fail("InvalidModule", "module name and version are required", "module")
        reserved = {
            "module", "version", "use", "source", "entity", "functional", "book", "basis",
            "account", "opening", "observation", "instant", "period", "symbol", "in", "because",
            "choice", "binding", "let", "constraint", "alternative", "assume", "contract", "event",
            "rule", "for", "as", "when", "require", "post", "scenario", "set", "report", "from",
            "to", "true", "false", "and", "or", "not", "debit", "credit",
        }
        declared_uses = tuple(d for d in self.program.declarations if isinstance(d, UseDecl))
        all_uses = tuple(self.program.uses) + declared_uses
        seen_use_ids: set[str] = set()
        for use in all_uses:
            self._check_name(use.name, "use", reserved)
            if (use.name, use.version) in seen_use_ids:
                self.fail("DuplicateDeclaration", f"duplicate package use {use.name!r}", use.name)
            seen_use_ids.add((use.name, use.version))
            try:
                package = self.bindings.package(use.name, use.version)
            except _Failure:
                raise
            if self.package is not None and self.package.id != package.id:
                self.fail("PackageCollision", "multiple package bases are outside Core0.1", use.name)
            self.package = package
        for decl in self.program.declarations:
            if isinstance(decl, UseDecl):
                # A use is allowed either in Program.uses or declarations, but
                # it must not be silently duplicated.
                continue
            if isinstance(decl, UnsupportedDecl):
                self.fail("UnsupportedDeclaration", f"{decl.kind} is outside Core0.1", decl.name or decl.kind,
                          capability=decl.kind)
            name = getattr(decl, "name", None)
            if name:
                self._check_name(name, type(decl).__name__, reserved)
                if name in self.decls:
                    self.fail("DuplicateDeclaration", f"duplicate declaration {name!r}", name)
                self.decls[name] = decl
            if isinstance(decl, SourceDecl):
                self.sources[decl.name] = decl
            elif isinstance(decl, EntityDecl):
                self.entities[decl.name] = decl
            elif isinstance(decl, BookDecl):
                self.books[decl.name] = decl
            elif isinstance(decl, AccountDecl):
                self.accounts[decl.name] = decl
            elif isinstance(decl, OpeningDecl):
                self.openings[decl.name] = decl
            elif isinstance(decl, ObservationDecl):
                self.observations[decl.name] = decl
            elif isinstance(decl, SymbolDecl):
                self.symbols[decl.name] = decl
            elif isinstance(decl, LetDecl):
                self.lets[decl.name] = decl
            elif isinstance(decl, ConstraintDecl):
                self.constraints[decl.name] = decl
            elif isinstance(decl, ContractDecl):
                self.contracts[decl.name] = decl
            elif isinstance(decl, AlternativeDecl):
                self.alternatives[decl.name] = decl
            elif isinstance(decl, ScenarioDecl):
                self.scenarios[decl.name] = decl
            elif isinstance(decl, ReportDecl):
                self.reports[decl.name] = decl
            else:
                self.fail("UnsupportedDeclaration", f"{type(decl).__name__} is outside Core0.1", str(decl))
        # A typed program may pass uses separately; source frontend does this.
        if self.package is None and all_uses:
            self.fail("MissingPackageBinding", "a Core0.1 program requires one package use", "use")
        if self.package is None:
            self.fail("MissingPackageBinding", "a Core0.1 program requires one package use", "use")
        if len(self.entities) != 1 or len(self.books) != 1:
            self.fail("ProfileCardinality", "Core0.1 requires exactly one entity and one book", "profile")
        if len(self.observations) < 1 or len(self.symbols) < 1 or len(self.contracts) != 1:
            self.fail("ProfileCardinality", "Core0.1 requires an observation, symbol and one contract", "profile")
        if len(self.openings) != 1 or len(self.reports) != 1 or len(self.scenarios) != 1:
            self.fail("ProfileCardinality", "Core0.1 requires one opening, scenario and report", "profile")
        if len(self.alternatives) < 1:
            self.fail("ProfileCardinality", "Core0.1 requires at least one named alternative", "profile")
        self.entity = next(iter(self.entities.values()))
        self.book = next(iter(self.books.values()))
        if self.book.entity != self.entity.name:
            self.fail("BindingMismatch", "book entity must name the declared entity", self.book.name)
        if self.book.basis != self.package.name or self.book.version != self.package.version:
            self.fail("PackageBinding", "book basis/version must match the locked package", self.book.name)

    @staticmethod
    def _check_name(name: str, where: str, reserved: set[str]) -> None:
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise _diag("InvalidIdentifier", f"invalid identifier {name!r}", where)
        if name in reserved:
            raise _diag("ReservedIdentifier", f"reserved keyword {name!r} cannot be declared", where)

    def _external_ids(self) -> dict[str, Any]:
        return {
            **{r.key: r for r in self.bindings.readings},
            **{o.key: o for o in self.bindings.openings},
            **{r.key: r for r in self.bindings.reports},
        }

    def _expr_id(self, owner: str, path: str) -> str:
        return f"expr:{_clean_id(owner)}:{_clean_id(path)}"

    def _record_source(self, expr_id: str, expr: Any, owner: str, path: str) -> None:
        item = self.source_spans.get(id(expr))
        if item:
            self.source_map[expr_id] = dict(item, owner=owner, path=path)

    def _add_expr(self, expr_id: str, row: dict[str, Any], typ: str,
                  context: Optional[str], value: Any = None, expr: Any = None,
                  owner: str = "", path: str = "") -> tuple[str, str, Optional[str], Any]:
        if expr_id in self.expr_rows:
            prior = self.expr_rows[expr_id]
            if prior != row:
                self.fail("ExpressionIdentityCollision", f"two expressions map to {expr_id}", expr_id)
            return expr_id, typ, context, value
        self.expr_rows[expr_id] = row
        self.expr_info[expr_id] = (typ, context, value)
        self._record_source(expr_id, expr, owner, path)
        return expr_id, typ, context, value

    def _lookup_type(self, name: str) -> tuple[str, Optional[str], Any]:
        if name in self.let_ids:
            return self.expr_info[self.let_ids[name]]
        if name in self.observations:
            obs = self.observations[name]
            ctx = f"context:{_clean_id(obs.name)}"
            return f"Observation<{obs.type_name}>", ctx, None
        if name in self.symbols:
            return self.symbols[name].type_name, None, None
        self.fail("UnknownReference", f"reference {name!r} is not declared", name)

    def _constant(self, expr_id: str) -> Optional[Fraction]:
        if expr_id not in self.expr_info:
            return None
        value = self.expr_info[expr_id][2]
        return value if isinstance(value, Fraction) else None

    def lower_expr(self, expr: Expr, owner: str, path: str,
                   expected: Optional[str] = None) -> tuple[str, str, Optional[str], Any]:
        expr_id = self._expr_id(owner, path)
        if isinstance(expr, Literal):
            value = expr.value
            typ = expr.type_name
            unit = expr.unit
            display = expr.display
            if isinstance(value, bool):
                typ = typ or "Bool"
                text = "true" if value else "false"
                row = dict(id=expr_id, op="literal", type=typ, context=None, args=[], rational=None,
                           text=text, target=None, field_names=[])
                return self._add_expr(expr_id, row, typ, None, value, expr, owner, path)
            if isinstance(value, Fraction) or isinstance(value, (int, Decimal)):
                q = _fraction(value)
                if unit == "per year":
                    typ = typ or "Rate<annual_simple>"
                elif unit:
                    if not re.fullmatch(r"[A-Z]{3}", unit):
                        self.fail("UnsupportedUnit", f"unit {unit!r} is outside Core0.1", owner)
                    typ = typ or f"Money<{unit}>"
                else:
                    if expected and expected.startswith("Rate<"):
                        self.fail("MissingRateUnit", "annual rates require the explicit `per year` unit", owner, "rate", expr)
                    typ = typ or "Real"
                if typ == "Int" and q.denominator != 1:
                    self.fail("TypeMismatch", "fractional literal cannot have Int type", owner, node=expr)
                context = None
                row = dict(id=expr_id, op="literal", type=typ, context=context, args=[], rational=rational(q),
                           text=None, target=None, field_names=[])
                return self._add_expr(expr_id, row, typ, context, q, expr, owner, path)
            if isinstance(value, str):
                if value.startswith("@"):
                    _iso(value[1:], owner)
                    typ = typ or "Date"
                else:
                    typ = typ or "String"
                row = dict(id=expr_id, op="literal", type=typ, context=None, args=[], rational=None,
                           text=value, target=None, field_names=[])
                return self._add_expr(expr_id, row, typ, None, value, expr, owner, path)
            self.fail("UnsupportedLiteral", f"literal {type(value).__name__} is outside Core0.1", owner, node=expr)
        if isinstance(expr, External):
            # External source references are admitted only by declaration-level
            # handlers.  Keeping this operation explicit prevents accidental
            # fixture or filesystem lookup from an arbitrary expression.
            self.fail("UnsupportedExternalExpression", "external references are only valid in source/opening/report declarations", owner, "external", expr)
        if isinstance(expr, Ref):
            if expr.name in self.lets and expr.name not in self.let_ids:
                self._lower_let(expr.name)
            typ, context, value = self._lookup_type(expr.name)
            if expr.name in self.lets:
                target = self.let_ids[expr.name]
            else:
                target = expr.name
            row = dict(id=expr_id, op="ref", type=typ, context=context, args=[], rational=None,
                       text=None, target=target, field_names=[])
            return self._add_expr(expr_id, row, typ, context, value, expr, owner, path)
        if isinstance(expr, Call):
            args = [self.lower_expr(a, owner, f"{path}.arg{i}") for i, a in enumerate(expr.args)]
            if expr.name == "value":
                if len(args) != 1 or not args[0][1].startswith("Observation<"):
                    self.fail("TypeMismatch", "value requires exactly one observation", owner, node=expr)
                typ = args[0][1][12:-1]
                context = args[0][2]
                target = "builtin:value@1"
            elif expr.name == "constant":
                if len(args) != 1 or not args[0][1].startswith("Rate<"):
                    self.fail("TypeMismatch", "constant requires one explicitly annual rate", owner, node=expr)
                typ = f"Driver<{args[0][1]}>"
                context = args[0][2]
                target = "builtin:constant@1"
            else:
                self.fail("UnsupportedExpression", f"call {expr.name!r} is not admitted in Core0.1", owner,
                          capability=f"call:{expr.name}", node=expr)
            row = dict(id=expr_id, op="call", type=typ, context=context,
                       args=[a[0] for a in args], rational=None, text=None, target=target, field_names=[])
            return self._add_expr(expr_id, row, typ, context, args[0][3] if args else None, expr, owner, path)
        if isinstance(expr, Unary):
            arg = self.lower_expr(expr.arg, owner, f"{path}.arg0")
            if expr.op == "not":
                if arg[1] != "Bool":
                    self.fail("TypeMismatch", "not requires a Boolean operand", owner, node=expr)
                typ, value = "Bool", (not arg[3]) if isinstance(arg[3], bool) else None
            elif expr.op == "-":
                if not _numeric_type(arg[1]):
                    self.fail("TypeMismatch", "negation requires a numeric operand", owner, node=expr)
                typ, value = arg[1], (-arg[3]) if isinstance(arg[3], Fraction) else None
            else:
                self.fail("UnsupportedExpression", f"unary operator {expr.op!r} is unsupported", owner, node=expr)
            row = dict(id=expr_id, op="not" if expr.op == "not" else "negate", type=typ,
                       context=arg[2], args=[arg[0]], rational=None, text=None, target=None, field_names=[])
            return self._add_expr(expr_id, row, typ, arg[2], value, expr, owner, path)
        if isinstance(expr, Binary):
            left = self.lower_expr(expr.left, owner, f"{path}.left")
            right = self.lower_expr(expr.right, owner, f"{path}.right")
            op = expr.op
            context = _merge_context(left[2], right[2], owner, self)
            if op in {"and", "or"}:
                if left[1] != right[1] or left[1] != "Bool":
                    self.fail("TypeMismatch", "Boolean operands are required", owner, node=expr)
                typ, value = "Bool", _fold_bool(op, left[3], right[3])
            elif op in {"==", "!=", "<", "<=", ">", ">="}:
                if left[1] != right[1]:
                    self.fail("TypeMismatch", "comparison operands must have identical types", owner, node=expr)
                typ, value = "Bool", _compare(op, left[3], right[3])
            elif op in {"+", "-"}:
                if left[1] != right[1] or not _numeric_type(left[1]):
                    self.fail("TypeMismatch", "addition/subtraction requires compatible numeric quantities", owner, node=expr)
                typ, value = left[1], _arithmetic(op, left[3], right[3])
            elif op == "*":
                if not _numeric_type(left[1]) or not _numeric_type(right[1]):
                    self.fail("TypeMismatch", "multiplication requires numeric quantities", owner, node=expr)
                if _is_scalar(left[1]) and not _is_scalar(right[1]):
                    typ = right[1]
                elif _is_scalar(right[1]) and not _is_scalar(left[1]):
                    typ = left[1]
                elif _is_scalar(left[1]) and _is_scalar(right[1]):
                    typ = "Real"
                else:
                    self.fail("UnsupportedOperation", "product of two dimensional quantities is outside Core0.1", owner, "multiply", expr)
                value = _arithmetic(op, left[3], right[3])
            elif op == "/":
                if not _numeric_type(left[1]) or not _numeric_type(right[1]):
                    self.fail("TypeMismatch", "division requires numeric quantities", owner, node=expr)
                denominator = right[3]
                if not isinstance(denominator, Fraction) or denominator == 0:
                    self.fail("UnprovedNonzeroDenominator", "division denominator must be a nonzero constant", owner, "divide", expr)
                if not _is_scalar(right[1]):
                    self.fail("UnsupportedOperation", "division by a dimensional quantity is outside Core0.1", owner, "divide", expr)
                typ = left[1] if not _is_scalar(left[1]) else "Real"
                value = _arithmetic(op, left[3], right[3])
            else:
                self.fail("UnsupportedExpression", f"operator {op!r} is unsupported", owner, capability=f"operator:{op}", node=expr)
            row = dict(id=expr_id, op=_IR_OPS[op], type=typ, context=context,
                       args=[left[0], right[0]], rational=None, text=None, target=None, field_names=[])
            return self._add_expr(expr_id, row, typ, context, value, expr, owner, path)
        if isinstance(expr, (ArrayExpr, RecordExpr)):
            self.fail("UnsupportedExpression", "arrays and records are outside Core0.1", owner,
                      capability=type(expr).__name__, node=expr)
        self.fail("UnsupportedExpression", f"unknown typed expression {type(expr).__name__}", owner, node=expr)

    def _lower_let(self, name: str) -> None:
        if name in self.let_ids:
            return
        if name in self.lowering_lets:
            self.fail("ExpressionCycle", f"cyclic let binding involving {name!r}", name)
        decl = self.lets.get(name)
        if decl is None:
            self.fail("UnknownReference", f"unknown let binding {name!r}", name)
        self.lowering_lets.add(name)
        expr_id, typ, context, _ = self.lower_expr(decl.value, f"let:{name}", "value", decl.declared_type)
        if decl.declared_type and decl.declared_type != typ:
            self.fail("TypeMismatch", f"let {name!r} declares {decl.declared_type}, inferred {typ}", name)
        self.let_ids[name] = expr_id
        self.lowering_lets.remove(name)

    def _external(self, key: str, where: str) -> Any:
        if key in {r.key for r in self.bindings.readings}:
            return self.bindings.reading(key)
        if key in {o.key for o in self.bindings.openings}:
            return self.bindings.opening(key)
        if key in {r.key for r in self.bindings.reports}:
            return self.bindings.report(key)
        self.fail("MissingExternalBinding", f"external export {key!r} is not supplied", where)

    def _lower_source_metadata(self) -> tuple[dict[str, str], dict[str, str], dict[str, str]]:
        source_keys: dict[str, str] = {}
        for name, decl in self.sources.items():
            source_keys[name] = decl.external
            self._external(decl.external, name)
        return source_keys, {}, {}

    def _build_evidence(self, source_keys: Mapping[str, str]) -> dict[str, tuple[str, str, str]]:
        # Return source-key -> (document, span, view) IDs.
        out: dict[str, tuple[str, str, str]] = {}
        for key in sorted(set(source_keys.values())):
            reading = self.bindings.reading(key)
            _instant(reading.available, f"reading:{key}.available")
            _instant(reading.ingested, f"reading:{key}.ingested")
            _instant(reading.review_date, f"reading:{key}.review_date")
            _instant(reading.cutoff, f"reading:{key}.cutoff")
            _iso(reading.instant, f"reading:{key}.instant")
            if reading.system_as_of is not None:
                _instant(reading.system_as_of, f"reading:{key}.system_as_of")
            document_id = f"document:{_clean_id(key)}"
            span_id = f"span:{_clean_id(key)}"
            reading_id = f"reading:{_clean_id(key)}"
            review_id = f"review:{_clean_id(key)}"
            view_id = f"evidence:{_clean_id(key)}"
            self.ir["sourceSpans"].append({
                "id": span_id, "document": document_id, "locator": f"binding:{key}",
                "literal": reading.literal, "extraction": reading.extraction,
            })
            self.ir["documents"].append({
                "id": document_id, "sha256": hashlib.sha256(reading.literal.encode("utf-8")).hexdigest(),
                "uri": reading.uri, "filing_id": reading.filing_id, "available": reading.available,
                "availability_policy": "explicit_binding_timestamp", "ingested": reading.ingested,
            })
            self.ir["reviewDecisions"].append({
                "id": review_id, "reading_ids": [reading_id], "action": "Accept",
                "reviewer": reading.reviewer, "date": reading.review_date,
                "reason": reading.review_reason, "evidence": [span_id],
                "prior_view": reading.prior_view, "new_view": view_id,
                "invalidated_descendants": [],
            })
            self.ir["evidenceViews"].append({
                "id": view_id, "cutoff": reading.cutoff, "system_as_of": reading.system_as_of,
                "mode": "ExplicitSelection", "documents": [document_id], "observations": [],
                "decisions": [review_id], "conflict_sets": [], "transforms": [],
            })
            out[key] = (document_id, span_id, view_id)
            # The reading object is a small external export represented by the
            # binding.  It is referenced by observations but is not embedded as
            # an executable package or expected-result fixture.
            self._reading_ids[key] = reading_id
        return out

    def build(self) -> CompileResult:
        self.collect()
        source_keys, _, _ = self._lower_source_metadata()
        self._reading_ids: dict[str, str] = {}
        evidence = self._build_evidence(source_keys)
        assert self.entity is not None and self.book is not None and self.package is not None
        entity = self.entity
        book = self.book
        package = self.package
        model_scope = self.scope_id
        # Core declarations and package context.
        self.ir["entities"].append({"id": entity.name, "functional_currency": entity.currency})
        self.ir["packages"].append({
            "id": package.id, "version": package.version, "digest": package.digest,
            "basis": package.basis,
            "effective": _time("interval", package.effective_start, package.effective_end, self.bindings.calendar_id),
            "operations": [f"{package.id}/{x}" for x in package.operations],
            "extension_points": [], "dependencies": list(package.dependencies),
            "authority": list(package.authority), "review_status": package.review_status,
            "implementation": package.implementation,
        })
        self.ir["books"].append({"id": book.name, "entity": book.entity, "basis": package.id,
                                  "package": package.id, "currency": entity.currency})
        for account in self.accounts.values():
            if account.book != book.name:
                self.fail("BindingMismatch", "all accounts must belong to the declared book", account.name)
            if account.role not in {"Asset", "Liability", "Expense", "Equity"}:
                self.fail("UnsupportedAccountRole", f"account role {account.role!r} is outside profile", account.name)
            self.ir["accounts"].append({"id": account.name, "book": account.book,
                                         "role": account.role, "report_concept": account.name})
        # Time/context and observations.
        observation_contexts: dict[str, str] = {}
        for obs in self.observations.values():
            if not obs.type_name.startswith("Money<"):
                self.fail("UnsupportedObservationType", "Core0.1 observations are monetary", obs.name)
            currency = obs.type_name[6:-1]
            if currency != entity.currency:
                self.fail("ContextMismatch", "observation currency must match the entity currency", obs.name)
            key = source_keys.get(obs.source)
            if key is None:
                self.fail("UnknownReference", f"observation source {obs.source!r} is not a source alias", obs.name)
            reading = self.bindings.reading(key)
            if _fraction(_literal_value(obs.value, obs.name)) != reading.amount:
                self.fail("SourceReadingMismatch", "surface observation and bound reading disagree", obs.name)
            if reading.currency != currency or reading.instant != obs.instant:
                self.fail("ReadingContextMismatch", "bound reading does not match observation context", obs.name)
            context_id = f"context:{_clean_id(obs.name)}"
            observation_contexts[obs.name] = context_id
            self.ir["contexts"].append({
                "id": context_id, "entity": entity.name, "perimeter": self.bindings.entity_perimeter,
                "concept": "debt_principal", "basis": package.id, "measurement": "principal",
                "time": _time("instant", obs.instant, None, self.bindings.calendar_id),
                "unit": currency, "currency": currency, "taxonomy_version": None, "dimensions": [],
            })
            document_id, span_id, view_id = evidence[key]
            reading_id = self._reading_ids[key]
            review_id = f"review:{_clean_id(key)}"
            self.ir["observations"].append({
                "id": obs.name, "context": context_id, "domain": {
                    "kind": "exact", "lower": rational(reading.amount), "upper": rational(reading.amount),
                    "lower_closed": True, "upper_closed": True, "values": [], "missing_reason": None,
                    "display": obs.value.display or f"{reading.amount} {currency}",
                    "rounding_rule": "exact_binding",
                }, "source_spans": [span_id], "reading": reading_id,
                "review_decision": review_id, "supersedes": [], "revision_group": f"binding-{_clean_id(key)}",
            })
            for view in self.ir["evidenceViews"]:
                if view["id"] == view_id:
                    view["observations"].append(obs.name)
        # Symbols and declarations.
        for symbol in self.symbols.values():
            if symbol.type_name != "Real":
                self.fail("UnsupportedSymbol", "Core0.1 admits one Real interval symbol", symbol.name)
            low = self.lower_expr(symbol.lower, f"symbol:{symbol.name}", "lower", "Real")
            high = self.lower_expr(symbol.upper, f"symbol:{symbol.name}", "upper", "Real")
            if low[3] is None or high[3] is None or low[3] > high[3]:
                self.fail("InvalidDomain", "symbol bounds must be ordered constants", symbol.name)
            source_key = next(iter(source_keys.values()))
            span_id = evidence[source_key][1]
            self.ir["symbols"].append({
                "id": symbol.name, "type": symbol.type_name, "context": None,
                "domain": {"kind": "interval", "lower": rational(low[3]), "upper": rational(high[3]),
                            "lower_closed": True, "upper_closed": True, "values": [],
                            "missing_reason": None, "display": None, "rounding_rule": None},
                "uncertainty_kind": self.bindings.symbol_uncertainty, "scope": self.model_id,
                "dependencies": [], "admission": f"review:{_clean_id(source_key)}", "provenance": [span_id],
            })
        for name in self.lets:
            self._lower_let(name)
        # Contract, alternatives, and scenario expressions.
        contract = next(iter(self.contracts.values()))
        fields = dict(contract.fields)
        required_fields = {"principal", "fixed_fraction", "fixed_rate", "initial_floating_rate"}
        if set(fields) != required_fields:
            self.fail("ContractFields", "DebtMix requires principal, fraction and two rates", contract.name)
        field_rows = []
        for name in ("principal", "fixed_fraction", "fixed_rate", "initial_floating_rate"):
            expected = {"principal": f"Money<{entity.currency}>", "fixed_fraction": "Real",
                        "fixed_rate": "Rate<annual_simple>", "initial_floating_rate": "Rate<annual_simple>"}[name]
            info = self.lower_expr(fields[name], f"contract:{contract.name}", f"field:{name}", expected)
            if info[1] != expected:
                self.fail("ContractType", f"field {name!r} has type {info[1]}, expected {expected}", contract.name)
            if name in {"fixed_rate", "initial_floating_rate"}:
                self._assumption_row(f"contract:{contract.name}:{name}", info[0], contract.name, evidence)
            field_rows.append({"name": name, "expression": info[0]})
        self.ir["contracts"].append({"id": contract.name, "type": f"{package.id}/{contract.type_name}",
                                      "book": contract.book, "fields": field_rows, "package": package.id,
                                      "source_refs": [evidence[next(iter(source_keys.values()))][1]]})
        alt_ids = []
        constraint_ids = []
        for alt in self.alternatives.values():
            alt_ids.append(alt.name)
            alt_constraints = []
            for index, assumption in enumerate(alt.assumptions):
                eid = self.lower_expr(assumption, f"alternative:{alt.name}", f"assumption:{index}")[0]
                cid = f"constraint:{_clean_id(alt.name)}:{index}"
                self.ir["constraints"].append({"id": cid, "expression": eid, "kind": "assumption",
                                                "scope": alt.name, "source_refs": []})
                alt_constraints.append(cid); constraint_ids.append(cid)
                self._assumption_row(f"alternative:{alt.name}", eid, alt.name, evidence)
            if not alt_constraints:
                self.fail("MissingAlternativeCondition", "named alternatives require a Boolean condition", alt.name)
            self.ir["alternatives"].append({
                "id": alt.name, "parent": f"history:{_clean_id(self.model_id)}", "scope": model_scope,
                "author": self.bindings.reading(next(iter(source_keys.values()))).reviewer,
                "created_at": self.bindings.reading(next(iter(source_keys.values()))).review_date,
                "constraints": alt_constraints, "choice_group": None,
                "reason": "Named conditional alternative supplied by the program", "evidence": [evidence[next(iter(source_keys.values()))][1]],
                "opposing_evidence": [],
            })
        scenario = next(iter(self.scenarios.values()))
        settings = dict(scenario.settings)
        if set(settings) != {"market_rate"}:
            self.fail("ScenarioFields", "Core0.1 scenario requires one market_rate setting", scenario.name)
        driver = self.lower_expr(settings["market_rate"], f"scenario:{scenario.name}", "market_rate")
        if not driver[1].startswith("Driver<Rate<"):
            self.fail("ScenarioType", "market_rate must be a constant annual rate driver", scenario.name)
        self._assumption_row(f"scenario:{scenario.name}", driver[0], scenario.name, evidence)
        self.ir["scenarios"].append({"id": scenario.name, "kind": "ExogenousStress",
                                      "drivers": [{"name": "market_rate", "expression": driver[0]}],
                                      "probability_model": None, "observed_event": None, "structural_model": None,
                                      "replaced_equations": [], "visibility": "announced"})
        # Opening state and report mapping.
        opening_decl = next(iter(self.openings.values()))
        opening = self.bindings.opening(opening_decl.external)
        if opening.book is not None and opening.book != opening_decl.book:
            self.fail("OpeningStateMismatch", "opening binding belongs to another book", opening_decl.name)
        account_names = {a.name for a in self.accounts.values()}
        bound_names = {name for name, _ in opening.balances}
        if account_names != bound_names:
            self.fail("OpeningStateMismatch", "opening binding must provide every account exactly once", opening_decl.name)
        total = sum((value for _, value in opening.balances), Fraction(0))
        if total != 0:
            self.fail("UnbalancedState", "opening signed balances must sum to zero", opening_decl.name)
        self.ir["states"].append({"id": opening_decl.name, "date": _iso(opening.date, opening_decl.name),
                                   "book": opening_decl.book,
                                   "balances": [{"account": name, "signed_amount": rational(value)} for name, value in opening.balances],
                                   "contracts": [contract.name], "measurements": [],
                                   "dependencies": list(opening.dependencies) or [evidence[next(iter(source_keys.values()))][2]]})
        report = next(iter(self.reports.values()))
        rb = self.bindings.report(report.mapping.key if isinstance(report.mapping, External) else str(report.mapping)) if isinstance(report.mapping, External) else None
        if rb is None:
            self.fail("UnsupportedReportMapping", "report mapping must be an explicit external binding", report.name)
        self.ir["reportMappings"].append({"id": report.name, "book": report.book, "basis": package.id,
                                          "rows": [{"name": "package_mapping", "expression": self._source_ref_expr(rb.mapping, report.name)}],
                                          "closing_policy": f"{package.id}/{rb.closing_policy}",
                                          "cash_flow_policy": f"{package.id}/{rb.cash_flow_policy}",
                                          "required_operations": [f"{package.id}/{x}" for x in rb.required_operations]})
        # Profile scope and conservative family status.  This profile does not
        # perform a reconstruction or feasibility search.
        slot = self._literal_expr("scope", "slot_limit", 1, "Int")
        self.ir["modelScopes"].append({"id": model_scope, "templates": [f"{package.id}/{contract.type_name}"],
                                       "slot_limits": [{"name": "debt_contracts", "expression": slot}],
                                       "resolution": "one fixed/floating aggregate, annual simple accrual",
                                       "calendars": [self.bindings.calendar_id], "choices": [],
                                       "exclusions": ["fees", "foreign_currency", "embedded_options"], "obligations": []})
        family_id = f"history:{_clean_id(self.model_id)}"
        self.ir["historyFamilies"].append({"id": family_id, "scope": model_scope,
            "evidence_view": evidence[next(iter(source_keys.values()))][2], "opening_state": opening_decl.name,
            "symbols": list(self.symbols), "choices": [], "constraints": constraint_ids,
            "alternatives": alt_ids, "feasibility": "Unknown", "coverage": "PartialSearch",
            "completed_cells": 0, "unresolved_cells": 1, "witnesses": [], "solver_results": []})
        declarations = [getattr(d, "name", None) for d in self.program.declarations if getattr(d, "name", None)]
        declarations += [u.name for u in self.program.uses]
        self.ir["models"].append({"id": self.model_id, "language_version": "Core0.1",
                                  "declarations": list(dict.fromkeys(declarations)),
                                  "package_lock": [package.id], "scope": model_scope})
        self.ir["expressions"] = list(self.expr_rows.values())
        self.ir["diagnostics"] = []
        # Evidence view observations were added after creation; record all
        # generated rows deterministically.
        self.ir["sourceSpans"].sort(key=lambda r: r["id"])
        self.ir["documents"].sort(key=lambda r: r["id"])
        self.ir["observations"].sort(key=lambda r: r["id"])
        self.ir["expressions"].sort(key=lambda r: r["id"])
        self.ir["assumptions"].sort(key=lambda r: r["id"])
        self.ir["constraints"].sort(key=lambda r: r["id"])
        self.ir["alternatives"].sort(key=lambda r: r["id"])
        self.ir["reviewDecisions"].sort(key=lambda r: r["id"])
        self.ir["evidenceViews"].sort(key=lambda r: r["id"])
        # Validate the generated structure before exposing it.
        checked = validate_ir(self.ir, self.bindings)
        if not checked.ok:
            raise _Failure(checked.diagnostics[0])
        return CompileResult(copy.deepcopy(self.ir), (), MappingProxyType(copy.deepcopy(self.source_map)))

    def _source_ref_expr(self, mapping: str, owner: str) -> str:
        return self._literal_expr(owner, "report_mapping", mapping, "SourceRef")

    def _literal_expr(self, owner: str, path: str, value: Any, typ: str) -> str:
        expr = Literal(value, type_name=typ)
        return self.lower_expr(expr, owner, path)[0]

    def _assumption_row(self, key: str, expression: str, scope: str,
                        evidence: Mapping[str, tuple[str, str, str]]) -> str:
        # Existing row IDs are reused when the same source expression is
        # referenced by more than one binding, while metadata remains explicit.
        aid = f"assumption:{_clean_id(key)}"
        if any(r["id"] == aid for r in self.ir["assumptions"]):
            return aid
        # The demo helper supplies coarse keys.  Custom callers can provide
        # exact keys; fall back only to the documented profile categories.
        if key.startswith("alternative:"):
            meta = self.bindings.assumption("alternative")
        elif key.startswith("contract:"):
            meta = self.bindings.assumption("contract-rate")
        elif key.startswith("scenario:"):
            meta = self.bindings.assumption("scenario")
        else:
            meta = self.bindings.assumption(key)
        start = meta.valid_start or self.bindings.horizon_start
        end = meta.valid_end or self.bindings.horizon_end
        cutoff = meta.information_cutoff or self.bindings.horizon_start + "T00:00:00Z"
        self.ir["assumptions"].append({"id": aid, "expression": expression, "scope": scope,
            "rationale": meta.rationale, "provenance": meta.provenance, "source_refs": list(meta.source_refs),
            "valid": _time("interval", start, end, self.bindings.calendar_id),
            "information_cutoff": cutoff, "role": meta.role})
        return aid


_IR_OPS = {"+": "add", "-": "subtract", "*": "multiply", "/": "divide",
           "==": "eq", "!=": "ne", "<": "lt", "<=": "le", ">": "gt", ">=": "ge",
           "and": "and", "or": "or"}


def _numeric_type(typ: str) -> bool:
    return typ in {"Real", "Int", "Rate<annual_simple>", "YearFraction"} or bool(re.fullmatch(r"Money<[A-Z]{3}>", typ))


def _is_scalar(typ: str) -> bool:
    return typ in {"Real", "Int", "Rate<annual_simple>", "YearFraction"}


def _merge_context(left: Optional[str], right: Optional[str], owner: str, compiler: _Compiler) -> Optional[str]:
    if left and right and left != right:
        compiler.fail("ContextMismatch", "quantities require an explicit compatible context", owner)
    return left or right


def _literal_value(expr: Expr, where: str) -> Any:
    if not isinstance(expr, Literal):
        raise _Failure(Diagnostic("SourceReadingMismatch", "observation value must be a numeric literal", where))
    if not isinstance(expr.value, (Fraction, int, Decimal)):
        raise _Failure(Diagnostic("SourceReadingMismatch", "observation value must be numeric", where))
    return _fraction(expr.value)


def _arithmetic(op: str, left: Any, right: Any) -> Any:
    if not isinstance(left, Fraction) or not isinstance(right, Fraction):
        return None
    if op == "+":
        return left + right
    if op == "-":
        return left - right
    if op == "*":
        return left * right
    if op == "/":
        return left / right
    return None


def _compare(op: str, left: Any, right: Any) -> Optional[bool]:
    if left is None or right is None:
        return None
    return {"==": left == right, "!=": left != right, "<": left < right,
            "<=": left <= right, ">": left > right, ">=": left >= right}[op]


def _fold_bool(op: str, left: Any, right: Any) -> Optional[bool]:
    if not isinstance(left, bool) or not isinstance(right, bool):
        return None
    return left and right if op == "and" else left or right


def compile_program(program: Program, bindings: CompileBindings,
                    *, source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,
                    input_text: Optional[str] = None) -> CompileResult:
    """Lower a typed ``Program`` through the shared Core0.1 stages."""
    if not isinstance(program, Program):
        raise TypeError("compile_program requires a Program constructed from typed declarations")
    try:
        return _Compiler(program, bindings, source_spans, input_text).build()
    except _Failure as exc:
        return CompileResult(None, (exc.diagnostic,), MappingProxyType({}),
                             hashlib.sha256(input_text.encode("utf-8")).hexdigest() if input_text is not None else None)


# ---------------------------------------------------------------------------
# IR validation and exact evaluation


def _load_schema() -> dict[str, Any]:
    try:
        return json.loads(SCHEMA_PATH.read_text(encoding="utf-8"))
    except OSError as exc:
        raise RuntimeError(f"cannot read closed Core IR schema: {SCHEMA_PATH}") from exc


def _invalid(code: str, message: str, location: str) -> Diagnostic:
    return Diagnostic(code, message, location)


def _nodes(ir: Mapping[str, Any]) -> tuple[dict[str, tuple[str, Mapping[str, Any]]], Optional[Diagnostic]]:
    nodes: dict[str, tuple[str, Mapping[str, Any]]] = {}
    for section, rows in ir.items():
        if not isinstance(rows, list):
            continue
        for row in rows:
            if not isinstance(row, Mapping) or "id" not in row:
                continue
            identifier = row["id"]
            if identifier in nodes:
                return {}, _invalid("DuplicateID", f"identifier {identifier!r} occurs more than once", identifier)
            nodes[identifier] = (section, row)
    return nodes, None


def _ref(nodes: Mapping[str, tuple[str, Mapping[str, Any]]], identifier: str,
         sections: Optional[set[str]], where: str) -> Optional[Diagnostic]:
    if identifier not in nodes:
        return _invalid("UnknownReference", f"unknown reference {identifier!r}", where)
    if sections and nodes[identifier][0] not in sections:
        return _invalid("ReferenceKind", f"{identifier!r} has kind {nodes[identifier][0]}, expected {sorted(sections)}", where)
    return None


class _IRTypeChecker:
    def __init__(self, ir: Mapping[str, Any], nodes: Mapping[str, tuple[str, Mapping[str, Any]]]):
        self.ir, self.nodes = ir, nodes
        self.memo: dict[str, tuple[str, Optional[str], Any]] = {}
        self.active: set[str] = set()

    def expr(self, identifier: str) -> tuple[str, Optional[str], Any]:
        if identifier in self.memo:
            return self.memo[identifier]
        if identifier in self.active:
            raise _Failure(Diagnostic("ExpressionCycle", "cyclic expression dependency", identifier))
        if identifier not in self.nodes or self.nodes[identifier][0] != "expressions":
            raise _Failure(Diagnostic("UnknownReference", f"expression {identifier!r} is not declared", identifier))
        self.active.add(identifier)
        e = self.nodes[identifier][1]
        op, target = e["op"], e["target"]
        args = [self.expr(a) for a in e["args"]]
        types = [a[0] for a in args]
        if op == "literal":
            if e["rational"] is not None:
                value = parse_rational(e["rational"])
            elif e["text"] is not None:
                value = e["text"]
            else:
                raise _Failure(Diagnostic("ExpressionPayload", "literal has no payload", identifier))
            result, context = e["type"], e["context"]
        elif op == "ref":
            if target not in self.nodes:
                raise _Failure(Diagnostic("UnknownReference", f"reference {target!r} is not declared", identifier))
            section, row = self.nodes[target]
            if section == "expressions":
                result, context, value = self.expr(target)
            elif section == "symbols":
                result, context, value = row["type"], row["context"], None
            elif section == "observations":
                ctx = self.nodes[row["context"]][1]
                result, context, value = f"Observation<Money<{ctx['currency']}>>", row["context"], None
            else:
                raise _Failure(Diagnostic("ReferenceKind", f"cannot reference {section} from expression", identifier))
            value = None
        elif op == "call":
            if target == "builtin:value@1":
                if len(args) != 1 or not types[0].startswith("Observation<"):
                    raise _Failure(Diagnostic("TypeMismatch", "value requires one observation", identifier))
                result, context = types[0][12:-1], args[0][1]
                value = args[0][2]
            elif target == "builtin:constant@1":
                if len(args) != 1 or not types[0].startswith("Rate<"):
                    raise _Failure(Diagnostic("TypeMismatch", "constant requires one annual rate", identifier))
                result, context, value = f"Driver<{types[0]}>", args[0][1], args[0][2]
            else:
                raise _Failure(Diagnostic("UnsupportedExpression", "unknown builtin call", identifier))
        else:
            arity = 1 if op in {"negate", "not"} else 2
            if len(args) != arity:
                raise _Failure(Diagnostic("ArityMismatch", "wrong expression arity", identifier))
            if op in {"not", "and", "or"}:
                if any(t != "Bool" for t in types):
                    raise _Failure(Diagnostic("TypeMismatch", "Boolean operands required", identifier))
                result, context = "Bool", None
                value = None
            elif op in {"eq", "ne", "lt", "le", "gt", "ge"}:
                if types[0] != types[1]:
                    raise _Failure(Diagnostic("TypeMismatch", "comparison types differ", identifier))
                result, context, value = "Bool", None, None
            elif op in {"add", "subtract"}:
                if types[0] != types[1] or not _numeric_type(types[0]):
                    raise _Failure(Diagnostic("TypeMismatch", "compatible numeric operands required", identifier))
                result, context, value = types[0], args[0][1] or args[1][1], None
            elif op == "negate":
                if not _numeric_type(types[0]):
                    raise _Failure(Diagnostic("TypeMismatch", "numeric operand required", identifier))
                result, context, value = types[0], args[0][1], None
            elif op in {"multiply", "divide"}:
                if not _numeric_type(types[0]) or not _numeric_type(types[1]):
                    raise _Failure(Diagnostic("TypeMismatch", "numeric operands required", identifier))
                if op == "divide" and not _is_scalar(types[1]):
                    raise _Failure(Diagnostic("UnsupportedOperation", "divisor must be scalar", identifier))
                if op == "divide" and not isinstance(args[1][2], Fraction):
                    raise _Failure(Diagnostic("UnprovedNonzeroDenominator", "divisor must be constant", identifier))
                if op == "divide" and args[1][2] == 0:
                    raise _Failure(Diagnostic("UnprovedNonzeroDenominator", "divisor is zero", identifier))
                result = types[0] if not _is_scalar(types[0]) else (types[1] if op == "multiply" else "Real")
                context, value = args[0][1] or args[1][1], None
            else:
                raise _Failure(Diagnostic("UnsupportedExpression", f"operator {op!r} unsupported", identifier))
        declared = (e["type"], e["context"])
        if declared != (result, context):
            raise _Failure(Diagnostic("TypeMismatch", f"declared {declared}, inferred {(result, context)}", identifier))
        self.active.remove(identifier)
        self.memo[identifier] = (result, context, value)
        return self.memo[identifier]


def validate_ir(ir: Mapping[str, Any], bindings: CompileBindings,
                *, schema: Optional[Mapping[str, Any]] = None) -> ValidationResult:
    """Validate closed-schema shape and independent Core0.1 semantics."""
    diagnostics: list[Diagnostic] = []
    if not isinstance(ir, Mapping):
        return ValidationResult(False, (_invalid("StructuralError", "IR must be a mapping", "ir"),))
    schema = schema or _load_schema()
    if jsonschema is None:
        return ValidationResult(False, (_invalid("MissingDependency", "jsonschema is required for closed-schema validation", "validator"),))
    try:
        jsonschema.Draft202012Validator(schema).validate(ir)
    except jsonschema.ValidationError as exc:
        return ValidationResult(False, (_invalid("StructuralError", exc.message, "/".join(map(str, exc.path))),))
    nodes, duplicate = _nodes(ir)
    if duplicate:
        return ValidationResult(False, (duplicate,))
    try:
        packages = {p.id: p for p in bindings.packages}
        package_rows = {r["id"]: r for r in ir["packages"]}
        if set(package_rows) != set(packages):
            raise _Failure(Diagnostic("PackageBinding", "IR package lock differs from supplied package bindings", "packages"))
        for pid, package in packages.items():
            row = package_rows[pid]
            if row["digest"] != package.digest or row["basis"] != package.basis:
                raise _Failure(Diagnostic("PackageDigestMismatch", "package digest/basis differs from binding", pid))
            if row["operations"] != [f"{pid}/{x}" for x in package.operations]:
                raise _Failure(Diagnostic("PackageBinding", "package operation lock differs from binding", pid))
        entities = {r["id"]: r for r in ir["entities"]}
        books = {r["id"]: r for r in ir["books"]}
        if len(entities) != 1 or len(books) != 1:
            raise _Failure(Diagnostic("ProfileCardinality", "one entity and book are required", "profile"))
        for row in ir["contexts"]:
            if (err := _ref(nodes, row["entity"], {"entities"}, row["id"])):
                raise _Failure(err)
            _time("instant" if row["time"]["kind"] == "instant" else "interval", row["time"]["start"], row["time"]["end_exclusive"], row["time"]["calendar"])
        for row in ir["sourceSpans"]:
            if (err := _ref(nodes, row["document"], {"documents"}, row["id"])):
                raise _Failure(err)
        for row in ir["documents"]:
            _instant(row["available"], row["id"]); _instant(row["ingested"], row["id"])
        for row in ir["observations"]:
            if (err := _ref(nodes, row["context"], {"contexts"}, row["id"])):
                raise _Failure(err)
            for rid in row["source_spans"]:
                if (err := _ref(nodes, rid, {"sourceSpans"}, row["id"])):
                    raise _Failure(err)
            reading_key = next((r.key for r in bindings.readings if f"reading:{_clean_id(r.key)}" == row["reading"]), None)
            if reading_key is None:
                raise _Failure(Diagnostic("UnknownReference", "observation reading is not bound", row["id"]))
            reading = bindings.reading(reading_key)
            if row["domain"]["lower"] != rational(reading.amount) or row["domain"]["upper"] != rational(reading.amount):
                raise _Failure(Diagnostic("SourceReadingMismatch", "observation domain differs from bound reading", row["id"]))
            document_id = f"document:{_clean_id(reading.key)}"
            span = next((s for s in ir["sourceSpans"] if s["id"] in row["source_spans"]), None)
            if span is None or span["literal"] != reading.literal:
                raise _Failure(Diagnostic("SourceLiteralMismatch", "source span literal differs from binding", row["id"]))
            doc = next((d for d in ir["documents"] if d["id"] == document_id), None)
            if doc is None or doc["sha256"] != hashlib.sha256(reading.literal.encode()).hexdigest():
                raise _Failure(Diagnostic("SourceDigestMismatch", "document digest differs from binding", row["id"]))
        for row in ir["books"]:
            if row["package"] not in package_rows:
                raise _Failure(Diagnostic("PackageBinding", "book package is not locked", row["id"]))
            if row["currency"] != entities[row["entity"]]["functional_currency"]:
                raise _Failure(Diagnostic("ContextMismatch", "book currency differs from entity", row["id"]))
        for row in ir["accounts"]:
            if (err := _ref(nodes, row["book"], {"books"}, row["id"])):
                raise _Failure(err)
        checker = _IRTypeChecker(ir, nodes)
        for row in ir["expressions"]:
            checker.expr(row["id"])
        for row in ir["constraints"]:
            inferred = checker.expr(row["expression"])
            if inferred[0] != "Bool":
                raise _Failure(Diagnostic("ConstraintType", "constraint expression must be Boolean", row["id"]))
        for row in ir["contracts"]:
            if row["book"] not in books:
                raise _Failure(Diagnostic("UnknownReference", "contract book is unknown", row["id"]))
            fields = {f["name"]: f["expression"] for f in row["fields"]}
            if set(fields) != {"principal", "fixed_fraction", "fixed_rate", "initial_floating_rate"}:
                raise _Failure(Diagnostic("ContractFields", "contract fields are incomplete or duplicated", row["id"]))
            expected = {"principal": f"Money<{books[row['book']]['currency']}>", "fixed_fraction": "Real",
                        "fixed_rate": "Rate<annual_simple>", "initial_floating_rate": "Rate<annual_simple>"}
            for name, typ in expected.items():
                if checker.expr(fields[name])[0] != typ:
                    raise _Failure(Diagnostic("ContractType", f"{name} has the wrong type", row["id"]))
        for row in ir["states"]:
            total = Fraction(0); seen = set()
            for balance in row["balances"]:
                if balance["account"] in seen:
                    raise _Failure(Diagnostic("DuplicateBalance", "opening account occurs twice", row["id"]))
                seen.add(balance["account"]); total += parse_rational(balance["signed_amount"])
            if total != 0:
                raise _Failure(Diagnostic("UnbalancedState", "opening balances do not sum to zero", row["id"]))
            expected_accounts = {a["id"] for a in ir["accounts"] if a["book"] == row["book"]}
            if seen != expected_accounts:
                raise _Failure(Diagnostic("IncompleteState", "opening state must include every account", row["id"]))
        for row in ir["historyFamilies"]:
            if row["feasibility"] == "Feasible" and not row["witnesses"]:
                raise _Failure(Diagnostic("MissingWitness", "feasible family requires a witness", row["id"]))
            if row["coverage"] == "ExactWithinScope" and (row["unresolved_cells"] or not row["completed_cells"]):
                raise _Failure(Diagnostic("FalseCoverage", "exact coverage requires completed cells and no unresolved cells", row["id"]))
            if row["coverage"] != "PartialSearch" or row["feasibility"] != "Unknown" or row["completed_cells"] != 0 or row["unresolved_cells"] != 1:
                raise _Failure(Diagnostic("CoverageClaim", "Core0.1 family must remain explicitly unsearched", row["id"]))
        for row in ir["reportMappings"]:
            if not row["rows"] or row["rows"][0]["expression"] not in checker.memo:
                raise _Failure(Diagnostic("ReportMapping", "report mapping expression is not compiled", row["id"]))
        if not ir["diagnostics"]:
            pass
    except _Failure as exc:
        return ValidationResult(False, (exc.diagnostic,))
    return ValidationResult(True, ())


@dataclass(frozen=True)
class _Symbolic:
    name: str


def evaluate_expression(ir: Mapping[str, Any], identifier: str,
                        symbols: Mapping[str, Fraction | int | str] | None = None) -> Any:
    """Evaluate exact supported expressions for a supplied symbol assignment."""
    nodes = {e["id"]: e for e in ir.get("expressions", [])}
    symbol_values = {k: _fraction(v) for k, v in (symbols or {}).items()}
    observations = {o["id"]: o for o in ir.get("observations", [])}
    contexts = {c["id"]: c for c in ir.get("contexts", [])}
    seen: set[str] = set()

    def go(eid: str) -> Any:
        if eid in seen:
            raise ValueError(f"expression cycle at {eid}")
        if eid not in nodes:
            raise KeyError(eid)
        e = nodes[eid]; op = e["op"]
        if op == "literal":
            if e["rational"] is not None:
                return parse_rational(e["rational"])
            if e["type"] == "Bool":
                return e["text"] == "true"
            return e["text"]
        seen.add(eid)
        try:
            if op == "ref":
                target = e["target"]
                if target in nodes:
                    return go(target)
                if target in symbol_values:
                    return symbol_values[target]
                if target in observations:
                    return parse_rational(observations[target]["domain"]["lower"])
                return _Symbolic(target)
            if op == "call":
                value = go(e["args"][0])
                return value
            args = [go(a) for a in e["args"]]
            if any(isinstance(a, _Symbolic) for a in args):
                return _Symbolic(eid)
            if op == "add": return args[0] + args[1]
            if op == "subtract": return args[0] - args[1]
            if op == "multiply": return args[0] * args[1]
            if op == "divide": return args[0] / args[1]
            if op == "negate": return -args[0]
            if op == "not": return not args[0]
            if op == "and": return args[0] and args[1]
            if op == "or": return args[0] or args[1]
            return {"eq": args[0] == args[1], "ne": args[0] != args[1], "lt": args[0] < args[1],
                    "le": args[0] <= args[1], "gt": args[0] > args[1], "ge": args[0] >= args[1]}[op]
        finally:
            seen.remove(eid)
    return go(identifier)


def semantic_projection(ir: Mapping[str, Any] | None) -> Optional[dict[str, Any]]:
    if ir is None:
        return None
    # Source offsets live in CompileResult.source_map.  IR itself retains
    # source context, package locks, assumptions, alternatives and bindings.
    projected = copy.deepcopy(dict(ir))
    projected.pop("diagnostics", None)
    return projected


