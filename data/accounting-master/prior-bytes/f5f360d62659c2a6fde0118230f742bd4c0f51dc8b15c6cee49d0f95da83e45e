    calendar_name: str = "Gregorian"
    horizon_start: str = "2026-01-01"
    horizon_end: str = "2027-01-01"
    symbol_uncertainty: str = "HistoricalFact"
    entity_perimeter: str = "Acme-only"

    def __init__(self, packages: Sequence[PackageBinding] = (), readings: Sequence[ReadingBinding] = (),
                 openings: Sequence[OpeningBinding] = (), reports: Sequence[ReportBinding] = (),
                 assumptions: Sequence[AssumptionBinding] = (), calendar_id: str = "DemoCalendar@1",
                 calendar_name: str = "Gregorian", horizon_start: str = "2026-01-01",
                 horizon_end: str = "2027-01-01", symbol_uncertainty: str = "HistoricalFact",
                 entity_perimeter: str = "Acme-only"):
        object.__setattr__(self, "packages", tuple(packages))
        object.__setattr__(self, "readings", tuple(readings))
        object.__setattr__(self, "openings", tuple(openings))
        object.__setattr__(self, "reports", tuple(reports))
        object.__setattr__(self, "assumptions", tuple(assumptions))
        object.__setattr__(self, "calendar_id", calendar_id)
        object.__setattr__(self, "calendar_name", calendar_name)
        object.__setattr__(self, "horizon_start", horizon_start)
        object.__setattr__(self, "horizon_end", horizon_end)
        object.__setattr__(self, "symbol_uncertainty", symbol_uncertainty)
        object.__setattr__(self, "entity_perimeter", entity_perimeter)

    def package(self, name: str, version: Optional[str] = None) -> PackageBinding:
        candidates = [p for p in self.packages if p.name == name and (version is None or p.version == version)]
        if len(candidates) != 1:
            raise _Failure(Diagnostic("MissingPackageBinding", f"package {name!r} is not uniquely bound", name))
        return candidates[0]

    def reading(self, key: str) -> ReadingBinding:
        candidates = [r for r in self.readings if r.key == key]
        if len(candidates) != 1:
            raise _Failure(Diagnostic("MissingExternalBinding", f"reading {key!r} is not bound", key))
        return candidates[0]

    def opening(self, key: str) -> OpeningBinding:
        candidates = [r for r in self.openings if r.key == key]
        if len(candidates) != 1:
            raise _Failure(Diagnostic("MissingExternalBinding", f"opening {key!r} is not bound", key))
        return candidates[0]

    def report(self, key: str) -> ReportBinding:
        candidates = [r for r in self.reports if r.key == key]
        if len(candidates) != 1:
            raise _Failure(Diagnostic("MissingExternalBinding", f"report mapping {key!r} is not bound", key))
        return candidates[0]

    def assumption(self, key: str) -> AssumptionBinding:
        candidates = [a for a in self.assumptions if a.key == key]
        if len(candidates) != 1:
            raise _Failure(Diagnostic("MissingAssumptionMetadata", f"assumption metadata {key!r} is not bound", key))
        return candidates[0]

    @classmethod
    def demo(cls, root: Path | str | None = None, principal: Fraction | int | str = 100,
             stress_rate: Fraction | int | str = Fraction(7, 100),
             fixed_rate: Fraction | int | str = Fraction(1, 20),
             opening_balances: Mapping[str, Fraction | int | str] | None = None) -> "CompileBindings":
        """Create explicit synthetic bindings for the bounded demonstration profile.

        This helper is a convenience for tests and examples.  The compiler
        still receives all evidence/package/assumption records as arguments;
        it does not inspect the authored expected IR.
        """
        root_path = Path(root) if root is not None else ROOT
        package_path = root_path / "docs/design/fixtures/demo-debt-package.json"
        digest = hashlib.sha256(package_path.read_bytes()).hexdigest() if package_path.is_file() else ""
        p = _fraction(principal)
        stress = _fraction(stress_rate)
        fixed = _fraction(fixed_rate)
        literal = f"Debt {p}; interest 5; fixed/floating split not disclosed"
        reading = ReadingBinding(
            key="synthetic-note-7", literal=literal, amount=p, currency="USD",
            instant="2025-12-31", uri="fixture:demo-debt-package.json#registry/synthetic-note-7",
            filing_id="synthetic-2025", available="2026-01-01T00:00:00Z",
            ingested="2026-01-01T00:00:00Z", reviewer="synthetic-fixture-author",
            review_date="2026-01-01T00:00:00Z",
            review_reason="Explicit synthetic disclosure supplied by the caller",
            cutoff="2026-01-01T00:00:00Z")
        balances = opening_balances or {"Cash": p - 5, "Debt": -p, "InterestExpense": 0, "Retained": 5}
        opening = OpeningBinding("after-2025-close", "2025-12-31", balances, book="Local")
        package = PackageBinding(
            "DemoDebt", "1", digest, "DemoDebt", "2025-01-01", "2028-01-01",
            ("reset", "accrue_and_pay", "close", "statements"),
            ("builtin:Core0@1", "DemoCalendar@1"), ("fixture:demo-debt-package.json",))
        report = ReportBinding("DemoDebt.statements.v1", "DemoDebt.statements.v1",
                               "interest_operating", "close", ("accrue_and_pay",))
        assumptions = (
            AssumptionBinding("alternative", "Named endpoint condition supplied for comparison"),
            AssumptionBinding("contract-rate", "Component rates are explicit scenario inputs supplied by the caller"),
            AssumptionBinding("scenario", f"Illustrative constant annual stress {stress}; not an estimated future rate"),
        )
        # Retain values for callers that want to inspect the intended defaults;
        # rate values remain in the typed/source program itself.
        _ = fixed
        return cls((package,), (reading,), (opening,), (report,), assumptions)


