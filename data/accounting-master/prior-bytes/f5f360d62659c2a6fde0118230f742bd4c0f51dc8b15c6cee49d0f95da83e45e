def _pairs(value: Mapping[str, Any] | Iterable[tuple[str, Any]] | None) -> tuple[tuple[str, Any], ...]:
    if value is None:
        return ()
    if isinstance(value, Mapping):
        return tuple((str(k), v) for k, v in value.items())
    return tuple((str(k), v) for k, v in value)


def _tuple(value: Iterable[Any] | None) -> tuple[Any, ...]:
    return tuple(value or ())


def _fraction(value: Fraction | int | str | Decimal) -> Fraction:
    if isinstance(value, Fraction):
        return value
    if isinstance(value, int):
        return Fraction(value, 1)
    if isinstance(value, Decimal):
        return Fraction(value)
    if isinstance(value, str):
        try:
            return Fraction(Decimal(value))
        except (InvalidOperation, ValueError, ZeroDivisionError) as exc:
            raise ValueError(f"invalid decimal literal {value!r}") from exc
    raise TypeError(f"unsupported numeric value {type(value)!r}")


def rational(value: Fraction | int | str | Decimal) -> dict[str, str]:
    q = _fraction(value)
    return {"n": str(q.numerator), "d": str(q.denominator)}


def parse_rational(value: Mapping[str, str]) -> Fraction:
    try:
        n, d = int(value["n"]), int(value["d"])
    except (KeyError, TypeError, ValueError) as exc:
        raise ValueError("invalid rational") from exc
    if d <= 0 or Fraction(n, d) != Fraction(n, d):
        raise ValueError("invalid rational denominator")
    q = Fraction(n, d)
    if (str(q.numerator), str(q.denominator)) != (str(n), str(d)):
        raise ValueError("noncanonical rational")
    return q


def _clean_id(value: str) -> str:
    value = re.sub(r"[^A-Za-z0-9_.-]+", "_", value)
    return value.strip(".") or "anonymous"


def _iso(value: str, where: str) -> str:
    try:
        parsed = date.fromisoformat(value)
    except ValueError as exc:
        raise _Failure(Diagnostic("InvalidDate", f"{value!r} is not a Gregorian date", where)) from exc
    if parsed.isoformat() != value:
        raise _Failure(Diagnostic("InvalidDate", f"use canonical YYYY-MM-DD for {value!r}", where))
    return value


def _instant(value: str, where: str) -> str:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise _Failure(Diagnostic("InvalidTimestamp", f"invalid timestamp {value!r}", where)) from exc
    if parsed.tzinfo is None:
        raise _Failure(Diagnostic("MissingTimezone", "timestamps require an explicit timezone", where))
    return value


def _time(kind: str, start: str, end: Optional[str], calendar: str) -> dict[str, Any]:
    _iso(start, "time.start")
    if kind == "interval":
        if end is None or date.fromisoformat(end) <= date.fromisoformat(start):
            raise _Failure(Diagnostic("InvalidPeriod", "interval end must be after start", "time"))
        _iso(end, "time.end_exclusive")
    elif end is not None:
        raise _Failure(Diagnostic("InvalidPeriod", "instant cannot have an end", "time"))
    return {"kind": kind, "start": start, "end_exclusive": end, "calendar": calendar}


