def walk_anchors(value):
    if isinstance(value, dict):
        if {"start", "end", "quote", "offset_unit"} <= value.keys():
            yield value
        for item in value.values():
            yield from walk_anchors(item)
    elif isinstance(value, list):
        for item in value:
            yield from walk_anchors(item)


def validate_anchors(value):
    cache = {}
    def read(path, digest):
        resolved = (ROOT/path).resolve()
        require(resolved.is_relative_to(ROOT), "anchor outside repository")
        if path not in cache:
            data = resolved.read_bytes()
            cache[path] = (sha(data), None if path.endswith('.pdf') else data.decode('utf-8'))
        require(cache[path][0] == digest, "anchor source hash mismatch")
        return cache[path][1]
    count = 0
    for a in walk_anchors(value):
        if "original_path" in a:
            read(a["original_path"], a["original_sha256"])
            text = read(a["extraction_path"], a["extraction_sha256"])
        else:
            text = read(a["path"], a["sha256"])
        require(a["offset_unit"] == "Unicode code points" and
                0 <= a["start"] < a["end"] <= len(text) and
                text[a["start"]:a["end"]] == a["quote"], "broken source quotation/offset")
        if "pdf_page" in a:
            doc = Document(a["document"], a["original_path"], a["extraction_path"], True)
            require(doc.anchor(a["start"], a["end"]) == a, "PDF page/anchor mismatch")
        count += 1
    return count


def note_records(annual, interim, observations):
    notes = discover_notes(annual, 13)+discover_notes(interim, 10)
    inventory = json.loads((ROOT/APPLE/"manifest.json").read_text())["notes"]
    require([(n["id"], n["title"]) for n in notes] == [(n["id"], n["title"]) for n in inventory],
            "note inventory disagreement")
    for note in notes:
        areas, interpretation, unknown = NOTE_MEANING[note["title"]]
        note.update(disposition="partially_mapped" if note["number"] in (1, 2, 4) else "unresolved_meaning_retained",
                    affected_model_areas=areas, interpretation=interpretation,
                    unresolved_meaning=unknown, semantic_completion=False, linked_quantities=[],
                    qualifications="The full bounded source passage is retained; only the stated interpretation is applied.")
        a = note["anchor"]
        for obs in observations:
            for source in walk_anchors(obs["source_readings"]):
                if source.get("extraction_path") == a["extraction_path"] and a["start"] <= source["start"] < a["end"]:
                    note["linked_quantities"].append(obs["id"])
                    break
        # Inline fact locations live in HTML, not in the independent text extraction.
        # Match the fact's literal/concept within this note's corresponding ix:textBlock.
        if a["document"] == "interim":
            prefixes = {2: ["interim.product."], 4: ["interim.notional."],
                        6: ["interim.debt."], 10: ["interim.segment."]}.get(note["number"], [])
            note["linked_quantities"] = [o["id"] for o in observations if any(o["id"].startswith(p) for p in prefixes)]
        note["linked_quantities"] = sorted(set(note["linked_quantities"]))
        if note["linked_quantities"]:
            note["disposition"] = "selected_quantities_mapped_with_unresolved_remainder"
        targets = sorted(set(int(n) for n in re.findall(r"Note\s+(\d+)", a["quote"])))
        note["cross_references"] = [dict(target=f"{a['document']}.note.{n}",
                                         relation="literal note reference", status="source_present; meaning not necessarily executed")
                                    for n in targets if n != note["number"]]
        require(all(t["target"] in {n["id"] for n in notes} for t in note["cross_references"]), "unresolved internal note target")
    by_id = {n["id"]: n for n in notes}
    by_id["annual.note.9"]["cross_references"].append(dict(target="annual.note.4", relation="analyst link: debt and interest-rate swaps", status="source_present"))
    by_id["interim.note.1"]["cross_references"].append(dict(target="annual.note.1", relation="explicit read-with-2024-10-K qualification", status="source_present"))
    contingency = by_id["interim.note.9"]
    contingency["assertion"] = dict(kind="reported_management_assessment", speaker="Apple management",
        subject="asserted legal and other claims", modal_operator="not at least a reasonable possibility",
        assessed_event="material loss, or material loss greater than a recorded accrual",
        unresolved_outcomes=True, probability=None, liability_amount=None,
        anchor=interim.find(r"The Company is subject to various legal proceedings.*?asserted legal and other claims\.",
                            (contingency["anchor"]["start"], contingency["anchor"]["end"]), re.S))
    return notes


def supported_excerpt(doc, pattern, bounds=None):
    return doc.find(pattern, bounds, re.S)


def rendered_row_match(doc, label, literal, occurrence=0):
    """Anchor a displayed row/value in an issuer-rendered HTML extraction.

    The issuer-linked HTML retained for the publication/version check is a
    rendered filing, not an inline-XBRL instance.  It therefore cannot be
    parsed with ``InlineReader``.  This helper deliberately binds only the
    visible label/value pair and records the exact occurrence; it does not
    promote the rendered copy to a second accounting source.
    """
    pattern = re.escape(label) + r"\s+(?:\$\s+)?" + re.escape(literal)
    matches = list(re.finditer(pattern, doc.text, re.S))
    require(len(matches) > occurrence, f"rendered row missing: {label} {literal}")
    m = matches[occurrence]
    return doc.anchor(m.start(), m.end())


def policy_records(annual, interim, notes):
    n = {r["id"]: r for r in notes}
