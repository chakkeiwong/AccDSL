def availability(record, cutoff, scope="filing_identity"):
    """Date-resolution query; unknown byte vintage never inherits a filing date."""
    cutoff = date.fromisoformat(cutoff)
    require(scope in ("filing_identity", "retained_bytes"), "unsupported availability scope")
    day = record.get("filing_date" if scope == "filing_identity" else "retained_byte_publication_date")
    return "unknown" if day is None else ("available_by_filing_day" if date.fromisoformat(day) <= cutoff else "later")


def version_view(records, cutoff, scope="retained_bytes"):
    require(len({r["id"] for r in records}) == len(records), "duplicate version identity")
    decisions = [{"id": r["id"], "availability": availability(r, cutoff, scope)} for r in records]
    eligible = [d["id"] for d in decisions if d["availability"] == "available_by_filing_day"]
    return dict(versions=decisions, eligible=eligible,
                resolution="retain_all_no_automatic_supersession", conflict_resolution="unsupported")


def exhibit_records(annual, official, interim):
    """Read exhibit target/version columns; distinguish a link from its contents."""
    result = []
    for doc, prefix in [(official, "annual"), (interim, "interim")]:
        soup = BeautifulSoup((ROOT/doc.original).read_text(), "html.parser")
        for tr in soup.find_all("tr"):
            cells = [c.get_text(" ", strip=True) for c in tr.find_all("td", recursive=False)]
            cells = [c for c in cells if c]
            if len(cells) < 2 or not re.fullmatch(r"(?:\d+\.\d+|101|104)[*, ]*", cells[0]):
                continue
            # Exclude financial rows and identify only the exhibit-index description cells.
            if not tr.find("a", href=True) and "**" not in cells[0]:
                continue
            number = re.match(r"\d+(?:\.\d+)?", cells[0])[0]
            row_text = tr.get_text("\n", strip=True)
            anchor = doc.find(re.escape(row_text))
            links = [a["href"] for a in tr.find_all("a", href=True)]
            internal = [u for u in links if u.startswith("#")]
            external = [u for u in links if u.startswith("http")]
            record = dict(id=f"{prefix}.exhibit.{number}", number=number, description=cells[1],
                          filed_marker=cells[0], source=anchor, target_links=links,
                          referenced_form=cells[2] if len(cells) >= 5 else None,
                          referenced_exhibit=cells[3] if len(cells) >= 5 else None,
                          referenced_date_or_period=cells[4] if len(cells) >= 5 else None,
                          contents_status="unresolved", missing_terms="Full substantive interpretation and applicability to current contracts.",
                          consequence="No complete incorporated-package or contract-history claim.",
                          next_route="Use the exact SEC accession in the link or the issuer filing feed for the stated form and date.")
            if internal:
                missing_internal = [u for u in internal
                                    if soup.find(id=u[1:]) is None and
                                    soup.find(attrs={"name": u[1:]}) is None]
                if missing_internal:
                    # A malformed or stale anchor is itself evidence about
                    # package closure.  Preserve it as an unresolved filing
                    # obligation instead of silently treating the link as
                    # resolved or aborting the whole bounded case build.
                    record["contents_status"] = "internal_target_missing_in_retained_html"
                    record["missing_internal_targets"] = missing_internal
                    record["missing_terms"] = "Retained issuer HTML exposes an internal link whose target is absent; substantive exhibit contents remain unverified."
                else:
                    record["contents_status"] = "within_retained_issuer_html; semantics_unresolved"
            if external:
                record["contents_status"] = "external_target_not_acquired"
            if number in ("101", "104"):
                record["contents_status"] = "inline_facts_present; complete_taxonomy_package_not_acquired"
                record["missing_terms"] = "Separate taxonomy/linkbase files and complete package validation."
            if prefix == "annual":
                # Bind each issuer index row independently to the mirrored PDF index.
                lo, hi = annual.page(53)[0], annual.page(56)[1]
                record["pdf_index_row"] = annual.find(r"^[ \t]*"+re.escape(number)+r"(?=[* \t])[^\n]+", (lo, hi), re.M)
            result.append(record)
    require(len({r["id"] for r in result}) == len(result), "duplicate exhibit rows")
    return result


def external_records(annual, interim, docs):
    proxy, reg, official = [docs[k] for k in ("proxy-2025", "registration-2021", "annual-2024-official")]
    exhibits = exhibit_records(annual, official, interim)
    obligations = []
    proxy_patterns = {
        10: r"Board Independence\nApple’s Corporate Governance Guidelines.*?applicable rules of The Nasdaq Stock Market LLC.*?\(“Nasdaq”\)\.",
        11: r"Compensation Discussion and Analysis\nThis Compensation.*?paid to our named executive officers\.",
        12: r"Security\nOwnership of Certain Beneficial Owners and Management\nThe\nfollowing table.*?\(the “Table Date”\)",
        13: r"Related Party Policy and Transactions\nThe Board has.*?\$120,000 in a single fiscal year",
        14: r"Audit Fees\n\(1\).*?Total\n30,270,822\n25,403,329",
    }
    lo, hi = annual.page(52)
    for item, pat in proxy_patterns.items():
        start = annual.find(r"Item "+str(item)+r"\.[^\n]+", (lo, hi))["start"]
        stop = annual.text.find("Item "+str(item+1)+".", start, hi) if item < 14 else hi
        obligations.append(dict(id=f"annual.partIII.item{item}", target="2025 proxy, accession 0001308179-25-000008",
                                incorporation=annual.anchor(start, stop), support=proxy.find(pat, flags=re.S),
                                status="target_acquired_selected_passage_inspected",
                                unresolved="Complete item-level semantics, exceptions and references beyond the selected passage remain unmodelled.",
                                consequence="Proxy information cannot be backdated to the annual filing.",
                                next_route="Inspect remaining sections in the retained proxy and its exact incorporated targets."))
    title = reg.find(r"Exhibit 4\.1\nApple Inc\..*?Dated as of October\s+28, 2021", flags=re.S)
    terms = reg.find(r"Section\s+301\.\nAmount\nUnlimited; Issuable in Series.*?Section\s+302\.", flags=re.S)
    # The retained issuer extraction omits the indenture's section numbers,
    # but preserves the substantive heading and the following covenants.
    defaults = reg.find(r"Events of Default\n.*?Discharge, Defeasance and Covenant Defeasance", flags=re.S)
    for e in exhibits:
        if e["id"] == "annual.exhibit.4.26":
            e.update(contents_status="acquired_in_registration_2021; selected_sections_inspected", acquired_support=title,
                     section_301=terms, section_501=defaults,
                     missing_terms="Series-specific officer certificates, outstanding balances, amendments and swap confirmations/allocation.")
    # Source content after the annual report includes filed exhibits; 4.1 is not a missing external indenture.
    securities = annual.find(r"(?m)^[ \t]*4\.1[^\n]*Description of Securities of the Registrant\.")
    obligations.append(dict(id="annual.exhibit.4.1.in_pdf", target="Description of Securities, filed exhibit 4.1",
                            support=securities, status="heading_and_contents_retained_in_pdf",
                            unresolved="Description is not the complete incorporated indentures and series certificates.",
                            consequence="General descriptions do not identify all current debt terms.",
                            next_route="Inspect specific 4.2–4.28 index targets for contract reconstruction."))
    omissions = annual.find(r"Certain instruments defining the rights of holders.*?copies of any such instruments\.", annual.page(56), re.S)
    obligations.append(dict(id="omitted_debt_instruments", target="Instruments omitted under Item 601(b)(4)(iii)", support=omissions,
                            status="expressly_omitted_from_filing", unresolved="Instrument identities and complete terms not specified by this index.",
                            consequence="No complete debt-contract inventory is established.",
                            next_route="Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach."))
    return dict(partIII_and_package_obligations=obligations, exhibit_inventory=exhibits,
                agreement_interpretation=dict(status="selected_contract_sections_only", support=[title, terms, defaults],
                    interpretation="Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.",
                    missing="2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule."))


def unidentified_records(notes):
    n = {r["id"]: r for r in notes}
    specs = [
        ("debt_and_swaps", ["annual.note.9", "annual.note.4", "interim.note.6", "interim.note.4"],
         "Annual interest-rate notional and interim notional are disclosed but contract allocation, resets, hedge coverage and net economic exposure remain unidentified.",
         "Obtain series certificates and public hedge terms; never equate derivative notional with floating-rate debt exposure."),
        ("debt_movements", ["annual.note.9", "interim.note.6"],
         "Carrying differences cannot be identified solely from cash issuance/repayment; FX and noncash measurement changes remain separate unknowns.",
         "Reconstruct movements only with sourced FX, hedge, discount and noncash adjustments."),
        ("asset_cohorts", ["annual.note.5", "interim.note.5"],
         "Gross/net balances do not identify vintages, remaining useful lives, additions and retirements.",
         "Retain alternative cohort histories until transaction or asset-register evidence supports a narrower family."),
        ("contingent_outcomes", ["annual.note.12", "interim.note.9"],
         "Management's loss assessment and commitment amounts do not provide a loss probability measure or a zero liability.",
         "Maintain unresolved outcomes and revisit dated legal disclosures; do not assign equal or confidence-derived probabilities."),
    ]
    return [dict(id=key, supports=[n[k]["anchor"] for k in ids], unresolved=meaning, next_action=action,
                 status="not_identified", probability=None) for key, ids, meaning, action in specs]


def build_case():
    annual, interim, docs, bindings, acquisitions = load_sources()
    observations, bridges, calendar = collect_observations(annual, interim)
    notes = note_records(annual, interim, observations)
    # A selected-table check relates representations, not whole-document
    # publication vintage.  The issuer-linked HTML is rendered filing text,
    # so bind visible label/value rows instead of treating it as a second
    # inline-XBRL instance.  The accounting observations remain sourced from
    # the retained annual/interim documents above.
    rendered_specs = [
        ("annual.bs.2024-09-28.assets", "Total assets", "364,980", 0),
        ("annual.bs.2024-09-28.liabilities", "Total liabilities", "308,030", 0),
        ("annual.bs.2024-09-28.equity", "Total shareholders’ equity", "56,950", 0),
        ("annual.bs.2024-09-28.debt_current", "Term debt", "10,912", 0),
        ("annual.bs.2024-09-28.debt_noncurrent", "Term debt", "85,750", 0),
        ("annual.revenue.2024", "Total net sales", "391,035", 0),
    ]
    rendered_checks = []
    for oid, label, literal, occurrence in rendered_specs:
        annual_observation = next(o for o in observations if o["id"] == oid)
        rendered_checks.append(dict(
            id="issuer_html." + oid,
            annual_observation=oid,
            label=label,
            displayed_literal=literal,
            source=rendered_row_match(docs["annual-2024-official"], label, literal, occurrence),
            status="visible_row_match_only",
            interpretation="Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.",
            source_value_usd=annual_observation["value_usd"],
        ))
    matched = [x["annual_observation"] for x in rendered_checks]
    policy = policy_records(annual, interim, notes)
    external = external_records(annual, interim, docs)
    records = filing_records()
    out = dict(schema_version="accdsl.apple_case.v1", plan_sha256=PLAN_HASH,
        scope="Retained Apple FY2024 annual, FY2025 Q1 interim and disclosed comparatives; selected numerical bridges only.",
        source_bindings=bindings, source_pins=PINS, p01_register=dict(path=REGISTER, sha256=file_hash(REGISTER)),
        source_acquisition=acquisitions, fiscal_calendar=calendar, policies=policy,
        observations=observations, notes=notes, reconciliations=bridges, external=external,
        filing_availability=records, unidentified_histories=unidentified_records(notes),
        rounding_model=dict(arithmetic="exact rational USD", model="closed half-unit nearest-rounding intervals",
                            issuer_tie_rule="unknown", inference="compatibility only; no distribution or identified underlying exact amounts"),
        representation_comparison=dict(matched_observations=matched, rendered_row_checks=rendered_checks,
                                       whole_document_equivalence=False, mirror_publication_date=None,
                                       historical_byte_vintage="not established"),
        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n["linked_quantities"]) for n in notes),
                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),
                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage="not measured by note count"),
        mapping_contract=dict(kind="explicit case annotations", context_source="Report policies, table headings and original inline contexts",
            annual_dates="Fiscal year-end table headings plus Note 1 week lengths; duration starts are derived, not calendar-year substitutions.",
            partitions="Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.",
            measurements="Debt principal, carrying amount, fair value and derivative notional remain distinct.",
            supported_transformations="Only the recorded partition aggregation, gross/net signed addition, comparative equality and dated cash movement bridges."),
        acceptance=dict(specified_behavior="reviewed P02 plan", implemented="bounded reusable source/context/reconciliation adapter",
                        tested_invariants="see result.md for executed tests", accounting_validity="selected displayed identities only; no compliance determination",
                        empirical_forecast_validity="not evaluated; no forecast generated", human_acceptance="pending"))
    out["anchor_count"] = validate_anchors(out)
    return out


def validate_case(candidate):
    """Rebuild from independently pinned sources, rejecting supplied metadata edits."""
    validate_anchors(candidate)
    expected = build_case()
    require(candidate == expected, "case differs from source-derived rebuild (values, metadata, notes or obligations)")
    return {"status": "pass", "observations": len(expected["observations"]),
            "notes": len(expected["notes"]), "reconciliations": len(expected["reconciliations"]),
            "anchors": expected["anchor_count"]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output-dir", default="data/accounting-master/deliverables/P02")
    parser.add_argument("--check", action="store_true", help="read-only rebuild and comparison")
    args = parser.parse_args()
    target = ROOT / args.output_dir / "case.json"
    if args.check:
        report = validate_case(json.loads(target.read_text()))
    else:
        case = build_case()
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(case, ensure_ascii=False, indent=2, sort_keys=True)+"\n")
        report = dict(status="built", **case["coverage"])
    print(json.dumps(report, sort_keys=True))


if __name__ == "__main__":
    main()
