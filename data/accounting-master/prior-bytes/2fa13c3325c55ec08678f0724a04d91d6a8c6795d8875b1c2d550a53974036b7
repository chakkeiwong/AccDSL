class CaseError(ValueError):
    """A source or interpretation fails the supported case contract."""


def require(condition, message):
    if not condition:
        raise CaseError(message)


def sha(data):
    return hashlib.sha256(data).hexdigest()


def file_hash(path):
    return sha((ROOT / path).read_bytes())


def power10(n):
    return Fraction(10)**n


def number(literal):
    s = re.sub(r"[\s$]", "", literal)
    if s in ("—", "–"):
        return Fraction(0)
    require(bool(re.fullmatch(r"(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?", s)) or
            bool(re.fullmatch(r"\((?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?\)", s)), "unsupported numeric literal: " + literal)
    s = s.replace(",", "")
    return -Fraction(s[1:-1]) if s.startswith("(") else Fraction(s)


def interval(value, quantum):
    v, q = Fraction(value), Fraction(quantum)
    require(q > 0, "precision must be positive")
    return [str(v-q/2), str(v+q/2)]


def interval_sum(observations, coefficients=None):
    coefs = coefficients or [1]*len(observations)
    require(len(coefs) == len(observations), "coefficient count")
    lo = hi = Fraction(0)
    for obs, c in zip(observations, coefs):
        a, b = map(Fraction, obs["rounding_interval_usd"])
        lo += min(c*a, c*b)
        hi += max(c*a, c*b)
    return lo, hi


def compatible(left, right):
    return max(Fraction(left[0]), Fraction(right[0])) <= min(Fraction(left[1]), Fraction(right[1]))


class Document:
    def __init__(self, identity, original, extraction, pdf=False):
        self.identity, self.original, self.extraction, self.pdf = identity, original, extraction, pdf
        self.original_hash, self.extraction_hash = file_hash(original), file_hash(extraction)
        self.text = (ROOT/extraction).read_text()

    def anchor(self, start, end):
        require(0 <= start < end <= len(self.text), "anchor range")
        out = dict(document=self.identity, original_path=self.original,
                   original_sha256=self.original_hash, extraction_path=self.extraction,
                   extraction_sha256=self.extraction_hash, offset_unit="Unicode code points",
                   start=start, end=end, quote=self.text[start:end])
        if self.pdf:
            page_start = self.text.rfind("\f", 0, start)+1
            page_end = self.text.find("\f", start)
            page = self.text[page_start:page_end if page_end >= 0 else len(self.text)]
            m = re.search(r"Apple Inc\. \| 2024 Form 10-K \| (\d+)", page)
            out.update(pdf_page=self.text.count("\f", 0, start)+1,
                       printed_page=int(m[1]) if m else None,
                       ending_pdf_page=self.text.count("\f", 0, end-1)+1)
        return out

    def find(self, pattern, bounds=None, flags=0):
        start, end = bounds or (0, len(self.text))
        matches = list(re.finditer(pattern, self.text[start:end], flags))
        require(len(matches) == 1, f"{self.identity}: expected unique span {pattern!r}, got {len(matches)}")
        m = matches[0]
        return self.anchor(start+m.start(), start+m.end())

    def page(self, printed):
        offset = 0
        for page in self.text.split("\f"):
            if re.search(r"Apple Inc\. \| 2024 Form 10-K \| " + str(printed) + r"\s*$", page):
                return offset, offset+len(page)
            offset += len(page)+1
        raise CaseError("printed page missing")

    def binding(self):
        return dict(id=self.identity, original_path=self.original, original_sha256=self.original_hash,
                    extraction_path=self.extraction, extraction_sha256=self.extraction_hash)


def discover_notes(doc, expected):
    matches = list(re.finditer(r"(?m)^[\f \t]*Note (\d+)\s*[–-]\s*([^\n]+)", doc.text))
    require([int(m[1]) for m in matches] == list(range(1, expected+1)), "missing, duplicate or reordered notes")
    marker = "Report of Independent Registered" if doc.pdf else "Item 2."
    out = []
    for i, m in enumerate(matches):
        end = matches[i+1].start() if i+1 < len(matches) else doc.text.find(marker, m.end())
        require(end > m.end(), "final note boundary missing")
        start = m.start() + len(m[0])-len(m[0].lstrip())
        out.append(dict(id=f"{doc.identity}.note.{m[1]}", number=int(m[1]), title=m[2].strip(),
                        anchor=doc.anchor(start, end), heading=doc.anchor(start, m.end())))
    return out


def context(period, dimensions=None):
    return dict(entity=ENTITY, entity_scheme="http://www.sec.gov/CIK", perimeter="consolidated",
                basis="US GAAP", currency="USD", period=period, dimensions=dimensions or {})


def observation(oid, concept, value, literal, scale, quantum, ctx, measurement, anchors, **extra):
    out = dict(id=oid, concept=concept, displayed_literal=literal, scale=scale,
               value_usd=str(value), presentation_quantum_usd=str(quantum), context=ctx,
               measurement=measurement, rounding_interval_usd=interval(value, quantum),
               source_readings=anchors, status="extracted_reading", **extra)
    return out


def annual_row(doc, label, column, ctx, concept, measurement, bounds, columns,
               header, oid, partition=None):
    # A row is selected by its label within a scoped table, never by its value.
    a = doc.find(r"^[ \t]*" + re.escape(label) + r"[ \t]{2,}[^\n]+", bounds, re.M)
    line = a["quote"]
    begin = line.index(label)+len(label)
    tokens = list(re.finditer(r"\(?[\d,]+(?:\.\d+)?\)?|—", line[begin:]))
    require(len(tokens) == columns, f"{label}: ambiguous table columns")
    token = tokens[column]
    start = a["start"]+begin+token.start()
    literal = token[0]
    return observation(oid, concept, number(literal)*MILLION, literal, 6, MILLION,
                       ctx, measurement, [dict(row=a, cell=doc.anchor(start, start+len(literal)),
                                               table_header=header, column_index=column)], partition=partition)


class InlineReader:
    """Strict subset of inline-XBRL used in this case, retaining raw ID anchors."""
    def __init__(self, doc):
        self.doc = doc
        self.raw = (ROOT/doc.original).read_text()
        self.soup = BeautifulSoup(self.raw, "html.parser")
        self.ids = {}
        for el in self.soup.find_all(id=True):
            require(el["id"] not in self.ids, "duplicate HTML/XBRL id")
            self.ids[el["id"]] = el
        self.facts = self.soup.find_all("ix:nonfraction")

    def raw_anchor(self, el):
        # Exact original bytes (ASCII-compatible UTF-8 text offsets), not soup serialization.
        pattern = r"<" + re.escape(el.name) + r"\b[^>]*\bid=[\"']" + re.escape(el["id"]) + r"[\"'][^>]*>.*?</" + re.escape(el.name) + r">"
        matches = list(re.finditer(pattern, self.raw, re.S | re.I))
        require(len(matches) == 1, "raw ID anchor missing/ambiguous")
        m = matches[0]
        return dict(path=self.doc.original, sha256=self.doc.original_hash,
                    start=m.start(), end=m.end(), quote=m[0], offset_unit="Unicode code points", id=el["id"])

    def resolve(self, ref, tag):
        require(ref in self.ids and self.ids[ref].name == tag, f"broken {tag} reference {ref}")
        return self.ids[ref]

    def parse_context(self, el):
        identifier = el.find_all("xbrli:identifier")
        require(len(identifier) == 1, "ambiguous entity")
        require(identifier[0].get("scheme") == "http://www.sec.gov/CIK", "unsupported entity scheme")
        period = el.find("xbrli:period")
        require(period is not None, "missing period")
        tags = [n for n in period.children if getattr(n, "name", None)]
        names = [n.name for n in tags]
        require(names in [["xbrli:instant"], ["xbrli:startdate", "xbrli:enddate"]], "unsupported period")
        dates = [date.fromisoformat(n.get_text()).isoformat() for n in tags]
        require(len(dates) == 1 or dates[0] <= dates[1], "reversed period")
        p = dict(instant=dates[0]) if len(dates) == 1 else dict(start=dates[0], end=dates[1])
        require(not el.find("xbrldi:typedmember") and not el.find("xbrli:scenario"), "unsupported context content")
        dims = {}
        for d in el.find_all("xbrldi:explicitmember"):
            require(d.get("dimension") and d["dimension"] not in dims, "duplicate/missing dimension")
            dims[d["dimension"]] = d.get_text()
        out = context(p, dims)
        out["entity"] = identifier[0].get_text()
        return out

    def parse(self, fact):
        cid, uid = fact.get("contextref"), fact.get("unitref")
        c, u = self.resolve(cid, "xbrli:context"), self.resolve(uid, "xbrli:unit")
        ctx = self.parse_context(c)
        measures = u.find_all("xbrli:measure")
        require(len(measures) == 1 and measures[0].get_text() == "iso4217:USD" and
                not u.find("xbrli:divide"), "unsupported currency/unit")
        require(fact.get("sign") in [None, "-"], "unsupported sign")
        require(not fact.get("xsi:nil") and not fact.get("continuedat"), "nil/continued numeric unsupported")
        require(re.fullmatch(r"-?\d+", fact.get("scale", "0")) is not None, "invalid scale")
        require(re.fullmatch(r"-?\d+", fact.get("decimals", "")) is not None, "unsupported precision")
        scale, decimals = int(fact.get("scale", "0")), int(fact["decimals"])
        require(-12 <= scale <= 12 and -12 <= decimals <= 12, "unbounded scale/precision")
        fmt, lit = fact.get("format"), fact.get_text(strip=True)
        if fmt == "ixt:fixed-zero":
            require(lit in ("—", "–", "0"), "invalid zero transform")
            v = Fraction(0)
        elif fmt == "ixt:num-dot-decimal":
            require(re.fullmatch(r"(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?", lit) is not None, "invalid decimal transform")
            v = number(lit)
        elif fmt is None:
            require(re.fullmatch(r"\d+(?:\.\d+)?", lit) is not None, "unformatted nonnumeric fact")
            v = Fraction(lit)
        else:
            raise CaseError("unsupported inline transform " + fmt)
        v *= power10(scale) * (-1 if fact.get("sign") == "-" else 1)
        row = fact.find_parent("tr")
        # Selected monetary rows must agree with the visual sign, unless narrative.
        cell = fact.find_parent("td")
        if cell:
            visible = cell.get_text("", strip=True)
            require(("(" in visible and ")" in visible) == (v < 0), "rendered/tagged sign mismatch")
        rowtext = row.get_text(" ", strip=True) if row else fact.parent.get_text(" ", strip=True)
        return dict(value=v, literal=lit, scale=scale, quantum=power10(-decimals), context=ctx,
                    raw=dict(fact=self.raw_anchor(fact), context=self.raw_anchor(c), unit=self.raw_anchor(u),
                             fact_id=fact["id"], context_id=cid, unit_id=uid, decimals=decimals,
                             sign=fact.get("sign"), transform=fmt, rendered_text=rowtext))

    def select(self, concept, ctx, measurement, oid, scale=6, decimals=-6, partition=None,
               label=None):
        candidates = []
        for f in self.facts:
            if f.get("name") != concept:
                continue
            c = self.resolve(f.get("contextref"), "xbrli:context")
            parsed_ctx = self.parse_context(c)
            if parsed_ctx == ctx:
                candidates.append(self.parse(f))
        require(candidates, f"missing required fact/context {concept} {ctx}")
        first = candidates[0]
        for c in candidates:
            require(c["value"] == first["value"] and c["quantum"] == first["quantum"], "conflicting repeated readings")
            require(c["scale"] == scale and c["raw"]["decimals"] == decimals, "wrong presentation scale/precision")
        if label:
            require(any(label in c["raw"]["rendered_text"] for c in candidates), "rendered label not found")
        return observation(oid, concept, first["value"], first["literal"], scale, first["quantum"],
                           ctx, measurement, [c["raw"] for c in candidates], partition=partition)


def same_context(obs, ignore=()):
    require(obs, "no operands")
    base = {k: v for k, v in obs[0]["context"].items() if k not in ignore}
    require(all({k: v for k, v in x["context"].items() if k not in ignore} == base for x in obs),
            "entity/currency/perimeter/basis/period/dimensions mismatch")
    require(base.get("entity") == ENTITY and base.get("perimeter") == "consolidated" and
            base.get("currency") == "USD" and base.get("basis") == "US GAAP" and
            base.get("entity_scheme") == "http://www.sec.gov/CIK", "unsupported case context")


def validate_value(obs):
    """Check value, precision and sign against the retained numeric reading."""
    value = Fraction(obs["value_usd"])
    require(obs["rounding_interval_usd"] == interval(value, obs["presentation_quantum_usd"]),
            "altered rounding interval")
    require(abs(value) == abs(number(obs["displayed_literal"])*power10(obs["scale"])),
            "literal/scale/value mismatch")
    require(obs["source_readings"], "missing numeric source")
    for source in obs["source_readings"]:
        if "cell" in source:
            require(value == number(source["cell"]["quote"])*MILLION and obs["scale"] == 6 and
                    Fraction(obs["presentation_quantum_usd"]) == MILLION, "annual cell/value mismatch")
        elif "fact" in source:
            fact = BeautifulSoup(source["fact"]["quote"], "html.parser").find("ix:nonfraction")
            require(fact is not None, "missing inline source")
            sign = -1 if fact.get("sign") == "-" else 1
            require(value == number(fact.get_text(strip=True))*power10(int(fact.get("scale", "0")))*sign,
                    "inline source/value mismatch")
            require(obs["scale"] == int(fact.get("scale", "0")) and
                    Fraction(obs["presentation_quantum_usd"]) == power10(-int(fact["decimals"])),
                    "inline precision mismatch")
        else:
            raise CaseError("unsupported numeric reading")


def reconcile(bridge_id, kind, operands, target, partition=None):
    all_obs = operands+[target]
    for obs in all_obs:
        validate_value(obs)
    transformations = []
    if kind == "cash_flow":
        require(len(operands) == 4, "cash flow operands")
        opening, *flows = operands
        require(opening["measurement"] == target["measurement"] == "cash_including_restricted", "cash perimeter mismatch")
        require(all(o["measurement"] == "cash_flow" for o in flows), "cash movement type")
        same_context(all_obs, ("period",))
        per = flows[0]["context"]["period"]
        require(all(x["context"]["period"] == per for x in flows), "flow period mismatch")
        require(opening["context"]["period"] == {"instant": (date.fromisoformat(per["start"])-timedelta(days=1)).isoformat()} and
                target["context"]["period"] == {"instant": per["end"]}, "stock/flow date mismatch")
        transformations.append("Opening instant is the day before the disclosed flow period; closing instant is its end. Cash includes restricted cash on both sides.")
    elif kind == "partition":
        same_context(all_obs, ("dimensions",))
        require(partition in ("product", "segment"), "unknown partition")
        expected = PRODUCTS if partition == "product" else SEGMENTS
        require([o.get("partition") for o in operands] == [partition]*len(expected), "overlapping or wrong partitions")
        require([o.get("member_label") for o in operands] == expected, "duplicate/missing partition member")
        require(all(o["measurement"] == "net_revenue" for o in all_obs) and not target["context"]["dimensions"], "revenue target")
        require(len({json.dumps(o["context"]["dimensions"], sort_keys=True) for o in operands}) == len(expected), "duplicate dimension members")
        axis, members = (("srt:ProductOrServiceAxis", PRODUCT_MEMBERS) if partition == "product" else
                         ("us-gaap:StatementBusinessSegmentsAxis", SEGMENT_MEMBERS))
        require([o["context"]["dimensions"] for o in operands] == [{axis: m} for m in members] and
                all(o["concept"] == REV for o in all_obs), "partition axis/member/concept mismatch")
        transformations.append("Sum one disclosed exhaustive table partition; product and geography are separate classifications of the same revenue.")
    else:
        same_context(all_obs)
        measurements = [o["measurement"] for o in operands]
        allowed = {
            "balance": (["carrying_amount", "carrying_amount"], "carrying_amount"),
            "debt_components": (["carrying_amount", "carrying_amount"], "carrying_amount"),
            "principal_to_carrying": (["principal", "carrying_adjustment", "carrying_adjustment"], "carrying_amount"),
            "ppe": (["gross_cost", "accumulated_depreciation"], "carrying_amount"),
            "equality": ([target["measurement"]], target["measurement"]),
            "rounded_debt": (["carrying_amount", "carrying_amount"], "carrying_amount"),
        }
        require(kind in allowed and (measurements, target["measurement"]) == allowed[kind], "measurement substitution")
        if kind == "balance":
            require([o["concept"] for o in all_obs] == ["us-gaap:Liabilities", "us-gaap:StockholdersEquity", "us-gaap:Assets"],
                    "balance concept mismatch")
        if kind in ("debt_components", "rounded_debt"):
            require([o["concept"] for o in operands] == ["us-gaap:LongTermDebtCurrent", "us-gaap:LongTermDebtNoncurrent"],
                    "debt component concept mismatch")
    value = sum(Fraction(o["value_usd"]) for o in operands)
    target_value = Fraction(target["value_usd"])
    lhs_interval = interval_sum(operands)
    rhs_interval = target["rounding_interval_usd"]
    rounding = compatible(lhs_interval, rhs_interval)
    require(rounding, "incompatible rounding intervals")
    if kind != "rounded_debt":
        require(value == target_value, "displayed arithmetic mismatch")
    return dict(id=bridge_id, kind=kind, operands=[o["id"] for o in operands], target=target["id"],
                lhs_usd=str(value), rhs_usd=str(target_value), residual_usd=str(value-target_value),
                lhs_interval_usd=list(map(str, lhs_interval)), rhs_interval_usd=rhs_interval,
                displayed_identity=value == target_value, rounding_compatible=rounding,
                status="pass", transformations=transformations,
                conclusion="displayed identity" if kind != "rounded_debt" else "rounding compatibility only")


def html_text(raw):
    soup = BeautifulSoup(raw, "html.parser")
    for el in soup(["script", "style"]):
        el.decompose()
    return soup.get_text("\n", strip=True)


def load_sources():
    for p, h in PINS.items():
        require(file_hash(p) == h, "source hash mismatch: " + p)
    annual = Document("annual", APPLE+"annual-2024.pdf", APPLE+"annual-2024.txt", pdf=True)
    interim = Document("interim", APPLE+"interim-2025q1.html", APPLE+"interim-2025q1.txt")
    extracted = subprocess.run(["pdftotext", "-layout", str(ROOT/annual.original), "-"],
                               capture_output=True, check=True, timeout=30).stdout
    require(sha(extracted) == annual.extraction_hash, "PDF extraction does not reproduce retained text")
    require(html_text((ROOT/interim.original).read_text()) == interim.text, "HTML extraction mismatch")
    register = json.loads((ROOT/REGISTER).read_text())
    bindings = []
    for d, name in [(annual, "apple-2024-annual"), (interim, "apple-2025-q1")]:
        candidates = [r for r in register["records"] if r["document_id"] == name]
        require(len(candidates) == 1, "P01 source identity")
        r = candidates[0]
        require(r["original_sha256"] == d.original_hash == file_hash(r["original_path"]), "P01 original binding")
        require(r["extracted_sha256"] == file_hash(r["extracted_path"]), "P01 extraction binding")
        bindings.append(dict(**d.binding(), p01_document=name, p01_original_path=r["original_path"],
                             p01_extraction_path=r["extracted_path"], p01_extraction_sha256=r["extracted_sha256"],
                             extraction_relation="identical" if r["extracted_sha256"] == d.extraction_hash else
                             "distinct text versions; offsets must not transfer",
                             p01_publication_metadata=r["publication_metadata"]))
    acquisitions = json.loads((ROOT/NEW/"acquisition.json").read_text())
    external_docs = {}
    for rec in acquisitions["records"]:
        if "path" not in rec:
            continue
        require(file_hash(rec["path"]) == rec["sha256"], "acquired bytes changed")
        if rec["path"].endswith(".html"):
            p = Path(rec["path"])
            extracted_path = str(p.with_suffix(".txt"))
            require((ROOT/extracted_path).exists(), "missing acquired text")
            require(html_text((ROOT/p).read_text()) == (ROOT/extracted_path).read_text(), "external extraction mismatch")
            d = Document(p.stem, str(p), extracted_path)
            external_docs[p.stem] = d
            bindings.append(dict(**d.binding(), acquisition=rec,
                                 historical_byte_vintage="not established by current retrieval"))
    return annual, interim, external_docs, bindings, acquisitions


def collect_observations(annual, interim):
    observations, bridges = [], []
    def put(o):
        require(o["id"] not in {x["id"] for x in observations}, "duplicate observation id")
        observations.append(o)
        return o
    def bridge(name, kind, operands, target, **kw):
        bridges.append(reconcile(name, kind, operands, target, **kw))
    def scope(page, start=None, end=None):
        lo, hi = annual.page(page)
        if start:
            lo = annual.find(re.escape(start), (lo, hi))["start"]
        if end:
            stop = annual.text.find(end, lo, hi)
            require(stop >= 0, "scope terminator missing")
            hi = stop
        return lo, hi
    def arow(label, col, ctx, concept, measure, bounds, cols, oid, partition=None):
        # Include the table's actual date headings and declared presentation scale.
        yr = annual.find(r"^[ \t]*2024[ \t]+2023(?:[ \t]+2022)?[ \t]*$", bounds, re.M)
        header = annual.anchor(bounds[0], yr["end"])
        return put(annual_row(annual, label, col, ctx, concept, measure, bounds, cols, header, oid, partition))
    a_bs = {}
    for col, day in enumerate(["2024-09-28", "2023-09-30"]):
        ctx = context(dict(instant=day))
        rows = {}
        for key, label, concept in [
            ("assets", "Total assets", "us-gaap:Assets"),
