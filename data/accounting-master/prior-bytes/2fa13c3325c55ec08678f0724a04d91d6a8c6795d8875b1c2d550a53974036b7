    return [
        dict(id="annual.perimeter", status="reported_policy", anchor=within(annual, r"The consolidated financial statements include.*?wholly owned subsidiaries\.")),
        dict(id="annual.reclassification", status="reported_qualification", anchor=within(annual, r"Certain prior period amounts.*?current period’s presentation\."),
             interpretation="Comparatives are as presented in the 2024 report; original historical presentation has not been reconstructed."),
