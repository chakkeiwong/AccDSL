        dict(id="annual.depreciation", status="reported_policy", anchor=within(annual, r"Depreciation on property, plant and equipment.*?straight-line basis\.")),
        dict(id="interim.preparation", status="reported_management_assertion", anchor=within(interim, r"In the opinion of the Company’s management.*?2024 Form 10-K”\)\."),
