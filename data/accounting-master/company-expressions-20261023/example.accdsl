program CompanyExpressionsDraft/1 'Northstar collection fraction and installments';
input discount '{"context":null,"dimensions":{},"kind":"number"}' 1/10;
input ordinary '{"kind":"boolean"}' true;
input_ref ordinary ordinary;
input_ref discount discount;
literal one '{"context":null,"dimensions":{},"kind":"number"}' 1/1;
literal two '{"context":null,"dimensions":{},"kind":"number"}' 2/1;
literal stress '{"context":null,"dimensions":{},"kind":"number"}' 4/5;
node regular sub one discount;
node fraction if ordinary regular stress;
node half div one two;
output first_share half;
output fraction fraction;
output second_share half;
end_program;
