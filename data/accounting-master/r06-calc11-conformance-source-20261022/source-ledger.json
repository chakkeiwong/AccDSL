        1250,
        1284
      ]
    },
    {
      "id": "A03",
      "source": "02-requirements",
      "section": "Title date",
      "quote": "Requirements Document 25 May 2022",
      "normalized_character_span": [
        68,
        101
      ]
    },
    {
      "id": "A04",
      "source": "03-history",
      "section": "Displayed release date/status",
      "quote": "2022-05-22 Supports Candidate Recommendation",
      "normalized_character_span": [
        437,
        481
      ]
    },
    {
      "id": "A05",
      "source": "02-requirements",
      "section": "1 Introduction",
      "quote": "which share the same period, dimensions and other contextual information.",
      "normalized_character_span": [
        1988,
        2061
      ]
    },
    {
      "id": "A06",
      "source": "02-requirements",
      "section": "2.3 Syntactic dependencies",
      "quote": "This effectively requires that all facts have the same dimensions, including both built-in and taxonomy-defined dimensions, and the same units.",
      "normalized_character_span": [
        4883,
        5026
      ]
    },
    {
      "id": "A07",
      "source": "02-requirements",
      "section": "2.3 Syntactic dependencies",
      "quote": "QNames that make use of different prefixes bound to the same namespace URI should be considered equivalent, but will not be unless the comparison is type-aware.",
      "normalized_character_span": [
        5428,
        5588
      ]
    },
    {
      "id": "A08",
      "source": "02-requirements",
      "section": "3.1 Calculation consistency",
      "quote": "Reported values should be deemed to be consistent with a calculation if there is a set of actual values from which the reported values could have been rounded which conform to the specified calculation.",
      "normalized_character_span": [
        6148,
        6350
      ]
    },
    {
      "id": "A09",
      "source": "02-requirements",
      "section": "3.2 Rounding methods",
      "quote": "The solution should support both \"round to nearest\" and truncation methods.",
      "normalized_character_span": [
        7319,
        7394
      ]
    },
    {
      "id": "A10",
      "source": "02-requirements",
      "section": "3.2 Ties",
      "quote": "Where the consistency of a calculation cannot be established without knowing which variation has been used, it should be treated as consistent.",
      "normalized_character_span": [
        7659,
        7802
      ]
    },
    {
      "id": "A11",
      "source": "02-requirements",
      "section": "3.3 Duplicate facts",
      "quote": "Where multiple consistent facts are present, the calculation should be checked using the most precise fact available.",
      "normalized_character_span": [
        8424,
        8541
      ]
    },
    {
      "id": "A12",
      "source": "02-requirements",
      "section": "3.4 Syntax independence",
      "quote": "The solution should be defined in terms of the report model defined in the Open Information Model and should not depend on the XML syntax defined in XBRL v2.1",
      "normalized_character_span": [
        8650,
        8808
      ]
    },
    {
      "id": "A13",
      "source": "02-requirements",
      "section": "4.1 Out of scope",
      "quote": "It should not attempt to introduce any new functionality, such as the ability to check cross-period or other cross-dimensional calculations.",
      "normalized_character_span": [
        9057,
        9197
      ]
    },
    {
      "id": "A14",
      "source": "02-requirements",
      "section": "Appendix B",
      "quote": "9 November 2021 Paul Warren Initial draft",
      "normalized_character_span": [
        11687,
        11728
      ]
    },
    {
      "id": "A15",
      "source": "prior-recommendation",
      "section": "5.1 Binding",
      "quote": "Two reported data points, a and b, are dimensionally aligned if for every dimension other than the concept core dimension in the {dimensions} property of a, the same dimension is present in b with an equal dimension value.",
      "normalized_character_span": [
        14183,
        14405
      ]
    },
    {
      "id": "A16",
      "source": "prior-recommendation",
      "section": "5.4 Duplicates",
      "quote": "Two facts are calculation 1.1 consistent duplicates if they meet the specification for OIM duplicate facts, with the modification that the interval used to establish numeric value consistency is the fact value interval, as defined in this specification.",
      "normalized_character_span": [
        21477,
        21730
      ]
    },
    {
      "id": "A17",
      "source": "prior-recommendation",
      "section": "5.5 Intersection",
      "quote": "Where consistent duplicates are present, the calculation is performed using the intersection of fact value intervals for all facts within the set.",
      "normalized_character_span": [
        22462,
        22608
      ]
    },
    {
      "id": "A18",
      "source": "prior-recommendation",
      "section": "5.5 Example",
      "quote": "These facts are consistent with having been rounded from a value in the range [5450, 5500], so this is the interval used for the calculation.",
      "normalized_character_span": [
        22793,
        22934
      ]
    }
  ],
