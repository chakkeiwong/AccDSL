{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' tests/test_accounting_p02.py\"","aggregated_output":"\"\"\"Deterministic real-input checks for the bounded Apple P02 case.\n\nThe tests deliberately exercise the retained annual PDF/text and interim HTML\nthrough the reusable case adapter.  Expected identities below are stated from\nthe filing rows themselves; they are not copied from a generated case result.\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport unittest\n\nfrom scripts import apple_case_v1 as case\n\n\nROOT = Path(__file__).resolve().parents[1]\nOUT = ROOT / \"data/accounting-master/deliverables/P02\"\nCASE_PATH = OUT / \"case.json\"\nANNUAL_TEXT = ROOT / \"docs/design/cases/apple/annual-2024.txt\"\nINTERIM_HTML = ROOT / \"docs/design/cases/apple/interim-2025q1.html\"\n\n\nclass AccountingP02Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.case_data = json.loads(CASE_PATH.read_text())\n        cls.by_id = {o[\"id\"]: o for o in cls.case_data[\"observations\"]}\n\n    def test_real_inputs_build_and_independent_annual_arithmetic(self):\n        built = case.build_case()\n        self.assertEqual(len(built[\"notes\"]), 23)\n        self.assertEqual(built[\"coverage\"][\"annual_notes\"], 13)\n        self.assertEqual(built[\"coverage\"][\"interim_notes\"], 10)\n        self.assertEqual(built[\"acceptance\"][\"empirical_forecast_validity\"],\n                         \"not evaluated; no forecast generated\")\n\n        annual = ANNUAL_TEXT.read_text()\n        debt_row = re.search(\n            r\"Total term debt principal.*?97,341.*?\\n.*?\"\n            r\"Unamortized premium/\\(discount\\) and issuance costs, net.*?\\(321\\).*?\\n.*?\"\n            r\"Hedge accounting fair value adjustments.*?\\(358\\).*?\\n.*?\"\n            r\"Total term debt\\s+96,662\",\n            annual,\n            re.S,\n        )\n        self.assertIsNotNone(debt_row)\n        # Independent displayed-million arithmetic from the retained PDF text.\n        self.assertEqual(Fraction(97341) - Fraction(321) - Fraction(358),\n                         Fraction(96662))\n        self.assertEqual(\n            Fraction(10912) + Fraction(85750),\n            Fraction(96662),\n        )\n        self.assertIn(\"30,737\", annual)\n        self.assertIn(\"29,965\", annual)\n\n        # The independent retained HTML contains the actual tagged facts used\n        # by the interim reader, including the rounded narrative debt fact.\n        interim = INTERIM_HTML.read_text()\n        self.assertIn('name=\"us-gaap:LongTermDebt\"', interim)\n        self.assertIn('>94.8</ix:nonFraction>', interim)\n\n    def test_cli_check_rebuilds_case_from_sources(self):\n        result = subprocess.run(\n            [\"python3\", \"-B\", \"scripts/apple_case_v1.py\", \"--check\",\n             \"--output-dir\", \"data/accounting-master/deliverables/P02\"],\n            cwd=ROOT, text=True, capture_output=True, check=False,\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        report = json.loads(result.stdout)\n        self.assertEqual(report[\"status\"], \"pass\")\n        self.assertEqual(report[\"notes\"], 23)\n        self.assertGreater(report[\"anchors\"], 500)\n\n    def test_note_inventory_and_boundary_mutations_are_rejected(self):\n        annual = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                               case.APPLE + \"annual-2024.txt\", pdf=True)\n        self.assertEqual(len(case.discover_notes(annual, 13)), 13)\n        duplicate = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                  case.APPLE + \"annual-2024.txt\", pdf=True)\n        duplicate.text = duplicate.text.replace(\"Note 2 –\", \"Note 1 –\", 1)\n        with self.assertRaises(case.CaseError):\n            case.discover_notes(duplicate, 13)\n        broken_boundary = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                        case.APPLE + \"annual-2024.txt\", pdf=True)\n        broken_boundary.text = broken_boundary.text.replace(\n            \"Report of Independent Registered\", \"Report marker removed\")\n        with self.assertRaises(case.CaseError):\n            case.discover_notes(broken_boundary, 13)\n\n    def test_anchor_quote_hash_and_metadata_revalidation_reject_mutations(self):\n        mutated = copy.deepcopy(self.case_data)\n        anchor = mutated[\"notes\"][0][\"anchor\"]\n        anchor[\"quote\"] = anchor[\"quote\"] + \" altered\"\n        with self.assertRaises(case.CaseError):\n            case.validate_anchors(mutated)\n\n        mutated = copy.deepcopy(self.case_data)\n        anchor = mutated[\"notes\"][0][\"anchor\"]\n        anchor[\"extraction_sha256\"] = \"0\" * 64\n        with self.assertRaises(case.CaseError):\n            case.validate_anchors(mutated)\n\n        mutated = copy.deepcopy(self.case_data)\n        mutated[\"observations\"][0][\"displayed_literal\"] = \"1\"\n        with self.assertRaises(case.CaseError):\n            case.validate_case(mutated)\n\n    def test_context_scale_sign_and_measurement_substitutions_reject(self):\n        assets = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.assets\"])\n        liabilities = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.liabilities\"])\n        equity = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.equity\"])\n\n        wrong_scale = copy.deepcopy(assets)\n        wrong_scale[\"scale\"] = 9\n        with self.assertRaises(case.CaseError):\n            case.validate_value(wrong_scale)\n\n        wrong_sign = copy.deepcopy(assets)\n        wrong_sign[\"value_usd\"] = \"-364980000000\"\n        with self.assertRaises(case.CaseError):\n            case.validate_value(wrong_sign)\n\n        wrong_perimeter = copy.deepcopy(equity)\n        wrong_perimeter[\"context\"][\"perimeter\"] = \"standalone\"\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.perimeter\", \"balance\",\n                           [liabilities, wrong_perimeter], assets)\n\n        fair_value = copy.deepcopy(self.by_id[\"interim.debt.2024-12-28.fair_value\"])\n        current = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_current\"])\n        noncurrent = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_noncurrent\"])\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.measurement\", \"rounded_debt\",\n                           [current, noncurrent], fair_value)\n\n    def test_cash_perimeter_and_revenue_axis_substitutions_reject(self):\n        opening = copy.deepcopy(self.by_id[\"annual.cf.2024.opening\"])\n        closing = copy.deepcopy(self.by_id[\"annual.cf.2024.closing\"])\n        flows = [copy.deepcopy(self.by_id[f\"annual.cf.2024.{k}\"])\n                 for k in (\"operating\", \"investing\", \"financing\")]\n        balance_sheet_cash = copy.deepcopy(self.by_id[\"annual.bs.2023-09-30.cash\"])\n        # 30,737 is the cash-flow opening balance; 29,965 is the prior\n        # balance-sheet cash-only figure.  The latter has the wrong perimeter.\n        self.assertEqual(Fraction(opening[\"displayed_literal\"].replace(\",\", \"\")),\n                         Fraction(30737))\n        self.assertEqual(Fraction(balance_sheet_cash[\"displayed_literal\"].replace(\",\", \"\")),\n                         Fraction(29965))\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.cash.perimeter\", \"cash_flow\",\n                           [balance_sheet_cash] + flows, closing)\n\n        product = [copy.deepcopy(self.by_id[f\"annual.product.2024.{i}\"])\n                   for i in range(5)]\n        product_total = copy.deepcopy(self.by_id[\"annual.revenue.2024\"])\n        self.assertEqual(case.reconcile(\"ok.product\", \"partition\", product,\n                                        product_total, partition=\"product\")[\"status\"],\n                         \"pass\")\n        product[0][\"context\"][\"dimensions\"] = {\n            \"us-gaap:StatementBusinessSegmentsAxis\": \"aapl:AmericasSegmentMember\"\n        }\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.product.axis\", \"partition\", product,\n                           product_total, partition=\"product\")\n\n    def test_inline_fact_context_and_unit_ids_are_required(self):\n        interim = case.Document(\"interim\", case.APPLE + \"interim-2025q1.html\",\n                                case.APPLE + \"interim-2025q1.txt\")\n        reader = case.InlineReader(interim)\n        fact = copy.copy(reader.facts[0])\n        fact[\"contextref\"] = \"missing-context\"\n        with self.assertRaises(case.CaseError):\n            reader.parse(fact)\n        fact = copy.copy(reader.facts[0])\n        fact[\"unitref\"] = \"missing-unit\"\n        with self.assertRaises(case.CaseError):\n            reader.parse(fact)\n\n    def test_rounding_compatibility_and_incompatibility_are_distinct(self):\n        current = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_current\"])\n        noncurrent = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_noncurrent\"])\n        rounded = copy.deepcopy(self.by_id[\"interim.debt.2024-12-28.rounded\"])\n        passing = case.reconcile(\"ok.rounded\", \"rounded_debt\",\n                                 [current, noncurrent], rounded)\n        self.assertTrue(passing[\"rounding_compatible\"])\n        self.assertFalse(passing[\"displayed_identity\"])\n\n        incompatible = copy.deepcopy(rounded)\n        incompatible[\"displayed_literal\"] = \"95.1\"\n        incompatible[\"value_usd\"] = \"95100000000\"\n        incompatible[\"rounding_interval_usd\"] = case.interval(\n            Fraction(\"95100000000\"), Fraction(\"100000000\"))\n        source = incompatible[\"source_readings\"][0][\"fact\"]\n        source[\"quote\"] = source[\"quote\"].replace(\">94.8<\", \">95.1<\")\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.rounded\", \"rounded_debt\",\n                           [current, noncurrent], incompatible)\n\n    def test_external_obligations_and_unidentified_histories_remain_explicit(self):\n        external = self.case_data[\"external\"]\n        self.assertTrue(external[\"partIII_and_package_obligations\"])\n        self.assertTrue(any(\"proxy\" in x.get(\"target\", \"\").lower()\n                            for x in external[\"partIII_and_package_obligations\"]))\n        self.assertTrue(any(x.get(\"contents_status\") ==\n                            \"internal_target_missing_in_retained_html\"\n                            for x in external[\"exhibit_inventory\"]))\n        views = case.version_view(self.case_data[\"filing_availability\"],\n                                  \"2024-11-01\", scope=\"retained_bytes\")\n        self.assertEqual({x[\"availability\"] for x in views[\"versions\"]},\n                         {\"unknown\"})\n        self.assertEqual(\n            {x[\"status\"] for x in self.case_data[\"unidentified_histories\"]},\n            {\"not_identified\"},\n        )\n        self.assertEqual(\n            self.case_data[\"representation_comparison\"][\"whole_document_equivalence\"],\n            False,\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport json,pathlib\nfor run in ['20261002T201419-9b58ed81','20261002T181809-4cb566e0']:\n p=pathlib.Path('data/accounting-master/runs')/run/'P02/approved-plan.json'; d=json.loads(p.read_text()); print(p, 'keys', list(d)); q=d.get('plan',d); print(json.dumps({k:q[k] for k in ['summary','steps','issues'] if k in q},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport json,pathlib\nfor run in ['20261002T201419-9b58ed81','20261002T181809-4cb566e0']:\n p=pathlib.Path('data/accounting-master/runs')/run/'P02/approved-plan.json'; d=json.loads(p.read_text()); print(p, 'keys', list(d)); q=d.get('plan',d); print(json.dumps({k:q[k] for k in ['summary','steps','issues'] if k in q},indent=2))\nPY\"","aggregated_output":"data/accounting-master/runs/20261002T201419-9b58ed81/P02/approved-plan.json keys ['plan', 'review', 'plan_hash']\n{\n  \"summary\": \"Continue P02 as a focused repair, not a restart. The existing nine tests and source rebuild pass, but result.md is absent and inspection found incorrect contract-source attribution, insufficient exhibit support, unverified note links and gaps in independent validation. The plan preserves every original criterion and the working partial implementation.\",\n  \"steps\": [\n    \"1. Continue from the approved plan and current partial implementation. Create a concise progress.md immediately in the implementation role, recording the verified baseline, defects above and next checks. Capture hashes of affected inputs and protected files. Restrict edits to scripts/apple_case_v1.py, tests/test_accounting_p02.py and P02 case.json, result.md and progress.md; add versioned source files only if necessary. Preserve existing successful extraction and reconciliation behavior.\",\n    \"2. Repair contract and exhibit support. Select the substantive Section 501 within the retained Exhibit 4.1 indenture, excluding its table of contents, cross-references and prospectus summary; terminate at the substantive Section 502. Keep any useful summary as a separately labelled source. Anchor actual retained contents for the annual securities-description exhibit, or downgrade its status if only index evidence is verified. Recheck that interpretations follow the selected passages, including series-specific qualifications.\",\n    \"3. Strengthen reusable source relationships. Verify interim note-to-fact membership through actual HTML note boundaries and original fact anchors, retaining extraction-specific offsets; reject an assigned quantity outside its note. Parse the selected issuer statement cells independently by table, label and period, then compare exact scaled values with annual observations. Remove authored numeric literals as the matching oracle. Reject ambiguous rows, wrong columns, context mismatches and unsupported interpretations.\",\n    \"4. Preserve all original case obligations. Retain 13 annual and 10 interim source-bounded dispositions, linked quantities or specific unresolved meanings, management assertions, policy qualifications and cross-references. Preserve every existing bridge family: annual/interim balance sheets and comparatives, principal/carrying/current/noncurrent debt, rounded interim debt, separate product and segment revenue partitions, PP&E and dated cash-flow bridges. Retain source-bound external targets, acquisition provenance, date-resolution availability and unidentified histories. Inspect existing retained public-source evidence first; record any inaccessible capability once without bypass, fabricated timestamps or repeated polling.\",\n    \"5. Extend tests with independent evidence. Assert selected PDF rows using fresh pdftotext output and independently specify expected debt, revenue, PP&E and cash-flow arithmetic. Add source-boundary tests distinguishing contract text from summary/index/TOC text and verifying note membership. Add table-column/value mutations, missing/reordered notes, wrong extraction offsets, broken fact/context/unit IDs, entity/currency/date/scale/sign/perimeter mutations, duplicate dimensions and conflicting repeated facts. Test mixed product/geography aggregation, fair-value/notional substitution, restricted-cash perimeter, exact rounding endpoints and incompatible intervals. Ensure each negative test fails for its intended reason, not an unrelated malformed field.\",\n    \"6. Complete temporal and provenance tests. Test unknown retained-byte availability, proxy evidence excluded before its filing date, multiple retained conflicting versions without automatic supersession, and metadata tampering against unchanged source bytes. Preserve P01's distinct interim extraction identity. Treat selected-table agreement as representation evidence only; do not infer whole-document equivalence or historical byte vintage.\",\n    \"7. Generate and document the repaired result before the final reserve. Write result.md with the deterministic evidence contract and assumption audit, actual commands/outcomes, changed source/code/test paths and hashes, environment/tool versions, unavailable Git provenance, elapsed time, input/output paths and approved-plan plus recovery-plan provenance. Include a decision table covering primary criteria, vetoes, uncertainties, next actions and nonclaims. Separate specified behavior, implementation, tested invariants, selected accounting identities, unevaluated forecasting and pending human acceptance. Run the listed checks, fix failures, update progress.md, and report exact unfinished work if the budget expires.\"\n  ],\n  \"issues\": [\n    \"result.md is missing although case.json directs readers there for executed-test evidence; the required implementation progress checkpoint is also missing.\",\n    \"external_records labels a prospectus-summary passage as section_501. Its anchor starts at character 42968, before the indenture begins at 97710. The substantive Section 501 exists at 190993; the comment claiming section numbers were omitted is wrong.\",\n    \"The annual.exhibit.4.1.in_pdf obligation claims heading and contents are retained, but its supporting anchor is only the exhibit-index entry on printed page 53.\",\n    \"Interim note-to-quantity links are assigned by observation-ID prefixes. The comment describes a source-containment check that the code does not perform.\",\n    \"Issuer representation checks search for hard-coded label/value pairs and copy the annual observation value into their result without independently parsing and comparing the issuer row's value.\",\n    \"The nine tests omit several approved adversarial checks, including rounding endpoints, conflicting repeated facts, entity/currency/date mutations, mixed revenue partitions and conflicting publication versions. Independent arithmetic coverage is concentrated on debt.\"\n  ]\n}\ndata/accounting-master/runs/20261002T181809-4cb566e0/P02/approved-plan.json keys ['plan', 'review', 'plan_hash']\n{\n  \"summary\": \"P02 can proceed as a bounded source-to-case implementation. Current retained-file hashes match the Apple manifest, and independent heading scans confirm 13 annual and 10 interim notes. The existing builder hard-codes selected statement/debt amounts, while interim Note 9 retains a generic unresolved disposition. P01\\u2019s accepted source register is in its run directory. Reuse the prior planning log\\u2019s verified findings and implement a new versioned module without rewriting preserved evidence. This plan addresses MC01, MC03, MC05, MC16 and MC28 without closing the wider gaps.\",\n  \"steps\": [\n    \"1. Establish the input and write boundaries. Read the accepted P01 register, Apple originals, extracted text, manifest and retained SEC submissions index. Recheck hashes and bind each original to its extraction and document identity. Create scripts/apple_case_v1.py and tests/test_accounting_p02.py. Write only case.json and result.md under data/accounting-master/deliverables/P02. Any newly acquired sources go into a new docs/design/cases/apple/p02-v1/ directory. Preserve existing builders, manifests, snapshots, benchmark files and controller files.\",\n    \"2. Implement reusable source-anchor and extraction functions. Annual anchors must include original/extraction hashes, PDF page, printed page where identifiable, exact text offsets and quotation; retain table headers and selected column locations. Interim extraction must resolve inline-XBRL fact, context and unit IDs from the retained HTML, including entity, instant/duration, dimensions, currency, scale, sign, decimals and supported transformation. Validate extracted values against rendered labels/text. Reject missing, ambiguous or unsupported interpretations rather than guessing. Keep source readings, annotations and derived results separate.\",\n    \"3. Build the 23-note disposition layer from actual source spans. Independently discover note boundaries, reconcile them with the inventory and exclude following auditor/MD&A sections. Give every note explicit linked quantities or a specific unresolved meaning, affected model areas, qualifications and cross-reference targets. Replace the generic interim Contingencies treatment with an anchored management assertion whose uncertainty is preserved without inventing a probability or zero liability. Record annual/interim policy differences from their own passages. Report inventory, numerical coverage and semantic coverage separately.\",\n    \"4. Implement context validation and exact reconciliation using Fraction or Decimal, with no binary-float tolerance. Select facts by concept, reporting date/period, entity, perimeter, dimensions, measurement basis and unit. Check annual/comparative/interim balance-sheet identities; annual principal-to-carrying and current/noncurrent debt bridges; interim statement debt against rounded narrative debt; annual and interim product/segment revenue totals separately against statement revenue; annual PP&E gross-to-net; and annual/interim cash-flow opening-plus-movements-to-closing balances. Preserve each operand\\u2019s source and explain every permitted context transformation.\",\n    \"5. Implement rounding-aware comparisons. Retain displayed values and precision separately from inferred intervals. Encode 97,341 \\u2212 321 \\u2212 358 = 96,662 and 10,912 + 85,750 = 96,662 as displayed annual debt identities, and 10,848 + 83,956 = 94,804 as the interim identity. Verify 94,804 million is compatible with the displayed 94.8 billion under an explicitly recorded rounding model. Distinguish carrying amount, principal, fair value and derivative notional. For rounded aggregates, propagate operand intervals exactly; never conceal mismatches with a broad epsilon.\",\n    \"6. Preserve unidentified histories explicitly. Link the disclosed fixed-rate debt, swap discussion and annual 14,575 million interest-rate notional while leaving contract allocation, reset dates, hedge coverage, interim exposure, asset cohorts and contingent outcomes unresolved where unsupported. Retain the existing financing stress only as a labelled conditional illustration, if included; do not promote its assumed exposure or zero-tax treatment into extracted facts. Do not manufacture a debt roll-forward from cash movements when FX, noncash and measurement movements remain unidentified.\",\n    \"7. Investigate incorporation and publication obligations. Enumerate exact annual Part III and exhibit-index targets, distinguish material already inside the retained PDF from external documents, and preserve internal-reference closure separately. Use the retained SEC index to identify the 2025 proxy accession 0001308179-25-000008 and the annual/interim filing identities. Inspect legitimate SEC or issuer sources for the proxy and financing agreements relevant to this slice. Preserve acquired bytes, hashes, retrieval times and exact supporting spans. Give remaining obligations their target document/exhibit, version, missing terms, consequence and next legitimate retrieval route. Keep mirror availability distinct from filing availability; a selected-table match does not establish whole-PDF publication equivalence.\",\n    \"8. Generate deterministic case.json containing source bindings, typed observations, all note dispositions, mappings, bridges, external obligations, availability records and unidentified-history records. Provide build and read-only --check CLI modes. result.md must record the pre-run evidence/default audit, actual commands, deterministic check results, changed-file hashes, environment, elapsed time, input/output paths, decision table and separate implementation/accounting/forecast/human-acceptance assessments. Use the reviewed phase packet as plan provenance; report unavailable Git provenance honestly.\"\n  ],\n  \"issues\": []\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,52p' scripts/apple_case_v1.py\nsed -n '650,787p' scripts/apple_case_v1.py\nsed -n '963,1065p' scripts/apple_case_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,52p' scripts/apple_case_v1.py\nsed -n '650,787p' scripts/apple_case_v1.py\nsed -n '963,1065p' scripts/apple_case_v1.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Bounded, source-bound Apple case. No acquisition or forecasting at build time.\n\nMappings below are annotations; numbers are read from pinned source bytes.\nAll amounts used by the arithmetic engine are exact rational USD amounts.\nRevalidation rebuilds from sources, so editing an observation's metadata cannot\nchange its source meaning. This is a case adapter, not a general XBRL processor.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom datetime import date, datetime, timedelta, timezone\nfrom fractions import Fraction\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\n\nfrom bs4 import BeautifulSoup\n\nROOT = Path(__file__).resolve().parents[1]\nAPPLE = \"docs/design/cases/apple/\"\nNEW = APPLE + \"p02-v1/\"\nREGISTER = \"data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json\"\nINDEX = \"data/financial-report-benchmark/landing/apple/21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42.json\"\nPLAN_HASH = \"916a4c80553bebee3ca0b6399ba8d4e54a6f5d3bd2975cda75815b95e8f45f59\"\nPINS = {\n    APPLE + \"annual-2024.pdf\": \"ec74758cd767465362c641cf2fd5d8fedd477aed2bf7f62117e67610435dcb88\",\n    APPLE + \"annual-2024.txt\": \"caaf182340d3846ff54cf967a2d3da7dce82505170665943ea7227e6bed8336e\",\n    APPLE + \"interim-2025q1.html\": \"2f7629f0733f75b3155dd52f7ae6a8724468e3cde1a9ce32fbce96d98f1ec27e\",\n    APPLE + \"interim-2025q1.txt\": \"ab8e06fc35957f43a355d0d1d11d57d203b494a4008edb39cff162e984ef633b\",\n    APPLE + \"manifest.json\": \"f25b63803d8a7e136befa10d68b935f521aa42ffc95663b6c26d792b0e4e5fc7\",\n    INDEX: \"21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42\",\n}\nMILLION = 10**6\nENTITY = \"0000320193\"\nPRODUCTS = [\"iPhone\", \"Mac\", \"iPad\", \"Wearables, Home and Accessories\", \"Services\"]\nSEGMENTS = [\"Americas\", \"Europe\", \"Greater China\", \"Japan\", \"Rest of Asia Pacific\"]\nPRODUCT_MEMBERS = [\"aapl:IPhoneMember\", \"aapl:MacMember\", \"aapl:IPadMember\",\n                   \"aapl:WearablesHomeandAccessoriesMember\", \"us-gaap:ServiceMember\"]\nSEGMENT_MEMBERS = [\"aapl:AmericasSegmentMember\", \"aapl:EuropeSegmentMember\",\n                   \"aapl:GreaterChinaSegmentMember\", \"aapl:JapanSegmentMember\",\n                   \"aapl:RestOfAsiaPacificSegmentMember\"]\nREV = \"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"\nCF_BAL = \"us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents\"\n\n\nclass CaseError(ValueError):\n    \"\"\"A source or interpretation fails the supported case contract.\"\"\"\n\n\n            yield from walk_anchors(item)\n\n\ndef validate_anchors(value):\n    cache = {}\n    def read(path, digest):\n        resolved = (ROOT/path).resolve()\n        require(resolved.is_relative_to(ROOT), \"anchor outside repository\")\n        if path not in cache:\n            data = resolved.read_bytes()\n            cache[path] = (sha(data), None if path.endswith('.pdf') else data.decode('utf-8'))\n        require(cache[path][0] == digest, \"anchor source hash mismatch\")\n        return cache[path][1]\n    count = 0\n    for a in walk_anchors(value):\n        if \"original_path\" in a:\n            read(a[\"original_path\"], a[\"original_sha256\"])\n            text = read(a[\"extraction_path\"], a[\"extraction_sha256\"])\n        else:\n            text = read(a[\"path\"], a[\"sha256\"])\n        require(a[\"offset_unit\"] == \"Unicode code points\" and\n                0 <= a[\"start\"] < a[\"end\"] <= len(text) and\n                text[a[\"start\"]:a[\"end\"]] == a[\"quote\"], \"broken source quotation/offset\")\n        if \"pdf_page\" in a:\n            doc = Document(a[\"document\"], a[\"original_path\"], a[\"extraction_path\"], True)\n            require(doc.anchor(a[\"start\"], a[\"end\"]) == a, \"PDF page/anchor mismatch\")\n        count += 1\n    return count\n\n\ndef note_records(annual, interim, observations):\n    notes = discover_notes(annual, 13)+discover_notes(interim, 10)\n    raw_ranges = raw_note_ranges(interim)\n    inventory = json.loads((ROOT/APPLE/\"manifest.json\").read_text())[\"notes\"]\n    require([(n[\"id\"], n[\"title\"]) for n in notes] == [(n[\"id\"], n[\"title\"]) for n in inventory],\n            \"note inventory disagreement\")\n    for note in notes:\n        areas, interpretation, unknown = NOTE_MEANING[note[\"title\"]]\n        note.update(disposition=\"partially_mapped\" if note[\"number\"] in (1, 2, 4) else \"unresolved_meaning_retained\",\n                    affected_model_areas=areas, interpretation=interpretation,\n                    unresolved_meaning=unknown, semantic_completion=False, linked_quantities=[], linked_quantity_evidence=[],\n                    qualifications=\"The full bounded source passage is retained; only the stated interpretation is applied.\")\n        a = note[\"anchor\"]\n        for obs in observations:\n            for source in walk_anchors(obs[\"source_readings\"]):\n                if source.get(\"extraction_path\") == a[\"extraction_path\"] and a[\"start\"] <= source[\"start\"] < a[\"end\"]:\n                    note[\"linked_quantities\"].append(obs[\"id\"])\n                    note[\"linked_quantity_evidence\"].append(dict(observation=obs[\"id\"], method=\"extraction_anchor_containment\", source=source))\n                    break\n        # Inline facts use raw HTML offsets, which are distinct from the text\n        # extraction.  Membership is source containment, never an ID prefix.\n        if a[\"document\"] == \"interim\":\n            boundary = raw_ranges[note[\"number\"]]\n            note[\"raw_note_boundary\"] = boundary\n            for obs in observations:\n                for reading in obs[\"source_readings\"]:\n                    fact = reading.get(\"fact\") if isinstance(reading, dict) else None\n                    if fact and fact.get(\"path\") == interim.original and boundary[\"start\"] <= fact[\"start\"] < boundary[\"end\"]:\n                        note[\"linked_quantities\"].append(obs[\"id\"])\n                        note[\"linked_quantity_evidence\"].append(dict(observation=obs[\"id\"], method=\"raw_html_fact_containment\", source=fact))\n                        break\n        note[\"linked_quantities\"] = sorted(set(note[\"linked_quantities\"]))\n        note[\"linked_quantity_evidence\"] = sorted(note[\"linked_quantity_evidence\"], key=lambda x: x[\"observation\"])\n        if note[\"linked_quantities\"]:\n            note[\"disposition\"] = \"selected_quantities_mapped_with_unresolved_remainder\"\n        targets = sorted(set(int(n) for n in re.findall(r\"Note\\s+(\\d+)\", a[\"quote\"])))\n        note[\"cross_references\"] = [dict(target=f\"{a['document']}.note.{n}\",\n                                         relation=\"literal note reference\", status=\"source_present; meaning not necessarily executed\")\n                                    for n in targets if n != note[\"number\"]]\n        require(all(t[\"target\"] in {n[\"id\"] for n in notes} for t in note[\"cross_references\"]), \"unresolved internal note target\")\n    by_id = {n[\"id\"]: n for n in notes}\n    by_id[\"annual.note.9\"][\"cross_references\"].append(dict(target=\"annual.note.4\", relation=\"analyst link: debt and interest-rate swaps\", status=\"source_present\"))\n    by_id[\"interim.note.1\"][\"cross_references\"].append(dict(target=\"annual.note.1\", relation=\"explicit read-with-2024-10-K qualification\", status=\"source_present\"))\n    contingency = by_id[\"interim.note.9\"]\n    contingency[\"assertion\"] = dict(kind=\"reported_management_assessment\", speaker=\"Apple management\",\n        subject=\"asserted legal and other claims\", modal_operator=\"not at least a reasonable possibility\",\n        assessed_event=\"material loss, or material loss greater than a recorded accrual\",\n        unresolved_outcomes=True, probability=None, liability_amount=None,\n        anchor=interim.find(r\"The Company is subject to various legal proceedings.*?asserted legal and other claims\\.\",\n                            (contingency[\"anchor\"][\"start\"], contingency[\"anchor\"][\"end\"]), re.S))\n    return notes\n\n\ndef raw_note_ranges(doc):\n    \"\"\"Return raw HTML ranges for actual interim note headings.\"\"\"\n    raw = (ROOT/doc.original).read_text()\n    headings = list(re.finditer(r\">Note\\s+(\\d+)\\s+&#8211;\\s+<ix:nonNumeric\\b\", raw, re.I))\n    require([int(m[1]) for m in headings] == list(range(1, 11)),\n            \"missing, duplicate or reordered raw note headings\")\n    stop = re.search(r\"Item 2\\.(?:&#160;)+Management\", raw[headings[-1].end():])\n    require(stop is not None, \"raw final note boundary missing\")\n    final = headings[-1].end()+stop.start()\n    return {int(m[1]): dict(path=doc.original, sha256=doc.original_hash,\n                             start=m.start(), end=(headings[i+1].start() if i+1 < len(headings) else final),\n                             quote=raw[m.start():(headings[i+1].start() if i+1 < len(headings) else final)],\n                             offset_unit=\"Unicode code points\")\n            for i, m in enumerate(headings)}\n\n\ndef supported_excerpt(doc, pattern, bounds=None):\n    return doc.find(pattern, bounds, re.S)\n\n\ndef rendered_row_match(doc, label, occurrence=0, column=0):\n    \"\"\"Parse a row independently in a dated issuer statement table.\"\"\"\n    revenue = label == \"Total net sales\"\n    title = \"CONSOLIDATED STATEMENTS OF OPERATIONS\" if revenue else \"CONSOLIDATED BALANCE SHEETS\"\n    stop = \"CONSOLIDATED STATEMENTS OF COMPREHENSIVE INCOME\" if revenue else \"CONSOLIDATED STATEMENTS OF SHAREHOLDERS\"\n    start = doc.text.find(title)\n    end = doc.text.find(stop, start + len(title))\n    require(start >= 0 and end > start, \"issuer statement boundary missing\")\n    section = doc.text[start:end]\n    require(\"In millions\" in section, \"issuer statement scale missing\")\n    dates = re.findall(r\"(September \\d+,)\\s*(20\\d{2})\", section)\n    expected = [(\"September 28,\", \"2024\"), (\"September 30,\", \"2023\")]\n    if revenue:\n        expected.append((\"September 24,\", \"2022\"))\n    require(dates[:len(expected)] == expected and 0 <= column < len(expected), \"issuer period/column mismatch\")\n    lines = list(re.finditer(r\"[^\\n]+\", section))\n    rows = [i for i, line in enumerate(lines) if line[0] == label]\n    require(len(rows) == (2 if label == \"Term debt\" else 1), \"ambiguous issuer row\")\n    require(0 <= occurrence < len(rows), \"issuer row occurrence\")\n    values = []\n    j = rows[occurrence] + 1\n    while j < len(lines) and len(values) < len(expected):\n        literal = lines[j][0]\n        if literal != \"$\":\n            number(literal)\n            values.append(lines[j])\n        j += 1\n    require(len(values) == len(expected), \"issuer table column count\")\n    cell = values[column]\n    return doc.anchor(start + cell.start(), start + cell.end()), cell[0]\n\n\ndef policy_records(annual, interim, notes):\n    n = {r[\"id\"]: r for r in notes}\n    def within(doc, pattern):\ndef build_case():\n    annual, interim, docs, bindings, acquisitions = load_sources()\n    observations, bridges, calendar = collect_observations(annual, interim)\n    notes = note_records(annual, interim, observations)\n    # A selected-table check relates representations, not whole-document\n    # publication vintage.  The issuer-linked HTML is rendered filing text,\n    # so bind visible label/value rows instead of treating it as a second\n    # inline-XBRL instance.  The accounting observations remain sourced from\n    # the retained annual/interim documents above.\n    rendered_specs = [\n        (\"annual.bs.2024-09-28.assets\", \"Total assets\", 0),\n        (\"annual.bs.2024-09-28.liabilities\", \"Total liabilities\", 0),\n        (\"annual.bs.2024-09-28.equity\", \"Total shareholders’ equity\", 0),\n        (\"annual.bs.2024-09-28.debt_current\", \"Term debt\", 0),\n        (\"annual.bs.2024-09-28.debt_noncurrent\", \"Term debt\", 1),\n        (\"annual.revenue.2024\", \"Total net sales\", 0),\n    ]\n    rendered_checks = []\n    for oid, label, occurrence in rendered_specs:\n        annual_observation = next(o for o in observations if o[\"id\"] == oid)\n        source, literal = rendered_row_match(docs[\"annual-2024-official\"], label, occurrence)\n        source_value = number(literal)*MILLION\n        require(source_value == Fraction(annual_observation[\"value_usd\"]),\n                \"issuer/annual selected value mismatch: \" + oid)\n        rendered_checks.append(dict(\n            id=\"issuer_html.\" + oid,\n            annual_observation=oid,\n            label=label,\n            displayed_literal=literal,\n            source=source,\n            status=\"independently_parsed_visible_value_agreement\",\n            interpretation=\"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\",\n            source_value_usd=str(source_value),\n        ))\n    matched = [x[\"annual_observation\"] for x in rendered_checks]\n    policy = policy_records(annual, interim, notes)\n    external = external_records(annual, interim, docs)\n    records = filing_records()\n    out = dict(schema_version=\"accdsl.apple_case.v1\", plan_sha256=PLAN_HASH,\n        scope=\"Retained Apple FY2024 annual, FY2025 Q1 interim and disclosed comparatives; selected numerical bridges only.\",\n        source_bindings=bindings, source_pins=PINS, p01_register=dict(path=REGISTER, sha256=file_hash(REGISTER)),\n        source_acquisition=acquisitions, fiscal_calendar=calendar, policies=policy,\n        observations=observations, notes=notes, reconciliations=bridges, external=external,\n        filing_availability=records, unidentified_histories=unidentified_records(notes),\n        rounding_model=dict(arithmetic=\"exact rational USD\", model=\"closed half-unit nearest-rounding intervals\",\n                            issuer_tie_rule=\"unknown\", inference=\"compatibility only; no distribution or identified underlying exact amounts\"),\n        representation_comparison=dict(matched_observations=matched, rendered_row_checks=rendered_checks,\n                                       whole_document_equivalence=False, mirror_publication_date=None,\n                                       historical_byte_vintage=\"not established\"),\n        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n        mapping_contract=dict(kind=\"explicit case annotations\", context_source=\"Report policies, table headings and original inline contexts\",\n            annual_dates=\"Fiscal year-end table headings plus Note 1 week lengths; duration starts are derived, not calendar-year substitutions.\",\n            partitions=\"Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.\",\n            measurements=\"Debt principal, carrying amount, fair value and derivative notional remain distinct.\",\n            supported_transformations=\"Only the recorded partition aggregation, gross/net signed addition, comparative equality and dated cash movement bridges.\"),\n        acceptance=dict(specified_behavior=\"reviewed P02 plan\", implemented=\"bounded reusable source/context/reconciliation adapter\",\n                        tested_invariants=\"see result.md for executed tests\", accounting_validity=\"selected displayed identities only; no compliance determination\",\n                        empirical_forecast_validity=\"not evaluated; no forecast generated\", human_acceptance=\"pending\"))\n    out[\"anchor_count\"] = validate_anchors(out)\n    return out\n\n\ndef validate_case(candidate):\n    \"\"\"Rebuild from independently pinned sources, rejecting supplied metadata edits.\"\"\"\n    validate_anchors(candidate)\n    expected = build_case()\n    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n    return {\"status\": \"pass\", \"observations\": len(expected[\"observations\"]),\n            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n            \"anchors\": expected[\"anchor_count\"]}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--output-dir\", default=\"data/accounting-master/deliverables/P02\")\n    parser.add_argument(\"--check\", action=\"store_true\", help=\"read-only rebuild and comparison\")\n    args = parser.parse_args()\n    target = ROOT / args.output_dir / \"case.json\"\n    if args.check:\n        report = validate_case(json.loads(target.read_text()))\n    else:\n        case = build_case()\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(case, ensure_ascii=False, indent=2, sort_keys=True)+\"\\n\")\n        report = dict(status=\"built\", **case[\"coverage\"])\n    print(json.dumps(report, sort_keys=True))\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
