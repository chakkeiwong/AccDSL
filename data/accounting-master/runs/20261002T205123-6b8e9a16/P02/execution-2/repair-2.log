{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '644,765p' scripts/apple_case_v1.py\"","aggregated_output":"def walk_anchors(value):\n    if isinstance(value, dict):\n        if {\"start\", \"end\", \"quote\", \"offset_unit\"} <= value.keys():\n            yield value\n        for item in value.values():\n            yield from walk_anchors(item)\n    elif isinstance(value, list):\n        for item in value:\n            yield from walk_anchors(item)\n\n\ndef validate_anchors(value):\n    cache = {}\n    def read(path, digest):\n        resolved = (ROOT/path).resolve()\n        require(resolved.is_relative_to(ROOT), \"anchor outside repository\")\n        if path not in cache:\n            data = resolved.read_bytes()\n            cache[path] = (sha(data), None if path.endswith('.pdf') else data.decode('utf-8'))\n        require(cache[path][0] == digest, \"anchor source hash mismatch\")\n        return cache[path][1]\n    count = 0\n    for a in walk_anchors(value):\n        if \"original_path\" in a:\n            read(a[\"original_path\"], a[\"original_sha256\"])\n            text = read(a[\"extraction_path\"], a[\"extraction_sha256\"])\n        else:\n            text = read(a[\"path\"], a[\"sha256\"])\n        require(a[\"offset_unit\"] == \"Unicode code points\" and\n                0 <= a[\"start\"] < a[\"end\"] <= len(text) and\n                text[a[\"start\"]:a[\"end\"]] == a[\"quote\"], \"broken source quotation/offset\")\n        if \"pdf_page\" in a:\n            doc = Document(a[\"document\"], a[\"original_path\"], a[\"extraction_path\"], True)\n            require(doc.anchor(a[\"start\"], a[\"end\"]) == a, \"PDF page/anchor mismatch\")\n        count += 1\n    return count\n\n\ndef contains_source(boundary, source):\n    \"\"\"Contain a complete span in the same immutable extraction or raw file.\"\"\"\n    if \"extraction_path\" in boundary:\n        keys = (\"original_path\", \"original_sha256\", \"extraction_path\", \"extraction_sha256\")\n    else:\n        keys = (\"path\", \"sha256\")\n    return (all(source.get(k) == boundary.get(k) for k in keys) and\n            source.get(\"offset_unit\") == boundary.get(\"offset_unit\") and\n            boundary[\"start\"] <= source[\"start\"] < source[\"end\"] <= boundary[\"end\"])\n\n\ndef validate_note_links(notes, observations):\n    by_id = {o[\"id\"]: o for o in observations}\n    require(len(by_id) == len(observations), \"duplicate observation id\")\n    for note in notes:\n        linked = []\n        for link in note[\"linked_quantity_evidence\"]:\n            oid = link[\"observation\"]\n            require(oid in by_id, \"unknown note observation\")\n            require(link[\"source\"] in list(walk_anchors(by_id[oid][\"source_readings\"])),\n                    \"note link is not an observation source\")\n            method = link[\"method\"]\n            require(method in (\"raw_html_fact_containment\", \"extraction_anchor_containment\"),\n                    \"unsupported note membership method\")\n            boundary = note.get(\"raw_note_boundary\") if method == \"raw_html_fact_containment\" else note[\"anchor\"]\n            require(boundary is not None and contains_source(boundary, link[\"source\"]),\n                    \"note source span/extraction mismatch\")\n            linked.append(oid)\n        require(note[\"linked_quantities\"] == sorted(set(linked)), \"note link inventory mismatch\")\n\n\ndef note_records(annual, interim, observations):\n    notes = discover_notes(annual, 13)+discover_notes(interim, 10)\n    raw_ranges = raw_note_ranges(interim)\n    inventory = json.loads((ROOT/APPLE/\"manifest.json\").read_text())[\"notes\"]\n    require([(n[\"id\"], n[\"title\"]) for n in notes] == [(n[\"id\"], n[\"title\"]) for n in inventory],\n            \"note inventory disagreement\")\n    for note in notes:\n        areas, interpretation, unknown = NOTE_MEANING[note[\"title\"]]\n        note.update(disposition=\"partially_mapped\" if note[\"number\"] in (1, 2, 4) else \"unresolved_meaning_retained\",\n                    affected_model_areas=areas, interpretation=interpretation,\n                    unresolved_meaning=unknown, semantic_completion=False, linked_quantities=[], linked_quantity_evidence=[],\n                    qualifications=\"The full bounded source passage is retained; only the stated interpretation is applied.\")\n        a = note[\"anchor\"]\n        for obs in observations:\n            for source in walk_anchors(obs[\"source_readings\"]):\n                if contains_source(a, source):\n                    note[\"linked_quantities\"].append(obs[\"id\"])\n                    note[\"linked_quantity_evidence\"].append(dict(observation=obs[\"id\"], method=\"extraction_anchor_containment\", source=source))\n                    break\n        # Inline facts use raw HTML offsets, which are distinct from the text\n        # extraction.  Membership is source containment, never an ID prefix.\n        if a[\"document\"] == \"interim\":\n            boundary = raw_ranges[note[\"number\"]]\n            note[\"raw_note_boundary\"] = boundary\n            for obs in observations:\n                for reading in obs[\"source_readings\"]:\n                    fact = reading.get(\"fact\") if isinstance(reading, dict) else None\n                    if fact and contains_source(boundary, fact):\n                        note[\"linked_quantities\"].append(obs[\"id\"])\n                        note[\"linked_quantity_evidence\"].append(dict(observation=obs[\"id\"], method=\"raw_html_fact_containment\", source=fact))\n                        break\n        note[\"linked_quantities\"] = sorted(set(note[\"linked_quantities\"]))\n        note[\"linked_quantity_evidence\"] = sorted(note[\"linked_quantity_evidence\"], key=lambda x: x[\"observation\"])\n        if note[\"linked_quantities\"]:\n            note[\"disposition\"] = \"selected_quantities_mapped_with_unresolved_remainder\"\n        targets = sorted(set(int(n) for n in re.findall(r\"Note\\s+(\\d+)\", a[\"quote\"])))\n        note[\"cross_references\"] = [dict(target=f\"{a['document']}.note.{n}\",\n                                         relation=\"literal note reference\", status=\"source_present; meaning not necessarily executed\")\n                                    for n in targets if n != note[\"number\"]]\n        require(all(t[\"target\"] in {n[\"id\"] for n in notes} for t in note[\"cross_references\"]), \"unresolved internal note target\")\n    by_id = {n[\"id\"]: n for n in notes}\n    by_id[\"annual.note.9\"][\"cross_references\"].append(dict(target=\"annual.note.4\", relation=\"analyst link: debt and interest-rate swaps\", status=\"source_present\"))\n    by_id[\"interim.note.1\"][\"cross_references\"].append(dict(target=\"annual.note.1\", relation=\"explicit read-with-2024-10-K qualification\", status=\"source_present\"))\n    contingency = by_id[\"interim.note.9\"]\n    contingency[\"assertion\"] = dict(kind=\"reported_management_assessment\", speaker=\"Apple management\",\n        subject=\"asserted legal and other claims\", modal_operator=\"not at least a reasonable possibility\",\n        assessed_event=\"material loss, or material loss greater than a recorded accrual\",\n        unresolved_outcomes=True, probability=None, liability_amount=None,\n        anchor=interim.find(r\"The Company is subject to various legal proceedings.*?asserted legal and other claims\\.\",\n                            (contingency[\"anchor\"][\"start\"], contingency[\"anchor\"][\"end\"]), re.S))\n    return notes\n\n\n","exit_code":0,"status":"completed"}}
