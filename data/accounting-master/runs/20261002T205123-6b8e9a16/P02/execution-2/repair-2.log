{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '835,975p' scripts/apple_case_v1.py\"","aggregated_output":"def filing_records():\n    raw = json.loads((ROOT/INDEX).read_text())[\"filings\"][\"recent\"]\n    out = []\n    for identity, accession in [(\"annual\", \"0000320193-24-000123\"),\n                                (\"interim\", \"0000320193-25-000008\"),\n                                (\"proxy\", \"0001308179-25-000008\")]:\n        require(raw[\"accessionNumber\"].count(accession) == 1, \"filing identity missing/ambiguous\")\n        i = raw[\"accessionNumber\"].index(accession)\n        out.append(dict(id=identity, accession=accession, form=raw[\"form\"][i], report_date=raw[\"reportDate\"][i],\n                        filing_date=raw[\"filingDate\"][i], acceptance_timestamp=raw[\"acceptanceDateTime\"][i],\n                        primary_document=raw[\"primaryDocument\"][i], index_path=INDEX, index_sha256=file_hash(INDEX),\n                        json_pointer=f\"/filings/recent/accessionNumber/{i}\",\n                        public_dissemination_timestamp=None, retained_byte_publication_date=None,\n                        qualification=\"Acceptance is index metadata, not independently verified public dissemination or retained-byte vintage.\"))\n    return out\n\n\ndef availability(record, cutoff, scope=\"filing_identity\"):\n    \"\"\"Date-resolution query; unknown byte vintage never inherits a filing date.\"\"\"\n    cutoff = date.fromisoformat(cutoff)\n    require(scope in (\"filing_identity\", \"retained_bytes\"), \"unsupported availability scope\")\n    day = record.get(\"filing_date\" if scope == \"filing_identity\" else \"retained_byte_publication_date\")\n    return \"unknown\" if day is None else (\"available_by_filing_day\" if date.fromisoformat(day) <= cutoff else \"later\")\n\n\ndef version_view(records, cutoff, scope=\"retained_bytes\"):\n    require(len({r[\"id\"] for r in records}) == len(records), \"duplicate version identity\")\n    decisions = [{\"id\": r[\"id\"], \"availability\": availability(r, cutoff, scope)} for r in records]\n    eligible = [d[\"id\"] for d in decisions if d[\"availability\"] == \"available_by_filing_day\"]\n    return dict(versions=decisions, eligible=eligible,\n                resolution=\"retain_all_no_automatic_supersession\", conflict_resolution=\"unsupported\")\n\n\ndef exhibit_records(annual, official, interim):\n    \"\"\"Read exhibit target/version columns; distinguish a link from its contents.\"\"\"\n    result = []\n    for doc, prefix in [(official, \"annual\"), (interim, \"interim\")]:\n        soup = BeautifulSoup((ROOT/doc.original).read_text(), \"html.parser\")\n        for tr in soup.find_all(\"tr\"):\n            cells = [c.get_text(\" \", strip=True) for c in tr.find_all(\"td\", recursive=False)]\n            cells = [c for c in cells if c]\n            if len(cells) < 2 or not re.fullmatch(r\"(?:\\d+\\.\\d+|101|104)[*, ]*\", cells[0]):\n                continue\n            # Exclude financial rows and identify only the exhibit-index description cells.\n            if not tr.find(\"a\", href=True) and \"**\" not in cells[0]:\n                continue\n            number = re.match(r\"\\d+(?:\\.\\d+)?\", cells[0])[0]\n            row_text = tr.get_text(\"\\n\", strip=True)\n            anchor = doc.find(re.escape(row_text))\n            links = [a[\"href\"] for a in tr.find_all(\"a\", href=True)]\n            internal = [u for u in links if u.startswith(\"#\")]\n            external = [u for u in links if u.startswith(\"http\")]\n            record = dict(id=f\"{prefix}.exhibit.{number}\", number=number, description=cells[1],\n                          filed_marker=cells[0], source=anchor, target_links=links,\n                          referenced_form=cells[2] if len(cells) >= 5 else None,\n                          referenced_exhibit=cells[3] if len(cells) >= 5 else None,\n                          referenced_date_or_period=cells[4] if len(cells) >= 5 else None,\n                          contents_status=\"unresolved\", missing_terms=\"Full substantive interpretation and applicability to current contracts.\",\n                          consequence=\"No complete incorporated-package or contract-history claim.\",\n                          next_route=\"Use the exact SEC accession in the link or the issuer filing feed for the stated form and date.\")\n            if internal:\n                missing_internal = [u for u in internal\n                                    if soup.find(id=u[1:]) is None and\n                                    soup.find(attrs={\"name\": u[1:]}) is None]\n                if missing_internal:\n                    # A malformed or stale anchor is itself evidence about\n                    # package closure.  Preserve it as an unresolved filing\n                    # obligation instead of silently treating the link as\n                    # resolved or aborting the whole bounded case build.\n                    record[\"contents_status\"] = \"internal_target_missing_in_retained_html\"\n                    record[\"missing_internal_targets\"] = missing_internal\n                    record[\"missing_terms\"] = \"Retained issuer HTML exposes an internal link whose target is absent; substantive exhibit contents remain unverified.\"\n                else:\n                    record[\"contents_status\"] = \"within_retained_issuer_html; semantics_unresolved\"\n            if external:\n                record[\"contents_status\"] = \"external_target_not_acquired\"\n            if number in (\"101\", \"104\"):\n                record[\"contents_status\"] = \"inline_facts_present; complete_taxonomy_package_not_acquired\"\n                record[\"missing_terms\"] = \"Separate taxonomy/linkbase files and complete package validation.\"\n            if prefix == \"annual\":\n                # Bind each issuer index row independently to the mirrored PDF index.\n                lo, hi = annual.page(53)[0], annual.page(56)[1]\n                record[\"pdf_index_row\"] = annual.find(r\"^[ \\t]*\"+re.escape(number)+r\"(?=[* \\t])[^\\n]+\", (lo, hi), re.M)\n            result.append(record)\n    require(len({r[\"id\"] for r in result}) == len(result), \"duplicate exhibit rows\")\n    return result\n\n\ndef external_records(annual, interim, docs):\n    proxy, reg, official = [docs[k] for k in (\"proxy-2025\", \"registration-2021\", \"annual-2024-official\")]\n    exhibits = exhibit_records(annual, official, interim)\n    obligations = []\n    proxy_patterns = {\n        10: r\"Board Independence\\nApple’s Corporate Governance Guidelines.*?applicable rules of The Nasdaq Stock Market LLC.*?\\(“Nasdaq”\\)\\.\",\n        11: r\"Compensation Discussion and Analysis\\nThis Compensation.*?paid to our named executive officers\\.\",\n        12: r\"Security\\nOwnership of Certain Beneficial Owners and Management\\nThe\\nfollowing table.*?\\(the “Table Date”\\)\",\n        13: r\"Related Party Policy and Transactions\\nThe Board has.*?\\$120,000 in a single fiscal year\",\n        14: r\"Audit Fees\\n\\(1\\).*?Total\\n30,270,822\\n25,403,329\",\n    }\n    lo, hi = annual.page(52)\n    for item, pat in proxy_patterns.items():\n        start = annual.find(r\"Item \"+str(item)+r\"\\.[^\\n]+\", (lo, hi))[\"start\"]\n        stop = annual.text.find(\"Item \"+str(item+1)+\".\", start, hi) if item < 14 else hi\n        obligations.append(dict(id=f\"annual.partIII.item{item}\", target=\"2025 proxy, accession 0001308179-25-000008\",\n                                incorporation=annual.anchor(start, stop), support=proxy.find(pat, flags=re.S),\n                                status=\"target_acquired_selected_passage_inspected\",\n                                unresolved=\"Complete item-level semantics, exceptions and references beyond the selected passage remain unmodelled.\",\n                                consequence=\"Proxy information cannot be backdated to the annual filing.\",\n                                next_route=\"Inspect remaining sections in the retained proxy and its exact incorporated targets.\"))\n    title = reg.find(r\"Exhibit 4\\.1\\nApple Inc\\..*?Dated as of October\\s+28, 2021\", flags=re.S)\n    terms = reg.find(r\"Section\\s+301\\.\\nAmount\\nUnlimited; Issuable in Series.*?Section\\s+302\\.\", flags=re.S)\n    # Select the substantive Section 501 in Exhibit 4.1.  The same phrase\n    # occurs in a prospectus summary and in the table of contents; the section\n    # heading and Section 502 terminator bind the operative text.\n    defaults = reg.find(r\"Section\\s+501\\.\\nEvents of\\nDefault\\n\\..*?(?=Section\\s+502\\.\\nAcceleration of Maturity; Rescission and Annulment\\n\\.)\",\n                        (title[\"end\"], len(reg.text)), flags=re.S)\n    for e in exhibits:\n        if e[\"id\"] == \"annual.exhibit.4.26\":\n            e.update(contents_status=\"acquired_in_registration_2021; selected_sections_inspected\", acquired_support=title,\n                     section_301=terms, section_501=defaults,\n                     missing_terms=\"Series-specific officer certificates, outstanding balances, amendments and swap confirmations/allocation.\")\n    # Keep the exhibit-index row separate from the substantive Exhibit 4.1\n    # contents retained after the annual-report signatures.\n    securities_index = annual.find(r\"(?m)^[ \\t]*4\\.1[^\\n]*Description of Securities of the Registrant\\.\")\n    securities = annual.find(r\"Exhibit 4\\.1\\s+DESCRIPTION OF THE REGISTRANT’S SECURITIES.*?(?=Exhibit 10\\.1)\", flags=re.S)\n    obligations.append(dict(id=\"annual.exhibit.4.1.in_pdf\", target=\"Description of Securities, filed exhibit 4.1\",\n                            support=securities, index_support=securities_index, status=\"heading_and_contents_retained_in_pdf\",\n                            unresolved=\"Description is not the complete incorporated indentures and series certificates.\",\n                            consequence=\"General descriptions do not identify all current debt terms.\",\n                            next_route=\"Inspect specific 4.2–4.28 index targets for contract reconstruction.\"))\n    omissions = annual.find(r\"Certain instruments defining the rights of holders.*?copies of any such instruments\\.\", annual.page(56), re.S)\n    obligations.append(dict(id=\"omitted_debt_instruments\", target=\"Instruments omitted under Item 601(b)(4)(iii)\", support=omissions,\n                            status=\"expressly_omitted_from_filing\", unresolved=\"Instrument identities and complete terms not specified by this index.\",\n                            consequence=\"No complete debt-contract inventory is established.\",\n                            next_route=\"Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach.\"))\n    return dict(partIII_and_package_obligations=obligations, exhibit_inventory=exhibits,\n                agreement_interpretation=dict(status=\"selected_contract_sections_only\", support=[title, terms, defaults],\n                    interpretation=\"Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.\",\n                    missing=\"2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule.\"))\n\n\n","exit_code":0,"status":"completed"}}
