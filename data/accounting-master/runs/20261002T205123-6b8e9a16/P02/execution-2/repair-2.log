{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,101p' scripts/apple_case_v1.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Bounded, source-bound Apple case. No acquisition or forecasting at build time.\n\nMappings below are annotations; numbers are read from pinned source bytes.\nAll amounts used by the arithmetic engine are exact rational USD amounts.\nRevalidation rebuilds from sources, so editing an observation's metadata cannot\nchange its source meaning. This is a case adapter, not a general XBRL processor.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom datetime import date, datetime, timedelta, timezone\nfrom fractions import Fraction\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\n\nfrom bs4 import BeautifulSoup\n\nROOT = Path(__file__).resolve().parents[1]\nAPPLE = \"docs/design/cases/apple/\"\nNEW = APPLE + \"p02-v1/\"\nREGISTER = \"data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json\"\nINDEX = \"data/financial-report-benchmark/landing/apple/21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42.json\"\nPLAN_HASH = \"916a4c80553bebee3ca0b6399ba8d4e54a6f5d3bd2975cda75815b95e8f45f59\"\nRECOVERY_PLAN_HASH = \"569a45ba5ce7d75d1e71ba5fc5a870de38f5dedcc7b6d81aa74b4f135f815bcd\"\nPINS = {\n    APPLE + \"annual-2024.pdf\": \"ec74758cd767465362c641cf2fd5d8fedd477aed2bf7f62117e67610435dcb88\",\n    APPLE + \"annual-2024.txt\": \"caaf182340d3846ff54cf967a2d3da7dce82505170665943ea7227e6bed8336e\",\n    APPLE + \"interim-2025q1.html\": \"2f7629f0733f75b3155dd52f7ae6a8724468e3cde1a9ce32fbce96d98f1ec27e\",\n    APPLE + \"interim-2025q1.txt\": \"ab8e06fc35957f43a355d0d1d11d57d203b494a4008edb39cff162e984ef633b\",\n    APPLE + \"manifest.json\": \"f25b63803d8a7e136befa10d68b935f521aa42ffc95663b6c26d792b0e4e5fc7\",\n    INDEX: \"21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42\",\n}\nMILLION = 10**6\nENTITY = \"0000320193\"\nPRODUCTS = [\"iPhone\", \"Mac\", \"iPad\", \"Wearables, Home and Accessories\", \"Services\"]\nSEGMENTS = [\"Americas\", \"Europe\", \"Greater China\", \"Japan\", \"Rest of Asia Pacific\"]\nPRODUCT_MEMBERS = [\"aapl:IPhoneMember\", \"aapl:MacMember\", \"aapl:IPadMember\",\n                   \"aapl:WearablesHomeandAccessoriesMember\", \"us-gaap:ServiceMember\"]\nSEGMENT_MEMBERS = [\"aapl:AmericasSegmentMember\", \"aapl:EuropeSegmentMember\",\n                   \"aapl:GreaterChinaSegmentMember\", \"aapl:JapanSegmentMember\",\n                   \"aapl:RestOfAsiaPacificSegmentMember\"]\nREV = \"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"\nCF_BAL = \"us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents\"\n\n\nclass CaseError(ValueError):\n    \"\"\"A source or interpretation fails the supported case contract.\"\"\"\n\n\ndef require(condition, message):\n    if not condition:\n        raise CaseError(message)\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef file_hash(path):\n    return sha((ROOT / path).read_bytes())\n\n\ndef power10(n):\n    return Fraction(10)**n\n\n\ndef number(literal):\n    s = re.sub(r\"[\\s$]\", \"\", literal)\n    if s in (\"—\", \"–\"):\n        return Fraction(0)\n    require(bool(re.fullmatch(r\"(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\", s)) or\n            bool(re.fullmatch(r\"\\((?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\\)\", s)), \"unsupported numeric literal: \" + literal)\n    s = s.replace(\",\", \"\")\n    return -Fraction(s[1:-1]) if s.startswith(\"(\") else Fraction(s)\n\n\ndef interval(value, quantum):\n    v, q = Fraction(value), Fraction(quantum)\n    require(q > 0, \"precision must be positive\")\n    return [str(v-q/2), str(v+q/2)]\n\n\ndef interval_sum(observations, coefficients=None):\n    coefs = coefficients or [1]*len(observations)\n    require(len(coefs) == len(observations), \"coefficient count\")\n    lo = hi = Fraction(0)\n    for obs, c in zip(observations, coefs):\n        a, b = map(Fraction, obs[\"rounding_interval_usd\"])\n        lo += min(c*a, c*b)\n        hi += max(c*a, c*b)\n    return lo, hi\n\n\ndef compatible(left, right):\n    return max(Fraction(left[0]), Fraction(right[0])) <= min(Fraction(left[1]), Fraction(right[1]))\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport json\nfrom pathlib import Path\nc=json.loads(Path('data/accounting-master/deliverables/P02/case.json').read_text())\nprint('acceptance',c['acceptance'])\nprint('sources',[(x['id'],x['original_path']) for x in c['source_bindings']])\nprint('notes',[(n['id'],n['title'],len(n['linked_quantities']),bool(n['unresolved_meaning'])) for n in c['notes']])\nprint('bridges',[(b['id'],b['conclusion']) for b in c['reconciliations']])\nprint('availability',[(r['id'],r['filing_date'],r['retained_byte_publication_date']) for r in c['filing_availability']])\na=json.loads(Path('docs/design/cases/apple/p02-v1/acquisition.json').read_text())\nprint('acquisition_keys',list(a))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
