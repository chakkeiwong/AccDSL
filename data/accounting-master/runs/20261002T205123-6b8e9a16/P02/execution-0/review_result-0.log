{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '438,535p' scripts/apple_case_v1.py; sed -n '835,869p' scripts/apple_case_v1.py\"","aggregated_output":"def collect_observations(annual, interim):\n    observations, bridges = [], []\n    def put(o):\n        require(o[\"id\"] not in {x[\"id\"] for x in observations}, \"duplicate observation id\")\n        observations.append(o)\n        return o\n    def bridge(name, kind, operands, target, **kw):\n        bridges.append(reconcile(name, kind, operands, target, **kw))\n    def scope(page, start=None, end=None):\n        lo, hi = annual.page(page)\n        if start:\n            lo = annual.find(re.escape(start), (lo, hi))[\"start\"]\n        if end:\n            stop = annual.text.find(end, lo, hi)\n            require(stop >= 0, \"scope terminator missing\")\n            hi = stop\n        return lo, hi\n    def arow(label, col, ctx, concept, measure, bounds, cols, oid, partition=None):\n        # Include the table's actual date headings and declared presentation scale.\n        yr = annual.find(r\"^[ \\t]*2024[ \\t]+2023(?:[ \\t]+2022)?[ \\t]*$\", bounds, re.M)\n        header = annual.anchor(bounds[0], yr[\"end\"])\n        return put(annual_row(annual, label, col, ctx, concept, measure, bounds, cols, header, oid, partition))\n    a_bs = {}\n    for col, day in enumerate([\"2024-09-28\", \"2023-09-30\"]):\n        ctx = context(dict(instant=day))\n        rows = {}\n        for key, label, concept in [\n            (\"assets\", \"Total assets\", \"us-gaap:Assets\"),\n            (\"liabilities\", \"Total liabilities\", \"us-gaap:Liabilities\"),\n            (\"equity\", \"Total shareholders’ equity\", \"us-gaap:StockholdersEquity\"),\n            (\"cash\", \"Cash and cash equivalents\", \"us-gaap:CashAndCashEquivalentsAtCarryingValue\"),\n            (\"ppe\", \"Property, plant and equipment, net\", \"us-gaap:PropertyPlantAndEquipmentNet\")]:\n            measure = \"cash_excluding_restricted\" if key == \"cash\" else \"carrying_amount\"\n            rows[key] = arow(label, col, ctx, concept, measure, scope(31), 2, f\"annual.bs.{day}.{key}\")\n        for key, start, end, concept in [\n            (\"debt_current\", \"Current liabilities:\", \"Non-current liabilities:\", \"us-gaap:LongTermDebtCurrent\"),\n            (\"debt_noncurrent\", \"Non-current liabilities:\", \"Commitments and contingencies\", \"us-gaap:LongTermDebtNoncurrent\")]:\n            bounds = scope(31, start, end)\n            header = annual.anchor(annual.page(31)[0], annual.page(31)[0]+450)\n            rows[key] = put(annual_row(annual, \"Term debt\", col, ctx, concept, \"carrying_amount\", bounds, 2,\n                                      header, f\"annual.bs.{day}.{key}\"))\n        bridge(f\"annual.balance.{day}\", \"balance\", [rows[\"liabilities\"], rows[\"equity\"]], rows[\"assets\"])\n        a_bs[day] = rows\n        debt_bounds = scope(43, \"Term Debt\", \"To manage interest rate risk\")\n        d = {}\n        for key, label, measurement in [\n            (\"principal\", \"Total term debt principal\", \"principal\"),\n            (\"discount\", \"Unamortized premium/(discount) and issuance costs, net\", \"carrying_adjustment\"),\n            (\"hedge\", \"Hedge accounting fair value adjustments\", \"carrying_adjustment\"),\n            (\"carrying\", \"Total term debt\", \"carrying_amount\")]:\n            d[key] = arow(label, col, ctx, \"apple:Debt\"+key.title(), measurement, debt_bounds, 2,\n                          f\"annual.debt.{day}.{key}\")\n        bridge(f\"annual.principal_to_carrying.{day}\", \"principal_to_carrying\", [d[k] for k in [\"principal\", \"discount\", \"hedge\"]], d[\"carrying\"])\n        bridge(f\"annual.debt_components.{day}\", \"debt_components\", [rows[\"debt_current\"], rows[\"debt_noncurrent\"]], d[\"carrying\"])\n        p = {}\n        for key, label, measure in [(\"gross\", \"Gross property, plant and equipment\", \"gross_cost\"),\n                                    (\"depreciation\", \"Accumulated depreciation\", \"accumulated_depreciation\"),\n                                    (\"net\", \"Total property, plant and equipment, net\", \"carrying_amount\")]:\n            p[key] = arow(label, col, ctx, \"apple:PPE\"+key.title(), measure,\n                          scope(39, \"Note 5\", \"Note 6\"), 2, f\"annual.ppe.{day}.{key}\")\n        bridge(f\"annual.ppe.{day}\", \"ppe\", [p[\"gross\"], p[\"depreciation\"]], p[\"net\"])\n        bridge(f\"annual.ppe_statement.{day}\", \"equality\", [p[\"net\"]], rows[\"ppe\"])\n    # Years and week lengths are read from the actual Note 1 calendar paragraph.\n    calendar = annual.find(r\"The Company’s fiscal year is the 52- or 53-week period.*?associated quarters, months and periods of those fiscal years\\.\",\n                           scope(34), re.S)\n    m = re.search(r\"years (\\d{4}) and (\\d{4}) spanned (\\d+) weeks each, whereas fiscal year (\\d{4}) spanned (\\d+) weeks\", calendar[\"quote\"])\n    require(m is not None, \"fiscal week lengths missing\")\n    weeks = {m[1]: int(m[3]), m[2]: int(m[3]), m[4]: int(m[5])}\n    # The dates are bound to the split-line date header on printed page 33.\n    for col, day in enumerate([\"2024-09-28\", \"2023-09-30\", \"2022-09-24\"]):\n        end = date.fromisoformat(day)\n        require(end.strftime(\"%B\")+\" \"+str(end.day)+\",\" in annual.text[slice(*annual.page(33))], \"annual end header missing\")\n        start = end+timedelta(days=1-weeks[str(end.year)]*7)\n        per = dict(start=start.isoformat(), end=day)\n        ctx = context(per)\n        rev = arow(\"Total net sales\", col, ctx, REV, \"net_revenue\", scope(29), 3, f\"annual.revenue.{end.year}\")\n        for partition, members in [(\"product\", PRODUCTS), (\"segment\", SEGMENTS)]:\n            parts = []\n            for i, member in enumerate(members):\n                dims = {\"srt:ProductOrServiceAxis\": PRODUCT_MEMBERS[i]} if partition == \"product\" else {\"us-gaap:StatementBusinessSegmentsAxis\": SEGMENT_MEMBERS[i]}\n                bounds = scope(35) if partition == \"product\" else scope(47, member+\":\", \"Operating income\")\n                label = \"Services (1)\" if member == \"Services\" else member\n                if partition == \"segment\":\n                    o = put(annual_row(annual, \"Net sales\", col, context(per, dims), REV, \"net_revenue\", bounds, 3,\n                                      annual.anchor(annual.page(47)[0], scope(47, \"Americas:\")[0]), f\"annual.{partition}.{end.year}.{i}\", partition))\n                else:\n                    o = arow(label, col, context(per, dims), REV, \"net_revenue\", bounds, 3,\n                              f\"annual.{partition}.{end.year}.{i}\", partition)\n                o[\"member_label\"] = member\n                parts.append(o)\n            bridge(f\"annual.revenue_{partition}.{end.year}\", \"partition\", parts, rev, partition=partition)\n        flows = []\n        opening = arow(\"Cash, cash equivalents, and restricted cash and cash equivalents, beginning balances\", col,\n                       context(dict(instant=(start-timedelta(days=1)).isoformat())), CF_BAL, \"cash_including_restricted\",\n                       scope(33), 3, f\"annual.cf.{end.year}.opening\")\n        for key, label in [(\"operating\", \"Cash generated by operating activities\"),\n                            (\"investing\", \"Cash generated by/(used in) investing activities\"),\n                            (\"financing\", \"Cash used in financing activities\")]:\ndef filing_records():\n    raw = json.loads((ROOT/INDEX).read_text())[\"filings\"][\"recent\"]\n    out = []\n    for identity, accession in [(\"annual\", \"0000320193-24-000123\"),\n                                (\"interim\", \"0000320193-25-000008\"),\n                                (\"proxy\", \"0001308179-25-000008\")]:\n        require(raw[\"accessionNumber\"].count(accession) == 1, \"filing identity missing/ambiguous\")\n        i = raw[\"accessionNumber\"].index(accession)\n        out.append(dict(id=identity, accession=accession, form=raw[\"form\"][i], report_date=raw[\"reportDate\"][i],\n                        filing_date=raw[\"filingDate\"][i], acceptance_timestamp=raw[\"acceptanceDateTime\"][i],\n                        primary_document=raw[\"primaryDocument\"][i], index_path=INDEX, index_sha256=file_hash(INDEX),\n                        json_pointer=f\"/filings/recent/accessionNumber/{i}\",\n                        public_dissemination_timestamp=None, retained_byte_publication_date=None,\n                        qualification=\"Acceptance is index metadata, not independently verified public dissemination or retained-byte vintage.\"))\n    return out\n\n\ndef availability(record, cutoff, scope=\"filing_identity\"):\n    \"\"\"Date-resolution query; unknown byte vintage never inherits a filing date.\"\"\"\n    cutoff = date.fromisoformat(cutoff)\n    require(scope in (\"filing_identity\", \"retained_bytes\"), \"unsupported availability scope\")\n    day = record.get(\"filing_date\" if scope == \"filing_identity\" else \"retained_byte_publication_date\")\n    return \"unknown\" if day is None else (\"available_by_filing_day\" if date.fromisoformat(day) <= cutoff else \"later\")\n\n\ndef version_view(records, cutoff, scope=\"retained_bytes\"):\n    require(len({r[\"id\"] for r in records}) == len(records), \"duplicate version identity\")\n    decisions = [{\"id\": r[\"id\"], \"availability\": availability(r, cutoff, scope)} for r in records]\n    eligible = [d[\"id\"] for d in decisions if d[\"availability\"] == \"available_by_filing_day\"]\n    return dict(versions=decisions, eligible=eligible,\n                resolution=\"retain_all_no_automatic_supersession\", conflict_resolution=\"unsupported\")\n\n\ndef exhibit_records(annual, official, interim):\n    \"\"\"Read exhibit target/version columns; distinguish a link from its contents.\"\"\"\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '291,375p' tests/test_accounting_p02.py; sed -n '868,923p' scripts/apple_case_v1.py\"","aggregated_output":"    def test_context_and_measurement_rejection_reasons(self):\n        assets = self.by_id[\"annual.bs.2024-09-28.assets\"]\n        liabilities = self.by_id[\"annual.bs.2024-09-28.liabilities\"]\n        equity = self.by_id[\"annual.bs.2024-09-28.equity\"]\n        for key, value in [(\"entity\", \"0000000001\"), (\"currency\", \"EUR\"),\n                           (\"period\", {\"instant\": \"2024-09-27\"}), (\"perimeter\", \"standalone\")]:\n            mutated = copy.deepcopy(equity)\n            mutated[\"context\"][key] = value\n            with self.subTest(key=key), self.assertRaisesRegex(case.CaseError, \"entity/currency/perimeter/basis/period/dimensions mismatch\"):\n                case.reconcile(\"bad\", \"balance\", [liabilities, mutated], assets)\n        parts = [self.by_id[f\"annual.product.2024.{i}\"] for i in range(5)]\n        geography = [self.by_id[f\"annual.segment.2024.{i}\"] for i in range(5)]\n        with self.assertRaisesRegex(case.CaseError, \"overlapping or wrong partitions\"):\n            case.reconcile(\"bad\", \"partition\", parts + geography, self.by_id[\"annual.revenue.2024\"], partition=\"product\")\n        operands = [self.by_id[f\"interim.bs.2024-12-28.debt_{s}\"] for s in [\"current\", \"noncurrent\"]]\n        for oid in [\"interim.debt.2024-12-28.fair_value\", \"interim.notional.2024-12-28\"]:\n            # Equalize dimensional context to isolate measurement rejection;\n            # original dimensional mismatch is independently rejected above.\n            target = copy.deepcopy(self.by_id[oid])\n            target[\"context\"] = copy.deepcopy(operands[0][\"context\"])\n            with self.assertRaisesRegex(case.CaseError, \"measurement substitution\"):\n                case.reconcile(\"bad\", \"rounded_debt\", operands, target)\n        opening = copy.deepcopy(self.by_id[\"annual.cf.2024.opening\"])\n        opening[\"context\"][\"period\"][\"instant\"] = \"2023-09-29\"\n        flows = [self.by_id[f\"annual.cf.2024.{k}\"] for k in [\"operating\", \"investing\", \"financing\"]]\n        with self.assertRaisesRegex(case.CaseError, \"stock/flow date mismatch\"):\n            case.reconcile(\"bad\", \"cash_flow\", [opening] + flows, self.by_id[\"annual.cf.2024.closing\"])\n\n    def test_exact_rounding_endpoints_with_valid_synthetic_sources(self):\n        # This is a numerical unit fixture, explicitly separate from Apple\n        # source validation. All fixture literals and anchors are consistent.\n        with tempfile.TemporaryDirectory(prefix=\"p02-rounding-\") as directory:\n            root = Path(directory)\n            (root / \"numbers.txt\").write_text(\"1\\n2\\n1.5\\n\")\n            with patch.object(case, \"ROOT\", root):\n                doc = case.Document(\"synthetic\", \"numbers.txt\", \"numbers.txt\")\n                ctx = case.context({\"instant\": \"2024-12-28\"})\n                def obs(oid, n, concept):\n                    start, end = {Fraction(1): (0, 1), Fraction(2): (2, 3), Fraction(3, 2): (4, 7)}[n]\n                    anchor = doc.anchor(start, end)\n                    return case.observation(oid, concept, n * 1000000, anchor[\"quote\"], 6, 1000000,\n                        ctx, \"carrying_amount\", [{\"cell\": anchor}])\n                current = obs(\"current\", 1, \"us-gaap:LongTermDebtCurrent\")\n                noncurrent = obs(\"noncurrent\", 2, \"us-gaap:LongTermDebtNoncurrent\")\n                target = obs(\"target\", 2, \"us-gaap:LongTermDebt\")\n                self.assertEqual(case.validate_anchors([current, noncurrent, target]), 3)\n                self.assertTrue(case.reconcile(\"compatible\", \"rounded_debt\", [current, noncurrent], target)[\"rounding_compatible\"])\n                endpoint = obs(\"endpoint\", Fraction(3, 2), \"us-gaap:LongTermDebt\")\n                bridge = case.reconcile(\"endpoint\", \"rounded_debt\", [current, noncurrent], endpoint)\n                self.assertEqual(bridge[\"lhs_interval_usd\"][0], bridge[\"rhs_interval_usd\"][1])\n                self.assertTrue(bridge[\"rounding_compatible\"])\n                target = obs(\"target\", 1, \"us-gaap:LongTermDebt\")\n                case.validate_value(target)\n                case.validate_anchors(target)\n                with self.assertRaisesRegex(case.CaseError, \"incompatible rounding intervals\"):\n                    case.reconcile(\"incompatible\", \"rounded_debt\", [current, noncurrent], target)\n        self.assertEqual(case.interval(Fraction(948, 10), Fraction(1, 10)), [\"379/4\", \"1897/20\"])\n        self.assertTrue(case.compatible([0, Fraction(1, 2)], [Fraction(1, 2), 1]))\n        self.assertFalse(case.compatible([0, Fraction(1, 2)], [Fraction(1, 2) + Fraction(1, 10**12), 1]))\n        self.assertEqual(case.interval_sum([{\"rounding_interval_usd\": [\"1\", \"2\"]}], [-1]), (-2, -1))\n\n    def test_publication_cutoffs_conflicts_and_metadata_tampering(self):\n        records = self.case_data[\"filing_availability\"]\n        view = case.version_view(records, \"2024-11-01\", scope=\"filing_identity\")\n        self.assertEqual(view[\"eligible\"], [\"annual\"])\n        self.assertEqual(next(r[\"availability\"] for r in view[\"versions\"] if r[\"id\"] == \"proxy\"), \"later\")\n        self.assertEqual(case.version_view(records, \"2099-12-31\")[\"eligible\"], [])\n        versions = [{\"id\": \"v1\", \"filing_date\": \"2024-11-01\", \"retained_byte_publication_date\": \"2024-11-01\", \"value\": 1},\n                    {\"id\": \"v2\", \"filing_date\": \"2024-11-02\", \"retained_byte_publication_date\": \"2024-11-02\", \"value\": 2}]\n        before = copy.deepcopy(versions)\n        result = case.version_view(versions, \"2024-11-03\")\n        self.assertEqual(result[\"eligible\"], [\"v1\", \"v2\"])\n        self.assertEqual(result[\"resolution\"], \"retain_all_no_automatic_supersession\")\n        self.assertEqual(versions, before)\n        for mutation in [\"filing\", \"column\", \"entity\"]:\n            candidate = copy.deepcopy(self.case_data)\n            if mutation == \"filing\":\n                candidate[\"filing_availability\"][2][\"filing_date\"] = \"2024-10-01\"\n            elif mutation == \"column\":\n                candidate[\"observations\"][0][\"source_readings\"][0][\"column_index\"] = 1\n            else:\n                candidate[\"observations\"][0][\"context\"][\"entity\"] = \"0000000001\"\n            with self.subTest(mutation=mutation), self.assertRaisesRegex(case.CaseError, \"case differs from source-derived rebuild\"):\n                case.validate_case(candidate)\n\ndef exhibit_records(annual, official, interim):\n    \"\"\"Read exhibit target/version columns; distinguish a link from its contents.\"\"\"\n    result = []\n    for doc, prefix in [(official, \"annual\"), (interim, \"interim\")]:\n        soup = BeautifulSoup((ROOT/doc.original).read_text(), \"html.parser\")\n        for tr in soup.find_all(\"tr\"):\n            cells = [c.get_text(\" \", strip=True) for c in tr.find_all(\"td\", recursive=False)]\n            cells = [c for c in cells if c]\n            if len(cells) < 2 or not re.fullmatch(r\"(?:\\d+\\.\\d+|101|104)[*, ]*\", cells[0]):\n                continue\n            # Exclude financial rows and identify only the exhibit-index description cells.\n            if not tr.find(\"a\", href=True) and \"**\" not in cells[0]:\n                continue\n            number = re.match(r\"\\d+(?:\\.\\d+)?\", cells[0])[0]\n            row_text = tr.get_text(\"\\n\", strip=True)\n            anchor = doc.find(re.escape(row_text))\n            links = [a[\"href\"] for a in tr.find_all(\"a\", href=True)]\n            internal = [u for u in links if u.startswith(\"#\")]\n            external = [u for u in links if u.startswith(\"http\")]\n            record = dict(id=f\"{prefix}.exhibit.{number}\", number=number, description=cells[1],\n                          filed_marker=cells[0], source=anchor, target_links=links,\n                          referenced_form=cells[2] if len(cells) >= 5 else None,\n                          referenced_exhibit=cells[3] if len(cells) >= 5 else None,\n                          referenced_date_or_period=cells[4] if len(cells) >= 5 else None,\n                          contents_status=\"unresolved\", missing_terms=\"Full substantive interpretation and applicability to current contracts.\",\n                          consequence=\"No complete incorporated-package or contract-history claim.\",\n                          next_route=\"Use the exact SEC accession in the link or the issuer filing feed for the stated form and date.\")\n            if internal:\n                missing_internal = [u for u in internal\n                                    if soup.find(id=u[1:]) is None and\n                                    soup.find(attrs={\"name\": u[1:]}) is None]\n                if missing_internal:\n                    # A malformed or stale anchor is itself evidence about\n                    # package closure.  Preserve it as an unresolved filing\n                    # obligation instead of silently treating the link as\n                    # resolved or aborting the whole bounded case build.\n                    record[\"contents_status\"] = \"internal_target_missing_in_retained_html\"\n                    record[\"missing_internal_targets\"] = missing_internal\n                    record[\"missing_terms\"] = \"Retained issuer HTML exposes an internal link whose target is absent; substantive exhibit contents remain unverified.\"\n                else:\n                    record[\"contents_status\"] = \"within_retained_issuer_html; semantics_unresolved\"\n            if external:\n                record[\"contents_status\"] = \"external_target_not_acquired\"\n            if number in (\"101\", \"104\"):\n                record[\"contents_status\"] = \"inline_facts_present; complete_taxonomy_package_not_acquired\"\n                record[\"missing_terms\"] = \"Separate taxonomy/linkbase files and complete package validation.\"\n            if prefix == \"annual\":\n                # Bind each issuer index row independently to the mirrored PDF index.\n                lo, hi = annual.page(53)[0], annual.page(56)[1]\n                record[\"pdf_index_row\"] = annual.find(r\"^[ \\t]*\"+re.escape(number)+r\"(?=[* \\t])[^\\n]+\", (lo, hi), re.M)\n            result.append(record)\n    require(len({r[\"id\"] for r in result}) == len(result), \"duplicate exhibit rows\")\n    return result\n\n\ndef external_records(annual, interim, docs):\n","exit_code":0,"status":"completed"}}
