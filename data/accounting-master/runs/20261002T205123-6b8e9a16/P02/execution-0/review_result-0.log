{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '535,644p' scripts/apple_case_v1.py\"","aggregated_output":"                            (\"financing\", \"Cash used in financing activities\")]:\n            flows.append(arow(label, col, ctx, \"us-gaap:NetCashProvidedByUsedIn\"+key.title()+\"Activities\", \"cash_flow\",\n                              scope(33), 3, f\"annual.cf.{end.year}.{key}\"))\n        closing = arow(\"Cash, cash equivalents, and restricted cash and cash equivalents, ending balances\", col,\n                       context(dict(instant=day)), CF_BAL, \"cash_including_restricted\", scope(33), 3,\n                       f\"annual.cf.{end.year}.closing\")\n        bridge(f\"annual.cash_flow.{end.year}\", \"cash_flow\", [opening]+flows, closing)\n    # The annual notional is retained as notional, never recast as debt exposure.\n    bounds = scope(38, \"The notional amounts\", \"The carrying amounts\")\n    notional = arow(\"Interest rate contracts\", 0, context(dict(instant=\"2024-09-28\"), {\n        \"us-gaap:DerivativeInstrumentRiskAxis\": \"us-gaap:InterestRateContractMember\",\n        \"us-gaap:HedgingDesignationAxis\": \"us-gaap:DesignatedAsHedgingInstrumentMember\"}),\n        \"us-gaap:DerivativeNotionalAmount\", \"derivative_notional\", bounds, 2, \"annual.notional.2024\")\n    reader = InlineReader(interim)\n    def iread(concept, ctx, measurement, oid, **kw):\n        return put(reader.select(concept, ctx, measurement, oid, **kw))\n    for day in [\"2024-12-28\", \"2024-09-28\"]:\n        ctx = context(dict(instant=day))\n        rows = {}\n        for key, concept, label in [\n            (\"assets\", \"us-gaap:Assets\", \"Total assets\"),\n            (\"liabilities\", \"us-gaap:Liabilities\", \"Total liabilities\"),\n            (\"equity\", \"us-gaap:StockholdersEquity\", \"Total shareholders’ equity\"),\n            (\"debt_current\", \"us-gaap:LongTermDebtCurrent\", \"Term debt\"),\n            (\"debt_noncurrent\", \"us-gaap:LongTermDebtNoncurrent\", \"Term debt\")]:\n            rows[key] = iread(concept, ctx, \"carrying_amount\", f\"interim.bs.{day}.{key}\", label=label)\n        bridge(f\"interim.balance.{day}\", \"balance\", [rows[\"liabilities\"], rows[\"equity\"]], rows[\"assets\"])\n        rounded = iread(\"us-gaap:LongTermDebt\", ctx, \"carrying_amount\", f\"interim.debt.{day}.rounded\", scale=9, decimals=-8)\n        bridge(f\"interim.rounded_debt.{day}\", \"rounded_debt\", [rows[\"debt_current\"], rows[\"debt_noncurrent\"]], rounded)\n        iread(\"us-gaap:LongTermDebtFairValue\", context(dict(instant=day), {\"us-gaap:FairValueByFairValueHierarchyLevelAxis\": \"us-gaap:FairValueInputsLevel2Member\"}),\n              \"fair_value\", f\"interim.debt.{day}.fair_value\", scale=9, decimals=-8)\n        iread(\"us-gaap:DerivativeNotionalAmount\", context(dict(instant=day), notional[\"context\"][\"dimensions\"]),\n              \"derivative_notional\", f\"interim.notional.{day}\", label=\"Interest rate contracts\")\n        if day in a_bs:\n            for key in rows:\n                bridge(f\"annual_interim_comparative.{key}\", \"equality\", [rows[key]], a_bs[day][key])\n    for start, end in [(\"2024-09-29\", \"2024-12-28\"), (\"2023-10-01\", \"2023-12-30\")]:\n        ctx = context(dict(start=start, end=end))\n        rev = iread(REV, ctx, \"net_revenue\", \"interim.revenue.\"+end, label=\"Total net sales\")\n        for partition, members, dimnames, axis in [\n            (\"product\", PRODUCTS, PRODUCT_MEMBERS, \"srt:ProductOrServiceAxis\"),\n            (\"segment\", SEGMENTS, SEGMENT_MEMBERS, \"us-gaap:StatementBusinessSegmentsAxis\")]:\n            parts = []\n            for i, (member, dim) in enumerate(zip(members, dimnames)):\n                o = iread(REV, context(ctx[\"period\"], {axis: dim}), \"net_revenue\", f\"interim.{partition}.{end}.{i}\",\n                          partition=partition, label=member if partition == \"product\" else \"Net sales\")\n                o[\"member_label\"] = member\n                parts.append(o)\n            bridge(f\"interim.revenue_{partition}.{end}\", \"partition\", parts, rev, partition=partition)\n        opening = iread(CF_BAL, context(dict(instant=(date.fromisoformat(start)-timedelta(days=1)).isoformat())),\n                        \"cash_including_restricted\", \"interim.cf.\"+end+\".opening\", label=\"beginning balances\")\n        flows = [iread(\"us-gaap:NetCashProvidedByUsedIn\"+kind+\"Activities\", ctx, \"cash_flow\", f\"interim.cf.{end}.{kind.lower()}\")\n                 for kind in [\"Operating\", \"Investing\", \"Financing\"]]\n        closing = iread(CF_BAL, context(dict(instant=end)), \"cash_including_restricted\", \"interim.cf.\"+end+\".closing\", label=\"ending balances\")\n        bridge(\"interim.cash_flow.\"+end, \"cash_flow\", [opening]+flows, closing)\n    return observations, bridges, calendar\n\n\n# Interpretation annotations, not extracted values or executable accounting rules.\nNOTE_MEANING = {\n    \"Summary of Significant Accounting Policies\": (\n        [\"consolidation\", \"calendar\", \"measurement policies\"],\n        \"Use the disclosed fiscal calendar and consolidated perimeter; annual policies and interim preparation qualifications remain distinct.\",\n        \"Legal-entity control histories, estimate changes and full policy-to-posting rules are not reconstructed.\"),\n    \"Revenue\": ([\"revenue\", \"deferred revenue\", \"returns\"],\n        \"Keep the disclosed product/service partition separate from geographic segment revenue.\",\n        \"Contract performance, return estimates, transaction-price allocation and deferred-revenue movements remain unidentified.\"),\n    \"Earnings Per Share\": ([\"earnings\", \"share denominators\", \"dilution\"],\n        \"Retain the EPS numerator and dated weighted-average basic/diluted share table as unresolved typed meaning.\",\n        \"Share counts are in thousands and EPS is per share; this USD-only extractor does not implement dilution or per-share division.\"),\n    \"Financial Instruments\": ([\"investments\", \"derivatives\", \"hedging\", \"OCI\"],\n        \"Retain interest-rate derivative notional separately from debt carrying amount and rate exposure.\",\n        \"Notional does not identify hedge allocation, reset dates, currency sensitivities or future OCI recycling.\"),\n    \"Property, Plant and Equipment\": ([\"fixed assets\", \"depreciation\"],\n        \"Reconcile gross cost plus signed accumulated depreciation to net carrying amount and the balance sheet.\",\n        \"Acquisition cohorts, disposals, asset lives and future depreciation are not identified by the gross/net bridge.\"),\n    \"Consolidated Financial Statement Details\": ([\"deferred taxes\", \"other assets\", \"other liabilities\"],\n        \"Retain component schedules with explicit unresolved movement and recognition meaning.\",\n        \"Components of other assets and liabilities are not converted to a unique transaction history or posting rules.\"),\n    \"Condensed Consolidated Financial Statement Details\": ([\"inventories\", \"fixed assets\"],\n        \"Retain inventory components and gross/net PP&E schedules with their interim dates and presentation units.\",\n        \"Inventory purchase/consumption histories and asset cohorts remain unidentified; interim detail schedules are not executed here.\"),\n    \"Income Taxes\": ([\"current taxes\", \"deferred taxes\", \"state aid\"],\n        \"Keep the State Aid Decision and current/deferred tax schedules as dated disclosures.\",\n        \"Jurisdiction-specific settlements, taxable bases and future effective rates cannot be inferred from the totals.\"),\n    \"Leases\": ([\"lease liabilities\", \"right-of-use assets\", \"lease expense\"],\n        \"Retain maturity buckets and fixed/variable payment distinctions without treating commitments as an undiscounted liability.\",\n        \"Individual lease discounting, renewal choices, modifications and variable-payment drivers remain unidentified.\"),\n    \"Debt\": ([\"financing\", \"cash flow\", \"interest\", \"hedging\"],\n        \"Separate principal, carrying adjustments, current/noncurrent carrying value, rounded narrative amounts and fair value.\",\n        \"Cash repayments alone cannot produce a debt roll-forward: FX, noncash and measurement movements and contract allocations are missing.\"),\n    \"Shareholders’ Equity\": ([\"repurchases\", \"equity\", \"dividends\"],\n        \"Repurchase permission is not an obligation to acquire a minimum number of shares.\",\n        \"Future repurchases, dividends and issuance timing remain choices, not deterministic consequences of authorization.\"),\n    \"Share-Based Compensation\": ([\"compensation\", \"equity\", \"tax withholding\"],\n        \"Retain award/vesting disclosures and expense/related tax effects as separate accounting quantities.\",\n        \"Grant-level vesting, forfeiture, performance outcomes and future cash-tax settlement histories remain unresolved.\"),\n    \"Commitments, Contingencies and Supply Concentrations\": ([\"purchase commitments\", \"litigation\", \"supplier concentration\"],\n        \"Preserve conditional litigation language, contractual purchase schedules and qualitative supplier concentration.\",\n        \"No loss probabilities, universal materiality threshold, provision equal to commitments or numerical supplier haircut is inferred.\"),\n    \"Contingencies\": ([\"litigation\", \"accruals\", \"material loss\"],\n        \"Retain management's dated assessment of asserted legal and other claims, including its uncertainty and recorded-accrual qualification.\",\n        \"The assertion supplies neither a zero liability nor a numerical loss probability or quantified materiality threshold.\"),\n    \"Segment Information and Geographic Data\": ([\"segment revenue\", \"segment profit\", \"geography\"],\n        \"Geographic segments form one revenue partition; product/service revenue is another partition of the same consolidated sales.\",\n        \"Cross-classified product-by-geography cells, future regional behavior and full segment-profit cost allocations remain unidentified.\"),\n}\n\n\ndef walk_anchors(value):\n","exit_code":0,"status":"completed"}}
