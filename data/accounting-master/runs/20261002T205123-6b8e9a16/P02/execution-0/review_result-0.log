{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,185p' tests/test_accounting_p02.py\"","aggregated_output":"\"\"\"Deterministic real-input checks for the bounded Apple P02 case.\n\nThe tests deliberately exercise the retained annual PDF/text and interim HTML\nthrough the reusable case adapter.  Expected identities below are stated from\nthe filing rows themselves; they are not copied from a generated case result.\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nfrom bs4 import BeautifulSoup\n\nfrom scripts import apple_case_v1 as case\n\n\nROOT = Path(__file__).resolve().parents[1]\nOUT = ROOT / \"data/accounting-master/deliverables/P02\"\nCASE_PATH = OUT / \"case.json\"\nANNUAL_TEXT = ROOT / \"docs/design/cases/apple/annual-2024.txt\"\nINTERIM_HTML = ROOT / \"docs/design/cases/apple/interim-2025q1.html\"\n\n\nclass AccountingP02Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.case_data = json.loads(CASE_PATH.read_text())\n        cls.by_id = {o[\"id\"]: o for o in cls.case_data[\"observations\"]}\n        cls.annual = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                   case.APPLE + \"annual-2024.txt\", pdf=True)\n        cls.interim = case.Document(\"interim\", case.APPLE + \"interim-2025q1.html\",\n                                    case.APPLE + \"interim-2025q1.txt\")\n        cls.reader = case.InlineReader(cls.interim)\n        cls.official = case.Document(\"annual-2024-official\",\n            case.NEW + \"annual-2024-official.html\", case.NEW + \"annual-2024-official.txt\")\n\n    def reader_with_raw(self, raw):\n        reader = copy.copy(self.reader)\n        reader.raw = raw\n        reader.soup = BeautifulSoup(raw, \"html.parser\")\n        reader.ids = {e[\"id\"]: e for e in reader.soup.find_all(id=True)}\n        reader.facts = reader.soup.find_all(\"ix:nonfraction\")\n        return reader\n\n    def test_fresh_pdf_rows_and_independent_arithmetic(self):\n        fresh = subprocess.run([\"pdftotext\", \"-layout\", str(ROOT / case.APPLE / \"annual-2024.pdf\"), \"-\"],\n                               capture_output=True, check=True, timeout=30).stdout.decode()\n        self.assertEqual(fresh, ANNUAL_TEXT.read_text())\n\n        def page(n):\n            found = [p for p in fresh.split(\"\\f\")\n                     if re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| \" + str(n) + r\"\\s*$\", p)]\n            self.assertEqual(len(found), 1)\n            return found[0]\n\n        def values(text, label, count):\n            rows = re.findall(r\"(?m)^[ \\t]*\" + re.escape(label) + r\"[ \\t]{2,}([^\\n]+)\", text)\n            self.assertEqual(len(rows), 1, label)\n            tokens = re.findall(r\"\\(?\\d[\\d,]*\\)?|—\", rows[0])\n            self.assertEqual(len(tokens), count)\n            return [Fraction(0) if t == \"—\" else\n                    Fraction(t.replace(\",\", \"\").replace(\"(\", \"-\").replace(\")\", \"\")) for t in tokens]\n\n        for col, day in enumerate([\"2024-09-28\", \"2023-09-30\"]):\n            debt = [values(page(43).split(\"To manage interest rate risk\")[0], label, 2)[col] for label in [\n                \"Total term debt principal\", \"Unamortized premium/(discount) and issuance costs, net\",\n                \"Hedge accounting fair value adjustments\", \"Total term debt\"]]\n            self.assertEqual(sum(debt[:3]), debt[3])\n            for key, val in zip([\"principal\", \"discount\", \"hedge\", \"carrying\"], debt):\n                self.assertEqual(val * 1000000, Fraction(self.by_id[f\"annual.debt.{day}.{key}\"][\"value_usd\"]))\n            balance = page(31)\n            current = balance.split(\"Current liabilities:\")[1].split(\"Non-current liabilities:\")[0]\n            noncurrent = balance.split(\"Non-current liabilities:\")[1]\n            self.assertEqual(values(current, \"Term debt\", 2)[col] +\n                             values(noncurrent, \"Term debt\", 2)[col], debt[3])\n            self.assertEqual(values(balance, \"Total liabilities\", 2)[col] +\n                             values(balance, \"Total shareholders’ equity\", 2)[col],\n                             values(balance, \"Total assets\", 2)[col])\n            ppe = [values(page(39), label, 2)[col] for label in [\n                \"Gross property, plant and equipment\", \"Accumulated depreciation\", \"Total property, plant and equipment, net\"]]\n            self.assertEqual(ppe[0] + ppe[1], ppe[2])\n            self.assertEqual(ppe[2], values(balance, \"Property, plant and equipment, net\", 2)[col])\n            for key, val in zip([\"gross\", \"depreciation\", \"net\"], ppe):\n                self.assertEqual(val * 1000000, Fraction(self.by_id[f\"annual.ppe.{day}.{key}\"][\"value_usd\"]))\n        for col, year in enumerate([2024, 2023, 2022]):\n            revenue = values(page(29), \"Total net sales\", 3)[col]\n            products = [values(page(35), label, 3)[col] for label in [\n                \"iPhone\", \"Mac\", \"iPad\", \"Wearables, Home and Accessories\", \"Services (1)\"]]\n            geographic = [values(page(47).split(label + \":\")[1].split(\"Operating income\")[0],\n                                 \"Net sales\", 3)[col] for label in\n                          [\"Americas\", \"Europe\", \"Greater China\", \"Japan\", \"Rest of Asia Pacific\"]]\n            self.assertEqual(sum(products), revenue)\n            self.assertEqual(sum(geographic), revenue)\n            for partition, amounts in [(\"product\", products), (\"segment\", geographic)]:\n                for i, val in enumerate(amounts):\n                    self.assertEqual(val * 1000000, Fraction(self.by_id[f\"annual.{partition}.{year}.{i}\"][\"value_usd\"]))\n            flows = [values(page(33), label, 3)[col] for label in [\n                \"Cash, cash equivalents, and restricted cash and cash equivalents, beginning balances\",\n                \"Cash generated by operating activities\", \"Cash generated by/(used in) investing activities\",\n                \"Cash used in financing activities\",\n                \"Cash, cash equivalents, and restricted cash and cash equivalents, ending balances\"]]\n            self.assertEqual(sum(flows[:4]), flows[4])\n            for key, val in zip([\"opening\", \"operating\", \"investing\", \"financing\", \"closing\"], flows):\n                self.assertEqual(val * 1000000, Fraction(self.by_id[f\"annual.cf.{year}.{key}\"][\"value_usd\"]))\n\n    def test_independent_html_contexts_values_and_bridges(self):\n        # Independently parse all selected interim readings, including repeated\n        # facts. No InlineReader extraction or generated expected totals here.\n        soup = BeautifulSoup(INTERIM_HTML.read_text(), \"html.parser\")\n        for oid, obs in self.by_id.items():\n            if not oid.startswith(\"interim.\"):\n                continue\n            for reading in obs[\"source_readings\"]:\n                fact = soup.find(id=reading[\"fact_id\"])\n                ctx = soup.find(id=fact[\"contextref\"])\n                unit = soup.find(id=fact[\"unitref\"])\n                self.assertEqual(fact[\"name\"], obs[\"concept\"])\n                self.assertEqual(ctx.find(\"xbrli:identifier\").get_text(), obs[\"context\"][\"entity\"])\n                self.assertEqual(unit.find(\"xbrli:measure\").get_text(), \"iso4217:USD\")\n                period = {e.name.split(\":\")[1].replace(\"date\", \"\"): e.get_text()\n                          for e in ctx.find(\"xbrli:period\").find_all(recursive=False)}\n                self.assertEqual(period, obs[\"context\"][\"period\"])\n                dims = {e[\"dimension\"]: e.get_text() for e in ctx.find_all(\"xbrldi:explicitmember\")}\n                self.assertEqual(dims, obs[\"context\"][\"dimensions\"])\n                literal = fact.get_text(strip=True).replace(\",\", \"\")\n                val = Fraction(0 if literal in (\"—\", \"–\") else literal) * Fraction(10)**int(fact.get(\"scale\", 0))\n                val *= -1 if fact.get(\"sign\") == \"-\" else 1\n                self.assertEqual(val, Fraction(obs[\"value_usd\"]))\n        get = lambda oid: Fraction(self.by_id[oid][\"value_usd\"])\n        self.assertEqual(get(\"interim.bs.2024-12-28.debt_current\") / 1000000, 10848)\n        self.assertEqual(get(\"interim.bs.2024-12-28.debt_noncurrent\") / 1000000, 83956)\n        self.assertEqual(10848 + 83956, 94804)\n        for end in [\"2024-12-28\", \"2023-12-30\"]:\n            for partition in [\"product\", \"segment\"]:\n                self.assertEqual(sum(get(f\"interim.{partition}.{end}.{i}\") for i in range(5)), get(\"interim.revenue.\" + end))\n            self.assertEqual(sum(get(f\"interim.cf.{end}.{k}\") for k in [\"opening\", \"operating\", \"investing\", \"financing\"]),\n                             get(f\"interim.cf.{end}.closing\"))\n\n    def test_substantive_indenture_and_exhibit_contents(self):\n        text = (ROOT / case.NEW / \"registration-2021.txt\").read_text()\n        # Locate operative numbered section headings independently of adapter regex.\n        normalized = text.replace(\"\\xa0\", \" \")\n        start = normalized.index(\"Section 501.\\nEvents of\\nDefault\\n.\")\n        end = normalized.index(\"Section 502.\\nAcceleration of Maturity; Rescission and Annulment\\n.\", start)\n        self.assertGreater(start, text.index(\"Exhibit 4.1\\nApple Inc.\"))\n        agreement = self.case_data[\"external\"][\"agreement_interpretation\"]\n        support = agreement[\"support\"][-1]\n        self.assertEqual((support[\"start\"], support[\"end\"]), (start, end))\n        self.assertIn(\"30 days\", support[\"quote\"])\n        self.assertIn(\"series\", support[\"quote\"].lower())\n        self.assertIn(\"series\", agreement[\"missing\"])\n        e = next(x for x in self.case_data[\"external\"][\"partIII_and_package_obligations\"]\n                 if x[\"id\"] == \"annual.exhibit.4.1.in_pdf\")\n        self.assertGreater(e[\"support\"][\"start\"], e[\"index_support\"][\"end\"])\n        self.assertIn(\"DESCRIPTION OF THE REGISTRANT’S SECURITIES\", e[\"support\"][\"quote\"])\n        self.assertGreater(len(e[\"support\"][\"quote\"]), 10000)\n\n    def test_note_membership_complete_span_and_extraction_identity(self):\n        notes = self.case_data[\"notes\"]\n        case.validate_note_links(notes, self.case_data[\"observations\"])\n        raw = INTERIM_HTML.read_text()\n        headings = [m for m in re.finditer(r\">Note (\\d+) &#8211; <ix:nonNumeric\", raw)]\n        self.assertEqual([int(m[1]) for m in headings], list(range(1, 11)))\n        for note in notes:\n            self.assertTrue(note[\"unresolved_meaning\"])\n            self.assertFalse(note[\"semantic_completion\"])\n            if note[\"id\"].startswith(\"interim.\"):\n                boundary = note[\"raw_note_boundary\"]\n                self.assertEqual(boundary[\"start\"], headings[note[\"number\"]-1].start())\n                for evidence in note[\"linked_quantity_evidence\"]:\n                    s = evidence[\"source\"]\n                    self.assertEqual(raw[s[\"start\"]:s[\"end\"]], s[\"quote\"])\n                    self.assertLessEqual(s[\"end\"], boundary[\"end\"])\n        linked_note = next(n for n in notes if n[\"id\"].startswith(\"interim.\") and n[\"linked_quantities\"])\n        for mutation in [\"end\", \"extraction\", \"assignment\"]:\n            altered = copy.deepcopy(notes)\n            note = next(n for n in altered if n[\"id\"] == linked_note[\"id\"])\n            link = note[\"linked_quantity_evidence\"][0]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '187,390p' scripts/apple_case_v1.py\"","aggregated_output":"class InlineReader:\n    \"\"\"Strict subset of inline-XBRL used in this case, retaining raw ID anchors.\"\"\"\n    def __init__(self, doc):\n        self.doc = doc\n        self.raw = (ROOT/doc.original).read_text()\n        self.soup = BeautifulSoup(self.raw, \"html.parser\")\n        self.ids = {}\n        for el in self.soup.find_all(id=True):\n            require(el[\"id\"] not in self.ids, \"duplicate HTML/XBRL id\")\n            self.ids[el[\"id\"]] = el\n        self.facts = self.soup.find_all(\"ix:nonfraction\")\n\n    def raw_anchor(self, el):\n        # Exact original bytes (ASCII-compatible UTF-8 text offsets), not soup serialization.\n        pattern = r\"<\" + re.escape(el.name) + r\"\\b[^>]*\\bid=[\\\"']\" + re.escape(el[\"id\"]) + r\"[\\\"'][^>]*>.*?</\" + re.escape(el.name) + r\">\"\n        matches = list(re.finditer(pattern, self.raw, re.S | re.I))\n        require(len(matches) == 1, \"raw ID anchor missing/ambiguous\")\n        m = matches[0]\n        return dict(path=self.doc.original, sha256=self.doc.original_hash,\n                    start=m.start(), end=m.end(), quote=m[0], offset_unit=\"Unicode code points\", id=el[\"id\"])\n\n    def resolve(self, ref, tag):\n        require(ref in self.ids and self.ids[ref].name == tag, f\"broken {tag} reference {ref}\")\n        return self.ids[ref]\n\n    def parse_context(self, el):\n        identifier = el.find_all(\"xbrli:identifier\")\n        require(len(identifier) == 1, \"ambiguous entity\")\n        require(identifier[0].get(\"scheme\") == \"http://www.sec.gov/CIK\", \"unsupported entity scheme\")\n        period = el.find(\"xbrli:period\")\n        require(period is not None, \"missing period\")\n        tags = [n for n in period.children if getattr(n, \"name\", None)]\n        names = [n.name for n in tags]\n        require(names in [[\"xbrli:instant\"], [\"xbrli:startdate\", \"xbrli:enddate\"]], \"unsupported period\")\n        dates = [date.fromisoformat(n.get_text()).isoformat() for n in tags]\n        require(len(dates) == 1 or dates[0] <= dates[1], \"reversed period\")\n        p = dict(instant=dates[0]) if len(dates) == 1 else dict(start=dates[0], end=dates[1])\n        require(not el.find(\"xbrldi:typedmember\") and not el.find(\"xbrli:scenario\"), \"unsupported context content\")\n        dims = {}\n        for d in el.find_all(\"xbrldi:explicitmember\"):\n            require(d.get(\"dimension\") and d[\"dimension\"] not in dims, \"duplicate/missing dimension\")\n            dims[d[\"dimension\"]] = d.get_text()\n        out = context(p, dims)\n        out[\"entity\"] = identifier[0].get_text()\n        return out\n\n    def parse(self, fact):\n        cid, uid = fact.get(\"contextref\"), fact.get(\"unitref\")\n        c, u = self.resolve(cid, \"xbrli:context\"), self.resolve(uid, \"xbrli:unit\")\n        ctx = self.parse_context(c)\n        measures = u.find_all(\"xbrli:measure\")\n        require(len(measures) == 1 and measures[0].get_text() == \"iso4217:USD\" and\n                not u.find(\"xbrli:divide\"), \"unsupported currency/unit\")\n        require(fact.get(\"sign\") in [None, \"-\"], \"unsupported sign\")\n        require(not fact.get(\"xsi:nil\") and not fact.get(\"continuedat\"), \"nil/continued numeric unsupported\")\n        require(re.fullmatch(r\"-?\\d+\", fact.get(\"scale\", \"0\")) is not None, \"invalid scale\")\n        require(re.fullmatch(r\"-?\\d+\", fact.get(\"decimals\", \"\")) is not None, \"unsupported precision\")\n        scale, decimals = int(fact.get(\"scale\", \"0\")), int(fact[\"decimals\"])\n        require(-12 <= scale <= 12 and -12 <= decimals <= 12, \"unbounded scale/precision\")\n        fmt, lit = fact.get(\"format\"), fact.get_text(strip=True)\n        if fmt == \"ixt:fixed-zero\":\n            require(lit in (\"—\", \"–\", \"0\"), \"invalid zero transform\")\n            v = Fraction(0)\n        elif fmt == \"ixt:num-dot-decimal\":\n            require(re.fullmatch(r\"(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\", lit) is not None, \"invalid decimal transform\")\n            v = number(lit)\n        elif fmt is None:\n            require(re.fullmatch(r\"\\d+(?:\\.\\d+)?\", lit) is not None, \"unformatted nonnumeric fact\")\n            v = Fraction(lit)\n        else:\n            raise CaseError(\"unsupported inline transform \" + fmt)\n        v *= power10(scale) * (-1 if fact.get(\"sign\") == \"-\" else 1)\n        row = fact.find_parent(\"tr\")\n        # Selected monetary rows must agree with the visual sign, unless narrative.\n        cell = fact.find_parent(\"td\")\n        if cell:\n            visible = cell.get_text(\"\", strip=True)\n            require((\"(\" in visible and \")\" in visible) == (v < 0), \"rendered/tagged sign mismatch\")\n        rowtext = row.get_text(\" \", strip=True) if row else fact.parent.get_text(\" \", strip=True)\n        return dict(value=v, literal=lit, scale=scale, quantum=power10(-decimals), context=ctx,\n                    raw=dict(fact=self.raw_anchor(fact), context=self.raw_anchor(c), unit=self.raw_anchor(u),\n                             fact_id=fact[\"id\"], context_id=cid, unit_id=uid, decimals=decimals,\n                             sign=fact.get(\"sign\"), transform=fmt, rendered_text=rowtext))\n\n    def select(self, concept, ctx, measurement, oid, scale=6, decimals=-6, partition=None,\n               label=None):\n        candidates = []\n        for f in self.facts:\n            if f.get(\"name\") != concept:\n                continue\n            c = self.resolve(f.get(\"contextref\"), \"xbrli:context\")\n            parsed_ctx = self.parse_context(c)\n            if parsed_ctx == ctx:\n                candidates.append(self.parse(f))\n        require(candidates, f\"missing required fact/context {concept} {ctx}\")\n        first = candidates[0]\n        for c in candidates:\n            require(c[\"value\"] == first[\"value\"] and c[\"quantum\"] == first[\"quantum\"], \"conflicting repeated readings\")\n            require(c[\"scale\"] == scale and c[\"raw\"][\"decimals\"] == decimals, \"wrong presentation scale/precision\")\n        if label:\n            require(any(label in c[\"raw\"][\"rendered_text\"] for c in candidates), \"rendered label not found\")\n        return observation(oid, concept, first[\"value\"], first[\"literal\"], scale, first[\"quantum\"],\n                           ctx, measurement, [c[\"raw\"] for c in candidates], partition=partition)\n\n\ndef same_context(obs, ignore=()):\n    require(obs, \"no operands\")\n    base = {k: v for k, v in obs[0][\"context\"].items() if k not in ignore}\n    require(all({k: v for k, v in x[\"context\"].items() if k not in ignore} == base for x in obs),\n            \"entity/currency/perimeter/basis/period/dimensions mismatch\")\n    require(base.get(\"entity\") == ENTITY and base.get(\"perimeter\") == \"consolidated\" and\n            base.get(\"currency\") == \"USD\" and base.get(\"basis\") == \"US GAAP\" and\n            base.get(\"entity_scheme\") == \"http://www.sec.gov/CIK\", \"unsupported case context\")\n\n\ndef validate_value(obs):\n    \"\"\"Check value, precision and sign against the retained numeric reading.\"\"\"\n    value = Fraction(obs[\"value_usd\"])\n    require(obs[\"rounding_interval_usd\"] == interval(value, obs[\"presentation_quantum_usd\"]),\n            \"altered rounding interval\")\n    require(abs(value) == abs(number(obs[\"displayed_literal\"])*power10(obs[\"scale\"])),\n            \"literal/scale/value mismatch\")\n    require(obs[\"source_readings\"], \"missing numeric source\")\n    for source in obs[\"source_readings\"]:\n        if \"cell\" in source:\n            require(value == number(source[\"cell\"][\"quote\"])*MILLION and obs[\"scale\"] == 6 and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == MILLION, \"annual cell/value mismatch\")\n        elif \"fact\" in source:\n            fact = BeautifulSoup(source[\"fact\"][\"quote\"], \"html.parser\").find(\"ix:nonfraction\")\n            require(fact is not None, \"missing inline source\")\n            sign = -1 if fact.get(\"sign\") == \"-\" else 1\n            require(value == number(fact.get_text(strip=True))*power10(int(fact.get(\"scale\", \"0\")))*sign,\n                    \"inline source/value mismatch\")\n            require(obs[\"scale\"] == int(fact.get(\"scale\", \"0\")) and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == power10(-int(fact[\"decimals\"])),\n                    \"inline precision mismatch\")\n        else:\n            raise CaseError(\"unsupported numeric reading\")\n\n\ndef reconcile(bridge_id, kind, operands, target, partition=None):\n    all_obs = operands+[target]\n    validate_anchors(all_obs)\n    for obs in all_obs:\n        validate_value(obs)\n    transformations = []\n    if kind == \"cash_flow\":\n        require(len(operands) == 4, \"cash flow operands\")\n        opening, *flows = operands\n        require(opening[\"measurement\"] == target[\"measurement\"] == \"cash_including_restricted\", \"cash perimeter mismatch\")\n        require(all(o[\"measurement\"] == \"cash_flow\" for o in flows), \"cash movement type\")\n        same_context(all_obs, (\"period\",))\n        per = flows[0][\"context\"][\"period\"]\n        require(all(x[\"context\"][\"period\"] == per for x in flows), \"flow period mismatch\")\n        require(opening[\"context\"][\"period\"] == {\"instant\": (date.fromisoformat(per[\"start\"])-timedelta(days=1)).isoformat()} and\n                target[\"context\"][\"period\"] == {\"instant\": per[\"end\"]}, \"stock/flow date mismatch\")\n        transformations.append(\"Opening instant is the day before the disclosed flow period; closing instant is its end. Cash includes restricted cash on both sides.\")\n    elif kind == \"partition\":\n        same_context(all_obs, (\"dimensions\",))\n        require(partition in (\"product\", \"segment\"), \"unknown partition\")\n        expected = PRODUCTS if partition == \"product\" else SEGMENTS\n        require([o.get(\"partition\") for o in operands] == [partition]*len(expected), \"overlapping or wrong partitions\")\n        require([o.get(\"member_label\") for o in operands] == expected, \"duplicate/missing partition member\")\n        require(all(o[\"measurement\"] == \"net_revenue\" for o in all_obs) and not target[\"context\"][\"dimensions\"], \"revenue target\")\n        require(len({json.dumps(o[\"context\"][\"dimensions\"], sort_keys=True) for o in operands}) == len(expected), \"duplicate dimension members\")\n        axis, members = ((\"srt:ProductOrServiceAxis\", PRODUCT_MEMBERS) if partition == \"product\" else\n                         (\"us-gaap:StatementBusinessSegmentsAxis\", SEGMENT_MEMBERS))\n        require([o[\"context\"][\"dimensions\"] for o in operands] == [{axis: m} for m in members] and\n                all(o[\"concept\"] == REV for o in all_obs), \"partition axis/member/concept mismatch\")\n        transformations.append(\"Sum one disclosed exhaustive table partition; product and geography are separate classifications of the same revenue.\")\n    else:\n        same_context(all_obs)\n        measurements = [o[\"measurement\"] for o in operands]\n        allowed = {\n            \"balance\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n            \"debt_components\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n            \"principal_to_carrying\": ([\"principal\", \"carrying_adjustment\", \"carrying_adjustment\"], \"carrying_amount\"),\n            \"ppe\": ([\"gross_cost\", \"accumulated_depreciation\"], \"carrying_amount\"),\n            \"equality\": ([target[\"measurement\"]], target[\"measurement\"]),\n            \"rounded_debt\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n        }\n        require(kind in allowed and (measurements, target[\"measurement\"]) == allowed[kind], \"measurement substitution\")\n        if kind == \"balance\":\n            require([o[\"concept\"] for o in all_obs] == [\"us-gaap:Liabilities\", \"us-gaap:StockholdersEquity\", \"us-gaap:Assets\"],\n                    \"balance concept mismatch\")\n        if kind in (\"debt_components\", \"rounded_debt\"):\n            require([o[\"concept\"] for o in operands] == [\"us-gaap:LongTermDebtCurrent\", \"us-gaap:LongTermDebtNoncurrent\"],\n                    \"debt component concept mismatch\")\n    value = sum(Fraction(o[\"value_usd\"]) for o in operands)\n    target_value = Fraction(target[\"value_usd\"])\n    lhs_interval = interval_sum(operands)\n    rhs_interval = target[\"rounding_interval_usd\"]\n    rounding = compatible(lhs_interval, rhs_interval)\n    require(rounding, \"incompatible rounding intervals\")\n    if kind != \"rounded_debt\":\n        require(value == target_value, \"displayed arithmetic mismatch\")\n    return dict(id=bridge_id, kind=kind, operands=[o[\"id\"] for o in operands], target=target[\"id\"],\n                lhs_usd=str(value), rhs_usd=str(target_value), residual_usd=str(value-target_value),\n                lhs_interval_usd=list(map(str, lhs_interval)), rhs_interval_usd=rhs_interval,\n                displayed_identity=value == target_value, rounding_compatible=rounding,\n                status=\"pass\", transformations=transformations,\n                conclusion=\"displayed identity\" if kind != \"rounded_debt\" else \"rounding compatibility only\")\n\n\n","exit_code":0,"status":"completed"}}
