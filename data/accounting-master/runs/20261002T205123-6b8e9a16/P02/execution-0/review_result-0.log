{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '923,976p' scripts/apple_case_v1.py; sed -n '398,438p' scripts/apple_case_v1.py; rg -n 'MC01|MC03|MC05|MC16|MC28' docs/plans/accounting-mission-requirements.md\"","aggregated_output":"def external_records(annual, interim, docs):\n    proxy, reg, official = [docs[k] for k in (\"proxy-2025\", \"registration-2021\", \"annual-2024-official\")]\n    exhibits = exhibit_records(annual, official, interim)\n    obligations = []\n    proxy_patterns = {\n        10: r\"Board Independence\\nApple’s Corporate Governance Guidelines.*?applicable rules of The Nasdaq Stock Market LLC.*?\\(“Nasdaq”\\)\\.\",\n        11: r\"Compensation Discussion and Analysis\\nThis Compensation.*?paid to our named executive officers\\.\",\n        12: r\"Security\\nOwnership of Certain Beneficial Owners and Management\\nThe\\nfollowing table.*?\\(the “Table Date”\\)\",\n        13: r\"Related Party Policy and Transactions\\nThe Board has.*?\\$120,000 in a single fiscal year\",\n        14: r\"Audit Fees\\n\\(1\\).*?Total\\n30,270,822\\n25,403,329\",\n    }\n    lo, hi = annual.page(52)\n    for item, pat in proxy_patterns.items():\n        start = annual.find(r\"Item \"+str(item)+r\"\\.[^\\n]+\", (lo, hi))[\"start\"]\n        stop = annual.text.find(\"Item \"+str(item+1)+\".\", start, hi) if item < 14 else hi\n        obligations.append(dict(id=f\"annual.partIII.item{item}\", target=\"2025 proxy, accession 0001308179-25-000008\",\n                                incorporation=annual.anchor(start, stop), support=proxy.find(pat, flags=re.S),\n                                status=\"target_acquired_selected_passage_inspected\",\n                                unresolved=\"Complete item-level semantics, exceptions and references beyond the selected passage remain unmodelled.\",\n                                consequence=\"Proxy information cannot be backdated to the annual filing.\",\n                                next_route=\"Inspect remaining sections in the retained proxy and its exact incorporated targets.\"))\n    title = reg.find(r\"Exhibit 4\\.1\\nApple Inc\\..*?Dated as of October\\s+28, 2021\", flags=re.S)\n    terms = reg.find(r\"Section\\s+301\\.\\nAmount\\nUnlimited; Issuable in Series.*?Section\\s+302\\.\", flags=re.S)\n    # Select the substantive Section 501 in Exhibit 4.1.  The same phrase\n    # occurs in a prospectus summary and in the table of contents; the section\n    # heading and Section 502 terminator bind the operative text.\n    defaults = reg.find(r\"Section\\s+501\\.\\nEvents of\\nDefault\\n\\..*?(?=Section\\s+502\\.\\nAcceleration of Maturity; Rescission and Annulment\\n\\.)\",\n                        (title[\"end\"], len(reg.text)), flags=re.S)\n    for e in exhibits:\n        if e[\"id\"] == \"annual.exhibit.4.26\":\n            e.update(contents_status=\"acquired_in_registration_2021; selected_sections_inspected\", acquired_support=title,\n                     section_301=terms, section_501=defaults,\n                     missing_terms=\"Series-specific officer certificates, outstanding balances, amendments and swap confirmations/allocation.\")\n    # Keep the exhibit-index row separate from the substantive Exhibit 4.1\n    # contents retained after the annual-report signatures.\n    securities_index = annual.find(r\"(?m)^[ \\t]*4\\.1[^\\n]*Description of Securities of the Registrant\\.\")\n    securities = annual.find(r\"Exhibit 4\\.1\\s+DESCRIPTION OF THE REGISTRANT’S SECURITIES.*?(?=Exhibit 10\\.1)\", flags=re.S)\n    obligations.append(dict(id=\"annual.exhibit.4.1.in_pdf\", target=\"Description of Securities, filed exhibit 4.1\",\n                            support=securities, index_support=securities_index, status=\"heading_and_contents_retained_in_pdf\",\n                            unresolved=\"Description is not the complete incorporated indentures and series certificates.\",\n                            consequence=\"General descriptions do not identify all current debt terms.\",\n                            next_route=\"Inspect specific 4.2–4.28 index targets for contract reconstruction.\"))\n    omissions = annual.find(r\"Certain instruments defining the rights of holders.*?copies of any such instruments\\.\", annual.page(56), re.S)\n    obligations.append(dict(id=\"omitted_debt_instruments\", target=\"Instruments omitted under Item 601(b)(4)(iii)\", support=omissions,\n                            status=\"expressly_omitted_from_filing\", unresolved=\"Instrument identities and complete terms not specified by this index.\",\n                            consequence=\"No complete debt-contract inventory is established.\",\n                            next_route=\"Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach.\"))\n    return dict(partIII_and_package_obligations=obligations, exhibit_inventory=exhibits,\n                agreement_interpretation=dict(status=\"selected_contract_sections_only\", support=[title, terms, defaults],\n                    interpretation=\"Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.\",\n                    missing=\"2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule.\"))\n\n\ndef unidentified_records(notes):\ndef load_sources():\n    for p, h in PINS.items():\n        require(file_hash(p) == h, \"source hash mismatch: \" + p)\n    annual = Document(\"annual\", APPLE+\"annual-2024.pdf\", APPLE+\"annual-2024.txt\", pdf=True)\n    interim = Document(\"interim\", APPLE+\"interim-2025q1.html\", APPLE+\"interim-2025q1.txt\")\n    extracted = subprocess.run([\"pdftotext\", \"-layout\", str(ROOT/annual.original), \"-\"],\n                               capture_output=True, check=True, timeout=30).stdout\n    require(sha(extracted) == annual.extraction_hash, \"PDF extraction does not reproduce retained text\")\n    require(html_text((ROOT/interim.original).read_text()) == interim.text, \"HTML extraction mismatch\")\n    register = json.loads((ROOT/REGISTER).read_text())\n    bindings = []\n    for d, name in [(annual, \"apple-2024-annual\"), (interim, \"apple-2025-q1\")]:\n        candidates = [r for r in register[\"records\"] if r[\"document_id\"] == name]\n        require(len(candidates) == 1, \"P01 source identity\")\n        r = candidates[0]\n        require(r[\"original_sha256\"] == d.original_hash == file_hash(r[\"original_path\"]), \"P01 original binding\")\n        require(r[\"extracted_sha256\"] == file_hash(r[\"extracted_path\"]), \"P01 extraction binding\")\n        bindings.append(dict(**d.binding(), p01_document=name, p01_original_path=r[\"original_path\"],\n                             p01_extraction_path=r[\"extracted_path\"], p01_extraction_sha256=r[\"extracted_sha256\"],\n                             extraction_relation=\"identical\" if r[\"extracted_sha256\"] == d.extraction_hash else\n                             \"distinct text versions; offsets must not transfer\",\n                             p01_publication_metadata=r[\"publication_metadata\"]))\n    acquisitions = json.loads((ROOT/NEW/\"acquisition.json\").read_text())\n    external_docs = {}\n    for rec in acquisitions[\"records\"]:\n        if \"path\" not in rec:\n            continue\n        require(file_hash(rec[\"path\"]) == rec[\"sha256\"], \"acquired bytes changed\")\n        if rec[\"path\"].endswith(\".html\"):\n            p = Path(rec[\"path\"])\n            extracted_path = str(p.with_suffix(\".txt\"))\n            require((ROOT/extracted_path).exists(), \"missing acquired text\")\n            require(html_text((ROOT/p).read_text()) == (ROOT/extracted_path).read_text(), \"external extraction mismatch\")\n            d = Document(p.stem, str(p), extracted_path)\n            external_docs[p.stem] = d\n            bindings.append(dict(**d.binding(), acquisition=rec,\n                                 historical_byte_vintage=\"not established by current retrieval\"))\n    return annual, interim, external_docs, bindings, acquisitions\n\n\ndef collect_observations(annual, interim):\n55:| MC01 | Account for complete annual, quarterly and semi-annual disclosure packages, including notes and relevant referenced material. U1, U3. | Define the source inventory, coverage units, cross-reference closure and disposition rules. A worked filing package must account for retained, structured, duplicated and unresolved content without treating page extraction as semantic completion. | Specified procedure; acquired-file inventory checked. Ch. 2 Apple and Ch. 3 coverage; `cases/apple/manifest.json` accounts for 121 annual pages, 13 annual notes and 10 interim notes. External incorporated documents and full semantic translation remain incomplete. G5, G11. The added source corpus now has 192 checked annual/interim files across nine issuers and 2018–2025; incorporated-package closure and semantic annotation remain open. |\n57:| MC03 | Represent narrative policies, qualifications, commitments and cross-references, including material that is not executable yet. U1, U3, D. | Specify narrative assertion types, modality/quantifiers, links to affected amounts and obligations, and reviewed translation into constraints without inventing thresholds. | Specified Narrative/coverage records and modality rules in Ch. 3 and Core 0. Apple note and cross-reference obligations are retained; representative debt language is interpreted. Complete translation of all material narratives remains open. G2, G11. |\n59:| MC05 | Represent economic, reporting, publication/availability and system times; preserve original and revised history. U1, U3, D. | Specify original, latest-available and harmonised queries, cutoffs, supersession, calendar/interval rules and retrospective/prospective changes. Include exact annual/interim/restatement fixtures. | Specified in Chs. 2–3 and EvidenceView/Time contracts. Four publication/ingestion queries and compatible annual-minus-interim subtraction are reference-checked in `temporal.json`. Debt dates, periods, publication/ingestion/review cutoffs now have semantic rejection checks. General calendar and standards-transition implementations remain pending. G2, G4, G13. The accepted corpus records sourced filing dates for 56 reports and explicitly unverified publication dates for 136; as-of forecasting remains blocked where availability is unknown. |\n80:| MC16 | Produce coherent financial statements, movements and supported note schedules from the same underlying history/path. U1, U2, D. | Define balance sheet, income/comprehensive income, cash flow and equity mappings, non-cash movements, closing and note relationships; supply a full set of expected outputs. | Reference-checked complete Northstar balance sheet, income/zero OCI, direct/indirect cash flow and equity from common journals; Chs. 2, 8 and `northstar.json`. Apple checks a coherent marginal financing stress only. General note schedules and report engine remain pending. G4, G5, G6. |\n102:| MC28 | Connect the full design through complete synthetic and real disclosure cases. U1, U2, U3, D. | Supply a known-history synthetic company and a named annual/interim real package across multiple dates; trace representative notes through records, constraints, alternatives and all affected future statements. Add structural finance/sector cases before fixing the core types. | Reference cases delivered in Ch. 2: complete synthetic Northstar history/revision/forecast and named Apple annual/interim inventory, notes and conditional stress. Ch. 9 supplies sector/finance structures. Real-company full semantic closure and independent case annotation remain open; no complete Apple forecast is claimed. G4, G5, G7. Nine eight-year report sequences are now source-checked; report-wide semantic cases and executable oracles remain to be prepared. |\n140:plan; v1 evidence remains preserved. This advances MC01, MC03, MC05, MC19–22,\n141:MC28, MC30 and MC33–35 without closing semantic, accounting or forecast\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,143p' scripts/apple_case_v1.py; sed -n '398,437p' scripts/apple_case_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,143p' scripts/apple_case_v1.py; sed -n '398,437p' scripts/apple_case_v1.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Bounded, source-bound Apple case. No acquisition or forecasting at build time.\n\nMappings below are annotations; numbers are read from pinned source bytes.\nAll amounts used by the arithmetic engine are exact rational USD amounts.\nRevalidation rebuilds from sources, so editing an observation's metadata cannot\nchange its source meaning. This is a case adapter, not a general XBRL processor.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom datetime import date, datetime, timedelta, timezone\nfrom fractions import Fraction\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\n\nfrom bs4 import BeautifulSoup\n\nROOT = Path(__file__).resolve().parents[1]\nAPPLE = \"docs/design/cases/apple/\"\nNEW = APPLE + \"p02-v1/\"\nREGISTER = \"data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json\"\nINDEX = \"data/financial-report-benchmark/landing/apple/21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42.json\"\nPLAN_HASH = \"916a4c80553bebee3ca0b6399ba8d4e54a6f5d3bd2975cda75815b95e8f45f59\"\nRECOVERY_PLAN_HASH = \"569a45ba5ce7d75d1e71ba5fc5a870de38f5dedcc7b6d81aa74b4f135f815bcd\"\nPINS = {\n    APPLE + \"annual-2024.pdf\": \"ec74758cd767465362c641cf2fd5d8fedd477aed2bf7f62117e67610435dcb88\",\n    APPLE + \"annual-2024.txt\": \"caaf182340d3846ff54cf967a2d3da7dce82505170665943ea7227e6bed8336e\",\n    APPLE + \"interim-2025q1.html\": \"2f7629f0733f75b3155dd52f7ae6a8724468e3cde1a9ce32fbce96d98f1ec27e\",\n    APPLE + \"interim-2025q1.txt\": \"ab8e06fc35957f43a355d0d1d11d57d203b494a4008edb39cff162e984ef633b\",\n    APPLE + \"manifest.json\": \"f25b63803d8a7e136befa10d68b935f521aa42ffc95663b6c26d792b0e4e5fc7\",\n    INDEX: \"21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42\",\n}\nMILLION = 10**6\nENTITY = \"0000320193\"\nPRODUCTS = [\"iPhone\", \"Mac\", \"iPad\", \"Wearables, Home and Accessories\", \"Services\"]\nSEGMENTS = [\"Americas\", \"Europe\", \"Greater China\", \"Japan\", \"Rest of Asia Pacific\"]\nPRODUCT_MEMBERS = [\"aapl:IPhoneMember\", \"aapl:MacMember\", \"aapl:IPadMember\",\n                   \"aapl:WearablesHomeandAccessoriesMember\", \"us-gaap:ServiceMember\"]\nSEGMENT_MEMBERS = [\"aapl:AmericasSegmentMember\", \"aapl:EuropeSegmentMember\",\n                   \"aapl:GreaterChinaSegmentMember\", \"aapl:JapanSegmentMember\",\n                   \"aapl:RestOfAsiaPacificSegmentMember\"]\nREV = \"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"\nCF_BAL = \"us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents\"\n\n\nclass CaseError(ValueError):\n    \"\"\"A source or interpretation fails the supported case contract.\"\"\"\n\n\ndef require(condition, message):\n    if not condition:\n        raise CaseError(message)\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef file_hash(path):\n    return sha((ROOT / path).read_bytes())\n\n\ndef power10(n):\n    return Fraction(10)**n\n\n\ndef number(literal):\n    s = re.sub(r\"[\\s$]\", \"\", literal)\n    if s in (\"—\", \"–\"):\n        return Fraction(0)\n    require(bool(re.fullmatch(r\"(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\", s)) or\n            bool(re.fullmatch(r\"\\((?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\\)\", s)), \"unsupported numeric literal: \" + literal)\n    s = s.replace(\",\", \"\")\n    return -Fraction(s[1:-1]) if s.startswith(\"(\") else Fraction(s)\n\n\ndef interval(value, quantum):\n    v, q = Fraction(value), Fraction(quantum)\n    require(q > 0, \"precision must be positive\")\n    return [str(v-q/2), str(v+q/2)]\n\n\ndef interval_sum(observations, coefficients=None):\n    coefs = coefficients or [1]*len(observations)\n    require(len(coefs) == len(observations), \"coefficient count\")\n    lo = hi = Fraction(0)\n    for obs, c in zip(observations, coefs):\n        a, b = map(Fraction, obs[\"rounding_interval_usd\"])\n        lo += min(c*a, c*b)\n        hi += max(c*a, c*b)\n    return lo, hi\n\n\ndef compatible(left, right):\n    return max(Fraction(left[0]), Fraction(right[0])) <= min(Fraction(left[1]), Fraction(right[1]))\n\n\nclass Document:\n    def __init__(self, identity, original, extraction, pdf=False):\n        self.identity, self.original, self.extraction, self.pdf = identity, original, extraction, pdf\n        self.original_hash, self.extraction_hash = file_hash(original), file_hash(extraction)\n        self.text = (ROOT/extraction).read_text()\n\n    def anchor(self, start, end):\n        require(0 <= start < end <= len(self.text), \"anchor range\")\n        out = dict(document=self.identity, original_path=self.original,\n                   original_sha256=self.original_hash, extraction_path=self.extraction,\n                   extraction_sha256=self.extraction_hash, offset_unit=\"Unicode code points\",\n                   start=start, end=end, quote=self.text[start:end])\n        if self.pdf:\n            page_start = self.text.rfind(\"\\f\", 0, start)+1\n            page_end = self.text.find(\"\\f\", start)\n            page = self.text[page_start:page_end if page_end >= 0 else len(self.text)]\n            m = re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| (\\d+)\", page)\n            out.update(pdf_page=self.text.count(\"\\f\", 0, start)+1,\n                       printed_page=int(m[1]) if m else None,\n                       ending_pdf_page=self.text.count(\"\\f\", 0, end-1)+1)\n        return out\n\n    def find(self, pattern, bounds=None, flags=0):\n        start, end = bounds or (0, len(self.text))\n        matches = list(re.finditer(pattern, self.text[start:end], flags))\n        require(len(matches) == 1, f\"{self.identity}: expected unique span {pattern!r}, got {len(matches)}\")\n        m = matches[0]\n        return self.anchor(start+m.start(), start+m.end())\n\n    def page(self, printed):\n        offset = 0\n        for page in self.text.split(\"\\f\"):\n            if re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| \" + str(printed) + r\"\\s*$\", page):\n                return offset, offset+len(page)\n            offset += len(page)+1\n        raise CaseError(\"printed page missing\")\n\n    def binding(self):\n        return dict(id=self.identity, original_path=self.original, original_sha256=self.original_hash,\n                    extraction_path=self.extraction, extraction_sha256=self.extraction_hash)\n\n\ndef load_sources():\n    for p, h in PINS.items():\n        require(file_hash(p) == h, \"source hash mismatch: \" + p)\n    annual = Document(\"annual\", APPLE+\"annual-2024.pdf\", APPLE+\"annual-2024.txt\", pdf=True)\n    interim = Document(\"interim\", APPLE+\"interim-2025q1.html\", APPLE+\"interim-2025q1.txt\")\n    extracted = subprocess.run([\"pdftotext\", \"-layout\", str(ROOT/annual.original), \"-\"],\n                               capture_output=True, check=True, timeout=30).stdout\n    require(sha(extracted) == annual.extraction_hash, \"PDF extraction does not reproduce retained text\")\n    require(html_text((ROOT/interim.original).read_text()) == interim.text, \"HTML extraction mismatch\")\n    register = json.loads((ROOT/REGISTER).read_text())\n    bindings = []\n    for d, name in [(annual, \"apple-2024-annual\"), (interim, \"apple-2025-q1\")]:\n        candidates = [r for r in register[\"records\"] if r[\"document_id\"] == name]\n        require(len(candidates) == 1, \"P01 source identity\")\n        r = candidates[0]\n        require(r[\"original_sha256\"] == d.original_hash == file_hash(r[\"original_path\"]), \"P01 original binding\")\n        require(r[\"extracted_sha256\"] == file_hash(r[\"extracted_path\"]), \"P01 extraction binding\")\n        bindings.append(dict(**d.binding(), p01_document=name, p01_original_path=r[\"original_path\"],\n                             p01_extraction_path=r[\"extracted_path\"], p01_extraction_sha256=r[\"extracted_sha256\"],\n                             extraction_relation=\"identical\" if r[\"extracted_sha256\"] == d.extraction_hash else\n                             \"distinct text versions; offsets must not transfer\",\n                             p01_publication_metadata=r[\"publication_metadata\"]))\n    acquisitions = json.loads((ROOT/NEW/\"acquisition.json\").read_text())\n    external_docs = {}\n    for rec in acquisitions[\"records\"]:\n        if \"path\" not in rec:\n            continue\n        require(file_hash(rec[\"path\"]) == rec[\"sha256\"], \"acquired bytes changed\")\n        if rec[\"path\"].endswith(\".html\"):\n            p = Path(rec[\"path\"])\n            extracted_path = str(p.with_suffix(\".txt\"))\n            require((ROOT/extracted_path).exists(), \"missing acquired text\")\n            require(html_text((ROOT/p).read_text()) == (ROOT/extracted_path).read_text(), \"external extraction mismatch\")\n            d = Document(p.stem, str(p), extracted_path)\n            external_docs[p.stem] = d\n            bindings.append(dict(**d.binding(), acquisition=rec,\n                                 historical_byte_vintage=\"not established by current retrieval\"))\n    return annual, interim, external_docs, bindings, acquisitions\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport json\nfrom pathlib import Path\nc=json.loads(Path('data/accounting-master/deliverables/P02/case.json').read_text())\nfor n in c['notes']:\n print(n['id'], n['title'],len(n['linked_quantities']), n['unresolved_meaning'])\np=Path('docs/design/cases/apple/p02-v1/acquisition.json');d=json.loads(p.read_text());print('ACQUISITION TYPE',type(d).__name__);print(json.dumps(d)[:3900])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport json\nfrom pathlib import Path\nc=json.loads(Path('data/accounting-master/deliverables/P02/case.json').read_text())\nfor n in c['notes']:\n print(n['id'], n['title'],len(n['linked_quantities']), n['unresolved_meaning'])\np=Path('docs/design/cases/apple/p02-v1/acquisition.json');d=json.loads(p.read_text());print('ACQUISITION TYPE',type(d).__name__);print(json.dumps(d)[:3900])\nPY\"","aggregated_output":"annual.note.1 Summary of Significant Accounting Policies 0 Legal-entity control histories, estimate changes and full policy-to-posting rules are not reconstructed.\nannual.note.2 Revenue 15 Contract performance, return estimates, transaction-price allocation and deferred-revenue movements remain unidentified.\nannual.note.3 Earnings Per Share 0 Share counts are in thousands and EPS is per share; this USD-only extractor does not implement dilution or per-share division.\nannual.note.4 Financial Instruments 1 Notional does not identify hedge allocation, reset dates, currency sensitivities or future OCI recycling.\nannual.note.5 Property, Plant and Equipment 6 Acquisition cohorts, disposals, asset lives and future depreciation are not identified by the gross/net bridge.\nannual.note.6 Consolidated Financial Statement Details 0 Components of other assets and liabilities are not converted to a unique transaction history or posting rules.\nannual.note.7 Income Taxes 0 Jurisdiction-specific settlements, taxable bases and future effective rates cannot be inferred from the totals.\nannual.note.8 Leases 0 Individual lease discounting, renewal choices, modifications and variable-payment drivers remain unidentified.\nannual.note.9 Debt 8 Cash repayments alone cannot produce a debt roll-forward: FX, noncash and measurement movements and contract allocations are missing.\nannual.note.10 Shareholders’ Equity 0 Future repurchases, dividends and issuance timing remain choices, not deterministic consequences of authorization.\nannual.note.11 Share-Based Compensation 0 Grant-level vesting, forfeiture, performance outcomes and future cash-tax settlement histories remain unresolved.\nannual.note.12 Commitments, Contingencies and Supply Concentrations 0 No loss probabilities, universal materiality threshold, provision equal to commitments or numerical supplier haircut is inferred.\nannual.note.13 Segment Information and Geographic Data 15 Cross-classified product-by-geography cells, future regional behavior and full segment-profit cost allocations remain unidentified.\ninterim.note.1 Summary of Significant Accounting Policies 0 Legal-entity control histories, estimate changes and full policy-to-posting rules are not reconstructed.\ninterim.note.2 Revenue 12 Contract performance, return estimates, transaction-price allocation and deferred-revenue movements remain unidentified.\ninterim.note.3 Earnings Per Share 0 Share counts are in thousands and EPS is per share; this USD-only extractor does not implement dilution or per-share division.\ninterim.note.4 Financial Instruments 2 Notional does not identify hedge allocation, reset dates, currency sensitivities or future OCI recycling.\ninterim.note.5 Condensed Consolidated Financial Statement Details 0 Inventory purchase/consumption histories and asset cohorts remain unidentified; interim detail schedules are not executed here.\ninterim.note.6 Debt 4 Cash repayments alone cannot produce a debt roll-forward: FX, noncash and measurement movements and contract allocations are missing.\ninterim.note.7 Shareholders’ Equity 0 Future repurchases, dividends and issuance timing remain choices, not deterministic consequences of authorization.\ninterim.note.8 Share-Based Compensation 0 Grant-level vesting, forfeiture, performance outcomes and future cash-tax settlement histories remain unresolved.\ninterim.note.9 Contingencies 0 The assertion supplies neither a zero liability nor a numeri