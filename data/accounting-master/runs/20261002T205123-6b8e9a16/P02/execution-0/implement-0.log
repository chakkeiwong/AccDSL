rn, (a[\"start\"], a[\"end\"]))\n    return [\n        dict(id=\"annual.perimeter\", status=\"reported_policy\", anchor=within(annual, r\"The consolidated financial statements include.*?wholly owned subsidiaries\\.\")),\n        dict(id=\"annual.reclassification\", status=\"reported_qualification\", anchor=within(annual, r\"Certain prior period amounts.*?current period’s presentation\\.\"),\n             interpretation=\"Comparatives are as presented in the 2024 report; original historical presentation has not been reconstructed.\"),\n        dict(id=\"annual.inventory\", status=\"reported_policy\", anchor=within(annual, r\"Inventories are measured using the first-in, first-out method\\.\")),\n        dict(id=\"annual.depreciation\", status=\"reported_policy\", anchor=within(annual, r\"Depreciation on property, plant and equipment.*?straight-line basis\\.\")),\n        dict(id=\"interim.preparation\", status=\"reported_management_assertion\", anchor=within(interim, r\"In the opinion of the Company’s management.*?2024 Form 10-K”\\)\\.\"),\n             interpretation=\"Normal recurring adjustments and management estimates; read together with annual statements, not an independently complete annual policy disclosure.\"),\n        dict(id=\"interim.calendar\", status=\"reported_policy\", anchor=within(interim, r\"The Company’s fiscal year.*?those fiscal years\\.\")),\n    ]\n\n\ndef filing_records():\n                          consequence=\"No complete incorporated-package or contract-history claim.\",\n                          next_route=\"Use the exact SEC accession in the link or the issuer filing feed for the stated form and date.\")\n            if internal:\n                missing_internal = [u for u in internal\n                                    if soup.find(id=u[1:]) is None and\n                                    soup.find(attrs={\"name\": u[1:]}) is None]\n                if missing_internal:\n                    # A malformed or stale anchor is itself evidence about\n                    # package closure.  Preserve it as an unresolved filing\n                    # obligation instead of silently treating the link as\n                    # resolved or aborting the whole bounded case build.\n                    record[\"contents_status\"] = \"internal_target_missing_in_retained_html\"\n                    record[\"missing_internal_targets\"] = missing_internal\n                    record[\"missing_terms\"] = \"Retained issuer HTML exposes an internal link whose target is absent; substantive exhibit contents remain unverified.\"\n                else:\n                    record[\"contents_status\"] = \"within_retained_issuer_html; semantics_unresolved\"\n            if external:\n                record[\"contents_status\"] = \"external_target_not_acquired\"\n            if number in (\"101\", \"104\"):\n                record[\"contents_status\"] = \"inline_facts_present; complete_taxonomy_package_not_acquired\"\n                record[\"missing_terms\"] = \"Separate taxonomy/linkbase files and complete package validation.\"\n            if prefix == \"annual\":\n                # Bind each issuer index row independently to the mirrored PDF index.\n                lo, hi = annual.page(53)[0], annual.page(56)[1]\n                record[\"pdf_index_row\"] = annual.find(r\"^[ \\t]*\"+re.escape(number)+r\"(?=[* \\t])[^\\n]+\", (lo, hi), re.M)\n            result.append(record)\n    require(len({r[\"id\"] for r in result}) == len(result), \"duplicate exhibit rows\")\n    return result\n\n\ndef external_records(annual, interim, docs):\n","exit_code":0,"status":"completed"}}
