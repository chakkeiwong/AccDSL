               ctx, measurement, [c[\"raw\"] for c in candidates], partition=partition)\n\n\ndef same_context(obs, ignore=()):\n    require(obs, \"no operands\")\n    base = {k: v for k, v in obs[0][\"context\"].items() if k not in ignore}\n    require(all({k: v for k, v in x[\"context\"].items() if k not in ignore} == base for x in obs),\n            \"entity/currency/perimeter/basis/period/dimensions mismatch\")\n    require(base.get(\"entity\") == ENTITY and base.get(\"perimeter\") == \"consolidated\" and\n            base.get(\"currency\") == \"USD\" and base.get(\"basis\") == \"US GAAP\" and\n            base.get(\"entity_scheme\") == \"http://www.sec.gov/CIK\", \"unsupported case context\")\n\n\ndef validate_value(obs):\n    \"\"\"Check value, precision and sign against the retained numeric reading.\"\"\"\n    value = Fraction(obs[\"value_usd\"])\n    require(obs[\"rounding_interval_usd\"] == interval(value, obs[\"presentation_quantum_usd\"]),\n            \"altered rounding interval\")\n    require(abs(value) == abs(number(obs[\"displayed_literal\"])*power10(obs[\"scale\"])),\n            \"literal/scale/value mismatch\")\n    require(obs[\"source_readings\"], \"missing numeric source\")\n    for source in obs[\"source_readings\"]:\n        if \"cell\" in source:\n            require(value == number(source[\"cell\"][\"quote\"])*MILLION and obs[\"scale\"] == 6 and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == MILLION, \"annual cell/value mismatch\")\n        elif \"fact\" in source:\n            fact = BeautifulSoup(source[\"fact\"][\"quote\"], \"html.parser\").find(\"ix:nonfraction\")\n            require(fact is not None, \"missing inline source\")\n            sign = -1 if fact.get(\"sign\") == \"-\" else 1\n            require(value == number(fact.get_text(strip=True))*power10(int(fact.get(\"scale\", \"0\")))*sign,\n                    \"inline source/value mismatch\")\n            require(obs[\"scale\"] == int(fact.get(\"scale\", \"0