ue target\")\n        require(len({json.dumps(o[\"context\"][\"dimensions\"], sort_keys=True) for o in operands}) == len(expected), \"duplicate dimension members\")\n        axis, members = ((\"srt:ProductOrServiceAxis\", PRODUCT_MEMBERS) if partition == \"product\" else\n                         (\"us-gaap:StatementBusinessSegmentsAxis\", SEGMENT_MEMBERS))\n        require([o[\"context\"][\"dimensions\"] for o in operands] == [{axis: m} for m in members] and\n                all(o[\"concept\"] == REV for o in all_obs), \"partition axis/member/concept mismatch\")\n        transformations.append(\"Sum one disclosed exhaustive table partition; product and geography are separate classifications of the same revenue.\")\n    else:\n        same_context(all_obs)\n        measurements = [o[\"measurement\"] for o in operands]\n        allowed = {\n            \"balance\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n            \"debt_components\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n            \"principal_to_carrying\": ([\"principal\", \"carrying_adjustment\", \"carrying_adjustment\"], \"carrying_amount\"),\n            \"ppe\": ([\"gross_cost\", \"accumulated_depreciation\"], \"carrying_amount\"),\n            \"equality\": ([target[\"measurement\"]], target[\"measurement\"]),\n            \"rounded_debt\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n        }\n        require(kind in allowed and (measurements, target[\"measurement\"]) == allowed[kind], \"measurement substitution\")\n        if kind == \"balance\":\n            require([o[\"concept\"] for o in all_obs] == [\"us-gaap:Liabilities\", \"us-gaap:StockholdersEquity\", \"us-gaap:Assets\"],\n                    \"balance concept mismatch\")\n        if kind in (\"debt_components\", \"rounded_debt\"):\n            require([o[\"concept\"] for o in operands] == [\"us-gaap:LongTermDebtCurrent\", \"us-gaap:LongTermDebtNoncurrent\"],\n                    \"debt component concept mismatch\")\n    value = sum(Fraction(o[\"value_usd\"]) for o in operands)\n    target_value = Fraction(target[\"value_usd\"])\n    lhs_interval = interval_sum(operands)\n    rhs_interval = target[\"rounding_interval_usd\"]\n    rounding = compatible(lhs_interval, rhs_interval)\n    require(rounding, \"incompatible rounding intervals\")\n    if kind != \"rounded_debt\":\n        require(value == target_value, \"displayed arithmetic mismatch\")\n    return dict(id=bridge_id, kind=kind, operands=[o[\"id\"] for o in operands], target=target[\"id\"],\n                lhs_usd=str(value), rhs_usd=str(target_value), residual_usd=str(value-target_value),\n                lhs_interval_usd=list(map(str, lhs_interval)), rhs_interval_usd=rhs_interval,\n                displayed_identity=value == target_value, rounding_compatible=rounding,\n                status=\"pass\", transformations=transformations,\n                conclusion=\"displayed identity\" if kind != \"rounded_debt\" else \"rounding compatibility only\")\n\n\ndef html_text(raw):\n    soup = BeautifulSoup(raw, \"html.parser\")\n    for el in soup([\"script\", \"style\"]):\n        el.decompose()\n    return soup.get_text(\"\\n\", strip=True)\n\n\ndef load_sources():\n    for p, h in PINS.items():\n        require(file_hash(p) == h, \"source hash mismatch: \" + p)\n    annual = Document(\"annual\", APPLE+\"annual-2024.pdf\", APPLE+\"annual-2024.txt\", pdf=True)\n    interim = Document(\"interim\", APPLE+\"interim-2025q1.html\", APPLE+\"interim-2025q1.txt\")\n    extracted = subprocess.run([\"pdftotext\", \"-layout\", str(ROOT/annual.original), \"-\"],\n                               capture_output=True, check=True, timeout=30).stdout\n    require(sha(extracted) == annual.extraction_hash, \"PDF extraction does not reproduce retained text\")\n    require(html_text((ROOT/interim.original).read_text()) == interim.text, \"HTML extraction mismatch\")\n    register = json.loads((ROOT/REGISTER).read_text())\n    bindings = []\n    for d, name in [(annual, \"apple-2024-annual\"), (interim, \"apple-2025-q1\")]:\n        candidates = [r for r in register[\"records\"] if r[\"document_id\"] == name]\n        require(len(candidates) == 1, \"P01 source identity\")\n        r = candidates[0]\n        require(r[\"original_sha256\"] == d.original_hash == file_hash(r[\"original_path\"]), \"P01 original binding\")\n        require(r[\"extracted_sha256\"] == file_hash(r[\"extracted_path\"]), \"P01 extraction binding\")\n        bindings.append(dict(**d.binding(), p01_document=name, p01_original_path=r[\"original_path\"],\n                             p01_extraction_path=r[\"extracted_path\"], p01_extraction_sha256=r[\"extracted_sha256\"],\n                             extraction_relation=\"identical\" if r[\"extracted_sha256\"] == d.extraction_hash else\n                             \"distinct text versions; offsets must not transfer\",\n                             p01_publication_metadata=r[\"publication_metadata\"]))\n    acquisitions = json.loads((ROOT/NEW/\"acquisition.json\").read_text())\n    external_docs = {}\n    for rec in acquisitions[\"records\"]:\n","exit_code":0,"status":"completed"}}
