{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '642,785p' scripts/apple_case_v1.py\"","aggregated_output":"def walk_anchors(value):\n    if isinstance(value, dict):\n        if {\"start\", \"end\", \"quote\", \"offset_unit\"} <= value.keys():\n            yield value\n        for item in value.values():\n            yield from walk_anchors(item)\n    elif isinstance(value, list):\n        for item in value:\n            yield from walk_anchors(item)\n\n\ndef validate_anchors(value):\n    cache = {}\n    def read(path, digest):\n        resolved = (ROOT/path).resolve()\n        require(resolved.is_relative_to(ROOT), \"anchor outside repository\")\n        if path not in cache:\n            data = resolved.read_bytes()\n            cache[path] = (sha(data), None if path.endswith('.pdf') else data.decode('utf-8'))\n        require(cache[path][0] == digest, \"anchor source hash mismatch\")\n        return cache[path][1]\n    count = 0\n    for a in walk_anchors(value):\n        if \"original_path\" in a:\n            read(a[\"original_path\"], a[\"original_sha256\"])\n            text = read(a[\"extraction_path\"], a[\"extraction_sha256\"])\n        else:\n            text = read(a[\"path\"], a[\"sha256\"])\n        require(a[\"offset_unit\"] == \"Unicode code points\" and\n                0 <= a[\"start\"] < a[\"end\"] <= len(text) and\n                text[a[\"start\"]:a[\"end\"]] == a[\"quote\"], \"broken source quotation/offset\")\n        if \"pdf_page\" in a:\n            doc = Document(a[\"document\"], a[\"original_path\"], a[\"extraction_path\"], True)\n            require(doc.anchor(a[\"start\"], a[\"end\"]) == a, \"PDF page/anchor mismatch\")\n        count += 1\n    return count\n\n\ndef note_records(annual, interim, observations):\n    notes = discover_notes(annual, 13)+discover_notes(interim, 10)\n    raw_ranges = raw_note_ranges(interim)\n    inventory = json.loads((ROOT/APPLE/\"manifest.json\").read_text())[\"notes\"]\n    require([(n[\"id\"], n[\"title\"]) for n in notes] == [(n[\"id\"], n[\"title\"]) for n in inventory],\n            \"note inventory disagreement\")\n    for note in notes:\n        areas, interpretation, unknown = NOTE_MEANING[note[\"title\"]]\n        note.update(disposition=\"partially_mapped\" if note[\"number\"] in (1, 2, 4) else \"unresolved_meaning_retained\",\n                    affected_model_areas=areas, interpretation=interpretation,\n                    unresolved_meaning=unknown, semantic_completion=False, linked_quantities=[], linked_quantity_evidence=[],\n                    qualifications=\"The full bounded source passage is retained; only the stated interpretation is applied.\")\n        a = note[\"anchor\"]\n        for obs in observations:\n            for source in walk_anchors(obs[\"source_readings\"]):\n                if source.get(\"extraction_path\") == a[\"extraction_path\"] and a[\"start\"] <= source[\"start\"] < a[\"end\"]:\n                    note[\"linked_quantities\"].append(obs[\"id\"])\n                    note[\"linked_quantity_evidence\"].append(dict(observation=obs[\"id\"], method=\"extraction_anchor_containment\", source=source))\n                    break\n        # Inline facts use raw HTML offsets, which are distinct from the text\n        # extraction.  Membership is source containment, never an ID prefix.\n        if a[\"document\"] == \"interim\":\n            boundary = raw_ranges[note[\"number\"]]\n            note[\"raw_note_boundary\"] = boundary\n            for obs in observations:\n                for reading in obs[\"source_readings\"]:\n                    fact = reading.get(\"fact\") if isinstance(reading, dict) else None\n                    if fact and fact.get(\"path\") == interim.original and boundary[\"start\"] <= fact[\"start\"] < boundary[\"end\"]:\n                        note[\"linked_quantities\"].append(obs[\"id\"])\n                        note[\"linked_quantity_evidence\"].append(dict(observation=obs[\"id\"], method=\"raw_html_fact_containment\", source=fact))\n                        break\n        note[\"linked_quantities\"] = sorted(set(note[\"linked_quantities\"]))\n        note[\"linked_quantity_evidence\"] = sorted(note[\"linked_quantity_evidence\"], key=lambda x: x[\"observation\"])\n        if note[\"linked_quantities\"]:\n            note[\"disposition\"] = \"selected_quantities_mapped_with_unresolved_remainder\"\n        targets = sorted(set(int(n) for n in re.findall(r\"Note\\s+(\\d+)\", a[\"quote\"])))\n        note[\"cross_references\"] = [dict(target=f\"{a['document']}.note.{n}\",\n                                         relation=\"literal note reference\", status=\"source_present; meaning not necessarily executed\")\n                                    for n in targets if n != note[\"number\"]]\n        require(all(t[\"target\"] in {n[\"id\"] for n in notes} for t in note[\"cross_references\"]), \"unresolved internal note target\")\n    by_id = {n[\"id\"]: n for n in notes}\n    by_id[\"annual.note.9\"][\"cross_references\"].append(dict(target=\"annual.note.4\", relation=\"analyst link: debt and interest-rate swaps\", status=\"source_present\"))\n    by_id[\"interim.note.1\"][\"cross_references\"].append(dict(target=\"annual.note.1\", relation=\"explicit read-with-2024-10-K qualification\", status=\"source_present\"))\n    contingency = by_id[\"interim.note.9\"]\n    contingency[\"assertion\"] = dict(kind=\"reported_management_assessment\", speaker=\"Apple management\",\n        subject=\"asserted legal and other claims\", modal_operator=\"not at least a reasonable possibility\",\n        assessed_event=\"material loss, or material loss greater than a recorded accrual\",\n        unresolved_outcomes=True, probability=None, liability_amount=None,\n        anchor=interim.find(r\"The Company is subject to various legal proceedings.*?asserted legal and other claims\\.\",\n                            (contingency[\"anchor\"][\"start\"], contingency[\"anchor\"][\"end\"]), re.S))\n    return notes\n\n\ndef raw_note_ranges(doc):\n    \"\"\"Return raw HTML ranges for actual interim note headings.\"\"\"\n    raw = (ROOT/doc.original).read_text()\n    headings = list(re.finditer(r\">Note\\s+(\\d+)\\s+&#8211;\\s+<ix:nonNumeric\\b\", raw, re.I))\n    require([int(m[1]) for m in headings] == list(range(1, 11)),\n            \"missing, duplicate or reordered raw note headings\")\n    stop = re.search(r\"Item 2\\.(?:&#160;)+Management\", raw[headings[-1].end():])\n    require(stop is not None, \"raw final note boundary missing\")\n    final = headings[-1].end()+stop.start()\n    return {int(m[1]): dict(path=doc.original, sha256=doc.original_hash,\n                             start=m.start(), end=(headings[i+1].start() if i+1 < len(headings) else final),\n                             quote=raw[m.start():(headings[i+1].start() if i+1 < len(headings) else final)],\n                             offset_unit=\"Unicode code points\")\n            for i, m in enumerate(headings)}\n\n\ndef supported_excerpt(doc, pattern, bounds=None):\n    return doc.find(pattern, bounds, re.S)\n\n\ndef rendered_row_match(doc, label, occurrence=0, column=0):\n    \"\"\"Parse a row independently in a dated issuer statement table.\"\"\"\n    revenue = label == \"Total net sales\"\n    title = \"CONSOLIDATED STATEMENTS OF OPERATIONS\" if revenue else \"CONSOLIDATED BALANCE SHEETS\"\n    stop = \"CONSOLIDATED STATEMENTS OF COMPREHENSIVE INCOME\" if revenue else \"CONSOLIDATED STATEMENTS OF SHAREHOLDERS\"\n    start = doc.text.find(title)\n    end = doc.text.find(stop, start + len(title))\n    require(start >= 0 and end > start, \"issuer statement boundary missing\")\n    section = doc.text[start:end]\n    require(\"In millions\" in section, \"issuer statement scale missing\")\n    dates = re.findall(r\"(September \\d+,)\\s*(20\\d{2})\", section)\n    expected = [(\"September 28,\", \"2024\"), (\"September 30,\", \"2023\")]\n    if revenue:\n        expected.append((\"September 24,\", \"2022\"))\n    require(dates[:len(expected)] == expected and 0 <= column < len(expected), \"issuer period/column mismatch\")\n    lines = list(re.finditer(r\"[^\\n]+\", section))\n    rows = [i for i, line in enumerate(lines) if line[0] == label]\n    require(len(rows) == (2 if label == \"Term debt\" else 1), \"ambiguous issuer row\")\n    require(0 <= occurrence < len(rows), \"issuer row occurrence\")\n    values = []\n    j = rows[occurrence] + 1\n    while j < len(lines) and len(values) < len(expected):\n        literal = lines[j][0]\n        if literal != \"$\":\n            number(literal)\n            values.append(lines[j])\n        j += 1\n    require(len(values) == len(expected), \"issuer table column count\")\n    cell = values[column]\n    return doc.anchor(start + cell.start(), start + cell.end()), cell[0]\n\n\ndef policy_records(annual, interim, notes):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '802,963p' scripts/apple_case_v1.py\"","aggregated_output":"def filing_records():\n    raw = json.loads((ROOT/INDEX).read_text())[\"filings\"][\"recent\"]\n    out = []\n    for identity, accession in [(\"annual\", \"0000320193-24-000123\"),\n                                (\"interim\", \"0000320193-25-000008\"),\n                                (\"proxy\", \"0001308179-25-000008\")]:\n        require(raw[\"accessionNumber\"].count(accession) == 1, \"filing identity missing/ambiguous\")\n        i = raw[\"accessionNumber\"].index(accession)\n        out.append(dict(id=identity, accession=accession, form=raw[\"form\"][i], report_date=raw[\"reportDate\"][i],\n                        filing_date=raw[\"filingDate\"][i], acceptance_timestamp=raw[\"acceptanceDateTime\"][i],\n                        primary_document=raw[\"primaryDocument\"][i], index_path=INDEX, index_sha256=file_hash(INDEX),\n                        json_pointer=f\"/filings/recent/accessionNumber/{i}\",\n                        public_dissemination_timestamp=None, retained_byte_publication_date=None,\n                        qualification=\"Acceptance is index metadata, not independently verified public dissemination or retained-byte vintage.\"))\n    return out\n\n\ndef availability(record, cutoff, scope=\"filing_identity\"):\n    \"\"\"Date-resolution query; unknown byte vintage never inherits a filing date.\"\"\"\n    cutoff = date.fromisoformat(cutoff)\n    require(scope in (\"filing_identity\", \"retained_bytes\"), \"unsupported availability scope\")\n    day = record.get(\"filing_date\" if scope == \"filing_identity\" else \"retained_byte_publication_date\")\n    return \"unknown\" if day is None else (\"available_by_filing_day\" if date.fromisoformat(day) <= cutoff else \"later\")\n\n\ndef version_view(records, cutoff, scope=\"retained_bytes\"):\n    require(len({r[\"id\"] for r in records}) == len(records), \"duplicate version identity\")\n    decisions = [{\"id\": r[\"id\"], \"availability\": availability(r, cutoff, scope)} for r in records]\n    eligible = [d[\"id\"] for d in decisions if d[\"availability\"] == \"available_by_filing_day\"]\n    return dict(versions=decisions, eligible=eligible,\n                resolution=\"retain_all_no_automatic_supersession\", conflict_resolution=\"unsupported\")\n\n\ndef exhibit_records(annual, official, interim):\n    \"\"\"Read exhibit target/version columns; distinguish a link from its contents.\"\"\"\n    result = []\n    for doc, prefix in [(official, \"annual\"), (interim, \"interim\")]:\n        soup = BeautifulSoup((ROOT/doc.original).read_text(), \"html.parser\")\n        for tr in soup.find_all(\"tr\"):\n            cells = [c.get_text(\" \", strip=True) for c in tr.find_all(\"td\", recursive=False)]\n            cells = [c for c in cells if c]\n            if len(cells) < 2 or not re.fullmatch(r\"(?:\\d+\\.\\d+|101|104)[*, ]*\", cells[0]):\n                continue\n            # Exclude financial rows and identify only the exhibit-index description cells.\n            if not tr.find(\"a\", href=True) and \"**\" not in cells[0]:\n                continue\n            number = re.match(r\"\\d+(?:\\.\\d+)?\", cells[0])[0]\n            row_text = tr.get_text(\"\\n\", strip=True)\n            anchor = doc.find(re.escape(row_text))\n            links = [a[\"href\"] for a in tr.find_all(\"a\", href=True)]\n            internal = [u for u in links if u.startswith(\"#\")]\n            external = [u for u in links if u.startswith(\"http\")]\n            record = dict(id=f\"{prefix}.exhibit.{number}\", number=number, description=cells[1],\n                          filed_marker=cells[0], source=anchor, target_links=links,\n                          referenced_form=cells[2] if len(cells) >= 5 else None,\n                          referenced_exhibit=cells[3] if len(cells) >= 5 else None,\n                          referenced_date_or_period=cells[4] if len(cells) >= 5 else None,\n                          contents_status=\"unresolved\", missing_terms=\"Full substantive interpretation and applicability to current contracts.\",\n                          consequence=\"No complete incorporated-package or contract-history claim.\",\n                          next_route=\"Use the exact SEC accession in the link or the issuer filing feed for the stated form and date.\")\n            if internal:\n                missing_internal = [u for u in internal\n                                    if soup.find(id=u[1:]) is None and\n                                    soup.find(attrs={\"name\": u[1:]}) is None]\n                if missing_internal:\n                    # A malformed or stale anchor is itself evidence about\n                    # package closure.  Preserve it as an unresolved filing\n                    # obligation instead of silently treating the link as\n                    # resolved or aborting the whole bounded case build.\n                    record[\"contents_status\"] = \"internal_target_missing_in_retained_html\"\n                    record[\"missing_internal_targets\"] = missing_internal\n                    record[\"missing_terms\"] = \"Retained issuer HTML exposes an internal link whose target is absent; substantive exhibit contents remain unverified.\"\n                else:\n                    record[\"contents_status\"] = \"within_retained_issuer_html; semantics_unresolved\"\n            if external:\n                record[\"contents_status\"] = \"external_target_not_acquired\"\n            if number in (\"101\", \"104\"):\n                record[\"contents_status\"] = \"inline_facts_present; complete_taxonomy_package_not_acquired\"\n                record[\"missing_terms\"] = \"Separate taxonomy/linkbase files and complete package validation.\"\n            if prefix == \"annual\":\n                # Bind each issuer index row independently to the mirrored PDF index.\n                lo, hi = annual.page(53)[0], annual.page(56)[1]\n                record[\"pdf_index_row\"] = annual.find(r\"^[ \\t]*\"+re.escape(number)+r\"(?=[* \\t])[^\\n]+\", (lo, hi), re.M)\n            result.append(record)\n    require(len({r[\"id\"] for r in result}) == len(result), \"duplicate exhibit rows\")\n    return result\n\n\ndef external_records(annual, interim, docs):\n    proxy, reg, official = [docs[k] for k in (\"proxy-2025\", \"registration-2021\", \"annual-2024-official\")]\n    exhibits = exhibit_records(annual, official, interim)\n    obligations = []\n    proxy_patterns = {\n        10: r\"Board Independence\\nApple’s Corporate Governance Guidelines.*?applicable rules of The Nasdaq Stock Market LLC.*?\\(“Nasdaq”\\)\\.\",\n        11: r\"Compensation Discussion and Analysis\\nThis Compensation.*?paid to our named executive officers\\.\",\n        12: r\"Security\\nOwnership of Certain Beneficial Owners and Management\\nThe\\nfollowing table.*?\\(the “Table Date”\\)\",\n        13: r\"Related Party Policy and Transactions\\nThe Board has.*?\\$120,000 in a single fiscal year\",\n        14: r\"Audit Fees\\n\\(1\\).*?Total\\n30,270,822\\n25,403,329\",\n    }\n    lo, hi = annual.page(52)\n    for item, pat in proxy_patterns.items():\n        start = annual.find(r\"Item \"+str(item)+r\"\\.[^\\n]+\", (lo, hi))[\"start\"]\n        stop = annual.text.find(\"Item \"+str(item+1)+\".\", start, hi) if item < 14 else hi\n        obligations.append(dict(id=f\"annual.partIII.item{item}\", target=\"2025 proxy, accession 0001308179-25-000008\",\n                                incorporation=annual.anchor(start, stop), support=proxy.find(pat, flags=re.S),\n                                status=\"target_acquired_selected_passage_inspected\",\n                                unresolved=\"Complete item-level semantics, exceptions and references beyond the selected passage remain unmodelled.\",\n                                consequence=\"Proxy information cannot be backdated to the annual filing.\",\n                                next_route=\"Inspect remaining sections in the retained proxy and its exact incorporated targets.\"))\n    title = reg.find(r\"Exhibit 4\\.1\\nApple Inc\\..*?Dated as of October\\s+28, 2021\", flags=re.S)\n    terms = reg.find(r\"Section\\s+301\\.\\nAmount\\nUnlimited; Issuable in Series.*?Section\\s+302\\.\", flags=re.S)\n    # Select the substantive Section 501 in Exhibit 4.1.  The same phrase\n    # occurs in a prospectus summary and in the table of contents; the section\n    # heading and Section 502 terminator bind the operative text.\n    defaults = reg.find(r\"Section\\s+501\\.\\nEvents of\\nDefault\\n\\..*?(?=Section\\s+502\\.\\nAcceleration of Maturity; Rescission and Annulment\\n\\.)\",\n                        (title[\"end\"], len(reg.text)), flags=re.S)\n    for e in exhibits:\n        if e[\"id\"] == \"annual.exhibit.4.26\":\n            e.update(contents_status=\"acquired_in_registration_2021; selected_sections_inspected\", acquired_support=title,\n                     section_301=terms, section_501=defaults,\n                     missing_terms=\"Series-specific officer certificates, outstanding balances, amendments and swap confirmations/allocation.\")\n    # Keep the exhibit-index row separate from the substantive Exhibit 4.1\n    # contents retained after the annual-report signatures.\n    securities_index = annual.find(r\"(?m)^[ \\t]*4\\.1[^\\n]*Description of Securities of the Registrant\\.\")\n    securities = annual.find(r\"Exhibit 4\\.1\\s+DESCRIPTION OF THE REGISTRANT’S SECURITIES.*?(?=Exhibit 10\\.1)\", flags=re.S)\n    obligations.append(dict(id=\"annual.exhibit.4.1.in_pdf\", target=\"Description of Securities, filed exhibit 4.1\",\n                            support=securities, index_support=securities_index, status=\"heading_and_contents_retained_in_pdf\",\n                            unresolved=\"Description is not the complete incorporated indentures and series certificates.\",\n                            consequence=\"General descriptions do not identify all current debt terms.\",\n                            next_route=\"Inspect specific 4.2–4.28 index targets for contract reconstruction.\"))\n    omissions = annual.find(r\"Certain instruments defining the rights of holders.*?copies of any such instruments\\.\", annual.page(56), re.S)\n    obligations.append(dict(id=\"omitted_debt_instruments\", target=\"Instruments omitted under Item 601(b)(4)(iii)\", support=omissions,\n                            status=\"expressly_omitted_from_filing\", unresolved=\"Instrument identities and complete terms not specified by this index.\",\n                            consequence=\"No complete debt-contract inventory is established.\",\n                            next_route=\"Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach.\"))\n    return dict(partIII_and_package_obligations=obligations, exhibit_inventory=exhibits,\n                agreement_interpretation=dict(status=\"selected_contract_sections_only\", support=[title, terms, defaults],\n                    interpretation=\"Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.\",\n                    missing=\"2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule.\"))\n\n\ndef unidentified_records(notes):\n    n = {r[\"id\"]: r for r in notes}\n    specs = [\n        (\"debt_and_swaps\", [\"annual.note.9\", \"annual.note.4\", \"interim.note.6\", \"interim.note.4\"],\n         \"Annual interest-rate notional and interim notional are disclosed but contract allocation, resets, hedge coverage and net economic exposure remain unidentified.\",\n         \"Obtain series certificates and public hedge terms; never equate derivative notional with floating-rate debt exposure.\"),\n        (\"debt_movements\", [\"annual.note.9\", \"interim.note.6\"],\n         \"Carrying differences cannot be identified solely from cash issuance/repayment; FX and noncash measurement changes remain separate unknowns.\",\n         \"Reconstruct movements only with sourced FX, hedge, discount and noncash adjustments.\"),\n        (\"asset_cohorts\", [\"annual.note.5\", \"interim.note.5\"],\n         \"Gross/net balances do not identify vintages, remaining useful lives, additions and retirements.\",\n         \"Retain alternative cohort histories until transaction or asset-register evidence supports a narrower family.\"),\n        (\"contingent_outcomes\", [\"annual.note.12\", \"interim.note.9\"],\n         \"Management's loss assessment and commitment amounts do not provide a loss probability measure or a zero liability.\",\n         \"Maintain unresolved outcomes and revisit dated legal disclosures; do not assign equal or confidence-derived probabilities.\"),\n    ]\n    return [dict(id=key, supports=[n[k][\"anchor\"] for k in ids], unresolved=meaning, next_action=action,\n                 status=\"not_identified\", probability=None) for key, ids, meaning, action in specs]\n\n\ndef build_case():\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '436,545p' scripts/apple_case_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '436,545p' scripts/apple_case_v1.py\"","aggregated_output":"def collect_observations(annual, interim):\n    observations, bridges = [], []\n    def put(o):\n        require(o[\"id\"] not in {x[\"id\"] for x in observations}, \"duplicate observation id\")\n        observations.append(o)\n        return o\n    def bridge(name, kind, operands, target, **kw):\n        bridges.append(reconcile(name, kind, operands, target, **kw))\n    def scope(page, start=None, end=None):\n        lo, hi = annual.page(page)\n        if start:\n            lo = annual.find(re.escape(start), (lo, hi))[\"start\"]\n        if end:\n            stop = annual.text.find(end, lo, hi)\n            require(stop >= 0, \"scope terminator missing\")\n            hi = stop\n        return lo, hi\n    def arow(label, col, ctx, concept, measure, bounds, cols, oid, partition=None):\n        # Include the table's actual date headings and declared presentation scale.\n        yr = annual.find(r\"^[ \\t]*2024[ \\t]+2023(?:[ \\t]+2022)?[ \\t]*$\", bounds, re.M)\n        header = annual.anchor(bounds[0], yr[\"end\"])\n        return put(annual_row(annual, label, col, ctx, concept, measure, bounds, cols, header, oid, partition))\n    a_bs = {}\n    for col, day in enumerate([\"2024-09-28\", \"2023-09-30\"]):\n        ctx = context(dict(instant=day))\n        rows = {}\n        for key, label, concept in [\n            (\"assets\", \"Total assets\", \"us-gaap:Assets\"),\n            (\"liabilities\", \"Total liabilities\", \"us-gaap:Liabilities\"),\n            (\"equity\", \"Total shareholders’ equity\", \"us-gaap:StockholdersEquity\"),\n            (\"cash\", \"Cash and cash equivalents\", \"us-gaap:CashAndCashEquivalentsAtCarryingValue\"),\n            (\"ppe\", \"Property, plant and equipment, net\", \"us-gaap:PropertyPlantAndEquipmentNet\")]:\n            measure = \"cash_excluding_restricted\" if key == \"cash\" else \"carrying_amount\"\n            rows[key] = arow(label, col, ctx, concept, measure, scope(31), 2, f\"annual.bs.{day}.{key}\")\n        for key, start, end, concept in [\n            (\"debt_current\", \"Current liabilities:\", \"Non-current liabilities:\", \"us-gaap:LongTermDebtCurrent\"),\n            (\"debt_noncurrent\", \"Non-current liabilities:\", \"Commitments and contingencies\", \"us-gaap:LongTermDebtNoncurrent\")]:\n            bounds = scope(31, start, end)\n            header = annual.anchor(annual.page(31)[0], annual.page(31)[0]+450)\n            rows[key] = put(annual_row(annual, \"Term debt\", col, ctx, concept, \"carrying_amount\", bounds, 2,\n                                      header, f\"annual.bs.{day}.{key}\"))\n        bridge(f\"annual.balance.{day}\", \"balance\", [rows[\"liabilities\"], rows[\"equity\"]], rows[\"assets\"])\n        a_bs[day] = rows\n        debt_bounds = scope(43, \"Term Debt\", \"To manage interest rate risk\")\n        d = {}\n        for key, label, measurement in [\n            (\"principal\", \"Total term debt principal\", \"principal\"),\n            (\"discount\", \"Unamortized premium/(discount) and issuance costs, net\", \"carrying_adjustment\"),\n            (\"hedge\", \"Hedge accounting fair value adjustments\", \"carrying_adjustment\"),\n            (\"carrying\", \"Total term debt\", \"carrying_amount\")]:\n            d[key] = arow(label, col, ctx, \"apple:Debt\"+key.title(), measurement, debt_bounds, 2,\n                          f\"annual.debt.{day}.{key}\")\n        bridge(f\"annual.principal_to_carrying.{day}\", \"principal_to_carrying\", [d[k] for k in [\"principal\", \"discount\", \"hedge\"]], d[\"carrying\"])\n        bridge(f\"annual.debt_components.{day}\", \"debt_components\", [rows[\"debt_current\"], rows[\"debt_noncurrent\"]], d[\"carrying\"])\n        p = {}\n        for key, label, measure in [(\"gross\", \"Gross property, plant and equipment\", \"gross_cost\"),\n                                    (\"depreciation\", \"Accumulated depreciation\", \"accumulated_depreciation\"),\n                                    (\"net\", \"Total property, plant and equipment, net\", \"carrying_amount\")]:\n            p[key] = arow(label, col, ctx, \"apple:PPE\"+key.title(), measure,\n                          scope(39, \"Note 5\", \"Note 6\"), 2, f\"annual.ppe.{day}.{key}\")\n        bridge(f\"annual.ppe.{day}\", \"ppe\", [p[\"gross\"], p[\"depreciation\"]], p[\"net\"])\n        bridge(f\"annual.ppe_statement.{day}\", \"equality\", [p[\"net\"]], rows[\"ppe\"])\n    # Years and week lengths are read from the actual Note 1 calendar paragraph.\n    calendar = annual.find(r\"The Company’s fiscal year is the 52- or 53-week period.*?associated quarters, months and periods of those fiscal years\\.\",\n                           scope(34), re.S)\n    m = re.search(r\"years (\\d{4}) and (\\d{4}) spanned (\\d+) weeks each, whereas fiscal year (\\d{4}) spanned (\\d+) weeks\", calendar[\"quote\"])\n    require(m is not None, \"fiscal week lengths missing\")\n    weeks = {m[1]: int(m[3]), m[2]: int(m[3]), m[4]: int(m[5])}\n    # The dates are bound to the split-line date header on printed page 33.\n    for col, day in enumerate([\"2024-09-28\", \"2023-09-30\", \"2022-09-24\"]):\n        end = date.fromisoformat(day)\n        require(end.strftime(\"%B\")+\" \"+str(end.day)+\",\" in annual.text[slice(*annual.page(33))], \"annual end header missing\")\n        start = end+timedelta(days=1-weeks[str(end.year)]*7)\n        per = dict(start=start.isoformat(), end=day)\n        ctx = context(per)\n        rev = arow(\"Total net sales\", col, ctx, REV, \"net_revenue\", scope(29), 3, f\"annual.revenue.{end.year}\")\n        for partition, members in [(\"product\", PRODUCTS), (\"segment\", SEGMENTS)]:\n            parts = []\n            for i, member in enumerate(members):\n                dims = {\"srt:ProductOrServiceAxis\": PRODUCT_MEMBERS[i]} if partition == \"product\" else {\"us-gaap:StatementBusinessSegmentsAxis\": SEGMENT_MEMBERS[i]}\n                bounds = scope(35) if partition == \"product\" else scope(47, member+\":\", \"Operating income\")\n                label = \"Services (1)\" if member == \"Services\" else member\n                if partition == \"segment\":\n                    o = put(annual_row(annual, \"Net sales\", col, context(per, dims), REV, \"net_revenue\", bounds, 3,\n                                      annual.anchor(annual.page(47)[0], scope(47, \"Americas:\")[0]), f\"annual.{partition}.{end.year}.{i}\", partition))\n                else:\n                    o = arow(label, col, context(per, dims), REV, \"net_revenue\", bounds, 3,\n                              f\"annual.{partition}.{end.year}.{i}\", partition)\n                o[\"member_label\"] = member\n                parts.append(o)\n            bridge(f\"annual.revenue_{partition}.{end.year}\", \"partition\", parts, rev, partition=partition)\n        flows = []\n        opening = arow(\"Cash, cash equivalents, and restricted cash and cash equivalents, beginning balances\", col,\n                       context(dict(instant=(start-timedelta(days=1)).isoformat())), CF_BAL, \"cash_including_restricted\",\n                       scope(33), 3, f\"annual.cf.{end.year}.opening\")\n        for key, label in [(\"operating\", \"Cash generated by operating activities\"),\n                            (\"investing\", \"Cash generated by/(used in) investing activities\"),\n                            (\"financing\", \"Cash used in financing activities\")]:\n            flows.append(arow(label, col, ctx, \"us-gaap:NetCashProvidedByUsedIn\"+key.title()+\"Activities\", \"cash_flow\",\n                              scope(33), 3, f\"annual.cf.{end.year}.{key}\"))\n        closing = arow(\"Cash, cash equivalents, and restricted cash and cash equivalents, ending balances\", col,\n                       context(dict(instant=day)), CF_BAL, \"cash_including_restricted\", scope(33), 3,\n                       f\"annual.cf.{end.year}.closing\")\n        bridge(f\"annual.cash_flow.{end.year}\", \"cash_flow\", [opening]+flows, closing)\n    # The annual notional is retained as notional, never recast as debt exposure.\n    bounds = scope(38, \"The notional amounts\", \"The carrying amounts\")\n    notional = arow(\"Interest rate contracts\", 0, context(dict(instant=\"2024-09-28\"), {\n        \"us-gaap:DerivativeInstrumentRiskAxis\": \"us-gaap:InterestRateContractMember\",\n        \"us-gaap:HedgingDesignationAxis\": \"us-gaap:DesignatedAsHedgingInstrumentMember\"}),\n        \"us-gaap:DerivativeNotionalAmount\", \"derivative_notional\", bounds, 2, \"annual.notional.2024\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '963,1054p' scripts/apple_case_v1.py && sed -n '135,170p' scripts/apple_case_v1.py && sed -n '326,355p' scripts/apple_case_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '963,1054p' scripts/apple_case_v1.py && sed -n '135,170p' scripts/apple_case_v1.py && sed -n '326,355p' scripts/apple_case_v1.py\"","aggregated_output":"def build_case():\n    annual, interim, docs, bindings, acquisitions = load_sources()\n    observations, bridges, calendar = collect_observations(annual, interim)\n    notes = note_records(annual, interim, observations)\n    # A selected-table check relates representations, not whole-document\n    # publication vintage.  The issuer-linked HTML is rendered filing text,\n    # so bind visible label/value rows instead of treating it as a second\n    # inline-XBRL instance.  The accounting observations remain sourced from\n    # the retained annual/interim documents above.\n    rendered_specs = [\n        (\"annual.bs.2024-09-28.assets\", \"Total assets\", 0),\n        (\"annual.bs.2024-09-28.liabilities\", \"Total liabilities\", 0),\n        (\"annual.bs.2024-09-28.equity\", \"Total shareholders’ equity\", 0),\n        (\"annual.bs.2024-09-28.debt_current\", \"Term debt\", 0),\n        (\"annual.bs.2024-09-28.debt_noncurrent\", \"Term debt\", 1),\n        (\"annual.revenue.2024\", \"Total net sales\", 0),\n    ]\n    rendered_checks = []\n    for oid, label, occurrence in rendered_specs:\n        annual_observation = next(o for o in observations if o[\"id\"] == oid)\n        source, literal = rendered_row_match(docs[\"annual-2024-official\"], label, occurrence)\n        source_value = number(literal)*MILLION\n        require(source_value == Fraction(annual_observation[\"value_usd\"]),\n                \"issuer/annual selected value mismatch: \" + oid)\n        rendered_checks.append(dict(\n            id=\"issuer_html.\" + oid,\n            annual_observation=oid,\n            label=label,\n            displayed_literal=literal,\n            source=source,\n            status=\"independently_parsed_visible_value_agreement\",\n            interpretation=\"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\",\n            source_value_usd=str(source_value),\n        ))\n    matched = [x[\"annual_observation\"] for x in rendered_checks]\n    policy = policy_records(annual, interim, notes)\n    external = external_records(annual, interim, docs)\n    records = filing_records()\n    out = dict(schema_version=\"accdsl.apple_case.v1\", plan_sha256=PLAN_HASH,\n        scope=\"Retained Apple FY2024 annual, FY2025 Q1 interim and disclosed comparatives; selected numerical bridges only.\",\n        source_bindings=bindings, source_pins=PINS, p01_register=dict(path=REGISTER, sha256=file_hash(REGISTER)),\n        source_acquisition=acquisitions, fiscal_calendar=calendar, policies=policy,\n        observations=observations, notes=notes, reconciliations=bridges, external=external,\n        filing_availability=records, unidentified_histories=unidentified_records(notes),\n        rounding_model=dict(arithmetic=\"exact rational USD\", model=\"closed half-unit nearest-rounding intervals\",\n                            issuer_tie_rule=\"unknown\", inference=\"compatibility only; no distribution or identified underlying exact amounts\"),\n        representation_comparison=dict(matched_observations=matched, rendered_row_checks=rendered_checks,\n                                       whole_document_equivalence=False, mirror_publication_date=None,\n                                       historical_byte_vintage=\"not established\"),\n        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n        mapping_contract=dict(kind=\"explicit case annotations\", context_source=\"Report policies, table headings and original inline contexts\",\n            annual_dates=\"Fiscal year-end table headings plus Note 1 week lengths; duration starts are derived, not calendar-year substitutions.\",\n            partitions=\"Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.\",\n            measurements=\"Debt principal, carrying amount, fair value and derivative notional remain distinct.\",\n            supported_transformations=\"Only the recorded partition aggregation, gross/net signed addition, comparative equality and dated cash movement bridges.\"),\n        acceptance=dict(specified_behavior=\"reviewed P02 plan\", implemented=\"bounded reusable source/context/reconciliation adapter\",\n                        tested_invariants=\"see result.md for executed tests\", accounting_validity=\"selected displayed identities only; no compliance determination\",\n                        empirical_forecast_validity=\"not evaluated; no forecast generated\", human_acceptance=\"pending\"))\n    out[\"anchor_count\"] = validate_anchors(out)\n    return out\n\n\ndef validate_case(candidate):\n    \"\"\"Rebuild from independently pinned sources, rejecting supplied metadata edits.\"\"\"\n    validate_anchors(candidate)\n    expected = build_case()\n    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n    return {\"status\": \"pass\", \"observations\": len(expected[\"observations\"]),\n            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n            \"anchors\": expected[\"anchor_count\"]}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--output-dir\", default=\"data/accounting-master/deliverables/P02\")\n    parser.add_argument(\"--check\", action=\"store_true\", help=\"read-only rebuild and comparison\")\n    args = parser.parse_args()\n    target = ROOT / args.output_dir / \"case.json\"\n    if args.check:\n        report = validate_case(json.loads(target.read_text()))\n    else:\n        case = build_case()\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(case, ensure_ascii=False, indent=2, sort_keys=True)+\"\\n\")\n        report = dict(status=\"built\", **case[\"coverage\"])\n    print(json.dumps(report, sort_keys=True))\n\n\nif __name__ == \"__main__\":\n    main()\n            offset += len(page)+1\n        raise CaseError(\"printed page missing\")\n\n    def binding(self):\n        return dict(id=self.identity, original_path=self.original, original_sha256=self.original_hash,\n                    extraction_path=self.extraction, extraction_sha256=self.extraction_hash)\n\n\ndef discover_notes(doc, expected):\n    matches = list(re.finditer(r\"(?m)^[\\f \\t]*Note (\\d+)\\s*[–-]\\s*([^\\n]+)\", doc.text))\n    require([int(m[1]) for m in matches] == list(range(1, expected+1)), \"missing, duplicate or reordered notes\")\n    marker = \"Report of Independent Registered\" if doc.pdf else \"Item 2.\"\n    out = []\n    for i, m in enumerate(matches):\n        end = matches[i+1].start() if i+1 < len(matches) else doc.text.find(marker, m.end())\n        require(end > m.end(), \"final note boundary missing\")\n        start = m.start() + len(m[0])-len(m[0].lstrip())\n        out.append(dict(id=f\"{doc.identity}.note.{m[1]}\", number=int(m[1]), title=m[2].strip(),\n                        anchor=doc.anchor(start, end), heading=doc.anchor(start, m.end())))\n    return out\n\n\ndef context(period, dimensions=None):\n    return dict(entity=ENTITY, entity_scheme=\"http://www.sec.gov/CIK\", perimeter=\"consolidated\",\n                basis=\"US GAAP\", currency=\"USD\", period=period, dimensions=dimensions or {})\n\n\ndef observation(oid, concept, value, literal, scale, quantum, ctx, measurement, anchors, **extra):\n    out = dict(id=oid, concept=concept, displayed_literal=literal, scale=scale,\n               value_usd=str(value), presentation_quantum_usd=str(quantum), context=ctx,\n               measurement=measurement, rounding_interval_usd=interval(value, quantum),\n               source_readings=anchors, status=\"extracted_reading\", **extra)\n    return out\n\n\ndef annual_row(doc, label, column, ctx, concept, measurement, bounds, columns,\ndef reconcile(bridge_id, kind, operands, target, partition=None):\n    all_obs = operands+[target]\n    for obs in all_obs:\n        validate_value(obs)\n    transformations = []\n    if kind == \"cash_flow\":\n        require(len(operands) == 4, \"cash flow operands\")\n        opening, *flows = operands\n        require(opening[\"measurement\"] == target[\"measurement\"] == \"cash_including_restricted\", \"cash perimeter mismatch\")\n        require(all(o[\"measurement\"] == \"cash_flow\" for o in flows), \"cash movement type\")\n        same_context(all_obs, (\"period\",))\n        per = flows[0][\"context\"][\"period\"]\n        require(all(x[\"context\"][\"period\"] == per for x in flows), \"flow period mismatch\")\n        require(opening[\"context\"][\"period\"] == {\"instant\": (date.fromisoformat(per[\"start\"])-timedelta(days=1)).isoformat()} and\n                target[\"context\"][\"period\"] == {\"instant\": per[\"end\"]}, \"stock/flow date mismatch\")\n        transformations.append(\"Opening instant is the day before the disclosed flow period; closing instant is its end. Cash includes restricted cash on both sides.\")\n    elif kind == \"partition\":\n        same_context(all_obs, (\"dimensions\",))\n        require(partition in (\"product\", \"segment\"), \"unknown partition\")\n        expected = PRODUCTS if partition == \"product\" else SEGMENTS\n        require([o.get(\"partition\") for o in operands] == [partition]*len(expected), \"overlapping or wrong partitions\")\n        require([o.get(\"member_label\") for o in operands] == expected, \"duplicate/missing partition member\")\n        require(all(o[\"measurement\"] == \"net_revenue\" for o in all_obs) and not target[\"context\"][\"dimensions\"], \"revenue target\")\n        require(len({json.dumps(o[\"context\"][\"dimensions\"], sort_keys=True) for o in operands}) == len(expected), \"duplicate dimension members\")\n        axis, members = ((\"srt:ProductOrServiceAxis\", PRODUCT_MEMBERS) if partition == \"product\" else\n                         (\"us-gaap:StatementBusinessSegmentsAxis\", SEGMENT_MEMBERS))\n        require([o[\"context\"][\"dimensions\"] for o in operands] == [{axis: m} for m in members] and\n                all(o[\"concept\"] == REV for o in all_obs), \"partition axis/member/concept mismatch\")\n        transformations.append(\"Sum one disclosed exhaustive table partition; product and geography are separate classifications of the same revenue.\")\n    else:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '545,608p' scripts/apple_case_v1.py && sed -n '1010,1038p' scripts/apple_case_v1.py && sed -n '414,436p' scripts/apple_case_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '545,608p' scripts/apple_case_v1.py && sed -n '1010,1038p' scripts/apple_case_v1.py && sed -n '414,436p' scripts/apple_case_v1.py\"","aggregated_output":"        \"us-gaap:DerivativeNotionalAmount\", \"derivative_notional\", bounds, 2, \"annual.notional.2024\")\n    reader = InlineReader(interim)\n    def iread(concept, ctx, measurement, oid, **kw):\n        return put(reader.select(concept, ctx, measurement, oid, **kw))\n    for day in [\"2024-12-28\", \"2024-09-28\"]:\n        ctx = context(dict(instant=day))\n        rows = {}\n        for key, concept, label in [\n            (\"assets\", \"us-gaap:Assets\", \"Total assets\"),\n            (\"liabilities\", \"us-gaap:Liabilities\", \"Total liabilities\"),\n            (\"equity\", \"us-gaap:StockholdersEquity\", \"Total shareholders’ equity\"),\n            (\"debt_current\", \"us-gaap:LongTermDebtCurrent\", \"Term debt\"),\n            (\"debt_noncurrent\", \"us-gaap:LongTermDebtNoncurrent\", \"Term debt\")]:\n            rows[key] = iread(concept, ctx, \"carrying_amount\", f\"interim.bs.{day}.{key}\", label=label)\n        bridge(f\"interim.balance.{day}\", \"balance\", [rows[\"liabilities\"], rows[\"equity\"]], rows[\"assets\"])\n        rounded = iread(\"us-gaap:LongTermDebt\", ctx, \"carrying_amount\", f\"interim.debt.{day}.rounded\", scale=9, decimals=-8)\n        bridge(f\"interim.rounded_debt.{day}\", \"rounded_debt\", [rows[\"debt_current\"], rows[\"debt_noncurrent\"]], rounded)\n        iread(\"us-gaap:LongTermDebtFairValue\", context(dict(instant=day), {\"us-gaap:FairValueByFairValueHierarchyLevelAxis\": \"us-gaap:FairValueInputsLevel2Member\"}),\n              \"fair_value\", f\"interim.debt.{day}.fair_value\", scale=9, decimals=-8)\n        iread(\"us-gaap:DerivativeNotionalAmount\", context(dict(instant=day), notional[\"context\"][\"dimensions\"]),\n              \"derivative_notional\", f\"interim.notional.{day}\", label=\"Interest rate contracts\")\n        if day in a_bs:\n            for key in rows:\n                bridge(f\"annual_interim_comparative.{key}\", \"equality\", [rows[key]], a_bs[day][key])\n    for start, end in [(\"2024-09-29\", \"2024-12-28\"), (\"2023-10-01\", \"2023-12-30\")]:\n        ctx = context(dict(start=start, end=end))\n        rev = iread(REV, ctx, \"net_revenue\", \"interim.revenue.\"+end, label=\"Total net sales\")\n        for partition, members, dimnames, axis in [\n            (\"product\", PRODUCTS, PRODUCT_MEMBERS, \"srt:ProductOrServiceAxis\"),\n            (\"segment\", SEGMENTS, SEGMENT_MEMBERS, \"us-gaap:StatementBusinessSegmentsAxis\")]:\n            parts = []\n            for i, (member, dim) in enumerate(zip(members, dimnames)):\n                o = iread(REV, context(ctx[\"period\"], {axis: dim}), \"net_revenue\", f\"interim.{partition}.{end}.{i}\",\n                          partition=partition, label=member if partition == \"product\" else \"Net sales\")\n                o[\"member_label\"] = member\n                parts.append(o)\n            bridge(f\"interim.revenue_{partition}.{end}\", \"partition\", parts, rev, partition=partition)\n        opening = iread(CF_BAL, context(dict(instant=(date.fromisoformat(start)-timedelta(days=1)).isoformat())),\n                        \"cash_including_restricted\", \"interim.cf.\"+end+\".opening\", label=\"beginning balances\")\n        flows = [iread(\"us-gaap:NetCashProvidedByUsedIn\"+kind+\"Activities\", ctx, \"cash_flow\", f\"interim.cf.{end}.{kind.lower()}\")\n                 for kind in [\"Operating\", \"Investing\", \"Financing\"]]\n        closing = iread(CF_BAL, context(dict(instant=end)), \"cash_including_restricted\", \"interim.cf.\"+end+\".closing\", label=\"ending balances\")\n        bridge(\"interim.cash_flow.\"+end, \"cash_flow\", [opening]+flows, closing)\n    return observations, bridges, calendar\n\n\n# Interpretation annotations, not extracted values or executable accounting rules.\nNOTE_MEANING = {\n    \"Summary of Significant Accounting Policies\": (\n        [\"consolidation\", \"calendar\", \"measurement policies\"],\n        \"Use the disclosed fiscal calendar and consolidated perimeter; annual policies and interim preparation qualifications remain distinct.\",\n        \"Legal-entity control histories, estimate changes and full policy-to-posting rules are not reconstructed.\"),\n    \"Revenue\": ([\"revenue\", \"deferred revenue\", \"returns\"],\n        \"Keep the disclosed product/service partition separate from geographic segment revenue.\",\n        \"Contract performance, return estimates, transaction-price allocation and deferred-revenue movements remain unidentified.\"),\n    \"Earnings Per Share\": ([\"earnings\", \"share denominators\", \"dilution\"],\n        \"Retain the EPS numerator and dated weighted-average basic/diluted share table as unresolved typed meaning.\",\n        \"Share counts are in thousands and EPS is per share; this USD-only extractor does not implement dilution or per-share division.\"),\n    \"Financial Instruments\": ([\"investments\", \"derivatives\", \"hedging\", \"OCI\"],\n        \"Retain interest-rate derivative notional separately from debt carrying amount and rate exposure.\",\n        \"Notional does not identify hedge allocation, reset dates, currency sensitivities or future OCI recycling.\"),\n    \"Property, Plant and Equipment\": ([\"fixed assets\", \"depreciation\"],\n        \"Reconcile gross cost plus signed accumulated depreciation to net carrying amount and the balance sheet.\",\n        \"Acquisition cohorts, disposals, asset lives and future depreciation are not identified by the gross/net bridge.\"),\n                                       whole_document_equivalence=False, mirror_publication_date=None,\n                                       historical_byte_vintage=\"not established\"),\n        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n        mapping_contract=dict(kind=\"explicit case annotations\", context_source=\"Report policies, table headings and original inline contexts\",\n            annual_dates=\"Fiscal year-end table headings plus Note 1 week lengths; duration starts are derived, not calendar-year substitutions.\",\n            partitions=\"Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.\",\n            measurements=\"Debt principal, carrying amount, fair value and derivative notional remain distinct.\",\n            supported_transformations=\"Only the recorded partition aggregation, gross/net signed addition, comparative equality and dated cash movement bridges.\"),\n        acceptance=dict(specified_behavior=\"reviewed P02 plan\", implemented=\"bounded reusable source/context/reconciliation adapter\",\n                        tested_invariants=\"see result.md for executed tests\", accounting_validity=\"selected displayed identities only; no compliance determination\",\n                        empirical_forecast_validity=\"not evaluated; no forecast generated\", human_acceptance=\"pending\"))\n    out[\"anchor_count\"] = validate_anchors(out)\n    return out\n\n\ndef validate_case(candidate):\n    \"\"\"Rebuild from independently pinned sources, rejecting supplied metadata edits.\"\"\"\n    validate_anchors(candidate)\n    expected = build_case()\n    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n    return {\"status\": \"pass\", \"observations\": len(expected[\"observations\"]),\n            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n            \"anchors\": expected[\"anchor_count\"]}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n                             p01_extraction_path=r[\"extracted_path\"], p01_extraction_sha256=r[\"extracted_sha256\"],\n                             extraction_relation=\"identical\" if r[\"extracted_sha256\"] == d.extraction_hash else\n                             \"distinct text versions; offsets must not transfer\",\n                             p01_publication_metadata=r[\"publication_metadata\"]))\n    acquisitions = json.loads((ROOT/NEW/\"acquisition.json\").read_text())\n    external_docs = {}\n    for rec in acquisitions[\"records\"]:\n        if \"path\" not in rec:\n            continue\n        require(file_hash(rec[\"path\"]) == rec[\"sha256\"], \"acquired bytes changed\")\n        if rec[\"path\"].endswith(\".html\"):\n            p = Path(rec[\"path\"])\n            extracted_path = str(p.with_suffix(\".txt\"))\n            require((ROOT/extracted_path).exists(), \"missing acquired text\")\n            require(html_text((ROOT/p).read_text()) == (ROOT/extracted_path).read_text(), \"external extraction mismatch\")\n            d = Document(p.stem, str(p), extracted_path)\n            external_docs[p.stem] = d\n            bindings.append(dict(**d.binding(), acquisition=rec,\n                                 historical_byte_vintage=\"not established by current retrieval\"))\n    return annual, interim, external_docs, bindings, acquisitions\n\n\ndef collect_observations(annual, interim):\n","exit_code":0,"status":"completed"}}
