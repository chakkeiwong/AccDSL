require(\"In millions\" in section, \"issuer statement scale missing\")\n    dates = re.findall(r\"(September \\d+,)\\s*(20\\d{2})\", section)\n    expected = [(\"September 28,\", \"2024\"), (\"September 30,\", \"2023\")]\n    if revenue:\n        expected.append((\"September 24,\", \"2022\"))\n    require(dates[:len(expected)] == expected and 0 <= column < len(expected), \"issuer period/column mismatch\")\n    lines = list(re.finditer(r\"[^\\n]+\", section))\n    rows = [i for i, line in enumerate(lines) if line[0] == label]\n    require(len(rows) == (2 if label == \"Term debt\" else 1), \"ambiguous issuer row\")\n    require(0 <= occurrence < len(rows), \"issuer row occurrence\")\n    values = []\n    j = rows[occurrence] + 1\n    while j < len(lines) and len(values) < len(expected):\n        literal = lines[j][0]\n        if literal != \"$\":\n            number(literal)\n            values.append(lines[j])\n        j += 1\n    require(len(values) == len(expected), \"issuer table column count\")\n    cell = values[column]\n    return doc.anchor(start + cell.start(), start + cell.end()), cell[0]\n\n\ndef policy_records(annual, interim, notes):\n    observations, bridges, calendar = collect_observations(annual, interim)\n    notes = note_records(annual, interim, observations)\n    # A selected-table check relates representations, not whole-document\n    # publication vintage.  The issuer-linked HTML is rendered filing text,\n    # so bind visible label/value rows instead of treating it as a second\n    # inline-XBRL instance.  The accounting observations remain sourced from\n    # the retained annual/interim documents above.\n    rendered_specs = [\n        (\"annual.bs.2024-09-28.assets\", \"Total assets\", 0),\n        (\"annual.bs.2024-09-28.liabilities\", \"Total liabilities\", 0),\n        (\"annual.bs.2024-09-28.equity\", \"Total shareholders’ equity\", 0),\n        (\"annual.bs.2024-09-28.debt_current\", \"Term debt\", 0),\n        (\"annual.bs.2024-09-28.debt_noncurrent\", \"Term debt\", 1),\n        (\"annual.revenue.2024\", \"Total net sales\", 0),\n    ]\n    rendered_checks = []\n    for oid, label, occurrence in rendered_specs:\n        annual_observation = next(o for o in observations if o[\"id\"] == oid)\n        source, literal = rendered_row_match(docs[\"annual-2024-official\"], label, occurrence)\n        source_value = number(literal)*MILLION\n        require(source_value == Fraction(annual_observation[\"value_usd\"]),\n                \"issuer/annual selected value mismatch: \" + oid)\n        rendered_checks.append(dict(\n            id=\"issuer_html.\" + oid,\n            annual_observation=oid,\n            label=label,\n            displayed_literal=literal,\n            source=source,\n            status=\"independently_parsed_visible_value_agreement\",\n            interpretation=\"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\",\n            source_value_usd=str(source_value),\n        ))\n    matched = [x[\"annual_observation\"] for x in rendered_checks]\n    policy = policy_records(annual, interim, notes)\n    external = external_records(annual, interim, docs)\n    records = filing_records()\n    out = dict(schema_version=\"accdsl.apple_case.v1\", plan_sha256=PLAN_HASH,\n        scope=\"Retained Apple FY2024 annual, FY2025 Q1 interim and disclosed comparatives; selected numerical bridges only.\",\n        source_bindings=bindings, source_pins=PINS, p01_register=dict(path=REGISTER, sha256=file_hash(REGISTER)),\n        source_acquisition=acquisitions, fiscal_calendar=calendar, policies=policy,\n        observations=observations, notes=notes, reconciliations=bridges, external=external,\n        filing_availability=records, unidentified_histories=unidentified_records(notes),\n        rounding_model=dict(arithmetic=\"exact rational USD\", model=\"closed half-unit nearest-rounding intervals\",\n                            issuer_tie_rule=\"unknown\", inference=\"compatibility only; no distribution or identified underlying exact amounts\"),\n        representation_comparison=dict(matched_observations=matched, rendered_row_checks=rendered_checks,\n                                       whole_document_equivalence=False, mirror_publication_date=None,\n                                       historical_byte_vintage=\"not established\"),\n        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n        mapping_contract=dict(kind=\"explicit case annotations\", context_source=\"Report policies, table headings and original inline contexts\",\n            annual_dates=\"Fiscal year-end table headings plus Note 1 week lengths; duration starts are derived, not calendar-year substitutions.\",\n            partitions=\"Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.\",\n            measurements=\"Debt principal, carrying amount, fair value and derivative notional remain distinct.\",\n            supported_transformations=\"Only the recorded partition aggregation, gross/net signed addition, comparative equality and dated cash movement bridges.\"),\n        acceptance=dict(specified_behavior=\"reviewed P02 plan\", implemented=\"bounded reusable source/context/reconciliation adapter\",\n                        tested_invariants=\"see result.md for executed tests\", accounting_validity=\"selected displayed identities only; no compliance determination\",\n                        empirical_forecast_validity=\"not evaluated; no forecast generated\", human_acceptance=\"pending\"))\n    out[\"anchor_count\"] = validate_anchors(out)\n    return out\n\n\ndef validate_case(candidate):\n    \"\"\"Rebuild from independently pinned sources, rejecting supplied metadata edits.\"\"\"\n    validate_anchors(candidate)\n    expected = build_case()\n    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n    return {\"status\": \"pass\", \"observations\": len(expected[\"observations\"]),\n            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n            \"anchors\": expected[\"anchor_count\"]}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--output-dir\", default=\"data/accounting-master/deliverables/P02\")\n    parser.add_argument(\"--check\", action=\"store_true\", help=\"read-only rebuild and comparison\")\n    args = parser.parse_args()\n    target = ROOT / args.output_dir / \"case.json\"\n    if args.check:\n        report = validate_case(json.loads(target.read_text()))\n    else:\n        case = build_case()\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(case, ensure_ascii=False, indent=2, sort_keys=True)+\"\\n\")\n        report = dict(status=\"built\", **case[\"coverage\"])\n    print(json.dumps(report, sort_keys=True))\n\n\nif __name__ == \"__main__\":\n    main()\nclass Document:\n    def __init__(self, identity, original, extraction, pdf=False):\n        self.identity, self.original, self.extraction, self.pdf = identity, original, extraction, pdf\n        self.original_hash, self.extraction_hash = file_hash(original), file_hash(extraction)\n        self.text = (ROOT/extraction).read_text()\n\n    def anchor(self, start, end):\n        require(0 <= start < end <= len(self.text), \"anchor range\")\n        out = dict(document=self.identity, original_path=self.original,\n                   original_sha256=self.original_hash, extraction_path=self.extraction,\n                   extraction_sha256=self.extraction_hash, offset_unit=\"Unicode code points\",\n                   start=start, end=end, quote=self.text[start:end])\n        if self.pdf:\n            page_start = self.text.rfind(\"\\f\", 0, start)+1\n            page_end = self.text.find(\"\\f\", start)\n            page = self.text[page_start:page_end if page_end >= 0 else len(self.text)]\n            m = re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| (\\d+)\", page)\n            out.update(pdf_page=self.text.count(\"\\f\", 0, start)+1,\n                       printed_page=int(m[1]) if m else None,\n                       ending_pdf_page=self.text.count(\"\\f\", 0, end-1)+1)\n        return out\n\n    def find(self, pattern, bounds=None, flags=0):\n        start, end = bounds or (0, len(self.text))\n        matches = list(re.finditer(pattern, self.text[start:end], flags))\n        require(len(matches) == 1, f\"{self.identity}: expected unique span {pattern!r}, got {len(matches)}\")\n        m = matches[0]\n        return self.anchor(start+m.start(), start+m.end())\n\n    def page(self, printed):\n        offset = 0\n        for page in self.text.split(\"\\f\"):\n            if re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| \" + str(printed) + r\"\\s*$\", page):\n                return offset, offset+len(page)\n            offset += len(page)+1\n        raise CaseError(\"printed page missing\")\n\n    def binding(self):\n        return dict(id=self.identity, original_path=self.original, original_sha256=self.original_hash,\n                    extraction_path=self.extraction, extraction_sha256=self.extraction_hash)\n\n\ndef validate_value(obs):\n    \"\"\"Check value, precision and sign against the retained numeric reading.\"\"\"\n    value = Fraction(obs[\"value_usd\"])\n    require(obs[\"rounding_interval_usd\"] == interval(value, obs[\"presentation_quantum_usd\"]),\n            \"altered rounding interval\")\n    require(abs(value) == abs(number(obs[\"displayed_literal\"])*power10(obs[\"scale\"])),\n            \"literal/scale/value mismatch\")\n    require(obs[\"source_readings\"], \"missing numeric source\")\n    for source in obs[\"source_readings\"]:\n        if \"cell\" in source:\n            require(value == number(source[\"cell\"][\"quote\"])*MILLION and obs[\"scale\"] == 6 and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == MILLION, \"annual cell/value mismatch\")\n        elif \"fact\" in source:\n            fact = BeautifulSoup(source[\"fact\"][\"quote\"], \"html.parser\").find(\"ix:nonfraction\")\n            require(fact is not None, \"missing inline source\")\n            sign = -1 if fact.get(\"sign\") == \"-\" else 1\n            require(value == number(fact.get_text(strip=True))*power10(int(fact.get(\"scale\", \"0\")))*sign,\n                    \"inline source/value mismatch\")\n            require(obs[\"scale\"] == int(fact.get(\"scale\", \"0\")) and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == power10(-int(fact[\"decimals\"])),\n                    \"inline precision mismatch\")\n        else:\n            raise CaseError(\"unsupported numeric reading\")\n\n\ndef reconcile(bridge_id, kind, operands, target, partition=None):\n","exit_code":0,"status":"completed"}}
