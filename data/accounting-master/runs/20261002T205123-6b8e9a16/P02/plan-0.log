{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '802,848p' scripts/apple_case_v1.py\nsed -n '326,389p' scripts/apple_case_v1.py\nsed -n '1,48p' scripts/apple_case_v1.py\"","aggregated_output":"def filing_records():\n    raw = json.loads((ROOT/INDEX).read_text())[\"filings\"][\"recent\"]\n    out = []\n    for identity, accession in [(\"annual\", \"0000320193-24-000123\"),\n                                (\"interim\", \"0000320193-25-000008\"),\n                                (\"proxy\", \"0001308179-25-000008\")]:\n        require(raw[\"accessionNumber\"].count(accession) == 1, \"filing identity missing/ambiguous\")\n        i = raw[\"accessionNumber\"].index(accession)\n        out.append(dict(id=identity, accession=accession, form=raw[\"form\"][i], report_date=raw[\"reportDate\"][i],\n                        filing_date=raw[\"filingDate\"][i], acceptance_timestamp=raw[\"acceptanceDateTime\"][i],\n                        primary_document=raw[\"primaryDocument\"][i], index_path=INDEX, index_sha256=file_hash(INDEX),\n                        json_pointer=f\"/filings/recent/accessionNumber/{i}\",\n                        public_dissemination_timestamp=None, retained_byte_publication_date=None,\n                        qualification=\"Acceptance is index metadata, not independently verified public dissemination or retained-byte vintage.\"))\n    return out\n\n\ndef availability(record, cutoff, scope=\"filing_identity\"):\n    \"\"\"Date-resolution query; unknown byte vintage never inherits a filing date.\"\"\"\n    cutoff = date.fromisoformat(cutoff)\n    require(scope in (\"filing_identity\", \"retained_bytes\"), \"unsupported availability scope\")\n    day = record.get(\"filing_date\" if scope == \"filing_identity\" else \"retained_byte_publication_date\")\n    return \"unknown\" if day is None else (\"available_by_filing_day\" if date.fromisoformat(day) <= cutoff else \"later\")\n\n\ndef version_view(records, cutoff, scope=\"retained_bytes\"):\n    require(len({r[\"id\"] for r in records}) == len(records), \"duplicate version identity\")\n    decisions = [{\"id\": r[\"id\"], \"availability\": availability(r, cutoff, scope)} for r in records]\n    eligible = [d[\"id\"] for d in decisions if d[\"availability\"] == \"available_by_filing_day\"]\n    return dict(versions=decisions, eligible=eligible,\n                resolution=\"retain_all_no_automatic_supersession\", conflict_resolution=\"unsupported\")\n\n\ndef exhibit_records(annual, official, interim):\n    \"\"\"Read exhibit target/version columns; distinguish a link from its contents.\"\"\"\n    result = []\n    for doc, prefix in [(official, \"annual\"), (interim, \"interim\")]:\n        soup = BeautifulSoup((ROOT/doc.original).read_text(), \"html.parser\")\n        for tr in soup.find_all(\"tr\"):\n            cells = [c.get_text(\" \", strip=True) for c in tr.find_all(\"td\", recursive=False)]\n            cells = [c for c in cells if c]\n            if len(cells) < 2 or not re.fullmatch(r\"(?:\\d+\\.\\d+|101|104)[*, ]*\", cells[0]):\n                continue\n            # Exclude financial rows and identify only the exhibit-index description cells.\n            if not tr.find(\"a\", href=True) and \"**\" not in cells[0]:\n                continue\n            number = re.match(r\"\\d+(?:\\.\\d+)?\", cells[0])[0]\ndef reconcile(bridge_id, kind, operands, target, partition=None):\n    all_obs = operands+[target]\n    for obs in all_obs:\n        validate_value(obs)\n    transformations = []\n    if kind == \"cash_flow\":\n        require(len(operands) == 4, \"cash flow operands\")\n        opening, *flows = operands\n        require(opening[\"measurement\"] == target[\"measurement\"] == \"cash_including_restricted\", \"cash perimeter mismatch\")\n        require(all(o[\"measurement\"] == \"cash_flow\" for o in flows), \"cash movement type\")\n        same_context(all_obs, (\"period\",))\n        per = flows[0][\"context\"][\"period\"]\n        require(all(x[\"context\"][\"period\"] == per for x in flows), \"flow period mismatch\")\n        require(opening[\"context\"][\"period\"] == {\"instant\": (date.fromisoformat(per[\"start\"])-timedelta(days=1)).isoformat()} and\n                target[\"context\"][\"period\"] == {\"instant\": per[\"end\"]}, \"stock/flow date mismatch\")\n        transformations.append(\"Opening instant is the day before the disclosed flow period; closing instant is its end. Cash includes restricted cash on both sides.\")\n    elif kind == \"partition\":\n        same_context(all_obs, (\"dimensions\",))\n        require(partition in (\"product\", \"segment\"), \"unknown partition\")\n        expected = PRODUCTS if partition == \"product\" else SEGMENTS\n        require([o.get(\"partition\") for o in operands] == [partition]*len(expected), \"overlapping or wrong partitions\")\n        require([o.get(\"member_label\") for o in operands] == expected, \"duplicate/missing partition member\")\n        require(all(o[\"measurement\"] == \"net_revenue\" for o in all_obs) and not target[\"context\"][\"dimensions\"], \"revenue target\")\n        require(len({json.dumps(o[\"context\"][\"dimensions\"], sort_keys=True) for o in operands}) == len(expected), \"duplicate dimension members\")\n        axis, members = ((\"srt:ProductOrServiceAxis\", PRODUCT_MEMBERS) if partition == \"product\" else\n                         (\"us-gaap:StatementBusinessSegmentsAxis\", SEGMENT_MEMBERS))\n        require([o[\"context\"][\"dimensions\"] for o in operands] == [{axis: m} for m in members] and\n                all(o[\"concept\"] == REV for o in all_obs), \"partition axis/member/concept mismatch\")\n        transformations.append(\"Sum one disclosed exhaustive table partition; product and geography are separate classifications of the same revenue.\")\n    else:\n        same_context(all_obs)\n        measurements = [o[\"measurement\"] for o in operands]\n        allowed = {\n 