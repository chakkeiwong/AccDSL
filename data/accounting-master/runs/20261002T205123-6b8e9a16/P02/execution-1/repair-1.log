d\"]: r for r in notes}\n821:        a = n[doc.identity+\".note.1\"][\"anchor\"]\n835:def filing_records():\n836:    raw = json.loads((ROOT/INDEX).read_text())[\"filings\"][\"recent\"]\n841:        require(raw[\"accessionNumber\"].count(accession) == 1, \"filing identity missing/ambiguous\")\n844:                        filing_date=raw[\"filingDate\"][i], acceptance_timestamp=raw[\"acceptanceDateTime\"][i],\n846:                        json_pointer=f\"/filings/recent/accessionNumber/{i}\",\n852:def availability(record, cutoff, scope=\"filing_identity\"):\n853:    \"\"\"Date-resolution query; unknown byte vintage never inherits a filing date.\"\"\"\n855:    require(scope in (\"filing_identity\", \"retained_bytes\"), \"unsupported availability scope\")\n856:    day = record.get(\"filing_date\" if scope == \"filing_identity\" else \"retained_byte_publication_date\")\n857:    return \"unknown\" if day is None else (\"available_by_filing_day\" if date.fromisoformat(day) <= cutoff else \"later\")\n860:def version_view(records, cutoff, scope=\"retained_bytes\"):\n863:    eligible = [d[\"id\"] for d in decisions if d[\"availability\"] == \"available_by_filing_day\"]\n868:def exhibit_records(annual, official, interim):\n894:                          next_route=\"Use the exact SEC accession in the link or the issuer filing feed for the stated form and date.\")\n901:                    # package closure.  Preserve it as an unresolved filing\n923:def external_records(annual, interim, docs):\n942:                                consequence=\"Proxy information cannot be backdated to the annual filing.\",\n967:                            status=\"expressly_omitted_from_filing\", unresolved=\"Instrument identities and complete terms not specified by this index.\",\n969:                            next_route=\"Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach.\"))\n976:def unidentified_records(notes):\n977:    n = {r[\"id\"]: r for r in notes}\n979:        (\"debt_and_swaps\", [\"annual.note.9\", \"annual.note.4\", \"interim.note.6\", \"interim.note.4\"],\n982:        (\"debt_movements\", [\"annual.note.9\", \"interim.note.6\"],\n985:        (\"asset_cohorts\", [\"annual.note.5\", \"interim.note.5\"],\n988:        (\"contingent_outcomes\", [\"annual.note.12\", \"interim.note.9\"],\n996:def build_case():\n999:    notes = note_records(annual, interim, observations)\n1000:    validate_note_links(notes, observations)\n1001:    # A selected-table check relates representations, not whole-document\n1002:    # publication vintage.  The issuer-linked HTML is rendered filing text,\n1028:            interpretation=\"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\",\n1032:    policy = policy_records(annual, interim, notes)\n1034:    records = filing_records()\n1040:        observations=observations, notes=notes, reconciliations=bridges, external=external,\n1041:        filing_availability=records, unidentified_histories=unidentified_records(notes),\n1042:        rounding_model=dict(arithmetic=\"exact rational USD\", model=\"closed half-unit nearest-rounding intervals\",\n1044:        representation_comparison=dict(matched_observations=matched, rendered_row_checks=rendered_checks,\n1047:        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n1048:                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n1049:                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n1052:            partitions=\"Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.\",\n1058:    out[\"anchor_count\"] = validate_anchors(out)\n1062:def validate_case(candidate):\n1064:    validate_anchors(candidate)\n1065:    validate_note_links(candidate[\"notes\"], candidate[\"observations\"])\n1066:    expected = build_case()\n1067:    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n1069:            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n1073:def main():\n1074:    parser = argparse.ArgumentParser(description=__doc__)\n1080:        report = validate_case(json.loads(target.read_text()))\n1082:        case = build_case()\n1089:if __name__ == \"__main__\":\n","exit_code":0,"status":"completed"}}
