{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, pathlib, hashlib\np=pathlib.Path('data/accounting-master/deliverables/P02/case.json')\nd=json.loads(p.read_text())\nfor n in d['notes']:\n assert n['anchor']['start'] < n['anchor']['end']\n assert n['unresolved_meaning'] and n['semantic_completion'] is False\n assert n['linked_quantities'] == sorted(set(n['linked_quantities']))\nprint('note assertions ok')\n# check every linked evidence points to exact obs source object by canonical JSON\nfor n in d['notes']:\n obs={o['id']:o for o in d['observations']}\n for l in n['linked_quantity_evidence']:\n  sources=[]\n  def walk(x):\n   if isinstance(x,dict):\n    if {'start','end','quote','offset_unit'} <= set(x): sources.append(x)\n    for v in x.values(): walk(v)\n   elif isinstance(x,list):\n    for v in x: walk(v)\n  walk(obs[l['observation']]['source_readings'])\n  assert any(s == l['source'] for s in sources)\nprint('link object assertions ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
