or n in inventory],\n718:            \"note inventory disagreement\")\n719:    for note in notes:\n720:        areas, interpretation, unknown = NOTE_MEANING[note[\"title\"]]\n721:        note.update(disposition=\"partially_mapped\" if note[\"number\"] in (1, 2, 4) else \"unresolved_meaning_retained\",\n723:                    unresolved_meaning=unknown, semantic_completion=False, linked_quantities=[], linked_quantity_evidence=[],\n725:        a = note[\"anchor\"]\n729:                    note[\"linked_quantities\"].append(obs[\"id\"])\n730:                    note[\"linked_quantity_evidence\"].append(dict(observation=obs[\"id\"], method=\"extraction_anchor_containment\", source=source))\n735:            boundary = raw_ranges[note[\"number\"]]\n736:            note[\"raw_note_boundary\"] = boundary\n741:                        note[\"linked_quantities\"].append(obs[\"id\"])\n742:                        note[\"linked_quantity_evidence\"].append(dict(observation=obs[\"id\"], method=\"raw_html_fact_containment\", source=fact))\n744:        note[\"linked_quantities\"] = sorted(set(note[\"linked_quantities\"]))\n745:        note[\"linked_quantity_evidence\"] = sorted(note[\"linked_quantity_evidence\"], key=lambda x: x[\"observation\"])\n746:        if note[\"linked_quantities\"]:\n747:            note[\"disposition\"] = \"selected_quantities_mapped_with_unresolved_remainder\"\n749:        note[\"cross_references\"] = [dict(target=f\"{a['document']}.note.{n}\",\n750:                                         relation=\"literal note reference\", status=\"source_present; meaning not necessarily executed\")\n751:                                    for n in targets if n != note[\"number\"]]\n752:        require(all(t[\"target\"] in {n[\"id\"] for n in notes} for t in note[\"cross_references\"]), \"unresolved internal note target\")\n753:    by_id = {n[\"id\"]: n for n in notes}\n754:    by_id[\"annual.note.9\"][\"cross_references\"].append(dict(target=\"annual.note.4\", relation=\"analyst link: debt and interest-rate swaps\", status=\"source_present\"))\n755:    by_id[\"interim.note.1\"][\"cross_references\"].append(dict(target=\"annual.note.1\", relation=\"explicit read-with-2024-10-K qualification\", status=\"source_present\"))\n756:    contingency = by_id[\"interim.note.9\"]\n757:    contingency[\"assertion\"] = dict(kind=\"reported_management_assessment\", speaker=\"Apple management\",\n763:    return notes\n766:def raw_note_ranges(doc):\n767:    \"\"\"Return raw HTML ranges for actual interim note headings.\"\"\"\n771:            \"missing, duplicate or reordered raw note headings\")\n773:    require(stop is not None, \"raw final note boundary missing\")\n818:def policy_records(annual, interim, notes):\n819:    n = {r[\"id\"]: r for r in notes}\n821:        a = n[doc.identity+\".note.1\"][\"anchor\"]\n826:             interpretation=\"Comparatives are as presented in the 2024 report; original historical presentation has not been reconstructed.\"),\n829:        dict(id=\"interim.preparation\", status=\"reported_management_assertion\", anchor=within(interim, r\"In the opinion of the Company’s management.*?2024 Form 10-K”\\)\\.\"),\n847:                        public_dissemination_timestamp=None, retained_byte_publication_date=None,\n852:def availability(record, cutoff, scope=\"filing_identity\"):\n854:    cutoff = date.fromisoformat(cutoff)\n856:    day = record.get(\"filing_date\" if scope == \"filing_identity\" else \"retained_byte_publication_date\")\n857:    return \"unknown\" if day is None else (\"available_by_filing_day\" if date.fromisoformat(day) <= cutoff else \"later\")\n860:def version_view(records, cutoff, scope=\"retained_bytes\"):\n862:    decisions = [{\"id\": r[\"id\"], \"availability\": availability(r, cutoff, scope)} for r in records]\n976:def unidentified_records(notes):\n977:    n = {r[\"id\"]: r for r in notes}\n979:        (\"debt_and_swaps\", [\"annual.note.9\", \"annual.note.4\", \"interim.note.6\", \"interim.note.4\"],\n982:        (\"debt_movements\", [\"annual.note.9\", \"interim.note.6\"],\n985:        (\"asset_cohorts\", [\"annual.note.5\", \"interim.note.5\"],\n988:        (\"contingent_outcomes\", [\"annual.note.12\", \"interim.note.9\"],\n996:def build_case():\n999:    notes = note_records(annual, interim, observations)\n1000:    validate_note_links(notes, observations)\n1001:    # A selected-table check relates representations, not whole-document\n1002:    # publication vintage.  The issuer-linked HTML is rendered filing text,\n1028:            interpretation=\"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\",\n1032:    policy = policy_records(annual, interim, notes)\n1040:        observations=observations, notes=notes, reconciliations=bridges, external=external,\n1041:        filing_availability=records, unidentified_histories=unidentified_records(notes),\n1044:        representation_comparison=dict(matched_observations=matched, rendered_row_checks=rendered_checks,\n1045:                                       whole_document_equivalence=False, mirror_publication_date=None,\n1046:                                       historical_byte_vintage=\"not established\"),\n1047:        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n1048:                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n1049:                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n1062:def validate_case(candidate):\n1065:    validate_note_links(candidate[\"notes\"], candidate[\"observations\"])\n1067:    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n1069:            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n","exit_code":0,"status":"completed"}}
