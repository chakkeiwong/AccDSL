e() else None for p in before}\n    protection=[p for p in before if before[p]!=after[p]]\n    initial=Path('/tmp/accdsl-p03-protected-entry.json')\n    worker_changes=[]\n    if initial.exists():\n        worker_changes=[p for p,h in json.loads(initial.read_text()).items() if not (ROOT/p).is_file() or hashlib.sha256((ROOT/p).read_bytes()).hexdigest()!=h]\n    passed=(result.wasSuccessful() and result.testsRun>0 and not result.skipped and not missing and not extra and not protection and not worker_changes)\n    payload={\n      'schema_version':'accdsl.p03.conformance.v1','passed':passed,'profile':catalog['profile'],\n      'manifest':{'git_commit':'unavailable: existing marker is not a usable repository',\n        'command':'python3 -B scripts/check_accounting_p03.py --output-dir data/accounting-master/deliverables/P03',\n        'environment':{'python':platform.python_version(),'lark':version('lark'),'jsonschema':version('jsonschema')},\n        'hardware':'CPU only; no accelerator framework imported','random_seeds':'N/A: deterministic checks',\n        'data_version':'synthetic P03 bindings and digest-locked DemoDebt@1',\n        'utc':datetime.now(timezone.utc).isoformat(),'wall_seconds':round(time.monotonic()-started,3),\n        'plan':'data/accounting-master/runs/20261002T205123-6b8e9a16/P03/approved-plan.json',\n        'result':'data/accounting-master/deliverables/P03/result.md',\n        'outputs':['data/accounting-master/deliverables/P03/conformance.json','data/accounting-master/deliverables/P03/result.md'],\n        'changed_files':CHANGED+['data/accounting-master/deliverables/P03/'+n for n in ('conformance.json','result.md','progress.md')]},\n      'tests':{'methods_run':result.testsRun,'obligations_run':len(observed),'missing':missing,'uncatalogued':extra,\n               'skipped':result.skipped,'failures':[{'test':str(t),'detail':d} for t,d in result.failures+result.errors]},\n      'observations':cases.OBSERVATIONS,\n      'hashes':{p:hashlib.sha256