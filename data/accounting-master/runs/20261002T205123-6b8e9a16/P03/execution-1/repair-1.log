 'ir_opening_binding':(lambda d:(d['states'][0]['balances'][0].update(signed_amount=ir.rational(94)),d['states'][0]['balances'][3].update(signed_amount=ir.rational(6))),'OpeningStateMismatch'),\n 'ir_report_policy':(lambda d:d['reportMappings'][0].update(cash_flow_policy='DemoDebt@1/invented'),'ReportMapping'),\n 'ir_report_operations':(lambda d:d['reportMappings'][0].update(required_operations=['DemoDebt@1/reset']),'ReportMapping'),\n 'false_family_coverage':(lambda d:d['historyFamilies'][0].update(coverage='ExactWithinScope'),'FalseCoverage'),\n 'ir_false_feasibility':(lambda d:d['historyFamilies'][0].update(feasibility='Feasible'),'MissingWitness'),\n 'ir_lost_branch':(lambda d:d['historyFamilies'][0].update(alternatives=[]),'FamilyMembership'),\n}\n\nif __name__=='__main__': unittest.main()\n        'utc':datetime.now(timezone.utc).isoformat(),'wall_seconds':round(time.monotonic()-started,3),\n        'plan':'data/accounting-master/runs/20261002T205123-6b8e9a16/P03/approved-plan.json',\n        'result':'data/accounting-master/deliverables/P03/result.md',\n        'outputs':['data/accounting-master/deliverables/P03/conformance.json','data/accounting-master/deliverables/P03/result.md'],\n        'changed_files':CHANGED+['data/accounting-master/deliverables/P03/'+n for n in ('conformance.json','result.md','progress.md')]},\n      'tests':{'methods_run':result.testsRun,'obligations_run':len(observed),'missing':missing,'uncatalogued':extra,\n               'skipped':result.skipped,'failures':[{'test':str(t),'detail':d} for t,d in result.failures+result.errors]},\n      'observations':cases.OBSERVATIONS,\n      'hashes':{p:hashlib.sha256((ROOT/p).read_bytes()).hexdigest() for p in CHANGED},\n      'protected_files':{'before':before,'after':after,'changed_during_check':protection,\n          'changed_during_worker':worker_changes,'historical_differences':[p for p in before if before[p]!=entry[p]]},\n      'requirement_coverage':{'MC02':'context and provenance','MC04':'separate alternatives and global constraints',\n         'MC10':'explicit historical admission and scenario assumptions','MC20':'package digest/applicability and report policies',\n         'MC23':'independent matched typed/text programs; no authoring superiority claim','MC24':'bounded parsing, binding, typing and independent IR rejection'},\n      'unsupported':catalog['unsupported'],\n      'acceptance':{'engineering':passed,'accounting_validity':'not established','forecast_validity':'not established',\n                    'human_acceptance':'pending','whole_gap_closure':False}}\n    out.mkdir(parents=True,exist_ok=True)\n# AccDSL mission control\n\nEstablished 2 October 2026 (Asia/Hong_Kong) at the user's request.\nStatus: active mission; Version 1.2 is a repaired design candidate with checked\nreference cases. Full product, domain and human acceptance remain pending.\n\n## Purpose\n\nDesign a system that represents a company's historical financial disclosures,\npreserves economically different histories and interpretations compatible with\nthe evidence, and carries those alternatives into scenario-dependent future\njournals and financial statements. Preserve their separate conditional outcome\ndistributions or feasible sets, including uncertainty that cannot be assigned\ndefensible probabilities.\n\nThe immediate deliverable is a detailed, readable LaTeX product and method\ndesign, with compiled PDF, supporting literature and software investigation,\nprecise implementation contracts and acceptance examples. The eventual product\nis the working representation and simulation engine. A document build, a small\nfinancing example and an implemented prototype are different achievements.\n\n## Authority and origin\n\nThis mission records the user's existing directions; it does not replace new\nuser instructions or higher-priority instructions. The three original requests\nare preserved in saved session `01a0f8e0-0c0b-7332-8f7e-d6b93ce32761`, at JSONL\nrecords 10, 115 