 \"contract fields are incomplete or duplicated\", row[\"id\"]))\n            expected = {\"principal\": f\"Money<{books[row['book']]['currency']}>\", \"fixed_fraction\": \"Real\",\n                        \"fixed_rate\": \"Rate<annual_simple>\", \"initial_floating_rate\": \"Rate<annual_simple>\"}\n            for name, typ in expected.items():\n                if checker.expr(fields[name])[0] != typ:\n                    raise _Failure(Diagnostic(\"ContractType\", f\"{name} has the wrong type\", row[\"id\"]))\n            low, high = _expression_bounds(fields[\"fixed_fraction\"], nodes)\n            if low < 0 or high > 1:\n                raise _Failure(Diagnostic(\"ContractDomain\", \"fixed fraction bounds must lie inside [0,1]\", row[\"id\"]))\n            principal = checker.expr(fields[\"principal\"])[2]\n            debt = bindings.readings[0].amount\n            if principal != debt or any(dict(o.balances).get(\"Debt\") != -debt for o in bindings.openings):\n                raise _Failure(Diagnostic(\"ContractPrincipal\", \"principal must equal accepted debt and opening liability\", row[\"id\"]))\n            for name in (\"fixed_rate\", \"initial_floating_rate\"):\n                value = checker.expr(fields[name])[2]\n                if not isinstance(value, Fraction) or value < 0:\n                    raise _Failure(Diagnostic(\"ContractDomain\", f\"{name} must be a nonnegative constant\", row[\"id\"]))\n        alternatives = {r[\"id\"]: r for r in ir[\"alternatives\"]}\n        for row in ir[\"alternatives\"]:\n            if row[\"parent\"] not in {r[\"id\"] for r in ir[\"historyFamilies\"]} or row[\"scope\"] not in scope_ids:\n                raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative parent or scope is unknown\", row[\"id\"]))\n            meta = next((a for a in bindings.alternatives if a.name == row[\"id\"]), None)\n            if meta is None or row[\"author\"] != meta.author or row[\"created_at\"] != meta.created_at or row[\"reason\"] != meta.reason:\n                raise _Failure(Diagnostic(\"AlternativeMetadata\", \"alternative metadata differs from binding\", row[\"id\"]))\n            if not row[\"constraints\"]:\n                raise _Failure(Diagnostic(\"MissingAlternativeCondition\", \"alternative requires at least one condition\", row[\"id\"]))\n            for cid in row[\"constraints\"]:\n                c = next((x for x in ir[\"constraints\"] if x[\"id\"] == cid), None)\n                if c is None or c[\"scope\"] != row[\"id\"] or checker.expr(c[\"expression\"])[0] != \"Bool\":\n                    raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative condition is not scoped to its branch\", row[\"id\"]))\n        for row in ir[\"states\"]:\n            total = Fraction(0); seen = set()\n            for balance in row[\"balances\"]:\n                if balance[\"account\"] in seen:\n                    raise _Failure(Diagnostic(\"DuplicateBalance\", \"opening account occurs twice\", row[\"id\"]))\n                seen.add(balance[\"account\"]); total += parse_rational(balance[\"signed_amount\"])\nclass _IRTypeChecker:\n    def __init__(self, ir: Mapping[str, Any], nodes: Mapping[str, tuple[str, Mapping[str, Any]]]):\n        self.ir, self.nodes = ir, nodes\n        self.memo: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.active: set[str] = set()\n\n    def expr(self, identifier: str) -> tuple[str, Optional[str], Any]:\n        if identifier in self.memo:\n            return self.memo[identifier]\n        if identifier in self.active:\n            raise _Failure(Diagnostic(\"ExpressionCycle\", \"cyclic expression dependency\", identifier))\n        if identifier not in self.nodes or self.nodes[identifier][0] != \"expressions\":\n            raise _Failure(Diagnostic(\"UnknownReference\", f\"expression {identifier!r} is not declared\", identifier))\n        self.active.add(identifier)\n        e = self.nodes[identifier][1]\n        op, target = e[\"op\"], e[\"target\"]\n        args = [self.expr(a) for a in e[\"args\"]]\n        types = [a[0] for a in args]\n        contexts = [a[1] for a in args]\n        context = next((c for c in contexts if c is not None), None)\n        if any(c is not None and context is not None and c != context for c in contexts):\n            raise _Failure(Diagnostic(\"ContextMismatch\", \"expression operands use incompatible contexts\", identifier))\n        if op == \"literal\":\n            if e[\"args\"] or e[\"target\"] is not None or e[\"field_names\"]:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"literal cannot have operands, target or fields\", identifier))\n            if (e[\"rational\"] is None) == (e[\"text\"] is None):\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"literal requires exactly one payload\", identifier))\n            if e[\"rational\"] is not None:\n                value = parse_rational(e[\"rational\"])\n                if not _numeric_type(e[\"type\"]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"rational literal must have a numeric type\", identifier))\n                if e[\"type\"] == \"Int\" and value.denominator != 1:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"fractional integer literal\", identifier))\n            elif e[\"text\"] is not None:\n                value = e[\"text\"]\n                if e[\"type\"] == \"Bool\" and value not in {\"true\", \"false\"}:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"Boolean text literal must be true or false\", identifier))\n                if e[\"type\"] == \"Date\":\n                    _iso(value, identifier)\n                if e[\"type\"] == \"SourceRef\":\n                    # SourceRef text is checked below against supplied report\n                    # bindings; here it must at least be a nonempty string.\n                    if not value:\n                        raise _Failure(Diagnostic(\"ExpressionPayload\", \"SourceRef cannot be empty\", identifier))\n                if e[\"type\"] not in {\"String\", \"Bool\", \"Date\", \"SourceRef\"}:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"text literal has unsupported type\", identifier))\n            result, context = e[\"type\"], e[\"context\"]\n        elif op == \"ref\":\n            if e[\"args\"] or e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"] or target is None:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"reference has an invalid payload\", identifier))\n            if target not in self.nodes:\n                raise _Failure(Diagnostic(\"UnknownReference\", f\"reference {target!r} is not declared\", identifier))\n            section, row = self.nodes[target]\n            if section == \"expressions\":\n                result, context, value = self.expr(target)\n            elif section == \"symbols\":\n                result, context, value = row[\"type\"], row[\"context\"], None\n            elif section == \"observations\":\n                ctx = self.nodes[row[\"context\"]][1]\n                result, context, value = f\"Observation<Money<{ctx['currency']}>>\", row[\"context\"], parse_rational(row[\"domain\"][\"lower\"])\n            else:\n                raise _Failure(Diagnostic(\"ReferenceKind\", f\"cannot reference {section} from expression\", identifier))\n        elif op == \"call\":\n            if e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"] or target is None:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"call has an invalid payload\", identifier))\n            if len(args) != 1:\n                raise _Failure(Diagnostic(\"ArityMismatch\", \"builtin requires one operand\", identifier))\n            if target == \"builtin:value@1\":\n                if len(args) != 1 or not types or not types[0].startswith(\"Observation<\"):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"value requires one observation\", identifier))\n                result, context = types[0][12:-1], args[0][1]\n                value = args[0][2]\n            elif target == \"builtin:constant@1\":\n                if len(args) != 1 or not types or types[0] != \"Rate<annual_simple>\":\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"constant requires one annual rate\", identifier))\n                result, context, value = f\"Driver<{types[0]}>\", args[0][1], args[0][2]\n            else:\n                raise _Failure(Diagnostic(\"UnsupportedExpression\", \"unknown builtin call\", identifier))\n        else:\n            if target is not None or e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"]:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"operator has an invalid payload\", identifier))\n            arity = 1 if op in {\"negate\", \"not\"} else 2\n            if len(args) != arity:\n                raise _Failure(Diagnostic(\"ArityMismatch\", \"wrong expression arity\", identifier))\n            if op in {\"not\", \"and\", \"or\"}:\n                if any(t != \"Bool\" for t in types):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"Boolean operands required\", identifier))\n                result, context = \"Bool\", None\n                value = None\n            elif op in {\"eq\", \"ne\", \"lt\", \"le\", \"gt\", \"ge\"}:\n                if types[0] != types[1]:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"comparison types differ\", identifier))\n                if op not in {\"eq\", \"ne\"} and not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"ordering requires numeric operands\", identifier))\n                result, context, value = \"Bool\", None, None\n            elif op in {\"add\", \"subtract\"}:\n                if types[0] != types[1] or not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"compatible numeric operands required\", identifier))\n                result, context, value = types[0], context, None\n            elif op == \"negate\":\n                if not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"numeric operand required\", identifier))\n                result, context, value = types[0], args[0][1], None\n            elif op in {\"multiply\", \"divide\"}:\n                if not _numeric_type(types[0]) or not _numeric_type(types[1]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"numeric operands required\", identifier))\n                if op == \"divide\" and not _is_scalar(types[1]):\n                    raise _Failure(Diagnostic(\"UnsupportedOperation\", \"divisor must be scalar\", identifier))\n                if op == \"divide\" and not isinstance(args[1][2], Fraction):\n                    raise _Failure(Diagnostic(\"UnprovedNonzeroDenominator\", \"divisor must be constant\", identifier))\n                if op == \"divide\" and args[1][2] == 0:\n                    raise _Failure(Diagnostic(\"UnprovedNonzeroDenominator\", \"divisor is zero\", identifier))\n                if op == \"multiply\":\n                    if _is_scalar(types[0]) and not _is_scalar(types[1]):\n                        result = types[1]\n                    elif _is_scalar(types[1]) and not _is_scalar(types[0]):\n                        result = types[0]\n                    elif _is_scalar(types[0]) and _is_scalar(types[1]):\n                        result = \"Int\" if types[0] == types[1] == \"Int\" else \"Real\"\n                    else:\n                        raise _Failure(Diagnostic(\"UnsupportedOperation\", \"product of two dimensional quantities is unsupported\", identifier))\n                else:\n                    result = types[0] if not _is_scalar(types[0]) else \"Real\"\n                context, value = context, None\n            else:\n                raise _Failure(Diagnostic(\"UnsupportedExpression\", f\"operator {op!r} unsupported\", identifier))\n        if op in {\"add\", \"subtract\", \"multiply\", \"divide\", \"negate\"} and all(isinstance(a[2], Fraction) for a in args):\n            values = [a[2] for a in args]\n            value = -values[0] if op == \"negate\" else _arithmetic({\"add\":\"+\", \"subtract\":\"-\", \"multiply\":\"*\", \"divide\":\"/\"}[op], *values)\n        declared = (e[\"type\"], e[\"context\"])\n        if declared != (result, context):\n            raise _Failure(Diagnostic(\"TypeMismatch\", f\"declared {declared}, inferred {(result, context)}\", identifier))\n        self.active.remove(identifier)\n        self.memo[identifier] = (result, context, value)\n        return self.memo[identifier]\n\n\ndef _expression_bounds(identifier, nodes):\n","exit_code":0,"status":"completed"}}
