{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '780,865p' scripts/core0_ir_v1.py; sed -n '1269,1305p' scripts/core0_ir_v1.py; sed -n '1380,1488p' scripts/core0_ir_v1.py\"","aggregated_output":"        if any(name not in _ACCOUNT_ROLES for name, _ in opening.balances):\n            raise _diag(\"OpeningStateMismatch\", \"opening contains an account outside DemoDebt\", opening.key)\n\n    for report in bindings.reports:\n        if not report.key or not report.mapping or not report.cash_flow_policy or not report.closing_policy:\n            raise _diag(\"IncompleteReportBinding\", \"report bindings require mapping and policies\", report.key or \"report\")\n        if (report.mapping != \"DemoDebt.statements.v1\" or report.cash_flow_policy != \"interest_operating\"\n                or report.closing_policy != \"close\" or report.required_operations != (\"accrue_and_pay\",)):\n            raise _diag(\"ReportMapping\", \"report policies must match the retained package export\", report.key)\n        if not report.required_operations:\n            raise _diag(\"IncompleteReportBinding\", \"report binding requires at least one operation\", report.key)\n\n    for assumption in bindings.assumptions:\n        if assumption.provenance not in {\"Analyst\", \"EmpiricalEstimate\", \"ImportedModel\", \"ScenarioDesign\"}:\n            raise _diag(\"InvalidAssumption\", \"unsupported assumption provenance\", assumption.key)\n        if assumption.role not in {\"Baseline\", \"Hypothesis\", \"Convenience\", \"ReviewedDefault\"}:\n            raise _diag(\"InvalidAssumption\", \"unsupported assumption role\", assumption.key)\n        if assumption.information_cutoff is not None:\n            _instant(assumption.information_cutoff, f\"assumption:{assumption.key}.cutoff\")\n        if assumption.valid_start is None or assumption.valid_end is None:\n            raise _diag(\"IncompleteAssumption\", \"assumptions require a validity interval\", assumption.key)\n        _iso(assumption.valid_start, f\"assumption:{assumption.key}.valid_start\")\n        _iso(assumption.valid_end, f\"assumption:{assumption.key}.valid_end\")\n        if date.fromisoformat(assumption.valid_end) <= date.fromisoformat(assumption.valid_start):\n            raise _diag(\"InvalidPeriod\", \"assumption validity end must be after start\", assumption.key)\n\n    readings = {r.key for r in bindings.readings}\n    for admission in bindings.admissions:\n        if admission.reading_key not in readings or admission.kind != \"HistoricalFact\":\n            raise _diag(\"SymbolAdmission\", \"symbol admissions must cite a bound HistoricalFact reading\", admission.name)\n        _instant(admission.date, f\"admission:{admission.name}.date\")\n        if not admission.reviewer or not admission.reason:\n            raise _diag(\"IncompleteAdmission\", \"symbol admissions require reviewer and reason\", admission.name)\n    for alternative in bindings.alternatives:\n        _instant(alternative.created_at, f\"alternative:{alternative.name}.created_at\")\n        if not alternative.author or not alternative.reason:\n            raise _diag(\"IncompleteAlternative\", \"alternative metadata require author and reason\", alternative.name)\n\n\n# ---------------------------------------------------------------------------\n# Lowering\n\n\ndef _empty_ir() -> dict[str, Any]:\n    keys = [\n        \"models\", \"contexts\", \"sourceSpans\", \"documents\", \"observations\", \"narratives\",\n        \"coverageUnits\", \"mappings\", \"partitions\", \"entities\", \"controls\", \"books\", \"accounts\",\n        \"symbols\", \"choices\", \"expressions\", \"constraints\", \"assumptions\", \"alternatives\",\n        \"contracts\", \"postings\", \"states\", \"events\", \"rules\", \"packages\", \"measurements\",\n        \"journals\", \"scenarios\", \"informationViews\", \"reviewDecisions\", \"evidenceViews\",\n        \"modelScopes\", \"historyFamilies\", \"probabilityModels\", \"reportMappings\", \"resultCells\",\n        \"branchResults\", \"runs\", \"diagnostics\",\n    ]\n    out = {k: [] for k in keys}\n    out[\"schema_version\"] = \"0.1\"\n    return out\n\n\ndef _diag(code: str, message: str, location: str, capability: Optional[str] = None,\n          span: Optional[tuple[int, int]] = None) -> _Failure:\n    return _Failure(Diagnostic(code, message, location, capability=capability, span=span))\n\n\nclass _Compiler:\n    def __init__(self, program: Program, bindings: CompileBindings,\n                 source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,\n                 input_text: Optional[str] = None):\n        self.program = program\n        self.bindings = bindings\n        self.source_spans = source_spans or {}\n        self.input_text = input_text\n        self.ir = _empty_ir()\n        self.source_map: dict[str, dict[str, Any]] = {}\n        self.expr_rows: dict[str, dict[str, Any]] = {}\n        self.expr_info: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.decls: dict[str, Any] = {}\n        self.lets: dict[str, LetDecl] = {}\n        self.let_ids: dict[str, str] = {}\n        self.lowering_lets: set[str] = set()\n        self.observations: dict[str, ObservationDecl] = {}\n        self.symbols: dict[str, SymbolDecl] = {}\n        self.sources: dict[str, SourceDecl] = {}\n        self.entities: dict[str, EntityDecl] = {}\n        self.books: dict[str, BookDecl] = {}\n        self.accounts: dict[str, AccountDecl] = {}\n        self.openings: dict[str, OpeningDecl] = {}\n    def build(self) -> CompileResult:\n        self.collect()\n        source_keys, _, _ = self._lower_source_metadata()\n        self._reading_ids: dict[str, str] = {}\n        evidence = self._build_evidence(source_keys)\n        assert self.entity is not None and self.book is not None and self.package is not None\n        entity = self.entity\n        book = self.book\n        package = self.package\n        model_scope = self.scope_id\n        # Core declarations and package context.\n        self.ir[\"entities\"].append({\"id\": entity.name, \"functional_currency\": entity.currency})\n        self.ir[\"packages\"].append({\n            \"id\": package.id, \"version\": package.version, \"digest\": package.digest,\n            \"basis\": package.basis,\n            \"effective\": _time(\"interval\", package.effective_start, package.effective_end, self.bindings.calendar_id),\n            \"operations\": [f\"{package.id}/{x}\" for x in package.operations],\n            \"extension_points\": [], \"dependencies\": list(package.dependencies),\n            \"authority\": list(package.authority), \"review_status\": package.review_status,\n            \"implementation\": package.implementation,\n        })\n        self.ir[\"books\"].append({\"id\": book.name, \"entity\": book.entity, \"basis\": package.id,\n                                  \"package\": package.id, \"currency\": entity.currency})\n        for account in self.accounts.values():\n            if account.book != book.name:\n                self.fail(\"BindingMismatch\", \"all accounts must belong to the declared book\", account.name)\n            if account.role not in {\"Asset\", \"Liability\", \"Expense\", \"Equity\"}:\n                self.fail(\"UnsupportedAccountRole\", f\"account role {account.role!r} is outside profile\", account.name)\n            self.ir[\"accounts\"].append({\"id\": account.name, \"book\": account.book,\n                                         \"role\": account.role, \"report_concept\": account.name})\n        # Time/context and observations.\n        observation_contexts: dict[str, str] = {}\n        for obs in self.observations.values():\n            _iso(obs.instant, obs.name)\n            if not obs.type_name.startswith(\"Money<\"):\n                self.fail(\"UnsupportedObservationType\", \"Core0.1 observations are monetary\", obs.name)\n            currency = obs.type_name[6:-1]\n            field_rows.append({\"name\": name, \"expression\": info[0]})\n        self.ir[\"contracts\"].append({\"id\": contract.name, \"type\": f\"{package.id}/{contract.type_name}\",\n                                      \"book\": contract.book, \"fields\": field_rows, \"package\": package.id,\n                                      \"source_refs\": [evidence[next(iter(source_keys.values()))][1]]})\n        alt_ids = []\n        constraint_ids = []\n        for alt in self.alternatives.values():\n            meta = self.bindings.alternative(alt.name)\n            alt_ids.append(alt.name)\n            alt_constraints = []\n            for index, assumption in enumerate(alt.assumptions):\n                eid = self.lower_expr(assumption, f\"alternative:{alt.name}\", f\"assumption:{index}\")[0]\n                cid = f\"constraint:{_clean_id(alt.name)}:{index}\"\n                self.ir[\"constraints\"].append({\"id\": cid, \"expression\": eid, \"kind\": \"assumption\",\n                                                \"scope\": alt.name, \"source_refs\": []})\n                alt_constraints.append(cid)\n                self._assumption_row(f\"alternative:{alt.name}:{index}\", eid, alt.name, evidence)\n            if not alt_constraints:\n                self.fail(\"MissingAlternativeCondition\", \"named alternatives require a Boolean condition\", alt.name)\n            self.ir[\"alternatives\"].append({\n                \"id\": alt.name, \"parent\": f\"history:{_clean_id(self.model_id)}\", \"scope\": model_scope,\n                \"author\": meta.author,\n                \"created_at\": meta.created_at,\n                \"constraints\": alt_constraints, \"choice_group\": None,\n                \"reason\": meta.reason, \"evidence\": [evidence[next(iter(source_keys.values()))][1]],\n                \"opposing_evidence\": [],\n            })\n        for con in self.constraints.values():\n            eid = self.lower_expr(con.expression, f\"constraint:{con.name}\", \"condition\")[0]\n            self.ir[\"constraints\"].append({\"id\": con.name, \"expression\": eid, \"kind\": \"assumption\",\n                                           \"scope\": model_scope, \"source_refs\": []})\n            constraint_ids.append(con.name)\n            self._assumption_row(f\"constraint:{con.name}\", eid, model_scope, evidence)\n        scenario = next(iter(self.scenarios.values()))\n        settings = dict(scenario.settings)\n        if set(settings) != {\"market_rate\"}:\n            self.fail(\"ScenarioFields\", \"Core0.1 scenario requires one market_rate setting\", scenario.name)\n        driver = self.lower_expr(settings[\"market_rate\"], f\"scenario:{scenario.name}\", \"market_rate\")\n        if not driver[1].startswith(\"Driver<Rate<\"):\n            self.fail(\"ScenarioType\", \"market_rate must be a constant annual rate driver\", scenario.name)\n        self._assumption_row(f\"scenario:{scenario.name}\", driver[0], scenario.name, evidence)\n        self.ir[\"scenarios\"].append({\"id\": scenario.name, \"kind\": \"ExogenousStress\",\n                                      \"drivers\": [{\"name\": \"market_rate\", \"expression\": driver[0]}],\n                                      \"probability_model\": None, \"observed_event\": None, \"structural_model\": None,\n                                      \"replaced_equations\": [], \"visibility\": \"announced\"})\n        # Opening state and report mapping.\n        opening_decl = next(iter(self.openings.values()))\n        opening = self.bindings.opening(opening_decl.external)\n        if opening.book is not None and opening.book != opening_decl.book:\n            self.fail(\"OpeningStateMismatch\", \"opening binding belongs to another book\", opening_decl.name)\n        account_names = {a.name for a in self.accounts.values()}\n        bound_names = {name for name, _ in opening.balances}\n        if account_names != bound_names:\n            self.fail(\"OpeningStateMismatch\", \"opening binding must provide every account exactly once\", opening_decl.name)\n        total = sum((value for _, value in opening.balances), Fraction(0))\n        if total != 0:\n            self.fail(\"UnbalancedState\", \"opening signed balances must sum to zero\", opening_decl.name)\n        self.ir[\"states\"].append({\"id\": opening_decl.name, \"date\": _iso(opening.date, opening_decl.name),\n                                   \"book\": opening_decl.book,\n                                   \"balances\": [{\"account\": name, \"signed_amount\": rational(value)} for name, value in opening.balances],\n                                   \"contracts\": [contract.name], \"measurements\": [],\n                                   \"dependencies\": list(opening.dependencies) or [evidence[next(iter(source_keys.values()))][2]]})\n        report = next(iter(self.reports.values()))\n        rb = self.bindings.report(report.mapping.key if isinstance(report.mapping, External) else str(report.mapping)) if isinstance(report.mapping, External) else None\n        if rb is None:\n            self.fail(\"UnsupportedReportMapping\", \"report mapping must be an explicit external binding\", report.name)\n        self.ir[\"reportMappings\"].append({\"id\": report.name, \"book\": report.book, \"basis\": package.id,\n                                          \"rows\": [{\"name\": \"package_mapping\", \"expression\": self._source_ref_expr(rb.mapping, report.name)}],\n                                          \"closing_policy\": f\"{package.id}/{rb.closing_policy}\",\n                                          \"cash_flow_policy\": f\"{package.id}/{rb.cash_flow_policy}\",\n                                          \"required_operations\": [f\"{package.id}/{x}\" for x in rb.required_operations]})\n        # Profile scope and conservative family status.  This profile does not\n        # perform a reconstruction or feasibility search.\n        slot = self._literal_expr(\"scope\", \"slot_limit\", 1, \"Int\")\n        self.ir[\"modelScopes\"].append({\"id\": model_scope, \"templates\": [f\"{package.id}/{contract.type_name}\"],\n                                       \"slot_limits\": [{\"name\": \"debt_contracts\", \"expression\": slot}],\n                                       \"resolution\": \"one fixed/floating aggregate, annual simple accrual\",\n                                       \"calendars\": [self.bindings.calendar_id], \"choices\": [],\n                                       \"exclusions\": [\"fees\", \"foreign_currency\", \"embedded_options\"], \"obligations\": []})\n        family_id = f\"history:{_clean_id(self.model_id)}\"\n        self.ir[\"historyFamilies\"].append({\"id\": family_id, \"scope\": model_scope,\n            \"evidence_view\": evidence[next(iter(source_keys.values()))][2], \"opening_state\": opening_decl.name,\n            \"symbols\": list(self.symbols), \"choices\": [], \"constraints\": constraint_ids,\n            \"alternatives\": alt_ids, \"feasibility\": \"Unknown\", \"coverage\": \"PartialSearch\",\n            \"completed_cells\": 0, \"unresolved_cells\": 1, \"witnesses\": [], \"solver_results\": []})\n        declarations = [self.let_ids.get(n, n) for n in self.decls]\n        declarations = [n for n in declarations if n not in self.sources]\n        self.ir[\"models\"].append({\"id\": self.model_id, \"language_version\": \"Core0.1\",\n                                  \"declarations\": list(dict.fromkeys(declarations)),\n                                  \"package_lock\": [package.id], \"scope\": model_scope})\n        self.ir[\"expressions\"] = list(self.expr_rows.values())\n        self.ir[\"diagnostics\"] = []\n        # Evidence view observations were added after creation; record all\n        # generated rows deterministically.\n        self.ir[\"sourceSpans\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"documents\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"observations\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"expressions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"assumptions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"constraints\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"alternatives\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"reviewDecisions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"evidenceViews\"].sort(key=lambda r: r[\"id\"])\n        # Validate the generated structure before exposing it.\n        checked = validate_ir(self.ir, self.bindings)\n        if not checked.ok:\n            raise _Failure(checked.diagnostics[0])\n        return CompileResult(copy.deepcopy(self.ir), (), MappingProxyType(copy.deepcopy(self.source_map)))\n\n","exit_code":0,"status":"completed"}}
