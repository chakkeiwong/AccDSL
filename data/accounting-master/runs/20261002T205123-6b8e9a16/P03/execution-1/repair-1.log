{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1900,2078p' scripts/core0_ir_v1.py\"","aggregated_output":"                raise _Failure(Diagnostic(\"SourceDigestMismatch\", \"document digest differs from binding\", row[\"id\"]))\n            review = reviews.get(row[\"review_decision\"])\n            if review is None or review[\"action\"] != \"Accept\" or review[\"reviewer\"] != reading.reviewer or review[\"date\"] != reading.review_date:\n                raise _Failure(Diagnostic(\"BindingAcceptance\", \"observation lacks the bound accepted review decision\", row[\"id\"]))\n            view = next((v for v in views.values() if row[\"id\"] in v[\"observations\"]), None)\n            if view is None or reading.cutoff != view[\"cutoff\"] or (view[\"system_as_of\"] != (reading.system_as_of or reading.ingested)):\n                raise _Failure(Diagnostic(\"EvidenceCutoff\", \"observation is not in the bound evidence view\", row[\"id\"]))\n        for row in ir[\"books\"]:\n            if row[\"package\"] not in package_rows:\n                raise _Failure(Diagnostic(\"PackageBinding\", \"book package is not locked\", row[\"id\"]))\n            if row[\"currency\"] != entities[row[\"entity\"]][\"functional_currency\"]:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"book currency differs from entity\", row[\"id\"]))\n        for row in ir[\"accounts\"]:\n            if (err := _ref(nodes, row[\"book\"], {\"books\"}, row[\"id\"])):\n                raise _Failure(err)\n            if row[\"id\"] not in _ACCOUNT_ROLES or row[\"role\"] != _ACCOUNT_ROLES[row[\"id\"]]:\n                raise _Failure(Diagnostic(\"PackageAccounts\", \"account role is outside the locked DemoDebt mapping\", row[\"id\"]))\n        if {r[\"id\"]: r[\"role\"] for r in ir[\"accounts\"]} != _ACCOUNT_ROLES:\n            raise _Failure(Diagnostic(\"PackageAccounts\", \"all four DemoDebt account roles are required\", \"accounts\"))\n        model_ids = {r[\"id\"] for r in ir[\"models\"]}\n        scope_ids = {r[\"id\"] for r in ir[\"modelScopes\"]}\n        if len(model_ids) != 1 or len(scope_ids) != 1:\n            raise _Failure(Diagnostic(\"ProfileCardinality\", \"one model and one model scope are required\", \"models\"))\n        admissions = {a.name: a for a in bindings.admissions}\n        for row in ir[\"symbols\"]:\n            if row[\"uncertainty_kind\"] != bindings.symbol_uncertainty or row[\"scope\"] not in model_ids:\n                raise _Failure(Diagnostic(\"SymbolAdmission\", \"symbol uncertainty or scope differs from bindings\", row[\"id\"]))\n            admission = admissions.get(row[\"id\"])\n            if admission is None or row[\"admission\"] != f\"admission:{row['id']}\" or not row[\"provenance\"]:\n                raise _Failure(Diagnostic(\"SymbolAdmission\", \"symbol admission/provenance is incomplete\", row[\"id\"]))\n            domain = row[\"domain\"]\n            if domain[\"kind\"] != \"interval\" or domain[\"lower\"] is None or domain[\"upper\"] is None:\n                raise _Failure(Diagnostic(\"InvalidDomain\", \"Core0.1 symbols require a closed interval\", row[\"id\"]))\n            if parse_rational(domain[\"lower\"]) > parse_rational(domain[\"upper\"]) or parse_rational(domain[\"lower\"]) < 0 or parse_rational(domain[\"upper\"]) > 1:\n                raise _Failure(Diagnostic(\"InvalidDomain\", \"alpha interval must lie inside [0,1]\", row[\"id\"]))\n        for row in ir[\"assumptions\"]:\n            if row[\"expression\"] not in {e[\"id\"] for e in ir[\"expressions\"]}:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"assumption expression is unknown\", row[\"id\"]))\n            if row[\"scope\"] not in model_ids | scope_ids and row[\"scope\"] not in {a[\"id\"] for a in ir[\"alternatives\"]} and row[\"scope\"] not in {c[\"id\"] for c in ir[\"contracts\"]} and row[\"scope\"] not in {s[\"id\"] for s in ir[\"scenarios\"]}:\n                raise _Failure(Diagnostic(\"AssumptionScope\", \"assumption scope is not declared\", row[\"id\"]))\n            valid = row[\"valid\"]\n            _time(\"interval\", valid[\"start\"], valid[\"end_exclusive\"], valid[\"calendar\"])\n            if valid[\"calendar\"] != bindings.calendar_id or valid[\"start\"] != bindings.horizon_start or valid[\"end_exclusive\"] != bindings.horizon_end:\n                raise _Failure(Diagnostic(\"AssumptionValidity\", \"assumption validity must cover the profile horizon\", row[\"id\"]))\n            _instant(row[\"information_cutoff\"], row[\"id\"])\n            if not row[\"rationale\"] or not row[\"source_refs\"] and row[\"provenance\"] != \"ScenarioDesign\":\n                raise _Failure(Diagnostic(\"MissingAssumption\", \"assumption rationale or source provenance is missing\", row[\"id\"]))\n            aid = row[\"id\"]\n            if aid.startswith(\"assumption:alternative_\"):\n                key = \"alternative\"\n            elif aid.startswith(\"assumption:contract_\"):\n                key = \"contract-rate\"\n            elif aid.startswith(\"assumption:scenario_\"):\n                key = \"scenario\"\n            elif aid.startswith(\"assumption:constraint_\"):\n                key = \"constraint\"\n            else:\n                key = None\n            if key is not None:\n                meta = bindings.assumption(key)\n                if (row[\"rationale\"] != meta.rationale or row[\"provenance\"] != meta.provenance or\n                        row[\"role\"] != meta.role or row[\"source_refs\"] != list(meta.source_refs) or row[\"information_cutoff\"] != meta.information_cutoff or\n                        row[\"valid\"][\"start\"] != meta.valid_start or row[\"valid\"][\"end_exclusive\"] != meta.valid_end):\n                    raise _Failure(Diagnostic(\"AssumptionBinding\", \"assumption metadata differs from explicit binding\", row[\"id\"]))\n        checker = _IRTypeChecker(ir, nodes)\n        for row in ir[\"expressions\"]:\n            checker.expr(row[\"id\"])\n        for row in ir[\"constraints\"]:\n            inferred = checker.expr(row[\"expression\"])\n            if inferred[0] != \"Bool\":\n                raise _Failure(Diagnostic(\"ConstraintType\", \"constraint expression must be Boolean\", row[\"id\"]))\n        for row in ir[\"contracts\"]:\n            if row[\"book\"] not in books:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"contract book is unknown\", row[\"id\"]))\n            if row[\"package\"] not in package_rows or row[\"type\"] != f\"{row['package']}/DebtMix\":\n                raise _Failure(Diagnostic(\"PackageBinding\", \"contract type/package is not locked\", row[\"id\"]))\n            if not row[\"source_refs\"]:\n                raise _Failure(Diagnostic(\"ContractProvenance\", \"contract requires source provenance\", row[\"id\"]))\n            fields = {f[\"name\"]: f[\"expression\"] for f in row[\"fields\"]}\n            if len(fields) != len(row[\"fields\"]) or set(fields) != {\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"}:\n                raise _Failure(Diagnostic(\"ContractFields\", \"contract fields are incomplete or duplicated\", row[\"id\"]))\n            expected = {\"principal\": f\"Money<{books[row['book']]['currency']}>\", \"fixed_fraction\": \"Real\",\n                        \"fixed_rate\": \"Rate<annual_simple>\", \"initial_floating_rate\": \"Rate<annual_simple>\"}\n            for name, typ in expected.items():\n                if checker.expr(fields[name])[0] != typ:\n                    raise _Failure(Diagnostic(\"ContractType\", f\"{name} has the wrong type\", row[\"id\"]))\n            low, high = _expression_bounds(fields[\"fixed_fraction\"], nodes)\n            if low < 0 or high > 1:\n                raise _Failure(Diagnostic(\"ContractDomain\", \"fixed fraction bounds must lie inside [0,1]\", row[\"id\"]))\n            principal = checker.expr(fields[\"principal\"])[2]\n            debt = bindings.readings[0].amount\n            if principal != debt or any(dict(o.balances).get(\"Debt\") != -debt for o in bindings.openings):\n                raise _Failure(Diagnostic(\"ContractPrincipal\", \"principal must equal accepted debt and opening liability\", row[\"id\"]))\n            for name in (\"fixed_rate\", \"initial_floating_rate\"):\n                value = checker.expr(fields[name])[2]\n                if not isinstance(value, Fraction) or value < 0:\n                    raise _Failure(Diagnostic(\"ContractDomain\", f\"{name} must be a nonnegative constant\", row[\"id\"]))\n        alternatives = {r[\"id\"]: r for r in ir[\"alternatives\"]}\n        for row in ir[\"alternatives\"]:\n            if row[\"parent\"] not in {r[\"id\"] for r in ir[\"historyFamilies\"]} or row[\"scope\"] not in scope_ids:\n                raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative parent or scope is unknown\", row[\"id\"]))\n            meta = next((a for a in bindings.alternatives if a.name == row[\"id\"]), None)\n            if meta is None or row[\"author\"] != meta.author or row[\"created_at\"] != meta.created_at or row[\"reason\"] != meta.reason:\n                raise _Failure(Diagnostic(\"AlternativeMetadata\", \"alternative metadata differs from binding\", row[\"id\"]))\n            if not row[\"constraints\"]:\n                raise _Failure(Diagnostic(\"MissingAlternativeCondition\", \"alternative requires at least one condition\", row[\"id\"]))\n            for cid in row[\"constraints\"]:\n                c = next((x for x in ir[\"constraints\"] if x[\"id\"] == cid), None)\n                if c is None or c[\"scope\"] != row[\"id\"] or checker.expr(c[\"expression\"])[0] != \"Bool\":\n                    raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative condition is not scoped to its branch\", row[\"id\"]))\n        for row in ir[\"states\"]:\n            total = Fraction(0); seen = set()\n            for balance in row[\"balances\"]:\n                if balance[\"account\"] in seen:\n                    raise _Failure(Diagnostic(\"DuplicateBalance\", \"opening account occurs twice\", row[\"id\"]))\n                seen.add(balance[\"account\"]); total += parse_rational(balance[\"signed_amount\"])\n            if total != 0:\n                raise _Failure(Diagnostic(\"UnbalancedState\", \"opening balances do not sum to zero\", row[\"id\"]))\n            expected_accounts = {a[\"id\"] for a in ir[\"accounts\"] if a[\"book\"] == row[\"book\"]}\n            if seen != expected_accounts:\n                raise _Failure(Diagnostic(\"IncompleteState\", \"opening state must include every account\", row[\"id\"]))\n            opening = next((o for o in bindings.openings\n                            if row[\"date\"] == o.date and row[\"book\"] == (o.book or row[\"book\"]) and\n                            {name: rational(value) for name, value in o.balances} ==\n                            {b[\"account\"]: b[\"signed_amount\"] for b in row[\"balances\"]}), None)\n            if opening is None:\n                raise _Failure(Diagnostic(\"OpeningStateMismatch\", \"opening state differs from bound opening export\", row[\"id\"]))\n            if row[\"contracts\"] != [c[\"id\"] for c in ir[\"contracts\"]]:\n                raise _Failure(Diagnostic(\"OpeningStateMismatch\", \"opening state must retain active contract\", row[\"id\"]))\n        for row in ir[\"historyFamilies\"]:\n            if row[\"feasibility\"] == \"Feasible\" and not row[\"witnesses\"]:\n                raise _Failure(Diagnostic(\"MissingWitness\", \"feasible family requires a witness\", row[\"id\"]))\n            if row[\"coverage\"] == \"ExactWithinScope\" and (row[\"unresolved_cells\"] or not row[\"completed_cells\"]):\n                raise _Failure(Diagnostic(\"FalseCoverage\", \"exact coverage requires completed cells and no unresolved cells\", row[\"id\"]))\n            if row[\"coverage\"] != \"PartialSearch\" or row[\"feasibility\"] != \"Unknown\" or row[\"completed_cells\"] != 0 or row[\"unresolved_cells\"] != 1:\n                raise _Failure(Diagnostic(\"CoverageClaim\", \"Core0.1 family must remain explicitly unsearched\", row[\"id\"]))\n            expected_constraints = {c[\"id\"] for c in ir[\"constraints\"] if c[\"scope\"] == row[\"scope\"]}\n            if set(row[\"constraints\"]) != expected_constraints or row[\"witnesses\"] or row[\"solver_results\"]:\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family must retain global constraints without invented search evidence\", row[\"id\"]))\n            if set(row[\"symbols\"]) != {s[\"id\"] for s in ir[\"symbols\"]} or set(row[\"alternatives\"]) != set(alternatives):\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family must retain all shared symbols and alternatives\", row[\"id\"]))\n            if row[\"evidence_view\"] not in views or row[\"opening_state\"] not in {s[\"id\"] for s in ir[\"states\"]}:\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family evidence/opening references are unknown\", row[\"id\"]))\n        for row in ir[\"scenarios\"]:\n            for driver in row[\"drivers\"]:\n                info = checker.expr(driver[\"expression\"])\n                if info[0] != \"Driver<Rate<annual_simple>>\" or not isinstance(info[2], Fraction) or info[2] < 0:\n                    raise _Failure(Diagnostic(\"ScenarioType\", \"scenario driver must be a constant annual rate\", row[\"id\"]))\n        for row in ir[\"reportMappings\"]:\n            if not row[\"rows\"] or row[\"rows\"][0][\"expression\"] not in checker.memo:\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping expression is not compiled\", row[\"id\"]))\n            rb = next((r for r in bindings.reports if r.key == row[\"id\"] or r.mapping == row[\"rows\"][0].get(\"value\")), None)\n            expr = nodes[row[\"rows\"][0][\"expression\"]][1]\n            rb = next((r for r in bindings.reports if r.mapping == expr[\"text\"]), None)\n            package_id = next(iter(packages))\n            if (rb is None or len(row[\"rows\"]) != 1 or expr[\"type\"] != \"SourceRef\"\n                    or row[\"closing_policy\"] != package_id + \"/\" + rb.closing_policy\n                    or row[\"cash_flow_policy\"] != package_id + \"/\" + rb.cash_flow_policy\n                    or row[\"required_operations\"] != [package_id + \"/\" + x for x in rb.required_operations]):\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report policies differ from binding\", row[\"id\"]))\n            if row[\"book\"] not in books or row[\"basis\"] not in package_rows or not row[\"required_operations\"]:\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping book/package/operations are incomplete\", row[\"id\"]))\n            if rb is None:\n                # The generated mapping uses a SourceRef literal; compare the\n                # text payload directly when an explicit row binding exists.\n                expr = next((e for e in ir[\"expressions\"] if e[\"id\"] == row[\"rows\"][0][\"expression\"]), None)\n                if expr is None or expr[\"type\"] != \"SourceRef\" or expr[\"text\"] not in {r.mapping for r in bindings.reports}:\n                    raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping is not bound to an explicit export\", row[\"id\"]))\n        if not ir[\"diagnostics\"]:\n            pass\n    except _Failure as exc:\n        return ValidationResult(False, (exc.diagnostic,))\n    except (KeyError, TypeError, ValueError, IndexError, ZeroDivisionError) as exc:\n        return ValidationResult(False, (_invalid(\"InvalidSemantics\", str(exc), \"ir\"),))\n    return ValidationResult(True, ())\n\n\n@dataclass(frozen=True)\nclass _Symbolic:\n","exit_code":0,"status":"completed"}}
