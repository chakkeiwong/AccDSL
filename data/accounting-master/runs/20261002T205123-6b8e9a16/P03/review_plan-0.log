elf, \"key\", key)\n        object.__setattr__(self, \"date\", date)\n        object.__setattr__(self, \"balances\", tuple((k, _fraction(v)) for k, v in _pairs(balances)))\n        object.__setattr__(self, \"book\", book)\n        object.__setattr__(self, \"contracts\", tuple(contracts))\n        object.__setattr__(self, \"dependencies\", tuple(dependencies))\n\n\n@dataclass(frozen=True)\nclass ReportBinding:\n    key: str\n    mapping: str\n    cash_flow_policy: str\n    closing_policy: str\n    required_operations: tuple[str, ...]\n\n    def __init__(self, key: str, mapping: str, cash_flow_policy: str,\n                 closing_policy: str, required_operations: Sequence[str]):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"mapping\", mapping)\n        object.__setattr__(self, \"cash_flow_policy\", cash_flow_policy)\n        object.__setattr__(self, \"closing_policy\", closing_policy)\n        object.__setattr__(self, \"required_operations\", tuple(required_operations))\n\n\n@dataclass(frozen=True)\nclass PackageBinding:\n    name: str\n    version: str\n    digest: str\n    basis: str\n    effective_start: str\n    effective_end: str\n    operations: tuple[str, ...]\n    dependencies: tuple[str, ...]\n    authority: tuple[str, ...]\n    review_status: str = \"illustrative\"\n    implementation: Optional[str] = None\n    contract_types: tuple[str, ...] = (\"DebtMix\",)\n    artifact: str = \"docs/design/fixtures/demo-debt-package.json\"\n\n    @property\n    def id(self) -> str:\n        return f\"{self.name}@{self.version}\"\n\n    def __init__(self, name: str, version: str, digest: str, basis: str,\n                 effective_start: str, effective_end: str,\n                 operations: Sequence[str], dependencies: Sequence[str],\n                 authority: Sequence[str], review_status: str = \"illustrative\",\n                 implementation: Optional[str] = None,\n                 contract_types: Sequence[str] = (\"DebtMix\",),\n                 artifact: str = \"docs/design/fixtures/demo-debt-package.json\"):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"version\", version)\n        object.__setattr__(self, \"digest\", digest)\n        object.__setattr__(self, \"basis\", basis)\n        object.__setattr__(self, \"effective_start\", effective_start)\n        object.__setattr__(self, \"effective_end\", effective_end)\n        object.__setattr__(self, \"operations\", tuple(operations))\n        object.__setattr__(self, \"dependencies\", tuple(dependencies))\n        object.__setattr__(self, \"authority\", tuple(authority))\n        object.__setattr__(self, \"review_status\", review_status)\n        object.__setattr__(self, \"implementation\", implementation)\n        object.__setattr__(self, \"contract_types\", tuple(contract_types))\n        object.__setattr__(self, \"artifact\", artifact)\n\n\n@dataclass(frozen=True)\nclass AssumptionBinding:\n    key: str\n    rationale: str\n    provenance: str = \"ScenarioDesign\"\n    role: str = \"Hypothesis\"\n    source_refs: tuple[str, ...] = ()\n    information_cutoff: Optional[str] = None\n    valid_start: Optional[str] = None\n    valid_end: Optional[str] = None\n\n    def __init__(self, key: str, rationale: str, provenance: str = \"ScenarioDesign\",\n                 role: str = \"Hypothesis\", source_refs: Sequence[str] = (),\n                 information_cutoff: Optional[str] = None,\n                 valid_start: Optional[str] = None, valid_end: Optional[str] = None):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"rationale\", rationale)\n        object.__setattr__(self, \"provenance\", provenance)\n        object.__setattr__(self, \"role\", role)\n        object.__setattr__(self, \"source_refs\", tuple(source_refs))\n        object.__setattr__(self, \"information_cutoff\", information_cutoff)\n        object.__setattr__(self, \"valid_start\", valid_start)\n        object.__setattr__(self, \"valid_end\", valid_end)\n\n\n@dataclass(frozen=True)\nclass SymbolAdmission:\n    name: str\n    reading_key: str\n    reason: str\n    reviewer: str\n    date: str\n    kind: str = \"HistoricalFact\"\n\n\n@dataclass(frozen=True)\nclass AlternativeBinding:\n    name: str\n    author: str\n    created_at: str\n    reason: str\n\n\n@dataclass(frozen=True)\nclass CompileBindings:\n    packages: tuple[PackageBinding, ...] = ()\n    readings: tuple[ReadingBinding, ...] = ()\n    openings: tuple[OpeningBinding, ...] = ()\n    reports: tuple[ReportBinding, ...] = ()\n    assumptions: tuple[AssumptionBinding, ...] = ()\n    calendar_id: str = \"DemoCalendar@1\"\n    calendar_name: str = \"Gregorian\"\n    horizon_start: str = \"2026-01-01\"\n    horizon_end: str = \"2027-01-01\"\n    symbol_uncertainty: str = \"HistoricalFact\"\n    entity_perimeter: str = \"Acme-only\"\n    admissions: tuple[SymbolAdmission, ...] = ()\n    alternatives: tuple[AlternativeBinding, ...] = ()\n\n    def __init__(self, packages: Sequence[PackageBinding] = (), readings: Sequence[ReadingBinding] = (),\n                 openings: Sequence[OpeningBinding] = (), reports: Sequence[ReportBinding] = (),\n                 assumptions: Sequence[AssumptionBinding] = (), calendar_id: str = \"DemoCalendar@1\",\n                 calendar_name: str = \"Gregorian\", horizon_start: str = \"2026-01-01\",\n                 horizon_end: str = \"2027-01-01\", symbol_uncertainty: str = \"HistoricalFact\",\n                 entity_perimeter: str = \"Acme-only\", admissions: Sequence[SymbolAdmission] = (),\n                 alternatives: Sequence[AlternativeBinding] = ()):\n        object.__setattr__(self, \"packages\", tuple(packages))\n        object.__setattr__(self, \"readings\", tuple(readings))\n        object.__setattr__(self, \"openings\", tuple(openings))\n        object.__setattr__(self, \"reports\", tuple(reports))\n        object.__setattr__(self, \"assumptions\", tuple(assumptions))\n        object.__setattr__(self, \"calendar_id\", calendar_id)\n        object.__setattr__(self, \"calendar_name\", calendar_name)\n        object.__setattr__(self, \"horizon_start\", horizon_start)\n        object.__setattr__(self, \"horizon_end\", horizon_end)\n        object.__setattr__(self, \"symbol_uncertainty\", symbol_uncertainty)\n        object.__setattr__(self, \"entity_perimeter\", entity_perimeter)\n        object.__setattr__(self, \"admissions\", tuple(admissions))\n        object.__setattr__(self, \"alternatives\", tuple(alternatives))\n\n    def admission(self, name: str) -> SymbolAdmission:\n        return _unique(self.admissions, \"name\", name, \"MissingSymbolAdmission\")\n\n    def alternative(self, name: str) -> AlternativeBinding:\n        return _unique(self.alternatives, \"name\", name, \"MissingAlternativeMetadata\")\n\n    def package(self, name: str, version: Optional[str] = None) -> PackageBinding:\n        candidates = [p for p in self.packages if p.name == name and (version is None or p.version == version)]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingPackageBinding\", f\"package {name!r} is not uniquely bound\", name))\n        return candidates[0]\n\n    def reading(self, key: str) -> ReadingBinding:\n        candidates = [r for r in self.readings if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"reading {key!r} is not bound\", key))\n        return candidates[0]\n\n    def opening(self, key: str) -> OpeningBinding:\n        candidates = [r for r in self.openings if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"opening {key!r} is not bound\", key))\n        return candidates[0]\n\n    def report(self, key: str) -> ReportBinding:\n        candidates = [r for r in self.reports if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"report mapping {key!r} is not bound\", key))\n        return candidates[0]\n\n    def assumption(self, key: str) -> AssumptionBinding:\n        candidates = [a for a in self.assumptions if a.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingAssumptionMetadata\", f\"assumption metadata {key!r} is not bound\", key))\n        return candidates[0]\n\n    @classmethod\n    def demo(cls, root: Path | str | None = None, principal: Fraction | int | str = 100,\n             stress_rate: Fraction | int | str = Fraction(7, 100),\n             fixed_rate: Fraction | int | str = Fraction(1, 20),\n             opening_balances: Mapping[str, Fraction | int | str] | None = None) -> \"CompileBindings\":\n        \"\"\"Create explicit synthetic bindings for the bounded demonstration profile.\n\n        This helper is a convenience for tests and examples.  The compiler\n        still receives all evidence/package/assumption records as arguments;\n        it does not inspect the authored expected IR.\n        \"\"\"\n        root_path = Path(root) if root is not None else ROOT\n        package_path = root_path / \"docs/design/fixtures/demo-debt-package.json\"\n        digest = hashlib.sha256(package_path.read_bytes()).hexdigest() if package_path.is_file() else \"\"\n        p = _fraction(principal)\n        stress = _fraction(stress_rate)\n        fixed = _fraction(fixed_rate)\n        literal = f\"Debt {p}; interest 5; fixed/floating split not disclosed\"\n        reading = ReadingBinding(\n            key=\"synthetic-note-7\", literal=literal, amount=p, currency=\"USD\",\n            instant=\"2025-12-31\", uri=\"fixture:demo-debt-package.json#registry/synthetic-note-7\",\n            filing_id=\"synthetic-2025\", available=\"2026-01-01T00:00:00Z\",\n            ingested=\"2026-01-01T00:00:00Z\", reviewer=\"synthetic-fixture-author\",\n            review_date=\"2026-01-01T00:00:00Z\",\n            review_reason=\"Explicit synthetic disclosure supplied by the caller\",\n            cutoff=\"2026-01-01T00:00:00Z\", action=\"Accept\")\n        balances = opening_balances if opening_balances is not None else {\"Cash\": p - 5, \"Debt\": -p, \"InterestExpense\": 0, \"Retained\": 5}\n        opening = OpeningBinding(\"after-2025-close\", \"2025-12-31\", balances, book=\"Local\")\n        package = PackageBinding(\n            \"DemoDebt\", \"1\", digest, \"DemoDebt\", \"2025-01-01\", \"2028-01-01\",\n            (\"reset\", \"accrue_and_pay\", \"close\", \"statements\"),\n            (\"builtin:Core0@1\", \"DemoCalendar@1\"), (\"fixture:demo-debt-package.json\",))\n        report = ReportBinding(\"DemoDebt.statements.v1\", \"DemoDebt.statements.v1\",\n                               \"interest_operating\", \"close\", (\"accrue_and_pay\",))\n        assumptions = tuple(AssumptionBinding(key, reason, information_cutoff=reading.cutoff,\n                           valid_start=\"2026-01-01\", valid_end=\"2027-01-01\") for key, reason in (\n            (\"alternative\", \"Named endpoint condition supplied for comparison\"),\n            (\"constraint\", \"Explicit caller constraint on the shared family\"),\n            (\"contract-rate\", \"Component rates are explicit scenario inputs supplied by the caller\"),\n            (\"scenario\", f\"Illustrative constant annual stress {stress}; not an estimated future rate\")))\n        # Retain values for callers that want to inspect the intended defaults;\n        # rate values remain in the typed/source program itself.\n        _ = fixed\n        admissions = (SymbolAdmission(\"alpha\", reading.key, \"Fixed-rate proportion not disclosed\",\n                                     \"synthetic-fixture-author\", reading.review_date),)\n        alternatives = tuple(AlternativeBinding(name, \"synthetic-fixture-author\", reading.review_date,\n                            \"Named endpoint hypothesis supplied by the synthetic caller\")\n                             for name in (\"allFixed\", \"allFloating\"))\n        return cls((package,), (reading,), (opening,), (report,), assumptions,\n                   admissions=admissions, alternatives=alternatives)\n\n\ndef _unique(rows, attr, key, code):\n    matches = [r for r in rows if getattr(r, attr) == key]\n    if len(matches) != 1:\n        raise _diag(code, f\"{key!r} must have exactly one explicit binding\", str(key))\n    return matches[0]\n\n\ndef _validate_bindings(bindings: CompileBindings) -> None:\n    \"\"\"Validate caller supplied metadata before any semantic lowering.\n\n    Bindings are facts supplied by the caller; they are never inferred from a\n    source declaration or from the authored expected IR.  This early pass\n    catches duplicate/ambiguous exports, invalid dates and unsafe package\n    artifacts so later lowering can rely on a single explicit record.\n    \"\"\"\n    if not isinstance(bindings, CompileBindings):\n        raise _diag(\"InvalidBindings\", \"compile bindings must be CompileBindings\", \"bindings\")\n\n    def unique(rows: Sequence[Any], attr: str, where: str) -> None:\n        values = [getattr(row, attr) for row in rows]\n        if len(values) != len(set(values)):\n            raise _diag(\"AmbiguousBinding\", f\"duplicate {attr} in {where}\", where)\n\n    unique(bindings.packages, \"id\", \"packages\")\n    unique(bindings.readings, \"key\", \"readings\")\n    unique(bindings.openings, \"key\", \"openings\")\n    unique(bindings.reports, \"key\", \"reports\")\n    unique(bindings.assumptions, \"key\", \"assumptions\")\n    unique(bindings.admissions, \"name\", \"admissions\")\n    unique(bindings.alternatives, \"name\", \"alternatives\")\n\n    try:\n        _iso(bindings.horizon_start, \"bindings.horizon_start\")\n        _iso(bindings.horizon_end, \"bindings.horizon_end\")\n        if date.fromisoformat(bindings.horizon_end) <= date.fromisoformat(bindings.horizon_start):\n            raise _diag(\"InvalidPeriod\", \"horizon end must be after start\", \"bindings.horizon\")\n    except _Failure:\n        raise\n    if bindings.calendar_id != \"DemoCalendar@1\" or bindings.calendar_name != \"Gregorian\":\n        raise _diag(\"UnsupportedCalendar\", \"Core0.1 requires DemoCalendar@1/Gregorian\", \"bindings.calendar\")\n    if bindings.symbol_uncertainty not in {\"HistoricalFact\"}:\n        raise _diag(\"UnsupportedUncertainty\", \"Core0.1 admits only HistoricalFact symbols\", \"bindings.symbol_uncertainty\")\n\n    package_root = ROOT.resolve()\n    for package in bindings.packages:\n        if package.name != \"DemoDebt\" or package.version != \"1\":\n            raise _diag(\"UnsupportedPackage\", \"Core0.1 requires DemoDebt@1\", package.id)\n        if not re.fullmatch(r\"[0-9a-f]{64}\", package.digest):\n            raise _diag(\"InvalidPackageDigest\", \"package digest must be a SHA-256 hex digest\", package.id)\n        try:\n            start = date.fromisoformat(package.effective_start)\n            end = date.fromisoformat(package.effective_end)\n        except ValueError as exc:\n            raise _diag(\"InvalidDate\", \"package applicability dates must be YYYY-MM-DD\", package.id) from exc\n        if end <= start:\n            raise _diag(\"InvalidPeriod\", \"package effective end must be after start\", package.id)\n        artifact = (ROOT / package.artifact).resolve()\n        if not artifact.is_relative_to(package_root) or not artifact.is_file():\n            raise _diag(\"UnsafePackageArtifact\", \"package artifact must be an existing project-local file\", package.id)\n        if hashlib.sha256(artifact.read_bytes()).hexdigest() != package.digest:\n            raise _diag(\"PackageDigestMismatch\", \"package artifact digest differs from binding\", package.id)\n        if package.basis != package.name or \"builtin:Core0@1\" not in package.dependencies or \"DemoCalendar@1\" not in package.dependencies:\n            raise _diag(\"PackageBinding\", \"package basis/dependencies are not the locked Core0 set\", package.id)\n        if set(package.operations) != {\"reset\", \"accrue_and_pay\", \"close\", \"statements\"}:\n            raise _diag(\"PackageBinding\", \"package operations differ from the retained DemoDebt export\", package.id)\n        if any(not str(a) or \"..\" in str(a) for a in package.authority):\n            raise _diag(\"UnsafePackageAuthority\", \"package authority contains an unsafe path\", package.id)\n\n    for reading in bindings.readings:\n        if not reading.key or not reading.currency or reading.action != \"Accept\":\n            raise _diag(\"BindingAcceptance\", \"readings require an explicit Accept action\", reading.key or \"reading\")\n        _iso(reading.instant, f\"reading:{reading.key}.instant\")\n        for label, value in ((\"available\", reading.available), (\"ingested\", reading.ingested),\n                             (\"review_date\", reading.review_date), (\"cutoff\", reading.cutoff)):\n            _instant(value, f\"reading:{reading.key}.{label}\")\n        if reading.system_as_of is not None:\n            _instant(reading.system_as_of, f\"reading:{reading.key}.system_as_of\")\n","exit_code":0,"status":"completed"}}
