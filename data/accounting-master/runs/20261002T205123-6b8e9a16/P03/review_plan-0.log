{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' scripts/core0_ir_v1.py\"","aggregated_output":"\"\"\"Core 0.1 source-independent typed IR and bounded lowering profile.\n\nThe module deliberately implements a small, explicit profile.  It does not\nload an authored expected IR and it does not infer missing evidence, review,\npackage, or accounting metadata.  Callers provide those facts through\n``CompileBindings``.  ``core0_frontends_v1`` supplies the textual parser; this\nmodule is also the typed-library entrypoint.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field, fields, is_dataclass\nfrom datetime import date, datetime, timezone\nfrom decimal import Decimal, InvalidOperation\nfrom fractions import Fraction\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport unicodedata\nfrom types import MappingProxyType\nfrom typing import Any, Iterable, Mapping, Optional, Sequence\n\ntry:  # The repository already uses jsonschema; no new dependency is added.\n    import jsonschema\nexcept Exception:  # pragma: no cover - reported by validation when absent.\n    jsonschema = None\n\n\nROOT = Path(__file__).resolve().parents[1]\nSCHEMA_PATH = ROOT / \"docs/design/spec/core-ir.schema.json\"\n\n# The executable profile is deliberately limited to the four account roles\n# exported by the retained DemoDebt package.  Keeping this mapping explicit\n# prevents a caller from changing the accounting perimeter by supplying a\n# different role table through bindings.\n_ACCOUNT_ROLES = {\n    \"Cash\": \"Asset\",\n    \"Debt\": \"Liability\",\n    \"InterestExpense\": \"Expense\",\n    \"Retained\": \"Equity\",\n}\n\n\nclass _Failure(Exception):\n    def __init__(self, diagnostic: \"Diagnostic\"):\n        self.diagnostic = diagnostic\n        super().__init__(diagnostic.message)\n\n\n@dataclass(frozen=True)\nclass Diagnostic:\n    code: str\n    message: str\n    location: str = \"program\"\n    severity: str = \"error\"\n    capability: Optional[str] = None\n    span: Optional[tuple[int, int]] = None\n\n    def as_dict(self) -> dict[str, Any]:\n        return {\n            \"code\": self.code,\n            \"message\": self.message,\n            \"location\": self.location,\n            \"severity\": self.severity,\n            \"capability\": self.capability,\n            \"span\": list(self.span) if self.span is not None else None,\n        }\n\n\n@dataclass(frozen=True)\nclass CompileResult:\n    ir: Optional[dict[str, Any]]\n    diagnostics: tuple[Diagnostic, ...] = ()\n    source_map: Mapping[str, Mapping[str, Any]] = field(default_factory=dict)\n    input_sha256: Optional[str] = None\n    binding_records: Mapping[str, Any] = field(default_factory=dict)\n\n    @property\n    def ok(self) -> bool:\n        return self.ir is not None and not self.diagnostics\n\n    @property\n    def semantic_projection(self) -> Optional[dict[str, Any]]:\n        return {\"ir\": semantic_projection(self.ir), \"bindings\": dict(self.binding_records)} if self.ir is not None else None\n\n\n@dataclass(frozen=True)\nclass ValidationResult:\n    valid: bool\n    diagnostics: tuple[Diagnostic, ...] = ()\n\n    @property\n    def ok(self) -> bool:\n        return self.valid and not self.diagnostics\n\n\ndef _pairs(value: Mapping[str, Any] | Iterable[tuple[str, Any]] | None) -> tuple[tuple[str, Any], ...]:\n    if value is None:\n        return ()\n    if isinstance(value, Mapping):\n        return tuple((str(k), v) for k, v in value.items())\n    return tuple((str(k), v) for k, v in value)\n\n\ndef _tuple(value: Iterable[Any] | None) -> tuple[Any, ...]:\n    return tuple(value or ())\n\n\ndef _fraction(value: Fraction | int | str | Decimal) -> Fraction:\n    if isinstance(value, Fraction):\n        return value\n    if isinstance(value, int):\n        return Fraction(value, 1)\n    if isinstance(value, Decimal):\n        return Fraction(value)\n    if isinstance(value, str):\n        try:\n            return Fraction(Decimal(value))\n        except (InvalidOperation, ValueError, ZeroDivisionError) as exc:\n            raise ValueError(f\"invalid decimal literal {value!r}\") from exc\n    raise TypeError(f\"unsupported numeric value {type(value)!r}\")\n\n\ndef rational(value: Fraction | int | str | Decimal) -> dict[str, str]:\n    q = _fraction(value)\n    return {\"n\": str(q.numerator), \"d\": str(q.denominator)}\n\n\ndef parse_rational(value: Mapping[str, str]) -> Fraction:\n    try:\n        n, d = int(value[\"n\"]), int(value[\"d\"])\n    except (KeyError, TypeError, ValueError) as exc:\n        raise ValueError(\"invalid rational\") from exc\n    if d <= 0:\n        raise ValueError(\"invalid rational denominator\")\n    q = Fraction(n, d)\n    if (str(q.numerator), str(q.denominator)) != (value[\"n\"], value[\"d\"]):\n        raise ValueError(\"noncanonical rational\")\n    return q\n\n\ndef _clean_id(value: str) -> str:\n    value = re.sub(r\"[^A-Za-z0-9_.-]+\", \"_\", value)\n    return value.strip(\".\") or \"anonymous\"\n\n\ndef _iso(value: str, where: str) -> str:\n    try:\n        parsed = date.fromisoformat(value)\n    except ValueError as exc:\n        raise _Failure(Diagnostic(\"InvalidDate\", f\"{value!r} is not a Gregorian date\", where)) from exc\n    if parsed.isoformat() != value:\n        raise _Failure(Diagnostic(\"InvalidDate\", f\"use canonical YYYY-MM-DD for {value!r}\", where))\n    return value\n\n\ndef _string(value: str) -> str:\n    if any(0xD800 <= ord(c) <= 0xDFFF for c in value):\n        raise _diag(\"InvalidString\", \"unpaired Unicode surrogate\", \"string\")\n    return unicodedata.normalize(\"NFC\", value)\n\n\ndef binding_projection(value: Any) -> Any:\n    \"\"\"JSON-compatible, complete typed inputs, including external records.\"\"\"\n    if isinstance(value, Fraction):\n        return rational(value)\n    if isinstance(value, Decimal):\n        return rational(value)\n    if is_dataclass(value):\n        return {\"constructor\": type(value).__name__, **{f.name: binding_projection(getattr(value, f.name)) for f in fields(value)}}\n    if isinstance(value, (list, tuple)):\n        return [binding_projection(v) for v in value]\n    if isinstance(value, Mapping):\n        return {k: binding_projection(v) for k, v in value.items()}\n    return value\n\n\ndef _instant(value: str, where: str) -> str:\n    try:\n        parsed = datetime.fromisoformat(value.replace(\"Z\", \"+00:00\"))\n    except ValueError as exc:\n        raise _Failure(Diagnostic(\"InvalidTimestamp\", f\"invalid timestamp {value!r}\", where)) from exc\n    if parsed.tzinfo is None:\n        raise _Failure(Diagnostic(\"MissingTimezone\", \"timestamps require an explicit timezone\", where))\n    return value\n\n\ndef _time(kind: str, start: str, end: Optional[str], calendar: str) -> dict[str, Any]:\n    _iso(start, \"time.start\")\n    if kind == \"interval\":\n        if end is None or date.fromisoformat(end) <= date.fromisoformat(start):\n            raise _Failure(Diagnostic(\"InvalidPeriod\", \"interval end must be after start\", \"time\"))\n        _iso(end, \"time.end_exclusive\")\n    elif end is not None:\n        raise _Failure(Diagnostic(\"InvalidPeriod\", \"instant cannot have an end\", \"time\"))\n    return {\"kind\": kind, \"start\": start, \"end_exclusive\": end, \"calendar\": calendar}\n\n\n# ---------------------------------------------------------------------------\n# Typed-library constructors\n\n\n@dataclass(frozen=True)\nclass Expr:\n    \"\"\"Marker class for typed expressions.\"\"\"\n\n\n@dataclass(frozen=True)\nclass Literal(Expr):\n    value: Any\n    type_name: Optional[str] = None\n    unit: Optional[str] = None\n    display: Optional[str] = None\n\n\n@dataclass(frozen=True)\nclass Ref(Expr):\n    name: str\n\n\n@dataclass(frozen=True)\nclass External(Expr):\n    key: str\n\n\n@dataclass(frozen=True)\nclass Call(Expr):\n    name: str\n    args: tuple[Expr, ...] = ()\n\n    def __init__(self, name: str, args: Sequence[Expr] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"args\", tuple(args))\n\n\n@dataclass(frozen=True)\nclass Binary(Expr):\n    op: str\n    left: Expr\n    right: Expr\n\n\n@dataclass(frozen=True)\nclass Unary(Expr):\n    op: str\n    arg: Expr\n\n\n@dataclass(frozen=True)\nclass ArrayExpr(Expr):\n    items: tuple[Expr, ...] = ()\n\n    def __init__(self, items: Sequence[Expr] = ()):\n        object.__setattr__(self, \"items\", tuple(items))\n\n\n@dataclass(frozen=True)\nclass RecordExpr(Expr):\n    fields: tuple[tuple[str, Expr], ...] = ()\n\n    def __init__(self, fields: Mapping[str, Expr] | Sequence[tuple[str, Expr]] = ()):\n        object.__setattr__(self, \"fields\", _pairs(fields))\n\n\n@dataclass(frozen=True)\nclass UseDecl:\n    name: str\n    version: str\n\n\n@dataclass(frozen=True)\nclass SourceDecl:\n    name: str\n    external: str\n\n\n@dataclass(frozen=True)\nclass EntityDecl:\n    name: str\n    currency: str\n\n\n@dataclass(frozen=True)\nclass BookDecl:\n    name: str\n    entity: str\n    basis: str\n    version: str\n\n\n@dataclass(frozen=True)\nclass AccountDecl:\n    name: str\n    role: str\n    book: str\n\n\n@dataclass(frozen=True)\nclass OpeningDecl:\n    name: str\n    book: str\n    external: str\n\n\n@dataclass(frozen=True)\nclass ObservationDecl:\n    name: str\n    type_name: str\n    instant: str\n    value: Expr\n    source: str\n\n\n@dataclass(frozen=True)\nclass SymbolDecl:\n    name: str\n    type_name: str\n    lower: Expr\n    upper: Expr\n    reason: str\n\n\n@dataclass(frozen=True)\nclass LetDecl:\n    name: str\n    value: Expr\n    declared_type: Optional[str] = None\n\n\n@dataclass(frozen=True)\nclass ConstraintDecl:\n    name: str\n    expression: Expr\n\n\n@dataclass(frozen=True)\nclass ContractDecl:\n    name: str\n    type_name: str\n    book: str\n    fields: tuple[tuple[str, Expr], ...] = ()\n\n    def __init__(self, name: str, type_name: str, book: str,\n                 fields: Mapping[str, Expr] | Sequence[tuple[str, Expr]] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"type_name\", type_name)\n        object.__setattr__(self, \"book\", book)\n        object.__setattr__(self, \"fields\", _pairs(fields))\n\n\n@dataclass(frozen=True)\nclass AlternativeDecl:\n    name: str\n    assumptions: tuple[Expr, ...] = ()\n\n    def __init__(self, name: str, assumptions: Sequence[Expr] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"assumptions\", tuple(assumptions))\n","exit_code":0,"status":"completed"}}
