{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1560,2075p' scripts/core0_ir_v1.py\"","aggregated_output":"        return None\n    return left and right if op == \"and\" else left or right\n\n\ndef compile_program(program: Program, bindings: CompileBindings,\n                    *, source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,\n                    input_text: Optional[str] = None) -> CompileResult:\n    \"\"\"Lower a typed ``Program`` through the shared Core0.1 stages.\"\"\"\n    if not isinstance(program, Program):\n        raise TypeError(\"compile_program requires a Program constructed from typed declarations\")\n    input_sha256 = hashlib.sha256(input_text.encode(\"utf-8\")).hexdigest() if input_text is not None else None\n    try:\n        result = _Compiler(program, bindings, source_spans, input_text).build()\n        if input_sha256 is None:\n            input_sha256 = hashlib.sha256(json.dumps(binding_projection(program), sort_keys=True).encode()).hexdigest()\n        return CompileResult(result.ir, result.diagnostics, result.source_map, input_sha256, binding_projection(bindings))\n    except _Failure as exc:\n        return CompileResult(None, (exc.diagnostic,), MappingProxyType({}),\n                             input_sha256)\n\n\n# ---------------------------------------------------------------------------\n# IR validation and exact evaluation\n\n\ndef _load_schema() -> dict[str, Any]:\n    try:\n        return json.loads(SCHEMA_PATH.read_text(encoding=\"utf-8\"))\n    except OSError as exc:\n        raise RuntimeError(f\"cannot read closed Core IR schema: {SCHEMA_PATH}\") from exc\n\n\ndef _invalid(code: str, message: str, location: str) -> Diagnostic:\n    return Diagnostic(code, message, location)\n\n\ndef _nodes(ir: Mapping[str, Any]) -> tuple[dict[str, tuple[str, Mapping[str, Any]]], Optional[Diagnostic]]:\n    nodes: dict[str, tuple[str, Mapping[str, Any]]] = {}\n    for section, rows in ir.items():\n        if not isinstance(rows, list):\n            continue\n        for row in rows:\n            if not isinstance(row, Mapping) or \"id\" not in row:\n                continue\n            identifier = row[\"id\"]\n            if identifier in nodes:\n                return {}, _invalid(\"DuplicateID\", f\"identifier {identifier!r} occurs more than once\", identifier)\n            nodes[identifier] = (section, row)\n    return nodes, None\n\n\ndef _ref(nodes: Mapping[str, tuple[str, Mapping[str, Any]]], identifier: str,\n         sections: Optional[set[str]], where: str) -> Optional[Diagnostic]:\n    if identifier not in nodes:\n        return _invalid(\"UnknownReference\", f\"unknown reference {identifier!r}\", where)\n    if sections and nodes[identifier][0] not in sections:\n        return _invalid(\"ReferenceKind\", f\"{identifier!r} has kind {nodes[identifier][0]}, expected {sorted(sections)}\", where)\n    return None\n\n\nclass _IRTypeChecker:\n    def __init__(self, ir: Mapping[str, Any], nodes: Mapping[str, tuple[str, Mapping[str, Any]]]):\n        self.ir, self.nodes = ir, nodes\n        self.memo: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.active: set[str] = set()\n\n    def expr(self, identifier: str) -> tuple[str, Optional[str], Any]:\n        if identifier in self.memo:\n            return self.memo[identifier]\n        if identifier in self.active:\n            raise _Failure(Diagnostic(\"ExpressionCycle\", \"cyclic expression dependency\", identifier))\n        if identifier not in self.nodes or self.nodes[identifier][0] != \"expressions\":\n            raise _Failure(Diagnostic(\"UnknownReference\", f\"expression {identifier!r} is not declared\", identifier))\n        self.active.add(identifier)\n        e = self.nodes[identifier][1]\n        op, target = e[\"op\"], e[\"target\"]\n        args = [self.expr(a) for a in e[\"args\"]]\n        types = [a[0] for a in args]\n        contexts = [a[1] for a in args]\n        context = next((c for c in contexts if c is not None), None)\n        if any(c is not None and context is not None and c != context for c in contexts):\n            raise _Failure(Diagnostic(\"ContextMismatch\", \"expression operands use incompatible contexts\", identifier))\n        if op == \"literal\":\n            if e[\"args\"] or e[\"target\"] is not None or e[\"field_names\"]:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"literal cannot have operands, target or fields\", identifier))\n            if (e[\"rational\"] is None) == (e[\"text\"] is None):\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"literal requires exactly one payload\", identifier))\n            if e[\"rational\"] is not None:\n                value = parse_rational(e[\"rational\"])\n                if not _numeric_type(e[\"type\"]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"rational literal must have a numeric type\", identifier))\n                if e[\"type\"] == \"Int\" and value.denominator != 1:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"fractional integer literal\", identifier))\n            elif e[\"text\"] is not None:\n                value = e[\"text\"]\n                if e[\"type\"] == \"Bool\" and value not in {\"true\", \"false\"}:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"Boolean text literal must be true or false\", identifier))\n                if e[\"type\"] == \"Date\":\n                    _iso(value, identifier)\n                if e[\"type\"] == \"SourceRef\":\n                    # SourceRef text is checked below against supplied report\n                    # bindings; here it must at least be a nonempty string.\n                    if not value:\n                        raise _Failure(Diagnostic(\"ExpressionPayload\", \"SourceRef cannot be empty\", identifier))\n                if e[\"type\"] not in {\"String\", \"Bool\", \"Date\", \"SourceRef\"}:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"text literal has unsupported type\", identifier))\n            result, context = e[\"type\"], e[\"context\"]\n        elif op == \"ref\":\n            if e[\"args\"] or e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"] or target is None:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"reference has an invalid payload\", identifier))\n            if target not in self.nodes:\n                raise _Failure(Diagnostic(\"UnknownReference\", f\"reference {target!r} is not declared\", identifier))\n            section, row = self.nodes[target]\n            if section == \"expressions\":\n                result, context, value = self.expr(target)\n            elif section == \"symbols\":\n                result, context, value = row[\"type\"], row[\"context\"], None\n            elif section == \"observations\":\n                ctx = self.nodes[row[\"context\"]][1]\n                result, context, value = f\"Observation<Money<{ctx['currency']}>>\", row[\"context\"], None\n            else:\n                raise _Failure(Diagnostic(\"ReferenceKind\", f\"cannot reference {section} from expression\", identifier))\n            value = None\n        elif op == \"call\":\n            if e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"] or target is None:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"call has an invalid payload\", identifier))\n            if target == \"builtin:value@1\":\n                if len(args) != 1 or not types or not types[0].startswith(\"Observation<\"):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"value requires one observation\", identifier))\n                result, context = types[0][12:-1], args[0][1]\n                value = args[0][2]\n            elif target == \"builtin:constant@1\":\n                if len(args) != 1 or not types or types[0] != \"Rate<annual_simple>\":\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"constant requires one annual rate\", identifier))\n                result, context, value = f\"Driver<{types[0]}>\", args[0][1], args[0][2]\n            else:\n                raise _Failure(Diagnostic(\"UnsupportedExpression\", \"unknown builtin call\", identifier))\n        else:\n            if target is not None or e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"]:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"operator has an invalid payload\", identifier))\n            arity = 1 if op in {\"negate\", \"not\"} else 2\n            if len(args) != arity:\n                raise _Failure(Diagnostic(\"ArityMismatch\", \"wrong expression arity\", identifier))\n            if op in {\"not\", \"and\", \"or\"}:\n                if any(t != \"Bool\" for t in types):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"Boolean operands required\", identifier))\n                result, context = \"Bool\", None\n                value = None\n            elif op in {\"eq\", \"ne\", \"lt\", \"le\", \"gt\", \"ge\"}:\n                if types[0] != types[1]:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"comparison types differ\", identifier))\n                if op not in {\"eq\", \"ne\"} and not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"ordering requires numeric operands\", identifier))\n                result, context, value = \"Bool\", None, None\n            elif op in {\"add\", \"subtract\"}:\n                if types[0] != types[1] or not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"compatible numeric operands required\", identifier))\n                result, context, value = types[0], context, None\n            elif op == \"negate\":\n                if not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"numeric operand required\", identifier))\n                result, context, value = types[0], args[0][1], None\n            elif op in {\"multiply\", \"divide\"}:\n                if not _numeric_type(types[0]) or not _numeric_type(types[1]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"numeric operands required\", identifier))\n                if op == \"divide\" and not _is_scalar(types[1]):\n                    raise _Failure(Diagnostic(\"UnsupportedOperation\", \"divisor must be scalar\", identifier))\n                if op == \"divide\" and not isinstance(args[1][2], Fraction):\n                    raise _Failure(Diagnostic(\"UnprovedNonzeroDenominator\", \"divisor must be constant\", identifier))\n                if op == \"divide\" and args[1][2] == 0:\n                    raise _Failure(Diagnostic(\"UnprovedNonzeroDenominator\", \"divisor is zero\", identifier))\n                if op == \"multiply\":\n                    if _is_scalar(types[0]) and not _is_scalar(types[1]):\n                        result = types[1]\n                    elif _is_scalar(types[1]) and not _is_scalar(types[0]):\n                        result = types[0]\n                    elif _is_scalar(types[0]) and _is_scalar(types[1]):\n                        result = \"Int\" if types[0] == types[1] == \"Int\" else \"Real\"\n                    else:\n                        raise _Failure(Diagnostic(\"UnsupportedOperation\", \"product of two dimensional quantities is unsupported\", identifier))\n                else:\n                    result = types[0] if not _is_scalar(types[0]) else \"Real\"\n                context, value = context, None\n            else:\n                raise _Failure(Diagnostic(\"UnsupportedExpression\", f\"operator {op!r} unsupported\", identifier))\n        declared = (e[\"type\"], e[\"context\"])\n        if declared != (result, context):\n            raise _Failure(Diagnostic(\"TypeMismatch\", f\"declared {declared}, inferred {(result, context)}\", identifier))\n        self.active.remove(identifier)\n        self.memo[identifier] = (result, context, value)\n        return self.memo[identifier]\n\n\ndef validate_ir(ir: Mapping[str, Any], bindings: CompileBindings,\n                *, schema: Optional[Mapping[str, Any]] = None) -> ValidationResult:\n    \"\"\"Validate closed-schema shape and independent Core0.1 semantics.\"\"\"\n    if not isinstance(ir, Mapping):\n        return ValidationResult(False, (_invalid(\"StructuralError\", \"IR must be a mapping\", \"ir\"),))\n    try:\n        _validate_bindings(bindings)\n    except _Failure as exc:\n        return ValidationResult(False, (exc.diagnostic,))\n    schema = schema or _load_schema()\n    if jsonschema is None:\n        return ValidationResult(False, (_invalid(\"MissingDependency\", \"jsonschema is required for closed-schema validation\", \"validator\"),))\n    try:\n        jsonschema.Draft202012Validator(schema).validate(ir)\n    except jsonschema.ValidationError as exc:\n        return ValidationResult(False, (_invalid(\"StructuralError\", exc.message, \"/\".join(map(str, exc.path))),))\n    nodes, duplicate = _nodes(ir)\n    if duplicate:\n        return ValidationResult(False, (duplicate,))\n    try:\n        packages = {p.id: p for p in bindings.packages}\n        package_rows = {r[\"id\"]: r for r in ir[\"packages\"]}\n        if set(package_rows) != set(packages):\n            raise _Failure(Diagnostic(\"PackageBinding\", \"IR package lock differs from supplied package bindings\", \"packages\"))\n        for pid, package in packages.items():\n            row = package_rows[pid]\n            if (row[\"version\"] != package.version or row[\"digest\"] != package.digest or\n                    row[\"basis\"] != package.basis or row[\"dependencies\"] != list(package.dependencies) or\n                    row[\"authority\"] != list(package.authority) or row[\"review_status\"] != package.review_status or\n                    row[\"implementation\"] != package.implementation):\n                raise _Failure(Diagnostic(\"PackageDigestMismatch\", \"package digest/basis differs from binding\", pid))\n            if row[\"operations\"] != [f\"{pid}/{x}\" for x in package.operations]:\n                raise _Failure(Diagnostic(\"PackageBinding\", \"package operation lock differs from binding\", pid))\n            effective = row[\"effective\"]\n            if effective[\"calendar\"] != bindings.calendar_id or effective[\"start\"] != package.effective_start or effective[\"end_exclusive\"] != package.effective_end:\n                raise _Failure(Diagnostic(\"PackageValidity\", \"package applicability differs from binding\", pid))\n            if date.fromisoformat(effective[\"start\"]) >= date.fromisoformat(bindings.horizon_end) or date.fromisoformat(effective[\"end_exclusive\"]) <= date.fromisoformat(bindings.horizon_start):\n                raise _Failure(Diagnostic(\"PackageValidity\", \"package does not cover the requested horizon\", pid))\n        entities = {r[\"id\"]: r for r in ir[\"entities\"]}\n        books = {r[\"id\"]: r for r in ir[\"books\"]}\n        if len(entities) != 1 or len(books) != 1:\n            raise _Failure(Diagnostic(\"ProfileCardinality\", \"one entity and book are required\", \"profile\"))\n        for row in ir[\"contexts\"]:\n            if (err := _ref(nodes, row[\"entity\"], {\"entities\"}, row[\"id\"])):\n                raise _Failure(err)\n            if row[\"basis\"] != next(iter(packages)) or row[\"currency\"] != row[\"unit\"] or row[\"currency\"] != entities[row[\"entity\"]][\"functional_currency\"]:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"context basis, unit and currency disagree\", row[\"id\"]))\n            _time(\"instant\" if row[\"time\"][\"kind\"] == \"instant\" else \"interval\", row[\"time\"][\"start\"], row[\"time\"][\"end_exclusive\"], row[\"time\"][\"calendar\"])\n            if row[\"time\"][\"calendar\"] != bindings.calendar_id or row[\"perimeter\"] != bindings.entity_perimeter:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"context calendar or perimeter differs from bindings\", row[\"id\"]))\n        for row in ir[\"sourceSpans\"]:\n            if (err := _ref(nodes, row[\"document\"], {\"documents\"}, row[\"id\"])):\n                raise _Failure(err)\n        for row in ir[\"documents\"]:\n            _instant(row[\"available\"], row[\"id\"]); _instant(row[\"ingested\"], row[\"id\"])\n        reviews = {r[\"id\"]: r for r in ir[\"reviewDecisions\"]}\n        views = {r[\"id\"]: r for r in ir[\"evidenceViews\"]}\n        spans = {r[\"id\"]: r for r in ir[\"sourceSpans\"]}\n        documents = {r[\"id\"]: r for r in ir[\"documents\"]}\n        observations = {r[\"id\"]: r for r in ir[\"observations\"]}\n        for row in ir[\"reviewDecisions\"]:\n            if row[\"action\"] not in {\"Accept\", \"AcceptAlternative\", \"Propose\", \"Reject\", \"Supersede\"}:\n                raise _Failure(Diagnostic(\"ReviewAction\", \"unsupported review action\", row[\"id\"]))\n            if not row[\"reviewer\"] or not row[\"reason\"] or not row[\"evidence\"]:\n                raise _Failure(Diagnostic(\"IncompleteReview\", \"review decisions require reviewer, reason and evidence\", row[\"id\"]))\n            for sid in row[\"evidence\"]:\n                if sid not in spans:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"review evidence span is unknown\", row[\"id\"]))\n            for rid in row[\"reading_ids\"]:\n                if not rid.startswith(\"reading:\"):\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"review reading id is malformed\", row[\"id\"]))\n        for row in ir[\"evidenceViews\"]:\n            _instant(row[\"cutoff\"], row[\"id\"])\n            if row[\"system_as_of\"] is not None:\n                _instant(row[\"system_as_of\"], row[\"id\"])\n            for did in row[\"documents\"]:\n                if did not in documents:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence document is unknown\", row[\"id\"]))\n            for sid in row[\"decisions\"]:\n                if sid not in reviews:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence decision is unknown\", row[\"id\"]))\n            for oid in row[\"observations\"]:\n                if oid not in observations:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence observation is unknown\", row[\"id\"]))\n        for row in ir[\"observations\"]:\n            if (err := _ref(nodes, row[\"context\"], {\"contexts\"}, row[\"id\"])):\n                raise _Failure(err)\n            for rid in row[\"source_spans\"]:\n                if (err := _ref(nodes, rid, {\"sourceSpans\"}, row[\"id\"])):\n                    raise _Failure(err)\n            reading_key = next((r.key for r in bindings.readings if f\"reading:{_clean_id(r.key)}\" == row[\"reading\"]), None)\n            if reading_key is None:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"observation reading is not bound\", row[\"id\"]))\n            reading = bindings.reading(reading_key)\n            if row[\"domain\"][\"lower\"] != rational(reading.amount) or row[\"domain\"][\"upper\"] != rational(reading.amount):\n                raise _Failure(Diagnostic(\"SourceReadingMismatch\", \"observation domain differs from bound reading\", row[\"id\"]))\n            document_id = f\"document:{_clean_id(reading.key)}\"\n            span = next((s for s in ir[\"sourceSpans\"] if s[\"id\"] in row[\"source_spans\"]), None)\n            if span is None or span[\"literal\"] != reading.literal:\n                raise _Failure(Diagnostic(\"SourceLiteralMismatch\", \"source span literal differs from binding\", row[\"id\"]))\n            doc = next((d for d in ir[\"documents\"] if d[\"id\"] == document_id), None)\n            if doc is None or doc[\"sha256\"] != hashlib.sha256(reading.literal.encode()).hexdigest():\n                raise _Failure(Diagnostic(\"SourceDigestMismatch\", \"document digest differs from binding\", row[\"id\"]))\n            review = reviews.get(row[\"review_decision\"])\n            if review is None or review[\"action\"] != \"Accept\" or review[\"reviewer\"] != reading.reviewer or review[\"date\"] != reading.review_date:\n                raise _Failure(Diagnostic(\"BindingAcceptance\", \"observation lacks the bound accepted review decision\", row[\"id\"]))\n            view = next((v for v in views.values() if row[\"id\"] in v[\"observations\"]), None)\n            if view is None or reading.cutoff != view[\"cutoff\"] or (reading.system_as_of is not None and view[\"system_as_of\"] != reading.system_as_of):\n                raise _Failure(Diagnostic(\"EvidenceCutoff\", \"observation is not in the bound evidence view\", row[\"id\"]))\n        for row in ir[\"books\"]:\n            if row[\"package\"] not in package_rows:\n                raise _Failure(Diagnostic(\"PackageBinding\", \"book package is not locked\", row[\"id\"]))\n            if row[\"currency\"] != entities[row[\"entity\"]][\"functional_currency\"]:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"book currency differs from entity\", row[\"id\"]))\n        for row in ir[\"accounts\"]:\n            if (err := _ref(nodes, row[\"book\"], {\"books\"}, row[\"id\"])):\n                raise _Failure(err)\n            if row[\"id\"] not in _ACCOUNT_ROLES or row[\"role\"] != _ACCOUNT_ROLES[row[\"id\"]]:\n                raise _Failure(Diagnostic(\"PackageAccounts\", \"account role is outside the locked DemoDebt mapping\", row[\"id\"]))\n        if {r[\"id\"]: r[\"role\"] for r in ir[\"accounts\"]} != _ACCOUNT_ROLES:\n            raise _Failure(Diagnostic(\"PackageAccounts\", \"all four DemoDebt account roles are required\", \"accounts\"))\n        model_ids = {r[\"id\"] for r in ir[\"models\"]}\n        scope_ids = {r[\"id\"] for r in ir[\"modelScopes\"]}\n        if len(model_ids) != 1 or len(scope_ids) != 1:\n            raise _Failure(Diagnostic(\"ProfileCardinality\", \"one model and one model scope are required\", \"models\"))\n        admissions = {a.name: a for a in bindings.admissions}\n        for row in ir[\"symbols\"]:\n            if row[\"uncertainty_kind\"] != bindings.symbol_uncertainty or row[\"scope\"] not in model_ids:\n                raise _Failure(Diagnostic(\"SymbolAdmission\", \"symbol uncertainty or scope differs from bindings\", row[\"id\"]))\n            admission = admissions.get(row[\"id\"])\n            if admission is None or row[\"admission\"] != f\"admission:{row['id']}\" or not row[\"provenance\"]:\n                raise _Failure(Diagnostic(\"SymbolAdmission\", \"symbol admission/provenance is incomplete\", row[\"id\"]))\n            domain = row[\"domain\"]\n            if domain[\"kind\"] != \"interval\" or domain[\"lower\"] is None or domain[\"upper\"] is None:\n                raise _Failure(Diagnostic(\"InvalidDomain\", \"Core0.1 symbols require a closed interval\", row[\"id\"]))\n            if parse_rational(domain[\"lower\"]) < 0 or parse_rational(domain[\"upper\"]) > 1:\n                raise _Failure(Diagnostic(\"InvalidDomain\", \"alpha interval must lie inside [0,1]\", row[\"id\"]))\n        for row in ir[\"assumptions\"]:\n            if row[\"expression\"] not in {e[\"id\"] for e in ir[\"expressions\"]}:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"assumption expression is unknown\", row[\"id\"]))\n            if row[\"scope\"] not in model_ids and row[\"scope\"] not in {a[\"id\"] for a in ir[\"alternatives\"]} and row[\"scope\"] not in {c[\"id\"] for c in ir[\"contracts\"]} and row[\"scope\"] not in {s[\"id\"] for s in ir[\"scenarios\"]}:\n                raise _Failure(Diagnostic(\"AssumptionScope\", \"assumption scope is not declared\", row[\"id\"]))\n            valid = row[\"valid\"]\n            _time(\"interval\", valid[\"start\"], valid[\"end_exclusive\"], valid[\"calendar\"])\n            if valid[\"calendar\"] != bindings.calendar_id or valid[\"start\"] != bindings.horizon_start or valid[\"end_exclusive\"] != bindings.horizon_end:\n                raise _Failure(Diagnostic(\"AssumptionValidity\", \"assumption validity must cover the profile horizon\", row[\"id\"]))\n            _instant(row[\"information_cutoff\"], row[\"id\"])\n            if not row[\"rationale\"] or not row[\"source_refs\"] and row[\"provenance\"] != \"ScenarioDesign\":\n                raise _Failure(Diagnostic(\"MissingAssumption\", \"assumption rationale or source provenance is missing\", row[\"id\"]))\n            aid = row[\"id\"]\n            if aid.startswith(\"assumption:alternative_\"):\n                key = \"alternative\"\n            elif aid.startswith(\"assumption:contract_\"):\n                key = \"contract-rate\"\n            elif aid.startswith(\"assumption:scenario_\"):\n                key = \"scenario\"\n            elif aid.startswith(\"assumption:constraint_\"):\n                key = \"constraint\"\n            else:\n                key = None\n            if key is not None:\n                meta = bindings.assumption(key)\n                if (row[\"rationale\"] != meta.rationale or row[\"provenance\"] != meta.provenance or\n                        row[\"role\"] != meta.role or row[\"information_cutoff\"] != meta.information_cutoff or\n                        row[\"valid\"][\"start\"] != meta.valid_start or row[\"valid\"][\"end_exclusive\"] != meta.valid_end):\n                    raise _Failure(Diagnostic(\"AssumptionBinding\", \"assumption metadata differs from explicit binding\", row[\"id\"]))\n        checker = _IRTypeChecker(ir, nodes)\n        for row in ir[\"expressions\"]:\n            checker.expr(row[\"id\"])\n        for row in ir[\"constraints\"]:\n            inferred = checker.expr(row[\"expression\"])\n            if inferred[0] != \"Bool\":\n                raise _Failure(Diagnostic(\"ConstraintType\", \"constraint expression must be Boolean\", row[\"id\"]))\n        for row in ir[\"contracts\"]:\n            if row[\"book\"] not in books:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"contract book is unknown\", row[\"id\"]))\n            if row[\"package\"] not in package_rows or row[\"type\"] != f\"{row['package']}/DebtMix\":\n                raise _Failure(Diagnostic(\"PackageBinding\", \"contract type/package is not locked\", row[\"id\"]))\n            if not row[\"source_refs\"]:\n                raise _Failure(Diagnostic(\"ContractProvenance\", \"contract requires source provenance\", row[\"id\"]))\n            fields = {f[\"name\"]: f[\"expression\"] for f in row[\"fields\"]}\n            if set(fields) != {\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"}:\n                raise _Failure(Diagnostic(\"ContractFields\", \"contract fields are incomplete or duplicated\", row[\"id\"]))\n            expected = {\"principal\": f\"Money<{books[row['book']]['currency']}>\", \"fixed_fraction\": \"Real\",\n                        \"fixed_rate\": \"Rate<annual_simple>\", \"initial_floating_rate\": \"Rate<annual_simple>\"}\n            for name, typ in expected.items():\n                if checker.expr(fields[name])[0] != typ:\n                    raise _Failure(Diagnostic(\"ContractType\", f\"{name} has the wrong type\", row[\"id\"]))\n            fixed = checker.expr(fields[\"fixed_fraction\"])\n            if fixed[2] is not None and (fixed[2] < 0 or fixed[2] > 1):\n                raise _Failure(Diagnostic(\"ContractDomain\", \"fixed fraction must lie inside [0,1]\", row[\"id\"]))\n            for name in (\"fixed_rate\", \"initial_floating_rate\"):\n                value = checker.expr(fields[name])[2]\n                if value is not None and value < 0:\n                    raise _Failure(Diagnostic(\"ContractDomain\", f\"{name} must be nonnegative\", row[\"id\"]))\n        alternatives = {r[\"id\"]: r for r in ir[\"alternatives\"]}\n        for row in ir[\"alternatives\"]:\n            if row[\"parent\"] not in {r[\"id\"] for r in ir[\"historyFamilies\"]} or row[\"scope\"] not in scope_ids:\n                raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative parent or scope is unknown\", row[\"id\"]))\n            meta = next((a for a in bindings.alternatives if a.name == row[\"id\"]), None)\n            if meta is None or row[\"author\"] != meta.author or row[\"created_at\"] != meta.created_at or row[\"reason\"] != meta.reason:\n                raise _Failure(Diagnostic(\"AlternativeMetadata\", \"alternative metadata differs from binding\", row[\"id\"]))\n            if not row[\"constraints\"]:\n                raise _Failure(Diagnostic(\"MissingAlternativeCondition\", \"alternative requires at least one condition\", row[\"id\"]))\n            for cid in row[\"constraints\"]:\n                c = next((x for x in ir[\"constraints\"] if x[\"id\"] == cid), None)\n                if c is None or c[\"scope\"] != row[\"id\"] or checker.expr(c[\"expression\"])[0] != \"Bool\":\n                    raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative condition is not scoped to its branch\", row[\"id\"]))\n        for row in ir[\"states\"]:\n            total = Fraction(0); seen = set()\n            for balance in row[\"balances\"]:\n                if balance[\"account\"] in seen:\n                    raise _Failure(Diagnostic(\"DuplicateBalance\", \"opening account occurs twice\", row[\"id\"]))\n                seen.add(balance[\"account\"]); total += parse_rational(balance[\"signed_amount\"])\n            if total != 0:\n                raise _Failure(Diagnostic(\"UnbalancedState\", \"opening balances do not sum to zero\", row[\"id\"]))\n            expected_accounts = {a[\"id\"] for a in ir[\"accounts\"] if a[\"book\"] == row[\"book\"]}\n            if seen != expected_accounts:\n                raise _Failure(Diagnostic(\"IncompleteState\", \"opening state must include every account\", row[\"id\"]))\n            opening = next((o for o in bindings.openings\n                            if row[\"date\"] == o.date and row[\"book\"] == (o.book or row[\"book\"]) and\n                            {name: rational(value) for name, value in o.balances} ==\n                            {b[\"account\"]: b[\"signed_amount\"] for b in row[\"balances\"]}), None)\n            if opening is None:\n                raise _Failure(Diagnostic(\"OpeningStateMismatch\", \"opening state differs from bound opening export\", row[\"id\"]))\n            if row[\"contracts\"] != [c[\"id\"] for c in ir[\"contracts\"]]:\n                raise _Failure(Diagnostic(\"OpeningStateMismatch\", \"opening state must retain active contract\", row[\"id\"]))\n        for row in ir[\"historyFamilies\"]:\n            if row[\"feasibility\"] == \"Feasible\" and not row[\"witnesses\"]:\n                raise _Failure(Diagnostic(\"MissingWitness\", \"feasible family requires a witness\", row[\"id\"]))\n            if row[\"coverage\"] == \"ExactWithinScope\" and (row[\"unresolved_cells\"] or not row[\"completed_cells\"]):\n                raise _Failure(Diagnostic(\"FalseCoverage\", \"exact coverage requires completed cells and no unresolved cells\", row[\"id\"]))\n            if row[\"coverage\"] != \"PartialSearch\" or row[\"feasibility\"] != \"Unknown\" or row[\"completed_cells\"] != 0 or row[\"unresolved_cells\"] != 1:\n                raise _Failure(Diagnostic(\"CoverageClaim\", \"Core0.1 family must remain explicitly unsearched\", row[\"id\"]))\n            if set(row[\"symbols\"]) != {s[\"id\"] for s in ir[\"symbols\"]} or set(row[\"alternatives\"]) != set(alternatives):\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family must retain all shared symbols and alternatives\", row[\"id\"]))\n            if row[\"evidence_view\"] not in views or row[\"opening_state\"] not in {s[\"id\"] for s in ir[\"states\"]}:\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family evidence/opening references are unknown\", row[\"id\"]))\n        for row in ir[\"scenarios\"]:\n            for driver in row[\"drivers\"]:\n                info = checker.expr(driver[\"expression\"])\n                if info[0] != \"Driver<Rate<annual_simple>>\":\n                    raise _Failure(Diagnostic(\"ScenarioType\", \"scenario driver must be a constant annual rate\", row[\"id\"]))\n        for row in ir[\"reportMappings\"]:\n            if not row[\"rows\"] or row[\"rows\"][0][\"expression\"] not in checker.memo:\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping expression is not compiled\", row[\"id\"]))\n            rb = next((r for r in bindings.reports if r.key == row[\"id\"] or r.mapping == row[\"rows\"][0].get(\"value\")), None)\n            if row[\"book\"] not in books or row[\"basis\"] not in package_rows or not row[\"required_operations\"]:\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping book/package/operations are incomplete\", row[\"id\"]))\n            if rb is None:\n                # The generated mapping uses a SourceRef literal; compare the\n                # text payload directly when an explicit row binding exists.\n                expr = next((e for e in ir[\"expressions\"] if e[\"id\"] == row[\"rows\"][0][\"expression\"]), None)\n                if expr is None or expr[\"type\"] != \"SourceRef\" or expr[\"text\"] not in {r.mapping for r in bindings.reports}:\n                    raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping is not bound to an explicit export\", row[\"id\"]))\n        if not ir[\"diagnostics\"]:\n            pass\n    except _Failure as exc:\n        return ValidationResult(False, (exc.diagnostic,))\n    return ValidationResult(True, ())\n\n\n@dataclass(frozen=True)\nclass _Symbolic:\n    name: str\n\n\ndef evaluate_expression(ir: Mapping[str, Any], identifier: str,\n                        symbols: Mapping[str, Fraction | int | str] | None = None) -> Any:\n    \"\"\"Evaluate exact supported expressions for a supplied symbol assignment.\"\"\"\n    nodes = {e[\"id\"]: e for e in ir.get(\"expressions\", [])}\n    symbol_values = {k: _fraction(v) for k, v in (symbols or {}).items()}\n    observations = {o[\"id\"]: o for o in ir.get(\"observations\", [])}\n    contexts = {c[\"id\"]: c for c in ir.get(\"contexts\", [])}\n    seen: set[str] = set()\n\n    def go(eid: str) -> Any:\n        if eid in seen:\n            raise ValueError(f\"expression cycle at {eid}\")\n        if eid not in nodes:\n            raise KeyError(eid)\n        e = nodes[eid]; op = e[\"op\"]\n        if op == \"literal\":\n            if e[\"rational\"] is not None:\n                return parse_rational(e[\"rational\"])\n            if e[\"type\"] == \"Bool\":\n                return e[\"text\"] == \"true\"\n            return e[\"text\"]\n        seen.add(eid)\n        try:\n            if op == \"ref\":\n                target = e[\"target\"]\n                if target in nodes:\n                    return go(target)\n                if target in symbol_values:\n                    return symbol_values[target]\n                if target in observations:\n                    return parse_rational(observations[target][\"domain\"][\"lower\"])\n                return _Symbolic(target)\n            if op == \"call\":\n                value = go(e[\"args\"][0])\n                return value\n            args = [go(a) for a in e[\"args\"]]\n            if any(isinstance(a, _Symbolic) for a in args):\n                return _Symbolic(eid)\n            if op == \"add\": return args[0] + args[1]\n            if op == \"subtract\": return args[0] - args[1]\n            if op == \"multiply\": return args[0] * args[1]\n            if op == \"divide\": return args[0] / args[1]\n            if op == \"negate\": return -args[0]\n            if op == \"not\": return not args[0]\n            if op == \"and\": return args[0] and args[1]\n            if op == \"or\": return args[0] or args[1]\n            return {\"eq\": args[0] == args[1], \"ne\": args[0] != args[1], \"lt\": args[0] < args[1],\n                    \"le\": args[0] <= args[1], \"gt\": args[0] > args[1], \"ge\": args[0] >= args[1]}[op]\n        finally:\n            seen.remove(eid)\n    return go(identifier)\n\n\ndef semantic_projection(ir: Mapping[str, Any] | None) -> Optional[dict[str, Any]]:\n    if ir is None:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '680,1035p' scripts/core0_ir_v1.py\"","aggregated_output":"        return cls((package,), (reading,), (opening,), (report,), assumptions,\n                   admissions=admissions, alternatives=alternatives)\n\n\ndef _unique(rows, attr, key, code):\n    matches = [r for r in rows if getattr(r, attr) == key]\n    if len(matches) != 1:\n        raise _diag(code, f\"{key!r} must have exactly one explicit binding\", str(key))\n    return matches[0]\n\n\ndef _validate_bindings(bindings: CompileBindings) -> None:\n    \"\"\"Validate caller supplied metadata before any semantic lowering.\n\n    Bindings are facts supplied by the caller; they are never inferred from a\n    source declaration or from the authored expected IR.  This early pass\n    catches duplicate/ambiguous exports, invalid dates and unsafe package\n    artifacts so later lowering can rely on a single explicit record.\n    \"\"\"\n    if not isinstance(bindings, CompileBindings):\n        raise _diag(\"InvalidBindings\", \"compile bindings must be CompileBindings\", \"bindings\")\n\n    def unique(rows: Sequence[Any], attr: str, where: str) -> None:\n        values = [getattr(row, attr) for row in rows]\n        if len(values) != len(set(values)):\n            raise _diag(\"AmbiguousBinding\", f\"duplicate {attr} in {where}\", where)\n\n    unique(bindings.packages, \"id\", \"packages\")\n    unique(bindings.readings, \"key\", \"readings\")\n    unique(bindings.openings, \"key\", \"openings\")\n    unique(bindings.reports, \"key\", \"reports\")\n    unique(bindings.assumptions, \"key\", \"assumptions\")\n    unique(bindings.admissions, \"name\", \"admissions\")\n    unique(bindings.alternatives, \"name\", \"alternatives\")\n\n    try:\n        _iso(bindings.horizon_start, \"bindings.horizon_start\")\n        _iso(bindings.horizon_end, \"bindings.horizon_end\")\n        if date.fromisoformat(bindings.horizon_end) <= date.fromisoformat(bindings.horizon_start):\n            raise _diag(\"InvalidPeriod\", \"horizon end must be after start\", \"bindings.horizon\")\n    except _Failure:\n        raise\n    if bindings.calendar_id != \"DemoCalendar@1\" or bindings.calendar_name != \"Gregorian\":\n        raise _diag(\"UnsupportedCalendar\", \"Core0.1 requires DemoCalendar@1/Gregorian\", \"bindings.calendar\")\n    if bindings.symbol_uncertainty not in {\"HistoricalFact\"}:\n        raise _diag(\"UnsupportedUncertainty\", \"Core0.1 admits only HistoricalFact symbols\", \"bindings.symbol_uncertainty\")\n\n    package_root = ROOT.resolve()\n    for package in bindings.packages:\n        if package.name != \"DemoDebt\" or package.version != \"1\":\n            raise _diag(\"UnsupportedPackage\", \"Core0.1 requires DemoDebt@1\", package.id)\n        if not re.fullmatch(r\"[0-9a-f]{64}\", package.digest):\n            raise _diag(\"InvalidPackageDigest\", \"package digest must be a SHA-256 hex digest\", package.id)\n        try:\n            start = date.fromisoformat(package.effective_start)\n            end = date.fromisoformat(package.effective_end)\n        except ValueError as exc:\n            raise _diag(\"InvalidDate\", \"package applicability dates must be YYYY-MM-DD\", package.id) from exc\n        if end <= start:\n            raise _diag(\"InvalidPeriod\", \"package effective end must be after start\", package.id)\n        artifact = (ROOT / package.artifact).resolve()\n        if not artifact.is_relative_to(package_root) or not artifact.is_file():\n            raise _diag(\"UnsafePackageArtifact\", \"package artifact must be an existing project-local file\", package.id)\n        if hashlib.sha256(artifact.read_bytes()).hexdigest() != package.digest:\n            raise _diag(\"PackageDigestMismatch\", \"package artifact digest differs from binding\", package.id)\n        if package.basis != package.name or \"builtin:Core0@1\" not in package.dependencies or \"DemoCalendar@1\" not in package.dependencies:\n            raise _diag(\"PackageBinding\", \"package basis/dependencies are not the locked Core0 set\", package.id)\n        if set(package.operations) != {\"reset\", \"accrue_and_pay\", \"close\", \"statements\"}:\n            raise _diag(\"PackageBinding\", \"package operations differ from the retained DemoDebt export\", package.id)\n        if any(not str(a) or \"..\" in str(a) for a in package.authority):\n            raise _diag(\"UnsafePackageAuthority\", \"package authority contains an unsafe path\", package.id)\n\n    for reading in bindings.readings:\n        if not reading.key or not reading.currency or reading.action != \"Accept\":\n            raise _diag(\"BindingAcceptance\", \"readings require an explicit Accept action\", reading.key or \"reading\")\n        _iso(reading.instant, f\"reading:{reading.key}.instant\")\n        for label, value in ((\"available\", reading.available), (\"ingested\", reading.ingested),\n                             (\"review_date\", reading.review_date), (\"cutoff\", reading.cutoff)):\n            _instant(value, f\"reading:{reading.key}.{label}\")\n        if reading.system_as_of is not None:\n            _instant(reading.system_as_of, f\"reading:{reading.key}.system_as_of\")\n        if not reading.reviewer or not reading.review_reason or not reading.literal:\n            raise _diag(\"IncompleteEvidence\", \"reading bindings require reviewer, reason and literal\", reading.key)\n        if reading.amount < 0:\n            raise _diag(\"InvalidReading\", \"debt principal reading must be nonnegative\", reading.key)\n\n    for opening in bindings.openings:\n        _iso(opening.date, f\"opening:{opening.key}.date\")\n        if not opening.balances or len({name for name, _ in opening.balances}) != len(opening.balances):\n            raise _diag(\"OpeningStateMismatch\", \"opening balances require unique account names\", opening.key)\n        if any(name not in _ACCOUNT_ROLES for name, _ in opening.balances):\n            raise _diag(\"OpeningStateMismatch\", \"opening contains an account outside DemoDebt\", opening.key)\n\n    for report in bindings.reports:\n        if not report.key or not report.mapping or not report.cash_flow_policy or not report.closing_policy:\n            raise _diag(\"IncompleteReportBinding\", \"report bindings require mapping and policies\", report.key or \"report\")\n        if not report.required_operations:\n            raise _diag(\"IncompleteReportBinding\", \"report binding requires at least one operation\", report.key)\n\n    for assumption in bindings.assumptions:\n        if assumption.provenance not in {\"Analyst\", \"EmpiricalEstimate\", \"ImportedModel\", \"ScenarioDesign\"}:\n            raise _diag(\"InvalidAssumption\", \"unsupported assumption provenance\", assumption.key)\n        if assumption.role not in {\"Baseline\", \"Hypothesis\", \"Convenience\", \"ReviewedDefault\"}:\n            raise _diag(\"InvalidAssumption\", \"unsupported assumption role\", assumption.key)\n        if assumption.information_cutoff is not None:\n            _instant(assumption.information_cutoff, f\"assumption:{assumption.key}.cutoff\")\n        if assumption.valid_start is None or assumption.valid_end is None:\n            raise _diag(\"IncompleteAssumption\", \"assumptions require a validity interval\", assumption.key)\n        _iso(assumption.valid_start, f\"assumption:{assumption.key}.valid_start\")\n        _iso(assumption.valid_end, f\"assumption:{assumption.key}.valid_end\")\n        if date.fromisoformat(assumption.valid_end) <= date.fromisoformat(assumption.valid_start):\n            raise _diag(\"InvalidPeriod\", \"assumption validity end must be after start\", assumption.key)\n\n    readings = {r.key for r in bindings.readings}\n    for admission in bindings.admissions:\n        if admission.reading_key not in readings or admission.kind != \"HistoricalFact\":\n            raise _diag(\"SymbolAdmission\", \"symbol admissions must cite a bound HistoricalFact reading\", admission.name)\n        _instant(admission.date, f\"admission:{admission.name}.date\")\n        if not admission.reviewer or not admission.reason:\n            raise _diag(\"IncompleteAdmission\", \"symbol admissions require reviewer and reason\", admission.name)\n    for alternative in bindings.alternatives:\n        _instant(alternative.created_at, f\"alternative:{alternative.name}.created_at\")\n        if not alternative.author or not alternative.reason:\n            raise _diag(\"IncompleteAlternative\", \"alternative metadata require author and reason\", alternative.name)\n\n\n# ---------------------------------------------------------------------------\n# Lowering\n\n\ndef _empty_ir() -> dict[str, Any]:\n    keys = [\n        \"models\", \"contexts\", \"sourceSpans\", \"documents\", \"observations\", \"narratives\",\n        \"coverageUnits\", \"mappings\", \"partitions\", \"entities\", \"controls\", \"books\", \"accounts\",\n        \"symbols\", \"choices\", \"expressions\", \"constraints\", \"assumptions\", \"alternatives\",\n        \"contracts\", \"postings\", \"states\", \"events\", \"rules\", \"packages\", \"measurements\",\n        \"journals\", \"scenarios\", \"informationViews\", \"reviewDecisions\", \"evidenceViews\",\n        \"modelScopes\", \"historyFamilies\", \"probabilityModels\", \"reportMappings\", \"resultCells\",\n        \"branchResults\", \"runs\", \"diagnostics\",\n    ]\n    out = {k: [] for k in keys}\n    out[\"schema_version\"] = \"0.1\"\n    return out\n\n\ndef _diag(code: str, message: str, location: str, capability: Optional[str] = None,\n          span: Optional[tuple[int, int]] = None) -> _Failure:\n    return _Failure(Diagnostic(code, message, location, capability=capability, span=span))\n\n\nclass _Compiler:\n    def __init__(self, program: Program, bindings: CompileBindings,\n                 source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,\n                 input_text: Optional[str] = None):\n        self.program = program\n        self.bindings = bindings\n        self.source_spans = source_spans or {}\n        self.input_text = input_text\n        self.ir = _empty_ir()\n        self.source_map: dict[str, dict[str, Any]] = {}\n        self.expr_rows: dict[str, dict[str, Any]] = {}\n        self.expr_info: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.decls: dict[str, Any] = {}\n        self.lets: dict[str, LetDecl] = {}\n        self.let_ids: dict[str, str] = {}\n        self.lowering_lets: set[str] = set()\n        self.observations: dict[str, ObservationDecl] = {}\n        self.symbols: dict[str, SymbolDecl] = {}\n        self.sources: dict[str, SourceDecl] = {}\n        self.entities: dict[str, EntityDecl] = {}\n        self.books: dict[str, BookDecl] = {}\n        self.accounts: dict[str, AccountDecl] = {}\n        self.openings: dict[str, OpeningDecl] = {}\n        self.contracts: dict[str, ContractDecl] = {}\n        self.alternatives: dict[str, AlternativeDecl] = {}\n        self.scenarios: dict[str, ScenarioDecl] = {}\n        self.reports: dict[str, ReportDecl] = {}\n        self.constraints: dict[str, ConstraintDecl] = {}\n        self.package: Optional[PackageBinding] = None\n        self.entity: Optional[EntityDecl] = None\n        self.book: Optional[BookDecl] = None\n        self.scope_id = f\"scope:{_clean_id(program.module)}@{_clean_id(program.version)}\"\n        self.model_id = f\"{program.module}@{program.version}\"\n\n    def fail(self, code: str, message: str, location: str, capability: Optional[str] = None,\n             node: Any = None) -> None:\n        span = None\n        if node is not None and id(node) in self.source_spans:\n            item = self.source_spans[id(node)]\n            span = (item.get(\"start\", 0), item.get(\"end\", 0))\n        raise _diag(code, message, location, capability, span)\n\n    def collect(self) -> None:\n        _validate_bindings(self.bindings)\n        if not self.program.module or not self.program.version:\n            self.fail(\"InvalidModule\", \"module name and version are required\", \"module\")\n        reserved = {\n            \"module\", \"version\", \"use\", \"source\", \"entity\", \"functional\", \"book\", \"basis\",\n            \"account\", \"opening\", \"observation\", \"instant\", \"period\", \"symbol\", \"in\", \"because\",\n            \"choice\", \"binding\", \"let\", \"constraint\", \"alternative\", \"assume\", \"contract\", \"event\",\n            \"rule\", \"for\", \"as\", \"when\", \"require\", \"post\", \"scenario\", \"set\", \"report\", \"from\",\n            \"to\", \"true\", \"false\", \"and\", \"or\", \"not\", \"debit\", \"credit\", \"overrides\", \"per\", \"year\",\n        }\n        self._check_name(self.program.module, \"module\", reserved)\n        declared_uses = tuple(d for d in self.program.declarations if isinstance(d, UseDecl))\n        all_uses = tuple(self.program.uses) + declared_uses\n        seen_use_ids: set[str] = set()\n        for use in all_uses:\n            self._check_name(use.name, \"use\", reserved)\n            if (use.name, use.version) in seen_use_ids:\n                self.fail(\"DuplicateDeclaration\", f\"duplicate package use {use.name!r}\", use.name)\n            seen_use_ids.add((use.name, use.version))\n            try:\n                package = self.bindings.package(use.name, use.version)\n            except _Failure:\n                raise\n            if self.package is not None and self.package.id != package.id:\n                self.fail(\"PackageCollision\", \"multiple package bases are outside Core0.1\", use.name)\n            self.package = package\n        for decl in self.program.declarations:\n            if isinstance(decl, UseDecl):\n                # A use is allowed either in Program.uses or declarations, but\n                # it must not be silently duplicated.\n                continue\n            if isinstance(decl, UnsupportedDecl):\n                self.fail(\"UnsupportedDeclaration\", f\"{decl.kind} is outside Core0.1\", decl.name or decl.kind,\n                          capability=decl.kind)\n            name = getattr(decl, \"name\", None)\n            if name:\n                self._check_name(name, type(decl).__name__, reserved)\n                if name in self.decls:\n                    self.fail(\"DuplicateDeclaration\", f\"duplicate declaration {name!r}\", name)\n                self.decls[name] = decl\n                self._record_source(name, decl, name, \"declaration\")\n            if isinstance(decl, (ContractDecl, ScenarioDecl)):\n                pairs = decl.fields if isinstance(decl, ContractDecl) else decl.settings\n                if len({k for k, _ in pairs}) != len(pairs):\n                    self.fail(\"DuplicateField\", \"fields must occur once\", name)\n            if isinstance(decl, SourceDecl):\n                self.sources[decl.name] = decl\n            elif isinstance(decl, EntityDecl):\n                self.entities[decl.name] = decl\n            elif isinstance(decl, BookDecl):\n                self.books[decl.name] = decl\n            elif isinstance(decl, AccountDecl):\n                self.accounts[decl.name] = decl\n            elif isinstance(decl, OpeningDecl):\n                self.openings[decl.name] = decl\n            elif isinstance(decl, ObservationDecl):\n                self.observations[decl.name] = decl\n            elif isinstance(decl, SymbolDecl):\n                self.symbols[decl.name] = decl\n            elif isinstance(decl, LetDecl):\n                self.lets[decl.name] = decl\n            elif isinstance(decl, ConstraintDecl):\n                self.constraints[decl.name] = decl\n            elif isinstance(decl, ContractDecl):\n                self.contracts[decl.name] = decl\n            elif isinstance(decl, AlternativeDecl):\n                self.alternatives[decl.name] = decl\n            elif isinstance(decl, ScenarioDecl):\n                self.scenarios[decl.name] = decl\n            elif isinstance(decl, ReportDecl):\n                self.reports[decl.name] = decl\n            else:\n                self.fail(\"UnsupportedDeclaration\", f\"{type(decl).__name__} is outside Core0.1\", str(decl))\n        # A typed program may pass uses separately; source frontend does this.\n        if self.package is None and all_uses:\n            self.fail(\"MissingPackageBinding\", \"a Core0.1 program requires one package use\", \"use\")\n        if self.package is None:\n            self.fail(\"MissingPackageBinding\", \"a Core0.1 program requires one package use\", \"use\")\n        if len(self.entities) != 1 or len(self.books) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires exactly one entity and one book\", \"profile\")\n        if any(len(x) != 1 for x in (self.sources, self.observations, self.symbols, self.contracts)):\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires one source, observation, symbol and contract\", \"profile\")\n        if len(self.openings) != 1 or len(self.reports) != 1 or len(self.scenarios) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires one opening, scenario and report\", \"profile\")\n        if len(self.alternatives) < 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires at least one named alternative\", \"profile\")\n        self.entity = next(iter(self.entities.values()))\n        self.book = next(iter(self.books.values()))\n        if self.book.entity != self.entity.name:\n            self.fail(\"BindingMismatch\", \"book entity must name the declared entity\", self.book.name)\n        if self.book.basis != self.package.name or self.book.version != self.package.version:\n            self.fail(\"PackageBinding\", \"book basis/version must match the locked package\", self.book.name)\n        if self.entity.currency != \"USD\":\n            self.fail(\"UnsupportedCurrency\", \"DemoDebt report requires USD\", self.entity.name)\n        if {a.name: a.role for a in self.accounts.values()} != _ACCOUNT_ROLES:\n            self.fail(\"PackageAccounts\", \"DemoDebt report requires its four named account roles\", \"accounts\")\n\n    @staticmethod\n    def _check_name(name: str, where: str, reserved: set[str]) -> None:\n        if not re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", name):\n            raise _diag(\"InvalidIdentifier\", f\"invalid identifier {name!r}\", where)\n        if name in reserved:\n            raise _diag(\"ReservedIdentifier\", f\"reserved keyword {name!r} cannot be declared\", where)\n\n    def _external_ids(self) -> dict[str, Any]:\n        return {\n            **{r.key: r for r in self.bindings.readings},\n            **{o.key: o for o in self.bindings.openings},\n            **{r.key: r for r in self.bindings.reports},\n        }\n\n    def _expr_id(self, owner: str, path: str) -> str:\n        return f\"expr:{_clean_id(owner)}:{_clean_id(path)}\"\n\n    def _record_source(self, expr_id: str, expr: Any, owner: str, path: str) -> None:\n        item = self.source_spans.get(id(expr))\n        if item:\n            self.source_map[expr_id] = dict(item, owner=owner, path=path)\n        else:\n            self.source_map[expr_id] = {\"constructor\": type(expr).__name__, \"owner\": owner, \"path\": path}\n\n    def _add_expr(self, expr_id: str, row: dict[str, Any], typ: str,\n                  context: Optional[str], value: Any = None, expr: Any = None,\n                  owner: str = \"\", path: str = \"\") -> tuple[str, str, Optional[str], Any]:\n        if expr_id in self.expr_rows:\n            prior = self.expr_rows[expr_id]\n            if prior != row:\n                self.fail(\"ExpressionIdentityCollision\", f\"two expressions map to {expr_id}\", expr_id)\n            return expr_id, typ, context, value\n        self.expr_rows[expr_id] = row\n        self.expr_info[expr_id] = (typ, context, value)\n        self._record_source(expr_id, expr, owner, path)\n        return expr_id, typ, context, value\n\n    def _lookup_type(self, name: str) -> tuple[str, Optional[str], Any]:\n        if name in self.let_ids:\n            return self.expr_info[self.let_ids[name]]\n        if name in self.observations:\n            obs = self.observations[name]\n            ctx = f\"context:{_clean_id(obs.name)}\"\n            key = self.sources[obs.source].external\n            return f\"Observation<{obs.type_name}>\", ctx, self.bindings.reading(key).amount\n        if name in self.symbols:\n            return self.symbols[name].type_name, None, None\n        self.fail(\"UnknownReference\", f\"reference {name!r} is not declared\", name)\n\n    def _constant(self, expr_id: str) -> Optional[Fraction]:\n        if expr_id not in self.expr_info:\n            return None\n        value = self.expr_info[expr_id][2]\n        return value if isinstance(value, Fraction) else None\n\n    def lower_expr(self, expr: Expr, owner: str, path: str,\n                   expected: Optional[str] = None) -> tuple[str, str, Optional[str], Any]:\n        expr_id = self._expr_id(owner, path)\n        if isinstance(expr, Literal):\n            value = expr.value\n            typ = expr.type_name\n            unit = expr.unit\n            display = expr.display\n            if isinstance(value, bool):\n                typ = typ or \"Bool\"\n                if typ != \"Bool\" or unit is not None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat data/accounting-master/runs/20261002T181809-4cb566e0/P03/review_plan-0.response.json; cat data/accounting-master/runs/20261002T181809-4cb566e0/P03/approved-plan.json | head -c 12000'","aggregated_output":"{\n  \"assumptions\": [\n    \"Acceptance applies only to the declared Core 0 debt-lowering profile.\",\n    \"Caller-supplied evidence and assumption metadata remain distinct from package definitions; synthetic acceptance records do not establish human review.\"\n  ],\n  \"checks\": [\n    \"Inspected the grammar, borrowing source, closed IR schema, package registry, existing validator and relevant MC requirement rows.\",\n    \"Confirmed Python 3.11.15, Lark 1.3.1 and jsonschema 4.26.0 are available.\",\n    \"A read-only parser probe confirmed that retaining literal tokens distinguishes bare numbers, annual rates and currency amounts without modifying the grammar.\",\n    \"Verified that the schema permits Unknown feasibility, PartialSearch coverage and zero completed cells; compilation need not inherit the authored fixture's reconstruction claims.\",\n    \"Baseline and comparison audit passed: independent typed programs, source variants, exact arithmetic checks and schema-valid corruptions supplement shared-frontend agreement.\",\n    \"Proxy-promotion audit passed: schema validation, frontend agreement and interest calculations are explicitly insufficient for accounting validity, forecasting or DSL superiority.\",\n    \"Stop-condition and protection audit passed: unexpected input changes, conflicting files, missing dependencies, skipped mandatory cases and timeouts cannot count as success.\",\n    \"No files changed; implementation tests were not run because the proposed modules and required test file do not yet exist.\"\n  ],\n  \"evidence\": [\n    \"AGENTS.md\",\n    \"MISSION_CONTROL.md\",\n    \"docs/plans/accounting-mission-requirements.md\",\n    \"docs/design/spec/core-0.lark\",\n    \"docs/design/spec/core-contract.md\",\n    \"docs/design/spec/core-ir.schema.json\",\n    \"docs/design/fixtures/borrowing.acc\",\n    \"docs/design/fixtures/demo-debt-package.json\",\n    \"docs/design/fixtures/core-demo-registry.json\",\n    \"scripts/core_semantics.py\",\n    \"scripts/check_core_contract.py\",\n    \"scripts/check_semantic_preparation.py\",\n    \"data/accounting-master/runs/20261002T180732-83972f09/P03/plan-0.log\"\n  ],\n  \"issues\": [],\n  \"next_actions\": [\n    \"Implement the declared versioned modules, profile, cases, tests and P03 deliverables within the reviewed boundary.\",\n    \"Run both specified conformance commands and repair failed obligations before result review.\",\n    \"Review generated IR and rejection diagnostics against independent expected semantics, including package/evidence separation and preservation of every alternative.\"\n  ],\n  \"residuals\": [\n    \"Executable lowering, typed frontend equivalence and semantic rejection coverage remain to be demonstrated by implementation.\",\n    \"The implementation must make the promised quantity rules, metadata requirements and semantic comparison projection explicit in the profile.\",\n    \"General language support, cross-company mapping and broader uncertainty admission remain open under G2, G12 and G15.\",\n    \"Reconstruction, accounting execution, empirical forecast validity, authoring superiority and human acceptance remain outside this phase's evidence.\"\n  ],\n  \"steps\": [\n    \"Reused the prior inspection findings and checked current interfaces.\",\n    \"Audited scope, baselines, assumptions, environment, stopping rules and proposed acceptance artifacts.\"\n  ],\n  \"summary\": \"AGREE. No unresolved material objection to the bounded P03 plan. It addresses the prior parser and fixture-inheritance risks, requires actual source lowering and independent semantic checks, and preserves the wider requirements without claiming gap closure.\",\n  \"verdict\": \"AGREE\"\n}\n{\n  \"plan\": {\n    \"verdict\": \"PLAN\",\n    \"summary\": \"P03 can proceed independently of unfinished P02. Current code parses syntax and validates authored debt IR, but does not compile source programs. Implement a versioned, explicitly bounded Core 0 lowering profile with independent textual and typed entrypoints, shared semantic validation, and executable conformance checks. The prior timeout is addressed by reusing its inspection findings and limiting this planning pass to relevant interfaces. No files were changed or implementation tests run.\",\n    \"steps\": [\n      \"1. Establish the implementation boundary in new docs/design/spec/core0-lowering-profile-v1.md. Map MC02/MC04 to context and provenance, MC10 to admitted factual uncertainty and explicit assumptions, MC20 to package-controlled bindings and rejected overrides, MC23 to equivalent frontend tasks, and MC24 to parsing, binding, validation and diagnostics. Declare support for the borrowing.acc declarations plus let bindings and Boolean constraints; one USD book, the four DemoDebt account roles, one DebtMix contract, exact instant observations, closed Real symbol intervals, conditional alternatives and constant-rate stress scenarios. Enumerate every unsupported declaration, expression and uncertainty category.\",\n      \"2. Record the preimplementation audit and protection boundary in that profile. Add only scripts/core0_frontends_v1.py, scripts/core0_ir_v1.py, scripts/check_accounting_p03.py, tests/test_accounting_p03.py, docs/design/spec/core0-lowering-profile-v1.md and docs/design/fixtures/p03-lowering-cases-v1.json, plus the two declared P03 deliverables. Hash relevant existing inputs and protected files before work. Preserve existing grammar, schema, validators, fixtures, controller files, release-pinned files and snapshots. Stop on unexpected input changes or conflicting preexisting content; retain partial work without overwriting it.\",\n      \"3. Define immutable typed Program, declaration and expression constructors, CompileBindings, CompileResult and Diagnostic interfaces. CompileBindings must explicitly supply package locks, evidence/view records, accepted synthetic readings, symbol admissions, opening balances, context metadata and assumption/alternative metadata absent from surface syntax. Separate package definitions from caller-supplied evidence. Resolve only local, declared, kind-checked, digest-locked exports; reject missing bindings, wrong versions, collisions, escaping paths and unsupported exports. Never infer acceptance from a source declaration or manufacture reviewer identities, timestamps, probabilities or missing context.\",\n      \"4. Implement compile_source(text, bindings) using the existing grammar with retained literal tokens and source positions. Build an AST from actual declarations, preserve per-year and currency suffixes, and reject reserved identifiers explicitly. Decode JSON strings safely, retain original spelling and offsets, normalize semantic strings as specified, validate Gregorian dates, and convert decimal text directly to Fraction. Bind declaration names and lexical scopes, detect duplicate declarations/fields, unresolved references and cycles, then lower every supported node. Recognized unsupported constructs must return an explicit capability diagnostic.\",\n      \"5. Implement compile_program(Program, bindings) through the same binding, type/context checking and IR construction stages. Typed constructors must neither generate DSL text nor accept an unchecked IR dictionary as a compiled program. Support value, constant and external in their declared positions; references, unary operations, compatible addition/subtraction, comparisons and Boolean composition; and scalar multiplication/division with explicit quantity rules and a provably nonzero constant denominator. Reject implicit currency/rate conversions, unsupported products and unproved bounds. Keep generated IDs deterministic and independent of source offsets.\",\n      \"6. Implement validate_ir(ir, bindings) and a small exact expression evaluator in core0_ir_v1.py. Validate against the unchanged closed schema, then independently check references, arities, inferred types, contexts, source-reading equality, evidence cutoffs, symbol admission, assumption scope/validity, package applicability, contract fields/domains, opening balances and report bindings. Reuse sound low-level helpers where appropriate; do not weaken the existing fixture-specific validator. Preserve all alternatives over shared symbols without solving or selecting them. Emit Unknown feasibility, PartialSearch coverage, zero completed cells and one explicitly unsearched family cell for this profile, with no witnesses or solver results.\",\n      \"7. Preserve source spans, original display/precision, context, dependencies, assumptions and alternatives in generated records. Return a separate source map for textual offsets or typed-constructor locations. Define a semantic comparison projection that excludes frontend locations but retains economically relevant values, contexts, package locks and assumptions. Retain raw input hashes separately. Compare the original generated program with the authored IR only through documented corresponding fields; exclude authored reconstruction claims from that comparator. Neither compiler entrypoint may load core-ir-demo.json, borrowings.json or package expected-result fields to construct its output.\",\n      \"8. Implement independent positive programs, typed counterparts and negative cases in the new fixture/test files. Include the original borrowing source, formatting variants, a differently named program, let-bound rates, arithmetic and compound alternative conditions, a changed stress rate, and changed principal with matching new synthetic evidence/opening balances. Add schema-valid IR corruptions and invalid typed programs. Exercise exact evaluation from generated IR, stable diagnostics, immutability, repeated compilation and prohibited fixture-lookup checks.\",\n      \"9. Run the checks below and repair failures before producing data/accounting-master/deliverables/P03/conformance.json and result.md. The checker must write only these declared deliverables under accounting-master. Conformance must contain actual generated IR or complete semantic projections, input/code hashes, expected and observed checks, diagnostics, requirement coverage and unsupported capabilities. Result.md must record commands, environment, wall time, changed files, baseline comparisons, decision table, remaining uncertainty and next justified actions. Keep specification, implementation, tested invariants, accounting validity, forecast validity and human acceptance separate.\"\n    ],\n    \"assumptions\": [\n      \"The executable target is a named Core0.1 debt-lowering profile, not the whole grammar. Package-specific USD, account roles, calendar and report mapping remain explicit profile restrictions; source identifiers and supported expressions are not matched against one complete fixture.\",\n      \"Missing surface metadata is supplied through explicit bindings. Synthetic review/admission records remain labeled synthetic; compiler acceptance does not imply actual human review.\",\n      \"Existing Python 3.11.15, Lark 1.3.1 and jsonschema 4.26.0 are available. Use these and the standard library; no dependency installation, network access, GPU use or model invocation is needed.\",\n      \"Skeptical audit: addressed fixture lookup, dropped unit tokens, fixture-specific validation and unsupported feasibility inheritance. The authored IR is a bounded comparator; schema success and frontend agreement are insufficient alone. Independent expression checks and semantic rejection cases answer the phase question. No timing or usability comparison is proposed.\",\n      \"Default audit: numeric semantics come from core-contract.md; package restrictions come from DemoDebt; conservative family status follows the absence of reconstruction. These are implementation choices with tests, not newly promoted accounting or scientific defaults. No experiment or stochastic comparison is authorized by this plan.\"\n    ],\n    \"checks\": [\n      \"Run from the repository root: python3 -B -m unittest discover -s tests -p 'test_accounting_p03.py' -v. Require every mandatory case to execute and pass; skipped required cases, unexpected exceptions, missing dependencies or timeouts cannot count as success.\",\n      \"Run: python3 -B scripts/check_accounting_p03.py --output-dir data/accounting-master/deliverables/P03. Require a nonzero exit on any failed obligation, actual per-case observations and complete declared deliverables.\",\n      \"Frontend equivalence: independently construct typed programs matching each valid source case. Compare complete semantic projections, package/evidence bindings and evaluated expressions. Comments and LF/CRLF changes preserve semantics while retaining distinct source provenance.\",\n      \"Input sensitivity: original principal 100, fixed rate 0.05 and stressed floating rate 0.07 yield unrounded one-year interest 5 and 7 at the two endpoint assignments. A 0.09 stress yields 9 for the floating endpoint. Consistently changed principal 200 yields 10 and 14. Derive these checks independently as P × (alpha × fixed_rate + (1 − alpha) × stress_rate) × 1 year from evaluated generated fields. These verify this exact calculation, not journals or forecasting.\",\n      \"Lexical/binding rejection: malformed syntax, reserved names, invalid dates/escapes, duplicate declarations/fields, unknown references, cyclic lets, unresolved or ambiguous exports and missing external metadata. Specifically distinguish bare 0.05 from 0.05 per year.\",\n      \"Semantic rejection: first confirm schema validity for corrupted IR, then require the intended diagnostic for wrong reference kinds, arity, units, context, accepted reading, cutoff, assumption scope, package digest, contract domain, opening state or report policy. Reject unsupported rules/overrides, mappings, finite choices, uncertainty categories and expression operations through both applicable entrypoints.\",\n      \"Honesty and regression: verify no invented acceptance, weights, witnesses or feasibility; preserve all conditional branches and shared dependencies. Validate the existing authored fixture with its existing validator through in-memory calls. Do not execute legacy checker mains that overwrite historical reports.\",\n      \"Verify input immutability, repeated-run determinism and no runtime dependence on expected IR/results. Compare pre/post hashes for protected inputs and record every added or changed source, test and deliverable file. Evidence is deterministic engineering conformance; test counts are not an accounting-validity metric.\"\n    ],\n    \"evidence\": [\n      \"AGENTS.md\",\n      \"MISSION_CONTROL.md\",\n      \"docs/plans/accounting-mission-requirements.md\",\n      \"docs/design/spec/core-0.lark\",\n      \"docs/design/spec/core-contract.md\",\n      \"docs/design/spec/core-ir.schema.json\",\n      \"docs/design/fixtures/borrowing.acc\",\n      \"docs/design/fixtures/core-ir-demo.json\",\n      \"docs/design/fixtures/core-demo-registry.json\",\n      \"docs/design/fixtures/demo-debt-package.json\",\n      \"scripts/core_semantics.py\",\n      \"scripts/check_core_contract.py\",\n      \"scripts/check_semantic_preparation.py\",\n      \"data/financial-report-benchmark/release-manifest.json\",\n      \"data/accounting-master/runs/20261002T180732-83972f09/P03/plan-0.log\",\n      \"data/accounting-master/runs/20261002T180732-83972f09/P00/result-review.json\",\n      \"data/accounting-master/runs/20261002T180732-83972f09/P01/result-review.json\"\n    ],\n    \"issues\": [],\n    \"residuals\": [\n      \"P03 implementation modules, required test file and deliverables do not yet exist. This response establishes a plan only.\",\n      \"Git metadata is unavailable because this directory is not a usable Git repository. Record that limitation once and use file hashes; do not initialize Git.\",\n      \"Ge","exit_code":0,"status":"completed"}}
