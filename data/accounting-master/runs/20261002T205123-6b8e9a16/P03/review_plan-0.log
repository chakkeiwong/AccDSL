{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1200,1515p' scripts/core0_ir_v1.py\"","aggregated_output":"        if key in {r.key for r in self.bindings.reports}:\n            return self.bindings.report(key)\n        self.fail(\"MissingExternalBinding\", f\"external export {key!r} is not supplied\", where)\n\n    def _lower_source_metadata(self) -> tuple[dict[str, str], dict[str, str], dict[str, str]]:\n        source_keys: dict[str, str] = {}\n        for name, decl in self.sources.items():\n            source_keys[name] = decl.external\n            self._external(decl.external, name)\n        return source_keys, {}, {}\n\n    def _build_evidence(self, source_keys: Mapping[str, str]) -> dict[str, tuple[str, str, str]]:\n        # Return source-key -> (document, span, view) IDs.\n        out: dict[str, tuple[str, str, str]] = {}\n        for key in sorted(set(source_keys.values())):\n            reading = self.bindings.reading(key)\n            _instant(reading.available, f\"reading:{key}.available\")\n            _instant(reading.ingested, f\"reading:{key}.ingested\")\n            _instant(reading.review_date, f\"reading:{key}.review_date\")\n            _instant(reading.cutoff, f\"reading:{key}.cutoff\")\n            _iso(reading.instant, f\"reading:{key}.instant\")\n            if reading.system_as_of is not None:\n                _instant(reading.system_as_of, f\"reading:{key}.system_as_of\")\n            document_id = f\"document:{_clean_id(key)}\"\n            span_id = f\"span:{_clean_id(key)}\"\n            reading_id = f\"reading:{_clean_id(key)}\"\n            review_id = f\"review:{_clean_id(key)}\"\n            view_id = f\"evidence:{_clean_id(key)}\"\n            self.ir[\"sourceSpans\"].append({\n                \"id\": span_id, \"document\": document_id, \"locator\": f\"binding:{key}\",\n                \"literal\": reading.literal, \"extraction\": reading.extraction,\n            })\n            self.ir[\"documents\"].append({\n                \"id\": document_id, \"sha256\": hashlib.sha256(reading.literal.encode(\"utf-8\")).hexdigest(),\n                \"uri\": reading.uri, \"filing_id\": reading.filing_id, \"available\": reading.available,\n                \"availability_policy\": \"explicit_binding_timestamp\", \"ingested\": reading.ingested,\n            })\n            self.ir[\"reviewDecisions\"].append({\n                \"id\": review_id, \"reading_ids\": [reading_id], \"action\": reading.action,\n                \"reviewer\": reading.reviewer, \"date\": reading.review_date,\n                \"reason\": reading.review_reason, \"evidence\": [span_id],\n                \"prior_view\": reading.prior_view, \"new_view\": view_id,\n                \"invalidated_descendants\": [],\n            })\n            self.ir[\"evidenceViews\"].append({\n                \"id\": view_id, \"cutoff\": reading.cutoff, \"system_as_of\": reading.system_as_of,\n                \"mode\": \"ExplicitSelection\", \"documents\": [document_id], \"observations\": [],\n                \"decisions\": [review_id], \"conflict_sets\": [], \"transforms\": [],\n            })\n            out[key] = (document_id, span_id, view_id)\n            # The reading object is a small external export represented by the\n            # binding.  It is referenced by observations but is not embedded as\n            # an executable package or expected-result fixture.\n            self._reading_ids[key] = reading_id\n        return out\n\n    def build(self) -> CompileResult:\n        self.collect()\n        source_keys, _, _ = self._lower_source_metadata()\n        self._reading_ids: dict[str, str] = {}\n        evidence = self._build_evidence(source_keys)\n        assert self.entity is not None and self.book is not None and self.package is not None\n        entity = self.entity\n        book = self.book\n        package = self.package\n        model_scope = self.scope_id\n        # Core declarations and package context.\n        self.ir[\"entities\"].append({\"id\": entity.name, \"functional_currency\": entity.currency})\n        self.ir[\"packages\"].append({\n            \"id\": package.id, \"version\": package.version, \"digest\": package.digest,\n            \"basis\": package.basis,\n            \"effective\": _time(\"interval\", package.effective_start, package.effective_end, self.bindings.calendar_id),\n            \"operations\": [f\"{package.id}/{x}\" for x in package.operations],\n            \"extension_points\": [], \"dependencies\": list(package.dependencies),\n            \"authority\": list(package.authority), \"review_status\": package.review_status,\n            \"implementation\": package.implementation,\n        })\n        self.ir[\"books\"].append({\"id\": book.name, \"entity\": book.entity, \"basis\": package.id,\n                                  \"package\": package.id, \"currency\": entity.currency})\n        for account in self.accounts.values():\n            if account.book != book.name:\n                self.fail(\"BindingMismatch\", \"all accounts must belong to the declared book\", account.name)\n            if account.role not in {\"Asset\", \"Liability\", \"Expense\", \"Equity\"}:\n                self.fail(\"UnsupportedAccountRole\", f\"account role {account.role!r} is outside profile\", account.name)\n            self.ir[\"accounts\"].append({\"id\": account.name, \"book\": account.book,\n                                         \"role\": account.role, \"report_concept\": account.name})\n        # Time/context and observations.\n        observation_contexts: dict[str, str] = {}\n        for obs in self.observations.values():\n            _iso(obs.instant, obs.name)\n            if not obs.type_name.startswith(\"Money<\"):\n                self.fail(\"UnsupportedObservationType\", \"Core0.1 observations are monetary\", obs.name)\n            currency = obs.type_name[6:-1]\n            if currency != entity.currency:\n                self.fail(\"ContextMismatch\", \"observation currency must match the entity currency\", obs.name)\n            key = source_keys.get(obs.source)\n            if key is None:\n                self.fail(\"UnknownReference\", f\"observation source {obs.source!r} is not a source alias\", obs.name)\n            reading = self.bindings.reading(key)\n            oi = self.lower_expr(obs.value, f\"observation:{obs.name}\", \"value\", obs.type_name)\n            if oi[1] != obs.type_name:\n                self.fail(\"TypeMismatch\", \"observation literal must carry matching currency\", obs.name)\n            if _fraction(_literal_value(obs.value, obs.name)) != reading.amount:\n                self.fail(\"SourceReadingMismatch\", \"surface observation and bound reading disagree\", obs.name)\n            if reading.currency != currency or reading.instant != obs.instant:\n                self.fail(\"ReadingContextMismatch\", \"bound reading does not match observation context\", obs.name)\n            context_id = f\"context:{_clean_id(obs.name)}\"\n            observation_contexts[obs.name] = context_id\n            self.ir[\"contexts\"].append({\n                \"id\": context_id, \"entity\": entity.name, \"perimeter\": self.bindings.entity_perimeter,\n                \"concept\": \"debt_principal\", \"basis\": package.id, \"measurement\": \"principal\",\n                \"time\": _time(\"instant\", obs.instant, None, self.bindings.calendar_id),\n                \"unit\": currency, \"currency\": currency, \"taxonomy_version\": None, \"dimensions\": [],\n            })\n            document_id, span_id, view_id = evidence[key]\n            reading_id = self._reading_ids[key]\n            review_id = f\"review:{_clean_id(key)}\"\n            self.ir[\"observations\"].append({\n                \"id\": obs.name, \"context\": context_id, \"domain\": {\n                    \"kind\": \"exact\", \"lower\": rational(reading.amount), \"upper\": rational(reading.amount),\n                    \"lower_closed\": True, \"upper_closed\": True, \"values\": [], \"missing_reason\": None,\n                    \"display\": obs.value.display or f\"{reading.amount} {currency}\",\n                    \"rounding_rule\": \"exact_binding\",\n                }, \"source_spans\": [span_id], \"reading\": reading_id,\n                \"review_decision\": review_id, \"supersedes\": [], \"revision_group\": f\"binding-{_clean_id(key)}\",\n            })\n            for view in self.ir[\"evidenceViews\"]:\n                if view[\"id\"] == view_id:\n                    view[\"observations\"].append(obs.name)\n        # Symbols and declarations.\n        for symbol in self.symbols.values():\n            if symbol.type_name != \"Real\":\n                self.fail(\"UnsupportedSymbol\", \"Core0.1 admits one Real interval symbol\", symbol.name)\n            low = self.lower_expr(symbol.lower, f\"symbol:{symbol.name}\", \"lower\", \"Real\")\n            high = self.lower_expr(symbol.upper, f\"symbol:{symbol.name}\", \"upper\", \"Real\")\n            if low[1] != \"Real\" or high[1] != \"Real\" or low[3] is None or high[3] is None or low[3] > high[3]:\n                self.fail(\"InvalidDomain\", \"symbol bounds must be ordered constants\", symbol.name)\n            source_key = next(iter(source_keys.values()))\n            admission = self.bindings.admission(symbol.name)\n            if admission.reading_key != source_key or _string(admission.reason) != _string(symbol.reason):\n                self.fail(\"SymbolAdmission\", \"source reason and supplied admission disagree\", symbol.name)\n            span_id = evidence[source_key][1]\n            self.ir[\"symbols\"].append({\n                \"id\": symbol.name, \"type\": symbol.type_name, \"context\": None,\n                \"domain\": {\"kind\": \"interval\", \"lower\": rational(low[3]), \"upper\": rational(high[3]),\n                            \"lower_closed\": True, \"upper_closed\": True, \"values\": [],\n                            \"missing_reason\": None, \"display\": None, \"rounding_rule\": None},\n                \"uncertainty_kind\": self.bindings.symbol_uncertainty, \"scope\": self.model_id,\n                \"dependencies\": [], \"admission\": f\"admission:{symbol.name}\", \"provenance\": [span_id],\n            })\n        for name in self.lets:\n            self._lower_let(name)\n        # Contract, alternatives, and scenario expressions.\n        contract = next(iter(self.contracts.values()))\n        fields = dict(contract.fields)\n        required_fields = {\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"}\n        if set(fields) != required_fields:\n            self.fail(\"ContractFields\", \"DebtMix requires principal, fraction and two rates\", contract.name)\n        field_rows = []\n        for name in (\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"):\n            expected = {\"principal\": f\"Money<{entity.currency}>\", \"fixed_fraction\": \"Real\",\n                        \"fixed_rate\": \"Rate<annual_simple>\", \"initial_floating_rate\": \"Rate<annual_simple>\"}[name]\n            info = self.lower_expr(fields[name], f\"contract:{contract.name}\", f\"field:{name}\", expected)\n            if info[1] != expected:\n                self.fail(\"ContractType\", f\"field {name!r} has type {info[1]}, expected {expected}\", contract.name)\n            if name in {\"fixed_rate\", \"initial_floating_rate\"}:\n                self._assumption_row(f\"contract:{contract.name}:{name}\", info[0], contract.name, evidence)\n            field_rows.append({\"name\": name, \"expression\": info[0]})\n        self.ir[\"contracts\"].append({\"id\": contract.name, \"type\": f\"{package.id}/{contract.type_name}\",\n                                      \"book\": contract.book, \"fields\": field_rows, \"package\": package.id,\n                                      \"source_refs\": [evidence[next(iter(source_keys.values()))][1]]})\n        alt_ids = []\n        constraint_ids = []\n        for alt in self.alternatives.values():\n            meta = self.bindings.alternative(alt.name)\n            alt_ids.append(alt.name)\n            alt_constraints = []\n            for index, assumption in enumerate(alt.assumptions):\n                eid = self.lower_expr(assumption, f\"alternative:{alt.name}\", f\"assumption:{index}\")[0]\n                cid = f\"constraint:{_clean_id(alt.name)}:{index}\"\n                self.ir[\"constraints\"].append({\"id\": cid, \"expression\": eid, \"kind\": \"assumption\",\n                                                \"scope\": alt.name, \"source_refs\": []})\n                alt_constraints.append(cid)\n                self._assumption_row(f\"alternative:{alt.name}:{index}\", eid, alt.name, evidence)\n            if not alt_constraints:\n                self.fail(\"MissingAlternativeCondition\", \"named alternatives require a Boolean condition\", alt.name)\n            self.ir[\"alternatives\"].append({\n                \"id\": alt.name, \"parent\": f\"history:{_clean_id(self.model_id)}\", \"scope\": model_scope,\n                \"author\": meta.author,\n                \"created_at\": meta.created_at,\n                \"constraints\": alt_constraints, \"choice_group\": None,\n                \"reason\": meta.reason, \"evidence\": [evidence[next(iter(source_keys.values()))][1]],\n                \"opposing_evidence\": [],\n            })\n        for con in self.constraints.values():\n            eid = self.lower_expr(con.expression, f\"constraint:{con.name}\", \"condition\")[0]\n            self.ir[\"constraints\"].append({\"id\": con.name, \"expression\": eid, \"kind\": \"assumption\",\n                                           \"scope\": model_scope, \"source_refs\": []})\n            constraint_ids.append(con.name)\n            self._assumption_row(f\"constraint:{con.name}\", eid, model_scope, evidence)\n        scenario = next(iter(self.scenarios.values()))\n        settings = dict(scenario.settings)\n        if set(settings) != {\"market_rate\"}:\n            self.fail(\"ScenarioFields\", \"Core0.1 scenario requires one market_rate setting\", scenario.name)\n        driver = self.lower_expr(settings[\"market_rate\"], f\"scenario:{scenario.name}\", \"market_rate\")\n        if not driver[1].startswith(\"Driver<Rate<\"):\n            self.fail(\"ScenarioType\", \"market_rate must be a constant annual rate driver\", scenario.name)\n        self._assumption_row(f\"scenario:{scenario.name}\", driver[0], scenario.name, evidence)\n        self.ir[\"scenarios\"].append({\"id\": scenario.name, \"kind\": \"ExogenousStress\",\n                                      \"drivers\": [{\"name\": \"market_rate\", \"expression\": driver[0]}],\n                                      \"probability_model\": None, \"observed_event\": None, \"structural_model\": None,\n                                      \"replaced_equations\": [], \"visibility\": \"announced\"})\n        # Opening state and report mapping.\n        opening_decl = next(iter(self.openings.values()))\n        opening = self.bindings.opening(opening_decl.external)\n        if opening.book is not None and opening.book != opening_decl.book:\n            self.fail(\"OpeningStateMismatch\", \"opening binding belongs to another book\", opening_decl.name)\n        account_names = {a.name for a in self.accounts.values()}\n        bound_names = {name for name, _ in opening.balances}\n        if account_names != bound_names:\n            self.fail(\"OpeningStateMismatch\", \"opening binding must provide every account exactly once\", opening_decl.name)\n        total = sum((value for _, value in opening.balances), Fraction(0))\n        if total != 0:\n            self.fail(\"UnbalancedState\", \"opening signed balances must sum to zero\", opening_decl.name)\n        self.ir[\"states\"].append({\"id\": opening_decl.name, \"date\": _iso(opening.date, opening_decl.name),\n                                   \"book\": opening_decl.book,\n                                   \"balances\": [{\"account\": name, \"signed_amount\": rational(value)} for name, value in opening.balances],\n                                   \"contracts\": [contract.name], \"measurements\": [],\n                                   \"dependencies\": list(opening.dependencies) or [evidence[next(iter(source_keys.values()))][2]]})\n        report = next(iter(self.reports.values()))\n        rb = self.bindings.report(report.mapping.key if isinstance(report.mapping, External) else str(report.mapping)) if isinstance(report.mapping, External) else None\n        if rb is None:\n            self.fail(\"UnsupportedReportMapping\", \"report mapping must be an explicit external binding\", report.name)\n        self.ir[\"reportMappings\"].append({\"id\": report.name, \"book\": report.book, \"basis\": package.id,\n                                          \"rows\": [{\"name\": \"package_mapping\", \"expression\": self._source_ref_expr(rb.mapping, report.name)}],\n                                          \"closing_policy\": f\"{package.id}/{rb.closing_policy}\",\n                                          \"cash_flow_policy\": f\"{package.id}/{rb.cash_flow_policy}\",\n                                          \"required_operations\": [f\"{package.id}/{x}\" for x in rb.required_operations]})\n        # Profile scope and conservative family status.  This profile does not\n        # perform a reconstruction or feasibility search.\n        slot = self._literal_expr(\"scope\", \"slot_limit\", 1, \"Int\")\n        self.ir[\"modelScopes\"].append({\"id\": model_scope, \"templates\": [f\"{package.id}/{contract.type_name}\"],\n                                       \"slot_limits\": [{\"name\": \"debt_contracts\", \"expression\": slot}],\n                                       \"resolution\": \"one fixed/floating aggregate, annual simple accrual\",\n                                       \"calendars\": [self.bindings.calendar_id], \"choices\": [],\n                                       \"exclusions\": [\"fees\", \"foreign_currency\", \"embedded_options\"], \"obligations\": []})\n        family_id = f\"history:{_clean_id(self.model_id)}\"\n        self.ir[\"historyFamilies\"].append({\"id\": family_id, \"scope\": model_scope,\n            \"evidence_view\": evidence[next(iter(source_keys.values()))][2], \"opening_state\": opening_decl.name,\n            \"symbols\": list(self.symbols), \"choices\": [], \"constraints\": constraint_ids,\n            \"alternatives\": alt_ids, \"feasibility\": \"Unknown\", \"coverage\": \"PartialSearch\",\n            \"completed_cells\": 0, \"unresolved_cells\": 1, \"witnesses\": [], \"solver_results\": []})\n        declarations = [self.let_ids.get(n, n) for n in self.decls]\n        declarations = [n for n in declarations if n not in self.sources]\n        self.ir[\"models\"].append({\"id\": self.model_id, \"language_version\": \"Core0.1\",\n                                  \"declarations\": list(dict.fromkeys(declarations)),\n                                  \"package_lock\": [package.id], \"scope\": model_scope})\n        self.ir[\"expressions\"] = list(self.expr_rows.values())\n        self.ir[\"diagnostics\"] = []\n        # Evidence view observations were added after creation; record all\n        # generated rows deterministically.\n        self.ir[\"sourceSpans\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"documents\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"observations\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"expressions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"assumptions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"constraints\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"alternatives\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"reviewDecisions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"evidenceViews\"].sort(key=lambda r: r[\"id\"])\n        # Validate the generated structure before exposing it.\n        checked = validate_ir(self.ir, self.bindings)\n        if not checked.ok:\n            raise _Failure(checked.diagnostics[0])\n        return CompileResult(copy.deepcopy(self.ir), (), MappingProxyType(copy.deepcopy(self.source_map)))\n\n    def _source_ref_expr(self, mapping: str, owner: str) -> str:\n        return self._literal_expr(owner, \"report_mapping\", mapping, \"SourceRef\")\n\n    def _literal_expr(self, owner: str, path: str, value: Any, typ: str) -> str:\n        expr = Literal(value, type_name=typ)\n        return self.lower_expr(expr, owner, path)[0]\n\n    def _assumption_row(self, key: str, expression: str, scope: str,\n                        evidence: Mapping[str, tuple[str, str, str]]) -> str:\n        # Existing row IDs are reused when the same source expression is\n        # referenced by more than one binding, while metadata remains explicit.\n        aid = f\"assumption:{_clean_id(key)}\"\n        if any(r[\"id\"] == aid for r in self.ir[\"assumptions\"]):\n            return aid\n        # The demo helper supplies coarse keys.  Custom callers can provide\n        # exact keys; fall back only to the documented profile categories.\n        if key.startswith(\"alternative:\"):\n            meta = self.bindings.assumption(\"alternative\")\n        elif key.startswith(\"contract:\"):\n            meta = self.bindings.assumption(\"contract-rate\")\n        elif key.startswith(\"scenario:\"):\n            meta = self.bindings.assumption(\"scenario\")\n        elif key.startswith(\"constraint:\"):\n            meta = self.bindings.assumption(\"constraint\")\n        else:\n            meta = self.bindings.assumption(key)\n        start, end, cutoff = meta.valid_start, meta.valid_end, meta.information_cutoff\n        self.ir[\"assumptions\"].append({\"id\": aid, \"expression\": expression, \"scope\": scope,\n            \"rationale\": meta.rationale, \"provenance\": meta.provenance, \"source_refs\": list(meta.source_refs),\n            \"valid\": _time(\"interval\", start, end, self.bindings.calendar_id),\n            \"information_cutoff\": cutoff, \"role\": meta.role})\n        return aid\n\n\n_IR_OPS = {\"+\": \"add\", \"-\": \"subtract\", \"*\": \"multiply\", \"/\": \"divide\",\n           \"==\": \"eq\", \"!=\": \"ne\", \"<\": \"lt\", \"<=\": \"le\", \">\": \"gt\", \">=\": \"ge\",\n           \"and\": \"and\", \"or\": \"or\"}\n\n\ndef _numeric_type(typ: str) -> bool:\n","exit_code":0,"status":"completed"}}
