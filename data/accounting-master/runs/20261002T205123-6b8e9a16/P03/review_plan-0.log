{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' scripts/core0_frontends_v1.py\"","aggregated_output":"\"\"\"Textual Core 0.1 frontend.\n\nThe frontend retains token spelling and source positions while translating the\ngrammar into the typed constructors in :mod:`core0_ir_v1`.  It deliberately\ndoes not construct IR from a fixture or from a JSON schema.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nfrom typing import Any, Mapping, Optional\n\nfrom lark import Lark, Token, Tree, UnexpectedInput\n\ntry:  # Support both ``scripts.core0_frontends_v1`` and direct script imports.\n    from .core0_ir_v1 import (\n        AccountDecl, AlternativeDecl, ArrayExpr, Binary, BookDecl, Call, CompileBindings,\n        ConstraintDecl, ContractDecl, EntityDecl, External, Expr, LetDecl, Literal,\n        ObservationDecl, OpeningDecl, Program, RecordExpr, Ref, ReportDecl, ScenarioDecl,\n        SourceDecl, SymbolDecl, Unary, UnsupportedDecl, UseDecl, compile_program,\n    )\nexcept ImportError:  # pragma: no cover - used when scripts/ is sys.path[0].\n    from core0_ir_v1 import (\n        AccountDecl, AlternativeDecl, ArrayExpr, Binary, BookDecl, Call, CompileBindings,\n        ConstraintDecl, ContractDecl, EntityDecl, External, Expr, LetDecl, Literal,\n        ObservationDecl, OpeningDecl, Program, RecordExpr, Ref, ReportDecl, ScenarioDecl,\n        SourceDecl, SymbolDecl, Unary, UnsupportedDecl, UseDecl, compile_program,\n    )\n\n\nROOT = Path(__file__).resolve().parents[1]\nGRAMMAR_PATH = ROOT / \"docs/design/spec/core-0.lark\"\n\n\n@dataclass(frozen=True)\nclass _Node:\n    data: str\n    children: tuple[Any, ...]\n    start: int\n    end: int\n\n\n@dataclass(frozen=True)\nclass FrontendProgram:\n    program: Program\n    source_spans: Mapping[int, Mapping[str, Any]]\n\n\ndef _node(value: Any) -> Any:\n    if isinstance(value, Tree):\n        meta = value.meta\n        return _Node(value.data, tuple(_node(c) for c in value.children),\n                     int(getattr(meta, \"start_pos\", 0)), int(getattr(meta, \"end_pos\", 0)))\n    return value\n\n\ndef _text(value: Any) -> str:\n    return str(value)\n\n\ndef _strip_string(value: str, where: str) -> str:\n    try:\n        parsed = json.loads(value)\n    except (TypeError, json.JSONDecodeError) as exc:\n        raise ValueError(f\"invalid JSON string at {where}\") from exc\n    if not isinstance(parsed, str):\n        raise ValueError(f\"expected a string at {where}\")\n    return parsed\n\n\ndef _type(node: Any) -> str:\n    if not isinstance(node, _Node) or node.data != \"type\":\n        raise ValueError(\"expected type node\")\n    if not node.children:\n        raise ValueError(\"empty type\")\n    name = _text(node.children[0])\n    if len(node.children) == 1:\n        return name\n    return f\"{name}<{','.join(_type(c) for c in node.children[1:])}>\"\n\n\ndef _mark(expr: Expr, node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\n    spans[id(expr)] = {\"start\": node.start, \"end\": node.end,\n                       \"text\": source[node.start:node.end]}\n    return expr\n\n\ndef _operator_fold(node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\n    if not node.children:\n        raise ValueError(f\"empty {node.data}\")\n    current = _expr(node.children[0], source, spans)\n    i = 1\n    while i < len(node.children):\n        op = _text(node.children[i])\n        right = _expr(node.children[i + 1], source, spans)\n        current = _mark(Binary(op, current, right), node, source, spans)\n        i += 2\n    return current\n\n\ndef _expr(value: Any, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\n    if isinstance(value, Token):\n        if value.type == \"NAME\":\n            return _mark(Ref(_text(value)), _Node(\"token\", (), value.start_pos, value.end_pos), source, spans)\n        if value.type == \"BOOL\":\n            node = _Node(\"bool\", (), value.start_pos, value.end_pos)\n            return _mark(Literal(_text(value) == \"true\", type_name=\"Bool\", display=_text(value)), node, source, spans)\n        if value.type == \"DATE\":\n            node = _Node(\"date\", (), value.start_pos, value.end_pos)\n            return _mark(Literal(_text(value), type_name=\"Date\", display=_text(value)), node, source, spans)\n        if value.type == \"STRING\":\n            node = _Node(\"string\", (), value.start_pos, value.end_pos)\n            return _mark(Literal(_strip_string(_text(value), \"string\"), type_name=\"String\", display=_text(value)), node, source, spans)\n        raise ValueError(f\"unexpected token {_text(value)!r}\")\n    if not isinstance(value, _Node):\n        raise ValueError(\"expected expression node\")\n    if value.data == \"number\":\n        if not value.children:\n            raise ValueError(\"empty number\")\n        spelling = _text(value.children[0])\n        try:\n            number = Fraction(spelling) if \".\" not in spelling else Fraction(spelling)\n        except ValueError as exc:\n            raise ValueError(f\"invalid number {spelling!r}\") from exc\n        raw = source[value.start:value.end].strip()\n        unit: Optional[str] = None\n        if re.search(r\"\\bper\\s+year\\s*$\", raw):\n            unit = \"per year\"\n        elif len(value.children) > 1:\n            # The grammar spells an annual suffix as two literal children\n            # (``per``, ``year``) while a currency suffix is one NAME.  Join\n            # the former before semantic lowering so ``0.05`` and\n            # ``0.05 per year`` cannot collapse to the same dimensionless\n            # literal.\n            suffix = \" \".join(_text(child) for child in value.children[1:])\n            unit = \"per year\" if suffix == \"per year\" else suffix\n        return _mark(Literal(number, unit=unit, display=raw), value, source, spans)\n    if value.data in {\"disjunction\", \"conjunction\", \"comparison\", \"sum\", \"product\"}:\n        return _operator_fold(value, source, spans)\n    if value.data == \"unary\":\n        if len(value.children) == 1:\n            return _expr(value.children[0], source, spans)\n        op, child = _text(value.children[0]), _expr(value.children[1], source, spans)\n        return _mark(Unary(op, child), value, source, spans)\n    if value.data == \"postfix\":\n        current = _expr(value.children[0], source, spans)\n        for child in value.children[1:]:\n            current = _mark(Call(\"field\", (current, Ref(_text(child)))), value, source, spans)\n        return current\n    if value.data == \"call\":\n        if not value.children:\n            raise ValueError(\"empty call\")\n        name = _text(value.children[0])\n        args = tuple(_expr(c, source, spans) for c in value.children[1:])\n        if name == \"external\":\n            if len(args) != 1 or not isinstance(args[0], Literal) or not isinstance(args[0].value, str):\n                raise ValueError(\"external requires one string literal\")\n            return _mark(External(args[0].value), value, source, spans)\n        return _mark(Call(name, args), value, source, spans)\n    if value.data == \"array\":\n        return _mark(ArrayExpr(tuple(_expr(c, source, spans) for c in value.children)), value, source, spans)\n    if value.data == \"record\":\n        fields: list[tuple[str, Expr]] = []\n        for child in value.children:\n            if not isinstance(child, _Node) or child.data != \"record_field\":\n                raise ValueError(\"invalid record field\")\n            fields.append((_text(child.children[0]), _expr(child.children[1], source, spans)))\n        return _mark(RecordExpr(fields), value, source, spans)\n    if value.data == \"record_field\":\n        raise ValueError(\"record field outside record\")\n    if value.data == \"atom\" and value.children:\n        return _expr(value.children[0], source, spans)\n    raise ValueError(f\"unsupported expression syntax {value.data!r}\")\n\n\ndef _domain(node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> tuple[Expr, Expr] | None:\n    if node.data != \"domain\" or len(node.children) != 2:\n        return None\n    raw = source[node.start:node.end].lstrip()\n    if not raw.startswith(\"[\"):\n        return None  # finite choices are outside Core0.1\n    return (_expr(node.children[0], source, spans), _expr(node.children[1], source, spans))\n\n\ndef parse_program(source: str) -> FrontendProgram:\n    parser = Lark(GRAMMAR_PATH.read_text(encoding=\"utf-8\"), parser=\"lalr\",\n                  propagate_positions=True, maybe_placeholders=False)\n    tree = _node(parser.parse(source))\n    if not isinstance(tree, _Node) or tree.data != \"start\" or len(tree.children) < 2:\n        raise ValueError(\"module header is required\")\n    module, version = _text(tree.children[0]), _strip_string(_text(tree.children[1]), \"module version\")\n    spans: dict[int, dict[str, Any]] = {}\n    declarations: list[Any] = []\n    uses: list[UseDecl] = []\n    unsupported = {\"choice\", \"event\", \"rule\", \"require\", \"post\", \"setting\", \"parameters\"}\n    for item in tree.children[2:]:\n        if not isinstance(item, _Node):\n            raise ValueError(\"unexpected module token\")\n        d, c = item.data, item.children\n        try:\n            if d == \"use\":\n                uses.append(UseDecl(_text(c[0]), _strip_string(_text(c[1]), \"use version\")))\n            elif d == \"source\":\n                value = _expr(c[1], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"source requires external(string)\")\n                declarations.append(SourceDecl(_text(c[0]), value.key))\n            elif d == \"entity\":\n                declarations.append(EntityDecl(_text(c[0]), _text(c[1])))\n            elif d == \"book\":\n                declarations.append(BookDecl(_text(c[0]), _text(c[1]), _text(c[2]), _strip_string(_text(c[3]), \"book version\")))\n            elif d == \"account\":\n                declarations.append(AccountDecl(_text(c[0]), _text(c[1]), _text(c[2])))\n            elif d == \"opening\":\n                value = _expr(c[2], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"opening requires external(string)\")\n                declarations.append(OpeningDecl(_text(c[0]), _text(c[1]), value.key))\n            elif d == \"observation\":\n                typ = _type(c[1])\n                ts = c[2]\n                if not isinstance(ts, _Node) or ts.data != \"time_spec\":\n                    raise ValueError(\"observation time is required\")\n                if len(ts.children) == 1:\n                    instant = _text(ts.children[0]).lstrip(\"@\")\n                else:\n                    raise ValueError(\"period observations are outside Core0.1\")\n                value = _expr(c[3], source, spans)\n                declarations.append(ObservationDecl(_text(c[0]), typ, instant, value, _text(c[4])))\n            elif d == \"symbol\":\n                typ = _type(c[1]); bounds = _domain(c[2], source, spans)\n                if bounds is None:\n                    declarations.append(UnsupportedDecl(\"finite-domain\", _text(c[0])))\n                else:\n                    declarations.append(SymbolDecl(_text(c[0]), typ, bounds[0], bounds[1],\n                                                   _strip_string(_text(c[3]), \"symbol reason\")))\n            elif d == \"binding\":\n                name = _text(c[0]); idx = 1; declared = None\n                if isinstance(c[idx], _Node) and c[idx].data == \"type\":\n                    declared = _type(c[idx]); idx += 1\n                declarations.append(LetDecl(name, _expr(c[idx], source, spans), declared))\n            elif d == \"constraint\":\n                declarations.append(ConstraintDecl(_text(c[0]), _expr(c[1], source, spans)))\n            elif d == \"contract\":\n                fields = []\n                for field_node in c[3:]:\n                    if not isinstance(field_node, _Node) or field_node.data != \"field\":\n                        raise ValueError(\"invalid contract field\")\n                    fields.append((_text(field_node.children[0]), _expr(field_node.children[1], source, spans)))\n                declarations.append(ContractDecl(_text(c[0]), _text(c[1]), _text(c[2]), fields))\n            elif d == \"alternative\":\n                assumptions = []\n                for assumption in c[1:]:\n                    if not isinstance(assumption, _Node) or assumption.data != \"assumption\":\n                        raise ValueError(\"invalid alternative assumption\")\n                    assumptions.append(_expr(assumption.children[0], source, spans))\n                declarations.append(AlternativeDecl(_text(c[0]), assumptions))\n            elif d == \"scenario\":\n                settings = []\n                for setting in c[1:]:\n                    if not isinstance(setting, _Node) or setting.data != \"setting\":\n                        raise ValueError(\"invalid scenario setting\")\n                    settings.append((_text(setting.children[0]), _expr(setting.children[1], source, spans)))\n                declarations.append(ScenarioDecl(_text(c[0]), settings))\n            elif d == \"report\":\n                fields = [x for x in c[2:] if isinstance(x, _Node) and x.data == \"field\"]\n                mappings = [x for x in fields if _text(x.children[0]) == \"mapping\"]\n                if len(mappings) != 1:\n                    raise ValueError(\"report requires one mapping field\")\n                mapping = _expr(mappings[0].children[1], source, spans)\n                declarations.append(ReportDecl(_text(c[0]), _text(c[1]), mapping))\n            elif d in unsupported:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n            else:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n        except (IndexError, TypeError, ValueError) as exc:\n            raise ValueError(f\"invalid {d} declaration at {item.start}: {exc}\") from exc\n    return FrontendProgram(Program(module, version, declarations, uses), spans)\n\n\ndef compile_source(source: str, bindings: CompileBindings):\n    \"\"\"Parse and lower a source program through the shared compiler.\"\"\"\n    try:\n        parsed = parse_program(source)\n    except UnexpectedInput as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        start = getattr(exc, \"pos_in_stream\", None)\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\",\n                                               span=(start, start) if start is not None else None),), {})\n    except ValueError as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\"),), {})\n    return compile_program(parsed.program, bindings, source_spans=parsed.source_spans, input_text=source)\n\n\n__all__ = [\"FrontendProgram\", \"compile_source\", \"parse_program\"]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' docs/design/spec/core0-lowering-profile-v1.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' docs/design/spec/core0-lowering-profile-v1.md\"","aggregated_output":"# Core 0.1 debt source lowering, version 1\n\nThis executable profile supplements the protected Core 0 grammar and contract.\n`compile_source(text, bindings)` parses real source; `compile_program(Program,\nbindings)` accepts immutable typed declarations. Both bind names, check quantities\nand context, construct shared IR, and submit it to independent schema and semantic\nvalidation. Neither entrypoint reads the authored expected IR or expected results.\n\n## Repair execution audit\n\nThe approved P03 plan remains the implementation boundary. Inspection of the\ntimed-out attempt found two partial modules and no tests or deliverables. Its\nsuccessful example compile was insufficient: global constraints were dropped,\nrates were treated as dimensionless, and acceptance, package and domain checks\nwere incomplete. These are implementation failures, not evidence against the\nlanguage design. Repair them before accepting the slice.\n\nThe baseline is `borrowing.acc`, plus documented corresponding fields of the\nauthored IR, whose reconstruction claims are excluded. Independently constructed\ntyped programs and exact arithmetic checks supplement agreement between frontends.\nSchema validity is a prerequisite, not semantic acceptance. Negative IR cases must\nbe structurally valid before testing the intended semantic rejection. Stops are\nunexpected protected-input changes, missing dependencies, or failing mandatory\nchecks; failures trigger repair, never a passing report. No statistical, timing,\nusability, accounting-compliance or forecasting comparison is being run.\n\nProvenance of material choices: exact rationals, lexical rules and quantities come\nfrom `core-contract.md`; USD accounts and DebtMix fields come from the local\nDemoDebt package. These are bounded baseline restrictions, not promoted defaults.\nThe single source/observation/symbol restriction keeps the evidence view explicit;\nmultiple-source reconciliation is unsupported. Synthetic acceptance and admission\nrecords are supplied by the caller. Absence of reconstruction requires Unknown\nfeasibility, PartialSearch, zero completed cells, one unsearched cell, no witnesses\nand no solver results. Early diagnostics cover unit loss, silent constraint loss,\ninvented acceptance and copied package digests. A pass establishes deterministic\nengineering conformance only. Results are preserved in the two P03 deliverables.\n\nThe writable project files are the two versioned modules, checker, required test,\nthis profile, the versioned cases JSON and the two P03 deliverables. Existing\ngrammar/schema, authored fixtures, legacy validators, controllers, release-pinned\nfiles and preserved snapshots remain protected. Their current hashes are checked\nagainst phase-entry hashes where available, and before/after execution. Git is\nunavailable (existing marker is not a usable repository); no Git initialization.\nPython 3.11.15, Lark 1.3.1 and jsonschema 4.26.0 are existing dependencies. No\naccelerator framework, service, installation, model or background job is used.\n\n## Supported language and bindings\n\nThe profile has one module, DemoDebt@1 import, source, entity, USD book, exact\ninstant debt observation, admitted Real interval symbol, opening, DebtMix\ncontract, constant annual-rate stress and package report. Its four account names\nare Cash, Debt, InterestExpense and Retained, with Asset, Liability, Expense and\nEquity roles respectively: the package report actually names these accounts.\nOther declaration names may vary. There may be multiple lets, Boolean constraints\nand conditional alternatives, with multiple assumptions in each alternative.\nGlobal constraints constrain the parent family; alternative constraints stay in\ntheir respective branches and are not conjoined in the parent. No branch is\nselected or solved.\n\nBindings explicitly supply a digest-locked local package, synthetic reading and\nacceptance action, information/system cutoffs, opening balances, perimeter,\nsymbol admission, assumption periods/origins, and alternative authorship. Binding\nrecords remain separate from package definitions. Every acceptance must explicitly\nsay Accept; no declaration creates acceptance. Package loading is restricted to\nthe retained DemoDebt file and checks its fixed version, digest, exports and\napplicability. Paths escaping the repository and overrides are errors. The\npackage's registry examples and expected-result fields are not compiler inputs.\n\nDecimal tokens become Fraction directly; binary floats are rejected. Strings use\nJSON escapes, reject unpaired surrogates and normalize semantic strings to NFC.\nOriginal spelling and Unicode-code-point offsets remain in the separate source\nmap; typed locations identify constructors. LF, CRLF, comments and whitespace\npreserve semantics. Dates are Gregorian. All grammar words are reserved.\n\nExpressions include literals, shared references, `value(observation)`, unary minus,\n`not`, compatible addition/subtraction, numeric comparisons, typed equality and\nBoolean composition. Multiplication admits a dimensionless Real or Int factor;\ndivision requires a provably nonzero constant Real or Int denominator. Rates and\nYearFraction are dimensional; rate times money is rejected here (the general\n`simpleInterest` builtin is future work). Integer products remain integer; division\nof scalars returns Real. Addition and comparisons require equal types and compatible\ncontexts. `constant(rate)` is a scenario driver, with a constant, nonnegative annual\nrate. `external(string)` is admitted only for source/opening/report declarations.\nDebtMix principal must equal the accepted debt and opening liability, its fraction\nmust have proven bounds inside [0,1], and component rates must be constant and\nnonnegative. Interval arithmetic proves only conservative bounds; failure to prove\na bound rejects this profile and does not assert mathematical infeasibility.\n\n## Verification and remaining coverage\n\nRun `python3 -B -m unittest discover -s tests -p 'test_accounting_p03.py' -v`, then\n`python3 -B scripts/check_accounting_p03.py --output-dir data/accounting-master/deliverables/P03`.\nThe checker returns nonzero for failed or skipped obligations, includes generated\nIR and binding projections, observations, diagnostics, hashes and runtime details,\nand writes only conformance.json and result.md under the declared output folder.\n\nThe semantic comparison retains IR values, contexts, locks, evidence, assumptions\nand all external bindings. It excludes frontend offsets and observation display\nspelling; those are separately preserved. The authored comparison uses debt value,\ncontext, contract types/fields, assumptions, endpoint conditions, scenario rate,\nopening balances and report policies. Exact one-year interest is checked as\nP * (alpha * fixed_rate + (1-alpha) * stress_rate), using evaluated generated\nfields. At alpha=1/0, P=100 and 5%/7% imply 5/7; 9% stress implies 5/9;\nP=200 implies 10/14. This calculation is not journal execution or forecasting.\n\nMC02/MC04 receive bounded context, evidence and assumption preservation checks;\nMC10 receives factual admission and explicit scenario-assumption checks; MC20\nreceives locked-package and override rejection checks; MC23 receives matched\ntyped/text tasks; MC24 receives parsing, binding, typing and semantic diagnostics.\nNone is wholly closed by this profile. G2, G12 and G15 remain open, as do all wider\nMC01–MC35 and G1–G18 obligations.\n\nUnsupported: general package loading, events, rules/overrides, postings, arbitrary\nreport mappings, records/arrays/field access, finite choices, nonlinear bound\nproofs, implicit conversions, multiple books/entities/observations, dimensions,\ncurrency/calendar variants, rounded or period observations, source conflicts and\nrevisions, cross-company mapping, extraction uncertainty, accounting elections,\nmeasurement estimates, behavior policies, future innovations and probability\nmeasures. Reconstruction, accounting execution, forecast validity, authoring\nsuperiority and human acceptance require separate evidence.\n","exit_code":0,"status":"completed"}}
