{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"cat > tests/test_accounting_p03.py <<'PY'\n\\\"\\\"\\\"Executed P03 obligations; authored typed inputs never pass through the parser.\\\"\\\"\\\"\nimport copy\nfrom dataclasses import replace\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport unittest\nfrom unittest.mock import patch\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'scripts'))\nimport core0_ir_v1 as ir\nfrom core0_frontends_v1 import compile_source\nimport jsonschema\n\nOBSERVATIONS = []\nBASE = (ROOT / 'docs/design/fixtures/borrowing.acc').read_text()\nREASON = 'Fixed-rate proportion not disclosed'\nRENAMED = '''module FinancingStudy version \\\"2\\\";\nuse DemoDebt version \\\"1\\\";\nsource disclosure = external(\\\"synthetic-note-7\\\");\nentity Beta functional USD;\nbook Statutory entity Beta basis DemoDebt version \\\"1\\\";\naccount Cash : Asset book Statutory;\naccount Debt : Liability book Statutory;\naccount InterestExpense : Expense book Statutory;\naccount Retained : Equity book Statutory;\nopening carried for Statutory from external(\\\"after-2025-close\\\");\nobservation borrowing : Money<USD> instant @2025-12-31 = 150 USD from disclosure;\nsymbol share : Real in [0, 1] because \\\"Fixed-rate proportion not disclosed\\\";\ncontract facility : DebtMix book Statutory {\n principal = value(borrowing); fixed_fraction = share;\n fixed_rate = 0.05 per year; initial_floating_rate = 0.05 per year;\n}\nalternative fixed { assume share == 1; }\nalternative floating { assume share == 0; }\nscenario shock { set market_rate = constant(0.08 per year); }\nreport financials for Statutory { mapping = external(\\\"DemoDebt.statements.v1\\\"); }\n'''\n\n\ndef bindings(principal=100, renamed=False):\n    \\\"\\\"\\\"Explicit synthetic evidence, separately authored from source and expected IR.\\\"\\\"\\\"\n    p = F(principal); stamp = '2026-01-01T00:00:00Z'\n    book, symbol = ('Statutory', 'share') if renamed else ('Local', 'alpha')\n    names = ('fixed', 'floating') if renamed else ('allFixed', 'allFloating')\n    package_path = ROOT / 'docs/design/fixtures/demo-debt-package.json'\n    return ir.CompileBindings(\n        packages=[ir.PackageBinding('DemoDebt', '1', hashlib.sha256(package_path.read_bytes()).hexdigest(),\n            'DemoDebt', '2025-01-01', '2028-01-01', ['reset','accrue_and_pay','close','statements'],\n            ['builtin:Core0@1','DemoCalendar@1'], ['fixture:demo-debt-package.json'])],\n        readings=[ir.ReadingBinding('synthetic-note-7', f'Synthetic disclosed debt {p} USD; split undisclosed', p,\n            'USD', '2025-12-31', 'fixture:p03-synthetic', 'synthetic-2025', stamp, stamp,\n            'synthetic-author', stamp, 'Explicit synthetic acceptance, not human approval', stamp,\n            system_as_of=stamp, action='Accept')],\n        openings=[ir.OpeningBinding('after-2025-close', '2025-12-31',\n            {'Cash':p-5, 'Debt':-p, 'InterestExpense':0, 'Retained':5}, book=book)],\n        reports=[ir.ReportBinding('DemoDebt.statements.v1','DemoDebt.statements.v1',\n            'interest_operating','close',['accrue_and_pay'])],\n        assumptions=[ir.AssumptionBinding(k, 'Synthetic explicit '+k, information_cutoff=stamp,\n            valid_start='2026-01-01',valid_end='2027-01-01')\n            for k in ('alternative','constraint','contract-rate','scenario')],\n        admissions=[ir.SymbolAdmission(symbol,'synthetic-note-7',REASON,'synthetic-author',stamp)],\n        alternatives=[ir.AlternativeBinding(n,'synthetic-author',stamp,'Synthetic endpoint') for n in names],\n        calendar_id='DemoCalendar@1',calendar_name='Gregorian',horizon_start='2026-01-01',\n        horizon_end='2027-01-01',symbol_uncertainty='HistoricalFact',\n        entity_perimeter='Beta-only' if renamed else 'Acme-only')\n\n\ndef typed(principal=100, stress=F(7,100), renamed=False, arithmetic=False):\n    mod, ver, src, ent, book, opening, obs, sym, contract, a1, a0, scenario, report = (\n        ('FinancingStudy','2','disclosure','Beta','Statutory','carried','borrowing','share','facility',\n         'fixed','floating','shock','financials') if renamed else\n        ('BorrowingExample','1','note7','Acme','Local','after2025','debt','alpha','loans',\n         'allFixed','allFloating','rateShock','statements'))\n    ds = [ir.SourceDecl(src,'synthetic-note-7'),ir.EntityDecl(ent,'USD'),ir.BookDecl(book,ent,'DemoDebt','1')]\n    ds += [ir.AccountDecl(n,r,book) for n,r in [('Cash','Asset'),('Debt','Liability'),('InterestExpense','Expense'),('Retained','Equity')]]\n    ds += [ir.OpeningDecl(opening,book,'after-2025-close'),\n           ir.ObservationDecl(obs,'Money<USD>','2025-12-31',ir.Literal(F(principal),unit='USD'),src),\n           ir.SymbolDecl(sym,'Real',ir.Literal(F(0)),ir.Literal(F(1)),REASON)]\n    fraction = ir.Ref(sym)\n    if arithmetic:\n        ds += [ir.LetDecl('mix',ir.Binary('/',ir.Binary('*',ir.Ref(sym),ir.Literal(F(2))),ir.Literal(F(2)))),\n               ir.ConstraintDecl('limit',ir.Binary('and',ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0))),\n                    ir.Binary('<=',ir.Ref(sym),ir.Literal(F(1)))))]\n        fraction=ir.Ref('mix')\n    ds += [ir.ContractDecl(contract,'DebtMix',book,[('principal',ir.Call('value',[ir.Ref(obs)])),\n           ('fixed_fraction',fraction),('fixed_rate',ir.Literal(F(1,20),unit='per year')),\n           ('initial_floating_rate',ir.Literal(F(1,20),unit='per year'))])]\n    for name,value in ((a1,1),(a0,0)):\n        conds=[ir.Binary('==',ir.Ref(sym),ir.Literal(F(value)))]\n        if arithmetic: conds += [ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0)))]\n        ds.append(ir.AlternativeDecl(name,conds))\n    ds += [ir.ScenarioDecl(scenario,[('market_rate',ir.Call('constant',[ir.Literal(F(stress),unit='per year')]))]),\n           ir.ReportDecl(report,book,ir.External('DemoDebt.statements.v1'))]\n    return ir.Program(mod,ver,ds,[ir.UseDecl('DemoDebt','1')])\n\n\ndef arithmetic_source():\n    return BASE.replace('contract loans', 'let mix = alpha * 2 / 2;\\\\nconstraint limit: alpha >= 0 and alpha <= 1;\\\\ncontract loans').replace(\n        'fixed_fraction = alpha;', 'fixed_fraction = mix;').replace('assume alpha == 1;', 'assume alpha == 1; assume alpha >= 0;').replace(\n        'assume alpha == 0;', 'assume alpha == 0; assume alpha >= 0;')\n\n\nSOURCE_NEGATIVES = {\n 'unknown_report_field': (lambda s:s.replace('mapping =', 'extra = 3; mapping ='),'ParseError'),\n 'duplicate_report_field': (lambda s:s.replace('mapping = external(\\\"DemoDebt.statements.v1\\\");','mapping = external(\\\"DemoDebt.statements.v1\\\"); mapping = external(\\\"DemoDebt.statements.v1\\\");'),'ParseError'),\n 'missing_rate_unit': (lambda s:s.replace('fixed_rate = 0.05 per year','fixed_rate = 0.05'),'MissingRateUnit'),\n 'unsupported_event': (lambda s:s+'\\\\nevent maturity at @2026-12-31 {}','UnsupportedDeclaration'),\n 'reserved_identifier': (lambda s:s.replace('entity Acme','entity report'),'ReservedIdentifier'),\n 'invalid_date': (lambda s:s.replace('@2025-12-31','@2025-02-30'),'InvalidDate'),\n 'invalid_escape': (lambda s:s.replace('Fixed-rate',r'Fixed\\\\qrate'),'ParseError'),\n 'invalid_surrogate': (lambda s:s.replace('Fixed-rate',r'Fixed\\\\ud800rate'),'ParseError'),\n 'duplicate_declaration': (lambda s:s+'\\\\nentity Acme functional USD;','DuplicateDeclaration'),\n 'duplicate_contract_field': (lambda s:s.replace('fixed_fraction = alpha;', 'fixed_fraction = alpha; fixed_fraction = alpha;'),'DuplicateField'),\n 'unknown_reference': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = absent'),'UnknownReference'),\n 'cyclic_lets': (lambda s:s.replace('contract loans','let first = second; let second = first; contract loans'),'CyclicBinding'),\n 'unsupported_call': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = sqrt(alpha)'),'UnsupportedExpression'),\n 'unsupported_array': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = [alpha, 1]'),'UnsupportedExpression'),\n 'unsupported_field': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha.part'),'UnsupportedExpression'),\n 'wrong_dimensions': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD + 1'),'TypeMismatch'),\n 'rate_product': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD * 0.05 per year'),'UnsupportedQuantity'),\n 'zero_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha / 0'),'DivisionByZero'),\n 'unproved_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 / alpha'),'UnprovedDivisor'),\n 'bad_arity': (lambda s:s.replace('value(debt)','value(debt, debt)'),'ArityMismatch'),\n 'invalid_fraction_bounds': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha + 1'),'ContractDomain'),\n 'principal_disagreement': (lambda s:s.replace('principal = value(debt)','principal = 200 USD'),'ContractPrincipal'),\n 'malformed_syntax': (lambda s:s.replace('module BorrowingExample','module {'),'ParseError'),\n 'wrong_book': (lambda s:s.replace('account Cash : Asset book Local','account Cash : Asset book Elsewhere'),'BindingMismatch'),\n 'extra_scenario_setting': (lambda s:s.replace('set market_rate', 'set other = 1; set market_rate'),'ScenarioFields'),\n}\n\n\nclass P03Tests(unittest.TestCase):\n    def record(self, case, **values):\n        OBSERVATIONS.append(dict(id=case, passed=True, **values))\n\n    def success(self, source, program, b, case, expected):\n        before=ir.binding_projection(b); original=ir.binding_projection(program)\n        a=compile_source(source,b); t=ir.compile_program(program,b)\n        self.assertTrue(a.ok,[d.as_dict() for d in a.diagnostics]);self.assertTrue(t.ok,[d.as_dict() for d in t.diagnostics])\n        self.assertEqual(a.semantic_projection(),t.semantic_projection())\n        self.assertEqual(a.bindings,t.bindings)\n        self.assertEqual(before,ir.binding_projection(b));self.assertEqual(original,ir.binding_projection(program))\n        self.assertEqual(a.ir,compile_source(source,b).ir)\n        fields={v['name']:v['expression'] for v in a.ir['contracts'][0]['fields']}\n        symbol=a.ir['symbols'][0]['id']; rates=[]\n        for alpha in (1,0):\n            ev=lambda eid:ir.evaluate_expression(a.ir,eid,{symbol:F(alpha)})\n            principal=ev(fields['principal']); weight=ev(fields['fixed_fraction']); fixed=ev(fields['fixed_rate'])\n            stress=ev(a.ir['scenarios'][0]['drivers'][0]['expression'])\n            rates.append(principal*(weight*fixed+(1-weight)*stress))\n        self.assertEqual(rates,list(map(F,expected)))\n        fam=a.ir['historyFamilies'][0]\n        self.assertEqual((fam['feasibility'],fam['coverage'],fam['completed_cells'],fam['unresolved_cells'],fam['witnesses'],fam['solver_results']),\n                         ('Unknown','PartialSearch',0,1,[],[]))\n        self.record(case,source=source,input_sha256=a.input_sha256,typed_sha256=t.input_sha256,\n                    ir=a.ir,bindings=a.bindings,source_map=dict(a.source_map),typed_source_map=dict(t.source_map),\n                    expected_interest=list(map(str,expected)),observed_interest=list(map(str,rates)))\n        return a\n\n    def test_positive_pairs(self):\n        for case,source,program,b,expect in [\n          ('borrowing_baseline',BASE,typed(),bindings(),(5,7)),\n          ('borrowing_stress_09',BASE.replace('0.07 per year','0.09 per year'),typed(stress=F(9,100)),bindings(),(5,9)),\n          ('borrowing_principal_200',BASE.replace('= 100 USD','= 200 USD'),typed(200),bindings(200),(10,14)),\n          ('renamed_independent',RENAMED,typed(150,F(8,100),True),bindings(150,True),(F(15,2),12)),\n          ('borrowing_let_arithmetic',arithmetic_source(),typed(arithmetic=True),bindings(),(5,7))]:\n            with self.subTest(case=case):\n                result=self.success(source,program,b,case,expect)\n                if case=='borrowing_let_arithmetic':\n                    self.assertEqual(len(result.ir['historyFamilies'][0]['constraints']),1)\n                    self.assertEqual([len(a['constraints']) for a in result.ir['alternatives']],[2,2])\n\n    def test_formatting_and_spelling(self):\n        base=compile_source(BASE,bindings())\n        for name,source in [('borrowing_crlf_comment','// comment\\\\r\\\\n'+BASE.replace('\\\\n','\\\\r\\\\n')),\n                            ('decimal_spelling',BASE.replace('100 USD','100.00 USD'))]:\n            result=self.success(source,typed(),bindings(),name,(5,7))\n            self.assertEqual(base.semantic_projection(),result.semantic_projection())\n            self.assertNotEqual(base.input_sha256,result.input_sha256)\n        for decl in ('Acme','Local','loans','statements'):\n            span=base.source_map[decl];self.assertIn(decl,BASE[span['start']:span['end']])\n        self.record('declaration_source_spans')\n\n    def test_source_rejections(self):\n        for name,(change,code) in SOURCE_NEGATIVES.items():\n            with self.subTest(case=name):\n                result=compile_source(change(BASE),bindings())\n                self.assertFalse(result.ok)\n                self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_typed_rejections(self):\n        p=typed(); contract=next(d for d in p.declarations if isinstance(d,ir.ContractDecl))\n        replacements={\n          'typed_missing_rate_unit':('fixed_rate',ir.Literal(F(1,20)),'MissingRateUnit'),\n          'typed_unknown_reference':('fixed_fraction',ir.Ref('absent'),'UnknownReference'),\n          'typed_unsupported_call':('fixed_fraction',ir.Call('sqrt',[ir.Ref('alpha')]),'UnsupportedExpression'),\n          'typed_float':('fixed_rate',ir.Literal(0.05,unit='per year'),'UnsupportedLiteral'),\n          'typed_invalid_bounds':('fixed_fraction',ir.Binary('+',ir.Ref('alpha'),ir.Literal(F(1))),'ContractDomain'),\n        }\n        for name,(field,value,code) in replacements.items():\n            with self.subTest(case=name):\n                bad=replace(contract,fields=[(k,value if k==field else v) for k,v in contract.fields])\n                result=ir.compile_program(replace(p,declarations=[bad if d is contract else d for d in p.declarations]),bindings())\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_binding_rejections(self):\n        b=bindings()\n        cases={\n         'missing_acceptance':(replace(b,readings=[replace(b.readings[0],action=None)]),'BindingAcceptance'),\n         'missing_admission':(replace(b,admissions=[]),'MissingSymbolAdmission'),\n         'missing_assumption':(replace(b,assumptions=[]),'MissingAssumptionMetadata'),\n         'missing_alternative':(replace(b,alternatives=[]),'MissingAlternativeMetadata'),\n         'ambiguous_reading':(replace(b,readings=b.readings*2),'AmbiguousBinding'),\n         'changed_reading':(replace(b,readings=[replace(b.readings[0],amount=200)]),'SourceReadingMismatch'),\n         'package_digest_binding':(replace(b,packages=[replace(b.packages[0],digest='0'*64)]),'PackageDigestMismatch'),\n         'package_horizon':(replace(b,horizon_end='2029-01-01'),'PackageValidity'),\n         'missing_perimeter':(replace(b,entity_perimeter=None),'MissingContext'),\n         'missing_calendar':(replace(b,calendar_id=None),'MissingContext'),\n         'wrong_report_policy_binding':(replace(b,reports=[replace(b.reports[0],cash_flow_policy='invented')]),'ReportMapping'),\n        }\n        for name,(bound,code) in cases.items():\n            with self.subTest(case=name):\n                result=compile_source(BASE,bound)\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_schema_valid_corruptions(self):\n        base=compile_source(BASE,bindings());self.assertTrue(base.ok)\n        schema=json.loads((ROOT/'docs/design/spec/core-ir.schema.json').read_text())\n        for name,(change,code) in IR_NEGATIVES.items():\n            with self.subTest(case=name):\n                bad=copy.deepcopy(base.ir);change(bad)\n                jsonschema.Draft202012Validator(schema).validate(bad)\n                result=ir.validate_ir(bad,bindings())\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,schema_valid=True,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_no_expected_fixture_input(self):\n        original=Path.read_text\n        def guarded(path,*a,**kw):\n            if path.name in {'borrowing.ir.json','borrowing.expected.json','borrowings.json'}:\n                raise AssertionError('Compiler tried reading expected fixture')\n            return original(path,*a,**kw)\n        with patch.object(Path,'read_text',guarded):\n            self.assertTrue(ir.compile_program(typed(),bindings()).ok)\n            self.assertTrue(compile_source(BASE,bindings()).ok)\n        self.record('no_expected_fixture_input')\n\n\ndef expression(doc, suffix):\n    return next(e for e in doc['expressions'] if e['id'].endswith(suffix))\n\nIR_NEGATIVES = {\n 'package_digest':(lambda d:d['packages'][0].update(digest='0'*64),'PackageDigestMismatch'),\n 'wrong_reference_kind':(lambda d:expression(d,'field_principal_arg0').update(target='Local'),'ReferenceKind'),\n 'ir_arity':(lambda d:expression(d,'field_principal').update(args=[]),'ArityMismatch'),\n 'ir_quantity':(lambda d:expression(d,'field_fixed_rate').update(type='Real'),'ContractType'),\n 'ir_context':(lambda d:d['contexts'][0].update(perimeter='Other'),'ContextMismatch'),\n 'ir_context_dimensions':(lambda d:d['contexts'][0].update(dimensions=[{'axis':'segment','member':'other'}]),'ContextMismatch'),\n 'ir_observation_date':(lambda d:d['contexts'][0]['time'].update(start='2025-12-30'),'ReadingContextMismatch'),\n 'ir_acceptance':(lambda d:d['reviewDecisions'][0].update(action='Reject'),'BindingAcceptance'),\n 'ir_cutoff':(lambda d:d['evidenceViews'][0].update(cutoff='2026-01-02T00:00:00Z'),'EvidenceCutoff'),\n 'ir_assumption':(lambda d:d['assumptions'][0].update(rationale='invented'),'AssumptionBinding'),\n 'ir_duplicate_fields':(lambda d:d['contracts'][0]['fields'].append(copy.deepcopy(d['contracts'][0]['fields'][0])),'ContractFields'),\n 'ir_fraction_domain':(lambda d:d['symbols'][0]['domain'].update(upper=ir.rational(2)),'InvalidDomain'),\n 'ir_symbolic_bounds':(lambda d:expression(d,'field_fixed_fraction').update(op='add',target=None,args=['expr:symbol_alpha:upper','expr:symbol_alpha:upper']),'ContractDomain'),\n 'ir_principal':(lambda d:expression(d,'field_principal').update(op='literal',args=[],target=None,context=None,rational=ir.rational(200)),'ContractPrincipal'),\n 'unbalanced_opening':(lambda d:d['states'][0]['balances'][0].update(signed_amount=ir.rational(94)),'UnbalancedState'),\n 'ir_opening_binding':(lambda d:(d['states'][0]['balances'][0].update(signed_amount=ir.rational(94)),d['states'][0]['balances'][3].update(signed_amount=ir.rational(6))),'OpeningStateMismatch'),\n 'ir_report_policy':(lambda d:d['reportMappings'][0].update(cash_flow_policy='DemoDebt@1/invented'),'ReportMapping'),\n 'ir_report_operations':(lambda d:d['reportMappings'][0].update(required_operations=['DemoDebt@1/reset']),'ReportMapping'),\n 'false_family_coverage':(lambda d:d['historyFamilies'][0].update(coverage='ExactWithinScope'),'FalseCoverage'),\n 'ir_false_feasibility':(lambda d:d['historyFamilies'][0].update(feasibility='Feasible'),'MissingWitness'),\n 'ir_lost_branch':(lambda d:d['historyFamilies'][0].update(alternatives=[]),'FamilyMembership'),\n}\n\nif __name__=='__main__': unittest.main()\nPY\npython3 -B -m unittest discover -s tests -p 'test_accounting_p03.py' -v > /tmp/accdsl-p03-first-tests.txt 2>&1\npython3 - <<'PY'\nfrom pathlib import Path\ns=Path('/tmp/accdsl-p03-first-tests.txt').read_text();print(s[-7000:])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"cat > tests/test_accounting_p03.py <<'PY'\n\\\"\\\"\\\"Executed P03 obligations; authored typed inputs never pass through the parser.\\\"\\\"\\\"\nimport copy\nfrom dataclasses import replace\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport unittest\nfrom unittest.mock import patch\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'scripts'))\nimport core0_ir_v1 as ir\nfrom core0_frontends_v1 import compile_source\nimport jsonschema\n\nOBSERVATIONS = []\nBASE = (ROOT / 'docs/design/fixtures/borrowing.acc').read_text()\nREASON = 'Fixed-rate proportion not disclosed'\nRENAMED = '''module FinancingStudy version \\\"2\\\";\nuse DemoDebt version \\\"1\\\";\nsource disclosure = external(\\\"synthetic-note-7\\\");\nentity Beta functional USD;\nbook Statutory entity Beta basis DemoDebt version \\\"1\\\";\naccount Cash : Asset book Statutory;\naccount Debt : Liability book Statutory;\naccount InterestExpense : Expense book Statutory;\naccount Retained : Equity book Statutory;\nopening carried for Statutory from external(\\\"after-2025-close\\\");\nobservation borrowing : Money<USD> instant @2025-12-31 = 150 USD from disclosure;\nsymbol share : Real in [0, 1] because \\\"Fixed-rate proportion not disclosed\\\";\ncontract facility : DebtMix book Statutory {\n principal = value(borrowing); fixed_fraction = share;\n fixed_rate = 0.05 per year; initial_floating_rate = 0.05 per year;\n}\nalternative fixed { assume share == 1; }\nalternative floating { assume share == 0; }\nscenario shock { set market_rate = constant(0.08 per year); }\nreport financials for Statutory { mapping = external(\\\"DemoDebt.statements.v1\\\"); }\n'''\n\n\ndef bindings(principal=100, renamed=False):\n    \\\"\\\"\\\"Explicit synthetic evidence, separately authored from source and expected IR.\\\"\\\"\\\"\n    p = F(principal); stamp = '2026-01-01T00:00:00Z'\n    book, symbol = ('Statutory', 'share') if renamed else ('Local', 'alpha')\n    names = ('fixed', 'floating') if renamed else ('allFixed', 'allFloating')\n    package_path = ROOT / 'docs/design/fixtures/demo-debt-package.json'\n    return ir.CompileBindings(\n        packages=[ir.PackageBinding('DemoDebt', '1', hashlib.sha256(package_path.read_bytes()).hexdigest(),\n            'DemoDebt', '2025-01-01', '2028-01-01', ['reset','accrue_and_pay','close','statements'],\n            ['builtin:Core0@1','DemoCalendar@1'], ['fixture:demo-debt-package.json'])],\n        readings=[ir.ReadingBinding('synthetic-note-7', f'Synthetic disclosed debt {p} USD; split undisclosed', p,\n            'USD', '2025-12-31', 'fixture:p03-synthetic', 'synthetic-2025', stamp, stamp,\n            'synthetic-author', stamp, 'Explicit synthetic acceptance, not human approval', stamp,\n            system_as_of=stamp, action='Accept')],\n        openings=[ir.OpeningBinding('after-2025-close', '2025-12-31',\n            {'Cash':p-5, 'Debt':-p, 'InterestExpense':0, 'Retained':5}, book=book)],\n        reports=[ir.ReportBinding('DemoDebt.statements.v1','DemoDebt.statements.v1',\n            'interest_operating','close',['accrue_and_pay'])],\n        assumptions=[ir.AssumptionBinding(k, 'Synthetic explicit '+k, information_cutoff=stamp,\n            valid_start='2026-01-01',valid_end='2027-01-01')\n            for k in ('alternative','constraint','contract-rate','scenario')],\n        admissions=[ir.SymbolAdmission(symbol,'synthetic-note-7',REASON,'synthetic-author',stamp)],\n        alternatives=[ir.AlternativeBinding(n,'synthetic-author',stamp,'Synthetic endpoint') for n in names],\n        calendar_id='DemoCalendar@1',calendar_name='Gregorian',horizon_start='2026-01-01',\n        horizon_end='2027-01-01',symbol_uncertainty='HistoricalFact',\n        entity_perimeter='Beta-only' if renamed else 'Acme-only')\n\n\ndef typed(principal=100, stress=F(7,100), renamed=False, arithmetic=False):\n    mod, ver, src, ent, book, opening, obs, sym, contract, a1, a0, scenario, report = (\n        ('FinancingStudy','2','disclosure','Beta','Statutory','carried','borrowing','share','facility',\n         'fixed','floating','shock','financials') if renamed else\n        ('BorrowingExample','1','note7','Acme','Local','after2025','debt','alpha','loans',\n         'allFixed','allFloating','rateShock','statements'))\n    ds = [ir.SourceDecl(src,'synthetic-note-7'),ir.EntityDecl(ent,'USD'),ir.BookDecl(book,ent,'DemoDebt','1')]\n    ds += [ir.AccountDecl(n,r,book) for n,r in [('Cash','Asset'),('Debt','Liability'),('InterestExpense','Expense'),('Retained','Equity')]]\n    ds += [ir.OpeningDecl(opening,book,'after-2025-close'),\n           ir.ObservationDecl(obs,'Money<USD>','2025-12-31',ir.Literal(F(principal),unit='USD'),src),\n           ir.SymbolDecl(sym,'Real',ir.Literal(F(0)),ir.Literal(F(1)),REASON)]\n    fraction = ir.Ref(sym)\n    if arithmetic:\n        ds += [ir.LetDecl('mix',ir.Binary('/',ir.Binary('*',ir.Ref(sym),ir.Literal(F(2))),ir.Literal(F(2)))),\n               ir.ConstraintDecl('limit',ir.Binary('and',ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0))),\n                    ir.Binary('<=',ir.Ref(sym),ir.Literal(F(1)))))]\n        fraction=ir.Ref('mix')\n    ds += [ir.ContractDecl(contract,'DebtMix',book,[('principal',ir.Call('value',[ir.Ref(obs)])),\n           ('fixed_fraction',fraction),('fixed_rate',ir.Literal(F(1,20),unit='per year')),\n           ('initial_floating_rate',ir.Literal(F(1,20),unit='per year'))])]\n    for name,value in ((a1,1),(a0,0)):\n        conds=[ir.Binary('==',ir.Ref(sym),ir.Literal(F(value)))]\n        if arithmetic: conds += [ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0)))]\n        ds.append(ir.AlternativeDecl(name,conds))\n    ds += [ir.ScenarioDecl(scenario,[('market_rate',ir.Call('constant',[ir.Literal(F(stress),unit='per year')]))]),\n           ir.ReportDecl(report,book,ir.External('DemoDebt.statements.v1'))]\n    return ir.Program(mod,ver,ds,[ir.UseDecl('DemoDebt','1')])\n\n\ndef arithmetic_source():\n    return BASE.replace('contract loans', 'let mix = alpha * 2 / 2;\\\\nconstraint limit: alpha >= 0 and alpha <= 1;\\\\ncontract loans').replace(\n        'fixed_fraction = alpha;', 'fixed_fraction = mix;').replace('assume alpha == 1;', 'assume alpha == 1; assume alpha >= 0;').replace(\n        'assume alpha == 0;', 'assume alpha == 0; assume alpha >= 0;')\n\n\nSOURCE_NEGATIVES = {\n 'unknown_report_field': (lambda s:s.replace('mapping =', 'extra = 3; mapping ='),'ParseError'),\n 'duplicate_report_field': (lambda s:s.replace('mapping = external(\\\"DemoDebt.statements.v1\\\");','mapping = external(\\\"DemoDebt.statements.v1\\\"); mapping = external(\\\"DemoDebt.statements.v1\\\");'),'ParseError'),\n 'missing_rate_unit': (lambda s:s.replace('fixed_rate = 0.05 per year','fixed_rate = 0.05'),'MissingRateUnit'),\n 'unsupported_event': (lambda s:s+'\\\\nevent maturity at @2026-12-31 {}','UnsupportedDeclaration'),\n 'reserved_identifier': (lambda s:s.replace('entity Acme','entity report'),'ReservedIdentifier'),\n 'invalid_date': (lambda s:s.replace('@2025-12-31','@2025-02-30'),'InvalidDate'),\n 'invalid_escape': (lambda s:s.replace('Fixed-rate',r'Fixed\\\\qrate'),'ParseError'),\n 'invalid_surrogate': (lambda s:s.replace('Fixed-rate',r'Fixed\\\\ud800rate'),'ParseError'),\n 'duplicate_declaration': (lambda s:s+'\\\\nentity Acme functional USD;','DuplicateDeclaration'),\n 'duplicate_contract_field': (lambda s:s.replace('fixed_fraction = alpha;', 'fixed_fraction = alpha; fixed_fraction = alpha;'),'DuplicateField'),\n 'unknown_reference': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = absent'),'UnknownReference'),\n 'cyclic_lets': (lambda s:s.replace('contract loans','let first = second; let second = first; contract loans'),'CyclicBinding'),\n 'unsupported_call': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = sqrt(alpha)'),'UnsupportedExpression'),\n 'unsupported_array': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = [alpha, 1]'),'UnsupportedExpression'),\n 'unsupported_field': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha.part'),'UnsupportedExpression'),\n 'wrong_dimensions': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD + 1'),'TypeMismatch'),\n 'rate_product': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD * 0.05 per year'),'UnsupportedQuantity'),\n 'zero_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha / 0'),'DivisionByZero'),\n 'unproved_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 / alpha'),'UnprovedDivisor'),\n 'bad_arity': (lambda s:s.replace('value(debt)','value(debt, debt)'),'ArityMismatch'),\n 'invalid_fraction_bounds': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha + 1'),'ContractDomain'),\n 'principal_disagreement': (lambda s:s.replace('principal = value(debt)','principal = 200 USD'),'ContractPrincipal'),\n 'malformed_syntax': (lambda s:s.replace('module BorrowingExample','module {'),'ParseError'),\n 'wrong_book': (lambda s:s.replace('account Cash : Asset book Local','account Cash : Asset book Elsewhere'),'BindingMismatch'),\n 'extra_scenario_setting': (lambda s:s.replace('set market_rate', 'set other = 1; set market_rate'),'ScenarioFields'),\n}\n\n\nclass P03Tests(unittest.TestCase):\n    def record(self, case, **values):\n        OBSERVATIONS.append(dict(id=case, passed=True, **values))\n\n    def success(self, source, program, b, case, expected):\n        before=ir.binding_projection(b); original=ir.binding_projection(program)\n        a=compile_source(source,b); t=ir.compile_program(program,b)\n        self.assertTrue(a.ok,[d.as_dict() for d in a.diagnostics]);self.assertTrue(t.ok,[d.as_dict() for d in t.diagnostics])\n        self.assertEqual(a.semantic_projection(),t.semantic_projection())\n        self.assertEqual(a.bindings,t.bindings)\n        self.assertEqual(before,ir.binding_projection(b));self.assertEqual(original,ir.binding_projection(program))\n        self.assertEqual(a.ir,compile_source(source,b).ir)\n        fields={v['name']:v['expression'] for v in a.ir['contracts'][0]['fields']}\n        symbol=a.ir['symbols'][0]['id']; rates=[]\n        for alpha in (1,0):\n            ev=lambda eid:ir.evaluate_expression(a.ir,eid,{symbol:F(alpha)})\n            principal=ev(fields['principal']); weight=ev(fields['fixed_fraction']); fixed=ev(fields['fixed_rate'])\n            stress=ev(a.ir['scenarios'][0]['drivers'][0]['expression'])\n            rates.append(principal*(weight*fixed+(1-weight)*stress))\n        self.assertEqual(rates,list(map(F,expected)))\n        fam=a.ir['historyFamilies'][0]\n        self.assertEqual((fam['feasibility'],fam['coverage'],fam['completed_cells'],fam['unresolved_cells'],fam['witnesses'],fam['solver_results']),\n                         ('Unknown','PartialSearch',0,1,[],[]))\n        self.record(case,source=source,input_sha256=a.input_sha256,typed_sha256=t.input_sha256,\n                    ir=a.ir,bindings=a.bindings,source_map=dict(a.source_map),typed_source_map=dict(t.source_map),\n                    expected_interest=list(map(str,expected)),observed_interest=list(map(str,rates)))\n        return a\n\n    def test_positive_pairs(self):\n        for case,source,program,b,expect in [\n          ('borrowing_baseline',BASE,typed(),bindings(),(5,7)),\n          ('borrowing_stress_09',BASE.replace('0.07 per year','0.09 per year'),typed(stress=F(9,100)),bindings(),(5,9)),\n          ('borrowing_principal_200',BASE.replace('= 100 USD','= 200 USD'),typed(200),bindings(200),(10,14)),\n          ('renamed_independent',RENAMED,typed(150,F(8,100),True),bindings(150,True),(F(15,2),12)),\n          ('borrowing_let_arithmetic',arithmetic_source(),typed(arithmetic=True),bindings(),(5,7))]:\n            with self.subTest(case=case):\n                result=self.success(source,program,b,case,expect)\n                if case=='borrowing_let_arithmetic':\n                    self.assertEqual(len(result.ir['historyFamilies'][0]['constraints']),1)\n                    self.assertEqual([len(a['constraints']) for a in result.ir['alternatives']],[2,2])\n\n    def test_formatting_and_spelling(self):\n        base=compile_source(BASE,bindings())\n        for name,source in [('borrowing_crlf_comment','// comment\\\\r\\\\n'+BASE.replace('\\\\n','\\\\r\\\\n')),\n                            ('decimal_spelling',BASE.replace('100 USD','100.00 USD'))]:\n            result=self.success(source,typed(),bindings(),name,(5,7))\n            self.assertEqual(base.semantic_projection(),result.semantic_projection())\n            self.assertNotEqual(base.input_sha256,result.input_sha256)\n        for decl in ('Acme','Local','loans','statements'):\n            span=base.source_map[decl];self.assertIn(decl,BASE[span['start']:span['end']])\n        self.record('declaration_source_spans')\n\n    def test_source_rejections(self):\n        for name,(change,code) in SOURCE_NEGATIVES.items():\n            with self.subTest(case=name):\n                result=compile_source(change(BASE),bindings())\n                self.assertFalse(result.ok)\n                self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_typed_rejections(self):\n        p=typed(); contract=next(d for d in p.declarations if isinstance(d,ir.ContractDecl))\n        replacements={\n          'typed_missing_rate_unit':('fixed_rate',ir.Literal(F(1,20)),'MissingRateUnit'),\n          'typed_unknown_reference':('fixed_fraction',ir.Ref('absent'),'UnknownReference'),\n          'typed_unsupported_call':('fixed_fraction',ir.Call('sqrt',[ir.Ref('alpha')]),'UnsupportedExpression'),\n          'typed_float':('fixed_rate',ir.Literal(0.05,unit='per year'),'UnsupportedLiteral'),\n          'typed_invalid_bounds':('fixed_fraction',ir.Binary('+',ir.Ref('alpha'),ir.Literal(F(1))),'ContractDomain'),\n        }\n        for name,(field,value,code) in replacements.items():\n            with self.subTest(case=name):\n                bad=replace(contract,fields=[(k,value if k==field else v) for k,v in contract.fields])\n                result=ir.compile_program(replace(p,declarations=[bad if d is contract else d for d in p.declarations]),bindings())\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_binding_rejections(self):\n        b=bindings()\n        cases={\n         'missing_acceptance':(replace(b,readings=[replace(b.readings[0],action=None)]),'BindingAcceptance'),\n         'missing_admission':(replace(b,admissions=[]),'MissingSymbolAdmission'),\n         'missing_assumption':(replace(b,assumptions=[]),'MissingAssumptionMetadata'),\n         'missing_alternative':(replace(b,alternatives=[]),'MissingAlternativeMetadata'),\n         'ambiguous_reading':(replace(b,readings=b.readings*2),'AmbiguousBinding'),\n         'changed_reading':(replace(b,readings=[replace(b.readings[0],amount=200)]),'SourceReadingMismatch'),\n         'package_digest_binding':(replace(b,packages=[replace(b.packages[0],digest='0'*64)]),'PackageDigestMismatch'),\n         'package_horizon':(replace(b,horizon_end='2029-01-01'),'PackageValidity'),\n         'missing_perimeter':(replace(b,entity_perimeter=None),'MissingContext'),\n         'missing_calendar':(replace(b,calendar_id=None),'MissingContext'),\n         'wrong_report_policy_binding':(replace(b,reports=[replace(b.reports[0],cash_flow_policy='invented')]),'ReportMapping'),\n        }\n        for name,(bound,code) in cases.items():\n            with self.subTest(case=name):\n                result=compile_source(BASE,bound)\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_schema_valid_corruptions(self):\n        base=compile_source(BASE,bindings());self.assertTrue(base.ok)\n        schema=json.loads((ROOT/'docs/design/spec/core-ir.schema.json').read_text())\n        for name,(change,code) in IR_NEGATIVES.items():\n            with self.subTest(case=name):\n                bad=copy.deepcopy(base.ir);change(bad)\n                jsonschema.Draft202012Validator(schema).validate(bad)\n                result=ir.validate_ir(bad,bindings())\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,schema_valid=True,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_no_expected_fixture_input(self):\n        original=Path.read_text\n        def guarded(path,*a,**kw):\n            if path.name in {'borrowing.ir.json','borrowing.expected.json','borrowings.json'}:\n                raise AssertionError('Compiler tried reading expected fixture')\n            return original(path,*a,**kw)\n        with patch.object(Path,'read_text',guarded):\n            self.assertTrue(ir.compile_program(typed(),bindings()).ok)\n            self.assertTrue(compile_source(BASE,bindings()).ok)\n        self.record('no_expected_fixture_input')\n\n\ndef expression(doc, suffix):\n    return next(e for e in doc['expressions'] if e['id'].endswith(suffix))\n\nIR_NEGATIVES = {\n 'package_digest':(lambda d:d['packages'][0].update(digest='0'*64),'PackageDigestMismatch'),\n 'wrong_reference_kind':(lambda d:expression(d,'field_principal_arg0').update(target='Local'),'ReferenceKind'),\n 'ir_arity':(lambda d:expression(d,'field_principal').update(args=[]),'ArityMismatch'),\n 'ir_quantity':(lambda d:expression(d,'field_fixed_rate').update(type='Real'),'ContractType'),\n 'ir_context':(lambda d:d['contexts'][0].