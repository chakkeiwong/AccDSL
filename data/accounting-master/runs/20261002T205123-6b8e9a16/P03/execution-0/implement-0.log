{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1753,1885p' scripts/core0_ir_v1.py\"","aggregated_output":"def validate_ir(ir: Mapping[str, Any], bindings: CompileBindings,\n                *, schema: Optional[Mapping[str, Any]] = None) -> ValidationResult:\n    \"\"\"Validate closed-schema shape and independent Core0.1 semantics.\"\"\"\n    if not isinstance(ir, Mapping):\n        return ValidationResult(False, (_invalid(\"StructuralError\", \"IR must be a mapping\", \"ir\"),))\n    try:\n        _validate_bindings(bindings)\n    except _Failure as exc:\n        return ValidationResult(False, (exc.diagnostic,))\n    schema = schema or _load_schema()\n    if jsonschema is None:\n        return ValidationResult(False, (_invalid(\"MissingDependency\", \"jsonschema is required for closed-schema validation\", \"validator\"),))\n    try:\n        jsonschema.Draft202012Validator(schema).validate(ir)\n    except jsonschema.ValidationError as exc:\n        return ValidationResult(False, (_invalid(\"StructuralError\", exc.message, \"/\".join(map(str, exc.path))),))\n    nodes, duplicate = _nodes(ir)\n    if duplicate:\n        return ValidationResult(False, (duplicate,))\n    try:\n        packages = {p.id: p for p in bindings.packages}\n        package_rows = {r[\"id\"]: r for r in ir[\"packages\"]}\n        if set(package_rows) != set(packages):\n            raise _Failure(Diagnostic(\"PackageBinding\", \"IR package lock differs from supplied package bindings\", \"packages\"))\n        for pid, package in packages.items():\n            row = package_rows[pid]\n            if (row[\"version\"] != package.version or row[\"digest\"] != package.digest or\n                    row[\"basis\"] != package.basis or row[\"dependencies\"] != list(package.dependencies) or\n                    row[\"authority\"] != list(package.authority) or row[\"review_status\"] != package.review_status or\n                    row[\"implementation\"] != package.implementation):\n                raise _Failure(Diagnostic(\"PackageDigestMismatch\", \"package digest/basis differs from binding\", pid))\n            if row[\"operations\"] != [f\"{pid}/{x}\" for x in package.operations]:\n                raise _Failure(Diagnostic(\"PackageBinding\", \"package operation lock differs from binding\", pid))\n            effective = row[\"effective\"]\n            if effective[\"calendar\"] != bindings.calendar_id or effective[\"start\"] != package.effective_start or effective[\"end_exclusive\"] != package.effective_end:\n                raise _Failure(Diagnostic(\"PackageValidity\", \"package applicability differs from binding\", pid))\n            if date.fromisoformat(effective[\"start\"]) >= date.fromisoformat(bindings.horizon_end) or date.fromisoformat(effective[\"end_exclusive\"]) <= date.fromisoformat(bindings.horizon_start):\n                raise _Failure(Diagnostic(\"PackageValidity\", \"package does not cover the requested horizon\", pid))\n        entities = {r[\"id\"]: r for r in ir[\"entities\"]}\n        books = {r[\"id\"]: r for r in ir[\"books\"]}\n        if len(entities) != 1 or len(books) != 1:\n            raise _Failure(Diagnostic(\"ProfileCardinality\", \"one entity and book are required\", \"profile\"))\n        for row in ir[\"contexts\"]:\n            if (err := _ref(nodes, row[\"entity\"], {\"entities\"}, row[\"id\"])):\n                raise _Failure(err)\n            if row[\"basis\"] != next(iter(packages)) or row[\"currency\"] != row[\"unit\"] or row[\"currency\"] != entities[row[\"entity\"]][\"functional_currency\"]:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"context basis, unit and currency disagree\", row[\"id\"]))\n            _time(\"instant\" if row[\"time\"][\"kind\"] == \"instant\" else \"interval\", row[\"time\"][\"start\"], row[\"time\"][\"end_exclusive\"], row[\"time\"][\"calendar\"])\n            if row[\"time\"][\"calendar\"] != bindings.calendar_id or row[\"perimeter\"] != bindings.entity_perimeter:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"context calendar or perimeter differs from bindings\", row[\"id\"]))\n        for row in ir[\"sourceSpans\"]:\n            if (err := _ref(nodes, row[\"document\"], {\"documents\"}, row[\"id\"])):\n                raise _Failure(err)\n        for row in ir[\"documents\"]:\n            _instant(row[\"available\"], row[\"id\"]); _instant(row[\"ingested\"], row[\"id\"])\n        reviews = {r[\"id\"]: r for r in ir[\"reviewDecisions\"]}\n        views = {r[\"id\"]: r for r in ir[\"evidenceViews\"]}\n        spans = {r[\"id\"]: r for r in ir[\"sourceSpans\"]}\n        documents = {r[\"id\"]: r for r in ir[\"documents\"]}\n        observations = {r[\"id\"]: r for r in ir[\"observations\"]}\n        for row in ir[\"reviewDecisions\"]:\n            if row[\"action\"] not in {\"Accept\", \"AcceptAlternative\", \"Propose\", \"Reject\", \"Supersede\"}:\n                raise _Failure(Diagnostic(\"ReviewAction\", \"unsupported review action\", row[\"id\"]))\n            if not row[\"reviewer\"] or not row[\"reason\"] or not row[\"evidence\"]:\n                raise _Failure(Diagnostic(\"IncompleteReview\", \"review decisions require reviewer, reason and evidence\", row[\"id\"]))\n            for sid in row[\"evidence\"]:\n                if sid not in spans:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"review evidence span is unknown\", row[\"id\"]))\n            for rid in row[\"reading_ids\"]:\n                if not rid.startswith(\"reading:\"):\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"review reading id is malformed\", row[\"id\"]))\n        for row in ir[\"evidenceViews\"]:\n            _instant(row[\"cutoff\"], row[\"id\"])\n            if row[\"system_as_of\"] is not None:\n                _instant(row[\"system_as_of\"], row[\"id\"])\n            for did in row[\"documents\"]:\n                if did not in documents:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence document is unknown\", row[\"id\"]))\n            for sid in row[\"decisions\"]:\n                if sid not in reviews:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence decision is unknown\", row[\"id\"]))\n            for oid in row[\"observations\"]:\n                if oid not in observations:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence observation is unknown\", row[\"id\"]))\n        for row in ir[\"observations\"]:\n            if (err := _ref(nodes, row[\"context\"], {\"contexts\"}, row[\"id\"])):\n                raise _Failure(err)\n            for rid in row[\"source_spans\"]:\n                if (err := _ref(nodes, rid, {\"sourceSpans\"}, row[\"id\"])):\n                    raise _Failure(err)\n            reading_key = next((r.key for r in bindings.readings if f\"reading:{_clean_id(r.key)}\" == row[\"reading\"]), None)\n            if reading_key is None:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"observation reading is not bound\", row[\"id\"]))\n            reading = bindings.reading(reading_key)\n            if row[\"domain\"][\"lower\"] != rational(reading.amount) or row[\"domain\"][\"upper\"] != rational(reading.amount):\n                raise _Failure(Diagnostic(\"SourceReadingMismatch\", \"observation domain differs from bound reading\", row[\"id\"]))\n            document_id = f\"document:{_clean_id(reading.key)}\"\n            span = next((s for s in ir[\"sourceSpans\"] if s[\"id\"] in row[\"source_spans\"]), None)\n            if span is None or span[\"literal\"] != reading.literal:\n                raise _Failure(Diagnostic(\"SourceLiteralMismatch\", \"source span literal differs from binding\", row[\"id\"]))\n            doc = next((d for d in ir[\"documents\"] if d[\"id\"] == document_id), None)\n            if doc is None or doc[\"sha256\"] != hashlib.sha256(reading.literal.encode()).hexdigest():\n                raise _Failure(Diagnostic(\"SourceDigestMismatch\", \"document digest differs from binding\", row[\"id\"]))\n            review = reviews.get(row[\"review_decision\"])\n            if review is None or review[\"action\"] != \"Accept\" or review[\"reviewer\"] != reading.reviewer or review[\"date\"] != reading.review_date:\n                raise _Failure(Diagnostic(\"BindingAcceptance\", \"observation lacks the bound accepted review decision\", row[\"id\"]))\n            view = next((v for v in views.values() if row[\"id\"] in v[\"observations\"]), None)\n            if view is None or reading.cutoff != view[\"cutoff\"] or (reading.system_as_of is not None and view[\"system_as_of\"] != reading.system_as_of):\n                raise _Failure(Diagnostic(\"EvidenceCutoff\", \"observation is not in the bound evidence view\", row[\"id\"]))\n        for row in ir[\"books\"]:\n            if row[\"package\"] not in package_rows:\n                raise _Failure(Diagnostic(\"PackageBinding\", \"book package is not locked\", row[\"id\"]))\n            if row[\"currency\"] != entities[row[\"entity\"]][\"functional_currency\"]:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"book currency differs from entity\", row[\"id\"]))\n        for row in ir[\"accounts\"]:\n            if (err := _ref(nodes, row[\"book\"], {\"books\"}, row[\"id\"])):\n                raise _Failure(err)\n            if row[\"id\"] not in _ACCOUNT_ROLES or row[\"role\"] != _ACCOUNT_ROLES[row[\"id\"]]:\n                raise _Failure(Diagnostic(\"PackageAccounts\", \"account role is outside the locked DemoDebt mapping\", row[\"id\"]))\n        if {r[\"id\"]: r[\"role\"] for r in ir[\"accounts\"]} != _ACCOUNT_ROLES:\n            raise _Failure(Diagnostic(\"PackageAccounts\", \"all four DemoDebt account roles are required\", \"accounts\"))\n        model_ids = {r[\"id\"] for r in ir[\"models\"]}\n        scope_ids = {r[\"id\"] for r in ir[\"modelScopes\"]}\n        if len(model_ids) != 1 or len(scope_ids) != 1:\n            raise _Failure(Diagnostic(\"ProfileCardinality\", \"one model and one model scope are required\", \"models\"))\n        admissions = {a.name: a for a in bindings.admissions}\n        for row in ir[\"symbols\"]:\n            if row[\"uncertainty_kind\"] != bindings.symbol_uncertainty or row[\"scope\"] not in model_ids:\n                raise _Failure(Diagnostic(\"SymbolAdmission\", \"symbol uncertainty or scope differs from bindings\", row[\"id\"]))\n            admission = admissions.get(row[\"id\"])\n            if admission is None or row[\"admission\"] != f\"admission:{row['id']}\" or not row[\"provenance\"]:\n                raise _Failure(Diagnostic(\"SymbolAdmission\", \"symbol admission/provenance is incomplete\", row[\"id\"]))\n            domain = row[\"domain\"]\n","exit_code":0,"status":"completed"}}
