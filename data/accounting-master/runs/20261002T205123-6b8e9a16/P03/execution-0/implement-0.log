{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '815,960p' scripts/core0_ir_v1.py\"","aggregated_output":"        \"contracts\", \"postings\", \"states\", \"events\", \"rules\", \"packages\", \"measurements\",\n        \"journals\", \"scenarios\", \"informationViews\", \"reviewDecisions\", \"evidenceViews\",\n        \"modelScopes\", \"historyFamilies\", \"probabilityModels\", \"reportMappings\", \"resultCells\",\n        \"branchResults\", \"runs\", \"diagnostics\",\n    ]\n    out = {k: [] for k in keys}\n    out[\"schema_version\"] = \"0.1\"\n    return out\n\n\ndef _diag(code: str, message: str, location: str, capability: Optional[str] = None,\n          span: Optional[tuple[int, int]] = None) -> _Failure:\n    return _Failure(Diagnostic(code, message, location, capability=capability, span=span))\n\n\nclass _Compiler:\n    def __init__(self, program: Program, bindings: CompileBindings,\n                 source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,\n                 input_text: Optional[str] = None):\n        self.program = program\n        self.bindings = bindings\n        self.source_spans = source_spans or {}\n        self.input_text = input_text\n        self.ir = _empty_ir()\n        self.source_map: dict[str, dict[str, Any]] = {}\n        self.expr_rows: dict[str, dict[str, Any]] = {}\n        self.expr_info: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.decls: dict[str, Any] = {}\n        self.lets: dict[str, LetDecl] = {}\n        self.let_ids: dict[str, str] = {}\n        self.lowering_lets: set[str] = set()\n        self.observations: dict[str, ObservationDecl] = {}\n        self.symbols: dict[str, SymbolDecl] = {}\n        self.sources: dict[str, SourceDecl] = {}\n        self.entities: dict[str, EntityDecl] = {}\n        self.books: dict[str, BookDecl] = {}\n        self.accounts: dict[str, AccountDecl] = {}\n        self.openings: dict[str, OpeningDecl] = {}\n        self.contracts: dict[str, ContractDecl] = {}\n        self.alternatives: dict[str, AlternativeDecl] = {}\n        self.scenarios: dict[str, ScenarioDecl] = {}\n        self.reports: dict[str, ReportDecl] = {}\n        self.constraints: dict[str, ConstraintDecl] = {}\n        self.package: Optional[PackageBinding] = None\n        self.entity: Optional[EntityDecl] = None\n        self.book: Optional[BookDecl] = None\n        self.scope_id = f\"scope:{_clean_id(program.module)}@{_clean_id(program.version)}\"\n        self.model_id = f\"{program.module}@{program.version}\"\n\n    def fail(self, code: str, message: str, location: str, capability: Optional[str] = None,\n             node: Any = None) -> None:\n        span = None\n        if node is not None and id(node) in self.source_spans:\n            item = self.source_spans[id(node)]\n            span = (item.get(\"start\", 0), item.get(\"end\", 0))\n        raise _diag(code, message, location, capability, span)\n\n    def collect(self) -> None:\n        _validate_bindings(self.bindings)\n        if not self.program.module or not self.program.version:\n            self.fail(\"InvalidModule\", \"module name and version are required\", \"module\")\n        reserved = {\n            \"module\", \"version\", \"use\", \"source\", \"entity\", \"functional\", \"book\", \"basis\",\n            \"account\", \"opening\", \"observation\", \"instant\", \"period\", \"symbol\", \"in\", \"because\",\n            \"choice\", \"binding\", \"let\", \"constraint\", \"alternative\", \"assume\", \"contract\", \"event\",\n            \"rule\", \"for\", \"as\", \"when\", \"require\", \"post\", \"scenario\", \"set\", \"report\", \"from\",\n            \"to\", \"true\", \"false\", \"and\", \"or\", \"not\", \"debit\", \"credit\", \"overrides\", \"per\", \"year\",\n        }\n        self._check_name(self.program.module, \"module\", reserved)\n        declared_uses = tuple(d for d in self.program.declarations if isinstance(d, UseDecl))\n        all_uses = tuple(self.program.uses) + declared_uses\n        seen_use_ids: set[str] = set()\n        for use in all_uses:\n            self._check_name(use.name, \"use\", reserved)\n            if (use.name, use.version) in seen_use_ids:\n                self.fail(\"DuplicateDeclaration\", f\"duplicate package use {use.name!r}\", use.name)\n            seen_use_ids.add((use.name, use.version))\n            try:\n                package = self.bindings.package(use.name, use.version)\n            except _Failure:\n                raise\n            if self.package is not None and self.package.id != package.id:\n                self.fail(\"PackageCollision\", \"multiple package bases are outside Core0.1\", use.name)\n            self.package = package\n        for decl in self.program.declarations:\n            if isinstance(decl, UseDecl):\n                # A use is allowed either in Program.uses or declarations, but\n                # it must not be silently duplicated.\n                continue\n            if isinstance(decl, UnsupportedDecl):\n                self.fail(\"UnsupportedDeclaration\", f\"{decl.kind} is outside Core0.1\", decl.name or decl.kind,\n                          capability=decl.kind)\n            name = getattr(decl, \"name\", None)\n            if name:\n                self._check_name(name, type(decl).__name__, reserved)\n                if name in self.decls:\n                    self.fail(\"DuplicateDeclaration\", f\"duplicate declaration {name!r}\", name)\n                self.decls[name] = decl\n                self._record_source(name, decl, name, \"declaration\")\n            if isinstance(decl, (ContractDecl, ScenarioDecl)):\n                pairs = decl.fields if isinstance(decl, ContractDecl) else decl.settings\n                if len({k for k, _ in pairs}) != len(pairs):\n                    self.fail(\"DuplicateField\", \"fields must occur once\", name)\n            if isinstance(decl, SourceDecl):\n                self.sources[decl.name] = decl\n            elif isinstance(decl, EntityDecl):\n                self.entities[decl.name] = decl\n            elif isinstance(decl, BookDecl):\n                self.books[decl.name] = decl\n            elif isinstance(decl, AccountDecl):\n                self.accounts[decl.name] = decl\n            elif isinstance(decl, OpeningDecl):\n                self.openings[decl.name] = decl\n            elif isinstance(decl, ObservationDecl):\n                self.observations[decl.name] = decl\n            elif isinstance(decl, SymbolDecl):\n                self.symbols[decl.name] = decl\n            elif isinstance(decl, LetDecl):\n                self.lets[decl.name] = decl\n            elif isinstance(decl, ConstraintDecl):\n                self.constraints[decl.name] = decl\n            elif isinstance(decl, ContractDecl):\n                self.contracts[decl.name] = decl\n            elif isinstance(decl, AlternativeDecl):\n                self.alternatives[decl.name] = decl\n            elif isinstance(decl, ScenarioDecl):\n                self.scenarios[decl.name] = decl\n            elif isinstance(decl, ReportDecl):\n                self.reports[decl.name] = decl\n            else:\n                self.fail(\"UnsupportedDeclaration\", f\"{type(decl).__name__} is outside Core0.1\", str(decl))\n        # A typed program may pass uses separately; source frontend does this.\n        if self.package is None and all_uses:\n            self.fail(\"MissingPackageBinding\", \"a Core0.1 program requires one package use\", \"use\")\n        if self.package is None:\n            self.fail(\"MissingPackageBinding\", \"a Core0.1 program requires one package use\", \"use\")\n        if len(self.entities) != 1 or len(self.books) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires exactly one entity and one book\", \"profile\")\n        if any(len(x) != 1 for x in (self.sources, self.observations, self.symbols, self.contracts)):\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires one source, observation, symbol and contract\", \"profile\")\n        if len(self.openings) != 1 or len(self.reports) != 1 or len(self.scenarios) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires one opening, scenario and report\", \"profile\")\n        if len(self.alternatives) < 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires at least one named alternative\", \"profile\")\n        self.entity = next(iter(self.entities.values()))\n        self.book = next(iter(self.books.values()))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1010,1140p' scripts/core0_ir_v1.py\"","aggregated_output":"        if name in self.observations:\n            obs = self.observations[name]\n            ctx = f\"context:{_clean_id(obs.name)}\"\n            key = self.sources[obs.source].external\n            return f\"Observation<{obs.type_name}>\", ctx, self.bindings.reading(key).amount\n        if name in self.symbols:\n            return self.symbols[name].type_name, None, None\n        self.fail(\"UnknownReference\", f\"reference {name!r} is not declared\", name)\n\n    def _constant(self, expr_id: str) -> Optional[Fraction]:\n        if expr_id not in self.expr_info:\n            return None\n        value = self.expr_info[expr_id][2]\n        return value if isinstance(value, Fraction) else None\n\n    def lower_expr(self, expr: Expr, owner: str, path: str,\n                   expected: Optional[str] = None) -> tuple[str, str, Optional[str], Any]:\n        expr_id = self._expr_id(owner, path)\n        if isinstance(expr, Literal):\n            value = expr.value\n            typ = expr.type_name\n            unit = expr.unit\n            display = expr.display\n            if isinstance(value, bool):\n                typ = typ or \"Bool\"\n                if typ != \"Bool\" or unit is not None:\n                    self.fail(\"TypeMismatch\", \"Boolean literal cannot carry numeric type/unit\", owner)\n                text = \"true\" if value else \"false\"\n                row = dict(id=expr_id, op=\"literal\", type=typ, context=None, args=[], rational=None,\n                           text=text, target=None, field_names=[])\n                return self._add_expr(expr_id, row, typ, None, value, expr, owner, path)\n            if isinstance(value, Fraction) or isinstance(value, (int, Decimal)):\n                q = _fraction(value)\n                if unit == \"per year\":\n                    if typ and typ != \"Rate<annual_simple>\":\n                        self.fail(\"TypeMismatch\", \"annual unit disagrees with literal type\", owner)\n                    typ = \"Rate<annual_simple>\"\n                elif unit:\n                    if not re.fullmatch(r\"[A-Z]{3}\", unit):\n                        self.fail(\"UnsupportedUnit\", f\"unit {unit!r} is outside Core0.1\", owner)\n                    if typ and typ != f\"Money<{unit}>\":\n                        self.fail(\"TypeMismatch\", \"currency suffix disagrees with literal type\", owner)\n                    typ = f\"Money<{unit}>\"\n                else:\n                    if expected and expected.startswith(\"Rate<\") and typ != expected:\n                        self.fail(\"MissingRateUnit\", \"annual rates require the explicit `per year` unit\", owner, \"rate\", expr)\n                    typ = typ or \"Real\"\n                if typ == \"Int\" and q.denominator != 1:\n                    self.fail(\"TypeMismatch\", \"fractional literal cannot have Int type\", owner, node=expr)\n                context = None\n                row = dict(id=expr_id, op=\"literal\", type=typ, context=context, args=[], rational=rational(q),\n                           text=None, target=None, field_names=[])\n                return self._add_expr(expr_id, row, typ, context, q, expr, owner, path)\n            if isinstance(value, str):\n                typ = typ or \"String\"\n                value = _string(value)\n                if typ == \"Date\":\n                    value = _iso(value.lstrip(\"@\"), owner)\n                row = dict(id=expr_id, op=\"literal\", type=typ, context=None, args=[], rational=None,\n                           text=value, target=None, field_names=[])\n                return self._add_expr(expr_id, row, typ, None, value, expr, owner, path)\n            self.fail(\"UnsupportedLiteral\", f\"literal {type(value).__name__} is outside Core0.1\", owner, node=expr)\n        if isinstance(expr, External):\n            # External source references are admitted only by declaration-level\n            # handlers.  Keeping this operation explicit prevents accidental\n            # fixture or filesystem lookup from an arbitrary expression.\n            self.fail(\"UnsupportedExternalExpression\", \"external references are only valid in source/opening/report declarations\", owner, \"external\", expr)\n        if isinstance(expr, Ref):\n            if expr.name in self.lets and expr.name not in self.let_ids:\n                self._lower_let(expr.name)\n            typ, context, value = self._lookup_type(expr.name)\n            if expr.name in self.lets:\n                target = self.let_ids[expr.name]\n            else:\n                target = expr.name\n            row = dict(id=expr_id, op=\"ref\", type=typ, context=context, args=[], rational=None,\n                       text=None, target=target, field_names=[])\n            return self._add_expr(expr_id, row, typ, context, value, expr, owner, path)\n        if isinstance(expr, Call):\n            if expr.name not in {\"value\", \"constant\"}:\n                self.fail(\"UnsupportedExpression\", f\"call {expr.name!r} is not admitted\", owner, f\"call:{expr.name}\", expr)\n            if len(expr.args) != 1:\n                self.fail(\"ArityMismatch\", f\"{expr.name} requires one argument\", owner, node=expr)\n            args = [self.lower_expr(a, owner, f\"{path}.arg{i}\") for i, a in enumerate(expr.args)]\n            if expr.name == \"value\":\n                if len(args) != 1 or not args[0][1].startswith(\"Observation<\"):\n                    self.fail(\"TypeMismatch\", \"value requires exactly one observation\", owner, node=expr)\n                typ = args[0][1][12:-1]\n                context = args[0][2]\n                target = \"builtin:value@1\"\n            elif expr.name == \"constant\":\n                if len(args) != 1 or not args[0][1].startswith(\"Rate<\"):\n                    self.fail(\"TypeMismatch\", \"constant requires one explicitly annual rate\", owner, node=expr)\n                typ = f\"Driver<{args[0][1]}>\"\n                context = args[0][2]\n                target = \"builtin:constant@1\"\n            else:\n                self.fail(\"UnsupportedExpression\", f\"call {expr.name!r} is not admitted in Core0.1\", owner,\n                          capability=f\"call:{expr.name}\", node=expr)\n            row = dict(id=expr_id, op=\"call\", type=typ, context=context,\n                       args=[a[0] for a in args], rational=None, text=None, target=target, field_names=[])\n            return self._add_expr(expr_id, row, typ, context, args[0][3] if args else None, expr, owner, path)\n        if isinstance(expr, Unary):\n            arg = self.lower_expr(expr.arg, owner, f\"{path}.arg0\")\n            if expr.op == \"not\":\n                if arg[1] != \"Bool\":\n                    self.fail(\"TypeMismatch\", \"not requires a Boolean operand\", owner, node=expr)\n                typ, value = \"Bool\", (not arg[3]) if isinstance(arg[3], bool) else None\n            elif expr.op == \"-\":\n                if not _numeric_type(arg[1]):\n                    self.fail(\"TypeMismatch\", \"negation requires a numeric operand\", owner, node=expr)\n                typ, value = arg[1], (-arg[3]) if isinstance(arg[3], Fraction) else None\n            else:\n                self.fail(\"UnsupportedExpression\", f\"unary operator {expr.op!r} is unsupported\", owner, node=expr)\n            row = dict(id=expr_id, op=\"not\" if expr.op == \"not\" else \"negate\", type=typ,\n                       context=arg[2], args=[arg[0]], rational=None, text=None, target=None, field_names=[])\n            return self._add_expr(expr_id, row, typ, arg[2], value, expr, owner, path)\n        if isinstance(expr, Binary):\n            left = self.lower_expr(expr.left, owner, f\"{path}.left\")\n            right = self.lower_expr(expr.right, owner, f\"{path}.right\")\n            op = expr.op\n            context = _merge_context(left[2], right[2], owner, self)\n            if op in {\"and\", \"or\"}:\n                if left[1] != right[1] or left[1] != \"Bool\":\n                    self.fail(\"TypeMismatch\", \"Boolean operands are required\", owner, node=expr)\n                typ, value = \"Bool\", _fold_bool(op, left[3], right[3])\n            elif op in {\"==\", \"!=\", \"<\", \"<=\", \">\", \">=\"}:\n                if left[1] != right[1]:\n                    self.fail(\"TypeMismatch\", \"comparison operands must have identical types\", owner, node=expr)\n                if op not in {\"==\", \"!=\"} and not _numeric_type(left[1]):\n                    self.fail(\"TypeMismatch\", \"ordering requires numeric operands\", owner)\n","exit_code":0,"status":"completed"}}
