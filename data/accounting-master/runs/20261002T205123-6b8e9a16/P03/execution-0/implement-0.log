t_binding\",\n                }, \"source_spans\": [span_id], \"reading\": reading_id,\n                \"review_decision\": review_id, \"supersedes\": [], \"revision_group\": f\"binding-{_clean_id(key)}\",\n            })\n            for view in self.ir[\"evidenceViews\"]:\n                if view[\"id\"] == view_id:\n                    view[\"observations\"].append(obs.name)\n        # Symbols and declarations.\n        for symbol in self.symbols.values():\n            if symbol.type_name != \"Real\":\n                self.fail(\"UnsupportedSymbol\", \"Core0.1 admits one Real interval symbol\", symbol.name)\n            low = self.lower_expr(symbol.lower, f\"symbol:{symbol.name}\", \"lower\", \"Real\")\n            high = self.lower_expr(symbol.upper, f\"symbol:{symbol.name}\", \"upper\", \"Real\")\n            if low[1] != \"Real\" or high[1] != \"Real\" or low[3] is None or high[3] is None or low[3] > high[3]:\n                self.fail(\"InvalidDomain\", \"symbol bounds must be ordered constants\", symbol.name)\n            source_key = next(iter(source_keys.values()))\n            admission = self.bindings.admission(symbol.name)\n            if admission.reading_key != source_key or _string(admission.reason) != _string(symbol.reason):\n                self.fail(\"SymbolAdmission\", \"source reason and supplied admission disagree\", symbol.name)\n            span_id = evidence[source_key][1]\n            self.ir[\"symbols\"].append({\n                \"id\": symbol.name, \"type\": symbol.type_name, \"context\": None,\n                \"domain\": {\"kind\": \"interval\", \"lower\": rational(low[3]), \"upper\": rational(high[3]),\n                            \"lower_closed\": True, \"upper_closed\": True, \"values\": [],\n                            \"missing_reason\": None, \"display\": None, \"rounding_rule\": None},\n                \"uncertainty_kind\": self.bindings.symbol_uncertainty, \"scope\": self.model_id,\n                \"dependencies\": [], \"admission\": f\"admission:{symbol.name}\", \"provenance\": [span_id],\n            })\n        for name in self.lets:\n            self._lower_let(name)\n        # Contract, alternatives, and scenario expressions.\n        contract = next(iter(self.contracts.values()))\n        fields = dict(contract.fields)\n        required_fields = {\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"}\n        if set(fields) != required_fields:\n            self.fail(\"ContractFields\", \"DebtMix requires principal, fraction and two rates\", contract.name)\n        field_rows = []\n        for name in (\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"):\n            expected = {\"principal\": f\"Money<{entity.currency}>\", \"fixed_fraction\": \"Real\",\n                        \"fixed_rate\": \"Rate<annual_simple>\", \"initial_floating_rate\": \"Rate<annual_simple>\"}[name]\n            info = self.lower_expr(fields[name], f\"contract:{contract.name}\", f\"field:{name}\", expected)\n            if info[1] != expected:\n                self.fail(\"ContractType\", f\"field {name!r} has type {info[1]}, expected {expected}\", contract.name)\n            if name in {\"fixed_rate\", \"initial_floating_rate\"}:\n                self._assumption_row(f\"contract:{contract.name}:{name}\", info[0], contract.name, evidence)\n            field_rows.append({\"name\": name, \"expression\": info[0]})\n        self.ir[\"contracts\"].append({\"id\": contract.name, \"type\": f\"{package.id}/{contract.type_name}\",\n                                      \"book\": contract.book, \"fields\": field_rows, \"package\": package.id,\n                                      \"source_refs\": [evidence[next(iter(source_keys.values()))][1]]})\n        alt_ids = []\n        constraint_ids = []\n        for alt in self.alternatives.values():\n            meta = self.bindings.alternative(alt.name)\n            alt_ids.append(alt.name)\n            alt_constraints = []\n            for index, assumption in enumerate(alt.assumptions):\n                eid = self.lower_expr(assumption, f\"alternative:{alt.name}\", f\"assumption:{index}\")[0]\n                cid = f\"constraint:{_clean_id(alt.name)}:{index}\"\n                self.ir[\"constraints\"].append({\"id\": cid, \"expression\": eid, \"kind\": \"assumption\",\n                                                \"scope\": alt.name, \"source_refs\": []})\n                alt_constraints.append(cid)\n                self._assumption_row(f\"alternative:{alt.name}:{index}\", eid, alt.name, evidence)\n            if not alt_constraints:\n                self.fail(\"MissingAlternativeCondition\", \"named alternatives require a Boolean condition\", alt.name)\n            self.ir[\"alternatives\"].append({\n                \"id\": alt.name, \"parent\": f\"history:{_clean_id(self.model_id)}\", \"scope\": model_scope,\n                \"author\": meta.author,\n                \"created_at\": meta.created_at,\n                \"constraints\": alt_constraints, \"choice_group\": None,\n                \"reason\": meta.reason, \"evidence\": [evidence[next(iter(source_keys.values()))][1]],\n                \"opposing_evidence\": [],\n            })\n        for con in self.constraints.values():\n            eid = self.lower_expr(con.expression, f\"constraint:{con.name}\", \"condition\")[0]\n            self.ir[\"constraints\"].append({\"id\": con.name, \"expression\": eid, \"kind\": \"assumption\",\n                                           \"scope\": model_scope, \"source_refs\": []})\n            constraint_ids.append(con.name)\n            self._assumption_row(f\"constraint:{con.name}\", eid, model_scope, evidence)\n        scenario = next(iter(self.scenarios.values()))\n        settings = dict(scenario.settings)\n        if set(settings) != {\"market_rate\"}:\n            self.fail(\"ScenarioFields\", \"Core0.1 scenario requires one market_rate setting\", scenario.name)\n        driver = self.lower_expr(settings[\"market_rate\"], f\"scenario:{scenario.name}\", \"market_rate\")\n        if not driver[1].startswith(\"Driver<Rate<\"):\n            self.fail(\"ScenarioType\", \"market_rate must be a constant annual rate driver\", scenario.name)\n        self._assumption_row(f\"scenario:{scenario.name}\", driver[0], scenario.name, evidence)\n        self.ir[\"scenarios\"].append({\"id\": scenario.name, \"kind\": \"ExogenousStress\",\n                                      \"drivers\": [{\"name\": \"market_rate\", \"expression\": driver[0]}],\n                                      \"probability_model\": None, \"observed_event\": None, \"structural_model\": None,\n                                      \"replaced_equations\": [], \"visibility\": \"announced\"})\n        # Opening state and report mapping.\n        opening_decl = next(iter(self.openings.values()))\n        opening = self.bindings.opening(opening_decl.external)\n        if opening.book is not None and opening.book != opening_decl.book:\n            self.fail(\"OpeningStateMismatch\", \"opening binding belongs to another book\", opening_decl.name)\n        account_names = {a.name for a in self.accounts.values()}\n        bound_names = {name for name, _ in opening.balances}\n        if account_names != bound_names:\n            self.fail(\"OpeningStateMismatch\", \"opening binding must provide every account exactly once\", opening_decl.name)\n        total = sum((value for _, value in opening.balances), Fraction(0))\n        if total != 0:\n            self.fail(\"UnbalancedState\", \"opening signed balances must sum to zero\", opening_decl.name)\n        self.ir[\"states\"].append({\"id\": opening_decl.name, \"date\": _iso(opening.date, opening_decl.name),\n                    raise _Failure(Diagnostic(\"ContractType\", f\"{name} has the wrong type\", row[\"id\"]))\n            fixed = checker.expr(fields[\"fixed_fraction\"])\n            if fixed[2] is not None and (fixed[2] < 0 or fixed[2] > 1):\n                raise _Failure(Diagnostic(\"ContractDomain\", \"fixed fraction must lie inside [0,1]\", row[\"id\"]))\n            for name in (\"fixed_rate\", \"initial_floating_rate\"):\n                value = checker.expr(fields[name])[2]\n                if value is not None and value < 0:\n                    raise _Failure(Diagnostic(\"ContractDomain\", f\"{name} must be nonnegative\", row[\"id\"]))\n        alternatives = {r[\"id\"]: r for r in ir[\"alternatives\"]}\n        for row in ir[\"alternatives\"]:\n            if row[\"parent\"] not in {r[\"id\"] for r in ir[\"historyFamilies\"]} or row[\"scope\"] not in scope_ids:\n                raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative parent or scope is unknown\", row[\"id\"]))\n            meta = next((a for a in bindings.alternatives if a.name == row[\"id\"]), None)\n            if meta is None or row[\"author\"] != meta.author or row[\"created_at\"] != meta.created_at or row[\"reason\"] != meta.reason:\n                raise _Failure(Diagnostic(\"AlternativeMetadata\", \"alternative metadata differs from binding\", row[\"id\"]))\n            if not row[\"constraints\"]:\n                raise _Failure(Diagnostic(\"MissingAlternativeCondition\", \"alternative requires at least one condition\", row[\"id\"]))\n            for cid in row[\"constraints\"]:\n                c = next((x for x in ir[\"constraints\"] if x[\"id\"] == cid), None)\n                if c is None or c[\"scope\"] != row[\"id\"] or checker.expr(c[\"expression\"])[0] != \"Bool\":\n                    raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative condition is not scoped to its branch\", row[\"id\"]))\n        for row in ir[\"states\"]:\n            total = Fraction(0); seen = set()\n            for balance in row[\"balances\"]:\n                if balance[\"account\"] in seen:\n                    raise _Failure(Diagnostic(\"DuplicateBalance\", \"opening account occurs twice\", row[\"id\"]))\n                seen.add(balance[\"account\"]); total += parse_rational(balance[\"signed_amount\"])\n            if total != 0:\n                raise _Failure(Diagnostic(\"UnbalancedState\", \"opening balances do not sum to zero\", row[\"id\"]))\n            expected_accounts = {a[\"id\"] for a in ir[\"accounts\"] if a[\"book\"] == row[\"book\"]}\n            if seen != expected_accounts:\n                raise _Failure(Diagnostic(\"IncompleteState\", \"opening state must include every account\", row[\"id\"]))\n            opening = next((o for o in bindings.openings\n                            if row[\"date\"] == o.date and row[\"book\"] == (o.book or row[\"book\"]) and\n                            {name: rational(value) for name, value in o.balances} ==\n                            {b[\"account\"]: b[\"signed_amount\"] for b in row[\"balances\"]}), None)\n            if opening is None:\n                raise _Failure(Diagnostic(\"OpeningStateMismatch\", \"opening state differs from bound opening export\", row[\"id\"]))\n            if row[\"contracts\"] != [c[\"id\"] for c in ir[\"contracts\"]]:\n                raise _Failure(Diagnostic(\"OpeningStateMismatch\", \"opening state must retain active contract\", row[\"id\"]))\n        for row in ir[\"historyFamilies\"]:\n            if row[\"feasibility\"] == \"Feasible\" and not row[\"witnesses\"]:\n                raise _Failure(Diagnostic(\"MissingWitness\", \"feasible family requires a witness\", row[\"id\"]))\n            if row[\"coverage\"] == \"ExactWithinScope\" and (row[\"unresolved_cells\"] or not row[\"completed_cells\"]):\n                raise _Failure(Diagnostic(\"FalseCoverage\", \"exact coverage requires completed cells and no unresolved cells\", row[\"id\"]))\n            if row[\"coverage\"] != \"PartialSearch\" or row[\"feasibility\"] != \"Unknown\" or row[\"completed_cells\"] != 0 or row[\"unresolved_cells\"] != 1:\n                raise _Failure(Diagnostic(\"CoverageClaim\", \"Core0.1 family must remain explicitly unsearched\", row[\"id\"]))\n            if set(row[\"symbols\"]) != {s[\"id\"] for s in ir[\"symbols\"]} or set(row[\"alternatives\"]) != set(alternatives):\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family must retain all shared symbols and alternatives\", row[\"id\"]))\n            if row[\"evidence_view\"] not in views or row[\"opening_state\"] not in {s[\"id\"] for s in ir[\"states\"]}:\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family evidence/opening references are unknown\", row[\"id\"]))\n","exit_code":0,"status":"completed"}}
