{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '656,805p' scripts/core0_ir_v1.py\"","aggregated_output":"            review_reason=\"Explicit synthetic disclosure supplied by the caller\",\n            cutoff=\"2026-01-01T00:00:00Z\", action=\"Accept\")\n        balances = opening_balances if opening_balances is not None else {\"Cash\": p - 5, \"Debt\": -p, \"InterestExpense\": 0, \"Retained\": 5}\n        opening = OpeningBinding(\"after-2025-close\", \"2025-12-31\", balances, book=\"Local\")\n        package = PackageBinding(\n            \"DemoDebt\", \"1\", digest, \"DemoDebt\", \"2025-01-01\", \"2028-01-01\",\n            (\"reset\", \"accrue_and_pay\", \"close\", \"statements\"),\n            (\"builtin:Core0@1\", \"DemoCalendar@1\"), (\"fixture:demo-debt-package.json\",))\n        report = ReportBinding(\"DemoDebt.statements.v1\", \"DemoDebt.statements.v1\",\n                               \"interest_operating\", \"close\", (\"accrue_and_pay\",))\n        assumptions = tuple(AssumptionBinding(key, reason, information_cutoff=reading.cutoff,\n                           valid_start=\"2026-01-01\", valid_end=\"2027-01-01\") for key, reason in (\n            (\"alternative\", \"Named endpoint condition supplied for comparison\"),\n            (\"constraint\", \"Explicit caller constraint on the shared family\"),\n            (\"contract-rate\", \"Component rates are explicit scenario inputs supplied by the caller\"),\n            (\"scenario\", f\"Illustrative constant annual stress {stress}; not an estimated future rate\")))\n        # Retain values for callers that want to inspect the intended defaults;\n        # rate values remain in the typed/source program itself.\n        _ = fixed\n        admissions = (SymbolAdmission(\"alpha\", reading.key, \"Fixed-rate proportion not disclosed\",\n                                     \"synthetic-fixture-author\", reading.review_date),)\n        alternatives = tuple(AlternativeBinding(name, \"synthetic-fixture-author\", reading.review_date,\n                            \"Named endpoint hypothesis supplied by the synthetic caller\")\n                             for name in (\"allFixed\", \"allFloating\"))\n        return cls((package,), (reading,), (opening,), (report,), assumptions,\n                   admissions=admissions, alternatives=alternatives)\n\n\ndef _unique(rows, attr, key, code):\n    matches = [r for r in rows if getattr(r, attr) == key]\n    if len(matches) != 1:\n        raise _diag(code, f\"{key!r} must have exactly one explicit binding\", str(key))\n    return matches[0]\n\n\ndef _validate_bindings(bindings: CompileBindings) -> None:\n    \"\"\"Validate caller supplied metadata before any semantic lowering.\n\n    Bindings are facts supplied by the caller; they are never inferred from a\n    source declaration or from the authored expected IR.  This early pass\n    catches duplicate/ambiguous exports, invalid dates and unsafe package\n    artifacts so later lowering can rely on a single explicit record.\n    \"\"\"\n    if not isinstance(bindings, CompileBindings):\n        raise _diag(\"InvalidBindings\", \"compile bindings must be CompileBindings\", \"bindings\")\n\n    def unique(rows: Sequence[Any], attr: str, where: str) -> None:\n        values = [getattr(row, attr) for row in rows]\n        if len(values) != len(set(values)):\n            raise _diag(\"AmbiguousBinding\", f\"duplicate {attr} in {where}\", where)\n\n    unique(bindings.packages, \"id\", \"packages\")\n    unique(bindings.readings, \"key\", \"readings\")\n    unique(bindings.openings, \"key\", \"openings\")\n    unique(bindings.reports, \"key\", \"reports\")\n    unique(bindings.assumptions, \"key\", \"assumptions\")\n    unique(bindings.admissions, \"name\", \"admissions\")\n    unique(bindings.alternatives, \"name\", \"alternatives\")\n\n    try:\n        _iso(bindings.horizon_start, \"bindings.horizon_start\")\n        _iso(bindings.horizon_end, \"bindings.horizon_end\")\n        if date.fromisoformat(bindings.horizon_end) <= date.fromisoformat(bindings.horizon_start):\n            raise _diag(\"InvalidPeriod\", \"horizon end must be after start\", \"bindings.horizon\")\n    except _Failure:\n        raise\n    if bindings.calendar_id != \"DemoCalendar@1\" or bindings.calendar_name != \"Gregorian\":\n        raise _diag(\"UnsupportedCalendar\", \"Core0.1 requires DemoCalendar@1/Gregorian\", \"bindings.calendar\")\n    if bindings.symbol_uncertainty not in {\"HistoricalFact\"}:\n        raise _diag(\"UnsupportedUncertainty\", \"Core0.1 admits only HistoricalFact symbols\", \"bindings.symbol_uncertainty\")\n\n    package_root = ROOT.resolve()\n    for package in bindings.packages:\n        if package.name != \"DemoDebt\" or package.version != \"1\":\n            raise _diag(\"UnsupportedPackage\", \"Core0.1 requires DemoDebt@1\", package.id)\n        if not re.fullmatch(r\"[0-9a-f]{64}\", package.digest):\n            raise _diag(\"InvalidPackageDigest\", \"package digest must be a SHA-256 hex digest\", package.id)\n        try:\n            start = date.fromisoformat(package.effective_start)\n            end = date.fromisoformat(package.effective_end)\n        except ValueError as exc:\n            raise _diag(\"InvalidDate\", \"package applicability dates must be YYYY-MM-DD\", package.id) from exc\n        if end <= start:\n            raise _diag(\"InvalidPeriod\", \"package effective end must be after start\", package.id)\n        artifact = (ROOT / package.artifact).resolve()\n        if not artifact.is_relative_to(package_root) or not artifact.is_file():\n            raise _diag(\"UnsafePackageArtifact\", \"package artifact must be an existing project-local file\", package.id)\n        if hashlib.sha256(artifact.read_bytes()).hexdigest() != package.digest:\n            raise _diag(\"PackageDigestMismatch\", \"package artifact digest differs from binding\", package.id)\n        if package.basis != package.name or \"builtin:Core0@1\" not in package.dependencies or \"DemoCalendar@1\" not in package.dependencies:\n            raise _diag(\"PackageBinding\", \"package basis/dependencies are not the locked Core0 set\", package.id)\n        if set(package.operations) != {\"reset\", \"accrue_and_pay\", \"close\", \"statements\"}:\n            raise _diag(\"PackageBinding\", \"package operations differ from the retained DemoDebt export\", package.id)\n        if any(not str(a) or \"..\" in str(a) for a in package.authority):\n            raise _diag(\"UnsafePackageAuthority\", \"package authority contains an unsafe path\", package.id)\n\n    for reading in bindings.readings:\n        if not reading.key or not reading.currency or reading.action != \"Accept\":\n            raise _diag(\"BindingAcceptance\", \"readings require an explicit Accept action\", reading.key or \"reading\")\n        _iso(reading.instant, f\"reading:{reading.key}.instant\")\n        for label, value in ((\"available\", reading.available), (\"ingested\", reading.ingested),\n                             (\"review_date\", reading.review_date), (\"cutoff\", reading.cutoff)):\n            _instant(value, f\"reading:{reading.key}.{label}\")\n        if reading.system_as_of is not None:\n            _instant(reading.system_as_of, f\"reading:{reading.key}.system_as_of\")\n        if not reading.reviewer or not reading.review_reason or not reading.literal:\n            raise _diag(\"IncompleteEvidence\", \"reading bindings require reviewer, reason and literal\", reading.key)\n        if reading.amount < 0:\n            raise _diag(\"InvalidReading\", \"debt principal reading must be nonnegative\", reading.key)\n\n    for opening in bindings.openings:\n        _iso(opening.date, f\"opening:{opening.key}.date\")\n        if not opening.balances or len({name for name, _ in opening.balances}) != len(opening.balances):\n            raise _diag(\"OpeningStateMismatch\", \"opening balances require unique account names\", opening.key)\n        if any(name not in _ACCOUNT_ROLES for name, _ in opening.balances):\n            raise _diag(\"OpeningStateMismatch\", \"opening contains an account outside DemoDebt\", opening.key)\n\n    for report in bindings.reports:\n        if not report.key or not report.mapping or not report.cash_flow_policy or not report.closing_policy:\n            raise _diag(\"IncompleteReportBinding\", \"report bindings require mapping and policies\", report.key or \"report\")\n        if not report.required_operations:\n            raise _diag(\"IncompleteReportBinding\", \"report binding requires at least one operation\", report.key)\n\n    for assumption in bindings.assumptions:\n        if assumption.provenance not in {\"Analyst\", \"EmpiricalEstimate\", \"ImportedModel\", \"ScenarioDesign\"}:\n            raise _diag(\"InvalidAssumption\", \"unsupported assumption provenance\", assumption.key)\n        if assumption.role not in {\"Baseline\", \"Hypothesis\", \"Convenience\", \"ReviewedDefault\"}:\n            raise _diag(\"InvalidAssumption\", \"unsupported assumption role\", assumption.key)\n        if assumption.information_cutoff is not None:\n            _instant(assumption.information_cutoff, f\"assumption:{assumption.key}.cutoff\")\n        if assumption.valid_start is None or assumption.valid_end is None:\n            raise _diag(\"IncompleteAssumption\", \"assumptions require a validity interval\", assumption.key)\n        _iso(assumption.valid_start, f\"assumption:{assumption.key}.valid_start\")\n        _iso(assumption.valid_end, f\"assumption:{assumption.key}.valid_end\")\n        if date.fromisoformat(assumption.valid_end) <= date.fromisoformat(assumption.valid_start):\n            raise _diag(\"InvalidPeriod\", \"assumption validity end must be after start\", assumption.key)\n\n    readings = {r.key for r in bindings.readings}\n    for admission in bindings.admissions:\n        if admission.reading_key not in readings or admission.kind != \"HistoricalFact\":\n            raise _diag(\"SymbolAdmission\", \"symbol admissions must cite a bound HistoricalFact reading\", admission.name)\n        _instant(admission.date, f\"admission:{admission.name}.date\")\n        if not admission.reviewer or not admission.reason:\n            raise _diag(\"IncompleteAdmission\", \"symbol admissions require reviewer and reason\", admission.name)\n    for alternative in bindings.alternatives:\n        _instant(alternative.created_at, f\"alternative:{alternative.name}.created_at\")\n        if not alternative.author or not alternative.reason:\n            raise _diag(\"IncompleteAlternative\", \"alternative metadata require author and reason\", alternative.name)\n\n\n","exit_code":0,"status":"completed"}}
