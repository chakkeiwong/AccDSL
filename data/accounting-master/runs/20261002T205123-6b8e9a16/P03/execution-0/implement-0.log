e\n    valid_start: Optional[str] = None\n    valid_end: Optional[str] = None\n\n    def __init__(self, key: str, rationale: str, provenance: str = \"ScenarioDesign\",\n                 role: str = \"Hypothesis\", source_refs: Sequence[str] = (),\n                 information_cutoff: Optional[str] = None,\n                 valid_start: Optional[str] = None, valid_end: Optional[str] = None):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"rationale\", rationale)\n        object.__setattr__(self, \"provenance\", provenance)\n        object.__setattr__(self, \"role\", role)\n        object.__setattr__(self, \"source_refs\", tuple(source_refs))\n        object.__setattr__(self, \"information_cutoff\", information_cutoff)\n        object.__setattr__(self, \"valid_start\", valid_start)\n        object.__setattr__(self, \"valid_end\", valid_end)\n\n\n@dataclass(frozen=True)\nclass SymbolAdmission:\n    name: str\n    reading_key: str\n    reason: str\n    reviewer: str\n    date: str\n    kind: str = \"HistoricalFact\"\n\n\n@dataclass(frozen=True)\nclass AlternativeBinding:\n    name: str\n    author: str\n    created_at: str\n    reason: str\n\n\n@dataclass(frozen=True)\nclass CompileBindings:\n    packages: tuple[PackageBinding, ...] = ()\n    readings: tuple[ReadingBinding, ...] = ()\n    openings: tuple[OpeningBinding, ...] = ()\n    reports: tuple[ReportBinding, ...] = ()\n    assumptions: tuple[AssumptionBinding, ...] = ()\n    calendar_id: str = \"DemoCalendar@1\"\n    calendar_name: str = \"Gregorian\"\n    horizon_start: str = \"2026-01-01\"\n    horizon_end: str = \"2027-01-01\"\n    symbol_uncertainty: str = \"HistoricalFact\"\n    entity_perimeter: str = \"Acme-only\"\n    admissions: tuple[SymbolAdmission, ...] = ()\n    alternatives: tuple[AlternativeBinding, ...] = ()\n\n    def __init__(self, packages: Sequence[PackageBinding] = (), readings: Sequence[ReadingBinding] = (),\n                 openings: Sequence[OpeningBinding] = (), reports: Sequence[ReportBinding] = (),\n                 assumptions: Sequence[AssumptionBinding] = (), calendar_id: str = \"DemoCalendar@1\",\n                 calendar_name: str = \"Gregorian\", horizon_start: str = \"2026-01-01\",\n                 horizon_end: str = \"2027-01-01\", symbol_uncertainty: str = \"HistoricalFact\",\n                 entity_perimeter: str = \"Acme-only\", admissions: Sequence[SymbolAdmission] = (),\n                 alternatives: Sequence[AlternativeBinding] = ()):\n        object.__setattr__(self, \"packages\", tuple(packages))\n        object.__setattr__(self, \"readings\", tuple(readings))\n        object.__setattr__(self, \"openings\", tuple(openings))\n        object.__setattr__(self, \"reports\", tuple(reports))\n        object.__setattr__(self, \"assumptions\", tuple(assumptions))\n        object.__setattr__(self, \"calendar_id\", calendar_id)\n        object.__setattr__(self, \"calendar_name\", calendar_name)\n        object.__setattr__(self, \"horizon_start\", horizon_start)\n        object.__setattr__(self, \"horizon_end\", horizon_end)\n        object.__setattr__(self, \"symbol_uncertainty\", symbol_uncertainty)\n        object.__setattr__(self, \"entity_perimeter\", entity_perimeter)\n        object.__setattr__(self, \"admissions\", tuple(admissions))\n        object.__setattr__(self, \"alternatives\", tuple(alternatives))\n\n    def admission(self, name: str) -> SymbolAdmission:\n        return _unique(self.admissions, \"name\", name, \"MissingSymbolAdmission\")\n\n    def alternative(self, name: str) -> AlternativeBinding:\n        return _unique(self.alternatives, \"name\", name, \"MissingAlternativeMetadata\")\n\n    def package(self, name: str, version: Optional[str] = None) -> PackageBinding:\n        candidates = [p for p in self.packages if p.name == name and (version is None or p.version == version)]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingPackageBinding\", f\"package {name!r} is not uniquely bound\", name))\n        return candidates[0]\n\n    def reading(self, key: str) -> ReadingBinding:\n        candidates = [r for r in self.readings if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"reading {key!r} is not bound\", key))\n        return candidates[0]\n\n    def opening(self, key: str) -> OpeningBinding:\n        candidates = [r for r in self.openings if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"opening {key!r} is not bound\", key))\n        return candidates[0]\n\n    def report(self, key: str) -> ReportBinding:\n        candidates = [r for r in self.reports if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"report mapping {key!r} is not bound\", key))\n        return candidates[0]\n\n    def assumption(self, key: str) -> AssumptionBinding:\n        candidates = [a for a in self.assumptions if a.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingAssumptionMetadata\", f\"assumption metadata {key!r} is not bound\", key))\n        return candidates[0]\n\n    @classmethod\n    def demo(cls, root: Path | str | None = None, principal: Fraction | int | str = 100,\n             stress_rate: Fraction | int | str = Fraction(7, 100),\n             fixed_rate: Fraction | int | str = Fraction(1, 20),\n             opening_balances: Mapping[str, Fraction | int | str] | None = None) -> \"CompileBindings\":\n        \"\"\"Create explicit synthetic bindings for the bounded demonstration profile.\n\n        This helper is a convenience for tests and examples.  The compiler\n        still receives all evidence/package/assumption records as arguments;\n        it does not inspect the authored expected IR.\n        \"\"\"\n        root_path = Path(root) if root is not None else ROOT\n        package_path = root_path / \"docs/design/fixtures/demo-debt-package.json\"\n        digest = hashlib.sha256(package_path.read_bytes()).hexdigest() if package_path.is_file() else \"\"\n        p = _fraction(principal)\n        stress = _fraction(stress_rate)\n        fixed = _fraction(fixed_rate)\n        literal = f\"Debt {p}; interest 5; fixed/floating split not disclosed\"\n        reading = ReadingBinding(\n            key=\"synthetic-note-7\", literal=literal, amount=p, currency=\"USD\",\n            instant=\"2025-12-31\", uri=\"fixture:demo-debt-package.json#registry/synthetic-note-7\",\n            filing_id=\"synthetic-2025\", available=\"2026-01-01T00:00:00Z\",\n            ingested=\"2026-01-01T00:00:00Z\", reviewer=\"synthetic-fixture-author\",\n            review_date=\"2026-01-01T00:00:00Z\",\n","exit_code":0,"status":"completed"}}
