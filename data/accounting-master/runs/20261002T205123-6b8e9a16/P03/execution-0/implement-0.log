{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '960,1008p' scripts/core0_ir_v1.py && sed -n '1220,1285p' scripts/core0_ir_v1.py && sed -n '1420,1485p' scripts/core0_ir_v1.py && sed -n '1564,1586p' scripts/core0_ir_v1.py\"","aggregated_output":"        self.book = next(iter(self.books.values()))\n        if self.book.entity != self.entity.name:\n            self.fail(\"BindingMismatch\", \"book entity must name the declared entity\", self.book.name)\n        if self.book.basis != self.package.name or self.book.version != self.package.version:\n            self.fail(\"PackageBinding\", \"book basis/version must match the locked package\", self.book.name)\n        if self.entity.currency != \"USD\":\n            self.fail(\"UnsupportedCurrency\", \"DemoDebt report requires USD\", self.entity.name)\n        if {a.name: a.role for a in self.accounts.values()} != _ACCOUNT_ROLES:\n            self.fail(\"PackageAccounts\", \"DemoDebt report requires its four named account roles\", \"accounts\")\n\n    @staticmethod\n    def _check_name(name: str, where: str, reserved: set[str]) -> None:\n        if not re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", name):\n            raise _diag(\"InvalidIdentifier\", f\"invalid identifier {name!r}\", where)\n        if name in reserved:\n            raise _diag(\"ReservedIdentifier\", f\"reserved keyword {name!r} cannot be declared\", where)\n\n    def _external_ids(self) -> dict[str, Any]:\n        return {\n            **{r.key: r for r in self.bindings.readings},\n            **{o.key: o for o in self.bindings.openings},\n            **{r.key: r for r in self.bindings.reports},\n        }\n\n    def _expr_id(self, owner: str, path: str) -> str:\n        return f\"expr:{_clean_id(owner)}:{_clean_id(path)}\"\n\n    def _record_source(self, expr_id: str, expr: Any, owner: str, path: str) -> None:\n        item = self.source_spans.get(id(expr))\n        if item:\n            self.source_map[expr_id] = dict(item, owner=owner, path=path)\n        else:\n            self.source_map[expr_id] = {\"constructor\": type(expr).__name__, \"owner\": owner, \"path\": path}\n\n    def _add_expr(self, expr_id: str, row: dict[str, Any], typ: str,\n                  context: Optional[str], value: Any = None, expr: Any = None,\n                  owner: str = \"\", path: str = \"\") -> tuple[str, str, Optional[str], Any]:\n        if expr_id in self.expr_rows:\n            prior = self.expr_rows[expr_id]\n            if prior != row:\n                self.fail(\"ExpressionIdentityCollision\", f\"two expressions map to {expr_id}\", expr_id)\n            return expr_id, typ, context, value\n        self.expr_rows[expr_id] = row\n        self.expr_info[expr_id] = (typ, context, value)\n        self._record_source(expr_id, expr, owner, path)\n        return expr_id, typ, context, value\n\n    def _lookup_type(self, name: str) -> tuple[str, Optional[str], Any]:\n        if name in self.let_ids:\n            _iso(reading.instant, f\"reading:{key}.instant\")\n            if reading.system_as_of is not None:\n                _instant(reading.system_as_of, f\"reading:{key}.system_as_of\")\n            document_id = f\"document:{_clean_id(key)}\"\n            span_id = f\"span:{_clean_id(key)}\"\n            reading_id = f\"reading:{_clean_id(key)}\"\n            review_id = f\"review:{_clean_id(key)}\"\n            view_id = f\"evidence:{_clean_id(key)}\"\n            self.ir[\"sourceSpans\"].append({\n                \"id\": span_id, \"document\": document_id, \"locator\": f\"binding:{key}\",\n                \"literal\": reading.literal, \"extraction\": reading.extraction,\n            })\n            self.ir[\"documents\"].append({\n                \"id\": document_id, \"sha256\": hashlib.sha256(reading.literal.encode(\"utf-8\")).hexdigest(),\n                \"uri\": reading.uri, \"filing_id\": reading.filing_id, \"available\": reading.available,\n                \"availability_policy\": \"explicit_binding_timestamp\", \"ingested\": reading.ingested,\n            })\n            self.ir[\"reviewDecisions\"].append({\n                \"id\": review_id, \"reading_ids\": [reading_id], \"action\": reading.action,\n                \"reviewer\": reading.reviewer, \"date\": reading.review_date,\n                \"reason\": reading.review_reason, \"evidence\": [span_id],\n                \"prior_view\": reading.prior_view, \"new_view\": view_id,\n                \"invalidated_descendants\": [],\n            })\n            self.ir[\"evidenceViews\"].append({\n                \"id\": view_id, \"cutoff\": reading.cutoff, \"system_as_of\": reading.system_as_of,\n                \"mode\": \"ExplicitSelection\", \"documents\": [document_id], \"observations\": [],\n                \"decisions\": [review_id], \"conflict_sets\": [], \"transforms\": [],\n            })\n            out[key] = (document_id, span_id, view_id)\n            # The reading object is a small external export represented by the\n            # binding.  It is referenced by observations but is not embedded as\n            # an executable package or expected-result fixture.\n            self._reading_ids[key] = reading_id\n        return out\n\n    def build(self) -> CompileResult:\n        self.collect()\n        source_keys, _, _ = self._lower_source_metadata()\n        self._reading_ids: dict[str, str] = {}\n        evidence = self._build_evidence(source_keys)\n        assert self.entity is not None and self.book is not None and self.package is not None\n        entity = self.entity\n        book = self.book\n        package = self.package\n        model_scope = self.scope_id\n        # Core declarations and package context.\n        self.ir[\"entities\"].append({\"id\": entity.name, \"functional_currency\": entity.currency})\n        self.ir[\"packages\"].append({\n            \"id\": package.id, \"version\": package.version, \"digest\": package.digest,\n            \"basis\": package.basis,\n            \"effective\": _time(\"interval\", package.effective_start, package.effective_end, self.bindings.calendar_id),\n            \"operations\": [f\"{package.id}/{x}\" for x in package.operations],\n            \"extension_points\": [], \"dependencies\": list(package.dependencies),\n            \"authority\": list(package.authority), \"review_status\": package.review_status,\n            \"implementation\": package.implementation,\n        })\n        self.ir[\"books\"].append({\"id\": book.name, \"entity\": book.entity, \"basis\": package.id,\n                                  \"package\": package.id, \"currency\": entity.currency})\n        for account in self.accounts.values():\n            if account.book != book.name:\n                self.fail(\"BindingMismatch\", \"all accounts must belong to the declared book\", account.name)\n            if account.role not in {\"Asset\", \"Liability\", \"Expense\", \"Equity\"}:\n                self.fail(\"UnsupportedAccountRole\", f\"account role {account.role!r} is outside profile\", account.name)\n            self.ir[\"accounts\"].append({\"id\": account.name, \"book\": account.book,\n                                         \"role\": account.role, \"report_concept\": account.name})\n            self.fail(\"OpeningStateMismatch\", \"opening binding must provide every account exactly once\", opening_decl.name)\n        total = sum((value for _, value in opening.balances), Fraction(0))\n        if total != 0:\n            self.fail(\"UnbalancedState\", \"opening signed balances must sum to zero\", opening_decl.name)\n        self.ir[\"states\"].append({\"id\": opening_decl.name, \"date\": _iso(opening.date, opening_decl.name),\n                                   \"book\": opening_decl.book,\n                                   \"balances\": [{\"account\": name, \"signed_amount\": rational(value)} for name, value in opening.balances],\n                                   \"contracts\": [contract.name], \"measurements\": [],\n                                   \"dependencies\": list(opening.dependencies) or [evidence[next(iter(source_keys.values()))][2]]})\n        report = next(iter(self.reports.values()))\n        rb = self.bindings.report(report.mapping.key if isinstance(report.mapping, External) else str(report.mapping)) if isinstance(report.mapping, External) else None\n        if rb is None:\n            self.fail(\"UnsupportedReportMapping\", \"report mapping must be an explicit external binding\", report.name)\n        self.ir[\"reportMappings\"].append({\"id\": report.name, \"book\": report.book, \"basis\": package.id,\n                                          \"rows\": [{\"name\": \"package_mapping\", \"expression\": self._source_ref_expr(rb.mapping, report.name)}],\n                                          \"closing_policy\": f\"{package.id}/{rb.closing_policy}\",\n                                          \"cash_flow_policy\": f\"{package.id}/{rb.cash_flow_policy}\",\n                                          \"required_operations\": [f\"{package.id}/{x}\" for x in rb.required_operations]})\n        # Profile scope and conservative family status.  This profile does not\n        # perform a reconstruction or feasibility search.\n        slot = self._literal_expr(\"scope\", \"slot_limit\", 1, \"Int\")\n        self.ir[\"modelScopes\"].append({\"id\": model_scope, \"templates\": [f\"{package.id}/{contract.type_name}\"],\n                                       \"slot_limits\": [{\"name\": \"debt_contracts\", \"expression\": slot}],\n                                       \"resolution\": \"one fixed/floating aggregate, annual simple accrual\",\n                                       \"calendars\": [self.bindings.calendar_id], \"choices\": [],\n                                       \"exclusions\": [\"fees\", \"foreign_currency\", \"embedded_options\"], \"obligations\": []})\n        family_id = f\"history:{_clean_id(self.model_id)}\"\n        self.ir[\"historyFamilies\"].append({\"id\": family_id, \"scope\": model_scope,\n            \"evidence_view\": evidence[next(iter(source_keys.values()))][2], \"opening_state\": opening_decl.name,\n            \"symbols\": list(self.symbols), \"choices\": [], \"constraints\": constraint_ids,\n            \"alternatives\": alt_ids, \"feasibility\": \"Unknown\", \"coverage\": \"PartialSearch\",\n            \"completed_cells\": 0, \"unresolved_cells\": 1, \"witnesses\": [], \"solver_results\": []})\n        declarations = [self.let_ids.get(n, n) for n in self.decls]\n        declarations = [n for n in declarations if n not in self.sources]\n        self.ir[\"models\"].append({\"id\": self.model_id, \"language_version\": \"Core0.1\",\n                                  \"declarations\": list(dict.fromkeys(declarations)),\n                                  \"package_lock\": [package.id], \"scope\": model_scope})\n        self.ir[\"expressions\"] = list(self.expr_rows.values())\n        self.ir[\"diagnostics\"] = []\n        # Evidence view observations were added after creation; record all\n        # generated rows deterministically.\n        self.ir[\"sourceSpans\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"documents\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"observations\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"expressions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"assumptions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"constraints\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"alternatives\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"reviewDecisions\"].sort(key=lambda r: r[\"id\"])\n        self.ir[\"evidenceViews\"].sort(key=lambda r: r[\"id\"])\n        # Validate the generated structure before exposing it.\n        checked = validate_ir(self.ir, self.bindings)\n        if not checked.ok:\n            raise _Failure(checked.diagnostics[0])\n        return CompileResult(copy.deepcopy(self.ir), (), MappingProxyType(copy.deepcopy(self.source_map)))\n\n    def _source_ref_expr(self, mapping: str, owner: str) -> str:\n        return self._literal_expr(owner, \"report_mapping\", mapping, \"SourceRef\")\n\n    def _literal_expr(self, owner: str, path: str, value: Any, typ: str) -> str:\n        expr = Literal(value, type_name=typ)\n        return self.lower_expr(expr, owner, path)[0]\n\n    def _assumption_row(self, key: str, expression: str, scope: str,\n                        evidence: Mapping[str, tuple[str, str, str]]) -> str:\n        # Existing row IDs are reused when the same source expression is\ndef compile_program(program: Program, bindings: CompileBindings,\n                    *, source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,\n                    input_text: Optional[str] = None) -> CompileResult:\n    \"\"\"Lower a typed ``Program`` through the shared Core0.1 stages.\"\"\"\n    if not isinstance(program, Program):\n        raise TypeError(\"compile_program requires a Program constructed from typed declarations\")\n    input_sha256 = hashlib.sha256(input_text.encode(\"utf-8\")).hexdigest() if input_text is not None else None\n    try:\n        result = _Compiler(program, bindings, source_spans, input_text).build()\n        if input_sha256 is None:\n            input_sha256 = hashlib.sha256(json.dumps(binding_projection(program), sort_keys=True).encode()).hexdigest()\n        return CompileResult(result.ir, result.diagnostics, result.source_map, input_sha256, binding_projection(bindings))\n    except _Failure as exc:\n        return CompileResult(None, (exc.diagnostic,), MappingProxyType({}),\n                             input_sha256)\n\n\n# ---------------------------------------------------------------------------\n# IR validation and exact evaluation\n\n\ndef _load_schema() -> dict[str, Any]:\n    try:\n","exit_code":0,"status":"completed"}}
