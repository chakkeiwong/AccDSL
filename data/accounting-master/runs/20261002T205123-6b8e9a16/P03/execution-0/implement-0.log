mo_ir_schema',True,'Author-entered expected lowering with source, context, review, state, contracts, alternatives, scenario and reporting package')\n    expressions={e['id']:e for e in demo['expressions']};observations={o['id']:o for o in demo['observations']}\n    def eval_expr(id,alpha):\n        e=expressions[id]\n        if e['op']=='literal':\n            return Q(int(e['rational']['n']),int(e['rational']['d'])) if e['rational'] else e['text']\nobservations [{'id': 'debt', 'context': 'debt-context', 'domain': {'kind': 'exact', 'lower': {'n': '100', 'd': '1'}, 'upper': {'n': '100', 'd': '1'}, 'lower_closed': True, 'upper_closed': True, 'values': [], 'missing_reason': None, 'display': '100 USD', 'rounding_rule': 'exact_authored_fixture'}, 'source_spans': ['synthetic-note-7'], 'reading': 'fixture:synthetic-note-7/exact-reading', 'review_decision': 'demo-review-1', 'supersedes': [], 'revision_group': 'synthetic-v1'}]\ncontracts [{'id': 'loans', 'type': 'DemoDebt@1/DebtMix', 'book': 'Local', 'fields': [{'name': 'principal', 'expression': 'debt.value'}, {'name': 'fixed_fraction', 'expression': 'alpha.ref'}, {'name': 'fixed_rate', 'expression': 'rate.fixed'}, {'name': 'initial_floating_rate', 'expression': 'rate.fixed'}], 'package': 'DemoDebt@1', 'source_refs': ['synthetic-note-7']}]\nreportMappings [{'id': 'statements', 'book': 'Local', 'basis': 'DemoDebt@1', 'rows': [{'name': 'package_mapping', 'expression': 'report.mapping'}], 'closing_policy': 'DemoDebt@1/close', 'cash_flow_policy': 'DemoDebt@1/interest_operating', 'required_operations': ['DemoDebt@1/accrue_and_pay']}]\ncontexts [{'id': 'debt-context', 'entity': 'Acme', 'perimeter': 'Acme-only', 'concept': 'debt_principal', 'basis': 'DemoDebt@1', 'measurement': 'principal', 'time': {'kind': 'instant', 'start': '2025-12-31', 'end_exclusive': None, 'calendar': 'DemoCalendar@1'}, 'unit': 'USD', 'currency': 'USD', 'taxonomy_version': None, 'dimensions': []}]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat > scripts/check_accounting_p03.py <<'PY'\n#\"'!/usr/bin/env python3\n\"\"\"Execute all catalogued P03 obligations and preserve actual observations.\"\"\"\nimport argparse\nfrom datetime import datetime, timezone\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport platform\nimport sys\nimport time\nimport unittest\nfrom importlib.metadata import version\n\nROOT=Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(ROOT/'\"'tests'))\nimport test_accounting_p03 as cases\n\nCHANGED=['scripts/core0_frontends_v1.py','scripts/core0_ir_v1.py','scripts/check_accounting_p03.py',\n         'tests/test_accounting_p03.py','docs/design/spec/core0-lowering-profile-v1.md',\n         'docs/design/fixtures/p03-lowering-cases-v1.json']\n\n\ndef main():\n    parser=argparse.ArgumentParser();parser.add_argument('--output-dir',required=True);args=parser.parse_args()\n    out=Path(args.output_dir).resolve()\n    if out \"'!= ROOT/'\"'data/accounting-master/deliverables/P03':\n        parser.error('output-dir must be the declared P03 output directory')\n    started=time.monotonic()\n    entry=json.loads((ROOT/'data/accounting-master/runs/20261002T181809-4cb566e0/P03/phase-entry-inventory.json').read_text())\n    before={p:hashlib.sha256((ROOT/p).read_bytes()).hexdigest() for p in entry if (ROOT/p).is_file()}\n    cases.OBSERVATIONS.clear(); stream=io.StringIO()\n    suite=unittest.defaultTestLoader.loadTestsFromModule(cases)\n    result=unittest.TextTestRunner(stream=stream,verbosity=0).run(suite)\n    catalog=json.loads((ROOT/'docs/design/fixtures/p03-lowering-cases-v1.json').read_text())\n    required={c['id'] for c in catalog['obligations']}\n    observed={c['id'] for c in cases.OBSERVATIONS}\n    missing=sorted(required-observed);extra=sorted(observed-required)\n    after={p:hashlib.sha256((ROOT/p).read_bytes()).hexdigest() if (ROOT/p).is_file() else None f