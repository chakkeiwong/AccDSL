{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '200,310p' scripts/core0_frontends_v1.py && sed -n '205,430p' scripts/core0_ir_v1.py\"","aggregated_output":"    for item in tree.children[2:]:\n        if not isinstance(item, _Node):\n            raise ValueError(\"unexpected module token\")\n        d, c = item.data, item.children\n        try:\n            if d == \"use\":\n                uses.append(UseDecl(_text(c[0]), _strip_string(_text(c[1]), \"use version\")))\n            elif d == \"source\":\n                value = _expr(c[1], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"source requires external(string)\")\n                declarations.append(SourceDecl(_text(c[0]), value.key))\n            elif d == \"entity\":\n                declarations.append(EntityDecl(_text(c[0]), _text(c[1])))\n            elif d == \"book\":\n                declarations.append(BookDecl(_text(c[0]), _text(c[1]), _text(c[2]), _strip_string(_text(c[3]), \"book version\")))\n            elif d == \"account\":\n                declarations.append(AccountDecl(_text(c[0]), _text(c[1]), _text(c[2])))\n            elif d == \"opening\":\n                value = _expr(c[2], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"opening requires external(string)\")\n                declarations.append(OpeningDecl(_text(c[0]), _text(c[1]), value.key))\n            elif d == \"observation\":\n                typ = _type(c[1])\n                ts = c[2]\n                if not isinstance(ts, _Node) or ts.data != \"time_spec\":\n                    raise ValueError(\"observation time is required\")\n                if len(ts.children) == 1:\n                    instant = _text(ts.children[0]).lstrip(\"@\")\n                else:\n                    raise ValueError(\"period observations are outside Core0.1\")\n                value = _expr(c[3], source, spans)\n                declarations.append(ObservationDecl(_text(c[0]), typ, instant, value, _text(c[4])))\n            elif d == \"symbol\":\n                typ = _type(c[1]); bounds = _domain(c[2], source, spans)\n                if bounds is None:\n                    declarations.append(UnsupportedDecl(\"finite-domain\", _text(c[0])))\n                else:\n                    declarations.append(SymbolDecl(_text(c[0]), typ, bounds[0], bounds[1],\n                                                   _strip_string(_text(c[3]), \"symbol reason\")))\n            elif d == \"binding\":\n                name = _text(c[0]); idx = 1; declared = None\n                if isinstance(c[idx], _Node) and c[idx].data == \"type\":\n                    declared = _type(c[idx]); idx += 1\n                declarations.append(LetDecl(name, _expr(c[idx], source, spans), declared))\n            elif d == \"constraint\":\n                declarations.append(ConstraintDecl(_text(c[0]), _expr(c[1], source, spans)))\n            elif d == \"contract\":\n                fields = []\n                for field_node in c[3:]:\n                    if not isinstance(field_node, _Node) or field_node.data != \"field\":\n                        raise ValueError(\"invalid contract field\")\n                    fields.append((_text(field_node.children[0]), _expr(field_node.children[1], source, spans)))\n                declarations.append(ContractDecl(_text(c[0]), _text(c[1]), _text(c[2]), fields))\n            elif d == \"alternative\":\n                assumptions = []\n                for assumption in c[1:]:\n                    if not isinstance(assumption, _Node) or assumption.data != \"assumption\":\n                        raise ValueError(\"invalid alternative assumption\")\n                    assumptions.append(_expr(assumption.children[0], source, spans))\n                declarations.append(AlternativeDecl(_text(c[0]), assumptions))\n            elif d == \"scenario\":\n                settings = []\n                for setting in c[1:]:\n                    if not isinstance(setting, _Node) or setting.data != \"setting\":\n                        raise ValueError(\"invalid scenario setting\")\n                    settings.append((_text(setting.children[0]), _expr(setting.children[1], source, spans)))\n                declarations.append(ScenarioDecl(_text(c[0]), settings))\n            elif d == \"report\":\n                fields = [x for x in c[2:] if isinstance(x, _Node) and x.data == \"field\"]\n                mappings = [x for x in fields if _text(x.children[0]) == \"mapping\"]\n                if len(mappings) != 1:\n                    raise ValueError(\"report requires one mapping field\")\n                mapping = _expr(mappings[0].children[1], source, spans)\n                declarations.append(ReportDecl(_text(c[0]), _text(c[1]), mapping))\n            elif d in unsupported:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n            else:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n        except (IndexError, TypeError, ValueError) as exc:\n            raise ValueError(f\"invalid {d} declaration at {item.start}: {exc}\") from exc\n    return FrontendProgram(Program(module, version, declarations, uses), spans)\n\n\ndef compile_source(source: str, bindings: CompileBindings):\n    \"\"\"Parse and lower a source program through the shared compiler.\"\"\"\n    try:\n        parsed = parse_program(source)\n    except UnexpectedInput as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        start = getattr(exc, \"pos_in_stream\", None)\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\",\n                                               span=(start, start) if start is not None else None),), {})\n    except ValueError as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\"),), {})\n    return compile_program(parsed.program, bindings, source_spans=parsed.source_spans, input_text=source)\n\n\n__all__ = [\"FrontendProgram\", \"compile_source\", \"parse_program\"]\n@dataclass(frozen=True)\nclass Expr:\n    \"\"\"Marker class for typed expressions.\"\"\"\n\n\n@dataclass(frozen=True)\nclass Literal(Expr):\n    value: Any\n    type_name: Optional[str] = None\n    unit: Optional[str] = None\n    display: Optional[str] = None\n\n\n@dataclass(frozen=True)\nclass Ref(Expr):\n    name: str\n\n\n@dataclass(frozen=True)\nclass External(Expr):\n    key: str\n\n\n@dataclass(frozen=True)\nclass Call(Expr):\n    name: str\n    args: tuple[Expr, ...] = ()\n\n    def __init__(self, name: str, args: Sequence[Expr] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"args\", tuple(args))\n\n\n@dataclass(frozen=True)\nclass Binary(Expr):\n    op: str\n    left: Expr\n    right: Expr\n\n\n@dataclass(frozen=True)\nclass Unary(Expr):\n    op: str\n    arg: Expr\n\n\n@dataclass(frozen=True)\nclass ArrayExpr(Expr):\n    items: tuple[Expr, ...] = ()\n\n    def __init__(self, items: Sequence[Expr] = ()):\n        object.__setattr__(self, \"items\", tuple(items))\n\n\n@dataclass(frozen=True)\nclass RecordExpr(Expr):\n    fields: tuple[tuple[str, Expr], ...] = ()\n\n    def __init__(self, fields: Mapping[str, Expr] | Sequence[tuple[str, Expr]] = ()):\n        object.__setattr__(self, \"fields\", _pairs(fields))\n\n\n@dataclass(frozen=True)\nclass UseDecl:\n    name: str\n    version: str\n\n\n@dataclass(frozen=True)\nclass SourceDecl:\n    name: str\n    external: str\n\n\n@dataclass(frozen=True)\nclass EntityDecl:\n    name: str\n    currency: str\n\n\n@dataclass(frozen=True)\nclass BookDecl:\n    name: str\n    entity: str\n    basis: str\n    version: str\n\n\n@dataclass(frozen=True)\nclass AccountDecl:\n    name: str\n    role: str\n    book: str\n\n\n@dataclass(frozen=True)\nclass OpeningDecl:\n    name: str\n    book: str\n    external: str\n\n\n@dataclass(frozen=True)\nclass ObservationDecl:\n    name: str\n    type_name: str\n    instant: str\n    value: Expr\n    source: str\n\n\n@dataclass(frozen=True)\nclass SymbolDecl:\n    name: str\n    type_name: str\n    lower: Expr\n    upper: Expr\n    reason: str\n\n\n@dataclass(frozen=True)\nclass LetDecl:\n    name: str\n    value: Expr\n    declared_type: Optional[str] = None\n\n\n@dataclass(frozen=True)\nclass ConstraintDecl:\n    name: str\n    expression: Expr\n\n\n@dataclass(frozen=True)\nclass ContractDecl:\n    name: str\n    type_name: str\n    book: str\n    fields: tuple[tuple[str, Expr], ...] = ()\n\n    def __init__(self, name: str, type_name: str, book: str,\n                 fields: Mapping[str, Expr] | Sequence[tuple[str, Expr]] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"type_name\", type_name)\n        object.__setattr__(self, \"book\", book)\n        object.__setattr__(self, \"fields\", _pairs(fields))\n\n\n@dataclass(frozen=True)\nclass AlternativeDecl:\n    name: str\n    assumptions: tuple[Expr, ...] = ()\n\n    def __init__(self, name: str, assumptions: Sequence[Expr] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"assumptions\", tuple(assumptions))\n\n\n@dataclass(frozen=True)\nclass ScenarioDecl:\n    name: str\n    settings: tuple[tuple[str, Expr], ...] = ()\n\n    def __init__(self, name: str, settings: Mapping[str, Expr] | Sequence[tuple[str, Expr]] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"settings\", _pairs(settings))\