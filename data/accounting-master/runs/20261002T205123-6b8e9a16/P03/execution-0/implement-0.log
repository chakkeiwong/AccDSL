{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '1620,1752p' scripts/core0_ir_v1.py && rg -n '\"'^event|''^constraint|''^let|''^binding|''^dimension'\"' docs/design/spec/core-0.lark && sed -n '70,91p' scripts/core0_ir_v1.py\"","aggregated_output":"class _IRTypeChecker:\n    def __init__(self, ir: Mapping[str, Any], nodes: Mapping[str, tuple[str, Mapping[str, Any]]]):\n        self.ir, self.nodes = ir, nodes\n        self.memo: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.active: set[str] = set()\n\n    def expr(self, identifier: str) -> tuple[str, Optional[str], Any]:\n        if identifier in self.memo:\n            return self.memo[identifier]\n        if identifier in self.active:\n            raise _Failure(Diagnostic(\"ExpressionCycle\", \"cyclic expression dependency\", identifier))\n        if identifier not in self.nodes or self.nodes[identifier][0] != \"expressions\":\n            raise _Failure(Diagnostic(\"UnknownReference\", f\"expression {identifier!r} is not declared\", identifier))\n        self.active.add(identifier)\n        e = self.nodes[identifier][1]\n        op, target = e[\"op\"], e[\"target\"]\n        args = [self.expr(a) for a in e[\"args\"]]\n        types = [a[0] for a in args]\n        contexts = [a[1] for a in args]\n        context = next((c for c in contexts if c is not None), None)\n        if any(c is not None and context is not None and c != context for c in contexts):\n            raise _Failure(Diagnostic(\"ContextMismatch\", \"expression operands use incompatible contexts\", identifier))\n        if op == \"literal\":\n            if e[\"args\"] or e[\"target\"] is not None or e[\"field_names\"]:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"literal cannot have operands, target or fields\", identifier))\n            if (e[\"rational\"] is None) == (e[\"text\"] is None):\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"literal requires exactly one payload\", identifier))\n            if e[\"rational\"] is not None:\n                value = parse_rational(e[\"rational\"])\n                if not _numeric_type(e[\"type\"]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"rational literal must have a numeric type\", identifier))\n                if e[\"type\"] == \"Int\" and value.denominator != 1:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"fractional integer literal\", identifier))\n            elif e[\"text\"] is not None:\n                value = e[\"text\"]\n                if e[\"type\"] == \"Bool\" and value not in {\"true\", \"false\"}:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"Boolean text literal must be true or false\", identifier))\n                if e[\"type\"] == \"Date\":\n                    _iso(value, identifier)\n                if e[\"type\"] == \"SourceRef\":\n                    # SourceRef text is checked below against supplied report\n                    # bindings; here it must at least be a nonempty string.\n                    if not value:\n                        raise _Failure(Diagnostic(\"ExpressionPayload\", \"SourceRef cannot be empty\", identifier))\n                if e[\"type\"] not in {\"String\", \"Bool\", \"Date\", \"SourceRef\"}:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"text literal has unsupported type\", identifier))\n            result, context = e[\"type\"], e[\"context\"]\n        elif op == \"ref\":\n            if e[\"args\"] or e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"] or target is None:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"reference has an invalid payload\", identifier))\n            if target not in self.nodes:\n                raise _Failure(Diagnostic(\"UnknownReference\", f\"reference {target!r} is not declared\", identifier))\n            section, row = self.nodes[target]\n            if section == \"expressions\":\n                result, context, value = self.expr(target)\n            elif section == \"symbols\":\n                result, context, value = row[\"type\"], row[\"context\"], None\n            elif section == \"observations\":\n                ctx = self.nodes[row[\"context\"]][1]\n                result, context, value = f\"Observation<Money<{ctx['currency']}>>\", row[\"context\"], None\n            else:\n                raise _Failure(Diagnostic(\"ReferenceKind\", f\"cannot reference {section} from expression\", identifier))\n            value = None\n        elif op == \"call\":\n            if e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"] or target is None:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"call has an invalid payload\", identifier))\n            if target == \"builtin:value@1\":\n                if len(args) != 1 or not types or not types[0].startswith(\"Observation<\"):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"value requires one observation\", identifier))\n                result, context = types[0][12:-1], args[0][1]\n                value = args[0][2]\n            elif target == \"builtin:constant@1\":\n                if len(args) != 1 or not types or types[0] != \"Rate<annual_simple>\":\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"constant requires one annual rate\", identifier))\n                result, context, value = f\"Driver<{types[0]}>\", args[0][1], args[0][2]\n            else:\n                raise _Failure(Diagnostic(\"UnsupportedExpression\", \"unknown builtin call\", identifier))\n        else:\n            if target is not None or e[\"rational\"] is not None or e[\"text\"] is not None or e[\"field_names\"]:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"operator has an invalid payload\", identifier))\n            arity = 1 if op in {\"negate\", \"not\"} else 2\n            if len(args) != arity:\n                raise _Failure(Diagnostic(\"ArityMismatch\", \"wrong expression arity\", identifier))\n            if op in {\"not\", \"and\", \"or\"}:\n                if any(t != \"Bool\" for t in types):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"Boolean operands required\", identifier))\n                result, context = \"Bool\", None\n                value = None\n            elif op in {\"eq\", \"ne\", \"lt\", \"le\", \"gt\", \"ge\"}:\n                if types[0] != types[1]:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"comparison types differ\", identifier))\n                if op not in {\"eq\", \"ne\"} and not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"ordering requires numeric operands\", identifier))\n                result, context, value = \"Bool\", None, None\n            elif op in {\"add\", \"subtract\"}:\n                if types[0] != types[1] or not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"compatible numeric operands required\", identifier))\n                result, context, value = types[0], context, None\n            elif op == \"negate\":\n                if not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"numeric operand required\", identifier))\n                result, context, value = types[0], args[0][1], None\n            elif op in {\"multiply\", \"divide\"}:\n                if not _numeric_type(types[0]) or not _numeric_type(types[1]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"numeric operands required\", identifier))\n                if op == \"divide\" and not _is_scalar(types[1]):\n                    raise _Failure(Diagnostic(\"UnsupportedOperation\", \"divisor must be scalar\", identifier))\n                if op == \"divide\" and not isinstance(args[1][2], Fraction):\n                    raise _Failure(Diagnostic(\"UnprovedNonzeroDenominator\", \"divisor must be constant\", identifier))\n                if op == \"divide\" and args[1][2] == 0:\n                    raise _Failure(Diagnostic(\"UnprovedNonzeroDenominator\", \"divisor is zero\", identifier))\n                if op == \"multiply\":\n                    if _is_scalar(types[0]) and not _is_scalar(types[1]):\n                        result = types[1]\n                    elif _is_scalar(types[1]) and not _is_scalar(types[0]):\n                        result = types[0]\n                    elif _is_scalar(types[0]) and _is_scalar(types[1]):\n                        result = \"Int\" if types[0] == types[1] == \"Int\" else \"Real\"\n                    else:\n                        raise _Failure(Diagnostic(\"UnsupportedOperation\", \"product of two dimensional quantities is unsupported\", identifier))\n                else:\n                    result = types[0] if not _is_scalar(types[0]) else \"Real\"\n                context, value = context, None\n            else:\n                raise _Failure(Diagnostic(\"UnsupportedExpression\", f\"operator {op!r} unsupported\", identifier))\n        declared = (e[\"type\"], e[\"context\"])\n        if declared != (result, context):\n            raise _Failure(Diagnostic(\"TypeMismatch\", f\"declared {declared}, inferred {(result, context)}\", identifier))\n        self.active.remove(identifier)\n        self.memo[identifier] = (result, context, value)\n        return self.memo[identifier]\n\n\n17:binding: \"let\" NAME [\":\" type] \"=\" expr \";\"\n18:constraint: \"constraint\" NAME \":\" expr \";\"\n23:event: \"event\" NAME \"(\" [parameters] \")\" \"book\" NAME \";\"\n\n\n@dataclass(frozen=True)\nclass CompileResult:\n    ir: Optional[dict[str, Any]]\n    diagnostics: tuple[Diagnostic, ...] = ()\n    source_map: Mapping[str, Mapping[str, Any]] = field(default_factory=dict)\n    input_sha256: Optional[str] = None\n    binding_records: Mapping[str, Any] = field(default_factory=dict)\n\n    @property\n    def ok(self) -> bool:\n        return self.ir is not None and not self.diagnostics\n\n    @property\n    def semantic_projection(self) -> Optional[dict[str, Any]]:\n        return {\"ir\": semantic_projection(self.ir), \"bindings\": dict(self.binding_records)} if self.ir is not None else None\n\n\n@dataclass(frozen=True)\nclass ValidationResult:\n    valid: bool\n","exit_code":0,"status":"completed"}}
