\"ge\",\n           \"and\": \"and\", \"or\": \"or\"}\n\n\ndef evaluate_expression(ir: Mapping[str, Any], identifier: str,\n                        symbols: Mapping[str, Fraction | int | str] | None = None) -> Any:\n    \"\"\"Evaluate exact supported expressions for a supplied symbol assignment.\"\"\"\n    nodes = {e[\"id\"]: e for e in ir.get(\"expressions\", [])}\n    symbol_values = {k: _fraction(v) for k, v in (symbols or {}).items()}\n    observations = {o[\"id\"]: o for o in ir.get(\"observations\", [])}\n    contexts = {c[\"id\"]: c for c in ir.get(\"contexts\", [])}\n    seen: set[str] = set()\n\n    def go(eid: str) -> Any:\n        if eid in seen:\n            raise ValueError(f\"expression cycle at {eid}\")\n        if eid not in nodes:\n            raise KeyError(eid)\n        e = nodes[eid]; op = e[\"op\"]\n        if op == \"literal\":\n            if e[\"rational\"] is not None:\n                return parse_rational(e[\"rational\"])\n            if e[\"type\"] == \"Bool\":\n                return e[\"text\"] == \"true\"\n            return e[\"text\"]\n        seen.add(eid)\n        try:\n            if op == \"ref\":\n                target = e[\"target\"]\n                if target in nodes:\n                    return go(target)\n                if target in symbol_values:\n                    return symbol_values[target]\n                if target in observations:\n                    return parse_rational(observations[target][\"domain\"][\"lower\"])\n                return _Symbolic(target)\n            if op == \"call\":\n                value = go(e[\"args\"][0])\n                return value\n            args = [go(a) for a in e[\"args\"]]\n            if any(isinstance(a, _Symbolic) for a in args):\n                return _Symbolic(eid)\n            if op == \"add\": return args[0] + args[1]\n            if op == \"subtract\": return args[0] - args[1]\n            if op == \"multiply\": return args[0] * args[1]\n            if op == \"divide\": return args[0] / args[1]\n            if op == \"negate\": return -args[0]\n            if op == \"not\": return not args[0]\n            if op == \"and\": return args[0] and args[1]\n            if op == \"or\": return args[0] or args[1]\n            return {\"eq\": args[0] == args[1], \"ne\": args[0] != args[1], \"lt\": args[0] < args[1],\n                    \"le\": args[0] <= args[1], \"gt\": args[0] > args[1], \"ge\": args[0] >= args[1]}[op]\n        finally:\n            seen.remove(eid)\n    return go(identifier)\n\n\n","exit_code":0,"status":"completed"}}
