se _diag(\"UnsupportedUncertainty\", \"Core0.1 admits only HistoricalFact symbols\", \"bindings.symbol_uncertainty\")\n\n    package_root = ROOT.resolve()\n    for package in bindings.packages:\n        if package.name != \"DemoDebt\" or package.version != \"1\":\n            raise _diag(\"UnsupportedPackage\", \"Core0.1 requires DemoDebt@1\", package.id)\n        if not re.fullmatch(r\"[0-9a-f]{64}\", package.digest):\n            raise _diag(\"InvalidPackageDigest\", \"package digest must be a SHA-256 hex digest\", package.id)\n        try:\n            start = date.fromisoformat(package.effective_start)\n            end = date.fromisoformat(package.effective_end)\n        except ValueError as exc:\n            raise _diag(\"InvalidDate\", \"package applicability dates must be YYYY-MM-DD\", package.id) from exc\n            field_rows.append({\"name\": name, \"expression\": info[0]})\n        self.ir[\"contracts\"].append({\"id\": contract.name, \"type\": f\"{package.id}/{contract.type_name}\",\n                                      \"book\": contract.book, \"fields\": field_rows, \"package\": package.id,\n                                      \"source_refs\": [evidence[next(iter(source_keys.values()))][1]]})\n        alt_ids = []\n        constraint_ids = []\n        for alt in self.alternatives.values():\n            meta = self.bindings.alternative(alt.name)\n            alt_ids.append(alt.name)\n            alt_constraints = []\n            for index, assumption in enumerate(alt.assumptions):\n                eid = self.lower_expr(assumption, f\"alternative:{alt.name}\", f\"assumption:{index}\")[0]\n                cid = f\"constraint:{_clean_id(alt.name)}:{index}\"\n                self.ir[\"constraints\"].append({\"id\": cid, \"expression\": eid, \"kind\": \"assumption\",\n                                                \"scope\": alt.name, \"source_refs\": []})\n                alt_constraints.append(cid)\n                self._assumption_row(f\"alternative