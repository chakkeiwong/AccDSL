{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1753,1845p' scripts/core0_ir_v1.py && sed -n '189,221p' scripts/core0_frontends_v1.py && cat docs/design/fixtures/borrowing.acc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1753,1845p' scripts/core0_ir_v1.py && sed -n '189,221p' scripts/core0_frontends_v1.py && cat docs/design/fixtures/borrowing.acc\"","aggregated_output":"def validate_ir(ir: Mapping[str, Any], bindings: CompileBindings,\n                *, schema: Optional[Mapping[str, Any]] = None) -> ValidationResult:\n    \"\"\"Validate closed-schema shape and independent Core0.1 semantics.\"\"\"\n    if not isinstance(ir, Mapping):\n        return ValidationResult(False, (_invalid(\"StructuralError\", \"IR must be a mapping\", \"ir\"),))\n    try:\n        _validate_bindings(bindings)\n    except _Failure as exc:\n        return ValidationResult(False, (exc.diagnostic,))\n    schema = schema or _load_schema()\n    if jsonschema is None:\n        return ValidationResult(False, (_invalid(\"MissingDependency\", \"jsonschema is required for closed-schema validation\", \"validator\"),))\n    try:\n        jsonschema.Draft202012Validator(schema).validate(ir)\n    except jsonschema.ValidationError as exc:\n        return ValidationResult(False, (_invalid(\"StructuralError\", exc.message, \"/\".join(map(str, exc.path))),))\n    nodes, duplicate = _nodes(ir)\n    if duplicate:\n        return ValidationResult(False, (duplicate,))\n    try:\n        packages = {p.id: p for p in bindings.packages}\n        package_rows = {r[\"id\"]: r for r in ir[\"packages\"]}\n        if set(package_rows) != set(packages):\n            raise _Failure(Diagnostic(\"PackageBinding\", \"IR package lock differs from supplied package bindings\", \"packages\"))\n        for pid, package in packages.items():\n            row = package_rows[pid]\n            if (row[\"version\"] != package.version or row[\"digest\"] != package.digest or\n                    row[\"basis\"] != package.basis or row[\"dependencies\"] != list(package.dependencies) or\n                    row[\"authority\"] != list(package.authority) or row[\"review_status\"] != package.review_status or\n                    row[\"implementation\"] != package.implementation):\n                raise _Failure(Diagnostic(\"PackageDigestMismatch\", \"package digest/basis differs from binding\", pid))\n            if row[\"operations\"] != [f\"{pid}/{x}\" for x in package.operations]:\n                raise _Failure(Diagnostic(\"PackageBinding\", \"package operation lock differs from binding\", pid))\n            effective = row[\"effective\"]\n            if effective[\"calendar\"] != bindings.calendar_id or effective[\"start\"] != package.effective_start or effective[\"end_exclusive\"] != package.effective_end:\n                raise _Failure(Diagnostic(\"PackageValidity\", \"package applicability differs from binding\", pid))\n            if date.fromisoformat(effective[\"start\"]) >= date.fromisoformat(bindings.horizon_end) or date.fromisoformat(effective[\"end_exclusive\"]) <= date.fromisoformat(bindings.horizon_start):\n                raise _Failure(Diagnostic(\"PackageValidity\", \"package does not cover the requested horizon\", pid))\n        entities = {r[\"id\"]: r for r in ir[\"entities\"]}\n        books = {r[\"id\"]: r for r in ir[\"books\"]}\n        if len(entities) != 1 or len(books) != 1:\n            raise _Failure(Diagnostic(\"ProfileCardinality\", \"one entity and book are required\", \"profile\"))\n        for row in ir[\"contexts\"]:\n            if (err := _ref(nodes, row[\"entity\"], {\"entities\"}, row[\"id\"])):\n                raise _Failure(err)\n            if row[\"basis\"] != next(iter(packages)) or row[\"currency\"] != row[\"unit\"] or row[\"currency\"] != entities[row[\"entity\"]][\"functional_currency\"]:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"context basis, unit and currency disagree\", row[\"id\"]))\n            _time(\"instant\" if row[\"time\"][\"kind\"] == \"instant\" else \"interval\", row[\"time\"][\"start\"], row[\"time\"][\"end_exclusive\"], row[\"time\"][\"calendar\"])\n            if row[\"time\"][\"calendar\"] != bindings.calendar_id or row[\"perimeter\"] != bindings.entity_perimeter:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"context calendar or perimeter differs from bindings\", row[\"id\"]))\n        for row in ir[\"sourceSpans\"]:\n            if (err := _ref(nodes, row[\"document\"], {\"documents\"}, row[\"id\"])):\n                raise _Failure(err)\n        for row in ir[\"documents\"]:\n            _instant(row[\"available\"], row[\"id\"]); _instant(row[\"ingested\"], row[\"id\"])\n        reviews = {r[\"id\"]: r for r in ir[\"reviewDecisions\"]}\n        views = {r[\"id\"]: r for r in ir[\"evidenceViews\"]}\n        spans = {r[\"id\"]: r for r in ir[\"sourceSpans\"]}\n        documents = {r[\"id\"]: r for r in ir[\"documents\"]}\n        observations = {r[\"id\"]: r for r in ir[\"observations\"]}\n        for row in ir[\"reviewDecisions\"]:\n            if row[\"action\"] not in {\"Accept\", \"AcceptAlternative\", \"Propose\", \"Reject\", \"Supersede\"}:\n                raise _Failure(Diagnostic(\"ReviewAction\", \"unsupported review action\", row[\"id\"]))\n            if not row[\"reviewer\"] or not row[\"reason\"] or not row[\"evidence\"]:\n                raise _Failure(Diagnostic(\"IncompleteReview\", \"review decisions require reviewer, reason and evidence\", row[\"id\"]))\n            for sid in row[\"evidence\"]:\n                if sid not in spans:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"review evidence span is unknown\", row[\"id\"]))\n            for rid in row[\"reading_ids\"]:\n                if not rid.startswith(\"reading:\"):\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"review reading id is malformed\", row[\"id\"]))\n        for row in ir[\"evidenceViews\"]:\n            _instant(row[\"cutoff\"], row[\"id\"])\n            if row[\"system_as_of\"] is not None:\n                _instant(row[\"system_as_of\"], row[\"id\"])\n            for did in row[\"documents\"]:\n                if did not in documents:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence document is unknown\", row[\"id\"]))\n            for sid in row[\"decisions\"]:\n                if sid not in reviews:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence decision is unknown\", row[\"id\"]))\n            for oid in row[\"observations\"]:\n                if oid not in observations:\n                    raise _Failure(Diagnostic(\"UnknownReference\", \"evidence observation is unknown\", row[\"id\"]))\n        for row in ir[\"observations\"]:\n            if (err := _ref(nodes, row[\"context\"], {\"contexts\"}, row[\"id\"])):\n                raise _Failure(err)\n            for rid in row[\"source_spans\"]:\n                if (err := _ref(nodes, rid, {\"sourceSpans\"}, row[\"id\"])):\n                    raise _Failure(err)\n            reading_key = next((r.key for r in bindings.readings if f\"reading:{_clean_id(r.key)}\" == row[\"reading\"]), None)\n            if reading_key is None:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"observation reading is not bound\", row[\"id\"]))\ndef parse_program(source: str) -> FrontendProgram:\n    parser = Lark(GRAMMAR_PATH.read_text(encoding=\"utf-8\"), parser=\"lalr\",\n                  propagate_positions=True, maybe_placeholders=False)\n    tree = _node(parser.parse(source))\n    if not isinstance(tree, _Node) or tree.data != \"start\" or len(tree.children) < 2:\n        raise ValueError(\"module header is required\")\n    module, version = _text(tree.children[0]), _strip_string(_text(tree.children[1]), \"module version\")\n    spans: dict[int, dict[str, Any]] = {}\n    declarations: list[Any] = []\n    uses: list[UseDecl] = []\n    unsupported = {\"choice\", \"event\", \"rule\", \"require\", \"post\", \"setting\", \"parameters\"}\n    for item in tree.children[2:]:\n        if not isinstance(item, _Node):\n            raise ValueError(\"unexpected module token\")\n        d, c = item.data, item.children\n        try:\n            if d == \"use\":\n                uses.append(UseDecl(_text(c[0]), _strip_string(_text(c[1]), \"use version\")))\n            elif d == \"source\":\n                value = _expr(c[1], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"source requires external(string)\")\n                declarations.append(SourceDecl(_text(c[0]), value.key))\n            elif d == \"entity\":\n                declarations.append(EntityDecl(_text(c[0]), _text(c[1])))\n            elif d == \"book\":\n                declarations.append(BookDecl(_text(c[0]), _text(c[1]), _text(c[2]), _strip_string(_text(c[3]), \"book version\")))\n            elif d == \"account\":\n                declarations.append(AccountDecl(_text(c[0]), _text(c[1]), _text(c[2])))\n            elif d == \"opening\":\n                value = _expr(c[2], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"opening requires external(string)\")\nmodule BorrowingExample version \"1\";\nuse DemoDebt version \"1\";\nsource note7 = external(\"synthetic-note-7\");\nentity Acme functional USD;\nbook Local entity Acme basis DemoDebt version \"1\";\naccount Cash : Asset book Local;\naccount Debt : Liability book Local;\naccount InterestExpense : Expense book Local;\naccount Retained : Equity book Local;\nopening after2025 for Local from external(\"after-2025-close\");\nobservation debt : Money<USD> instant @2025-12-31 = 100 USD from note7;\nsymbol alpha : Real in [0, 1] because \"Fixed-rate proportion not disclosed\";\ncontract loans : DebtMix book Local {\n  principal = value(debt);\n  fixed_fraction = alpha;\n  fixed_rate = 0.05 per year;\n  initial_floating_rate = 0.05 per year;\n}\nalternative allFixed { assume alpha == 1; }\nalternative allFloating { assume alpha == 0; }\nscenario rateShock { set market_rate = constant(0.07 per year); }\nreport statements for Local { mapping = external(\"DemoDebt.statements.v1\"); }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '435,540p' scripts/core0_ir_v1.py && sed -n '1564,1584p' scripts/core0_ir_v1.py && sed -n '1990,2014p' scripts/core0_ir_v1.py && sed -n '2073,2091p' scripts/core0_ir_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '435,540p' scripts/core0_ir_v1.py && sed -n '1564,1584p' scripts/core0_ir_v1.py && sed -n '1990,2014p' scripts/core0_ir_v1.py && sed -n '2073,2091p' scripts/core0_ir_v1.py\"","aggregated_output":"\n@dataclass(frozen=True)\nclass OpeningBinding:\n    key: str\n    date: str\n    balances: tuple[tuple[str, Fraction | int | str], ...]\n    book: Optional[str] = None\n    contracts: tuple[str, ...] = ()\n    dependencies: tuple[str, ...] = ()\n\n    def __init__(self, key: str, date: str,\n                 balances: Mapping[str, Fraction | int | str] | Sequence[tuple[str, Fraction | int | str]],\n                 book: Optional[str] = None, contracts: Sequence[str] = (),\n                 dependencies: Sequence[str] = ()):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"date\", date)\n        object.__setattr__(self, \"balances\", tuple((k, _fraction(v)) for k, v in _pairs(balances)))\n        object.__setattr__(self, \"book\", book)\n        object.__setattr__(self, \"contracts\", tuple(contracts))\n        object.__setattr__(self, \"dependencies\", tuple(dependencies))\n\n\n@dataclass(frozen=True)\nclass ReportBinding:\n    key: str\n    mapping: str\n    cash_flow_policy: str\n    closing_policy: str\n    required_operations: tuple[str, ...]\n\n    def __init__(self, key: str, mapping: str, cash_flow_policy: str,\n                 closing_policy: str, required_operations: Sequence[str]):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"mapping\", mapping)\n        object.__setattr__(self, \"cash_flow_policy\", cash_flow_policy)\n        object.__setattr__(self, \"closing_policy\", closing_policy)\n        object.__setattr__(self, \"required_operations\", tuple(required_operations))\n\n\n@dataclass(frozen=True)\nclass PackageBinding:\n    name: str\n    version: str\n    digest: str\n    basis: str\n    effective_start: str\n    effective_end: str\n    operations: tuple[str, ...]\n    dependencies: tuple[str, ...]\n    authority: tuple[str, ...]\n    review_status: str = \"illustrative\"\n    implementation: Optional[str] = None\n    contract_types: tuple[str, ...] = (\"DebtMix\",)\n    artifact: str = \"docs/design/fixtures/demo-debt-package.json\"\n\n    @property\n    def id(self) -> str:\n        return f\"{self.name}@{self.version}\"\n\n    def __init__(self, name: str, version: str, digest: str, basis: str,\n                 effective_start: str, effective_end: str,\n                 operations: Sequence[str], dependencies: Sequence[str],\n                 authority: Sequence[str], review_status: str = \"illustrative\",\n                 implementation: Optional[str] = None,\n                 contract_types: Sequence[str] = (\"DebtMix\",),\n                 artifact: str = \"docs/design/fixtures/demo-debt-package.json\"):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"version\", version)\n        object.__setattr__(self, \"digest\", digest)\n        object.__setattr__(self, \"basis\", basis)\n        object.__setattr__(self, \"effective_start\", effective_start)\n        object.__setattr__(self, \"effective_end\", effective_end)\n        object.__setattr__(self, \"operations\", tuple(operations))\n        object.__setattr__(self, \"dependencies\", tuple(dependencies))\n        object.__setattr__(self, \"authority\", tuple(authority))\n        object.__setattr__(self, \"review_status\", review_status)\n        object.__setattr__(self, \"implementation\", implementation)\n        object.__setattr__(self, \"contract_types\", tuple(contract_types))\n        object.__setattr__(self, \"artifact\", artifact)\n\n\n@dataclass(frozen=True)\nclass AssumptionBinding:\n    key: str\n    rationale: str\n    provenance: str = \"ScenarioDesign\"\n    role: str = \"Hypothesis\"\n    source_refs: tuple[str, ...] = ()\n    information_cutoff: Optional[str] = None\n    valid_start: Optional[str] = None\n    valid_end: Optional[str] = None\n\n    def __init__(self, key: str, rationale: str, provenance: str = \"ScenarioDesign\",\n                 role: str = \"Hypothesis\", source_refs: Sequence[str] = (),\n                 information_cutoff: Optional[str] = None,\n                 valid_start: Optional[str] = None, valid_end: Optional[str] = None):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"rationale\", rationale)\n        object.__setattr__(self, \"provenance\", provenance)\n        object.__setattr__(self, \"role\", role)\n        object.__setattr__(self, \"source_refs\", tuple(source_refs))\n        object.__setattr__(self, \"information_cutoff\", information_cutoff)\n        object.__setattr__(self, \"valid_start\", valid_start)\n        object.__setattr__(self, \"valid_end\", valid_end)\n\n\ndef compile_program(program: Program, bindings: CompileBindings,\n                    *, source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,\n                    input_text: Optional[str] = None) -> CompileResult:\n    \"\"\"Lower a typed ``Program`` through the shared Core0.1 stages.\"\"\"\n    if not isinstance(program, Program):\n        raise TypeError(\"compile_program requires a Program constructed from typed declarations\")\n    input_sha256 = hashlib.sha256(input_text.encode(\"utf-8\")).hexdigest() if input_text is not None else None\n    try:\n        result = _Compiler(program, bindings, source_spans, input_text).build()\n        if input_sha256 is None:\n            input_sha256 = hashlib.sha256(json.dumps(binding_projection(program), sort_keys=True).encode()).hexdigest()\n        return CompileResult(result.ir, result.diagnostics, result.source_map, input_sha256, binding_projection(bindings))\n    except _Failure as exc:\n        return CompileResult(None, (exc.diagnostic,), MappingProxyType({}),\n                             input_sha256)\n\n\n# ---------------------------------------------------------------------------\n# IR validation and exact evaluation\n\n\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family evidence/opening references are unknown\", row[\"id\"]))\n        for row in ir[\"scenarios\"]:\n            for driver in row[\"drivers\"]:\n                info = checker.expr(driver[\"expression\"])\n                if info[0] != \"Driver<Rate<annual_simple>>\":\n                    raise _Failure(Diagnostic(\"ScenarioType\", \"scenario driver must be a constant annual rate\", row[\"id\"]))\n        for row in ir[\"reportMappings\"]:\n            if not row[\"rows\"] or row[\"rows\"][0][\"expression\"] not in checker.memo:\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping expression is not compiled\", row[\"id\"]))\n            rb = next((r for r in bindings.reports if r.key == row[\"id\"] or r.mapping == row[\"rows\"][0].get(\"value\")), None)\n            if row[\"book\"] not in books or row[\"basis\"] not in package_rows or not row[\"required_operations\"]:\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping book/package/operations are incomplete\", row[\"id\"]))\n            if rb is None:\n                # The generated mapping uses a SourceRef literal; compare the\n                # text payload directly when an explicit row binding exists.\n                expr = next((e for e in ir[\"expressions\"] if e[\"id\"] == row[\"rows\"][0][\"expression\"]), None)\n                if expr is None or expr[\"type\"] != \"SourceRef\" or expr[\"text\"] not in {r.mapping for r in bindings.reports}:\n                    raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping is not bound to an explicit export\", row[\"id\"]))\n        if not ir[\"diagnostics\"]:\n            pass\n    except _Failure as exc:\n        return ValidationResult(False, (exc.diagnostic,))\n    return ValidationResult(True, ())\n\n\ndef semantic_projection(ir: Mapping[str, Any] | None) -> Optional[dict[str, Any]]:\n    if ir is None:\n        return None\n    # Source offsets live in CompileResult.source_map.  IR itself retains\n    # source context, package locks, assumptions, alternatives and bindings.\n    projected = copy.deepcopy(dict(ir))\n    projected.pop(\"diagnostics\", None)\n    return projected\n\n\n__all__ = [\n    \"AccountDecl\", \"AlternativeDecl\", \"ArrayExpr\", \"AssumptionBinding\", \"Binary\", \"BookDecl\",\n    \"Call\", \"CompileBindings\", \"CompileResult\", \"ConstraintDecl\", \"ContractDecl\", \"Diagnostic\",\n    \"EntityDecl\", \"Expr\", \"External\", \"LetDecl\", \"Literal\", \"OpeningBinding\", \"OpeningDecl\",\n    \"ObservationDecl\", \"PackageBinding\", \"Program\", \"RecordExpr\", \"Ref\", \"ReportBinding\",\n    \"ReportDecl\", \"ScenarioDecl\", \"SourceDecl\", \"SymbolDecl\", \"Unary\", \"UnsupportedDecl\", \"UseDecl\",\n    \"ValidationResult\", \"compile_program\", \"evaluate_expression\", \"rational\", \"semantic_projection\",\n    \"validate_ir\",\n]\n","exit_code":0,"status":"completed"}}
