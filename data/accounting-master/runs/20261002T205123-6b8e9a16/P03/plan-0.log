{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat docs/design/fixtures/p03-lowering-cases-v1.json && sed -n '1,100p' scripts/core0_frontends_v1.py && sed -n '180,306p' scripts/core0_frontends_v1.py\"","aggregated_output":"{\n  \"schema_version\": \"accdsl.p03.lowering-cases.v1\",\n  \"profile\": \"Core0.1 debt-lowering\",\n  \"source_cases\": [\n    {\"id\": \"borrowing_baseline\", \"source\": \"docs/design/fixtures/borrowing.acc\", \"kind\": \"positive\"},\n    {\"id\": \"borrowing_crlf_comment\", \"source\": \"docs/design/fixtures/borrowing.acc\", \"kind\": \"positive\", \"transform\": \"crlf_and_comment\"},\n    {\"id\": \"borrowing_let_arithmetic\", \"source\": \"docs/design/fixtures/borrowing.acc\", \"kind\": \"positive\", \"transform\": \"let_and_compound_constraint\"},\n    {\"id\": \"borrowing_stress_09\", \"source\": \"docs/design/fixtures/borrowing.acc\", \"kind\": \"positive\", \"transform\": \"stress_09\"},\n    {\"id\": \"borrowing_principal_200\", \"source\": \"docs/design/fixtures/borrowing.acc\", \"kind\": \"positive\", \"transform\": \"principal_200\"},\n    {\"id\": \"missing_rate_unit\", \"source\": \"docs/design/fixtures/borrowing.acc\", \"kind\": \"negative\", \"transform\": \"bare_rate\"},\n    {\"id\": \"unsupported_event\", \"source\": \"docs/design/fixtures/borrowing.acc\", \"kind\": \"negative\", \"transform\": \"add_event\"},\n    {\"id\": \"reserved_identifier\", \"source\": \"docs/design/fixtures/borrowing.acc\", \"kind\": \"negative\", \"transform\": \"reserved_name\"}\n  ],\n  \"typed_cases\": [\n    {\"id\": \"typed_baseline\", \"kind\": \"positive\", \"matches\": \"borrowing_baseline\"},\n    {\"id\": \"typed_principal_200\", \"kind\": \"positive\", \"matches\": \"borrowing_principal_200\"},\n    {\"id\": \"typed_missing_rate_unit\", \"kind\": \"negative\", \"diagnostic\": \"MissingRateUnit\"}\n  ],\n  \"schema_valid_negative_cases\": [\n    {\"id\": \"package_digest\", \"diagnostic\": \"PackageDigestMismatch\"},\n    {\"id\": \"wrong_reference_kind\", \"diagnostic\": \"ReferenceKind\"},\n    {\"id\": \"unbalanced_opening\", \"diagnostic\": \"UnbalancedState\"},\n    {\"id\": \"false_family_coverage\", \"diagnostic\": \"FalseCoverage\"}\n  ],\n  \"unsupported\": [\n    \"general package loading and overrides\",\n    \"events, rules, postings, journals and runtime execution\",\n    \"records, arrays, field selection and finite choices\",\n    \"multiple books/entities/observations, other currencies and calendars\",\n    \"cross-company mappings and broader uncertainty categories\",\n    \"reconstruction, feasibility proof, accounting validity and forecast validity\"\n  ]\n}\n\"\"\"Textual Core 0.1 frontend.\n\nThe frontend retains token spelling and source positions while translating the\ngrammar into the typed constructors in :mod:`core0_ir_v1`.  It deliberately\ndoes not construct IR from a fixture or from a JSON schema.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nfrom typing import Any, Mapping, Optional\n\nfrom lark import Lark, Token, Tree, UnexpectedInput\n\ntry:  # Support both ``scripts.core0_frontends_v1`` and direct script imports.\n    from .core0_ir_v1 import (\n        AccountDecl, AlternativeDecl, ArrayExpr, Binary, BookDecl, Call, CompileBindings,\n        ConstraintDecl, ContractDecl, EntityDecl, External, Expr, LetDecl, Literal,\n        ObservationDecl, OpeningDecl, Program, RecordExpr, Ref, ReportDecl, ScenarioDecl,\n        SourceDecl, SymbolDecl, Unary, UnsupportedDecl, UseDecl, compile_program,\n    )\nexcept ImportError:  # pragma: no cover - used when scripts/ is sys.path[0].\n    from core0_ir_v1 import (\n        AccountDecl, AlternativeDecl, ArrayExpr, Binary, BookDecl, Call, CompileBindings,\n        ConstraintDecl, ContractDecl, EntityDecl, External, Expr, LetDecl, Literal,\n        ObservationDecl, OpeningDecl, Program, RecordExpr, Ref, ReportDecl, ScenarioDecl,\n        SourceDecl, SymbolDecl, Unary, UnsupportedDecl, UseDecl, compile_program,\n    )\n\n\nROOT = Path(__file__).resolve().parents[1]\nGRAMMAR_PATH = ROOT / \"docs/design/spec/core-0.lark\"\n\n\n@dataclass(frozen=True)\nclass _Node:\n    data: str\n    children: tuple[Any, ...]\n    start: int\n    end: int\n\n\n@dataclass(frozen=True)\nclass FrontendProgram:\n    program: Program\n    source_spans: Mapping[int, Mapping[str, Any]]\n\n\ndef _node(value: Any) -> Any:\n    if isinstance(value, Tree):\n        meta = value.meta\n        return _Node(value.data, tuple(_node(c) for c in value.children),\n                     int(getattr(meta, \"start_pos\", 0)), int(getattr(meta, \"end_pos\", 0)))\n    return value\n\n\ndef _text(value: Any) -> str:\n    return str(value)\n\n\ndef _strip_string(value: str, where: str) -> str:\n    try:\n        parsed = json.loads(value)\n    except (TypeError, json.JSONDecodeError) as exc:\n        raise ValueError(f\"invalid JSON string at {where}\") from exc\n    if not isinstance(parsed, str):\n        raise ValueError(f\"expected a string at {where}\")\n    return parsed\n\n\ndef _type(node: Any) -> str:\n    if not isinstance(node, _Node) or node.data != \"type\":\n        raise ValueError(\"expected type node\")\n    if not node.children:\n        raise ValueError(\"empty type\")\n    name = _text(node.children[0])\n    if len(node.children) == 1:\n        return name\n    return f\"{name}<{','.join(_type(c) for c in node.children[1:])}>\"\n\n\ndef _mark(expr: Expr, node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\n    spans[id(expr)] = {\"start\": node.start, \"end\": node.end,\n                       \"text\": source[node.start:node.end]}\n    return expr\n\n\ndef _operator_fold(node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\n    if not node.children:\n        raise ValueError(f\"empty {node.data}\")\n    current = _expr(node.children[0], source, spans)\n    i = 1\n    while i < len(node.children):\n        op = _text(node.children[i])\n        right = _expr(node.children[i + 1], source, spans)\n        current = _mark(Binary(op, current, right), node, source, spans)\ndef _domain(node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> tuple[Expr, Expr] | None:\n    if node.data != \"domain\" or len(node.children) != 2:\n        return None\n    raw = source[node.start:node.end].lstrip()\n    if not raw.startswith(\"[\"):\n        return None  # finite choices are outside Core0.1\n    return (_expr(node.children[0], source, spans), _expr(node.children[1], source, spans))\n\n\ndef parse_program(source: str) -> FrontendProgram:\n    parser = Lark(GRAMMAR_PATH.read_text(encoding=\"utf-8\"), parser=\"lalr\",\n                  propagate_positions=True, maybe_placeholders=False)\n    tree = _node(parser.parse(source))\n    if not isinstance(tree, _Node) or tree.data != \"start\" or len(tree.children) < 2:\n        raise ValueError(\"module header is required\")\n    module, version = _text(tree.children[0]), _strip_string(_text(tree.children[1]), \"module version\")\n    spans: dict[int, dict[str, Any]] = {}\n    declarations: list[Any] = []\n    uses: list[UseDecl] = []\n    unsupported = {\"choice\", \"event\", \"rule\", \"require\", \"post\", \"setting\", \"parameters\"}\n    for item in tree.children[2:]:\n        if not isinstance(item, _Node):\n            raise ValueError(\"unexpected module token\")\n        d, c = item.data, item.children\n        try:\n            if d == \"use\":\n                uses.append(UseDecl(_text(c[0]), _strip_string(_text(c[1]), \"use version\")))\n            elif d == \"source\":\n                value = _expr(c[1], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"source requires external(string)\")\n                declarations.append(SourceDecl(_text(c[0]), value.key))\n            elif d == \"entity\":\n                declarations.append(EntityDecl(_text(c[0]), _text(c[1])))\n            elif d == \"book\":\n                declarations.append(BookDecl(_text(c[0]), _text(c[1]), _text(c[2]), _strip_string(_text(c[3]), \"book version\")))\n            elif d == \"account\":\n                declarations.append(AccountDecl(_text(c[0]), _text(c[1]), _text(c[2])))\n            elif d == \"opening\":\n                value = _expr(c[2], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"opening requires external(string)\")\n                declarations.append(OpeningDecl(_text(c[0]), _text(c[1]), value.key))\n            elif d == \"observation\":\n                typ = _type(c[1])\n                ts = c[2]\n                if not isinstance(ts, _Node) or ts.data != \"time_spec\":\n                    raise ValueError(\"observation time is required\")\n                if len(ts.children) == 1:\n                    instant = _text(ts.children[0]).lstrip(\"@\")\n                else:\n                    raise ValueError(\"period observations are outside Core0.1\")\n                value = _expr(c[3], source, spans)\n                declarations.append(ObservationDecl(_text(c[0]), typ, instant, value, _text(c[4])))\n            elif d == \"symbol\":\n                typ = _type(c[1]); bounds = _domain(c[2], source, spans)\n                if bounds is None:\n                    declarations.append(UnsupportedDecl(\"finite-domain\", _text(c[0])))\n                else:\n                    declarations.append(SymbolDecl(_text(c[0]), typ, bounds[0], bounds[1],\n                                                   _strip_string(_text(c[3]), \"symbol reason\")))\n            elif d == \"binding\":\n                name = _text(c[0]); idx = 1; declared = None\n                if isinstance(c[idx], _Node) and c[idx].data == \"type\":\n                    declared = _type(c[idx]); idx += 1\n                declarations.append(LetDecl(name, _expr(c[idx], source, spans), declared))\n            elif d == \"constraint\":\n                declarations.append(ConstraintDecl(_text(c[0]), _expr(c[1], source, spans)))\n            elif d == \"contract\":\n                fields = []\n                for field_node in c[3:]:\n                    if not isinstance(field_node, _Node) or field_node.data != \"field\":\n                        raise ValueError(\"invalid contract field\")\n                    fields.append((_text(field_node.children[0]), _expr(field_node.children[1], source, spans)))\n                declarations.append(ContractDecl(_text(c[0]), _text(c[1]), _text(c[2]), fields))\n            elif d == \"alternative\":\n                assumptions = []\n                for assumption in c[1:]:\n                    if not isinstance(assumption, _Node) or assumption.data != \"assumption\":\n                        raise ValueError(\"invalid alternative assumption\")\n                    assumptions.append(_expr(assumption.children[0], source, spans))\n                declarations.append(AlternativeDecl(_text(c[0]), assumptions))\n            elif d == \"scenario\":\n                settings = []\n                for setting in c[1:]:\n                    if not isinstance(setting, _Node) or setting.data != \"setting\":\n                        raise ValueError(\"invalid scenario setting\")\n                    settings.append((_text(setting.children[0]), _expr(setting.children[1], source, spans)))\n                declarations.append(ScenarioDecl(_text(c[0]), settings))\n            elif d == \"report\":\n                fields = [x for x in c[2:] if isinstance(x, _Node) and x.data == \"field\"]\n                mappings = [x for x in fields if _text(x.children[0]) == \"mapping\"]\n                if len(mappings) != 1:\n                    raise ValueError(\"report requires one mapping field\")\n                mapping = _expr(mappings[0].children[1], source, spans)\n                declarations.append(ReportDecl(_text(c[0]), _text(c[1]), mapping))\n            elif d in unsupported:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n            else:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n        except (IndexError, TypeError, ValueError) as exc:\n            raise ValueError(f\"invalid {d} declaration at {item.start}: {exc}\") from exc\n    return FrontendProgram(Program(module, version, declarations, uses), spans)\n\n\ndef compile_source(source: str, bindings: CompileBindings):\n    \"\"\"Parse and lower a source program through the shared compiler.\"\"\"\n    try:\n        parsed = parse_program(source)\n    except UnexpectedInput as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        start = getattr(exc, \"pos_in_stream\", None)\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\",\n                                               span=(start, start) if start is not None else None),), {})\n    except ValueError as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\"),), {})\n    return compile_program(parsed.program, bindings, source_spans=parsed.source_spans, input_text=source)\n\n\n__all__ = [\"FrontendProgram\", \"compile_source\", \"parse_program\"]\n","exit_code":0,"status":"completed"}}
