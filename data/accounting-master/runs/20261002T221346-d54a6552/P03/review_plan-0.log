and bounded debt static validator now pass positive and schema-valid negative cases. General compilation, package loading, remaining semantic conformance and independent implementability assessment remain open. G2, G12, G15. |\n\n\n@dataclass(frozen=True)\nclass CompileResult:\n    ir: Optional[dict[str, Any]]\n    diagnostics: tuple[Diagnostic, ...] = ()\n    source_map: Mapping[str, Mapping[str, Any]] = field(default_factory=dict)\n    input_sha256: Optional[str] = None\n    binding_records: Mapping[str, Any] = field(default_factory=dict)\n\n    @property\n    def ok(self) -> bool:\n        return self.ir is not None and not self.diagnostics\n\n    @property\n    def semantic_projection(self) -> Optional[dict[str, Any]]:\n        return {\"ir\": semantic_projection(self.ir), \"bindings\": dict(self.binding_records)} if self.ir is not None else None\n\n\n@dataclass(frozen=True)\nclass ValidationResult:\n    valid: bool\n    diagnostics: tuple[Diagnostic, ...] = ()\n\n    @property\n    def ok(self) -> bool:\n            if op == \"call\":\n                value = go(e[\"args\"][0])\n                return value\n            args = [go(a) for a in e[\"args\"]]\n            if any(isinstance(a, _Symbolic) for a in args):\n                return _Symbolic(eid)\n            if op == \"add\": return args[0] + args[1]\n            if op == \"subtract\": return args[0] - args[1]\n            if op == \"multiply\": return args[0] * args[1]\n            if op == \"divide\": return args[0] / args[1]\n            if op == \"negate\": return -args[0]\n            if op == \"not\": return not args[0]\n            if op == \"and\": return args[0] and args[1]\n            if op == \"or\": return args[0] or args[1]\n            return {\"eq\": args[0] == args[1], \"ne\": args[0] != args[1], \"lt\": args[0] < args[1],\n                    \"le\": args[0] <= args[1], \"gt\": args[0] > args[1], \"ge\": args[0] >= args[1]}[op]\n        finally:\n            seen.remove(eid)\n    return go(identifier)\n\n\ndef semantic_projection(ir: Mapping[str, Any] | None) -> Optional[dict[str, Any]]:\n    if ir is None:\n        return None\n    # Source offsets live in CompileResult.source_map.  IR itself retains\n    # source context, package locks, assumptions, alternatives and bindings.\n    projected = copy.deepcopy(dict(ir))\n    projected.pop(\"diagnostics\", None)\n    for observation in projected.get(\"observations\", []):\n        observation[\"domain\"].pop(\"display\", None)\n    return projected\n\n\n__all__ = [\n    \"AccountDecl\", \"AlternativeDecl\", \"ArrayExpr\", \"AssumptionBinding\", \"Binary\", \"BookDecl\",\n    \"Call\", \"CompileBindings\", \"CompileResult\", \"ConstraintDecl\", \"ContractDecl\", \"Diagnostic\",\ndef parse_program(source: str) -> FrontendProgram:\n    parser = Lark(GRAMMAR_PATH.read_text(encoding=\"utf-8\"), parser=\"lalr\",\n                  propagate_positions=True, maybe_placeholders=False)\n    tree = _node(parser.parse(source))\n    if not isinstance(tree, _Node) or tree.data != \"start\" or len(tree.children) < 2:\n        raise ValueError(\"module header is required\")\n    module, version = _text(tree.children[0]), _strip_string(_text(tree.children[1]), \"module version\")\n    spans: dict[int, dict[str, Any]] = {}\n    declarations: list[Any] = []\n    uses: list[UseDecl] = []\n    unsupported = {\"choice\", \"event\", \"rule\", \"require\", \"post\", \"setting\", \"parameters\"}\n    for item in tree.children[2:]:\n        if not isinstance(item, _Node):\n            raise ValueError(\"unexpected module token\")\n        d, c = item.data, item.children\n        try:\n            if d == \"use\":\n                uses.append(UseDecl(_text(c[0]), _strip_string(_text(c[1]), \"use version\")))\n            elif d == \"source\":\n                value = _expr(c[1], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"source requires external(string)\")\n                declarations.append(SourceDecl(_text(c[0]), value.key))\n            elif d == \"entity\":\n                declarations.append(EntityDecl(_text(c[0]), _text(c[1])))\n            elif d == \"book\":\n                declarations.append(BookDecl(_text(c[0]), _text(c[1]), _text(c[2]), _strip_string(_text(c[3]), \"book version\")))\n                declarations.append(ReportDecl(_text(c[0]), _text(c[1]), mapping))\n            elif d in unsupported:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n            else:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n            if d != \"use\" and declarations:\n                spans[id(declarations[-1])] = {\"start\": item.start, \"end\": item.end,\n                                               \"text\": source[item.start:item.end]}\n        except (IndexError, TypeError, ValueError) as exc:\n            raise ValueError(f\"invalid {d} declaration at {item.start}: {exc}\") from exc\n    return FrontendProgram(Program(module, version, declarations, uses), spans)\n\n\ndef compile_source(source: str, bindings: CompileBindings):\n    \"\"\"Parse and lower a source program through the shared compiler.\"\"\"\n    try:\n        parsed = parse_program(source)\n    except UnexpectedInput as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        start = getattr(exc, \"pos_in_stream\", None)\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\",\n                                               span=(start, start) if start is not None else None),), {})\n    except ValueError as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n       