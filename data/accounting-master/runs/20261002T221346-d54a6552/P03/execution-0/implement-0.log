lambda d:expression(d,'field_fixed_rate').update(type='Real'),'ContractType'),\n 'ir_context':(lambda d:d['contexts'][0].update(perimeter='Other'),'ContextMismatch'),\n 'ir_context_dimensions':(lambda d:d['contexts'][0].update(dimensions=[{'axis':'segment','member':'other'}]),'ContextMismatch'),\n 'ir_observation_date':(lambda d:d['contexts'][0]['time'].update(start='2025-12-30'),'ReadingContextMismatch'),\n 'ir_acceptance':(lambda d:d['reviewDecisions'][0].update(action='Reject'),'BindingAcceptance'),\n 'ir_cutoff':(lambda d:d['evidenceViews'][0].update(cutoff='2026-01-02T00:00:00Z'),'EvidenceCutoff'),\n 'ir_assumption':(lambda d:d['assumptions'][0].update(rationale='invented'),'AssumptionBinding'),\n 'ir_duplicate_fields':(lambda d:d['contracts'][0]['fields'].append(copy.deepcopy(d['contracts'][0]['fields'][0])),'ContractFields'),\n 'ir_fraction_domain':(lambda d:d['symbols'][0]['domain'].update(upper=ir.rational(2)),'InvalidDomain'),\n 'ir_symbolic_bounds':(lambda d:expression(d,'field_fixed_fraction').update(op='add',target=None,args=['expr:symbol_alpha:upper','expr:symbol_alpha:upper']),'ContractDomain'),\n\"\"\"Textual Core 0.1 frontend.\n\nThe frontend retains token spelling and source positions while translating the\ngrammar into the typed constructors in :mod:`core0_ir_v1`.  It deliberately\ndoes not construct IR from a fixture or from a JSON schema.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nfrom typing import Any, Mapping, Optional\n\nfrom lark import Lark, Token, Tree, UnexpectedInput\n\ntry:  # Support both ``scripts.core0_frontends_v1`` and direct script imports.\n    from .core0_ir_v1 import (\n        AccountDecl, AlternativeDecl, ArrayExpr, Binary, BookDecl, Call, CompileBindings,\n        ConstraintDecl, ContractDecl, EntityDecl, External, Expr, LetDecl, Literal,\n        ObservationDecl, OpeningDecl, Program, RecordExpr, Ref, ReportDecl, ScenarioDecl,\n        SourceDecl, SymbolDecl, Unary, UnsupportedDecl, UseDecl, compile_program,\n    )\nexcept ImportError:  # pragma: no cover - used when scripts/ is sys.path[0].\n    from core0_ir_v1 import (\n        AccountDecl, AlternativeDecl, ArrayExpr, Binary, BookDecl, Call, CompileBindings,\n        ConstraintDecl, ContractDecl, EntityDecl, External, Expr, LetDecl, Literal,\n        ObservationDecl, OpeningDecl, Program, RecordExpr, Ref, ReportDecl, ScenarioDecl,\n        SourceDecl, SymbolDecl, Unary, UnsupportedDecl, UseDecl, compile_program,\n    )\n\n\nROOT = Path(__file__).resolve().parents[1]\nGRAMMAR_PATH = ROOT / \"docs/design/spec/core-0.lark\"\n\n\n@dataclass(frozen=True)\nclass _Node:\n    data: str\n    children: tuple[Any, ...]\n    start: int\n    end: int\n\n\n@dataclass(frozen=True)\nclass FrontendProgram:\n    program: Program\n    source_spans: Mapping[int, Mapping[str, Any]]\n\n\ndef _node(value: Any) -> Any:\n    if isinstance(value, Tree):\n        meta = value.meta\n        return _Node(value.data, tuple(_node(c) for c in value.children),\n                     int(getattr(meta, \"start_pos\", 0)), int(getattr(meta, \"end_pos\", 0)))\n    return value\n\n\ndef _text(value: Any) -> str:\n    return str(value)\n\n\ndef _strip_string(value: str, where: str) -> str:\n","exit_code":0,"status":"completed"}}
