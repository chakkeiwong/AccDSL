ef test_authored_fields_and_legacy_validation(self):\n        from core_semantics import validate\n        authored=json.loads((ROOT/'docs/design/fixtures/core-ir-demo.json').read_text())\n        registry=json.loads((ROOT/'docs/design/fixtures/core-demo-registry.json').read_text())\n        schema=json.loads((ROOT/'docs/design/spec/core-ir.schema.json').read_text())\n        legacy=validate(authored,registry,schema,ROOT)\n        self.assertEqual(legacy['status'],'passed',legacy)\n        generated=compile_source(BASE,bindings()).ir\n        for name in ('entity','perimeter','concept','basis','measurement','time','unit','currency','dimensions'):\n            self.assertEqual(authored['contexts'][0][name],generated['contexts'][0][name])\n        for name in ('lower','upper','kind','lower_closed','upper_closed'):\n            self.assertEqual(authored['observations'][0]['domain'][name],generated['observations'][0]['domain'][name])\n        for name in ('closing_policy','cash_flow_policy','required_operations'):\n            self.assertEqual(authored['reportMappings'][0][name],generated['reportMappings'][0][name])\n        for alpha in (0,1):\n            for field in ('principal','fixed_fraction','fixed_rate','initial_floating_rate'):\n                values=[]\n                for doc in (authored,generated):\n                    eid=next(f['expression'] for f in doc['contracts'][0]['fields'] if f['name']==field)\n                    values.append(ir.evaluate_expression(doc,eid,{'alpha':F(alpha)}))\n                self.assertEqual(*values)\n        self.record('authored_fields_and_legacy',legacy=legacy)\n\n    def test_unicode_and_global_preservation(self):\n        left=compile_source(BASE+'\\nlet caption = \"caf\\u00e9\";',bindings())\n        right=compile_source(BASE+'\\nlet caption = \"cafe\\u0301\";',bindings())\n        self.assertTrue(left.ok); self.assertTrue(right.ok)\n        self.assertEqual(left.semantic_projection,right.semantic_projection)\n        s