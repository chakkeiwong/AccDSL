   return Diagnostic(code, message, location)\n\n\ndef _nodes(ir: Mapping[str, Any]) -> tuple[dict[str, tuple[str, Mapping[str, Any]]], Optional[Diagnostic]]:\ndef _validate_profile_integrity(ir, bindings, nodes, checker):\n    \"\"\"Reject omitted or disconnected profile semantics in schema-valid IR.\"\"\"\n    for section in (\"models\", \"modelScopes\", \"contexts\", \"documents\", \"sourceSpans\",\n                    \"observations\", \"entities\", \"books\", \"symbols\", \"contracts\",\n                    \"states\", \"scenarios\", \"evidenceViews\", \"historyFamilies\",\n                    \"reportMappings\"):\n        if len(ir[section]) != 1:\n            raise _diag(\"ProfileCardinality\", \"profile requires exactly one \" + section, section)\n    for section in (\"narratives\", \"coverageUnits\", \"mappings\", \"partitions\", \"controls\",\n                    \"choices\", \"postings\", \"events\", \"rules\", \"measurements\", \"journals\",\n                    \"informationViews\", \"probabilityModels\", \"resultCells\", \"branchResults\", \"runs\"):\n        if ir[section]:\n            raise _diag(\"UnsupportedProfile\", \"section is outside Core0.1\", section)\n    model, scope, family = ir[\"models\"][0], ir[\"modelScopes\"][0], ir[\"historyFamilies\"][0]\n    if (model[\"scope\"] != scope[\"id\"] or family[\"scope\"] != scope[\"id\"] or\n            model[\"package_lock\"] != [p.id for p in bindings.packages] or\n            model[\"language_version\"] != \"Core0.1\"):\n        raise _diag(\"ModelBinding\", \"model scope or package lock is inconsistent\", model[\"id\"])\n    declarations = model[\"declarations\"]\n    required = {r[\"id\"] for k in (\"entities\", \"books\", \"accounts\", \"states\", \"observations\",\n                \"symbols\", \"contracts\", \"alternatives\", \"scenarios\", \"reportMappings\") for r in ir[k]}\n    if (len(declarations) != len(set(declarations)) or not required.issubset(declarations)\n            or any(name not in nodes for name in declarations)):\n        raise _diag(\"ModelBinding\", \"model declarations are missing or unresolved\", model[\"id\"])\n    if (scope[\"templates\"] != [ir[\"contracts\"][0][\"type\"]] or\n            scope[\"calendars\"] != [bindings.calendar_id] or scope[\"choices\"] or\n            scope[\"obligations\"] or scope[\"exclusions\"] != [\"fees\", \"foreign_currency\", \"embedded_options\"] or\n            len(scope[\"slot_limits\"]) != 1 or scope[\"slot_limits\"][0][\"name\"] != \"debt_contracts\" or\n            checker.expr(scope[\"slot_limits\"][0][\"expression\"]) != (\"Int\", None, Fraction(1))):\n        raise _diag(\"ScopeBinding\", \"scope differs from supported debt profile\", scope[\"id\"])\n    if family[\"choices\"]:\n        raise _diag(\"UnsupportedProfile\", \"finite choices are outside Core0.1\", family[\"id\"])\n    alternatives = {r[\"id\"]: r for r in ir[\"alternatives\"]}\n    if not alternatives:\n        raise _diag(\"ProfileCardinality\", \"at least one alternative is required\", \"alternatives\")\n    expected_assumptions = []\n    for row in ir[\"constraints\"]:\n        if row[\"scope\"] not in set(alternatives) | {scope[\"id\"]} or row[\"kind\"] != \"assumption\":\n            raise _diag(\"ConstraintScope\", \"constraint has unsupported scope or kind\", row[\"id\"])\n        expected_assumptions.append((row[\"scope\"], row[\"expression\"]))\n    for alt in alternatives.values():\n        expected = {c[\"id\"] for c in ir[\"constraints\"] if c[\"scope\"] == alt[\"id\"]}\n        if set(alt[\"constraints\"]) != expected or len(alt[\"constraints\"]) != len(expected):\n            raise _diag(\"AlternativeScope\", \"branch has lost or duplicate conditions\", alt[\"id\"])\n    for row in ir[\"contracts\"]:\n        expected_assumptions.extend((row[\"id\"], f[\"expression\"]) for f in row[\"fields\"]\n                                    if f[\"name\"] in {\"fixed_rate\", \"initial_floating_rate\"})\n    for row in ir[\"scenarios\"]:\n        if (row[\"kind\"] != \"ExogenousStress\" or row[\"visibility\"] != \"announced\" or\n                row[\"probability_model\"] is not None or row[\"observed_event\"] is not None or\n                row[\"structural_model\"] is not None or row[\"replaced_equations\"] or\n                len(row[\"drivers\"]) != 1 or row[\"drivers\"][0][\"name\"] != \"market_rate\"):\n            raise _diag(\"ScenarioFields\", \"scenario differs from supported exogenous stress\", row[\"id\"])\n        expected_assumptions.append((row[\"id\"], row[\"drivers\"][0][\"expression\"]))\n    actual_assumptions = [(a[\"scope\"], a[\"expression\"]) for a in ir[\"assumptions\"]]\n    if sorted(actual_assumptions) != sorted(expected_assumptions):\n        raise _diag(\"MissingAssumption\", \"each condition and assumed rate requires its bound metadata\", \"assumptions\")\n    for row in ir[\"assumptions\"]:\n        key = (\"alternative\" if row[\"scope\"] in alternatives else\n               \"constraint\" if row[\"scope\"] == scope[\"id\"] else\n               \"contract-rate\" if row[\"scope\"] == ir[\"contracts\"][0][\"id\"] else \"scenario\")\n        meta = bindings.assumption(key)\n        if any(row[field] != getattr(meta, field) for field in\n               (\"rationale\", \"provenance\", \"role\", \"information_cutoff\")) or row[\"source_refs\"] != list(meta.source_refs):\n            raise _diag(\"AssumptionBinding\", \"assumption metadata must remain bound regardless of its identifier\", row[\"id\"])\n\n\n@dataclass(frozen=True)\nclass _Symbolic:\ndef semantic_projection(ir: Mapping[str, Any] | None) -> Optional[dict[str, Any]]:\n    if ir is None:\n        return None\n    # Source offsets live in CompileResult.source_map.  IR itself retains\n    # source context, package locks, assumptions, alternatives and bindings.\n    projected = copy.deepcopy(dict(ir))\n    projected.pop(\"diagnostics\", None)\n    for observation in projected.get(\"observations\", []):\n        observation[\"domain\"].pop(\"display\", None)\n    return projected\n\n\n__all__ = [\n    \"AccountDecl\", \"AlternativeDecl\", \"ArrayExpr\", \"AssumptionBinding\", \"Binary\", \"BookDecl\",\n    \"Call\", \"CompileBindings\", \"CompileResult\", \"ConstraintDecl\", \"ContractDecl\", \"Diagnostic\",\n    \"EntityDecl\", \"Expr\", \"External\", \"LetDecl\", \"Literal\", \"OpeningBinding\", \"OpeningDecl\",\n    \"ObservationDecl\", \"PackageBinding\", \"Program\", \"RecordExpr\", \"Ref\", \"ReportBinding\",\n    \"ReportDecl\", \"ScenarioDecl\", \"SourceDecl\", \"SymbolDecl\", \"Unary\", \"UnsupportedDecl\", \"UseDecl\",\n    \"ValidationResult\", \"compile_program\", \"evaluate_expression\", \"rational\", \"semantic_projection\",\n    \"validate_ir\",\n]\n","exit_code":0,"status":"completed"}}
