{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"git status --short\nsed -n '1,240p' scripts/check_accounting_p03.py\"","aggregated_output":"fatal: not a git repository (or any of the parent directories): .git\n#!/usr/bin/env python3\n\"\"\"Execute all catalogued P03 obligations and preserve actual observations.\"\"\"\nimport argparse\nfrom collections import Counter\nfrom datetime import datetime, timezone\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport platform\nimport sys\nimport time\nimport unittest\nfrom importlib.metadata import version\n\nROOT=Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(ROOT/'tests'))\nimport test_accounting_p03 as cases\n\nCHANGED=['scripts/core0_frontends_v1.py','scripts/core0_ir_v1.py','scripts/check_accounting_p03.py',\n         'tests/test_accounting_p03.py','docs/design/spec/core0-lowering-profile-v1.md',\n         'docs/design/fixtures/p03-lowering-cases-v1.json']\n\n\ndef main():\n    parser=argparse.ArgumentParser();parser.add_argument('--output-dir',required=True);args=parser.parse_args()\n    out=Path(args.output_dir).resolve()\n    if out != ROOT/'data/accounting-master/deliverables/P03':\n        parser.error('output-dir must be the declared P03 output directory')\n    started=time.monotonic()\n    entry=json.loads((ROOT/'data/accounting-master/runs/20261002T181809-4cb566e0/P03/phase-entry-inventory.json').read_text())\n    before={p:hashlib.sha256((ROOT/p).read_bytes()).hexdigest() for p in entry if (ROOT/p).is_file()}\n    cases.OBSERVATIONS.clear(); stream=io.StringIO()\n    suite=unittest.defaultTestLoader.loadTestsFromModule(cases)\n    result=unittest.TextTestRunner(stream=stream,verbosity=0).run(suite)\n    catalog=json.loads((ROOT/'docs/design/fixtures/p03-lowering-cases-v1.json').read_text())\n    required_counts=Counter(c['id'] for c in catalog['obligations'])\n    observed_counts=Counter(c['id'] for c in cases.OBSERVATIONS)\n    required=set(required_counts)\n    observed=set(observed_counts)\n    duplicate_ids=sorted(k for k in required|observed if required_counts[k]>1 or observed_counts[k]>1)\n    failed_observations=[c['id'] for c in cases.OBSERVATIONS if c.get('passed') is not True]\n    missing=sorted(required-observed);extra=sorted(observed-required)\n    after={p:hashlib.sha256((ROOT/p).read_bytes()).hexdigest() if (ROOT/p).is_file() else None for p in before}\n    protection=[p for p in before if before[p]!=after[p]]\n    initial=Path('/tmp/accdsl-p03-protected-entry.json')\n    worker_changes=[]\n    if initial.exists():\n        worker_changes=[p for p,h in json.loads(initial.read_text()).items() if not (ROOT/p).is_file() or hashlib.sha256((ROOT/p).read_bytes()).hexdigest()!=h]\n    repair_entry=Path('/tmp/accdsl-p03-repair-entry.json')\n    repair_before=json.loads(repair_entry.read_text()) if repair_entry.exists() else {}\n    repair_changes=[p for p,h in repair_before.items() if not (ROOT/p).is_file() or hashlib.sha256((ROOT/p).read_bytes()).hexdigest()!=h]\n    passed=(result.wasSuccessful() and result.testsRun>0 and not result.skipped and not missing and not extra\n            and not duplicate_ids and not failed_observations and not protection and not worker_changes and not repair_changes)\n    payload={\n      'schema_version':'accdsl.p03.conformance.v1','passed':passed,'profile':catalog['profile'],\n      'manifest':{'git_commit':'unavailable: existing marker is not a usable repository',\n        'command':'python3 -B scripts/check_accounting_p03.py --output-dir data/accounting-master/deliverables/P03',\n        'environment':{'python':platform.python_version(),'lark':version('lark'),'jsonschema':version('jsonschema')},\n        'hardware':'CPU only; no accelerator framework imported','random_seeds':'N/A: deterministic checks',\n        'data_version':'synthetic P03 bindings and digest-locked DemoDebt@1',\n        'utc':datetime.now(timezone.utc).isoformat(),'wall_seconds':round(time.monotonic()-started,3),\n        'plan':'data/accounting-master/runs/20261002T205123-6b8e9a16/P03/approved-plan.json',\n        'result':'data/accounting-master/deliverables/P03/result.md',\n        'outputs':['data/accounting-master/deliverables/P03/conformance.json','data/accounting-master/deliverables/P03/result.md'],\n        'changed_files':CHANGED+['data/accounting-master/deliverables/P03/'+n for n in ('conformance.json','result.md','progress.md')]},\n      'tests':{'methods_run':result.testsRun,'obligations_run':len(observed),'missing':missing,'uncatalogued':extra,\n               'duplicate_ids':duplicate_ids,'failed_observations':failed_observations,\n               'skipped':result.skipped,'failures':[{'test':str(t),'detail':d} for t,d in result.failures+result.errors]},\n      'observations':cases.OBSERVATIONS,\n      'hashes':{p:hashlib.sha256((ROOT/p).read_bytes()).hexdigest() for p in CHANGED},\n      'protected_files':{'before':before,'after':after,'changed_during_check':protection,\n          'repair_entry':repair_before,'changed_during_repair':repair_changes,\n          'changed_during_worker':worker_changes,'historical_differences':[p for p in before if before[p]!=entry[p]]},\n      'requirement_coverage':{'MC02':'context and provenance','MC04':'separate alternatives and global constraints',\n         'MC10':'explicit historical admission and scenario assumptions','MC20':'package digest/applicability and report policies',\n         'MC23':'independent matched typed/text programs; no authoring superiority claim','MC24':'bounded parsing, binding, typing and independent IR rejection'},\n      'unsupported':catalog['unsupported'],\n      'acceptance':{'engineering':passed,'accounting_validity':'not established','forecast_validity':'not established',\n                    'human_acceptance':'pending','whole_gap_closure':False}}\n    out.mkdir(parents=True,exist_ok=True)\n    (out/'conformance.json').write_text(json.dumps(payload,indent=2,ensure_ascii=True)+'\\n')\n    decision='PASS' if passed else 'FAIL'\n    (out/'result.md').write_text(f'''# P03 bounded source lowering result\n\n{decision}: {result.testsRun} unittest methods executed {len(observed)} catalogued obligations.\nThe compiler parses source declarations, binds explicit package/evidence/context\nmetadata, checks quantities, and constructs independently validated shared IR.\nDirect typed declarations use the same semantic stages. Neither compiler entrypoint\nreads expected IR. Complete actual IR, bindings, source spans, raw hashes and exact\nexpected/observed interest values are retained in conformance.json.\n\nIndependent renamed input and principal/rate changes establish input sensitivity.\nBaseline endpoint interest is 5/7; 9% stress gives 5/9; principal 200 gives 10/14.\nThese are exact one-year arithmetic checks, not journal execution. The authored IR\ncomparison covers corresponding economic/context/policy fields and excludes its\nreconstruction claims. Schema-valid corruptions must fail semantic validation.\n\nRecovery inspection found that removing all assumption metadata or the report\nmapping could pass the previous semantic validator. The repair rejects these\nomissions, disconnected model/package/scope references, missing scenario drivers\nand metadata changes hidden by renamed assumption identifiers. Added catalogued\nregressions first establish unchanged-schema validity, then semantic rejection.\n\n| Decision | Primary criterion | Veto diagnostics | Main uncertainty | Next action | Not concluded |\n| --- | --- | --- | --- | --- | --- |\n| {decision} for bounded engineering conformance | independent frontends, changed inputs and rejection coverage | missing obligations={len(missing)}, failures={len(result.failures)+len(result.errors)}, protected changes={len(protection)+len(worker_changes)+len(repair_changes)} | unimplemented language breadth and domain acceptance | independent result review | whole G2/G12/G15 closure, accounting or forecasting validity |\n\nSpecification is the versioned profile. Implemented behavior is in the two versioned\nmodules. Tested invariants are the executed catalog obligations. Accounting validity,\nempirical forecasting and human acceptance remain separate and unestablished.\nAll MC01–MC35 and G1–G18 retain wider obligations.\n\nThe strongest alternative explanation for frontend agreement is a shared compiler\nbug; independent arithmetic, authored-field comparison and schema-valid corruptions\nreduce that risk without proving the general language. The weakest evidence is\ncoverage outside this debt profile. A counterexample within the declared profile\nwould overturn this engineering acceptance and trigger a focused repair.\n\nActual checker command: `{payload['manifest']['command']}`.\nEnvironment: Python {platform.python_version()}, Lark {version('lark')}, jsonschema\n{version('jsonschema')}; deterministic CPU execution, no random seed or GPU use.\nWall time: {payload['manifest']['wall_seconds']} seconds. Git commit unavailable;\nsource and protected-input hashes are in conformance.json. No package installation.\nThe standalone required unittest command was also run; its final outcome is recorded\nin progress.md. Changed code, tests and profile/catalog files are enumerated in the\nmanifest. Historical controller/P02 changes predate this worker.\n\nResiduals: general packages, events, rules, postings, arbitrary mappings, multiple\nentities/books/observations, currencies/calendars, cross-company concepts, extraction\nuncertainty, accounting elections, estimates, behavior, future innovations and\nprobability measures remain unsupported. Families remain Unknown/PartialSearch with\nzero completed cells, one unsearched cell and no invented witnesses or solver results.\n''')\n    print(json.dumps({'passed':passed,'methods':result.testsRun,'obligations':len(observed),'missing':missing,\n          'failures':len(result.failures)+len(result.errors),'protected_changes':protection+worker_changes+repair_changes}))\n    return 0 if passed else 1\n\nif __name__=='__main__':sys.exit(main())\n","exit_code":0,"status":"completed"}}
