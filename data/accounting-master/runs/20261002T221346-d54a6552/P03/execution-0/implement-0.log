{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"rg -n 'P03|lowering|worker|test|protected|\"'^#'\"' AGENTS.md\nrg --files data/accounting-master/runs/20261002T221346-d54a6552/P03 -g '*.json'\nsed -n '1,210p' tests/test_accounting_p03.py\"","aggregated_output":"1:# AccDSL project instructions\n3:## Mission entry point\n23:## Working rules\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/plan-0.response.json\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/execution-0/pre-edit-files.json\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/execution-0/implement-0.recovery.json\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/review_plan-0.process.json\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/review_plan-0.recovery.json\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/approved-plan.json\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/plan-0.recovery.json\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/plan-0.process.json\ndata/accounting-master/runs/20261002T221346-d54a6552/P03/review_plan-0.response.json\n\"\"\"Executed P03 obligations; authored typed inputs never pass through the parser.\"\"\"\nimport copy\nfrom dataclasses import replace\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport unittest\nfrom unittest.mock import patch\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'scripts'))\nimport core0_ir_v1 as ir\nfrom core0_frontends_v1 import compile_source\nimport jsonschema\n\nOBSERVATIONS = []\nBASE = (ROOT / 'docs/design/fixtures/borrowing.acc').read_text()\nREASON = 'Fixed-rate proportion not disclosed'\nRENAMED = '''module FinancingStudy version \"2\";\nuse DemoDebt version \"1\";\nsource disclosure = external(\"synthetic-note-7\");\nentity Beta functional USD;\nbook Statutory entity Beta basis DemoDebt version \"1\";\naccount Cash : Asset book Statutory;\naccount Debt : Liability book Statutory;\naccount InterestExpense : Expense book Statutory;\naccount Retained : Equity book Statutory;\nopening carried for Statutory from external(\"after-2025-close\");\nobservation borrowing : Money<USD> instant @2025-12-31 = 150 USD from disclosure;\nsymbol share : Real in [0, 1] because \"Fixed-rate proportion not disclosed\";\ncontract facility : DebtMix book Statutory {\n principal = value(borrowing); fixed_fraction = share;\n fixed_rate = 0.05 per year; initial_floating_rate = 0.05 per year;\n}\nalternative fixed { assume share == 1; }\nalternative floating { assume share == 0; }\nscenario shock { set market_rate = constant(0.08 per year); }\nreport financials for Statutory { mapping = external(\"DemoDebt.statements.v1\"); }\n'''\n\n\ndef bindings(principal=100, renamed=False):\n    \"\"\"Explicit synthetic evidence, separately authored from source and expected IR.\"\"\"\n    p = F(principal); stamp = '2026-01-01T00:00:00Z'\n    book, symbol = ('Statutory', 'share') if renamed else ('Local', 'alpha')\n    names = ('fixed', 'floating') if renamed else ('allFixed', 'allFloating')\n    package_path = ROOT / 'docs/design/fixtures/demo-debt-package.json'\n    return ir.CompileBindings(\n        packages=[ir.PackageBinding('DemoDebt', '1', hashlib.sha256(package_path.read_bytes()).hexdigest(),\n            'DemoDebt', '2025-01-01', '2028-01-01', ['reset','accrue_and_pay','close','statements'],\n            ['builtin:Core0@1','DemoCalendar@1'], ['fixture:demo-debt-package.json'])],\n        readings=[ir.ReadingBinding('synthetic-note-7', f'Synthetic disclosed debt {p} USD; split undisclosed', p,\n            'USD', '2025-12-31', 'fixture:p03-synthetic', 'synthetic-2025', stamp, stamp,\n            'synthetic-author', stamp, 'Explicit synthetic acceptance, not human approval', stamp,\n            system_as_of=stamp, action='Accept')],\n        openings=[ir.OpeningBinding('after-2025-close', '2025-12-31',\n            {'Cash':p-5, 'Debt':-p, 'InterestExpense':0, 'Retained':5}, book=book)],\n        reports=[ir.ReportBinding('DemoDebt.statements.v1','DemoDebt.statements.v1',\n            'interest_operating','close',['accrue_and_pay'])],\n        assumptions=[ir.AssumptionBinding(k, 'Synthetic explicit '+k, information_cutoff=stamp,\n            valid_start='2026-01-01',valid_end='2027-01-01')\n            for k in ('alternative','constraint','contract-rate','scenario')],\n        admissions=[ir.SymbolAdmission(symbol,'synthetic-note-7',REASON,'synthetic-author',stamp)],\n        alternatives=[ir.AlternativeBinding(n,'synthetic-author',stamp,'Synthetic endpoint') for n in names],\n        calendar_id='DemoCalendar@1',calendar_name='Gregorian',horizon_start='2026-01-01',\n        horizon_end='2027-01-01',symbol_uncertainty='HistoricalFact',\n        entity_perimeter='Beta-only' if renamed else 'Acme-only')\n\n\ndef typed(principal=100, stress=F(7,100), renamed=False, arithmetic=False):\n    mod, ver, src, ent, book, opening, obs, sym, contract, a1, a0, scenario, report = (\n        ('FinancingStudy','2','disclosure','Beta','Statutory','carried','borrowing','share','facility',\n         'fixed','floating','shock','financials') if renamed else\n        ('BorrowingExample','1','note7','Acme','Local','after2025','debt','alpha','loans',\n         'allFixed','allFloating','rateShock','statements'))\n    ds = [ir.SourceDecl(src,'synthetic-note-7'),ir.EntityDecl(ent,'USD'),ir.BookDecl(book,ent,'DemoDebt','1')]\n    ds += [ir.AccountDecl(n,r,book) for n,r in [('Cash','Asset'),('Debt','Liability'),('InterestExpense','Expense'),('Retained','Equity')]]\n    ds += [ir.OpeningDecl(opening,book,'after-2025-close'),\n           ir.ObservationDecl(obs,'Money<USD>','2025-12-31',ir.Literal(F(principal),unit='USD'),src),\n           ir.SymbolDecl(sym,'Real',ir.Literal(F(0)),ir.Literal(F(1)),REASON)]\n    fraction = ir.Ref(sym)\n    if arithmetic:\n        ds += [ir.LetDecl('mix',ir.Binary('/',ir.Binary('*',ir.Ref(sym),ir.Literal(F(2))),ir.Literal(F(2)))),\n               ir.ConstraintDecl('limit',ir.Binary('and',ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0))),\n                    ir.Binary('<=',ir.Ref(sym),ir.Literal(F(1)))))]\n        fraction=ir.Ref('mix')\n    ds += [ir.ContractDecl(contract,'DebtMix',book,[('principal',ir.Call('value',[ir.Ref(obs)])),\n           ('fixed_fraction',fraction),('fixed_rate',ir.Literal(F(1,20),unit='per year')),\n           ('initial_floating_rate',ir.Literal(F(1,20),unit='per year'))])]\n    for name,value in ((a1,1),(a0,0)):\n        conds=[ir.Binary('==',ir.Ref(sym),ir.Literal(F(value)))]\n        if arithmetic: conds += [ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0)))]\n        ds.append(ir.AlternativeDecl(name,conds))\n    ds += [ir.ScenarioDecl(scenario,[('market_rate',ir.Call('constant',[ir.Literal(F(stress),unit='per year')]))]),\n           ir.ReportDecl(report,book,ir.External('DemoDebt.statements.v1'))]\n    return ir.Program(mod,ver,ds,[ir.UseDecl('DemoDebt','1')])\n\n\ndef arithmetic_source():\n    return BASE.replace('contract loans', 'let mix = alpha * 2 / 2;\\nconstraint limit: alpha >= 0 and alpha <= 1;\\ncontract loans').replace(\n        'fixed_fraction = alpha;', 'fixed_fraction = mix;').replace('assume alpha == 1;', 'assume alpha == 1; assume alpha >= 0;').replace(\n        'assume alpha == 0;', 'assume alpha == 0; assume alpha >= 0;')\n\n\nSOURCE_NEGATIVES = {\n 'unknown_report_field': (lambda s:s.replace('mapping =', 'extra = 3; mapping ='),'ParseError'),\n 'duplicate_report_field': (lambda s:s.replace('mapping = external(\"DemoDebt.statements.v1\");','mapping = external(\"DemoDebt.statements.v1\"); mapping = external(\"DemoDebt.statements.v1\");'),'ParseError'),\n 'missing_rate_unit': (lambda s:s.replace('fixed_rate = 0.05 per year','fixed_rate = 0.05'),'MissingRateUnit'),\n 'unsupported_event': (lambda s:s+'\\nevent maturity() book Local;','UnsupportedDeclaration'),\n 'reserved_identifier': (lambda s:s.replace('entity Acme','entity report'),'ReservedIdentifier'),\n 'invalid_date': (lambda s:s.replace('@2025-12-31','@2025-02-30'),'InvalidDate'),\n 'invalid_escape': (lambda s:s.replace('Fixed-rate',r'Fixed\\qrate'),'ParseError'),\n 'invalid_surrogate': (lambda s:s.replace('Fixed-rate',r'Fixed\\ud800rate'),'InvalidString'),\n 'duplicate_declaration': (lambda s:s+'\\nentity Acme functional USD;','DuplicateDeclaration'),\n 'duplicate_contract_field': (lambda s:s.replace('fixed_fraction = alpha;', 'fixed_fraction = alpha; fixed_fraction = alpha;'),'DuplicateField'),\n 'unknown_reference': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = absent'),'UnknownReference'),\n 'cyclic_lets': (lambda s:s.replace('contract loans','let first = second; let second = first; contract loans'),'ExpressionCycle'),\n 'unsupported_call': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = sqrt(alpha)'),'UnsupportedExpression'),\n 'unsupported_array': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = [alpha, 1]'),'UnsupportedExpression'),\n 'unsupported_field': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha.part'),'UnsupportedExpression'),\n 'wrong_dimensions': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD + 1'),'TypeMismatch'),\n 'rate_product': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD * 0.05 per year'),'UnsupportedOperation'),\n 'zero_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha / 0'),'UnprovedNonzeroDenominator'),\n 'unproved_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 / alpha'),'UnprovedNonzeroDenominator'),\n 'bad_arity': (lambda s:s.replace('value(debt)','value(debt, debt)'),'ArityMismatch'),\n 'invalid_fraction_bounds': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha + 1'),'ContractDomain'),\n 'principal_disagreement': (lambda s:s.replace('principal = value(debt)','principal = 200 USD'),'ContractPrincipal'),\n 'malformed_syntax': (lambda s:s.replace('module BorrowingExample','module {'),'ParseError'),\n 'wrong_book': (lambda s:s.replace('account Cash : Asset book Local','account Cash : Asset book Elsewhere'),'BindingMismatch'),\n 'extra_scenario_setting': (lambda s:s.replace('set market_rate', 'set other = 1; set market_rate'),'ScenarioFields'),\n}\n\n\nclass P03Tests(unittest.TestCase):\n    def record(self, case, **values):\n        OBSERVATIONS.append(dict(id=case, passed=True, **values))\n\n    def success(self, source, program, b, case, expected):\n        before=ir.binding_projection(b); original=ir.binding_projection(program)\n        a=compile_source(source,b); t=ir.compile_program(program,b)\n        self.assertTrue(a.ok,[d.as_dict() for d in a.diagnostics]);self.assertTrue(t.ok,[d.as_dict() for d in t.diagnostics])\n        self.assertEqual(a.semantic_projection,t.semantic_projection)\n        self.assertEqual(a.binding_records,t.binding_records)\n        self.assertEqual(before,ir.binding_projection(b));self.assertEqual(original,ir.binding_projection(program))\n        self.assertEqual(a.ir,compile_source(source,b).ir)\n        fields={v['name']:v['expression'] for v in a.ir['contracts'][0]['fields']}\n        symbol=a.ir['symbols'][0]['id']; rates=[]\n        for alpha in (1,0):\n            ev=lambda eid:ir.evaluate_expression(a.ir,eid,{symbol:F(alpha)})\n            principal=ev(fields['principal']); weight=ev(fields['fixed_fraction']); fixed=ev(fields['fixed_rate'])\n            stress=ev(a.ir['scenarios'][0]['drivers'][0]['expression'])\n            rates.append(principal*(weight*fixed+(1-weight)*stress))\n        self.assertEqual(rates,list(map(F,expected)))\n        fam=a.ir['historyFamilies'][0]\n        self.assertEqual((fam['feasibility'],fam['coverage'],fam['completed_cells'],fam['unresolved_cells'],fam['witnesses'],fam['solver_results']),\n                         ('Unknown','PartialSearch',0,1,[],[]))\n        self.record(case,source=source,input_sha256=a.input_sha256,typed_sha256=t.input_sha256,\n                    ir=a.ir,bindings=a.binding_records,source_map=dict(a.source_map),typed_source_map=dict(t.source_map),\n                    expected_interest=list(map(str,expected)),observed_interest=list(map(str,rates)))\n        return a\n\n    def test_positive_pairs(self):\n        for case,source,program,b,expect in [\n          ('borrowing_baseline',BASE,typed(),bindings(),(5,7)),\n          ('borrowing_stress_09',BASE.replace('0.07 per year','0.09 per year'),typed(stress=F(9,100)),bindings(),(5,9)),\n          ('borrowing_principal_200',BASE.replace('= 100 USD','= 200 USD'),typed(200),bindings(200),(10,14)),\n          ('renamed_independent',RENAMED,typed(150,F(8,100),True),bindings(150,True),(F(15,2),12)),\n          ('borrowing_let_arithmetic',arithmetic_source(),typed(arithmetic=True),bindings(),(5,7))]:\n            with self.subTest(case=case):\n                result=self.success(source,program,b,case,expect)\n                if case=='borrowing_let_arithmetic':\n                    self.assertEqual(len(result.ir['historyFamilies'][0]['constraints']),1)\n                    self.assertEqual([len(a['constraints']) for a in result.ir['alternatives']],[2,2])\n\n    def test_formatting_and_spelling(self):\n        base=compile_source(BASE,bindings())\n        for name,source in [('borrowing_crlf_comment','// comment\\r\\n'+BASE.replace('\\n','\\r\\n')),\n                            ('decimal_spelling',BASE.replace('100 USD','100.00 USD'))]:\n            result=self.success(source,typed(),bindings(),name,(5,7))\n            self.assertEqual(base.semantic_projection,result.semantic_projection)\n            self.assertNotEqual(base.input_sha256,result.input_sha256)\n        for decl in ('Acme','Local','loans','statements'):\n            span=base.source_map[decl];self.assertIn(decl,BASE[span['start']:span['end']])\n        self.record('declaration_source_spans')\n\n    def test_source_rejections(self):\n        for name,(change,code) in SOURCE_NEGATIVES.items():\n            with self.subTest(case=name):\n                result=compile_source(change(BASE),bindings())\n                self.assertFalse(result.ok)\n                self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_typed_rejections(self):\n        p=typed(); contract=next(d for d in p.declarations if isinstance(d,ir.ContractDecl))\n        replacements={\n          'typed_missing_rate_unit':('fixed_rate',ir.Literal(F(1,20)),'MissingRateUnit'),\n          'typed_unknown_reference':('fixed_fraction',ir.Ref('absent'),'UnknownReference'),\n          'typed_unsupported_call':('fixed_fraction',ir.Call('sqrt',[ir.Ref('alpha')]),'UnsupportedExpression'),\n          'typed_float':('fixed_rate',ir.Literal(0.05,unit='per year'),'UnsupportedLiteral'),\n          'typed_invalid_bounds':('fixed_fraction',ir.Binary('+',ir.Ref('alpha'),ir.Literal(F(1))),'ContractDomain'),\n        }\n        for name,(field,value,code) in replacements.items():\n            with self.subTest(case=name):\n                bad=replace(contract,fields=[(k,value if k==field else v) for k,v in contract.fields])\n                result=ir.compile_program(replace(p,declarations=[bad if d is contract else d for d in p.declarations]),bindings())\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' docs/design/spec/core0-lowering-profile-v1.md\npython3 -B - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('data/accounting-master/deliverables/P03/conformance.json'); d=json.loads(p.read_text());print('report keys',list(d)); print(json.dumps({k:d[k] for k in ('tests','protection','protected','manifest') if k in d},indent=2)[:2600])\nfor f in ['/tmp/accdsl-p03-protected-entry.json','/tmp/accdsl-p03-repair-entry.json']:\n p=Path(f);print(f,p.exists())\n if p.exists():\n  d=json.loads(p.read_text());print('entries',len(d),'sample',list(d.items())[:2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' docs/design/spec/core0-lowering-profile-v1.md\npython3 -B - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('data/accounting-master/deliverables/P03/conformance.json'); d=json.loads(p.read_text());print('report keys',list(d)); print(json.dumps({k:d[k] for k in ('tests','protection','protected','manifest') if k in d},indent=2)[:2600])\nfor f in ['/tmp/accdsl-p03-protected-entry.json','/tmp/accdsl-p03-repair-entry.json']:\n p=Path(f);print(f,p.exists())\n if p.exists():\n  d=json.loads(p.read_text());print('entries',len(d),'sample',list(d.items())[:2])\nPY\"","aggregated_output":"# Core 0.1 debt source lowering, version 1\n\nThis executable profile supplements the protected Core 0 grammar and contract.\n`compile_source(text, bindings)` parses real source; `compile_program(Program,\nbindings)` accepts immutable typed declarations. Both bind names, check quantities\nand context, construct shared IR, and submit it to independent schema and semantic\nvalidation. Neither entrypoint reads the authored expected IR or expected results.\n\n## Repair execution audit\n\nThe approved P03 plan remains the implementation boundary. Inspection of the\ntimed-out attempt found two partial modules and no tests or deliverables. Its\nsuccessful example compile was insufficient: global constraints were dropped,\nrates were treated as dimensionless, and acceptance, package and domain checks\nwere incomplete. These are implementation failures, not evidence against the\nlanguage design. Repair them before accepting the slice.\n\nThe baseline is `borrowing.acc`, plus documented corresponding fields of the\nauthored IR, whose reconstruction claims are excluded. Independently constructed\ntyped programs and exact arithmetic checks supplement agreement between frontends.\nSchema validity is a prerequisite, not semantic acceptance. Negative IR cases must\nbe structurally valid before testing the intended semantic rejection. Stops are\nunexpected protected-input changes, missing dependencies, or failing mandatory\nchecks; failures trigger repair, never a passing report. No statistical, timing,\nusability, accounting-compliance or forecasting comparison is being run.\n\nProvenance of material choices: exact rationals, lexical rules and quantities come\nfrom `core-contract.md`; USD accounts and DebtMix fields come from the local\nDemoDebt package. These are bounded baseline restrictions, not promoted defaults.\nThe single source/observation/symbol restriction keeps the evidence view explicit;\nmultiple-source reconciliation is unsupported. Synthetic acceptance and admission\nrecords are supplied by the caller. Absence of reconstruction requires Unknown\nfeasibility, PartialSearch, zero completed cells, one unsearched cell, no witnesses\nand no solver results. Early diagnostics cover unit loss, silent constraint loss,\ninvented acceptance and copied package digests. A pass establishes deterministic\nengineering conformance only. Results are preserved in the two P03 deliverables.\n\nThe writable project files are the two versioned modules, checker, required test,\nthis profile, the versioned cases JSON and the two P03 deliverables. Existing\ngrammar/schema, authored fixtures, legacy validators, controllers, release-pinned\nfiles and preserved snapshots remain protected. Their current hashes are checked\nagainst phase-entry hashes where available, and before/after execution. Git is\nunavailable (existing marker is not a usable repository); no Git initialization.\nPython 3.11.15, Lark 1.3.1 and jsonschema 4.26.0 are existing dependencies. No\naccelerator framework, service, installation, model or background job is used.\n\n## Supported language and bindings\n\nThe profile has one module, DemoDebt@1 import, source, entity, USD book, exact\ninstant debt observation, admitted Real interval symbol, opening, DebtMix\ncontract, constant annual-rate stress and package report. Its four account names\nare Cash, Debt, InterestExpense and Retained, with Asset, Liability, Expense and\nEquity roles respectively: the package report actually names these accounts.\nOther declaration names may vary. There may be multiple lets, Boolean constraints\nand conditional alternatives, with multiple assumptions in each alternative.\nGlobal constraints constrain the parent family; alternative constraints stay in\ntheir respective branches and are not conjoined in the parent. No branch is\nselected or solved.\n\nBindings explicitly supply a digest-locked local package, synthetic reading and\nacceptance action, information/system cutoffs, opening balances, perimeter,\nsymbol admission, assumption periods/origins, and alternative authorship. Binding\nrecords remain separate from package definitions. Every acceptance must explicitly\nsay Accept; no declaration creates acceptance. Package loading is restricted to\nthe retained DemoDebt file and checks its fixed version, digest, exports and\napplicability. Paths escaping the repository and overrides are errors. The\npackage's registry examples and expected-result fields are not compiler inputs.\n\nDecimal tokens become Fraction directly; binary floats are rejected. Strings use\nJSON escapes, reject unpaired surrogates and normalize semantic strings to NFC.\nOriginal spelling and Unicode-code-point offsets remain in the separate source\nmap; typed locations identify constructors. LF, CRLF, comments and whitespace\npreserve semantics. Dates are Gregorian. All grammar words are reserved.\n\nExpressions include literals, shared references, `value(observation)`, unary minus,\n`not`, compatible addition/subtraction, numeric comparisons, typed equality and\nBoolean composition. Multiplication admits a dimensionless Real or Int factor;\ndivision requires a provably nonzero constant Real or Int denominator. Rates and\nYearFraction are dimensional; rate times money is rejected here (the general\n`simpleInterest` builtin is future work). Integer products remain integer; division\nof scalars returns Real. Addition and comparisons require equal types and compatible\ncontexts. `constant(rate)` is a scenario driver, with a constant, nonnegative annual\nrate. `external(string)` is admitted only for source/opening/report declarations.\nDebtMix principal must equal the accepted debt and opening liability, its fraction\nmust have proven bounds inside [0,1], and component rates must be constant and\nnonnegative. Interval arithmetic proves only conservative bounds; failure to prove\na bound rejects this profile and does not assert mathematical infeasibility.\n\n## Verification and remaining coverage\n\nRun `python3 -B -m unittest discover -s tests -p 'test_accounting_p03.py' -v`, then\n`python3 -B scripts/check_accounting_p03.py --output-dir data/accounting-master/deliverables/P03`.\nThe checker returns nonzero for failed or skipped obligations, includes generated\nIR and binding projections, observations, diagnostics, hashes and runtime details,\nand writes only conformance.json and result.md under the declared output folder.\n\nThe semantic comparison retains IR values, contexts, locks, evidence, assumptions\nand all external bindings. It excludes frontend offsets and observation display\nspelling; those are separately preserved. The authored comparison uses debt value,\ncontext, contract types/fields, assumptions, endpoint conditions, scenario rate,\nopening balances and report policies. Exact one-year interest is checked as\nP * (alpha * fixed_rate + (1-alpha) * stress_rate), using evaluated generated\nfields. At alpha=1/0, P=100 and 5%/7% imply 5/7; 9% stress implies 5/9;\nP=200 implies 10/14. This calculation is not journal execution or forecasting.\n\nMC02/MC04 receive bounded context, evidence and assumption preservation checks;\nMC10 receives factual admission and explicit scenario-assumption checks; MC20\nreceives locked-package and override rejection checks; MC23 receives matched\ntyped/text tasks; MC24 receives parsing, binding, typing and semantic diagnostics.\nNone is wholly closed by this profile. G2, G12 and G15 remain open, as do all wider\nMC01–MC35 and G1–G18 obligations.\n\nUnsupported: general package loading, events, rules/overrides, postings, arbitrary\nreport mappings, records/arrays/field access, finite choices, nonlinear bound\nproofs, implicit conversions, multiple books/entities/observations, dimensions,\ncurrency/calendar variants, rounded or period observations, source conflicts and\nrevisions, cross-company mapping, extraction uncertainty, accounting elections,\nmeasurement estimates, behavior policies, future innovations and probability\nmeasures. Reconstruction, accounting execution, forecast validity, authoring\nsuperiority and human acceptance require separate evidence.\n\n## Current execution evidence contract\n\nThe refreshed approved plan passed skeptical review. Baselines, acceptance and\nstops remain those above; historical controller/P02 changes predate this worker\nand are not worker edits. A snapshot of 370 existing phase-entry files was taken.\nMandatory case coverage is enforced by the checker against the versioned catalog.\nThe paired typed programs are constructed independently of parsing and expected IR.\nMaterial metadata (calendar, horizon, perimeter and uncertainty kind) must be\nexplicit outside the named synthetic demo helper. Their provenance is caller\nevidence, their purpose is reproducible context, their failure mode is silent\ncontext transfer, and omission/renaming tests are the earliest diagnostic. They\nare inputs, not promoted defaults. Exact arithmetic and schema validation are\nengineering diagnostics only. No stochastic or research ranking is undertaken.\n\n## Recovery integrity repair\n\nA fresh nine-method suite passed, but focused schema-valid omission probes found\nthat all assumptions or the report could be removed without rejection. These\nwere validator defects. Mandatory profile cardinalities and model/package/scope\nreferences now undergo independent checks. Every global or branch condition and\nevery assumed rate must retain matching assumption metadata; renaming an\nassumption cannot bypass its binding. Scenario driver names and scope calendars\nare checked. Ten additional schema-valid corruptions test these repairs. The\nchecker also rejects duplicate obligation IDs and explicitly failed observations.\nProtected-input hashes captured at repair entry are embedded in conformance.json.\nThese repairs strengthen bounded engineering evidence without broadening the\nprofile or establishing accounting or forecast validity.\nreport keys ['schema_version', 'passed', 'profile', 'manifest', 'tests', 'observations', 'hashes', 'protected_files', 'requirement_coverage', 'unsupported', 'acceptance']\n{\n  \"tests\": {\n    \"methods_run\": 9,\n    \"obligations_run\": 85,\n    \"missing\": [],\n    \"uncatalogued\": [],\n    \"duplicate_ids\": [],\n    \"failed_observations\": [],\n    \"skipped\": [],\n    \"failures\": []\n  },\n  \"manifest\": {\n    \"git_commit\": \"unavailable: existing marker is not a usable repository\",\n    \"command\": \"python3 -B scripts/check_accounting_p03.py --output-dir data/accounting-master/deliverables/P03\",\n    \"environment\": {\n      \"python\": \"3.11.15\",\n      \"lark\": \"1.3.1\",\n      \"jsonschema\": \"4.26.0\"\n    },\n    \"hardware\": \"CPU only; no accelerator framework imported\",\n    \"random_seeds\": \"N/A: deterministic checks\",\n    \"data_version\": \"synthetic P03 bindings and digest-locked DemoDebt@1\",\n    \"utc\": \"2026-10-02T22:07:31.921952+00:00\",\n    \"wall_seconds\": 2.637,\n    \"plan\": \"data/accounting-master/runs/20261002T205123-6b8e9a16/P03/approved-plan.json\",\n    \"result\": \"data/accounting-master/deliverables/P03/result.md\",\n    \"outputs\": [\n      \"data/accounting-master/deliverables/P03/conformance.json\",\n      \"data/accounting-master/deliverables/P03/result.md\"\n    ],\n    \"changed_files\": [\n      \"scripts/core0_frontends_v1.py\",\n      \"scripts/core0_ir_v1.py\",\n      \"scripts/check_accounting_p03.py\",\n      \"tests/test_accounting_p03.py\",\n      \"docs/design/spec/core0-lowering-profile-v1.md\",\n      \"docs/design/fixtures/p03-lowering-cases-v1.json\",\n      \"data/accounting-master/deliverables/P03/conformance.json\",\n      \"data/accounting-master/deliverables/P03/result.md\",\n      \"data/accounting-master/deliverables/P03/progress.md\"\n    ]\n  }\n}\n/tmp/accdsl-p03-protected-entry.json True\nentries 370 sample [('data/accounting-master/deliverables/P02/case.json', '52cea992b880e6bbba3d861cd59eded7fbe4712fce07b3fceff0ebc566799f81'), ('docs/design/README.md', '212bc7c3f57b77ed866a04f9bc7185e1c7c77c3f3b3e3d1dded705d5b06aaa65')]\n/tmp/accdsl-p03-repair-entry.json True\nentries 370 sample [('scripts/build_repair_fixtures.py', 'd547424c6bb898adf919a4f5d50fd114bc7e759c78c600b2c9724456fab28b2a'), ('scripts/accounting_master_response.schema.json', 'aad6a6c3c2cdfc98728bf450c0350e4b3aff3ea32664038bd73b3f8b7ce7cd6c')]\n","exit_code":0,"status":"completed"}}
