{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' scripts/check_accounting_p03.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Execute catalogued P03 obligations with durable protection provenance.\"\"\"\nimport argparse\nfrom collections import Counter\nfrom datetime import datetime, timezone\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport platform\nimport re\nimport shlex\nimport sys\nimport time\nimport unittest\nfrom importlib.metadata import version\n\nROOT = Path(__file__).resolve().parents[1]\nCHANGED = ['scripts/core0_frontends_v1.py', 'scripts/core0_ir_v1.py',\n           'scripts/check_accounting_p03.py', 'tests/test_accounting_p03.py',\n           'docs/design/spec/core0-lowering-profile-v1.md',\n           'docs/design/fixtures/p03-lowering-cases-v1.json']\nOUTPUTS = ['data/accounting-master/deliverables/P03/' + name\n           for name in ('conformance.json', 'result.md', 'progress.md')]\nPHASE_FILES = CHANGED + OUTPUTS\nPHASE_INVENTORY = 'data/accounting-master/runs/20261002T181809-4cb566e0/P03/phase-entry-inventory.json'\nEXECUTION_INVENTORY = 'data/accounting-master/runs/20261002T221346-d54a6552/P03/execution-0/pre-edit-files.json'\nAPPROVED_PLAN = 'data/accounting-master/runs/20261002T221346-d54a6552/P03/approved-plan.json'\n\n\ndef digest(path):\n    try:\n        return hashlib.sha256(path.read_bytes()).hexdigest()\n    except OSError:\n        return None\n\n\ndef _unique_object(pairs):\n    result = {}\n    for key, value in pairs:\n        if key in result:\n            raise ValueError('duplicate inventory key: ' + key)\n        result[key] = value\n    return result\n\n\ndef _inventory(root, relative):\n    path = Path(relative)\n    if path.is_absolute() or '..' in path.parts or path.as_posix() != relative:\n        raise ValueError('inventory path must be repository-relative')\n    data = json.loads((root / path).read_text(), object_pairs_hook=_unique_object)\n    if not isinstance(data, dict) or not data:\n        raise ValueError('inventory must be a nonempty path-to-SHA256 object')\n    for name, value in data.items():\n        p = Path(name)\n        if (p.is_absolute() or '..' in p.parts or p.as_posix() != name\n                or not isinstance(value, str) or not re.fullmatch('[0-9a-f]{64}', value)):\n            raise ValueError('invalid inventory entry: ' + name)\n    return data\n\n\ndef capture_protection(root, historical_path, execution_path, writable=PHASE_FILES,\n                       required_paths=()):\n    \"\"\"Keep historical differences separate; never replace the execution baseline.\"\"\"\n    errors = []\n    inventories = []\n    for name in (historical_path, execution_path):\n        try:\n            inventories.append(_inventory(root, name))\n        except (OSError, ValueError) as exc:\n            errors.append(f'{name}: {exc}')\n            inventories.append({})\n    historical, execution = inventories\n    protected = sorted((set(historical) | set(execution) | set(required_paths)) - set(writable))\n    absent = sorted(set(protected) - set(execution))\n    if absent:\n        errors.append('execution inventory omits protected paths: ' + ', '.join(absent))\n    before = {p: digest(root / p) for p in protected}\n    return {\n        'historical_inventory': historical_path,\n        'execution_inventory': execution_path,\n        'inventory_hashes': {p: digest(root / p) for p in (historical_path, execution_path)},\n        'excluded_phase_files': list(writable),\n        'errors': errors,\n        'execution_baseline': {p: execution.get(p) for p in protected},\n        'before': before,\n        'missing_before_check': [p for p, h in before.items() if h is None],\n        'changed_since_execution_entry': [p for p in protected if before[p] != execution.get(p)],\n        'historical_differences': [\n            {'path': p, 'phase_entry_sha256': historical[p], 'execution_entry_sha256': execution[p],\n             'attribution': 'Predates this execution, as recorded by the supervisor pre-edit inventory.'}\n            for p in sorted(set(historical) & set(execution) - set(writable))\n            if historical[p] != execution[p]],\n    }\n\n\ndef finish_protection(root, report):\n    report['after'] = {p: digest(root / p) for p in report['before']}\n    report['changed_during_check'] = [p for p in report['before'] if report['before'][p] != report['after'][p]]\n    report['changed_inventory_records'] = [p for p, h in report['inventory_hashes'].items()\n                                           if h is None or digest(root / p) != h]\n    report['passed'] = not any(report[k] for k in (\n        'errors', 'missing_before_check', 'changed_since_execution_entry',\n        'changed_during_check', 'changed_inventory_records'))\n    return report\n\n\ndef obligation_status(catalog, observations):\n    required_counts = Counter(c['id'] for c in catalog['obligations'])\n    observed_counts = Counter(c['id'] for c in observations)\n    required, observed = set(required_counts), set(observed_counts)\n    return {\n        'obligations_required': len(required), 'obligations_run': len(observed),\n        'missing': sorted(required - observed), 'uncatalogued': sorted(observed - required),\n        'duplicate_ids': sorted(k for k in required | observed\n                                if required_counts[k] > 1 or observed_counts[k] > 1),\n        'failed_observations': [c['id'] for c in observations if c.get('passed') is not True],\n    }\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--output-dir', required=True)\n    parser.add_argument('--execution-inventory', default=EXECUTION_INVENTORY)\n    args = parser.parse_args(argv)\n    out = Path(args.output_dir).resolve()\n    if out != ROOT / 'data/accounting-master/deliverables/P03':\n        parser.error('output-dir must be the declared P03 output directory')\n    started = time.monotonic()\n    started_utc = datetime.now(timezone.utc).isoformat()\n    protection = capture_protection(ROOT, PHASE_INVENTORY, args.execution_inventory,\n                                    required_paths=('docs/design/spec/core-0.lark',\n                                                    'docs/design/spec/core-ir.schema.json',\n                                                    'docs/design/fixtures/borrowing.acc',\n                                                    'docs/design/fixtures/demo-debt-package.json'))\n    code_before = {p: digest(ROOT / p) for p in CHANGED}\n    plan_hash = digest(ROOT / APPROVED_PLAN)\n    if plan_hash is None:\n        protection['errors'].append('approved plan is missing or unreadable')\n    else:\n        approved = json.loads((ROOT / APPROVED_PLAN).read_text())\n        if approved.get('review', {}).get('verdict') != 'AGREE' or approved['review'].get('issues') != []:\n            protection['errors'].append('approved plan lacks an issue-free AGREE review')\n    # Lazy import keeps checker helpers usable by the required regression suite.\n    sys.path.insert(0, str(ROOT / 'tests'))\n    import test_accounting_p03 as cases\n    cases.OBSERVATIONS.clear()\n    stream = io.StringIO()\n    suite = unittest.defaultTestLoader.loadTestsFromModule(cases)\n    result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)\n    catalog = json.loads((ROOT / 'docs/design/fixtures/p03-lowering-cases-v1.json').read_text())\n    status = obligation_status(catalog, cases.OBSERVATIONS)\n    finish_protection(ROOT, protection)\n    code_after = {p: digest(ROOT / p) for p in CHANGED}\n    changed_code = [p for p in CHANGED if code_before[p] is None or code_before[p] != code_after[p]]\n    if digest(ROOT / APPROVED_PLAN) != plan_hash:\n        protection['errors'].append('approved plan changed during check')\n        protection['passed'] = False\n    passed = (result.wasSuccessful() and result.testsRun > 0 and not result.skipped\n              and bool(status['obligations_required']) and not changed_code and protection['passed']\n              and not any(status[k] for k in ('missing', 'uncatalogued', 'duplicate_ids', 'failed_observations')))\n    command_args = sys.argv[1:] if argv is None else argv\n    payload = {\n        'schema_version': 'accdsl.p03.conformance.v1', 'passed': bool(passed), 'profile': catalog['profile'],\n        'manifest': {\n            'git_commit': 'unavailable: existing marker is not a usable repository',\n            'command': shlex.join(['python3', '-B', 'scripts/check_accounting_p03.py'] + command_args),\n            'working_directory': str(ROOT), 'executable': sys.executable,\n            'environment': {'python': platform.python_version(), 'lark': version('lark'), 'jsonschema': version('jsonschema')},\n            'hardware': 'CPU only; no accelerator framework imported', 'random_seeds': 'N/A: deterministic checks',\n            'data_version': 'synthetic P03 bindings and digest-locked DemoDebt@1',\n            'started_utc': started_utc, 'utc': datetime.now(timezone.utc).isoformat(),\n            'wall_seconds': round(time.monotonic() - started, 3),\n            'plan': APPROVED_PLAN, 'plan_sha256': plan_hash,\n            'execution_inventory': args.execution_inventory,\n            'result': OUTPUTS[1], 'outputs': OUTPUTS[:2], 'changed_files': PHASE_FILES,\n            'changed_this_execution': [p for p in CHANGED\n                if code_after[p] != _inventory(ROOT, args.execution_inventory).get(p)]\n                if not protection['errors'] else 'unavailable: protection evidence failed'},\n        'tests': dict(status, methods_run=result.testsRun, skipped=result.skipped,\n                      failures=[{'test': str(t), 'detail': d} for t, d in result.failures + result.errors],\n                      runner_output=stream.getvalue()),\n        'observations': cases.OBSERVATIONS, 'hashes': code_after,\n        'checked_input_integrity': {'before': code_before, 'after': code_after, 'changed': changed_code},\n        'protected_files': protection,\n        'requirement_coverage': {\n            'MC02': 'bounded context and numeric/source provenance',\n            'MC04': 'separate evidence, assumptions, alternatives and global constraints',\n            'MC10': 'explicit factual admission and scenario assumptions; broader uncertainty unsupported',\n            'MC20': 'DemoDebt package digest/applicability and report policies; cross-company mappings unsupported',\n            'MC23': 'independently authored matched typed/text programs; no authoring superiority claim',\n            'MC24': 'bounded parsing, binding, typing and independent IR rejection'},\n        'unsupported': catalog['unsupported'],\n        'acceptance': {'engineering': bool(passed), 'accounting_validity': 'not established',\n                       'forecast_validity': 'not established', 'human_acceptance': 'pending', 'whole_gap_closure': False},\n    }\n    decision = 'PASS' if passed else 'FAIL'\n    positive = [c for c in cases.OBSERVATIONS if 'observed_interest' in c]\n    examples = '\\n'.join(f\"| {c['id']} | {', '.join(c['expected_interest'])} | {', '.join(c['observed_interest'])} |\"\n                         for c in positive)\n    historical_count = len(protection['historical_differences'])\n    result_text = f'''# P03 bounded source lowering result\n\n{decision}: {result.testsRun} unittest methods executed {status['obligations_run']} of\n{status['obligations_required']} catalogued obligations. This is deterministic\nCore0.1 engineering evidence; G2, G12 and G15 remain open beyond this profile.\n\nSource programs pass through parsing, name binding, package/type/context checks\nand shared IR construction. Independently authored typed declarations enter the\nsame semantic stages. The independent validator checks the resulting IR. Both\nentrypoints preserve package locks, source context, assumptions and alternatives.\nThe executed checks cover renamed programs, changed principal and stress rates,\nlet arithmetic, formatting, unsupported operations and schema-valid corruptions.\nThe compiler does not read authored expected IR to produce its results.\n\nThe generated expressions give the following exact one-year interest amounts in\nUSD at fixed-fraction endpoints 1 and 0. These arithmetic diagnostics are separate\nfrom accounting execution and empirical forecasting.\n\n| Input | Expected interest | Observed interest |\n| --- | --- | --- |\n{examples}\n\n| Decision | Primary criterion | Veto diagnostics | Main uncertainty | Next action | Not concluded |\n| --- | --- | --- | --- | --- | --- |\n| {decision} for bounded engineering conformance | frontend agreement, input sensitivity and semantic rejection jointly tested | missing={len(status['missing'])}; uncatalogued={len(status['uncatalogued'])}; duplicate={len(status['duplicate_ids'])}; failed observations={len(status['failed_observations'])}; test failures/errors={len(result.failures)+len(result.errors)}; skips={len(result.skipped)}; protected inputs passed={protection['passed']}; changed check inputs={len(changed_code)} | language breadth and shared-implementation bugs | independent result review if PASS; focused repair if FAIL | full G2/G12/G15 closure, accounting validity, forecast validity or human acceptance |\n\nProtection uses the durable historical inventory `{PHASE_INVENTORY}` and current\nsupervisor execution inventory `{args.execution_inventory}`. There are\n{historical_count} historical differences predating this execution, attributed by\nthose two records rather than ignored or treated as new worker edits. Missing\ninventory evidence, absent protected paths, changes since execution entry or\nchanges during the check prevent a pass. No temporary snapshot is required.\nConformance JSON preserves the inventory hashes, per-file baselines, actual IR,\nbindings, source maps, input hashes, diagnostics and the complete unittest output.\n\nSpecification is recorded in the versioned profile. The two versioned modules\nimplement the declared slice; the catalog enumerates tested invariants. Accounting\nvalidity and empirical forecast validity are not established; human acceptance is\npending. History families remain Unknown/PartialSearch, with zero completed cells,\none unsearched cell and no invented witnesses or solver results. MC02/MC04/MC10/\nMC20/MC23/MC24 receive bounded evidence, while all MC01–MC35 and G1–G18 retain wider\nobligations.\n\nThe strongest alternative explanation for frontend agreement is a shared compiler\nbug. Independent arithmetic, comparison with corresponding authored IR fields and\nschema-valid corruptions constrain that explanation without proving the general\nlanguage. An in-profile counterexample would overturn this engineering result.\nNo stochastic ranking, performance comparison or authoring superiority is claimed.\n\nActual command: `{payload['manifest']['command']}`. Approved plan:\n`{APPROVED_PLAN}`. Environment: Python {platform.python_version()}, Lark\n{version('lark')}, jsonschema {version('jsonschema')}; CPU only, no accelerator\nframework imported. Check wall time: {payload['manifest']['wall_seconds']} seconds.\nGit commit unavailable; content hashes provide file provenance. Changed phase\nfiles and this execution's source changes are enumerated in the manifest. The\nstandalone unittest outcome and final integrity inspection are in progress.md.\n\nResiduals: {', '.join(catalog['unsupported'])}. General language support, arbitrary\nand cross-company mappings, broader uncertainty, reconstruction, accounting\nexecution and human acceptance require separate evidence.\n'''\n    out.mkdir(parents=True, exist_ok=True)\n    (out / 'conformance.json').write_text(json.dumps(payload, indent=2, ensure_ascii=True) + '\\n')\n    (out / 'result.md').write_text(result_text)\n    print(json.dumps({'passed': bool(passed), 'methods': result.testsRun,\n                      'obligations': status['obligations_run'], 'missing': status['missing'],\n                      'failures': len(result.failures) + len(result.errors),\n                      'protected_inputs_passed': protection['passed'],\n                      'protection_errors': protection['errors'],\n                      'changed_since_execution_entry': protection['changed_since_execution_entry'],\n                      'changed_during_check': protection['changed_during_check'],\n                      'historical_differences': historical_count}))\n    return 0 if passed else 1\n\n\nif __name__ == '__main__':\n    sys.exit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' tests/test_accounting_p03.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' tests/test_accounting_p03.py\"","aggregated_output":"\"\"\"Executed P03 obligations; authored typed inputs never pass through the parser.\"\"\"\nimport copy\nfrom dataclasses import replace\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'scripts'))\nimport core0_ir_v1 as ir\nfrom core0_frontends_v1 import compile_source\nimport jsonschema\n\nOBSERVATIONS = []\nBASE = (ROOT / 'docs/design/fixtures/borrowing.acc').read_text()\nREASON = 'Fixed-rate proportion not disclosed'\nRENAMED = '''module FinancingStudy version \"2\";\nuse DemoDebt version \"1\";\nsource disclosure = external(\"synthetic-note-7\");\nentity Beta functional USD;\nbook Statutory entity Beta basis DemoDebt version \"1\";\naccount Cash : Asset book Statutory;\naccount Debt : Liability book Statutory;\naccount InterestExpense : Expense book Statutory;\naccount Retained : Equity book Statutory;\nopening carried for Statutory from external(\"after-2025-close\");\nobservation borrowing : Money<USD> instant @2025-12-31 = 150 USD from disclosure;\nsymbol share : Real in [0, 1] because \"Fixed-rate proportion not disclosed\";\ncontract facility : DebtMix book Statutory {\n principal = value(borrowing); fixed_fraction = share;\n fixed_rate = 0.05 per year; initial_floating_rate = 0.05 per year;\n}\nalternative fixed { assume share == 1; }\nalternative floating { assume share == 0; }\nscenario shock { set market_rate = constant(0.08 per year); }\nreport financials for Statutory { mapping = external(\"DemoDebt.statements.v1\"); }\n'''\n\n\ndef bindings(principal=100, renamed=False):\n    \"\"\"Explicit synthetic evidence, separately authored from source and expected IR.\"\"\"\n    p = F(principal); stamp = '2026-01-01T00:00:00Z'\n    book, symbol = ('Statutory', 'share') if renamed else ('Local', 'alpha')\n    names = ('fixed', 'floating') if renamed else ('allFixed', 'allFloating')\n    package_path = ROOT / 'docs/design/fixtures/demo-debt-package.json'\n    return ir.CompileBindings(\n        packages=[ir.PackageBinding('DemoDebt', '1', hashlib.sha256(package_path.read_bytes()).hexdigest(),\n            'DemoDebt', '2025-01-01', '2028-01-01', ['reset','accrue_and_pay','close','statements'],\n            ['builtin:Core0@1','DemoCalendar@1'], ['fixture:demo-debt-package.json'])],\n        readings=[ir.ReadingBinding('synthetic-note-7', f'Synthetic disclosed debt {p} USD; split undisclosed', p,\n            'USD', '2025-12-31', 'fixture:p03-synthetic', 'synthetic-2025', stamp, stamp,\n            'synthetic-author', stamp, 'Explicit synthetic acceptance, not human approval', stamp,\n            system_as_of=stamp, action='Accept')],\n        openings=[ir.OpeningBinding('after-2025-close', '2025-12-31',\n            {'Cash':p-5, 'Debt':-p, 'InterestExpense':0, 'Retained':5}, book=book)],\n        reports=[ir.ReportBinding('DemoDebt.statements.v1','DemoDebt.statements.v1',\n            'interest_operating','close',['accrue_and_pay'])],\n        assumptions=[ir.AssumptionBinding(k, 'Synthetic explicit '+k, information_cutoff=stamp,\n            valid_start='2026-01-01',valid_end='2027-01-01')\n            for k in ('alternative','constraint','contract-rate','scenario')],\n        admissions=[ir.SymbolAdmission(symbol,'synthetic-note-7',REASON,'synthetic-author',stamp)],\n        alternatives=[ir.AlternativeBinding(n,'synthetic-author',stamp,'Synthetic endpoint') for n in names],\n        calendar_id='DemoCalendar@1',calendar_name='Gregorian',horizon_start='2026-01-01',\n        horizon_end='2027-01-01',symbol_uncertainty='HistoricalFact',\n        entity_perimeter='Beta-only' if renamed else 'Acme-only')\n\n\ndef typed(principal=100, stress=F(7,100), renamed=False, arithmetic=False):\n    mod, ver, src, ent, book, opening, obs, sym, contract, a1, a0, scenario, report = (\n        ('FinancingStudy','2','disclosure','Beta','Statutory','carried','borrowing','share','facility',\n         'fixed','floating','shock','financials') if renamed else\n        ('BorrowingExample','1','note7','Acme','Local','after2025','debt','alpha','loans',\n         'allFixed','allFloating','rateShock','statements'))\n    ds = [ir.SourceDecl(src,'synthetic-note-7'),ir.EntityDecl(ent,'USD'),ir.BookDecl(book,ent,'DemoDebt','1')]\n    ds += [ir.AccountDecl(n,r,book) for n,r in [('Cash','Asset'),('Debt','Liability'),('InterestExpense','Expense'),('Retained','Equity')]]\n    ds += [ir.OpeningDecl(opening,book,'after-2025-close'),\n           ir.ObservationDecl(obs,'Money<USD>','2025-12-31',ir.Literal(F(principal),unit='USD'),src),\n           ir.SymbolDecl(sym,'Real',ir.Literal(F(0)),ir.Literal(F(1)),REASON)]\n    fraction = ir.Ref(sym)\n    if arithmetic:\n        ds += [ir.LetDecl('mix',ir.Binary('/',ir.Binary('*',ir.Ref(sym),ir.Literal(F(2))),ir.Literal(F(2)))),\n               ir.ConstraintDecl('limit',ir.Binary('and',ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0))),\n                    ir.Binary('<=',ir.Ref(sym),ir.Literal(F(1)))))]\n        fraction=ir.Ref('mix')\n    ds += [ir.ContractDecl(contract,'DebtMix',book,[('principal',ir.Call('value',[ir.Ref(obs)])),\n           ('fixed_fraction',fraction),('fixed_rate',ir.Literal(F(1,20),unit='per year')),\n           ('initial_floating_rate',ir.Literal(F(1,20),unit='per year'))])]\n    for name,value in ((a1,1),(a0,0)):\n        conds=[ir.Binary('==',ir.Ref(sym),ir.Literal(F(value)))]\n        if arithmetic: conds += [ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0)))]\n        ds.append(ir.AlternativeDecl(name,conds))\n    ds += [ir.ScenarioDecl(scenario,[('market_rate',ir.Call('constant',[ir.Literal(F(stress),unit='per year')]))]),\n           ir.ReportDecl(report,book,ir.External('DemoDebt.statements.v1'))]\n    return ir.Program(mod,ver,ds,[ir.UseDecl('DemoDebt','1')])\n\n\ndef arithmetic_source():\n    return BASE.replace('contract loans', 'let mix = alpha * 2 / 2;\\nconstraint limit: alpha >= 0 and alpha <= 1;\\ncontract loans').replace(\n        'fixed_fraction = alpha;', 'fixed_fraction = mix;').replace('assume alpha == 1;', 'assume alpha == 1; assume alpha >= 0;').replace(\n        'assume alpha == 0;', 'assume alpha == 0; assume alpha >= 0;')\n\n\nSOURCE_NEGATIVES = {\n 'unknown_report_field': (lambda s:s.replace('mapping =', 'extra = 3; mapping ='),'ParseError'),\n 'duplicate_report_field': (lambda s:s.replace('mapping = external(\"DemoDebt.statements.v1\");','mapping = external(\"DemoDebt.statements.v1\"); mapping = external(\"DemoDebt.statements.v1\");'),'ParseError'),\n 'missing_rate_unit': (lambda s:s.replace('fixed_rate = 0.05 per year','fixed_rate = 0.05'),'MissingRateUnit'),\n 'unsupported_event': (lambda s:s+'\\nevent maturity() book Local;','UnsupportedDeclaration'),\n 'reserved_identifier': (lambda s:s.replace('entity Acme','entity report'),'ReservedIdentifier'),\n 'invalid_date': (lambda s:s.replace('@2025-12-31','@2025-02-30'),'InvalidDate'),\n 'invalid_escape': (lambda s:s.replace('Fixed-rate',r'Fixed\\qrate'),'ParseError'),\n 'invalid_surrogate': (lambda s:s.replace('Fixed-rate',r'Fixed\\ud800rate'),'InvalidString'),\n 'duplicate_declaration': (lambda s:s+'\\nentity Acme functional USD;','DuplicateDeclaration'),\n 'duplicate_contract_field': (lambda s:s.replace('fixed_fraction = alpha;', 'fixed_fraction = alpha; fixed_fraction = alpha;'),'DuplicateField'),\n 'unknown_reference': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = absent'),'UnknownReference'),\n 'cyclic_lets': (lambda s:s.replace('contract loans','let first = second; let second = first; contract loans'),'ExpressionCycle'),\n 'unsupported_call': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = sqrt(alpha)'),'UnsupportedExpression'),\n 'unsupported_array': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = [alpha, 1]'),'UnsupportedExpression'),\n 'unsupported_field': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha.part'),'UnsupportedExpression'),\n 'wrong_dimensions': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD + 1'),'TypeMismatch'),\n 'rate_product': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD * 0.05 per year'),'UnsupportedOperation'),\n 'zero_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha / 0'),'UnprovedNonzeroDenominator'),\n 'unproved_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 / alpha'),'UnprovedNonzeroDenominator'),\n 'bad_arity': (lambda s:s.replace('value(debt)','value(debt, debt)'),'ArityMismatch'),\n 'invalid_fraction_bounds': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha + 1'),'ContractDomain'),\n 'principal_disagreement': (lambda s:s.replace('principal = value(debt)','principal = 200 USD'),'ContractPrincipal'),\n 'malformed_syntax': (lambda s:s.replace('module BorrowingExample','module {'),'ParseError'),\n 'wrong_book': (lambda s:s.replace('account Cash : Asset book Local','account Cash : Asset book Elsewhere'),'BindingMismatch'),\n 'extra_scenario_setting': (lambda s:s.replace('set market_rate', 'set other = 1; set market_rate'),'ScenarioFields'),\n}\n\n\nclass P03Tests(unittest.TestCase):\n    def record(self, case, **values):\n        OBSERVATIONS.append(dict(id=case, passed=True, **values))\n\n    def test_checker_protection_provenance(self):\n        from check_accounting_p03 import capture_protection, finish_protection\n\n        def sha(text):\n            return hashlib.sha256(text.encode()).hexdigest()\n\n        # All mutations here affect disposable test inputs, never project files.\n        variants = ('historical_change', 'new_change', 'missing_file',\n                    'missing_inventory', 'empty_inventory', 'omitted_path',\n                    'during_check_change', 'during_check_delete',\n                    'inventory_change', 'duplicate_inventory', 'invalid_digest')\n        for variant in variants:\n            with self.subTest(variant=variant), tempfile.TemporaryDirectory() as folder:\n                root = Path(folder)\n                protected = root / 'protected.txt'\n                protected.write_text('current')\n                (root / 'contribution.py').write_text('worker edit')\n                historical = {'protected.txt': sha('historical')}\n                execution = {'protected.txt': sha('current'),\n                             'contribution.py': sha('before worker edit')}\n                (root / 'historical.json').write_text(json.dumps(historical))\n                (root / 'execution.json').write_text(json.dumps(execution))\n                if variant == 'new_change':\n                    protected.write_text('unauthorised change')\n                elif variant == 'missing_file':\n                    protected.unlink()\n                elif variant == 'missing_inventory':\n                    (root / 'execution.json').unlink()\n                elif variant == 'empty_inventory':\n                    (root / 'execution.json').write_text('{}')\n                elif variant == 'omitted_path':\n                    del execution['protected.txt']\n                    (root / 'execution.json').write_text(json.dumps(execution))\n                elif variant == 'duplicate_inventory':\n                    entry = '\"protected.txt\": \"' + sha('current') + '\"'\n                    (root / 'execution.json').write_text('{' + entry + ',' + entry + '}')\n                elif variant == 'invalid_digest':\n                    (root / 'execution.json').write_text('{\"protected.txt\": \"invalid\"}')\n                report = capture_protection(root, 'historical.json', 'execution.json',\n                                            writable=['contribution.py'])\n                if variant == 'during_check_change':\n                    protected.write_text('changed during check')\n                elif variant == 'during_check_delete':\n                    protected.unlink()\n                elif variant == 'inventory_change':\n                    (root / 'execution.json').write_text('{}')\n                finish_protection(root, report)\n                self.assertEqual(report['passed'], variant == 'historical_change', report)\n                self.assertNotIn('contribution.py', report['before'])\n                if variant == 'historical_change':\n                    self.assertEqual([r['path'] for r in report['historical_differences']],\n                                     ['protected.txt'])\n                    self.assertEqual(report['changed_since_execution_entry'], [])\n                if variant == 'new_change':\n                    self.assertEqual(report['changed_since_execution_entry'], ['protected.txt'])\n                if variant.startswith('during_check_'):\n                    self.assertEqual(report['changed_during_check'], ['protected.txt'])\n                self.record('checker_' + variant, protection_passed=report['passed'],\n                            errors=report['errors'],\n                            historical_differences=report['historical_differences'],\n                            changed_since_execution_entry=report['changed_since_execution_entry'],\n                            changed_during_check=report['changed_during_check'])\n\n    def test_checker_obligation_integrity(self):\n        from check_accounting_p03 import obligation_status\n        required = {'obligations': [{'id': 'one'}, {'id': 'two'}]}\n        observations = [{'id': 'one', 'passed': True}, {'id': 'two', 'passed': True}]\n        for name, catalog, observed, field, expected in (\n            ('missing', required, observations[:1], 'missing', ['two']),\n            ('uncatalogued', required, observations + [{'id': 'extra', 'passed': True}],\n             'uncatalogued', ['extra']),\n            ('duplicate_observation', required, observations * 2, 'duplicate_ids', ['one', 'two']),\n            ('duplicate_catalog', {'obligations': required['obligations'] * 2}, observations,\n             'duplicate_ids', ['one', 'two']),\n            ('failed_observation', required, [{'id': 'one', 'passed': False}, observations[1]],\n             'failed_observations', ['one']),\n        ):\n            with self.subTest(name=name):\n                status = obligation_status(catalog, observed)\n                self.assertEqual(status[field], expected)\n                self.record('checker_' + name, expected=expected, observed=status[field])\n\n    def success(self, source, program, b, case, expected):\n        before=ir.binding_projection(b); original=ir.binding_projection(program)\n        a=compile_source(source,b); t=ir.compile_program(program,b)\n        self.assertTrue(a.ok,[d.as_dict() for d in a.diagnostics]);self.assertTrue(t.ok,[d.as_dict() for d in t.diagnostics])\n        self.assertEqual(a.semantic_projection,t.semantic_projection)\n        self.assertEqual(a.binding_records,t.binding_records)\n        self.assertEqual(before,ir.binding_projection(b));self.assertEqual(original,ir.binding_projection(program))\n        self.assertEqual(a.ir,compile_source(source,b).ir)\n        fields={v['name']:v['expression'] for v in a.ir['contracts'][0]['fields']}\n        symbol=a.ir['symbols'][0]['id']; rates=[]\n        for alpha in (1,0):\n            ev=lambda eid:ir.evaluate_expression(a.ir,eid,{symbol:F(alpha)})\n            principal=ev(fields['principal']); weight=ev(fields['fixed_fraction']); fixed=ev(fields['fixed_rate'])\n            stress=ev(a.ir['scenarios'][0]['drivers'][0]['expression'])\n            rates.append(principal*(weight*fixed+(1-weight)*stress))\n        self.assertEqual(rates,list(map(F,expected)))\n        fam=a.ir['historyFamilies'][0]\n        self.assertEqual((fam['feasibility'],fam['coverage'],fam['completed_cells'],fam['unresolved_cells'],fam['witnesses'],fam['solver_results']),\n                         ('Unknown','PartialSearch',0,1,[],[]))\n        self.record(case,source=source,input_sha256=a.input_sha256,typed_sha256=t.input_sha256,\n                    ir=a.ir,typed_ir=t.ir,typed_program=ir.binding_projection(program),\n                    semantic_projection=a.semantic_projection,typed_semantic_projection=t.semantic_projection,\n                    bindings=a.binding_records,typed_bindings=t.binding_records,\n                    source_map=dict(a.source_map),typed_source_map=dict(t.source_map),\n                    expected_interest=list(map(str,expected)),observed_interest=list(map(str,rates)))\n        return a\n\n    def test_positive_pairs(self):\n        for case,source,program,b,expect in [\n          ('borrowing_baseline',BASE,typed(),bindings(),(5,7)),\n          ('borrowing_stress_09',BASE.replace('0.07 per year','0.09 per year'),typed(stress=F(9,100)),bindings(),(5,9)),\n          ('borrowing_principal_200',BASE.replace('= 100 USD','= 200 USD'),typed(200),bindings(200),(10,14)),\n          ('renamed_independent',RENAMED,typed(150,F(8,100),True),bindings(150,True),(F(15,2),12)),\n          ('borrowing_let_arithmetic',arithmetic_source(),typed(arithmetic=True),bindings(),(5,7))]:\n            with self.subTest(case=case):\n                result=self.success(source,program,b,case,expect)\n                if case=='borrowing_let_arithmetic':\n                    self.assertEqual(len(result.ir['historyFamilies'][0]['constraints']),1)\n                    self.assertEqual([len(a['constraints']) for a in result.ir['alternatives']],[2,2])\n\n    def test_formatting_and_spelling(self):\n        base=compile_source(BASE,bindings())\n        for name,source in [('borrowing_crlf_comment','// comment\\r\\n'+BASE.replace('\\n','\\r\\n')),\n                            ('decimal_spelling',BASE.replace('100 USD','100.00 USD'))]:\n            result=self.success(source,typed(),bindings(),name,(5,7))\n            self.assertEqual(base.semantic_projection,result.semantic_projection)\n            self.assertNotEqual(base.input_sha256,result.input_sha256)\n        for decl in ('Acme','Local','loans','statements'):\n            span=base.source_map[decl];self.assertIn(decl,BASE[span['start']:span['end']])\n        self.record('declaration_source_spans')\n\n    def test_source_rejections(self):\n        for name,(change,code) in SOURCE_NEGATIVES.items():\n            with self.subTest(case=name):\n                result=compile_source(change(BASE),bindings())\n                self.assertFalse(result.ok)\n                self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n","exit_code":0,"status":"completed"}}
