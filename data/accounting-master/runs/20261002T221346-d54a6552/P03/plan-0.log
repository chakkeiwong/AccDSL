{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '130,300p' tests/test_accounting_p03.py\"","aggregated_output":" 'malformed_syntax': (lambda s:s.replace('module BorrowingExample','module {'),'ParseError'),\n 'wrong_book': (lambda s:s.replace('account Cash : Asset book Local','account Cash : Asset book Elsewhere'),'BindingMismatch'),\n 'extra_scenario_setting': (lambda s:s.replace('set market_rate', 'set other = 1; set market_rate'),'ScenarioFields'),\n}\n\n\nclass P03Tests(unittest.TestCase):\n    def record(self, case, **values):\n        OBSERVATIONS.append(dict(id=case, passed=True, **values))\n\n    def success(self, source, program, b, case, expected):\n        before=ir.binding_projection(b); original=ir.binding_projection(program)\n        a=compile_source(source,b); t=ir.compile_program(program,b)\n        self.assertTrue(a.ok,[d.as_dict() for d in a.diagnostics]);self.assertTrue(t.ok,[d.as_dict() for d in t.diagnostics])\n        self.assertEqual(a.semantic_projection,t.semantic_projection)\n        self.assertEqual(a.binding_records,t.binding_records)\n        self.assertEqual(before,ir.binding_projection(b));self.assertEqual(original,ir.binding_projection(program))\n        self.assertEqual(a.ir,compile_source(source,b).ir)\n        fields={v['name']:v['expression'] for v in a.ir['contracts'][0]['fields']}\n        symbol=a.ir['symbols'][0]['id']; rates=[]\n        for alpha in (1,0):\n            ev=lambda eid:ir.evaluate_expression(a.ir,eid,{symbol:F(alpha)})\n            principal=ev(fields['principal']); weight=ev(fields['fixed_fraction']); fixed=ev(fields['fixed_rate'])\n            stress=ev(a.ir['scenarios'][0]['drivers'][0]['expression'])\n            rates.append(principal*(weight*fixed+(1-weight)*stress))\n        self.assertEqual(rates,list(map(F,expected)))\n        fam=a.ir['historyFamilies'][0]\n        self.assertEqual((fam['feasibility'],fam['coverage'],fam['completed_cells'],fam['unresolved_cells'],fam['witnesses'],fam['solver_results']),\n                         ('Unknown','PartialSearch',0,1,[],[]))\n        self.record(case,source=source,input_sha256=a.input_sha256,typed_sha256=t.input_sha256,\n                    ir=a.ir,bindings=a.binding_records,source_map=dict(a.source_map),typed_source_map=dict(t.source_map),\n                    expected_interest=list(map(str,expected)),observed_interest=list(map(str,rates)))\n        return a\n\n    def test_positive_pairs(self):\n        for case,source,program,b,expect in [\n          ('borrowing_baseline',BASE,typed(),bindings(),(5,7)),\n          ('borrowing_stress_09',BASE.replace('0.07 per year','0.09 per year'),typed(stress=F(9,100)),bindings(),(5,9)),\n          ('borrowing_principal_200',BASE.replace('= 100 USD','= 200 USD'),typed(200),bindings(200),(10,14)),\n          ('renamed_independent',RENAMED,typed(150,F(8,100),True),bindings(150,True),(F(15,2),12)),\n          ('borrowing_let_arithmetic',arithmetic_source(),typed(arithmetic=True),bindings(),(5,7))]:\n            with self.subTest(case=case):\n                result=self.success(source,program,b,case,expect)\n                if case=='borrowing_let_arithmetic':\n                    self.assertEqual(len(result.ir['historyFamilies'][0]['constraints']),1)\n                    self.assertEqual([len(a['constraints']) for a in result.ir['alternatives']],[2,2])\n\n    def test_formatting_and_spelling(self):\n        base=compile_source(BASE,bindings())\n        for name,source in [('borrowing_crlf_comment','// comment\\r\\n'+BASE.replace('\\n','\\r\\n')),\n                            ('decimal_spelling',BASE.replace('100 USD','100.00 USD'))]:\n            result=self.success(source,typed(),bindings(),name,(5,7))\n            self.assertEqual(base.semantic_projection,result.semantic_projection)\n            self.assertNotEqual(base.input_sha256,result.input_sha256)\n        for decl in ('Acme','Local','loans','statements'):\n            span=base.source_map[decl];self.assertIn(decl,BASE[span['start']:span['end']])\n        self.record('declaration_source_spans')\n\n    def test_source_rejections(self):\n        for name,(change,code) in SOURCE_NEGATIVES.items():\n            with self.subTest(case=name):\n                result=compile_source(change(BASE),bindings())\n                self.assertFalse(result.ok)\n                self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_typed_rejections(self):\n        p=typed(); contract=next(d for d in p.declarations if isinstance(d,ir.ContractDecl))\n        replacements={\n          'typed_missing_rate_unit':('fixed_rate',ir.Literal(F(1,20)),'MissingRateUnit'),\n          'typed_unknown_reference':('fixed_fraction',ir.Ref('absent'),'UnknownReference'),\n          'typed_unsupported_call':('fixed_fraction',ir.Call('sqrt',[ir.Ref('alpha')]),'UnsupportedExpression'),\n          'typed_float':('fixed_rate',ir.Literal(0.05,unit='per year'),'UnsupportedLiteral'),\n          'typed_invalid_bounds':('fixed_fraction',ir.Binary('+',ir.Ref('alpha'),ir.Literal(F(1))),'ContractDomain'),\n        }\n        for name,(field,value,code) in replacements.items():\n            with self.subTest(case=name):\n                bad=replace(contract,fields=[(k,value if k==field else v) for k,v in contract.fields])\n                result=ir.compile_program(replace(p,declarations=[bad if d is contract else d for d in p.declarations]),bindings())\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_binding_rejections(self):\n        b=bindings()\n        cases={\n         'missing_acceptance':(replace(b,readings=[replace(b.readings[0],action=None)]),'BindingAcceptance'),\n         'missing_admission':(replace(b,admissions=[]),'MissingSymbolAdmission'),\n         'missing_assumption':(replace(b,assumptions=[]),'MissingAssumptionMetadata'),\n         'missing_alternative':(replace(b,alternatives=[]),'MissingAlternativeMetadata'),\n         'ambiguous_reading':(replace(b,readings=b.readings*2),'AmbiguousBinding'),\n         'changed_reading':(replace(b,readings=[replace(b.readings[0],amount=200)]),'SourceReadingMismatch'),\n         'package_digest_binding':(replace(b,packages=[replace(b.packages[0],digest='0'*64)]),'PackageDigestMismatch'),\n         'package_horizon':(replace(b,horizon_end='2029-01-01'),'PackageValidity'),\n         'missing_perimeter':(replace(b,entity_perimeter=None),'MissingContext'),\n         'missing_calendar':(replace(b,calendar_id=None),'MissingContext'),\n         'wrong_report_policy_binding':(replace(b,reports=[replace(b.reports[0],cash_flow_policy='invented')]),'ReportMapping'),\n        }\n        for name,(bound,code) in cases.items():\n            with self.subTest(case=name):\n                result=compile_source(BASE,bound)\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_schema_valid_corruptions(self):\n        base=compile_source(BASE,bindings());self.assertTrue(base.ok)\n        schema=json.loads((ROOT/'docs/design/spec/core-ir.schema.json').read_text())\n        for name,(change,code) in IR_NEGATIVES.items():\n            with self.subTest(case=name):\n                bad=copy.deepcopy(base.ir);change(bad)\n                jsonschema.Draft202012Validator(schema).validate(bad)\n                result=ir.validate_ir(bad,bindings())\n                self.assertFalse(result.ok);self.assertEqual(result.diagnostics[0].code,code)\n                self.record(name,schema_valid=True,expected=code,diagnostics=[d.as_dict() for d in result.diagnostics])\n\n    def test_no_expected_fixture_input(self):\n        original=Path.read_text\n        def guarded(path,*a,**kw):\n            if path.name in {'borrowing.ir.json','borrowing.expected.json','borrowings.json','core-ir-demo.json'}:\n                raise AssertionError('Compiler tried reading expected fixture')\n            return original(path,*a,**kw)\n        with patch.object(Path,'read_text',guarded):\n            self.assertTrue(ir.compile_program(typed(),bindings()).ok)\n            self.assertTrue(compile_source(BASE,bindings()).ok)\n        self.record('no_expected_fixture_input')\n\n\n    def test_authored_fields_and_legacy_validation(self):\n        from core_semantics import validate\n        authored=json.loads((ROOT/'docs/design/fixtures/core-ir-demo.json').read_text())\n        registry=json.loads((ROOT/'docs/design/fixtures/core-demo-registry.json').read_text())\n        schema=json.loads((ROOT/'docs/design/spec/core-ir.schema.json').read_text())\n        legacy=validate(authored,registry,schema,ROOT)\n        self.assertEqual(legacy['status'],'passed',legacy)\n        generated=compile_source(BASE,bindings()).ir\n        for name in ('entity','perimeter','concept','basis','measurement','time','unit','currency','dimensions'):\n            self.assertEqual(authored['contexts'][0][name],generated['contexts'][0][name])\n        for name in ('lower','upper','kind','lower_closed','upper_closed'):\n            self.assertEqual(authored['observations'][0]['domain'][name],generated['observations'][0]['domain'][name])\n        for name in ('closing_policy','cash_flow_policy','required_operations'):\n            self.assertEqual(authored['reportMappings'][0][name],generated['reportMappings'][0][name])\n        for alpha in (0,1):\n            for field in ('principal','fixed_fraction','fixed_rate','initial_floating_rate'):\n                values=[]\n                for doc in (authored,generated):\n                    eid=next(f['expression'] for f in doc['contracts'][0]['fields'] if f['name']==field)\n                    values.append(ir.evaluate_expression(doc,eid,{'alpha':F(alpha)}))\n                self.assertEqual(*values)\n        self.record('authored_fields_and_legacy',legacy=legacy)\n\n    def test_unicode_and_global_preservation(self):\n        left=compile_source(BASE+'\\nlet caption = \"caf\\u00e9\";',bindings())\n        right=compile_source(BASE+'\\nlet caption = \"cafe\\u0301\";',bindings())\n        self.assertTrue(left.ok); self.assertTrue(right.ok)\n        self.assertEqual(left.semantic_projection,right.semantic_projection)\n        self.assertNotEqual(left.input_sha256,right.input_sha256)\n        self.record('unicode_normalization')\n        r=compile_source(arithmetic_source(),bindings()); self.assertTrue(r.ok)\n        r.ir['historyFamilies'][0]['constraints']=[]\n        check=ir.validate_ir(r.ir,bindings());self.assertFalse(check.ok)\n        self.assertEqual(check.diagnostics[0].code,'FamilyMembership')\n        self.record('lost_global_constraint',diagnostics=[d.as_dict() for d in check.diagnostics])\n\n\ndef expression(doc, suffix):\n    return next(e for e in doc['expressions'] if e['id'].endswith(suffix))\n\nIR_NEGATIVES = {\n 'ir_renamed_assumption_metadata':(lambda d:d['assumptions'][0].update(id='renamed',rationale='invented'),'AssumptionBinding'),\n 'ir_lost_rate_assumption':(lambda d:d['assumptions'].pop(2),'MissingAssumption'),\n 'ir_missing_assumptions':(lambda d:d.update(assumptions=[]),'MissingAssumption'),\n 'ir_missing_report':(lambda d:d.update(reportMappings=[]),'ProfileCardinality'),\n","exit_code":0,"status":"completed"}}
