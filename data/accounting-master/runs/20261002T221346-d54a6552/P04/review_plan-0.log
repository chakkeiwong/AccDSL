dict[str, Any]]:\nscripts/check_accounting_p03.py:2:\"\"\"Execute catalogued P03 obligations with durable protection provenance.\"\"\"\nscripts/check_accounting_p03.py:6:import hashlib\nscripts/check_accounting_p03.py:26:PHASE_INVENTORY = 'data/accounting-master/runs/20261002T181809-4cb566e0/P03/phase-entry-inventory.json'\nscripts/check_accounting_p03.py:31:def digest(path):\nscripts/check_accounting_p03.py:33:        return hashlib.sha256(path.read_bytes()).hexdigest()\nscripts/check_accounting_p03.py:38:def _unique_object(pairs):\nscripts/check_accounting_p03.py:42:            raise ValueError('duplicate inventory key: ' + key)\nscripts/check_accounting_p03.py:47:def _inventory(root, relative):\nscripts/check_accounting_p03.py:50:        raise ValueError('inventory path must be repository-relative')\nscripts/check_accounting_p03.py:53:        raise ValueError('inventory must be a nonempty path-to-SHA256 object')\nscripts/check_accounting_p03.py:58:            raise ValueError('invalid inventory entry: ' + name)\nscripts/check_accounting_p03.py:62:def capture_protection(root, historical_path, execution_path, writable=PHASE_FILES,\nscripts/check_accounting_p03.py:69:            inventories.append(_inventory(root, name))\nscripts/check_accounting_p03.py:74:    protected = sorted((set(historical) | set(execution) | set(required_paths)) - set(writable))\nscripts/check_accounting_p03.py:75:    absent = sorted(set(protected) - set(execution))\nscripts/check_accounting_p03.py:77:        errors.append('execution inventory omits protected paths: ' + ', '.join(absent))\nscripts/check_accounting_p03.py:78:    before = {p: digest(root / p) for p in protected}\nscripts/check_accounting_p03.py:80:        'historical_inventory': historical_path,\nscripts/check_accounting_p03.py:81:        'execution_inventory': execution_path,\nscripts/check_accounting_p03.py:82:        'inventory_hashes': {p: digest(root / p) for p in (historical_path, execution_path)},\nscripts/check_accounting_p03.py:85:        'execution_baseline': {p: execution.get(p) for p in protected},\nscripts/check_accounting_p03.py:88:        'changed_since_execution_entry': [p for p in protected if before[p] != execution.get(p)],\nscripts/check_accounting_p03.py:91:             'attribution': 'Predates this execution, as recorded by the supervisor pre-edit inventory.'}\nscripts/check_accounting_p03.py:97:def finish_protection(root, report):\nscripts/check_accounting_p03.py:100:    report['changed_inventory_records'] = [p for p, h in report['inventory_hashes'].items()\nscripts/check_accounting_p03.py:104:        'changed_during_check', 'changed_inventory_records'))\nscripts/check_accounting_p03.py:108:def obligation_status(catalog, observations):\nscripts/check_accounting_p03.py:121:def main(argv=None):\nscripts/check_accounting_p03.py:124:    parser.add_argument('--execution-inventory', default=EXECUTION_INVENTORY)\nscripts/check_accounting_p03.py:131:    protection = capture_protection(ROOT, PHASE_INVENTORY, args.execution_inventory,\nscripts/check_accounting_p03.py:137:    plan_hash = digest(ROOT / APPROVED_PLAN)\nscripts/check_accounting_p03.py:138:    if plan_hash is None:\nscripts/check_accounting_p03.py:139:        protection['errors'].append('approved plan is missing or unreadable')\nscripts/check_accounting_p03.py:143:            protection['errors'].append('approved plan lacks an issue-free AGREE review')\nscripts/check_accounting_p03.py:153:    finish_protection(ROOT, protection)\nscripts/check_accounting_p03.py:156:    if digest(ROOT / APPROVED_PLAN) != plan_hash:\nscripts/check_accounting_p03.py:157:        protection['errors'].append('approved plan changed during check')\nscripts/check_accounting_p03.py:158:        protection['passed'] = False\nscripts/check_accounting_p03.py:160:              and bool(status['obligations_required']) and not changed_code and protection['passed']\nscripts/check_accounting_p03.py:174:            'plan': APPROVED_PLAN, 'plan_sha256': plan_hash,\nscripts/check_accounting_p03.py:175:            'execution_inventory': args.execution_inventory,\nscripts/check_accounting_p03.py:178:                if code_after[p] != _inventory(ROOT, args.execution_inventory).get(p)]\nscripts/check_accounting_p03.py:179:                if not protection['errors'] else 'unavailable: protection evidence failed'},\nscripts/check_accounting_p03.py:183:        'observations': cases.OBSERVATIONS, 'hashes': code_after,\nscripts/check_accounting_p03.py:185:        'protected_files': protection,\nscripts/check_accounting_p03.py:201:    historical_count = len(protection['historical_differences'])\nscripts/check_accounting_p03.py:226:| {decision} for bounded engineering conformance | frontend agreement, input sensitivity and semantic rejection jointly tested | missing={len(status['missing'])}; uncatalogued={len(status['uncatalogued'])}; duplicate={len(status['duplicate_ids'])}; failed observations={len(status['failed_observations'])}; test failures/errors={len(result.failures)+len(result.errors)}; skips={len(result.skipped)}; protected inputs passed={protection['passed']}; changed check inputs={len(changed_code)} | language breadth and shared-implementation bugs | independent result review if PASS; focused repair if FAIL | full G2/G12/G15 closure, accounting validity, forecast validity or human acceptance |\nscripts/check_accounting_p03.py:228:Protection uses the durable historical inventory `{PHASE_INVENTORY}` and current\nscripts/check_accounting_p03.py:229:supervisor execution inventory `{args.execution_inventory}`. There are\nscripts/check_accounting_p03.py:232:inventory evidence, absent protected paths, changes since execution entry or\nscripts/check_accounting_p03.py:234:Conformance JSON preserves the inventory hashes, per-file baselines, actual IR,\nscripts/check_accounting_p03.py:235:bindings, source maps, input hashes, diagnostics and the complete unittest output.\nscripts/check_accounting_p03.py:255:Git commit unavailable; content hashes provide file provenance. Changed phase\nscripts/check_accounting_p03.py:269:                      'protected_inputs_passed': protection['passed'],\nscripts/check_accounting_p03.py:270:                      'protection_errors': protection['errors'],\nscripts/check_accounting_p03.py:271:                      'changed_since_execution_entry': protection['changed_since_execution_entry'],\nscripts/check_accounting_p03.py:272:                      'changed_during_check': protection['changed_during_check'],\n| MC08 | Preserve jointly consistent discrete alternatives and continuous unknowns across accounts, notes and dates. U2, D. | Define history-family and choice/constraint semantics; provide cases preserving linked alternatives and rejecting incompatible combinations without independent account-by-account selection. | Specified shared symbols, choices and joint formulas in Chs. 2, 6–8. Exact reference checks retain fixed/floating histories, reject incompatible debt and reject incompatible marginal extrema. General reconstruction implementation remains pending. G1, G2, G15. |\n| MC09 | Construct historical families through a specified method, with honest scope and search completeness. U2, U3, D. | Define candidate templates, model-scope records, instantiation and constraint lowering, feasible/infeasible/unknown results, truncation and coverage evidence. | Specified finite template/slot construction and coverage rules in Ch. 6/Core 0. Northstar bridges are solved and checked within the declared scope; completeness concerns that model only. A compiler for arbitrary supported template registries remains pending. G1, G3. |\n| MC10 | Distinguish uncertainty about facts, disclosure readings, admissible accounting treatment, estimates, behaviour and future shocks. U2, P, D. | Specify the categories, dependencies and admissibility checks; show why a factual unknown, permitted election and unsupported treatment cannot be substituted for one another. | Specified six uncertainty kinds with separate admission/provenance/dependency rules in Core 0 and Chs. 6–8. Examples distinguish factual composition, permitted inventory election and unsupported treatment. Factual/assumption admission is now tested for the authored debt case; all-category semantic validation remains pending. G6, G15. |\n| MC11 | Preserve the economic memory and scenario responses needed when histories are aggregated or refined. U2, D. | Define required state by contract/lot/cohort, permitted grouping transformations, supported horizon/scenarios, exact versus approximate status and invalidation when the query changes. | Specified grouping keys, additive transition/report proof, exact/approximate status and query invalidation in Ch. 6/Core 0. Debt, lot and cohort counterexamples are given; a general equivalence checker or empirical approximate-cohort error bound is not established. G1, G16. |\n| MC12 | Add probabilities only under an explicit justified joint measure, and retain unweighted alternatives when weights are unsupported. U2, P, D. | Specify optional weight/prior/likelihood records, dependence, overlaps, updates and mass preservation; provide a worked weighted and unweighted example with clear interpretation. | Specified finite joint weighting and one-use likelihood update in Ch. 6/Core 0; exact posterior 3/11 and 8/11, mixture and retained unresolved mass are checked. Continuous inference requires a target-specific method and validation. G2, G6, G15. |\n\n","exit_code":0,"status":"completed"}}
