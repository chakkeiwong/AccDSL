s/06-language.tex-143-endpoints exhaust it. Requesting the parent family's exact bounds produces\ndocs/design/chapters/06-language.tex-144-$[5,7]$ for the next year's expense in this simple model. Requesting a\ndocs/design/chapters/06-language.tex:145:conditional run of \\code{allFixed} supplies $\\alpha=1$. Requesting a weighted\ndocs/design/chapters/06-language.tex-146-mixture requires a separate weight model; the two labels do not create equal\ndocs/design/chapters/06-language.tex-147-weights.\ndocs/design/chapters/06-language.tex-148-\ndocs/design/chapters/06-language.tex-149-An observation declaration is a reference to evidence plus a proposed typed\n52-are Cash, Debt, InterestExpense and Retained, with Asset, Liability, Expense and\n53-Equity roles respectively: the package report actually names these accounts.\n54-Other declaration names may vary. There may be multiple lets, Boolean constraints\n55:and conditional alternatives, with multiple assumptions in each alternative.\n56:Global constraints constrain the parent family; alternative constraints stay in\n57-their respective branches and are not conjoined in the parent. No branch is\n58-selected or solved.\n59-\n            debt = bindings.readings[0].amount\n            if principal != debt or any(dict(o.balances).get(\"Debt\") != -debt for o in bindings.openings):\n                raise _Failure(Diagnostic(\"ContractPrincipal\", \"principal must equal accepted debt and opening liability\", row[\"id\"]))\n            for name in (\"fixed_rate\", \"initial_floating_rate\"):\n                value = checker.expr(fields[name])[2]\n                if not isinstance(value, Fraction) or value < 0:\n                    raise _Failure(Diagnostic(\"ContractDomain\", f\"{name} must be a nonnegative constant\", row[\"id\"]))\n        alternatives = {r[\"id\"]: r for r in ir[\"alternatives\"]}\n        for row in ir[\"alternatives\"]:\n            if row[\"parent\"] not in {r[\"id\"] for r in ir[\"historyFamilies\"]} or row[\"scope\"] not in scope_ids:\n                raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative parent or scope is unknown\", row[\"id\"]))\n            meta = next((a for a in bindings.alternatives if a.name == row[\"id\"]), None)\n            if meta is None or row[\"author\"] != meta.author or row[\"created_at\"] != meta.created_at or row[\"reason\"] != meta.reason:\n                raise _Failure(Diagnostic(\"AlternativeMetadata\", \"alternative metadata differs from binding\", row[\"id\"]))\n            if not row[\"constraints\"]:\n                raise _Failure(Diagnostic(\"MissingAlternativeCondition\", \"alternative requires at least one condition\", row[\"id\"]))\n            for cid in row[\"constraints\"]:\n                c = next((x for x in ir[\"constraints\"] if x[\"id\"] == cid), None)\n                if c is None or c[\"scope\"] != row[\"id\"] or checker.expr(c[\"expression\"])[0] != \"Bool\":\n                    raise _Failure(Diagnostic(\"AlternativeScope\", \"alternative condition is not scoped to its branch\", row[\"id\"]))\n        for row in ir[\"states\"]:\n            total = Fraction(0); seen = set()\n            for balance in row[\"balances\"]:\n                if balance[\"account\"] in seen:\n                    raise _Failure(Diagnostic(\"DuplicateBalance\", \"opening account occurs twice\", row[\"id\"]))\n                seen.add(balance[\"account\"]); total += parse_rational(balance[\"signed_amount\"])\n            if total != 0:\n                raise _Failure(Diagnostic(\"UnbalancedState\", \"opening balances do not sum to zero\", row[\"id\"]))\n            expected_accounts = {a[\"id\"] for a in ir[\"accounts\"] if a[\"book\"] == row[\"book\"]}\n            if seen != expected_accounts:\n                raise _Failure(Diagnostic(\"IncompleteState\", \"opening state must include every account\", row[\"id\"]))\n            opening = next((o for o in bindings.openings\n                            if row[\"date\"] == o.date and row[\"book\"] == (o.book or row[\"book\"]) and\n                            {name: rational(value) for name, value in o.balances} ==\n                            {b[\"account\"]: b[\"signed_amount\"] for b in row[\"balances\"]}), None)\n            if opening is None:\n                raise _Failure(Diagnostic(\"OpeningStateMismatch\", \"opening state differs from bound opening export\", row[\"id\"]))\n            if row[\"contracts\"] != [c[\"id\"] for c in ir[\"contracts\"]]:\n                raise _Failure(Diagnostic(\"OpeningStateMismatch\", \"opening state must retain active contract\", row[\"id\"]))\n        for row in ir[\"historyFamilies\"]:\n            if row[\"feasibility\"] == \"Feasible\" and not row[\"witnesses\"]:\n                raise _Failure(Diagnostic(\"MissingWitness\", \"feasible family requires a witness\", row[\"id\"]))\n            if row[\"coverage\"] == \"ExactWithinScope\" and (row[\"unresolved_cells\"] or not row[\"completed_cells\"]):\n                raise _Failure(Diagnostic(\"FalseCoverage\", \"exact coverage requires completed cells and no unresolved cells\", row[\"id\"]))\n            if row[\"coverage\"] != \"PartialSearch\" or row[\"feasibility\"] != \"Unknown\" or row[\"completed_cells\"] != 0 or row[\"unresolved_cells\"] != 1:\n                raise _Failure(Diagnostic(\"CoverageClaim\", \"Core0.1 family must remain explicitly unsearched\", row[\"id\"]))\n            expected_constraints = {c[\"id\"] for c in ir[\"constraints\"] if c[\"scope\"] == row[\"scope\"]}\n            if set(row[\"constraints\"]) != expected_constraints or row[\"witnesses\"] or row[\"solver_results\"]:\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family must retain global constraints without invented search evidence\", row[\"id\"]))\n            if set(row[\"symbols\"]) != {s[\"id\"] for s in ir[\"symbols\"]} or set(row[\"alternatives\"]) != set(alternatives):\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family must retain all shared symbols and alternatives\", row[\"id\"]))\n            if row[\"evidence_view\"] not in views or row[\"opening_state\"] not in {s[\"id\"] for s in ir[\"states\"]}:\n                raise _Failure(Diagnostic(\"FamilyMembership\", \"family evidence/opening references are unknown\", row[\"id\"]))\n        for row in ir[\"scenarios\"]:\n            for driver in row[\"drivers\"]:\n                info = checker.expr(driver[\"expression\"])\n                if info[0] != \"Driver<Rate<annual_simple>>\" or not isinstance(info[2], Fraction) or info[2] < 0:\n                    raise _Failure(Diagnostic(\"ScenarioType\", \"scenario driver must be a constant annual rate\", row[\"id\"]))\n        for row in ir[\"reportMappings\"]:\n            if not row[\"rows\"] or row[\"rows\"][0][\"expression\"] not in checker.memo:\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping expression is not compiled\", row[\"id\"]))\n","exit_code":0,"status":"completed"}}
