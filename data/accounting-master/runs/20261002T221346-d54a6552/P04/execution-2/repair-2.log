{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,135p' tests/test_accounting_p04.py\"","aggregated_output":"\"\"\"Independent input replay and exact algebra; P04 executed obligations.\"\"\"\nimport copy\nfrom dataclasses import replace\nfrom fractions import Fraction as F\nfrom itertools import product\nimport json\nfrom pathlib import Path\nimport sys\nimport unittest\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'scripts'))\nimport z3\nfrom rational_solver_v1 import *\nfrom reconstruction_v1 import *\nfrom test_accounting_p03 import bindings, BASE\nfrom core0_frontends_v1 import compile_source\nROOT=Path(__file__).resolve().parents[1]\nOBSERVATIONS=[]\nB=Budget(20,10000,500,500,20000,1000,1000000)\n\n\ndef spec():\n    return json.loads((ROOT/'docs/design/fixtures/p04-reconstruction-cases-v1.json').read_text())['input_fixture']\n\n\ndef observation(s,amount):\n    return {'id':'cash-note','context':copy.deepcopy(s['context']),'action':'Accept','source':['synthetic:cash-note'],\n            'mapping':'cash','domain':{'lower':str(amount),'upper':str(amount),'lower_closed':True,'upper_closed':True}}\n\n\nclass ReconstructionTests(unittest.TestCase):\n    def record(self,name,result):OBSERVATIONS.append({'obligation':name,'passed':True,'result':result})\n    def test_independent_enumeration(self):\n        evidence=[]\n        # Oracle replays original template incidence; no production expressions or Z3.\n        for opening,total,limit,coefficient in [(10,13,3,1),(4,8,4,1),(7,13,3,2)]:\n            s=spec();s['opening']={'Cash':str(opening),'Equity':str(-opening)}\n            s['templates']['sale']['postings']={'Cash':str(coefficient),'Equity':str(-coefficient)}\n            for row in s['slots']:row['integer_bounds']=[0,limit]\n            s['observations']=[observation(s,total)]\n            p=construct(s);r=solve(p,B)\n            actual={(int(F(c['witness']['a'])),int(F(c['witness']['b']))) for c in r['cells'] if c['feasibility']=='sat'}\n            expected=set()\n            for a,b in product(range(limit+1),repeat=2):\n                cash=F(opening)\n                for amount in (a,b):cash+=F(coefficient)*amount\n                if cash==total:expected.add((a,b))\n            self.assertEqual(actual,expected);self.assertEqual(r['status'],'ExactWithinScope')\n            for c in r['cells']:\n                if c['feasibility']=='sat':self.assertEqual(F(c['outputs']['cash'])+F(c['outputs']['equity']),0)\n            s['slots'].reverse();rr=solve(construct(s),B)\n            self.assertEqual({tuple(c['witness'][n] for n in ('a','b')) for c in rr['cells'] if c['feasibility']=='sat'},\n                             {tuple(c['witness'][n] for n in ('a','b')) for c in r['cells'] if c['feasibility']=='sat'})\n            evidence.append({'inputs':s,'oracle':sorted(expected),'actual':r})\n        self.record('enumeration',evidence)\n    def test_p03_parent_views(self):\n        source=BASE.replace('alternative allFixed { assume alpha == 1; }','alternative allFixed { assume alpha <= 0.75; }').replace('alternative allFloating { assume alpha == 0; }','alternative allFloating { assume alpha >= 0.25; }')\n        results=[]\n        for text in (BASE,source):\n            c=compile_source(text,bindings());self.assertTrue(c.ok)\n            p=from_p03(c.ir,bindings(),{'DemoDebt@1/DebtMix':'fixed-floating-amounts-v1'})\n            self.assertFalse(p.unsupported)\n            r=solve(p,B,p.outputs['interest']);self.assertEqual(r['bounds']['lower']['value'],'5');self.assertEqual(r['bounds']['upper']['value'],'7')\n            self.assertEqual(r['coverage']['total'],1)\n            half=p.variables['alpha']==q('1/2')\n            self.assertEqual(solve(p,B,extra=[half])['feasibility'],'Feasible')\n            both=solve(p,B,selected_views=['allFixed','allFloating'],view_operator='intersection',extra=[half])\n            self.assertEqual(both['feasibility'],'Infeasible' if text==BASE else 'Feasible')\n            fixed=solve(p,B,selected_views=['allFixed'],extra=[half])\n            self.assertEqual(fixed['feasibility'],'Infeasible' if text==BASE else 'Feasible')\n            self.assertEqual(solve(p,B,extra=[half])['feasibility'],'Feasible')\n            results.append({'parent':r,'intersection':both,'conditional':fixed})\n        self.record('p03_views',results)\n    def test_rounded_strict_and_unbounded(self):\n        fixture=json.loads((ROOT/'docs/design/fixtures/borrowings.json').read_text())['rounded']\n        p=Problem('rounded-debt','fixture');f,v=z3.Reals('F V');p.variables={'F':f,'V':v}\n        p.add('amounts',z3.And(f>=0,v>=0));p.add('debt-note',z3.And(f+v>=q(fixture['debt'][0]),f+v<q(fixture['debt'][1])))\n        p.add('interest-note',z3.And(q('.05')*(f+v)>=q(fixture['interest'][0]),q('.05')*(f+v)<q(fixture['interest'][1])))\n        r=solve(p,B,q('.05')*f+q('.07')*v)\n        self.assertEqual(r['bounds']['lower']['value'],'199/40');self.assertTrue(r['bounds']['lower']['attained'])\n        self.assertEqual(r['bounds']['upper']['value'],'1407/200');self.assertFalse(r['bounds']['upper']['attained'])\n        x=z3.Real('x');empty=Problem('empty','fixture',variables={'x':x});empty.add('strict',x>0);empty.add('closed',x<=0)\n        self.assertEqual(solve(empty,B,x)['status'],'Infeasible')\n        u=Problem('unbounded','fixture',variables={'x':x});u.add('positive',x>0)\n        un=solve(u,B,x);self.assertEqual(un['bounds']['upper']['status'],'Unbounded');self.assertFalse(un['bounds']['lower']['attained'])\n        const=solve(u,B,q(2));self.assertTrue(const['bounds']['lower']['attained'])\n        self.record('strict_bounds',{'rounded':r,'unbounded':un,'constant':const})\n    def test_rounding_and_integer_gaps(self):\n        self.assertEqual([half_even(x,'1') for x in ['-2.5','-1.5','1.5','2.5']],[F(-2),F(-2),F(2),F(2)])\n        self.assertTrue(disclosure_domain('2','1','half_even')['upper_closed']);self.assertFalse(disclosure_domain('3','1','half_even')['lower_closed'])\n        self.assertEqual(half_even('.005','.01')+half_even('.005','.01'),0);self.assertEqual(half_even('.010','.01'),F('.01'))\n        p=Problem('integer-gap','fixture',variables={'k':z3.Int('k')},finite={'k':range(0,3)})\n        p.add('gap',z3.And(p.variables['k']>0,p.variables['k']<1));self.assertEqual(solve(p,B)['status'],'Infeasible')\n        self.record('rounding_integer',{'negative_ties':'checked','posting_boundary':'checked','integer':solve(p,B)})\n    def test_incomplete_unsupported_unknown(self):\n        s=spec();p=construct(s)\n        zero=solve(p,replace(B,max_cells=0));self.assertEqual(zero['coverage']['completed'],0)\n        partial=solve(p,replace(B,max_cells=1),p.outputs['cash']);self.assertEqual(partial['status'],'PartialSearch');self.assertFalse(partial['bounds']['upper']['certified'])\n        class UnknownBackend(Backend):\n            def check(self,solver,stage):return z3.unknown\n        unknown=solve(p,B,backend=UnknownBackend());self.assertEqual(unknown['feasibility'],'Unknown')\n        x,y=z3.Reals('x y');p=Problem('nonlinear','fixture',variables={'x':x,'y':y});p.add('nonlinear',x*y==1)\n        self.assertEqual(solve(p,B)['status'],'UnsupportedFragment')\n        p=Problem('unbounded-int','fixture',variables={'k':z3.Int('k')});self.assertEqual(solve(p,B)['status'],'UnsupportedFragment')\n        s['obligations']=['unmatched source'];self.assertEqual(solve(construct(s),B)['status'],'PartialSearch')\n        self.record('coverage_unknown',{'zero':zero,'partial':partial,'unknown':unknown})\n    def test_identity_context_conflicts(self):\n        s=spec();s['observations']=[observation(s,13)];s['observations']*=2\n        p=construct(s);self.assertEqual(sum(n=='observation:cash-note' for n,e in p.constraints),1)\n        bad=copy.deepcopy(s);bad['observations'][1]=observation(bad,14)\n        with self.assertRaises(ValueError):construct(bad)\n        bad=copy.deepcopy(s);bad['observations'][0]['context']['currency']='EUR'\n        with self.assertRaises(ValueError):construct(bad)\n        s['constraints']=[{'id':'source:contradiction','expression':['<','cash','0']}]\n        r=solve(construct(s),B);self.assertEqual(r['status'],'Infeasible')\n        self.assertTrue(all(c['conflict']['rechecked']=='unsat' for c in r['cells']))\n        self.record('identity_conflicts',r)\n    def test_admission_measure_grouping(self):\n        accepted=[]\n        for kind,fields in ADMISSION_FIELDS.items():\n            a={'id':kind,'scope':'synthetic','provenance':['synthetic'],'dependencies':[],'kind':kind}\n            a.update({k:'declared' for k in fields})\n            if kind=='ExtractionReading':a['review_decision']='Accept'\n            if kind=='AccountingElection':a.update(permitted_treatments=['FIFO'],election='FIFO')\n            accepted.append(admit(a));bad=dict(a);del bad[fields[0]]\n            with self.assertRaises(ValueError):admit(bad)\n        measure=FiniteMeasure([{'id':'fixed','hypothesis':{'economic_state':'fixed'},'weight':'3/5','status':'complete','outcome':'5'}, {'id':'floating','hypothesis':{'economic_state':'floating'},'weight':'2/5','status':'unsupported','outcome':None}], 'explicit synthetic joint prior')\n        posterior=measure.update({'fixed':'1/5','floating':'4/5'},['new-note'])\n        self.assertEqual([a['weight'] for a in posterior.atoms],['3/11','8/11']);self.assertIsNone(measure.summary()['mean'])\n        with self.assertRaises(ValueError):posterior.update({'fixed':'1','floating':'1'},['new-note'])\n        with self.assertRaises(ValueError):measure.update({'fixed':'0','floating':'0'},['zero'])\n        with self.assertRaises(ValueError):weighted_summary([])\n        contracts=[{'id':str(i),'principal':str(10+i),'rate':'1/20','reset':'fixed','maturity':'2030','hedge':'none'} for i in range(2)]\n        scenario={'rate':'7/100','year_fraction':'1'};horizon=['2026','2027'];group=group_contracts(contracts,scenario,horizon)\n        for key,value in [('rate','1/10'),('maturity','2031')]:\n            altered=copy.deepcopy(contracts);altered[0][key]=value\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat scripts/check_accounting_p04.py'","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Execute P04 obligations, regress P03, and retain supervisor inventory evidence.\"\"\"\nimport argparse\nfrom collections import Counter\nfrom datetime import datetime, timezone\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport shlex\nimport sys\nimport time\nimport unittest\nimport z3\nfrom check_accounting_p03 import capture_protection, finish_protection, digest\nROOT=Path(__file__).resolve().parents[1]\nINVENTORY='data/accounting-master/runs/20261002T221346-d54a6552/P04/phase-entry-inventory.json'\nPLAN='data/accounting-master/runs/20261002T221346-d54a6552/P04/approved-plan.json'\nSOURCES=['scripts/rational_solver_v1.py','scripts/reconstruction_v1.py','scripts/check_accounting_p04.py','tests/test_accounting_p04.py','docs/design/spec/reconstruction-profile-v1.md','docs/design/fixtures/p04-reconstruction-cases-v1.json']\nOUTPUTS=['data/accounting-master/deliverables/P04/'+p for p in ('conformance.json','result.md','progress.md')]\n\ndef main(argv=None):\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--output-dir',required=True)\n    parser.add_argument('--execution-inventory',required=True)\n    args=parser.parse_args(argv)\n    if Path(args.output_dir).resolve()!=ROOT/'data/accounting-master/deliverables/P04':\n        parser.error('use the declared P04 output directory')\n    if args.execution_inventory!=INVENTORY:\n        parser.error('use the supplied supervisor phase-entry inventory')\n    os.environ['CUDA_VISIBLE_DEVICES']='-1'\n    started=time.monotonic();utc=datetime.now(timezone.utc).isoformat()\n    protected=capture_protection(ROOT,INVENTORY,INVENTORY,writable=SOURCES+OUTPUTS,\n                                 required_paths=('docs/design/fixtures/borrowings.json','docs/design/fixtures/northstar.json','scripts/core0_ir_v1.py'))\n    approved=json.loads((ROOT/PLAN).read_text())\n    if approved['review']['verdict']!='AGREE' or approved['review']['issues']:\n        raise ValueError('no issue-free approved plan')\n    if protected['errors'] or protected['changed_since_execution_entry'] or protected['missing_before_check']:\n        raise ValueError('protection failure before execution: '+str(protected['errors']+protected['changed_since_execution_entry']))\n    source_before={p:digest(ROOT/p) for p in SOURCES+[PLAN]}\n    sys.path.insert(0,str(ROOT/'tests'))\n    import test_accounting_p04 as p04\n    import test_accounting_p03 as p03\n    p04.OBSERVATIONS.clear();p03.OBSERVATIONS.clear()\n    reports={}\n    for name,module in [('P04',p04),('P03_regression',p03)]:\n        stream=io.StringIO();suite=unittest.defaultTestLoader.loadTestsFromModule(module)\n        result=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)\n        reports[name]={'methods':result.testsRun,'failures':len(result.failures),'errors':len(result.errors),\n                       'skips':len(result.skipped),'passed':result.wasSuccessful() and result.testsRun>0 and not result.skipped,'output':stream.getvalue()}\n    catalog=json.loads((ROOT/SOURCES[-1]).read_text())\n    required=Counter(x['id'] for x in catalog['obligations']);observed=Counter(x['obligation'] for x in p04.OBSERVATIONS)\n    status={'required':len(required),'observed':len(observed),'missing':sorted(required.keys()-observed.keys()),\n            'uncatalogued':sorted(observed.keys()-required.keys()),\n            'duplicate_ids':sorted(k for k in required.keys()|observed.keys() if required[k]>1 or observed[k]>1),\n            'failed_observations':[x['obligation'] for x in p04.OBSERVATIONS if x.get('passed') is not True]}\n    finish_protection(ROOT,protected)\n    source_after={p:digest(ROOT/p) for p in source_before}\n    stable=all(h is not None and source_after[p]==h for p,h in source_before.items())\n    passed=all(r['passed'] for r in reports.values()) and protected['passed'] and stable and bool(required) and not any(status[k] for k in ('missing','uncatalogued','duplicate_ids','failed_observations'))\n    command=shlex.join(['python3','-B','scripts/check_accounting_p04.py']+(sys.argv[1:] if argv is None else argv))\n    payload={'schema_version':'accdsl.p04.conformance.v1','passed':bool(passed),'obligation_status':status,\n        'tests':reports,'observations':p04.OBSERVATIONS,'protection':protected,'code_stable_during_check':stable,\n        'input_source_test_hashes':dict(protected['before'],**source_before),\n        'manifest':{'git_commit':'unavailable: existing marker is not a usable repository','command':command,\n            'working_directory':str(ROOT),'executable':sys.executable,'environment':{'python':platform.python_version(),'z3':z3.get_version_string()},\n            'hardware':'CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported','random_seeds':'N/A: exact deterministic fixtures',\n            'data_version':'p04-reconstruction-cases-v1 plus preserved borrowing/Northstar fixtures','started_utc':utc,\n            'wall_seconds':round(time.monotonic()-started,6),'plan':PLAN,'plan_sha256':source_before[PLAN],\n            'execution_inventory':INVENTORY,'changed_source_code_test_files':SOURCES,'changed_files':SOURCES+OUTPUTS,\n            'outputs':OUTPUTS[:2],'result':OUTPUTS[1]},\n        'requirement_coverage':{'MC08':'shared symbols, choices, views and joint queries','MC09':'declared posting templates and bounded coverage',\n            'MC10':'six structural admission categories with provenance; external eligibility not independently certified',\n            'MC11':'unhedged additive bullet-debt grouping with retained memory','MC12':'explicit finite joint weights and retained mass',\n            'MC18':'strict bounds and unfinished cells','MC26':'exact rational linear and bounded integer numerical operations'},\n        'unsupported':catalog['unsupported'],\n        'acceptance':{'engineering':bool(passed),'accounting_validity':'not established','forecast_validity':'not established','human_acceptance':'pending','whole_gap_closure':False}}\n    decision='PASS' if passed else 'FAIL'\n    text=f'''# P04 bounded reconstruction result\n\n{decision}: {reports['P04']['methods']} P04 tests cover {status['observed']}/{status['required']} catalogued obligations; {reports['P03_regression']['methods']} P03 regression tests executed. Full executed outcomes, formulas, cell assignments, witnesses, conflicts, source hashes and proof queries are in conformance.json.\n\nDeclared templates construct account and economic-state roll-forwards. Independent Fraction enumeration checks three finite input variants; a selected Northstar receivables bridge replays original events to create observations before reconstruction. P03 integration preserves alpha=1/2, isolates endpoint conditions, retains overlapping views and rejects incompatible joint extrema. Parent coverage remains one continuous cell without genuine choices.\n\nExact debt interest ranges from 5 to 7. The rounded fixture has infimum 199/40, attained, and supremum 1407/200, unattained. Original strict feasibility precedes closure optimisation. Half-even negative ties, posting minor units, integer gaps, source conflicts, unsupported arithmetic, zero budgets and injected Unknown responses are checked. Incomplete search retains domains, predicates, ordinals and formulas; explored bounds cannot be global certificates.\n\nThe claimed target is the declared rational-linear family. The finite comparisons compute exactly the enumerated assignment sets; algebra supplies the continuous endpoint comparator. This establishes these tested invariants within the profile. It does not establish arbitrary-history completeness. Uncertainty admission checks validate records and declared permissions, not the truth of underlying evidence or professional accounting eligibility. Grouping covers unhedged additive bullet debt with no within-horizon maturity; year fractions are explicit assumptions. Probability atoms are declared disjoint economic hypotheses; their external interpretation is a modeling assumption.\n\n| Decision | Primary criterion | Veto status | Main uncertainty | Next justified action | Not concluded |\n| --- | --- | --- | --- | --- | --- |\n| {decision} for bounded engineering checks | Independent finite sets, integration and endpoint assertions | protection={protected['passed']}; tests={all(r['passed'] for r in reports.values())}; missing={status['missing']}; duplicates={status['duplicate_ids']} | shared solver defects, omitted templates, external admission truth | independent result review if PASS; local repair if FAIL | accounting validity, empirical forecast validity, human acceptance or closure of G1–G18 |\n\nEngineering, numerical and interpretation ledgers remain separate: implementation and executed invariants are recorded above; exact results concern only declared constraints; full-company accounting and empirical forecasts remain unevaluated. No stochastic comparison or method ranking is made.\n\nThe strongest alternative explanation is a shared modeling error between construction and fixtures. Independent posting replay, perturbed inputs and analytic endpoint checks reduce that risk. An in-profile counterexample would overturn this result. The weakest evidence is breadth: these are small deterministic cases, not arbitrary accounting histories.\n\nActual command: `{command}`. Python {platform.python_version()}, Z3 {z3.get_version_string()}, CPU only with GPU devices intentionally hidden. Wall time: {payload['manifest']['wall_seconds']} seconds. Seeds: N/A, deterministic. Git provenance is unavailable; conformance.json contains content hashes and the unchanged {len(protected['before'])}-file supervisor inventory. Approved plan: `{PLAN}`. All changed files appear in the manifest.\n\nResiduals: nonlinear inference, continuous probability inference, unbounded integer search, template discovery, general aggregation equivalence, accounting validity, forecast validity and human acceptance remain open. All MC01–MC35/G1–G18 retain wider obligations.\n'''\n    out=ROOT/args.output_dir;out.mkdir(parents=True,exist_ok=True)\n    (out/'conformance.json').write_text(json.dumps(payload,indent=2)+'\\n')\n    (out/'result.md').write_text(text)\n    print(json.dumps({'passed':bool(passed),'tests':{k:{x:v[x] for x in ('methods','failures','errors','skips')} for k,v in reports.items()},'obligations':status,'protected_inputs_passed':protected['passed']}))\n    return 0 if passed else 1\n\nif __name__=='__main__':\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
