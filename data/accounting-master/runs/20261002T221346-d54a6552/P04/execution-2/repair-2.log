gs']['unsupported']=['*','a','b'];self.assertEqual(solve(construct(s),B)['status'],'UnsupportedFragment')\n        with self.assertRaises(ValueError):q(.1)\n        self.record('fraction_fragment',records)\n\n    def test_northstar_known_history_and_renaming(self):\n{\n  \"schema_version\": \"accdsl.p04.cases.v1\",\n  \"profile\": \"docs/design/spec/reconstruction-profile-v1.md\",\n  \"input_fixture\": {\n    \"schema_version\": \"accdsl.reconstruction.input.v1\",\n    \"scope\": \"two-period-cash\",\n    \"evidence_view\": \"synthetic-accepted\",\n    \"exclusions\": [\n      \"unregistered events\"\n    ],\n    \"obligations\": [],\n    \"rounding_stage\": \"exact_rational\",\n    \"context\": {\n      \"entity\": \"Synthetic\",\n      \"currency\": \"USD\",\n      \"basis\": \"Demo\",\n      \"period\": \"T0:T2\"\n    },\n    \"admissions\": [],\n    \"choices\": [],\n    \"symbols\": [],\n    \"templates\": {\n      \"sale\": {\n        \"postings\": {\n          \"Cash\": \"1\",\n          \"Equity\": \"-1\"\n        },\n        \"state\": {\n          \"sold\": \"1\"\n        },\n        \"provenance\": [\n          \"synthetic:sale-v1\"\n        ]\n      }\n    },\n    \"slots\": [\n      {\n        \"id\": \"a\",\n        \"date\": \"T1\",\n        \"template\": \"sale\",\n        \"kind\": \"Int\",\n        \"integer_bounds\": [\n          0,\n          3\n        ],\n        \"active\": true\n      },\n      {\n        \"id\": \"b\",\n        \"date\": \"T2\",\n        \"template\": \"sale\",\n        \"kind\": \"Int\",\n        \"integer_bounds\": [\n          0,\n          3\n        ],\n        \"active\": true\n      }\n    ],\n    \"dates\": [\n      \"T1\",\n      \"T2\"\n    ],\n    \"opening\": {\n      \"Cash\": \"10\",\n      \"Equity\": \"-10\"\n    },\n    \"economic_opening\": {\n      \"sold\": \"0\"\n    },\n    \"mappings\": {\n      \"cash\": \"balance:T2:Cash\",\n      \"early\": \"balance:T1:Cash\",\n      \"sold\": \"state:T2:sold\",\n      \"equity\": \"balance:T2:Equity\"\n    },\n    \"observations\": [],\n    \"constraints\": [],\n    \"views\": {}\n  },\n  \"obligations\": [\n    {\n      \"id\": \"enumeration\"\n    },\n    {\n      \"id\": \"p03_views\"\n    },\n    {\n      \"id\": \"strict_bounds\"\n    },\n    {\n      \"id\": \"rounding_integer\"\n    },\n    {\n      \"id\": \"coverage_unknown\"\n    },\n    {\n      \"id\": \"identity_conflicts\"\n    },\n    {\n      \"id\": \"uncertainty_probability_grouping\"\n    },\n    {\n      \"id\": \"view_union_joint\"\n    },\n    {\n      \"id\": \"genuine_choices\"\n    },\n    {\n      \"id\": \"limits_bound_unknown\"\n    },\n    {\n      \"id\": \"posting_disclosure\"\n    },\n    {\n      \"id\": \"fraction_fragment\"\n    },\n    {\n      \"id\": \"northstar_bridge\"\n    },\n    {\n      \"id\": \"input_validation_mass\"\n    }\n  ],\n  \"unsupported\": [\n    \"arbitrary histories and template discovery\",\n    \"nonlinear solving and continuous probability inference\",\n    \"unbounded integer search\",\n    \"general accounting validity and forecast validity\",\n    \"general aggregation equivalence and human acceptance\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
