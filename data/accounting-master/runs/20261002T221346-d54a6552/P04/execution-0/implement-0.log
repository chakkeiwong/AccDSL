{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,155p' tests/test_accounting_p03.py; sed -n '1,100p' docs/design/spec/core0-lowering-profile-v1.md\"","aggregated_output":"\"\"\"Executed P03 obligations; authored typed inputs never pass through the parser.\"\"\"\nimport copy\nfrom dataclasses import replace\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'scripts'))\nimport core0_ir_v1 as ir\nfrom core0_frontends_v1 import compile_source\nimport jsonschema\n\nOBSERVATIONS = []\nBASE = (ROOT / 'docs/design/fixtures/borrowing.acc').read_text()\nREASON = 'Fixed-rate proportion not disclosed'\nRENAMED = '''module FinancingStudy version \"2\";\nuse DemoDebt version \"1\";\nsource disclosure = external(\"synthetic-note-7\");\nentity Beta functional USD;\nbook Statutory entity Beta basis DemoDebt version \"1\";\naccount Cash : Asset book Statutory;\naccount Debt : Liability book Statutory;\naccount InterestExpense : Expense book Statutory;\naccount Retained : Equity book Statutory;\nopening carried for Statutory from external(\"after-2025-close\");\nobservation borrowing : Money<USD> instant @2025-12-31 = 150 USD from disclosure;\nsymbol share : Real in [0, 1] because \"Fixed-rate proportion not disclosed\";\ncontract facility : DebtMix book Statutory {\n principal = value(borrowing); fixed_fraction = share;\n fixed_rate = 0.05 per year; initial_floating_rate = 0.05 per year;\n}\nalternative fixed { assume share == 1; }\nalternative floating { assume share == 0; }\nscenario shock { set market_rate = constant(0.08 per year); }\nreport financials for Statutory { mapping = external(\"DemoDebt.statements.v1\"); }\n'''\n\n\ndef bindings(principal=100, renamed=False):\n    \"\"\"Explicit synthetic evidence, separately authored from source and expected IR.\"\"\"\n    p = F(principal); stamp = '2026-01-01T00:00:00Z'\n    book, symbol = ('Statutory', 'share') if renamed else ('Local', 'alpha')\n    names = ('fixed', 'floating') if renamed else ('allFixed', 'allFloating')\n    package_path = ROOT / 'docs/design/fixtures/demo-debt-package.json'\n    return ir.CompileBindings(\n        packages=[ir.PackageBinding('DemoDebt', '1', hashlib.sha256(package_path.read_bytes()).hexdigest(),\n            'DemoDebt', '2025-01-01', '2028-01-01', ['reset','accrue_and_pay','close','statements'],\n            ['builtin:Core0@1','DemoCalendar@1'], ['fixture:demo-debt-package.json'])],\n        readings=[ir.ReadingBinding('synthetic-note-7', f'Synthetic disclosed debt {p} USD; split undisclosed', p,\n            'USD', '2025-12-31', 'fixture:p03-synthetic', 'synthetic-2025', stamp, stamp,\n            'synthetic-author', stamp, 'Explicit synthetic acceptance, not human approval', stamp,\n            system_as_of=stamp, action='Accept')],\n        openings=[ir.OpeningBinding('after-2025-close', '2025-12-31',\n            {'Cash':p-5, 'Debt':-p, 'InterestExpense':0, 'Retained':5}, book=book)],\n        reports=[ir.ReportBinding('DemoDebt.statements.v1','DemoDebt.statements.v1',\n            'interest_operating','close',['accrue_and_pay'])],\n        assumptions=[ir.AssumptionBinding(k, 'Synthetic explicit '+k, information_cutoff=stamp,\n            valid_start='2026-01-01',valid_end='2027-01-01')\n            for k in ('alternative','constraint','contract-rate','scenario')],\n        admissions=[ir.SymbolAdmission(symbol,'synthetic-note-7',REASON,'synthetic-author',stamp)],\n        alternatives=[ir.AlternativeBinding(n,'synthetic-author',stamp,'Synthetic endpoint') for n in names],\n        calendar_id='DemoCalendar@1',calendar_name='Gregorian',horizon_start='2026-01-01',\n        horizon_end='2027-01-01',symbol_uncertainty='HistoricalFact',\n        entity_perimeter='Beta-only' if renamed else 'Acme-only')\n\n\ndef typed(principal=100, stress=F(7,100), renamed=False, arithmetic=False):\n    mod, ver, src, ent, book, opening, obs, sym, contract, a1, a0, scenario, report = (\n        ('FinancingStudy','2','disclosure','Beta','Statutory','carried','borrowing','share','facility',\n         'fixed','floating','shock','financials') if renamed else\n        ('BorrowingExample','1','note7','Acme','Local','after2025','debt','alpha','loans',\n         'allFixed','allFloating','rateShock','statements'))\n    ds = [ir.SourceDecl(src,'synthetic-note-7'),ir.EntityDecl(ent,'USD'),ir.BookDecl(book,ent,'DemoDebt','1')]\n    ds += [ir.AccountDecl(n,r,book) for n,r in [('Cash','Asset'),('Debt','Liability'),('InterestExpense','Expense'),('Retained','Equity')]]\n    ds += [ir.OpeningDecl(opening,book,'after-2025-close'),\n           ir.ObservationDecl(obs,'Money<USD>','2025-12-31',ir.Literal(F(principal),unit='USD'),src),\n           ir.SymbolDecl(sym,'Real',ir.Literal(F(0)),ir.Literal(F(1)),REASON)]\n    fraction = ir.Ref(sym)\n    if arithmetic:\n        ds += [ir.LetDecl('mix',ir.Binary('/',ir.Binary('*',ir.Ref(sym),ir.Literal(F(2))),ir.Literal(F(2)))),\n               ir.ConstraintDecl('limit',ir.Binary('and',ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0))),\n                    ir.Binary('<=',ir.Ref(sym),ir.Literal(F(1)))))]\n        fraction=ir.Ref('mix')\n    ds += [ir.ContractDecl(contract,'DebtMix',book,[('principal',ir.Call('value',[ir.Ref(obs)])),\n           ('fixed_fraction',fraction),('fixed_rate',ir.Literal(F(1,20),unit='per year')),\n           ('initial_floating_rate',ir.Literal(F(1,20),unit='per year'))])]\n    for name,value in ((a1,1),(a0,0)):\n        conds=[ir.Binary('==',ir.Ref(sym),ir.Literal(F(value)))]\n        if arithmetic: conds += [ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0)))]\n        ds.append(ir.AlternativeDecl(name,conds))\n    ds += [ir.ScenarioDecl(scenario,[('market_rate',ir.Call('constant',[ir.Literal(F(stress),unit='per year')]))]),\n           ir.ReportDecl(report,book,ir.External('DemoDebt.statements.v1'))]\n    return ir.Program(mod,ver,ds,[ir.UseDecl('DemoDebt','1')])\n\n\ndef arithmetic_source():\n    return BASE.replace('contract loans', 'let mix = alpha * 2 / 2;\\nconstraint limit: alpha >= 0 and alpha <= 1;\\ncontract loans').replace(\n        'fixed_fraction = alpha;', 'fixed_fraction = mix;').replace('assume alpha == 1;', 'assume alpha == 1; assume alpha >= 0;').replace(\n        'assume alpha == 0;', 'assume alpha == 0; assume alpha >= 0;')\n\n\nSOURCE_NEGATIVES = {\n 'unknown_report_field': (lambda s:s.replace('mapping =', 'extra = 3; mapping ='),'ParseError'),\n 'duplicate_report_field': (lambda s:s.replace('mapping = external(\"DemoDebt.statements.v1\");','mapping = external(\"DemoDebt.statements.v1\"); mapping = external(\"DemoDebt.statements.v1\");'),'ParseError'),\n 'missing_rate_unit': (lambda s:s.replace('fixed_rate = 0.05 per year','fixed_rate = 0.05'),'MissingRateUnit'),\n 'unsupported_event': (lambda s:s+'\\nevent maturity() book Local;','UnsupportedDeclaration'),\n 'reserved_identifier': (lambda s:s.replace('entity Acme','entity report'),'ReservedIdentifier'),\n 'invalid_date': (lambda s:s.replace('@2025-12-31','@2025-02-30'),'InvalidDate'),\n 'invalid_escape': (lambda s:s.replace('Fixed-rate',r'Fixed\\qrate'),'ParseError'),\n 'invalid_surrogate': (lambda s:s.replace('Fixed-rate',r'Fixed\\ud800rate'),'InvalidString'),\n 'duplicate_declaration': (lambda s:s+'\\nentity Acme functional USD;','DuplicateDeclaration'),\n 'duplicate_contract_field': (lambda s:s.replace('fixed_fraction = alpha;', 'fixed_fraction = alpha; fixed_fraction = alpha;'),'DuplicateField'),\n 'unknown_reference': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = absent'),'UnknownReference'),\n 'cyclic_lets': (lambda s:s.replace('contract loans','let first = second; let second = first; contract loans'),'ExpressionCycle'),\n 'unsupported_call': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = sqrt(alpha)'),'UnsupportedExpression'),\n 'unsupported_array': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = [alpha, 1]'),'UnsupportedExpression'),\n 'unsupported_field': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha.part'),'UnsupportedExpression'),\n 'wrong_dimensions': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD + 1'),'TypeMismatch'),\n 'rate_product': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD * 0.05 per year'),'UnsupportedOperation'),\n 'zero_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha / 0'),'UnprovedNonzeroDenominator'),\n 'unproved_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 / alpha'),'UnprovedNonzeroDenominator'),\n 'bad_arity': (lambda s:s.replace('value(debt)','value(debt, debt)'),'ArityMismatch'),\n 'invalid_fraction_bounds': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha + 1'),'ContractDomain'),\n 'principal_disagreement': (lambda s:s.replace('principal = value(debt)','principal = 200 USD'),'ContractPrincipal'),\n 'malformed_syntax': (lambda s:s.replace('module BorrowingExample','module {'),'ParseError'),\n 'wrong_book': (lambda s:s.replace('account Cash : Asset book Local','account Cash : Asset book Elsewhere'),'BindingMismatch'),\n 'extra_scenario_setting': (lambda s:s.replace('set market_rate', 'set other = 1; set market_rate'),'ScenarioFields'),\n}\n\n\nclass P03Tests(unittest.TestCase):\n    def record(self, case, **values):\n        OBSERVATIONS.append(dict(id=case, passed=True, **values))\n\n    def test_checker_protection_provenance(self):\n        from check_accounting_p03 import capture_protection, finish_protection\n\n        def sha(text):\n            return hashlib.sha256(text.encode()).hexdigest()\n\n        # All mutations here affect disposable test inputs, never project files.\n        variants = ('historical_change', 'new_change', 'missing_file',\n                    'missing_inventory', 'empty_inventory', 'omitted_path',\n                    'during_check_change', 'during_check_delete',\n                    'inventory_change', 'duplicate_inventory', 'invalid_digest')\n        for variant in variants:\n            with self.subTest(variant=variant), tempfile.TemporaryDirectory() as folder:\n                root = Path(folder)\n                protected = root / 'protected.txt'\n# Core 0.1 debt source lowering, version 1\n\nThis executable profile supplements the protected Core 0 grammar and contract.\n`compile_source(text, bindings)` parses real source; `compile_program(Program,\nbindings)` accepts immutable typed declarations. Both bind names, check quantities\nand context, construct shared IR, and submit it to independent schema and semantic\nvalidation. Neither entrypoint reads the authored expected IR or expected results.\n\n## Execution evidence contract\n\nThe approved P03 plan remains the implementation boundary. Acceptance requires\nreal source lowering, independent typed/source equivalence, changed-input\nsensitivity, semantic rejection and complete catalog execution. The current\nimplementation preserves global constraints, explicit annual-rate units,\nacceptance records, package bindings and domain checks.\n\nThe baseline is `borrowing.acc`, plus documented corresponding fields of the\nauthored IR, whose reconstruction claims are excluded. Independently constructed\ntyped programs and exact arithmetic checks supplement agreement between frontends.\nSchema validity is a prerequisite, not semantic acceptance. Negative IR cases must\nbe structurally valid before testing the intended semantic rejection. Stops are\nunexpected protected-input changes, missing dependencies, or failing mandatory\nchecks; failures trigger repair, never a passing report. No statistical, timing,\nusability, accounting-compliance or forecasting comparison is being run.\n\nProvenance of material choices: exact rationals, lexical rules and quantities come\nfrom `core-contract.md`; USD accounts and DebtMix fields come from the local\nDemoDebt package. These are bounded baseline restrictions, not promoted defaults.\nThe single source/observation/symbol restriction keeps the evidence view explicit;\nmultiple-source reconciliation is unsupported. Synthetic acceptance and admission\nrecords are supplied by the caller. Absence of reconstruction requires Unknown\nfeasibility, PartialSearch, zero completed cells, one unsearched cell, no witnesses\nand no solver results. Early diagnostics cover unit loss, silent constraint loss,\ninvented acceptance and copied package digests. A pass establishes deterministic\nengineering conformance only. Results are preserved in the two P03 deliverables.\n\nThe writable project files are the two versioned modules, checker, required test,\nthis profile, the versioned cases JSON and the two P03 deliverables. Existing\ngrammar/schema, authored fixtures, legacy validators, controllers, release-pinned\nfiles and preserved snapshots remain protected. Recorded protected inputs are\nchecked against durable supervisor execution-entry hashes and before/after the\ncheck; historical phase-entry differences are separately attributed. Git is\nunavailable (existing marker is not a usable repository); no Git initialization.\nPython 3.11.15, Lark 1.3.1 and jsonschema 4.26.0 are existing dependencies. No\naccelerator framework, service, installation, model or background job is used.\n\n## Supported language and bindings\n\nThe profile has one module, DemoDebt@1 import, source, entity, USD book, exact\ninstant debt observation, admitted Real interval symbol, opening, DebtMix\ncontract, constant annual-rate stress and package report. Its four account names\nare Cash, Debt, InterestExpense and Retained, with Asset, Liability, Expense and\nEquity roles respectively: the package report actually names these accounts.\nOther declaration names may vary. There may be multiple lets, Boolean constraints\nand conditional alternatives, with multiple assumptions in each alternative.\nGlobal constraints constrain the parent family; alternative constraints stay in\ntheir respective branches and are not conjoined in the parent. No branch is\nselected or solved.\n\nBindings explicitly supply a digest-locked local package, synthetic reading and\nacceptance action, information/system cutoffs, opening balances, perimeter,\nsymbol admission, assumption periods/origins, and alternative authorship. Binding\nrecords remain separate from package definitions. Every acceptance must explicitly\nsay Accept; no declaration creates acceptance. Package loading is restricted to\nthe retained DemoDebt file and checks its fixed version, digest, exports and\napplicability. Paths escaping the repository and overrides are errors. The\npackage's registry examples and expected-result fields are not compiler inputs.\n\nDecimal tokens become Fraction directly; binary floats are rejected. Strings use\nJSON escapes, reject unpaired surrogates and normalize semantic strings to NFC.\nOriginal spelling and Unicode-code-point offsets remain in the separate source\nmap; typed locations identify constructors. LF, CRLF, comments and whitespace\npreserve semantics. Dates are Gregorian. All grammar words are reserved.\n\nExpressions include literals, shared references, `value(observation)`, unary minus,\n`not`, compatible addition/subtraction, numeric comparisons, typed equality and\nBoolean composition. Multiplication admits a dimensionless Real or Int factor;\ndivision requires a provably nonzero constant Real or Int denominator. Rates and\nYearFraction are dimensional; rate times money is rejected here (the general\n`simpleInterest` builtin is future work). Integer products remain integer; division\nof scalars returns Real. Addition and comparisons require equal types and compatible\ncontexts. `constant(rate)` is a scenario driver, with a constant, nonnegative annual\nrate. `external(string)` is admitted only for source/opening/report declarations.\nDebtMix principal must equal the accepted debt and opening liability, its fraction\nmust have proven bounds inside [0,1], and component rates must be constant and\nnonnegative. Interval arithmetic proves only conservative bounds; failure to prove\na bound rejects this profile and does not assert mathematical infeasibility.\n\n## Verification and remaining coverage\n\nRun `python3 -B -m unittest discover -s tests -p 'test_accounting_p03.py' -v`, then\n`python3 -B scripts/check_accounting_p03.py --output-dir data/accounting-master/deliverables/P03`.\nThe checker returns nonzero for failed or skipped obligations, includes generated\nIR and binding projections, observations, diagnostics, hashes and runtime details,\nand writes only conformance.json and result.md under the declared output folder.\n\nThe semantic comparison retains IR values, contexts, locks, evidence, assumptions\nand all external bindings. It excludes frontend offsets and observation display\nspelling; those are separately preserved. The authored comparison uses debt value,\ncontext, contract types/fields, assumptions, endpoint conditions, scenario rate,\n","exit_code":0,"status":"completed"}}
