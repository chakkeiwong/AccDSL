{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > scripts/reconstruction_v1.py <<'PY'\n\\\"\\\"\\\"Declared-template reconstruction and bounded uncertainty operations, version 1.\\\"\\\"\\\"\nfrom copy import deepcopy\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nimport z3\nfrom rational_solver_v1 import (Problem, Budget, UnsupportedFragment, q, rational, domain_formula,\n                                disclosure_domain, half_even, solve)\n\n\nADMISSION_FIELDS = {\n    'ExtractionReading': ('source', 'locator', 'review_decision'),\n    'HistoricalFact': ('evidence', 'reason'),\n    'AccountingElection': ('package', 'permitted_treatments', 'election'),\n    'MeasurementEstimate': ('method', 'measurement_date', 'inputs'),\n    'BehaviourPolicy': ('policy', 'information_set', 'decision_time'),\n    'FutureInnovation': ('driver', 'future_period', 'scenario'),\n}\n\n\ndef admit(record):\n    kind = record.get('kind')\n    if kind not in ADMISSION_FIELDS:\n        raise ValueError('unknown uncertainty category')\n    for key in ('id', 'scope', 'provenance', 'dependencies') + ADMISSION_FIELDS[kind]:\n        if key not in record or (key \"'!= '\"'dependencies' and not record[key]):\n            raise ValueError('missing admission field: ' + key)\n    if kind == 'ExtractionReading' and record['review_decision'] \"'!= '\"'Accept':\n        raise ValueError('extraction reading is not accepted')\n    if kind == 'AccountingElection' and record['election'] not in record['permitted_treatments']:\n        raise ValueError('treatment not permitted by declared package')\n    return deepcopy(record)\n\n\ndef expression(node, env):\n    if isinstance(node, bool):\n        return z3.BoolVal(node)\n    if isinstance(node, (str, int, F)):\n        return env[node] if isinstance(node, str) and node in env else q(node)\n    if not isinstance(node, list) or not node:\n        raise ValueError('expression must be exact scalar, reference or operation list')\n    op, *args = node\n    args = [expression(x, env) for x in args]\n    ops = {'+': lambda a,b:a+b, '-': lambda a,b:a-b, '*': lambda a,b:a*b,\n           '/': lambda a,b:a/b, '==': lambda a,b:a==b, '<=': lambda a,b:a<=b,\n           '>=': lambda a,b:a>=b, '<': lambda a,b:a<b, '>': lambda a,b:a>b,\n           'and': lambda *a:z3.And(*a), 'or': lambda *a:z3.Or(*a),\n           'not': lambda a:z3.Not(a), 'implies': lambda a,b:z3.Implies(a,b)}\n    if op not in ops:\n        raise UnsupportedFragment('unknown operation: ' + op)\n    return ops[op](*args)\n\n\ndef construct(spec):\n    if spec.get('schema_version') \"'!= '\"'accdsl.reconstruction.input.v1':\n        raise ValueError('unsupported reconstruction schema')\n    p = Problem(spec['scope'], spec['evidence_view'], exclusions=list(spec['exclusions']),\n                obligations=list(spec['obligations']), rounding_stage=spec['rounding_stage'])\n    context = spec['context']; env = {}\n    records = [admit(a) for a in spec['admissions']]\n    if len({r['id'] for r in records}) \"'!= len(records):\n        raise ValueError('\"'duplicate admission')\n    p.provenance = {'input_sha256': hashlib.sha256(json.dumps(spec, sort_keys=True).encode()).hexdigest(),\n                    'admissions': records, 'context': context, 'observation_sources': {}}\n    def variable(name, kind, limits=None):\n        if name in env:\n            raise ValueError('duplicate economic identifier: ' + name)\n        v = z3.Bool(name) if kind == 'Bool' else z3.Int(name) if kind == 'Int' else z3.Real(name)\n        env[name] = v; p.variables[name] = v\n        if kind == 'Bool':\n            p.finite[name] = [False, True]\n        elif kind == 'Int':\n            if limits is None:\n                p.unsupported.append('unbounded integer domain: ' + name)\n            else:\n                lo, hi = limits\n                if type(lo) is not int or type(hi) is not int or lo > hi:\n                    raise ValueError('invalid integer bounds')\n                p.finite[name] = range(lo, hi+1)\n        return v\n    for c in spec['choices']:\n        if not c['values'] or any(type(v) is not int for v in c['values']) or len(set(c['values'])) \"'!= len(c['\"'values']):\n            raise ValueError('finite choices need distinct integer codes')\n        variable(c['id'], 'Int', [0,0]); p.finite[c['id']] = list(c['values'])\n    for s in spec['symbols']:\n        if s['kind'] not in ('Real', 'Int'):\n            raise ValueError('unsupported symbol kind')\n        v = variable(s['id'], s['kind'], s.get('integer_bounds'))\n        p.add('domain:'+s['id'], domain_formula(v, s['domain']))\n    registry = spec['templates']\n    slots = []\n    for row in spec['slots']:\n        if row['template'] not in registry:\n            raise ValueError('unregistered template')\n        template = registry[row['template']]\n        if not template['provenance']:\n            raise ValueError('template provenance required')\n        if sum(rational(v) for v in template['postings'].values()) \"'!= 0:\n            raise ValueError('\"'posting incidence must balance')\n        amount = variable(row['id'], row['kind'], row.get('integer_bounds'))\n        p.add('nonnegative:'+row['id'], amount >= 0)\n        if row['active'] == 'choice':\n            active = variable(row['id']+':active', 'Bool')\n            p.add('activation:'+row['id'], z3.Implies(z3.Not(active), amount == 0))\n        elif type(row['active']) is bool:\n            if not row['active']:\n                p.add('activation:'+row['id'], amount == 0)\n        else:\n            raise ValueError('explicit activation required')\n        slots.append((row, template, amount))\n    p.slots = len(slots)\n    accounts = dict(spec['opening']); states = dict(spec['economic_opening'])\n    for date in spec['dates']:\n        for account, start in accounts.items():\n            env[f'balance:{date}:{account}'] = q(start) + sum((q(t['postings'].get(account,0))*a for r,t,a in slots if r['date'] <= date), q(0))\n        for state, start in states.items():\n            env[f'state:{date}:{state}'] = q(start) + sum((q(t['state'].get(state,0))*a for r,t,a in slots if r['date'] <= date), q(0))\n    for r,t,a in slots:\n        if r['date'] not in spec['dates'] or set(t['postings'])-set(accounts) or set(t['state'])-set(states):\n            raise ValueError('slot date/account/state outside declared scope')\n    try:\n        for name, node in spec['mappings'].items():\n            env[name] = expression(node, env); p.outputs[name] = env[name]\n        seen = {}\n        for obs in spec['observations']:\n            if obs['context'] \"'!= context or obs['\"'action'] \"'!= '\"'Accept' or not obs['source']:\n                raise ValueError('observation context/admission mismatch')\n            if obs['id'] in seen:\n                if obs \"'!= seen[obs['\"'id']]:\n                    raise ValueError('conflicting reuse of observation identity')\n                continue\n            seen[obs['id']] = obs\n            if obs['mapping'] not in p.outputs:\n                p.obligations.append('unmatched observation:'+obs['id']); continue\n            domain = obs['domain']\n            if domain.get('kind') == 'rounded':\n                if domain.get('convention') is None:\n                    p.obligations.append('unresolved rounding:'+obs['id']); continue\n                domain = disclosure_domain(domain['displayed'], domain['quantum'], domain['convention'])\n            p.add('observation:'+obs['id'], domain_formula(p.outputs[obs['mapping']], domain))\n            p.provenance['observation_sources'][obs['id']] = obs['source']\n        for row in spec['constraints']:\n            p.add(row['id'], expression(row['expression'], env))\n        for name, node in spec['views'].items():\n            p.views[name] = expression(node, env)\n    except UnsupportedFragment as exc:\n        p.unsupported.append(str(exc))\n    return p\n\n\ndef from_p03(ir, bindings, template_bindings):\n    from core0_ir_v1 import validate_ir\n    valid = validate_ir(ir, bindings)\n    if not valid.valid:\n        raise ValueError('P03 IR failed validation: ' + str(valid.diagnostics))\n    if set(template_bindings) \"'!= {'\"'DemoDebt@1/DebtMix'} or template_bindings['DemoDebt@1/DebtMix'] \"'!= '\"'fixed-floating-amounts-v1':\n        raise ValueError('explicit supported template binding required')\n    family = ir['historyFamilies'][0]; scope = ir['modelScopes'][0]\n    p = Problem(scope['id'], family['evidence_view'], exclusions=scope['exclusions'], obligations=scope['obligations'])\n    p.provenance = {'p03_ir_sha256': hashlib.sha256(json.dumps(ir,sort_keys=True).encode()).hexdigest(),\n                    'template_bindings': dict(template_bindings), 'observation_ids': [x['id'] for x in ir['observations']],\n                    'source_refs': ir['contracts'][0]['source_refs']}\n    for row in ir['symbols']:\n        v = z3.Real(row['id']); p.variables[row['id']] = v\n        p.add('domain:'+row['id'],domain_formula(v,row['domain']))\n    observations = {r['id']: r for r in ir['observations']}\n    exprs = {r['id']:r for r in ir['expressions']}\n    def lower(name):\n        row=exprs[name]; op=row['op']\n        if op=='literal':\n            if row['type']=='Bool': return z3.BoolVal(row['text']=='true')\n            return q(row['rational'])\n        if op=='ref':\n            if row['target'] in p.variables:return p.variables[row['target']]\n            return lower(row['target'])\n        if op=='value':\n            target=exprs[row['args'][0]]['target'] if row['args'] else row['target']\n            return q(observations[target]['domain']['lower'])\n        if op=='call' and row['target']=='value':\n            return q(observations[exprs[row['args'][0]]['target']]['domain']['lower'])\n        args=[lower(a) for a in row['args']]\n        if op in ('constant','neg','not'):\n            return args[0] if op=='constant' else -args[0] if op=='neg' else z3.Not(args[0])\n        operations={'add':lambda a,b:a+b,'sub':lambda a,b:a-b,'mul':lambda a,b:a*b,'div':lambda a,b:a/b,\n                    'eq':lambda a,b:a==b,'lt':lambda a,b:a<b,'le':lambda a,b:a<=b,\n                    'gt':lambda a,b:a>b,'ge':lambda a,b:a>=b,'and':lambda *a:z3.And(*a),'or':lambda *a:z3.Or(*a)}\n        if op not in operations:raise UnsupportedFragment('P03 operation: '+op)\n        return operations[op](*args)\n    try:\n        rows={r['id']:r for r in ir['constraints']}\n        for cid in family['constraints']: p.add(cid,lower(rows[cid]['expression']))\n        for view in ir['alternatives']:\n            if view['choice_group'] is not None:raise UnsupportedFragment('P03 choice group requires explicit partition')\n            p.views[view['id']]=z3.And(*[lower(rows[c]['expression']) for c in view['constraints']])\n        fields={f['name']:lower(f['expression']) for f in ir['contracts'][0]['fields']}\n        from rational_solver_v1 import fraction\n        principal=fraction(fields['principal'])\n        if principal<=0:raise UnsupportedFragment('amount/fraction adapter requires positive exact principal')\n        fixed=z3.Real('amount:fixed'); floating=z3.Real('amount:floating')\n        p.variables.update({'amount:fixed':fixed,'amount:floating':floating})\n        p.add('template:principal', fixed+floating==q(principal))\n        p.add('template:fixed', fixed==q(principal)*fields['fixed_fraction'])\n        p.add('template:amounts',z3.And(fixed>=0,floating>=0))\n        rate=lower(ir['scenarios'][0]['drivers'][0]['expression'])\n        p.outputs={'interest':fields['fixed_rate']*fixed+rate*floating,\n                   'fixed':fixed,'floating':floating,'principal':fixed+floating}\n        p.slots=1\n    except UnsupportedFragment as exc:p.unsupported.append(str(exc))\n    return p\n\n\nclass FiniteMeasure:\n    def __init__(self, atoms, justification, used=()):\n        if not justification:raise ValueError('explicit joint-measure justification required')\n        self.atoms=deepcopy(atoms);self.justification=justification;self.used=set(used)\n        ids=[a['id'] for a in atoms]\n        if len(ids)\"'!=len(set(ids)) or not atoms:raise ValueError('\"'distinct joint atoms required')\n        weights=[rational(a['weight']) for a in atoms]\n        if any(w<0 for w in weights) or sum(weights)\"'!=1:raise ValueError('\"'joint weights must sum to one')\n    def update(self, likelihood, information_blocks):\n        blocks=set(information_blocks)\n        if not blocks or blocks & self.used:raise ValueError('repeated/missing information block')\n        if set(likelihood)\"'!={a['\"'id'] for a in self.atoms}:raise ValueError('likelihood must cover every atom')\n        ls={k:rational(v) for k,v in likelihood.items()}\n        if any(v<0 or v>1 for v in ls.values()):raise ValueError('invalid event likelihood')\n        weights=[rational(a['weight'])*ls[a['id']] for a in self.atoms]; total=sum(weights)\n        if total==0:raise ValueError('zero-probability conditioning')\n        new=[dict(a,weight=str(w/total)) for a,w in zip(self.atoms,weights)]\n        return FiniteMeasure(new,self.justification,self.used|blocks)\n    def event(self, ids):\n        ids=set(ids)\n        if ids-{a['id'] for a in self.atoms}:raise ValueError('unknown atom')\n        return sum((rational(a['weight']) for a in self.atoms if a['id'] in ids),F(0))\n    def summary(self):\n        mass={};mean=F(0);available=True\n        for a in self.atoms:\n            w=rational(a['weight']); status=a['status'];mass[status]=mass.get(status,F(0))+w\n            if a.get('outcome') is None:\n                if w:available=False\n            else:mean+=w*rational(a['outcome'])\n        return {'mass':{k:str(v) for k,v in mass.items()},'mean':str(mean) if available else None,\n                'normalised_over_successful_only':False}\n\n\ndef weighted_summary(measure):\n    if not isinstance(measure,FiniteMeasure):raise ValueError('unweighted families have no mean')\n    return measure.summary()\n\n\ndef group_contracts(contracts, scenario, horizon, previous=None):\n    \\\"\\\"\\\"Exact additive simple-debt grouping; retain full constituent memory.\\\"\\\"\\\"\n    request={'contracts':contracts,'scenario':scenario,'horizon':horizon}\n    signature=hashlib.sha256(json.dumps(request,sort_keys=True).encode()).hexdigest()\n    if previous and previous['signature']\"'!=signature:raise ValueError('\"'grouping requires revalidation')\n    if not contracts or horizon[0]>=horizon[1]:raise ValueError('invalid grouping request')\n    keys=('rate','reset','maturity','hedge')\n    if any(tuple(c[k] for k in keys)\"'!=tuple(contracts[0][k] for k in keys) for c in contracts):\n        raise UnsupportedFragment('\"'different contract memory keys')\n    if any(c['maturity']<=horizon[1] for c in contracts):raise UnsupportedFragment('maturity inside horizon')\n    rate=rational(scenario['rate'] if contracts[0]['reset']=='floating' else contracts[0]['rate'])\n    year_fraction=rational(scenario['year_fraction'])\n    principal=sum((rational(c['principal']) for c in contracts),F(0))\n    individual=sum((rational(c['principal'])*rate*year_fraction for c in contracts),F(0))\n    grouped=principal*rate*year_fraction\n    if individual\"'!=grouped:raise ValueError('\"'additivity check failed')\n    return {'signature':signature,'status':'ExactForDeclaredAdditiveProfile','memory':deepcopy(contracts),\n            'scenario':deepcopy(scenario),'horizon':list(horizon),'principal':str(principal),\n            'interest':str(grouped),'transition_preserved':True,'report_preserved':True}\nPY\npython3 -B - <<'PY'\nimport sys\nsys.path[:0]=['scripts','tests']\nfrom test_accounting_p03 import bindings,BASE\nfrom core0_frontends_v1 import compile_source\nfrom reconstruction_v1 import from_p03\np=from_p03(compile_source(BASE,bindings()).ir,bindings(),{'DemoDebt