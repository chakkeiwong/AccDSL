ENTORY}` and current\n229:supervisor execution inventory `{args.execution_inventory}`. There are\n232:inventory evidence, absent protected paths, changes since execution entry or\n234:Conformance JSON preserves the inventory hashes, per-file baselines, actual IR,\n251:Actual command: `{payload['manifest']['command']}`. Approved plan:\n254:framework imported. Check wall time: {payload['manifest']['wall_seconds']} seconds.\n256:files and this execution's source changes are enumerated in the manifest. The\n269:                      'protected_inputs_passed': protection['passed'],\n\"\"\"Core 0.1 source-independent typed IR and bounded lowering profile.\n\nThe module deliberately implements a small, explicit profile.  It does not\nload an authored expected IR and it does not infer missing evidence, review,\npackage, or accounting metadata.  Callers provide those facts through\n``CompileBindings``.  ``core0_frontends_v1`` supplies the textual parser; this\nmodule is also the typed-library entrypoint.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field, fields, is_dataclass\nfrom datetime import date, datetime, timezone\nfrom decimal import Decimal, InvalidOperation\nfrom fractions import Fraction\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport unicodedata\nfrom types import MappingProxyType\nfrom typing import Any, Iterable, Mapping, Optional, Sequence\n\ntry:  # The repository already uses jsonschema; no new dependency is added.\n    import jsonschema\nexcept Exception:  # pragma: no cover - reported by validation when absent.\n    jsonschema = None\n\n\nROOT = Path(__file__).resolve().parents[1]\nSCHEMA_PATH = ROOT / \"docs/design/spec/core-ir.schema.json\"\n\n# The executable profile is deliberately limited to the four account roles\n# exported by the retained DemoDebt package.  Keeping this mapping explicit\n# prevents a caller from changing the accounting perimeter by supplying a\n# different role table through bindings.\n_ACCOUNT_ROLES = {\n    \"Cash\": \"Asset\",\n    \"Debt\": \"Liability\",\n    \"InterestExpense\": \"Expense\",\n    \"Retained\": \"Equity\",\n}\n\n\nclass _Failure(Exception):\n    def __init__(self, diagnostic: \"Diagnostic\"):\n        self.diagnostic = diagnostic\n        super().__init__(diagnostic.message)\n\n\n@dataclass(frozen=True)\nclass Diagnostic:\n    code: str\n    message: str\n    location: str = \"program\"\n    severity: str = \"error\"\n    capability: Optional[str] = None\n    span: Optional[tuple[int, int]] = None\n\n    def as_dict(self) -> dict[str, Any]:\n        return {\n            \"code\": self.code,\n            \"message\": self.message,\n            \"location\": self.location,\n            \"severity\": self.severity,\n            \"capability\": self.capability,\n            \"span\": list(self.span) if self.span is not None else None,\n        }\n\n\n@dataclass(frozen=True)\nclass CompileResult:\n    ir: Optional[dict[str, Any]]\n    diagnostics: tuple[Diagnostic, ...] = ()\n    source_map: Mapping[str, Mapping[str, Any]] = field(default_factory=dict)\n    input_sha256: Optional[str] = None\n    binding_records: Mapping[str, Any] = field(default_factory=dict)\n\n    @property\n    def ok(self) -> bool:\n        return self.ir is not None and not self.diagnostics\n\n    @property\n    def semantic_projection(self) -> Optional[dict[str, Any]]:\n        return {\"ir\": semantic_projection(self.ir), \"bindings\": dict(self.binding_records)} if self.ir is not None else None\n\n\n@dataclass(frozen=True)\nclass ValidationResult:\nscripts/core0_frontends_v1.py:105:def _expr(value: Any, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\nscripts/core0_frontends_v1.py:288:def compile_source(source: str, bindings: CompileBindings):\nscripts/core0_ir_v1.py:73:class CompileResult:\nscripts/core0_ir_v1.py:560:class CompileBindings:\nscripts/core0_ir_v1.py:997:    def _expr_id(self, owner: str, path: str) -> str:\nscripts/core0_ir_v1.py:1577:def compile_program(program: Program, bindings: CompileBindings,\nscripts/core0_ir_v1.py:1770:def _expression_bounds(identifier, nodes):\nscripts/core0_ir_v1.py:1793:def validate_ir(ir: Mapping[str, Any], bindings: CompileBindings,\nStructured inventories ['data/accounting-master/runs/20261002T221346-d54a6552/P04/phase-entry-inventory.json']\nInventory count 384\nExample [('scripts/check_accounting_p03.py', '4e98ce93fe5a2c9ba94930c6af8d4cee904121713ad9e6529c0645d45d26241f'), ('scripts/build_repair_fixtures.py', 'd547424c6bb898adf919a4f5d50fd114bc7e759c78c600b2c9724456fab28b2a')]\nborrowings ['exact', 'rounded', 'mixture']\n{'exact': {'principal': '100', 'historical_rate': '0.05', 'historical_interest': '5', 'fixed_rate': '0.05', 'stress_rate': '0.07', 'cash': '95', 'equity': '-5', 'expected': {'fixed_interest': '5', 'floating_interest': '7', 'fixed_cash': '90', 'floating_cash': '88', 'fixed_equity': '-10', 'floating_equity': '-12'}}, 'rounded': {'debt': ['99.5', '100.5'], 'interest': ['4.5', '5.5'], 'interval': 'lower closed, upper open', 'constraints': ['F>=0', 'V>=0', '99.5<=F+V<100.5', '4.5<=0.05*(F+V)<5.5'], 'expected_infimum': '4.975', 'expected_infimum_attained': True, 'expected_supremum': '7.035', 'expected_supremum_attained': False}, 'mixture': {'hypotheses': ['fixed', 'floating'], 'prior': ['0.6', '0.4'], 'likelihood_new_evidence': ['0.2', '0.8'], 'expected_posterior': ['3/11', '8/11'], 'expected_stress_mean': '5.8', 'partial_failure': {'fixed': 'complete', 'floating': 'unsupported', 'successful_mass': '0.6', 'unresolved_mass': '0.4', 'unconditional_mean': 'unavailable'}}}\nnorthstar ['schema', 'entity', 'currency', 'units', 'basis', 'disclosure_scope', 'assumptions', 'accounts', 'opening', 'historical_events', 'expected', 'forecast', 'coverage_units']\n{'schema': 'accdsl-design-fixture/1', 'entity': 'Northstar Components (synthetic)', 'currency': 'USD', 'units': 'one currency unit', 'basis': 'DemoCorporate/1; not GAAP certification', 'disclosure_scope': 'Closed synthetic goods company; the listed source package is complete by construction', 'assumptions': {'historical_resolution': 'half-year aggregate flows; existence of intraperiod schedules required, not recovered invoices', 'inventory': 'one homogeneous good at cost 5; purchases before delivery; quantities equal costs/5', 'sales': 'delivery transfers control; no returns, services, variable consideration or foreign currency', 'tax': '20% positive taxable profit, all expenses deductible, no deferred tax; excess payment is prepaid tax', 'plant': 'opening cost 100, annual depreciation 10; end-H1 addition 10 lives 5 years; end-H2 addition 12 lives 12 years; zero residuals', 'debt': '100 throughout; fixed and floating both 5% in 2024; fixed 5%, floating resets to 7% in 2025; all maturities after forecast', 'time': 'half-year accrual fractions 1/2, annual 1; explicit teaching convention', 'closing': 'temporary accounts closed after each H1/H2; annual income uses movements excluding closing', 'universe': 'no omitted company, OCI, acquisition, tax or off-balance-sheet operations insi\n","exit_code":0,"status":"completed"}}
