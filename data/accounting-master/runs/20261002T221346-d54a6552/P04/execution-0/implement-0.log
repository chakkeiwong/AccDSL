{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > scripts/reconstruction_v1.py <<'PY'\n\\\"\\\"\\\"Declared-template reconstruction and bounded uncertainty operations, version 1.\\\"\\\"\\\"\nfrom copy import deepcopy\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nimport z3\nfrom rational_solver_v1 import (Problem, Budget, UnsupportedFragment, q, rational, domain_formula,\n                                disclosure_domain, half_even, solve)\n\n\nADMISSION_FIELDS = {\n    'ExtractionReading': ('source', 'locator', 'review_decision'),\n    'HistoricalFact': ('evidence', 'reason'),\n    'AccountingElection': ('package', 'permitted_treatments', 'election'),\n    'MeasurementEstimate': ('method', 'measurement_date', 'inputs'),\n    'BehaviourPolicy': ('policy', 'information_set', 'decision_time'),\n    'FutureInnovation': ('driver', 'future_period', 'scenario'),\n}\n\n\ndef admit(record):\n    kind = record.get('kind')\n    if kind not in ADMISSION_FIELDS:\n        raise ValueError('unknown uncertainty category')\n    for key in ('id', 'scope', 'provenance', 'dependencies') + ADMISSION_FIELDS[kind]:\n        if key not in record or (key \"'!= '\"'dependencies' and not record[key]):\n            raise ValueError('missing admission field: ' + key)\n    if kind == 'ExtractionReading' and record['review_decision'] \"'!= '\"'Accept':\n        raise ValueError('extraction reading is not accepted')\n    if kind == 'AccountingElection' and record['election'] not in record['permitted_treatments']:\n        raise ValueError('treatment not permitted by declared package')\n    return deepcopy(record)\n\n\ndef expression(node, env):\n    if isinstance(node, bool):\n        return z3.BoolVal(node)\n    if isinstance(node, (str, int, F)):\n        return env[node] if isinstance(node, str) and node in env else q(node)\n    if not isinstance(node, list) or not node:\n        raise ValueError('expression must be