esign/research/software/Z3Prover_z3-README-CMake.md\ndocs/design/research/software/Z3Prover_z3-README.md\ndocs/design/research/software/ledger_ledger-README.md\ndocs/design/research/software/openfisca_openfisca-core-README.md\ndocs/design/research/software/pyro-ppl_pyro-LICENSE.md\ndocs/design/research/software/actusfrf_actus-service-ReadMe.md\ndocs/design/research/software/microsoft_table-transformer-README.md\ndocs/design/research/software/pyro-ppl_pyro-README.md\ndocs/design/research/software/actusfrf_actus-techspecs-LICENSE.md\ndocs/design/research/software/docling-project_docling-README.md\ndocs/design/research/software/actusfrf_actus-service-LICENSE.md\ndocs/design/research/software/stan-dev_stan-LICENSE.md\ndocs/design/research/software/stan-dev_stan-README.md\ndocs/design/research/software/Arelle_Arelle-README.md\ndocs/design/research/software/hledgerorg_hledger-README.md\ndocs/design/research/software/Arelle_Arelle-COPYRIGHT.md\ndocs/design/research/software/actusfrf_actus-techspecs-README.md\ndocs/design/research/software/CatalaLang_catala-README.md\ndocs/design/research/software/lballabio_QuantLib-README.md\ndocs/design/research/software/ledger_ledger-README-snapshot.md\ndocs/design/research/software/Arelle_Arelle-LICENSE.md\n","exit_code":0,"status":"completed"}}
