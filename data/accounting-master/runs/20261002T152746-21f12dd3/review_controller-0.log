{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'cat tests/test_accounting_master.py'","aggregated_output":"\"\"\"Control-plane fault injection; these tests make no accounting-validity claim.\"\"\"\nfrom contextlib import redirect_stdout\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport unittest\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts'))\nfrom accounting_master_support import atomic_json, digest, load_json, local_path, run_phase_tests\nfrom run_accounting_master import (ACCEPTED, CATALOG, Master, MasterError, bounded_process,\n                                  exclusive_lock, rule_text, validate_catalog, validate_response)\n\n\ndef response(verdict, **kwargs):\n    result = {'verdict': verdict, 'summary': 'Bounded control-plane test response',\n              'steps': ['Perform the registered work'], 'assumptions': ['Synthetic test only'],\n              'checks': ['Inspect actual generated value'], 'evidence': [], 'issues': [],\n              'residuals': ['The wider mission remains open'], 'next_actions': ['Use observed evidence in the next plan']}\n    result.update(kwargs)\n    return result\n\n\nclass MasterTests(unittest.TestCase):\n    def setUp(self):\n        self.temp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.temp.cleanup)\n        self.root = Path(self.temp.name)\n        (self.root / 'scripts').mkdir()\n        (self.root / 'tests').mkdir()\n        self.catalog = {'limits': {'phase_seconds': 5, 'review_seconds': 5, 'max_repairs': 2}, 'phases': []}\n        for i in range(3):\n            self.catalog['phases'].append({'id': f'P0{i}', 'name': f'Phase {i}', 'kind': 'worker',\n                'deps': [] if i == 0 else [f'P0{i-1}'], 'gaps': [f'G{x}' for x in range(1, 19)] if i == 0 else ['G1'],\n                'requirements': ['MC34'], 'objective': 'Synthetic control-plane exercise',\n                'criteria': ['The actual generated value equals repaired'], 'deliverables': ['result.json'],\n                'output_dir': f'data/accounting-master/deliverables/P0{i}',\n                'test_file': f'tests/test_phase_{i}.py'})\n        atomic_json(self.root / CATALOG, self.catalog)\n        self.calls = []\n        self.checked = []\n\n    def write_work(self, phase, value='repaired'):\n        destination = self.root / phase['output_dir'] / 'result.json'\n        atomic_json(destination, {'value': value})\n        (self.root / phase['test_file']).write_text('# Test double; real check is injected in this control-plane test.\\n')\n        return [str(destination.relative_to(self.root))]\n\n    def worker(self, role, phase, packet, folder, attempt):\n        self.calls.append((role, phase['id'], attempt, packet))\n        if role == 'plan':\n            return response('PLAN')\n        if role.startswith('review'):\n            return response('AGREE')\n        return response('IMPLEMENTED', evidence=self.write_work(phase))\n\n    def check(self, phase, folder):\n        self.checked.append(phase['id'])\n        actual = load_json(self.root / phase['output_dir'] / 'result.json')\n        return {'passed': actual['value'] == 'repaired', 'tests': 1, 'actual': actual}\n\n    def master(self, worker=None, check=None):\n        return Master(self.root, worker=worker or self.worker, check=check or self.check)\n\n    def run_quiet(self, master, **kwargs):\n        with redirect_stdout(io.StringIO()):\n            return master.run(seconds=30, require_review=False, **kwargs)\n\n    def test_executes_real_repair_before_acceptance(self):\n        def faulty(role, phase, packet, folder, attempt):\n            self.calls.append((role, phase['id'], attempt, packet))\n            if role == 'implement':\n                return response('IMPLEMENTED', evidence=self.write_work(phase, 'broken'))\n            if role == 'repair':\n                self.assertIn('repair_findings', packet)\n                return response('IMPLEMENTED', evidence=self.write_work(phase))\n            return response('PLAN' if role == 'plan' else 'AGREE')\n        m = self.master(worker=faulty)\n        self.run_quiet(m, max_phases=1)\n        self.assertEqual(m.state['phases']['P00']['status'], ACCEPTED)\n        self.assertEqual([c[0] for c in self.calls if c[0] in {'implement', 'repair'}], ['implement', 'repair'])\n        self.assertEqual(self.checked, ['P00', 'P00'])\n        value = load_json(self.root / 'data/accounting-master/deliverables/P00/result.json')\n        self.assertEqual(value['value'], 'repaired')\n\n    def test_next_phase_plan_uses_actual_previous_result(self):\n        m = self.master()\n        self.run_quiet(m, max_phases=2)\n        packets = [c[3] for c in self.calls if c[:2] == ('plan', 'P01')]\n        self.assertEqual(packets[0]['next_plan']['last_outcome']['phase'], 'P00')\n        self.assertEqual(packets[0]['next_plan']['phase_states']['P00'], ACCEPTED)\n        next_plan = load_json(m.home / 'next-plan.json')\n        self.assertEqual(next_plan['next_phase'], 'P02')\n\n    def test_resume_does_not_repeat_accepted_work(self):\n        m = self.master()\n        self.run_quiet(m, max_phases=1)\n        self.calls.clear()\n        resumed = self.master()\n        self.run_quiet(resumed, max_phases=1)\n        self.assertFalse(any(c[1] == 'P00' for c in self.calls))\n        self.assertEqual(resumed.state['phases']['P01']['status'], ACCEPTED)\n\n    def test_changed_evidence_invalidates_dependents(self):\n        m = self.master()\n        self.run_quiet(m, max_phases=2)\n        atomic_json(self.root / 'data/accounting-master/deliverables/P00/result.json', {'value': 'changed'})\n        m.refresh()\n        self.assertEqual(m.state['phases']['P00']['status'], 'stale')\n        self.assertEqual(m.state['phases']['P01']['status'], 'stale')\n\n    def test_zero_checks_cannot_pass_even_with_agree(self):\n        m = self.master(check=lambda p, f: {'passed': True, 'tests': 0})\n        self.run_quiet(m, max_phases=1)\n        self.assertEqual(m.state['phases']['P00']['status'], 'needs_repair')\n        self.assertEqual(sum(c[0] == 'repair' for c in self.calls), 2)\n\n    def test_missing_evidence_cannot_be_accepted(self):\n        def missing(role, phase, packet, folder, attempt):\n            result = self.worker(role, phase, packet, folder, attempt)\n            if role in {'implement', 'repair'}:\n                result['evidence'] = ['absent.json']\n            return result\n        m = self.master(worker=missing)\n        self.run_quiet(m, max_phases=1)\n        self.assertEqual(m.state['phases']['P00']['status'], 'needs_repair')\n\n    def test_plan_review_repairs_before_implementation(self):\n        def revise(role, phase, packet, folder, attempt):\n            self.calls.append((role, phase['id'], attempt, packet))\n            if role == 'review_plan' and attempt == 0:\n                return response('REVISE', issues=['Wrong comparator; use the exact synthetic oracle'])\n            if role == 'plan':\n                if attempt:\n                    self.assertIn('required_plan_repairs', packet)\n                return response('PLAN')\n            if role in {'implement', 'repair'}:\n                return response('IMPLEMENTED', evidence=self.write_work(phase))\n            return response('AGREE')\n        m = self.master(worker=revise)\n        self.run_quiet(m, max_phases=1)\n        roles = [c[0] for c in self.calls]\n        self.assertEqual(roles[:5], ['plan', 'review_plan', 'plan', 'review_plan', 'implement'])\n        self.assertEqual(m.state['phases']['P00']['status'], ACCEPTED)\n\n    def test_failed_plan_review_never_executes(self):\n        def rejected(role, phase, packet, folder, attempt):\n            self.calls.append((role, phase['id'], attempt, packet))\n            return response('PLAN' if role == 'plan' else 'REVISE', issues=['Unsupported promotion criterion'])\n        m = self.master(worker=rejected)\n        self.run_quiet(m, max_phases=1)\n        self.assertEqual(m.state['phases']['P00']['status'], 'needs_plan_repair')\n        self.assertFalse(any(c[0] in {'implement', 'repair'} for c in self.calls))\n\n    def test_external_block_does_not_stop_independent_phase(self):\n        self.catalog['phases'][2]['deps'] = []\n        atomic_json(self.root / CATALOG, self.catalog)\n        def blocked(role, phase, packet, folder, attempt):\n            if phase['id'] == 'P00':\n                return response('BLOCKED', issues=['Unavailable required external source'])\n            return self.worker(role, phase, packet, folder, attempt)\n        m = self.master(worker=blocked)\n        self.run_quiet(m, max_phases=3)\n        self.assertEqual(m.state['phases']['P00']['status'], 'blocked_external')\n        self.assertEqual(m.state['phases']['P01']['status'], 'pending')\n        self.assertEqual(m.state['phases']['P02']['status'], ACCEPTED)\n\n    def test_unchanged_external_block_is_not_retried_on_resume(self):\n        def blocked(role, phase, packet, folder, attempt):\n            self.calls.append((role, phase['id'], attempt, packet))\n            return response('BLOCKED', issues=['External source unavailable'])\n        m = self.master(worker=blocked)\n        self.run_quiet(m, max_phases=1)\n        self.calls.clear()\n        self.run_quiet(self.master(worker=blocked), max_phases=1)\n        self.assertEqual(self.calls, [])\n        self.run_quiet(self.master(worker=blocked), max_phases=1, retry_blocked=True)\n        self.assertEqual(len(self.calls), 1)\n\n    def test_previous_next_actions_reach_next_phase_packet(self):\n        m = self.master()\n        self.run_quiet(m, max_phases=2)\n        packet = next(c[3] for c in self.calls if c[:2] == ('plan', 'P01'))\n        self.assertEqual(packet['next_plan']['next_actions']['P00'], ['Use observed evidence in the next plan'])\n\n    def test_preexisting_bytes_are_preserved_before_edit(self):\n        source = self.root / 'scripts/existing.py'\n        source.write_text('VALUE = 1\\n')\n        original = digest(source)\n        def editing(role, phase, packet, folder, attempt):\n            result = self.worker(role, phase, packet, folder, attempt)\n            if role == 'implement':\n                source.write_text('VALUE = 2\\n')\n            return result\n        m = self.master(worker=editing)\n        self.run_quiet(m, max_phases=1)\n        self.assertEqual((m.home / 'prior-bytes' / original).read_text(), 'VALUE = 1\\n')\n        self.assertIn('scripts/existing.py', m.state['phases']['P00']['evidence_hashes'])\n\n    def test_successful_slices_do_not_close_mission_or_gaps(self):\n        m = self.master()\n        self.assertEqual(self.run_quiet(m, max_phases=3), 'catalog_slices_accepted_mission_open')\n        self.assertFalse(m.state['mission_complete'])\n        self.assertEqual(set(m.state['gap_status'].values()), {'open'})\n\n    def test_controller_mutation_is_continuation_veto(self):\n        def mutate(role, phase, packet, folder, attempt):\n            result = self.worker(role, phase, packet, folder, attempt)\n            if role == 'implement':\n                with (self.root / CATALOG).open('a') as stream:\n                    stream.write('\\n')\n            return result\n        m = self.master(worker=mutate)\n        self.assertEqual(self.run_quiet(m, max_phases=1), 'continuation_veto')\n        self.assertEqual(m.state['phases']['P00']['status'], 'interrupted')\n\n    def test_implementation_cannot_rewrite_approved_plan(self):\n        def mutate(role, phase, packet, folder, attempt):\n            result = self.worker(role, phase, packet, folder, attempt)\n            if role == 'implement':\n                target = folder.parent / 'approved-plan.json'\n                value = load_json(target)\n                value['plan']['steps'] = ['Change the previously approved objective']\n                atomic_json(target, value)\n            return result\n        m = self.master(worker=mutate)\n        self.assertEqual(self.run_quiet(m, max_phases=1), 'continuation_veto')\n\n    def test_worker_cannot_forge_supervisor_state(self):\n        def mutate(role, phase, packet, folder, attempt):\n            result = self.worker(role, phase, packet, folder, attempt)\n            if role == 'implement':\n                atomic_json(self.root / 'data/accounting-master/state.json', {'mission_complete': True})\n            return result\n        m = self.master(worker=mutate)\n        self.assertEqual(self.run_quiet(m, max_phases=1), 'continuation_veto')\n        self.assertFalse(load_json(m.state_path)['mission_complete'])\n\n    def test_interrupted_phase_replans_before_resuming(self):\n        m = self.master()\n        m.state['phases']['P00']['status'] = 'running'\n        m.save()\n        self.run_quiet(m, max_phases=1)\n        packet = next(c[3] for c in self.calls if c[0] == 'plan')\n        self.assertIn('Prior process ended', packet['prior_issues'][0])\n        self.assertEqual(m.state['phases']['P00']['status'], ACCEPTED)\n\n    def test_exclusive_writer_lock(self):\n        with exclusive_lock(self.root / 'lock'):\n            with self.assertRaises(MasterError):\n                with exclusive_lock(self.root / 'lock'):\n                    self.fail('Second writer acquired the lock')\n\n    def test_atomic_json_and_duplicate_key_rejection(self):\n        path = self.root / 'value.json'\n        atomic_json(path, {'value': 1})\n        atomic_json(path, {'value': 2})\n        self.assertEqual(load_json(path), {'value': 2})\n        path.write_text('{\"value\":1,\"value\":2}')\n        with self.assertRaises(ValueError):\n            load_json(path)\n\n    def test_evidence_path_escape_is_rejected(self):\n        for name in ['../outside', '/etc/passwd']:\n            with self.assertRaises(ValueError):\n                local_path(self.root, name)\n\n    def test_dependency_cycle_is_rejected(self):\n        self.catalog['phases'][0]['deps'] = ['P02']\n        with self.assertRaises(MasterError):\n            validate_catalog(self.catalog)\n\n    def test_schema_validity_does_not_accept_wrong_role_verdict(self):\n        with self.assertRaises(MasterError):\n            validate_response(response('IMPLEMENTED'), {'AGREE', 'REVISE'})\n\n    def test_process_timeout_is_bounded(self):\n        result = bounded_process([sys.executable, '-c', 'import time; time.sleep(60)'],\n                                 self.root, self.root / 'timeout.log', 0.2)\n        self.assertEqual(result['reason'], 'timeout')\n        self.assertLess(result['wall_seconds'], 7)\n        self.assertNotEqual(result['exit_code'], 0)\n\n    def test_nonreading_process_cannot_block_large_prompt(self):\n        result = bounded_process([sys.executable, '-c', 'import time; time.sleep(60)'],\n                                 self.root, self.root / 'stdin.log', 0.2, prompt='x' * 1024 * 1024)\n        self.assertEqual(result['reason'], 'timeout')\n\n    def test_subprocess_shell_characters_are_literal_arguments(self):\n        marker = self.root / 'must-not-exist'\n        value = f'$(touch {marker}); echo ignored'\n        log = self.root / 'argv.log'\n        result = bounded_process([sys.executable, '-c', 'import sys; print(sys.argv[1])', value], self.root, log, 5)\n        self.assertEqual(result['exit_code'], 0)\n        self.assertEqual(log.read_text().strip(), value)\n        self.assertFalse(marker.exists())\n\n    def test_zero_test_suite_fails(self):\n        path = self.root / 'tests/test_empty_control.py'\n        path.write_text('import unittest\\n')\n        result = run_phase_tests(self.root, {'test_file': str(path.relative_to(self.root))}, self.root / 'test-result.json')\n        self.assertFalse(result)\n\n    def test_allow_rule_has_only_fixed_entrypoint(self):\n        rule = rule_text(self.root)\n        self.assertIn(repr(['python3', str(self.root / 'scripts/run_accounting_master.py')]), rule)\n        self.assertNotIn('pattern=[\\'python3\\']', rule)\n        self.assertIn('not_match=', rule)\n\n\nif __name__ == '__main__':\n    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '481,700p' scripts/run_accounting_master.py\"","aggregated_output":"                if record['status'] in {'running', 'repairing'}:\n                    record['status'] = 'interrupted'\n                    record['issues'] = ['Prior process ended before acceptance; review actual partial work before resuming.']\n                if retry_blocked and record['status'] == 'blocked_external':\n                    record['status'] = 'pending'\n            stop = self.home / 'stop-request.json'\n            if stop.exists():\n                stop.rename(folder / 'prior-stop-request.json')\n            manifest = {'run_id': self.run_id, 'started_at': now(), 'command': sys.argv,\n                        'python': sys.executable, 'python_version': sys.version, 'controller_hashes': self.controls,\n                        'catalog_sha256': digest(self.root / CATALOG), 'git_commit': None,\n                        'git_reason': 'Existing marker unusable; no Git initialization',\n                        'device': 'CPU; CUDA_VISIBLE_DEVICES=-1 in child commands',\n                        'seeds': 'N/A for controller; scientific phases must declare their own',\n                        'max_phases': max_phases, 'wall_limit_seconds': seconds,\n                        'plan': 'docs/plans/accounting-master-program.md', 'mission_complete': False}\n            atomic_json(folder / 'manifest.json', manifest)\n            self.state['runs'].append(str(folder.relative_to(self.root)))\n            self.save()\n            tried = set()\n            outcome = 'stopped'\n            try:\n                self.check_protection()\n                if require_review:\n                    self.controller_review(folder)\n                while len(tried) < max_phases and time.monotonic() < self.deadline and not stop.exists():\n                    plan = self.refresh()\n                    candidates = [x for x in plan['eligible_phases'] if x not in tried]\n                    if not candidates:\n                        break\n                    identifier = candidates[0]\n                    tried.add(identifier)\n                    try:\n                        self.execute_phase(self.phases[identifier], folder / identifier)\n                    except ContinuationVeto:\n                        raise\n                    except Exception as error:\n                        self.state['phases'][identifier].update(status='needs_repair', issues=[f'{type(error).__name__}: {error}'])\n                    record = self.state['phases'][identifier]\n                    if record['status'] == 'blocked_external':\n                        record['block_signature'] = self.input_fingerprint(identifier)\n                    self.state['last_outcome'] = {'phase': identifier, 'status': record['status'],\n                                                  'issues': record.get('issues', []), 'residuals': record.get('residuals', [])}\n                    self.event('phase_finished', phase=identifier, status=record['status'])\n                    refreshed = self.refresh()\n                    self.event('next_plan_refreshed', previous_phase=identifier, next_phase=refreshed['next_phase'])\n                if stop.exists():\n                    outcome = 'stop_requested'\n                elif time.monotonic() >= self.deadline:\n                    outcome = 'wall_limit'\n                elif all(p['status'] == ACCEPTED for p in self.state['phases'].values()):\n                    outcome = 'catalog_slices_accepted_mission_open'\n                elif len(tried) >= max_phases:\n                    outcome = 'phase_limit'\n                else:\n                    outcome = 'remaining_work_requires_repair_or_dependency'\n            except (ContinuationVeto, MasterError, KeyboardInterrupt) as error:\n                outcome = 'continuation_veto' if isinstance(error, ContinuationVeto) else 'interrupted'\n                for record in self.state['phases'].values():\n                    if record['status'] in {'running', 'repairing'}:\n                        record.update(status='interrupted', issues=[str(error)])\n                self.event('run_stopped', reason=str(error))\n                manifest['stop_reason'] = str(error)\n            finally:\n                manifest.update(finished_at=now(), outcome=outcome, phases_attempted=sorted(tried),\n                                phase_states={k: v['status'] for k, v in self.state['phases'].items()})\n                atomic_json(folder / 'manifest.json', manifest)\n                self.refresh()\n                self.event('run_finished', outcome=outcome, manifest=str((folder / 'manifest.json').relative_to(self.root)))\n            return outcome\n\n\ndef rule_text(root):\n    command = ['python3', str(root / 'scripts/run_accounting_master.py')]\n    return ('# AccDSL master only; existing global rules/settings are preserved.\\n'\n            '# Installed after explicit user approval of the reviewed program.\\n'\n            'prefix_rule(\\n    pattern=' + repr(command) + ',\\n    decision=\"allow\",\\n'\n            '    match=[' + repr(command + ['run']) + ', ' + repr(command + ['status']) + '],\\n'\n            '    not_match=[[\"python3\", \"-c\", \"print(1)\"], [\"bash\", \"-lc\", \"echo unsafe\"],\\n'\n            '               [\"python3\", \"/tmp/unrelated.py\"]],\\n)\\n')\n\n\ndef check_rule(rule, command):\n    files = rule if isinstance(rule, list) else [rule]\n    arguments = [item for file in files for item in ['--rules', str(file)]]\n    result = subprocess.run(['codex', 'execpolicy', 'check', *arguments, '--', *command],\n                            capture_output=True, text=True, timeout=30, check=False)\n    if result.returncode:\n        raise MasterError('Execpolicy verification failed: ' + result.stderr[-800:])\n    return json.loads(result.stdout)\n\n\ndef install_rule(master):\n    candidate = master.home / 'accdsl-master.rules'\n    candidate.write_text(rule_text(master.root))\n    prefix = ['python3', str(master.root / 'scripts/run_accounting_master.py')]\n    positives = {name: check_rule(candidate, prefix + [name]) for name in ['install-and-run', 'run', 'status', 'refresh', 'stop']}\n    negatives = [check_rule(candidate, command) for command in [['python3', '-c', 'print(1)'], ['bash', '-lc', 'echo unsafe'], ['python3', '/tmp/unrelated.py']]]\n    if any(r.get('decision') != 'allow' for r in positives.values()) or any(r.get('decision') == 'allow' for r in negatives):\n        raise MasterError('Exact allow-rule positive/negative checks failed')\n    target = Path.home() / '.codex/rules/accdsl-master.rules'\n    effective_files = [p for p in target.parent.glob('*.rules') if p != target] + [candidate]\n    effective = {name: check_rule(effective_files, prefix + [name]) for name in ['install-and-run', 'run', 'status', 'refresh', 'stop']}\n    if any(r.get('decision') != 'allow' for r in effective.values()):\n        raise MasterError('Existing policy overrides the proposed allow rule; inspect effective-policy checks before proceeding')\n    target.parent.mkdir(parents=True, exist_ok=True)\n    if target.exists() and target.read_text() != candidate.read_text():\n        raise MasterError('A different dedicated rule already exists; preserve it for review')\n    if not target.exists():\n        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\n        with os.fdopen(fd, 'w') as stream:\n            stream.write(candidate.read_text())\n            stream.flush()\n            os.fsync(stream.fileno())\n    checks = {'rule': str(target), 'sha256': digest(target), 'positive_checks': positives, 'negative_checks': negatives, 'effective_policy_checks': effective}\n    atomic_json(master.home / 'approval-checks.json', checks)\n    atomic_json(master.home / 'authorization.json', {'created_at': now(), 'scope': str(master.root),\n        'basis': 'Explicit upfront approval of install-and-run and the reviewed plan',\n        'sequential_workers': True, 'parallel_or_recursive_workers': False,\n        'implementer_sandbox': 'workspace-write', 'reviewer_sandbox': 'read-only',\n        'nested_approval_policy': 'never', 'public_source_research': True,\n        'project_local_dependencies_only': True, 'paid_services_or_professional_review': False,\n        'rule': str(target), 'controller_hashes_at_grant': master.controls})\n    master.event('approval_rule_installed', rule=str(target), verified_commands=list(positives))\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('action', choices=['install-and-run', 'run', 'status', 'refresh', 'stop', 'review', '_checks', '_builtin'])\n    parser.add_argument('--max-phases', type=int, default=15)\n    parser.add_argument('--max-seconds', type=int, default=7200)\n    parser.add_argument('--phase')\n    parser.add_argument('--out')\n    parser.add_argument('--retry-blocked', action='store_true', help='Explicitly retry unchanged external blocks after repairing access/environment')\n    args = parser.parse_args()\n    if not 1 <= args.max_phases <= 15 or not 1 <= args.max_seconds <= 86400:\n        parser.error('Use 1..15 phases and 1..86400 seconds')\n    master = Master()\n    if args.action not in {'_checks', '_builtin'} and (args.phase or args.out):\n        parser.error('--phase and --out are restricted to registered internal operations')\n    if args.action in {'_checks', '_builtin'}:\n        if args.phase not in master.phases or not args.out:\n            parser.error('Internal operation requires an exact registered phase and output path')\n        out = Path(args.out).resolve()\n        if not out.is_relative_to(master.home / 'runs'):\n            parser.error('Internal output must be within master run records')\n        if args.action == '_checks':\n            return 0 if run_phase_tests(ROOT, master.phases[args.phase], out) else 1\n        if args.phase == 'P00':\n            baseline(ROOT, out)\n        elif args.phase == 'P01':\n            source_register(ROOT, out)\n        else:\n            parser.error('No builtin for this phase')\n        return 0\n    if args.action == 'status':\n        print(json.dumps({'mission_complete': False, 'phase_states': {k: v['status'] for k, v in master.state['phases'].items()},\n                          'last_outcome': master.state['last_outcome'], 'state': str(master.state_path)}, indent=2))\n        return 0\n    if args.action == 'stop':\n        atomic_json(master.home / 'stop-request.json', {'requested_at': now()})\n        print('Stop requested; the active child process will be terminated and partial work retained.')\n        return 0\n    if args.action == 'refresh':\n        with exclusive_lock(master.home / 'runner.lock'):\n            print(json.dumps(master.refresh(), indent=2))\n        return 0\n    if args.action == 'install-and-run':\n        install_rule(master)\n    if args.action == 'review':\n        with exclusive_lock(master.home / 'runner.lock'):\n            folder = master.home / 'runs' / ('review-' + uuid.uuid4().hex[:8])\n            folder.mkdir(parents=True)\n            master.protected = release_hashes(ROOT)\n            master.controller_review(folder)\n        return 0\n    outcome = master.run(args.max_phases, args.max_seconds, retry_blocked=args.retry_blocked)\n    return 0 if outcome in {'catalog_slices_accepted_mission_open', 'phase_limit'} else 2\n\n\nif __name__ == '__main__':\n    try:\n        raise SystemExit(main())\n    except (MasterError, ValueError, OSError) as error:\n        print(f'{type(error).__name__}: {error}', file=sys.stderr)\n        raise SystemExit(2)\n","exit_code":0,"status":"completed"}}
