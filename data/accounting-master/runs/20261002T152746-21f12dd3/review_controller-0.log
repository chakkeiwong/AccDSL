{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '241,480p' scripts/run_accounting_master.py\"","aggregated_output":"        (self.home / 'next-plan.md').write_text('\\n'.join(lines))\n        self.save()\n        return plan\n\n    def input_fingerprint(self, identifier):\n        return stable_hash({'catalog': digest(self.root / CATALOG), 'controls': self.controls,\n            'dependencies': {d: self.state['phases'][d].get('evidence_hashes', {}) for d in self.phases[identifier]['deps']}})\n\n    def process(self, argv, log, seconds, prompt=None):\n        result = bounded_process(argv, self.root, log, self.remaining(seconds), prompt=prompt,\n                                 heartbeat=lambda elapsed: self.event('heartbeat', stage=log.stem, seconds=elapsed),\n                                 stopped=lambda: (self.home / 'stop-request.json').exists())\n        atomic_json(log.with_suffix('.process.json'), result)\n        if result['exit_code'] != 0 or result['reason']:\n            raise MasterError(f'Command failed ({result[\"reason\"] or result[\"exit_code\"]}); inspect {log.relative_to(self.root)}')\n        return result\n\n    def worker(self, role, phase, packet, folder, attempt=0):\n        runtime_guard = {str(p.relative_to(self.root)): digest(p) for p in [self.state_path, self.home / 'authorization.json'] if p.exists()}\n        if self.worker_override:\n            response = self.worker_override(role, phase, packet, folder, attempt)\n        else:\n            grant = self.home / 'authorization.json'\n            if not grant.exists() or not load_json(grant).get('sequential_workers'):\n                raise MasterError('Sequential workers need the explicit upfront install-and-run grant')\n            executable = shutil.which('codex')\n            if not executable:\n                raise MasterError('Codex CLI unavailable')\n            mode = 'workspace-write' if role in {'implement', 'repair'} else 'read-only'\n            seconds = self.catalog['limits']['phase_seconds'] if mode == 'workspace-write' else self.catalog['limits']['review_seconds']\n            if role == 'probe':\n                seconds = 60\n            prompt = self.prompt(role, phase, packet)\n            (folder / f'{role}-{attempt}.prompt.txt').write_text(prompt)\n            destination = folder / f'{role}-{attempt}.response.json'\n            argv = [executable, '-a', 'never', 'exec', '--sandbox', mode, '--ephemeral',\n                    '--skip-git-repo-check', '--ignore-rules', '--json', '--color', 'never',\n                    '--output-schema', str(self.root / SCHEMA), '-o', str(destination),\n                    '-C', str(self.root), '-c', 'sandbox_workspace_write.network_access=true', '-']\n            self.process(argv, folder / f'{role}-{attempt}.log', seconds, prompt)\n            if not destination.exists():\n                raise MasterError('Worker did not produce its structured final response')\n            response = load_json(destination)\n        allowed = {'PLAN', 'BLOCKED'} if role == 'plan' else {'AGREE', 'REVISE', 'BLOCKED'} if role in {'probe', 'review_plan', 'review_result', 'review_controller'} else {'IMPLEMENTED', 'BLOCKED'}\n        value = validate_response(response, allowed)\n        atomic_json(folder / f'{role}-{attempt}.response.json', value)\n        self.check_protection()\n        if verify_hashes(self.root, runtime_guard):\n            raise ContinuationVeto('Worker changed supervisor state or the upfront grant')\n        return value\n\n    def prompt(self, role, phase, packet):\n        if role == 'probe':\n            return ('Do not use tools or read project files. Return only the required JSON schema: '\n                    'verdict AGREE, summary MASTER_WORKER_OK, and empty arrays for all other fields.')\n        return '\\n'.join([\n            'You are a sequential worker for the user-authorised AccDSL master program.',\n            f'Role: {role}. Repository: {self.root}. Phase contract follows below.',\n            'Read AGENTS.md, the mission, current requirements, consolidated gap register, and the master plan.',\n            'No agents/delegation/recursive workers. Do not launch another model or this master runner.',\n            'No paid service/data, accounts, outreach, publication, deployment, global or conda package installation, Git initialization, source deletion or permission changes.',\n            'Never use approval/sandbox bypass. Do not request approvals. Record inaccessible capabilities once and continue independent authorised work.',\n            'Only implement/repair roles may edit project code and the phase deliverables. Planner/reviewer roles are strictly read-only.',\n            'Do not edit the master controller, support module, catalog, response schema, controller tests, master plan, state, events, authorization or run records.',\n            'Do not modify data/financial-report-benchmark or any file pinned by its release manifest. Do not modify preserved pre-repair/pre-expert snapshots.',\n            'Preserve unrelated work. Add new versioned modules/results instead of rewriting frozen evidence. Record all changed source/code/test files in evidence.',\n            'Use only standard-library/existing packages by default. Any essential new open-source dependency must be isolated under this project, version-pinned and documented.',\n            'Public-source research must use legitimate official/primary sources, preserve local copies and exact support; no challenge bypass or fabricated authority.',\n            'Separate specified behaviour, implemented code, tested invariants, accounting validity, empirical forecast validity and human acceptance. All G1–G18 retain their wider obligations.',\n            'Before scientific runs, write the research intent/evidence/default audit and matched baseline plan required by project policy. Short checks cannot establish superiority.',\n            'For PLAN, inspect existing artifacts and produce concrete implementation steps, explicit assumptions, exact checks, risks/nonclaims and residuals. Address every supplied review finding before revising a plan.',\n            'For review_plan, actively check wrong baselines, proxy promotion, missing stops, unfair comparisons, hidden assumptions, stale context, environment mismatch and whether proposed artifacts answer the question. AGREE requires no unresolved material objection.',\n            'For implement/repair, execute the reviewed plan, write the specified actual deliverables and meaningful unittest cases at the required test_file. Execute checks and fix failures. Do not merely write a plan or call authored expected values the implementation.',\n            'For review_result, inspect actual code, tests, source evidence and deterministic check reports. A returned success or many tests alone is insufficient. Return REVISE with actionable repairs if acceptance criteria fail.',\n            'An AGREE response must have issues=[]; put nonblocking limitations in residuals. An empty implementation or a plan-only deliverable must not pass an implementation phase.',\n            'For review_controller, audit orchestration, recovery, permissions, repair, plan refresh, child-process limits and honest completion against the plan and tests. Do not change files.',\n            'Every evidence entry must be an existing repository-relative FILE path, never prose, a directory or an invented artifact. Include concrete unresolved work in residuals and justified next tasks in next_actions.',\n            'Return only the response schema. Verdict: PLAN for plan; AGREE/REVISE for review; IMPLEMENTED for actual work; BLOCKED only for a real dependency preventing the stated slice. Explain partial work without claiming whole-gap closure.',\n            json.dumps({'phase': phase, 'packet': packet}, ensure_ascii=False, indent=2),\n        ])\n\n    def controller_review(self, folder):\n        receipt = self.home / 'controller-review.json'\n        if receipt.exists():\n            old = load_json(receipt)\n            if old.get('verdict') == 'AGREE' and old.get('controller_hashes') == self.controls:\n                return\n        phase = {'id': 'controller', 'name': 'Review the master program', 'criteria': [\n            'The current controller and tests implement the reviewed master plan without false completion or approval bypass.',\n            'Repairs execute; verification and review rerun; next plans incorporate actual findings.',\n            'Processes are bounded, writes recover atomically, one writer runs, and frozen evidence is protected.']}\n        health = self.worker('probe', phase, {}, folder)\n        if health['verdict'] != 'AGREE' or health['summary'] != 'MASTER_WORKER_OK':\n            raise ContinuationVeto('Noninteractive worker health probe did not pass')\n        response = self.worker('review_controller', phase, {'files': CONTROLS,\n            'plan': 'docs/plans/accounting-master-program.md',\n            'local_review': 'docs/design/review/accounting-master-review.md'}, folder)\n        atomic_json(receipt, {**response, 'controller_hashes': self.controls, 'reviewed_at': now()})\n        if response['verdict'] != 'AGREE':\n            raise ContinuationVeto('Controller review requires repair: ' + '; '.join(response['issues']))\n\n    def check_phase(self, phase, folder):\n        if self.check_override:\n            result = self.check_override(phase, folder)\n            atomic_json(folder / 'checks.json', result)\n            return result\n        try:\n            self.process([sys.executable, str(self.root / 'scripts/run_accounting_master.py'),\n                          '_checks', '--phase', phase['id'], '--out', str(folder / 'checks.json')],\n                         folder / 'checks-process.log', min(300, self.catalog['limits']['phase_seconds']))\n            result = load_json(folder / 'checks.json')\n        except MasterError as error:\n            result = load_json(folder / 'checks.json') if (folder / 'checks.json').exists() else {'passed': False, 'tests': 0}\n            result.update(passed=False, error=str(error))\n        missing = [str((Path(phase['output_dir']) / name)) for name in phase['deliverables']\n                   if not local_path(self.root, str(Path(phase['output_dir']) / name)).is_file()]\n        if missing:\n            result.update(passed=False, missing_deliverables=missing)\n        atomic_json(folder / 'checks.json', result)\n        self.check_protection()\n        return result\n\n    def evidence_hashes(self, names):\n        result = {}\n        for name in names:\n            path = local_path(self.root, name)\n            if not path.is_file():\n                raise MasterError(f'Missing evidence file: {name}')\n            result[name] = digest(path)\n        if not result:\n            raise MasterError('No concrete evidence files')\n        return result\n\n    def execute_phase(self, phase, folder):\n        identifier = phase['id']\n        folder.mkdir(parents=True, exist_ok=True)\n        record = self.state['phases'][identifier]\n        record['status'] = 'running'\n        record['attempts'].append(str(folder.relative_to(self.root)))\n        self.save()\n        self.event('phase_started', phase=identifier, name=phase['name'])\n        if phase['kind'] == 'builtin':\n            if self.builtin_override:\n                result = self.builtin_override(phase, folder)\n            else:\n                self.process([sys.executable, str(self.root / 'scripts/run_accounting_master.py'),\n                              '_builtin', '--phase', identifier, '--out', str(folder)],\n                             folder / 'builtin-process.log', self.catalog['limits']['phase_seconds'])\n                result = load_json(folder / phase['deliverables'][0])\n            if result.get('status') != 'passed':\n                raise MasterError('Builtin acceptance failed')\n            self.check_protection()\n            evidence = [str((folder / name).relative_to(self.root)) for name in phase['deliverables']]\n            record.update(status=ACCEPTED, residuals=result.get('residuals', []), issues=[],\n                          evidence_hashes=self.evidence_hashes(evidence), accepted_at=now())\n            return\n        packet = {'next_plan': self.refresh(), 'phase_output_dir': phase['output_dir'],\n                  'prior_attempts': record['attempts'][:-1], 'prior_issues': record.get('issues', []),\n                  'original_criteria': phase['criteria']}\n        approved = None\n        for attempt in range(self.catalog['limits']['max_repairs'] + 1):\n            plan = self.worker('plan', phase, packet, folder, attempt)\n            if plan['verdict'] == 'BLOCKED':\n                record.update(status='blocked_external', issues=plan['issues'], residuals=plan['residuals'])\n                return\n            plan_hash = stable_hash(plan)\n            review = self.worker('review_plan', phase, {**packet, 'plan': plan, 'plan_hash': plan_hash}, folder, attempt)\n            if review['verdict'] == 'AGREE':\n                approved = {'plan': plan, 'review': review, 'plan_hash': plan_hash}\n                atomic_json(folder / 'approved-plan.json', approved)\n                break\n            packet['required_plan_repairs'] = review\n            self.event('plan_repair_required', phase=identifier, attempt=attempt, issues=review['issues'])\n        if approved is None:\n            record.update(status='needs_plan_repair', issues=review['issues'], residuals=review['residuals'])\n            return\n        packet['approved'] = approved\n        for attempt in range(self.catalog['limits']['max_repairs'] + 1):\n            self.check_protection()\n            if stable_hash(load_json(folder / 'approved-plan.json')['plan']) != approved['plan_hash']:\n                raise ContinuationVeto('Approved phase plan changed after review')\n            stage = folder / f'execution-{attempt}'\n            stage.mkdir()\n            role = 'implement' if attempt == 0 else 'repair'\n            self.event('repair_started' if attempt else 'implementation_started', phase=identifier, attempt=attempt)\n            try:\n                before = preserve_editable(self.root, self.home / 'prior-bytes')\n                atomic_json(stage / 'pre-edit-files.json', before)\n                work = self.worker(role, phase, packet, stage, attempt)\n                if stable_hash(load_json(folder / 'approved-plan.json')['plan']) != approved['plan_hash']:\n                    raise ContinuationVeto('Implementation changed its approved plan')\n                if work['verdict'] == 'BLOCKED':\n                    record.update(status='blocked_external', issues=work['issues'], residuals=work['residuals'])\n                    return\n                changes = changes_since(self.root, before)\n                atomic_json(stage / 'changes.json', changes)\n                if changes['deleted']:\n                    raise MasterError('Worker deleted pre-existing tracked project files: ' + ', '.join(changes['deleted']))\n                checked = self.check_phase(phase, stage)\n                response = self.worker('review_result', phase,\n                    {**packet, 'work': work, 'checks': checked, 'actual_changes': changes,\n                     'preserved_inputs': str((stage / 'pre-edit-files.json').relative_to(self.root)),\n                     'check_path': str((stage / 'checks.json').relative_to(self.root))},\n                    stage, attempt)\n                if stable_hash(load_json(folder / 'approved-plan.json')['plan']) != approved['plan_hash']:\n                    raise ContinuationVeto('Result review changed the approved plan')\n                if checked.get('passed') is True and checked.get('tests', 0) > 0 and response['verdict'] == 'AGREE':\n                    names = set(work['evidence']) | set(response['evidence']) | {phase['test_file']}\n                    names.update(changes['added'] + changes['changed'])\n                    names.update(str(Path(phase['output_dir']) / n) for n in phase['deliverables'])\n                    names.add(str((stage / 'checks.json').relative_to(self.root)))\n                    names.add(str((folder / 'approved-plan.json').relative_to(self.root)))\n                    record.update(status=ACCEPTED, issues=[], accepted_at=now(),\n                                  residuals=list(dict.fromkeys(work['residuals'] + response['residuals'])),\n                                  next_actions=list(dict.fromkeys(work['next_actions'] + response['next_actions'])),\n                                  evidence_hashes=self.evidence_hashes(names))\n                    return\n                packet['repair_findings'] = {'checks': checked, 'result_review': response, 'work': work}\n                issues = checked.get('missing_deliverables', []) + response['issues']\n            except ContinuationVeto:\n                raise\n            except (MasterError, ValueError, OSError) as error:\n                issues = [str(error)]\n                packet['repair_findings'] = {'execution_error': str(error)}\n            record.update(status='repairing', issues=issues)\n            self.save()\n            self.event('verification_requires_repair', phase=identifier, attempt=attempt, issues=issues)\n        record.update(status='needs_repair', issues=issues,\n                      residuals=record.get('residuals', []) + ['Repair allowance exhausted for this invocation; retain partial work and refresh the next slice.'])\n\n    def run(self, max_phases=15, seconds=7200, require_review=True, retry_blocked=False):\n        with exclusive_lock(self.home / 'runner.lock'):\n            if self.state_path.exists():\n                self.state = load_json(self.state_path)\n            self.run_id = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S') + '-' + uuid.uuid4().hex[:8]\n            folder = self.home / 'runs' / self.run_id\n            folder.mkdir(parents=True)\n            self.deadline = time.monotonic() + seconds\n            self.protected = release_hashes(self.root) if (self.root / 'data/financial-report-benchmark/release-manifest.json').exists() else {}\n            for record in self.state['phases'].values():\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'cat scripts/accounting_master_support.py'","aggregated_output":"\"\"\"Evidence-preserving deterministic operations for the accounting master.\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport hashlib\nimport importlib.util\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport runpy\nimport sys\nimport unittest\nfrom unittest.mock import patch\n\n\ndef digest(path: Path) -> str:\n    h = hashlib.sha256()\n    with path.open('rb') as stream:\n        for block in iter(lambda: stream.read(1024 * 1024), b''):\n            h.update(block)\n    return h.hexdigest()\n\n\ndef atomic_json(path: Path, value) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    tmp = path.with_name(path.name + f'.{os.getpid()}.tmp')\n    with tmp.open('w') as stream:\n        json.dump(value, stream, indent=2, ensure_ascii=False, allow_nan=False)\n        stream.write('\\n')\n        stream.flush()\n        os.fsync(stream.fileno())\n    os.replace(tmp, path)\n    fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\n\n\ndef load_json(path: Path):\n    def pairs(items):\n        result = {}\n        for key, value in items:\n            if key in result:\n                raise ValueError(f'Duplicate JSON key: {key}')\n            result[key] = value\n        return result\n    return json.loads(path.read_text(), object_pairs_hook=pairs,\n                      parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))\n\n\ndef local_path(root: Path, relative: str) -> Path:\n    if not isinstance(relative, str) or Path(relative).is_absolute():\n        raise ValueError('Expected a repository-relative path')\n    path = (root / relative).resolve()\n    if not path.is_relative_to(root.resolve()):\n        raise ValueError('Path escapes the repository')\n    return path\n\n\ndef release_hashes(root: Path) -> dict:\n    base = root / 'data/financial-report-benchmark'\n    release = load_json(base / 'release-manifest.json')\n    expected = {k: v['sha256'] for k, v in release['files'].items()}\n    expected['data/financial-report-benchmark/release-manifest.json'] = digest(base / 'release-manifest.json')\n    integrity = load_json(base / 'integrity-manifest.json')\n    # The independent inventory has a mapping of repository-relative paths.\n    inventory = integrity['files']\n    if isinstance(inventory, dict):\n        for name, info in inventory.items():\n            expected[name] = info['sha256'] if isinstance(info, dict) else info\n    else:\n        for info in inventory:\n            expected[info['path']] = info['sha256']\n    return expected\n\n\ndef verify_hashes(root: Path, expected: dict) -> list:\n    failures = []\n    for name, value in expected.items():\n        try:\n            path = local_path(root, name)\n            if not path.is_file() or digest(path) != value:\n                failures.append(name)\n        except (OSError, ValueError):\n            failures.append(name)\n    return failures\n\n\ndef baseline(root: Path, out: Path) -> dict:\n    \"\"\"Rerun old checks, redirecting only their new reports into this run.\"\"\"\n    out.mkdir(parents=True, exist_ok=True)\n    failures = verify_hashes(root, release_hashes(root))\n    if failures:\n        raise ValueError('Frozen baseline changed: ' + ', '.join(failures[:12]))\n    sys.path.insert(0, str(root))\n    sys.path.insert(0, str(root / 'scripts'))\n    spec = importlib.util.spec_from_file_location('accdsl_corpus_verifier', root / 'scripts/verify_financial_report_corpus.py')\n    verifier = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(verifier)\n    corpus = verifier.verify(root, root / 'data/financial-report-benchmark')\n    atomic_json(out / 'corpus-integrity.json', corpus)\n    if corpus['status'] != 'pass':\n        raise ValueError('Independent corpus integrity verification failed')\n    suites = [\n        ('check_design_examples.py', 'example-checks.json'),\n        ('check_repair_conformance.py', 'repair-conformance.json'),\n        ('check_core_contract.py', 'core-contract-checks.json'),\n        ('check_semantic_preparation.py', 'semantic-preparation-checks.json'),\n        ('check_accounting_dossiers.py', 'accounting-dossier-checks.json'),\n    ]\n    old_write = Path.write_text\n    reports = []\n    for script, report in suites:\n        target = root / 'docs/design/review' / report\n        def redirected(path, data, *args, **kwargs):\n            if path.resolve() != target.resolve():\n                raise ValueError(f'Unexpected legacy-check write: {path}')\n            return old_write(out / report, data, *args, **kwargs)\n        log = io.StringIO()\n        with patch.object(Path, 'write_text', redirected), contextlib.redirect_stdout(log):\n            runpy.run_path(str(root / 'scripts' / script), run_name='__main__')\n        (out / (script + '.log')).write_text(log.getvalue())\n        result = load_json(out / report)\n        checks = result.get('checks', [])\n        if not checks or any(c.get('passed', c.get('ok', False)) is not True for c in checks):\n            raise ValueError(f'{script}: missing or failed checks')\n        reports.append({'script': script, 'checks': len(checks), 'report': str((out / report).relative_to(root)),\n                        'scope': result.get('scope', result.get('conclusion', result.get('target')))})\n    suite = unittest.TestLoader().discover(str(root / 'scripts'), pattern='test_financial_report_corpus.py')\n    stream = io.StringIO()\n    tested = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)\n    (out / 'corpus-regressions.log').write_text(stream.getvalue())\n    if not tested.wasSuccessful() or tested.testsRun < 20 or len(tested.skipped) == tested.testsRun:\n        raise ValueError('Corpus regressions failed or did not execute the expected existing suite')\n    result = {'status': 'passed', 'verified_reports': corpus['verified_slots'],\n              'reference_suites': reports, 'corpus_regression_tests': tested.testsRun,\n              'source_acceptance_only': True, 'mission_complete': False,\n              'residuals': ['All G1–G18 retain work; bounded reference checks do not establish accounting or forecast validity.']}\n    atomic_json(out / 'baseline.json', result)\n    return result\n\n\ndef source_register(root: Path, out: Path) -> dict:\n    base = root / 'data/financial-report-benchmark'\n    coverage = load_json(base / 'coverage.json')\n    evidence = load_json(base / 'source-evidence.json')['documents']\n    records, identifiers = [], set()\n    for row in coverage['rows']:\n        identifier = row['document_id']\n        if identifier in identifiers or row['status'] != 'revalidated_verified':\n            raise ValueError(f'Duplicate/unaccepted corpus slot: {identifier}')\n        identifiers.add(identifier)\n        source = evidence[identifier]\n        original = local_path(root, row['local_path'])\n        extracted = local_path(root, row['extracted_text_path'])\n        if digest(original) != row['sha256']:\n            raise ValueError(f'Source hash mismatch: {identifier}')\n        extracted_hash = digest(extracted)\n        if extracted.name != f'extracted-{extracted_hash}.txt':\n            raise ValueError(f'Extraction hash mismatch: {identifier}')\n        if source.get('sha256') != row['sha256']:\n            raise ValueError(f'Selected version does not match evidence: {identifier}')\n        metadata = source.get('source_metadata', {})\n        records.append({\n            'document_id': identifier, 'issuer_id': row['issuer_id'],\n            'period_year': row['period_year'], 'report_class': row['report_class'],\n            'region': row['region'], 'industry': row['industry'],\n            'stated_basis_family': row['standard_family'],\n            'source_url': row['source_url'], 'original_path': row['local_path'],\n            'original_sha256': row['sha256'], 'extracted_path': row['extracted_text_path'],\n            'extracted_sha256': extracted_hash,\n            'basis_evidence': source['checks']['accounting_basis']['evidence'],\n            'publication_metadata': metadata,\n            'historical_byte_vintage': 'not_established_by_this_inventory',\n            'semantic_status': 'not_annotated', 'gold_label': False,\n            'package_closure': 'not_established',\n            'unresolved': ['report-specific entity/perimeter and jurisdiction interpretation',\n                           'cell and narrative meaning', 'incorporated source obligations',\n                           'revision/translation relationships', 'historical byte-vintage availability'],\n        })\n    if len(records) != coverage['verified_documents'] or len(records) != coverage['expected_documents']:\n        raise ValueError('Source-register coverage is incomplete')\n    result = {'schema_version': 'accdsl.source_work_register.v1', 'status': 'passed',\n              'record_count': len(records), 'input_hashes': {\n                  str((base / name).relative_to(root)): digest(base / name)\n                  for name in ['coverage.json', 'source-evidence.json']},\n              'records': records, 'mission_complete': False,\n              'residuals': ['Publication/version evidence, semantic annotation, incorporated packages and benchmark labels remain open.']}\n    out.mkdir(parents=True, exist_ok=True)\n    atomic_json(out / 'source-work-register.json', result)\n    return result\n\n\ndef run_phase_tests(root: Path, phase: dict, out: Path) -> bool:\n    sys.path.insert(0, str(root))\n    if (root / 'src').exists():\n        sys.path.insert(0, str(root / 'src'))\n    path = local_path(root, phase['test_file'])\n    if not path.is_file():\n        atomic_json(out, {'passed': False, 'tests': 0, 'error': 'Required test file is absent'})\n        return False\n    suite = unittest.TestLoader().discover(str(path.parent), pattern=path.name)\n    log = io.StringIO()\n    result = unittest.TextTestRunner(stream=log, verbosity=2).run(suite)\n    out.with_suffix('.log').write_text(log.getvalue())\n    passed = result.wasSuccessful() and result.testsRun > 0 and len(result.skipped) < result.testsRun\n    atomic_json(out, {'passed': passed, 'tests': result.testsRun, 'skipped': len(result.skipped),\n                      'failures': len(result.failures), 'errors': len(result.errors),\n                      'test_file': phase['test_file'], 'test_sha256': digest(path),\n                      'scope': 'Engineering tests only; result review separately checks adequacy and claim limits.'})\n    return passed\n\n\ndef editable_files(root: Path) -> dict:\n    \"\"\"Inventory code/manuscript inputs; exclude frozen snapshots and supervisor records.\"\"\"\n    files = {}\n    suffixes = {'.py', '.json', '.md', '.tex', '.lark', '.acc', '.txt', '.toml', '.csv'}\n    for name in ['scripts', 'src', 'tests', 'docs']:\n        directory = root / name\n        if not directory.exists():\n            continue\n        for path in directory.rglob('*'):\n            if (not path.is_file() or path.is_symlink() or '__pycache__' in path.parts\n                    or any(x.startswith(('pre-repair-', 'pre-expert-preparation-')) for x in path.parts)):\n                continue\n            if path.suffix in suffixes or path == root / 'docs/design/accounting-product-design.pdf':\n                files[str(path.relative_to(root))] = digest(path)\n    return files\n\n\ndef preserve_editable(root: Path, store: Path) -> dict:\n    files = editable_files(root)\n    store.mkdir(parents=True, exist_ok=True)\n    for name, value in files.items():\n        destination = store / value\n        if not destination.exists():\n            destination.write_bytes((root / name).read_bytes())\n        elif digest(destination) != value:\n            raise ValueError('Preserved pre-edit content is corrupt')\n    return files\n\n\ndef changes_since(root: Path, previous: dict) -> dict:\n    current = editable_files(root)\n    return {'added': sorted(set(current) - set(previous)),\n            'changed': sorted(k for k in set(current) & set(previous) if current[k] != previous[k]),\n            'deleted': sorted(set(previous) - set(current))}\n","exit_code":0,"status":"completed"}}
