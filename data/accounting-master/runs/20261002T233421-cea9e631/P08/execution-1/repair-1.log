   'sign_convention':'postings_debit_positive; sum of each entry and total ledger must equal zero.',\n   'issue':{'cash':'+proceeds','liability':'-initial_liability','conversion_equity':'-(proceeds-initial_liability)'},\n   'accrue':{'interest_expense':'+opening_liability*yield','liability':'-interest_expense'},\n   'coupon':{'liability':'+coupon','cash':'-coupon'},\n   'redeem':{'liability':'+principal','cash':'-principal'},\n   'convert':{'liability':'+principal','share_equity':'-principal'}\n },\n 'note_links':reg['note_links'],\n 'authority_claims':['recognition','classification','split','measurement','interest','redemption','conversion','note_carrying','note_interest'],\n 'excluded_features':['revenue allocation','current/deferred tax','lease terms and remeasurement','foreign currency','control/consolidation','transaction costs','fair-value designation','derivatives','guarantees','cash options','early conversion or repurchase','modification','default','inducement','rounding and real-market yield estimation']\n}\ndefault_audit=[\n {'choice':'annual calendar schedule and two coupons','provenance':'reviewed P08 plan and synthetic compound-bond dossier','justification':'keeps the issuer lifecycle exact and bounded to dated periods','failure_mode':'irregular calendars or day-count terms could change interest and eligibility','early_diagnostic':'Contract.validate rejects non-1 January issue dates; three-period test exercises the parameter','promotion_status':'bounded hypothesis'},\n {'choice':'10% comparable yield','provenance':'synthetic reviewed example','justification':'supports an exact rational present-value case','failure_mode':'a wrong market yield gives balanced but wrong carrying amount','early_diagnostic':'independent Fraction PV oracle and second principal/rate case','promotion_status':'synthetic input, not market evidence'},\n {'choice':'Australian for-profit Tier 1 AASB basis','provenance':'retained AASB 132/9/7 31 December 2022 compilations','justification':'all selected primary anchors and period limits are inspectable','failure_mode':'AASB adoption is not universal IFRS authority and later editions may differ','early_diagnostic':'AuthorityBook checks issuer, tier, entity scope and period start','promotion_status':'reviewed bounded scope'},\n {'choice':'opening cash/equity of 20','provenance':'reviewed synthetic plan','justification':'permits redemption while making funding explicit','failure_mode':'insufficient funding can make redemption invalid even when journals balance','early_diagnostic':'zero-opening-cash atomicity test','promotion_status':'synthetic fixture'},\n {'choice':'exact Fraction arithmetic','provenance':'existing Python standard library','justification':'avoids unrecorded rounding in the conformance cases','failure_mode':'does not validate currency rounding or production valuation','early_diagnostic':'independent rational recomputation','promotion_status':'engineering convenience'}\n]\naccess_blocks=[\n {'id':'fasb2020_06','status':'unavailable','url':'https://storage.fasb.org/ASU%202020-06_0.pdf','reason':'HTTP 403; ASC 470/815 and ASU 2020-06 remain uninspected.'},\n {'id':'mof22_candidate','status':'unavailable','url':'https://kjs.mof.gov.cn/zhengcefabu/201704/t20170406_2579238.htm','reason':'HTTP 502; official ASBE/CAS 22/37 edition and transition remain uninspected.'},\n {'id':'eu2023_1803','status':'uninspected','url':'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32023R1803','reason':'EUR-Lex returned HTTP 202 with zero retained bytes; no endorsed IAS 32/IFRS 9 treatment inferred.'}\n]\npayload={\n 'schema_version':'accdsl.p08.authority-methods.v1',\n 'phase':'P08',\n 'created_at':datetime.now(timezone.utc).isoformat(),\n 'authority_register_path':'docs/design/research/p08-v1/authority-register.json',\n 'authority_register_sha256':digest(reg_path),\n 'authorities':reg['authorities'],\n 'claims':reg['claims'],\n 'source_access':reg['access_attempts'],\n 'access_blocks':access_blocks,\n 'operations':[operation],\n 'cases':cases,\n 'comparisons':comparison,\n 'research':reg['research'],\n 'method_queue':reg['method_queue'],\n 'evidence_contract':{\n   'question':'Can applicable primary authority support a parameterized exact issuer compound-convertible-bond lifecycle and a same-fact comparison?',\n   'comparator':'Existing compound-bond dossier arithmetic, independently recomputed present values and cash flows.',\n   'primary_criterion':'Inspected applicable anchors, atomic parameterized journals, both maturity settlements, matched inputs, and reproducible notes.',\n   'vetoes':['source applicability or anchor failure for a claimed treatment','invalid chronology or unsupported terms','unbalanced journal/state','negative settlement funding','note roll-forward mismatch'],\n   'explanatory_diagnostics':['alternative principal/rate case','three-period case','zero-rate case','unresolved comparison cells','ACTUS scheduling source boundary'],\n   'nonclaims':['No professional accounting opinion, forecast validity, production readiness, superiority, or whole MC01-MC35/G1-G18 closure.','Synthetic eligibility and yield are not real contract or market evidence.'],\n   'artifact':'authority-and-methods.json plus result.md and deterministic checker output.'\n },\n 'default_audit':default_audit,\n 'implementation':{\n   'engine':'scripts/corporate_financing_v1.py',\n   'tests':'tests/test_accounting_p08.py',\n   'checker':'scripts/check_accounting_p08.py',\n   'source_register':'docs/design/research/p08-v1/authority-register.json',\n   'test_count_recorded':12,\n   'changed_files':['scripts/corporate_financing_v1.py','scripts/check_accounting_p08.py','tests/test_accounting_p08.py','data/accounting-master/deliverables/P08/authority-and-methods.json','data/accounting-master/deliverables/P08/result.md','data/accounting-master/deliverables/P08/progress.md','docs/design/research/p08-v1/authority-register.json','docs/design/research/p08-v1/access-records.j