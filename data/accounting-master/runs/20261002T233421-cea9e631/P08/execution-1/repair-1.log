{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"nl -ba tests/test_accounting_p08.py | sed -n '1,280p'\"","aggregated_output":"     1\t\"\"\"Independent PV/cash-flow oracles and failure-atomicity checks for P08.\"\"\"\n     2\timport copy\n     3\tfrom dataclasses import replace\n     4\tfrom fractions import Fraction as F\n     5\timport json\n     6\tfrom pathlib import Path\n     7\timport sys\n     8\timport unittest\n     9\t\n    10\tROOT = Path(__file__).resolve().parents[1]\n    11\tsys.path.insert(0, str(ROOT / 'scripts'))\n    12\tfrom corporate_financing_v1 import (AuthorityBook, BondBook, Contract, Unsupported,\n    13\t                                   compare_same_facts, run_case, rational)\n    14\t\n    15\t\n    16\tclass FinancingTests(unittest.TestCase):\n    17\t    @classmethod\n    18\t    def setUpClass(cls):\n    19\t        cls.authority = AuthorityBook()\n    20\t\n    21\t    def book(self, **kwargs):\n    22\t        return BondBook(Contract(), self.authority, **kwargs)\n    23\t\n    24\t    def ready(self, book):\n    25\t        book.apply('issue', 'issue', book.contract.issue_date)\n    26\t        for i, day in enumerate(book.contract.coupon_dates()):\n    27\t            book.apply(f'a{i}', 'accrue', day)\n    28\t            book.apply(f'c{i}', 'coupon', day)\n    29\t        return book\n    30\t\n    31\t    def atomic(self, book, *args):\n    32\t        before = book.state\n    33\t        with self.assertRaises(Unsupported):\n    34\t            book.apply(*args)\n    35\t        self.assertEqual(before, book.state)\n    36\t\n    37\t    def test_issue_independent_present_value(self):\n    38\t        b = self.book()\n    39\t        b.apply('i', 'issue', '2024-01-01')\n    40\t        expected = F(5, 1) / F(11, 10) + F(105, 1) / F(121, 100)\n    41\t        self.assertEqual(expected, F(11050, 121))\n    42\t        self.assertEqual(-b.state['ledger']['liability'], expected)\n    43\t        self.assertEqual(-b.state['ledger']['conversion_equity'], 100 - expected)\n    44\t        self.assertEqual(b.state['principal_outstanding'], 100)\n    45\t\n    46\t    def test_two_coupons_and_both_settlements(self):\n    47\t        for settlement, cash, shares in [('redeem', 10, 0), ('convert', 110, 10)]:\n    48\t            b = self.book(); b.apply('i', 'issue', '2024-01-01')\n    49\t            for i, expected in enumerate([F(1050, 11), F(100)], 1):\n    50\t                day = f'{2023+i}-12-31'\n    51\t                b.apply(f'a{i}', 'accrue', day); b.apply(f'c{i}', 'coupon', day)\n    52\t                self.assertEqual(-b.state['ledger']['liability'], expected)\n    53\t            self.assertEqual(b.state['ledger']['interest_expense'], F(2260, 121))\n    54\t            b.apply('s', settlement, '2025-12-31')\n    55\t            state = b.state; ledger = state['ledger']\n    56\t            self.assertEqual(ledger['cash'], cash)\n    57\t            self.assertEqual(ledger['liability'], 0)\n    58\t            self.assertEqual(ledger['conversion_equity'], -F(1050, 121))\n    59\t            self.assertEqual(state['principal_outstanding'], 0)\n    60\t            self.assertEqual(state['shares'], shares)\n    61\t            self.assertEqual(ledger['share_equity'], -100 if shares else 0)\n    62\t            self.assertEqual(sum(ledger.values()), 0)\n    63\t            for entry in state['journal']:\n    64\t                self.assertEqual(sum(entry['postings_debit_positive'].values()), 0)\n    65\t                self.assertEqual(sum(entry['state_after'].values()), 0)\n    66\t\n    67\t    def test_second_parameters_and_cashflow_oracle(self):\n    68\t        c = replace(Contract(), principal='240', proceeds='245', instrument_fair_value='245',\n    69\t                    annual_coupon='12', comparable_yield='2/25', conversion_shares=24)\n    70\t        pv = F(12)*F(25,27) + F(252)*F(625,729)\n    71\t        for method in ('redeem', 'convert'):\n    72\t            r = run_case(c, method, opening_cash='30', authority=self.authority)\n    73\t            self.assertEqual(F(r['initial_liability']), pv)\n    74\t            # Total effective interest = total contractual cash flows less issue liability.\n    75\t            self.assertEqual(F(r['state']['ledger']['interest_expense']), 264-pv)\n    76\t            self.assertEqual(F(r['state']['ledger']['cash']), 30+245-24-(240 if method=='redeem' else 0))\n    77\t\n    78\t    def test_three_periods_and_zero_rate(self):\n    79\t        c = replace(Contract(), issue_date='2023-01-01', years=3)\n    80\t        r = run_case(c, authority=self.authority)\n    81\t        pv = sum((F(5)*F(10,11)**n for n in (1,2,3)), F(0)) + 100*F(10,11)**3\n    82\t        self.assertEqual(F(r['initial_liability']), pv)\n    83\t        self.assertEqual(F(r['state']['ledger']['interest_expense']), 115-pv)\n    84\t        c = replace(Contract(), annual_coupon='0', comparable_yield='0')\n    85\t        self.assertEqual(run_case(c, authority=self.authority)['state']['ledger']['interest_expense'], '0')\n    86\t\n    87\t    def test_note_reconciliation_and_links(self):\n    88\t        r = run_case(authority=self.authority)\n    89\t        notes = r['notes']; total = F(0)\n    90\t        self.assertEqual(len(notes['periods']), 2)\n    91\t        for p in notes['periods']:\n    92\t            self.assertEqual(F(p['opening_liability'])+F(p['issue_liability'])+F(p['interest_expense'])-F(p['coupons'])-F(p['settlement_liability']), F(p['closing_liability']))\n    93\t            total += F(p['interest_expense'])\n    94\t            self.assertTrue(set(p['event_ids']) <= set(r['state']['used_event_ids']))\n    95\t        self.assertEqual(total, F(r['state']['ledger']['interest_expense']))\n    96\t        for links in notes['links'].values():\n    97\t            self.assertTrue(set(links) <= set(self.authority.claims))\n    98\t\n    99\t    def test_sequence_duplicate_conflict_and_settlement_atomicity(self):\n   100\t        b = self.book()\n   101\t        self.atomic(b, 'a', 'accrue', '2024-12-31')\n   102\t        b.apply('i', 'issue', '2024-01-01')\n   103\t        self.atomic(b, 'i', 'accrue', '2024-12-31')\n   104\t        self.atomic(b, 'c', 'coupon', '2024-12-31')\n   105\t        self.atomic(b, 'a', 'accrue', '2025-12-31')\n   106\t        self.atomic(b, 's', 'convert', '2024-12-31')\n   107\t        for i, day in enumerate(b.contract.coupon_dates()):\n   108\t            b.apply(f'a{i}', 'accrue', day); b.apply(f'c{i}', 'coupon', day)\n   109\t        b.apply('s', 'redeem', '2025-12-31')\n   110\t        self.atomic(b, 's2', 'convert', '2025-12-31')\n   111\t\n   112\t    def test_insufficient_cash_is_atomic(self):\n   113\t        b = self.ready(self.book(opening_cash='0'))\n   114\t        self.atomic(b, 's', 'redeem', '2025-12-31')\n   115\t        b.apply('s', 'convert', '2025-12-31')\n   116\t        self.assertEqual(b.state['shares'], 10)\n   117\t\n   118\t    def test_ineligible_contracts(self):\n   119\t        changes = [{'functional_currency':'USD'}, {'conversion_right':'variable_shares'},\n   120\t                   {'measurement':'fair_value'}, {'issue_date':'2024-02-01'}, {'years':0},\n   121\t                   {'years':True}, {'conversion_shares':0}, {'principal':'0'},\n   122\t                   {'comparable_yield':'-1/10'}, {'proceeds':'1','instrument_fair_value':'1'},\n   123\t                   {'instrument_fair_value':'99'}, {'annual_coupon':5.0}]\n   124\t        changes += [{'unsupported_features':(f,)} for f in ('tax','fees','cash_option','guarantee','early_conversion','modification','default','put','reset','embedded_derivative','FVPL_designation','contingent_consideration')]\n   125\t        for change in changes:\n   126\t            with self.subTest(change=change), self.assertRaises(Unsupported):\n   127\t                BondBook(replace(Contract(), **change), self.authority)\n   128\t\n   129\t    def test_jurisdiction_tier_period_veto(self):\n   130\t        for change in ({'basis':'US GAAP'}, {'jurisdiction':'US'}, {'tier':'Tier 2'},\n   131\t                       {'entity_scope':'not-for-profit'}, {'issue_date':'2022-01-01'},\n   132\t                       {'issue_date':'2026-01-01'}):\n   133\t            with self.subTest(change=change), self.assertRaises(Unsupported):\n   134\t                BondBook(replace(Contract(), **change), self.authority)\n   135\t        # 2026 calendar period starts before the 1 July edition limit.\n   136\t        BondBook(replace(Contract(), issue_date='2026-01-01', years=1), self.authority)\n   137\t\n   138\t    def test_source_and_claim_vetoes(self):\n   139\t        def broken(mutator):\n   140\t            d = copy.deepcopy(self.authority.records); mutator(d)\n   141\t            with self.assertRaises(Unsupported): AuthorityBook(records=d)\n   142\t        broken(lambda d: d['claims'].pop(0))\n   143\t        broken(lambda d: d['authorities'][0].update(access_status='overview_only'))\n   144\t        broken(lambda d: d['authorities'][0].update(kind='company_practice'))\n   145\t        broken(lambda d: d['authorities'][0]['retained'].update(sha256='0'*64))\n   146\t        broken(lambda d: d['authorities'][0]['retained'].update(path='does-not-exist.pdf'))\n   147\t        broken(lambda d: d['claims'][0]['anchors'][0].update(quote='invented authority'))\n   148\t        broken(lambda d: d['claims'][0]['anchors'][0].update(pdf_page=0))\n   149\t        broken(lambda d: d['note_links']['financing_equity'].append('absent'))\n   150\t\n   151\t    def test_same_fact_comparisons_do_not_inherit(self):\n   152\t        r = compare_same_facts(authority=self.authority)\n   153\t        self.assertEqual(len({x['facts_sha256'] for x in r['rows']}), 1)\n   154\t        self.assertEqual(r['rows'][0]['initial_liability'], '11050/121')\n   155\t        for row in r['rows'][1:]:\n   156\t            self.assertEqual(row['status'], 'unresolved')\n   157\t            self.assertIsNone(row['initial_liability']); self.assertIsNone(row['initial_equity'])\n   158\t            self.assertEqual(row['claims'], [])\n   159\t        self.assertIsNone(r['supported_difference'])\n   160\t\n   161\t    def test_state_copies_are_not_mutation_handles(self):\n   162\t        b=self.book(); state=b.state; state['ledger']['cash']=F(-100)\n   163\t        self.assertEqual(b.state['ledger']['cash'],20)\n   164\t\n   165\t\n   166\tif __name__ == '__main__':\n   167\t    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"nl -ba scripts/corporate_financing_v1.py | sed -n '1,420p'\"","aggregated_output":"     1\t\"\"\"Bounded, exact AASB issuer compound-bond lifecycle (P08).\n     2\t\n     3\tEligibility and fair value/yield inputs are explicit synthetic assumptions, not\n     4\tinferred accounting opinions. Annual calendar periods only; no market model.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\tfrom copy import deepcopy\n     9\tfrom dataclasses import dataclass\n    10\tfrom datetime import date\n    11\tfrom fractions import Fraction\n    12\tfrom hashlib import sha256\n    13\tfrom pathlib import Path\n    14\timport json\n    15\timport re\n    16\t\n    17\tROOT = Path(__file__).resolve().parents[1]\n    18\tREGISTER = 'docs/design/research/p08-v1/authority-register.json'\n    19\tREQUIRED = ('recognition', 'classification', 'split', 'measurement', 'interest',\n    20\t            'redemption', 'conversion', 'note_carrying', 'note_interest')\n    21\tACCOUNTS = ('cash', 'liability', 'conversion_equity', 'share_equity',\n    22\t            'opening_equity', 'interest_expense')\n    23\t\n    24\t\n    25\tclass Unsupported(ValueError):\n    26\t    \"\"\"A fact, source, or event is outside the explicitly supported slice.\"\"\"\n    27\t\n    28\t\n    29\tdef rational(value):\n    30\t    if isinstance(value, (bool, float)) or not isinstance(value, (str, int, Fraction)):\n    31\t        raise Unsupported('amounts and rates require exact integer/rational inputs')\n    32\t    try:\n    33\t        return Fraction(value)\n    34\t    except (ValueError, ZeroDivisionError) as exc:\n    35\t        raise Unsupported('invalid rational') from exc\n    36\t\n    37\t\n    38\tdef iso(value):\n    39\t    try:\n    40\t        result = date.fromisoformat(value)\n    41\t        if result.isoformat() != value:\n    42\t            raise ValueError('noncanonical date')\n    43\t        return result\n    44\t    except (ValueError, TypeError) as exc:\n    45\t        raise Unsupported('canonical ISO date required') from exc\n    46\t\n    47\t\n    48\tdef wire(value):\n    49\t    if isinstance(value, Fraction):\n    50\t        return str(value)\n    51\t    if isinstance(value, dict):\n    52\t        return {key: wire(val) for key, val in value.items()}\n    53\t    if isinstance(value, (list, tuple)):\n    54\t        return [wire(val) for val in value]\n    55\t    return value\n    56\t\n    57\t\n    58\tdef normal(value):\n    59\t    return re.sub(r'\\s+', ' ', value).strip()\n    60\t\n    61\t\n    62\tclass AuthorityBook:\n    63\t    def __init__(self, root=ROOT, records=None):\n    64\t        self.root = Path(root)\n    65\t        self.records = deepcopy(records) if records is not None else json.loads(\n    66\t            (self.root / REGISTER).read_text())\n    67\t        self.validate()\n    68\t\n    69\t    def validate(self):\n    70\t        d = self.records\n    71\t        if d.get('schema_version') != 'accdsl.p08.authority.v1':\n    72\t            raise Unsupported('authority schema')\n    73\t        self.sources = {r['id']: r for r in d['authorities']}\n    74\t        self.claims = {r['id']: r for r in d['claims']}\n    75\t        if len(self.sources) != len(d['authorities']) or len(self.claims) != len(d['claims']):\n    76\t            raise Unsupported('duplicate authority or claim')\n    77\t        for s in self.sources.values():\n    78\t            if s['access_status'] != 'inspected_primary':\n    79\t                continue\n    80\t            if s.get('kind') != 'primary_standard' or not s.get('inspected_at'):\n    81\t                raise Unsupported('uninspected or non-primary authority')\n    82\t            for key in ('retained', 'text'):\n    83\t                p = Path(s[key]['path'])\n    84\t                if p.is_absolute() or '..' in p.parts or (self.root / p).is_symlink():\n    85\t                    raise Unsupported('unsafe source path')\n    86\t                try:\n    87\t                    actual = sha256((self.root / p).read_bytes()).hexdigest()\n    88\t                except OSError as exc:\n    89\t                    raise Unsupported('missing source') from exc\n    90\t                if actual != s[key]['sha256']:\n    91\t                    raise Unsupported('source hash mismatch')\n    92\t            iso(s['period_start_inclusive']); iso(s['period_start_exclusive'])\n    93\t        for c in self.claims.values():\n    94\t            s = self.sources.get(c['authority_id'])\n    95\t            if not s or s['access_status'] != 'inspected_primary':\n    96\t                raise Unsupported('claim lacks inspected primary source')\n    97\t            pages = (self.root / s['text']['path']).read_text().split('\\f')\n    98\t            for a in c['anchors']:\n    99\t                if type(a['pdf_page']) is not int or not 1 <= a['pdf_page'] <= len(pages):\n   100\t                    raise Unsupported('invalid anchor page')\n   101\t                page = normal(pages[a['pdf_page'] - 1])\n   102\t                if normal(a['quote']) not in page or a['paragraph'] not in s['inspected_paragraphs']:\n   103\t                    raise Unsupported('unresolvable quote/paragraph')\n   104\t        if any(c not in self.claims for c in REQUIRED):\n   105\t            raise Unsupported('missing lifecycle authority')\n   106\t        if set(d['note_links']) != {'financing_carrying', 'financing_interest', 'financing_equity'}:\n   107\t            raise Unsupported('note schema')\n   108\t        for links in d['note_links'].values():\n   109\t            if not links or any(link not in self.claims for link in links):\n   110\t                raise Unsupported('unresolved note claim')\n   111\t\n   112\t    def admit(self, contract):\n   113\t        # Revalidate so a caller cannot bypass source checks by mutating records.\n   114\t        self.validate()\n   115\t        for key in REQUIRED:\n   116\t            s = self.sources[self.claims[key]['authority_id']]\n   117\t            if (contract.jurisdiction != s['jurisdiction'] or contract.basis != 'AASB'\n   118\t                    or contract.tier != s['tier'] or contract.entity_scope != s['entity_scope']):\n   119\t                raise Unsupported('authority jurisdiction/entity/tier mismatch')\n   120\t            for year in range(iso(contract.issue_date).year,\n   121\t                              iso(contract.issue_date).year + contract.years):\n   122\t                start = date(year, 1, 1)\n   123\t                if not iso(s['period_start_inclusive']) <= start < iso(s['period_start_exclusive']):\n   124\t                    raise Unsupported('edition outside reporting-period start')\n   125\t\n   126\t\n   127\t@dataclass(frozen=True)\n   128\tclass Contract:\n   129\t    entity: str = 'SyntheticIssuer'\n   130\t    book: str = 'statutory'\n   131\t    currency: str = 'AUD'\n   132\t    functional_currency: str = 'AUD'\n   133\t    jurisdiction: str = 'AU'\n   134\t    basis: str = 'AASB'\n   135\t    tier: str = 'Tier 1'\n   136\t    entity_scope: str = 'for-profit'\n   137\t    issue_date: str = '2024-01-01'\n   138\t    years: int = 2\n   139\t    principal: str = '100'\n   140\t    proceeds: str = '100'\n   141\t    instrument_fair_value: str = '100'\n   142\t    annual_coupon: str = '5'\n   143\t    comparable_yield: str = '1/10'\n   144\t    conversion_shares: int = 10\n   145\t    conversion_right: str = 'maturity_only_fixed_for_fixed_nonputtable_ordinary'\n   146\t    measurement: str = 'amortised_cost'\n   147\t    unsupported_features: tuple = ()\n   148\t\n   149\t    def validate(self):\n   150\t        if not self.entity or not self.book or not re.fullmatch('[A-Z]{3}', self.currency):\n   151\t            raise Unsupported('entity/book/currency required')\n   152\t        if self.currency != self.functional_currency:\n   153\t            raise Unsupported('FX unsupported')\n   154\t        if (type(self.years) is not int or not 1 <= self.years <= 10\n   155\t                or type(self.conversion_shares) is not int or self.conversion_shares <= 0):\n   156\t            raise Unsupported('invalid term or shares')\n   157\t        start = iso(self.issue_date)\n   158\t        if (start.month, start.day) != (1, 1):\n   159\t            raise Unsupported('annual calendar periods only')\n   160\t        if self.conversion_right != 'maturity_only_fixed_for_fixed_nonputtable_ordinary':\n   161\t            raise Unsupported('unsupported conversion terms')\n   162\t        if self.measurement != 'amortised_cost' or self.unsupported_features:\n   163\t            raise Unsupported('fees/tax/options/modifications/default and other features excluded')\n   164\t        p, proceeds, fair, coupon, rate = map(rational, (\n   165\t            self.principal, self.proceeds, self.instrument_fair_value,\n   166\t            self.annual_coupon, self.comparable_yield))\n   167\t        if p <= 0 or proceeds <= 0 or coupon < 0 or rate < 0 or proceeds != fair:\n   168\t            raise Unsupported('positive principal/proceeds, fair-value proceeds and nonnegative coupon/yield required')\n   169\t        liability = sum((coupon / (1 + rate) ** n for n in range(1, self.years + 1)), Fraction(0))\n   170\t        liability += p / (1 + rate) ** self.years\n   171\t        if liability > proceeds:\n   172\t            raise Unsupported('negative residual equity: assumptions need reassessment')\n   173\t        return liability\n   174\t\n   175\t    def coupon_dates(self):\n   176\t        y = iso(self.issue_date).year\n   177\t        return [date(y + i, 12, 31).isoformat() for i in range(self.years)]\n   178\t\n   179\t\n   180\tclass BondBook:\n   181\t    def __init__(self, contract, authority=None, opening_cash='20'):\n   182\t        liability = contract.validate()\n   183\t        self.authority = authority or AuthorityBook()\n   184\t        self.authority.admit(contract)\n   185\t        self.contract = contract\n   186\t        self.initial_liability = liability\n   187\t        opening = rational(opening_cash)\n   188\t        if opening < 0:\n   189\t            raise Unsupported('negative opening funding')\n   190\t        self._ledger = {k: Fraction(0) for k in ACCOUNTS}\n   191\t        self._ledger.update(cash=opening, opening_equity=-opening)\n   192\t        self._journal = []\n   193\t        self._used = set()\n   194\t        self._position = 0\n   195\t        self._shares = 0\n   196\t        self._principal = Fraction(0)\n   197\t        self._events = [('issue', contract.issue_date)]\n   198\t        for day in contract.coupon_dates():\n   199\t            self._events.extend([('accrue', day), ('coupon', day)])\n   200\t        self._events.append(('settle', contract.coupon_dates()[-1]))\n   201\t\n   202\t    @property\n   203\t    def state(self):\n   204\t        return deepcopy({'ledger': self._ledger, 'position': self._position,\n   205\t                         'shares': self._shares, 'principal_outstanding': self._principal,\n   206\t                         'journal': self._journal, 'used_event_ids': sorted(self._used)})\n   207\t\n   208\t    def apply(self, event_id, kind, day):\n   209\t        if not isinstance(event_id, str) or not event_id.strip() or event_id in self._used:\n   210\t            raise Unsupported('missing/duplicate event identity')\n   211\t        iso(day)\n   212\t        if self._position >= len(self._events):\n   213\t            raise Unsupported('already settled')\n   214\t        expected, expected_day = self._events[self._position]\n   215\t        if day != expected_day or (kind != expected and not (expected == 'settle' and kind in ('redeem', 'convert'))):\n   216\t            raise Unsupported('out-of-order or conflicting event')\n   217\t        c = self.contract\n   218\t        ledger = deepcopy(self._ledger)\n   219\t        shares, principal = self._shares, self._principal\n   220\t        postings = {}\n   221\t        claims = []\n   222\t        if kind == 'issue':\n   223\t            postings = {'cash': rational(c.proceeds), 'liability': -self.initial_liability,\n   224\t                        'conversion_equity': -(rational(c.proceeds) - self.initial_liability)}\n   225\t            principal = rational(c.principal)\n   226\t            claims = ['recognition', 'classification', 'split']\n   227\t        elif kind == 'accrue':\n   228\t            interest = -ledger['liability'] * rational(c.comparable_yield)\n   229\t            postings = {'interest_expense': interest, 'liability': -interest}\n   230\t            claims = ['measurement', 'interest']\n   231\t        elif kind == 'coupon':\n   232\t            coupon = rational(c.annual_coupon)\n   233\t            postings = {'liability': coupon, 'cash': -coupon}\n   234\t            claims = ['measurement', 'redemption']\n   235\t        elif kind in ('redeem', 'convert'):\n   236\t            carrying = -ledger['liability']\n   237\t            if carrying != rational(c.principal):\n   238\t                raise Unsupported('maturity liability does not equal principal')\n   239\t            postings = {'liability': carrying, 'cash' if kind == 'redeem' else 'share_equity': -carrying}\n   240\t            if kind == 'convert':\n   241\t                shares += c.conversion_shares\n   242\t            principal = Fraction(0)\n   243\t            claims = ['redemption' if kind == 'redeem' else 'conversion']\n   244\t        else:\n   245\t            raise Unsupported('unsupported event')\n   246\t        for account, amount in postings.items():\n   247\t            ledger[account] += amount\n   248\t        if sum(postings.values()) or sum(ledger.values()) or ledger['cash'] < 0 or ledger['liability'] > 0:\n   249\t            raise Unsupported('journal/state/funding invariant')\n   250\t        # Commit only after all validation, including funding and measurement.\n   251\t        entry = {'id': event_id, 'kind': kind, 'date': day, 'entity': c.entity,\n   252\t                 'book': c.book, 'currency': c.currency, 'postings_debit_positive': postings,\n   253\t                 'claims': claims, 'state_after': deepcopy(ledger)}\n   254\t        self._ledger, self._shares, self._principal = ledger, shares, principal\n   255\t        self._journal.append(entry)\n   256\t        self._used.add(event_id)\n   257\t        self._position += 1\n   258\t        return deepcopy(entry)\n   259\t\n   260\t    def notes(self):\n   261\t        periods = []\n   262\t        opening_carrying = Fraction(0)\n   263\t        for year in range(iso(self.contract.issue_date).year,\n   264\t                          iso(self.contract.issue_date).year + self.contract.years):\n   265\t            rows = [x for x in self._journal if x['date'].startswith(str(year))]\n   266\t            if not rows:\n   267\t                continue\n   268\t            def movement(kind, account):\n   269\t                return sum((x['postings_debit_positive'].get(account, Fraction(0))\n   270\t                            for x in rows if x['kind'] == kind), Fraction(0))\n   271\t            issued = -movement('issue', 'liability')\n   272\t            interest = movement('accrue', 'interest_expense')\n   273\t            coupons = movement('coupon', 'liability')\n   274\t            settled = movement('redeem', 'liability') + movement('convert', 'liability')\n   275\t            closing = -rows[-1]['state_after']['liability']\n   276\t            if opening_carrying + issued + interest - coupons - settled != closing:\n   277\t                raise Unsupported('note roll-forward mismatch')\n   278\t            periods.append({'period_start': f'{year}-01-01', 'period_end': f'{year}-12-31',\n   279\t                            'opening_liability': opening_carrying, 'issue_liability': issued,\n   280\t                            'interest_expense': interest, 'coupons': coupons, 'settlement_liability': settled,\n   281\t                            'closing_liability': closing, 'event_ids': [x['id'] for x in rows]})\n   282\t            opening_carrying = closing\n   283\t        return {'periods': periods, 'links': deepcopy(self.authority.records['note_links']),\n   284\t                'mandatory_disclosure_scope': 'selected carrying amount and interest only; not a complete AASB 7 note',\n   285\t                'conversion_equity': -self._ledger['conversion_equity'],\n   286\t                'issued_share_equity': -self._ledger['share_equity'], 'issued_shares': self._shares}\n   287\t\n   288\t\n   289\tdef run_case(contract=None, settlement='redeem', opening_cash='20', authority=None):\n   290\t    c = contract or Contract()\n   291\t    book = BondBook(c, authority, opening_cash)\n   292\t    book.apply('issue', 'issue', c.issue_date)\n   293\t    for i, day in enumerate(c.coupon_dates(), 1):\n   294\t        book.apply(f'accrue-{i}', 'accrue', day)\n   295\t        book.apply(f'coupon-{i}', 'coupon', day)\n   296\t    book.apply('settlement', settlement, c.coupon_dates()[-1])\n   297\t    return wire({'contract': vars(c), 'settlement': settlement, 'opening_cash': rational(opening_cash),\n   298\t                 'initial_liability': book.initial_liability, 'state': book.state, 'notes': book.notes()})\n   299\t\n   300\t\n   301\tdef compare_same_facts(contract=None, authority=None):\n   302\t    c = contract or Contract()\n   303\t    facts = wire(vars(c))\n   304\t    # Hash common economics without changing terms for an unavailable rule set.\n   305\t    economic = {k: v for k, v in facts.items() if k not in ('basis', 'jurisdiction', 'tier', 'entity_scope', 'book')}\n   306\t    digest = sha256(json.dumps(economic, sort_keys=True).encode()).hexdigest()\n   307\t    case = run_case(c, authority=authority)\n   308\t    rows = [{'standard': 'AASB', 'jurisdiction': 'AU', 'facts_sha256': digest,\n   309\t             'status': 'supported_bounded', 'initial_liability': case['initial_liability'],\n   310\t             'initial_equity': str(rational(c.proceeds) - rational(case['initial_liability'])),\n   311\t             'total_interest': case['state']['ledger']['interest_expense'],\n   312\t             'claims': list(REQUIRED)}]\n   313\t    for standard, jurisdiction, missing in [\n   314\t        ('US GAAP', 'US', 'Applicable ASC 470/815 and ASU 2020-06 text, adoption and exceptions uninspected; official PDF 403.'),\n   315\t        ('ASBE', 'CN', 'Official CAS 22/37 text, applicable edition and entity transition uninspected; MoF route 502.'),\n   316\t        ('EU-endorsed IFRS', 'EU', 'Applicable endorsed IAS 32/IFRS 9 text and amendments uninspected; EUR-Lex returned empty 202.')]:\n   317\t        rows.append({'standard': standard, 'jurisdiction': jurisdiction, 'facts_sha256': digest,\n   318\t                     'status': 'unresolved', 'initial_liability': None, 'initial_equity': None,\n   319\t                     'total_interest': None, 'claims': [], 'missing': missing})\n   320\t    return {'economic_facts': economic, 'rows': rows, 'supported_difference': None,\n   321\t            'criterion_status': 'incomplete: no second inspected applicable standard',\n   322\t            'interpretation': 'No numerical difference or equivalence is established; Australian adoption is not universal IFRS authority.'}\n","exit_code":0,"status":"completed"}}
