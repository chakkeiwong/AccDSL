sclosures\",\n      \"issuer\": \"Australian Accounting Standards Board\",\n      \"kind\": \"primary_standard\",\n      \"access_status\": \"inspected_primary\",\n      \"official_url\": \"https://www.aasb.gov.au/admin/file/content105/c9/AASB7_08-15_COMPdec22_01-23.pdf\",\n      \"retrieved_at\": \"2026-10-03T01:04:26.758268+00:00\",\n      \"inspected_at\": \"2026-10-03T01:14:19.665461+00:00\",\n      \"retained\": {\n        \"path\": \"docs/design/research/p08-v1/aasb7.pdf\",\n        \"sha256\": \"215bbd5ea6850443303046ad5c8587467a5b643910d2a2b5716569be2644a1bc\"\n      },\n      \"text\": {\n        \"path\": \"docs/design/research/p08-v1/aasb7.txt\",\n        \"sha256\": \"c825e043e0a120f15c1fde3236ae77bc1731ef527f6b388a483180e38da8a39d\"\n      },\n      \"edition\": \"31 December 2022 compilation; amendments through 15 December 2022\",\n      \"jurisdiction\": \"AU\",\n      \"entity_scope\": \"for-profit\",\n      \"tier\": \"Tier 1\",\n      \"period_start_inclusive\": \"2023-01-01\",\n      \"period_start_exclusive\": \"2026-07-01\",\n      \"transition_conditions\": \"Use this compilation only for annual periods with start in the stated interval; no optional early adoption of subsequent amendments. Synthetic cases use calendar 2024 and 2025.\",\n      \"applicability_anchor\": \"Cover and compilation preamble; Comparison with IAS/IFRS, Tier 1.\",\n      \"inspected_paragraphs\": [\n        \"7\",\n        \"8(g)\",\n        \"20(b)\"\n      ],\n      \"limits\": \"Only listed paragraphs inspected. Official Australian adoption; no universal IFRS jurisdiction conclusion.\"\n    }\n  ],\n  \"claims\": [\n    {\n      \"id\": \"recognition\",\n      \"authority_id\": \"aasb9\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"3.1.1\",\n          \"pdf_page\": 10,\n          \"quote\": \"when, and only when, the entity becomes party to the contractual provisions of the instrument\"\n        }\n      ],\n      \"supported_statement\": \"Recognise the contractual financial liability when the issuer becomes party; proceeds are assumed equal to instrument fair value.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"fair_value\",\n      \"authority_id\": \"aasb9\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"5.1.1\",\n          \"pdf_page\": 18,\n          \"quote\": \"measure a financial asset or financial liability at its fair value plus or minus\"\n        }\n      ],\n      \"supported_statement\": \"Initial measurement uses fair value; this slice assumes proceeds equal fair value and no transaction costs.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"classification\",\n      \"authority_id\": \"aasb132\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"22\",\n          \"pdf_page\": 12,\n          \"quote\": \"fixed number of its own equity instruments in exchange for a fixed amount of cash or another financial asset is an equity instrument.\"\n        }\n      ],\n      \"supported_statement\": \"Fixed-for-fixed equity classification, conditional on ordinary non-puttable shares, functional currency and exclusion of settlement alternatives/contingencies.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"split\",\n      \"authority_id\": \"aasb132\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"AG30–AG35\",\n          \"pdf_page\": 25,\n          \"quote\": \"On initial recognition, the fair value of the liability component is the present value of the contractually determined stream of future cash flows\"\n        }\n      ],\n      \"supported_statement\": \"AG31(a): discount liability cash flows at comparable non-convertible market yield; paragraphs 28–32 allocate residual proceeds to equity.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"residual_equity\",\n      \"authority_id\": \"aasb132\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"28–32\",\n          \"pdf_page\": 14,\n          \"quote\": \"the equity component is assigned the residual amount after deducting from the fair value of the instrument as a whole\"\n        }\n      ],\n      \"supported_statement\": \"Paragraph 31 supplies residual allocation. Equity is not remeasured; retained on expiry is a local deduction from paragraph 22 and liability-only extinguishment, not a separate quoted redemption rule.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"measurement\",\n      \"authority_id\": \"aasb9\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"4.2.1\",\n          \"pdf_page\": 16,\n          \"quote\": \"An entity shall classify all financial liabilities as subsequently measured at amortised cost, except for:\"\n        }\n      ],\n      \"supported_statement\": \"Ordinary liability uses amortised cost. Exclude fair-value designation/trading, derivatives, guarantees, transfer liabilities, below-market commitments and business-combination contingent consideration.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"interest\",\n      \"authority_id\": \"aasb9\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"Appendix A: effective interest\",\n          \"pdf_page\": 45,\n          \"quote\": \"the allocation and recognition of the interest revenue or interest expense in profit or loss over the relevant period.\"\n        }\n      ],\n      \"supported_statement\": \"Effective-interest method allocates interest expense; use opening liability times the assumed exact annual effective yield.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"amortised_cost\",\n      \"authority_id\": \"aasb9\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"Appendix A: amortised cost\",\n          \"pdf_page\": 44,\n          \"quote\": \"minus the principal repayments, plus or minus the cumulative amortisation using the effective interest method\"\n        }\n      ],\n      \"supported_statement\": \"Amortised cost roll-forward follows contractual payments and cumulative effective-interest amortisation.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"redemption\",\n      \"authority_id\": \"aasb9\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"3.3.1–3.3.3\",\n          \"pdf_page\": 14,\n          \"quote\": \"when, and only when, it is extinguished – ie when the obligation specified in the contract is discharged or cancelled or expires.\"\n        }\n      ],\n      \"supported_statement\": \"Remove the discharged liability; paragraph 3.3.3 difference is profit/loss. At this exact maturity, consideration equals carrying amount, so zero settlement gain/loss.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"conversion\",\n      \"authority_id\": \"aasb132\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"AG30–AG35\",\n          \"pdf_page\": 25,\n          \"quote\": \"On conversion of a convertible instrument at maturity, the entity derecognises the liability component and recognises it as equity.\"\n        }\n      ],\n      \"supported_statement\": \"AG32: maturity conversion reclassifies liability to equity, leaves original equity within equity and produces no gain/loss.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"note_carrying\",\n      \"authority_id\": \"aasb7\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"8(g)\",\n          \"pdf_page\": 8,\n          \"quote\": \"financial liabilities measured at amortised cost.\"\n        }\n      ],\n      \"supported_statement\": \"8(g), read with paragraph 8 lead-in: disclose carrying amounts of financial liabilities at amortised cost on the face or in notes.\",\n      \"status\": \"inspected_primary_conditional\"\n    },\n    {\n      \"id\": \"note_interest\",\n      \"authority_id\": \"aasb7\",\n      \"anchors\": [\n        {\n          \"paragraph\": \"20(b)\",\n          \"pdf_page\": 12,\n          \"quote\": \"total interest revenue and total interest expense (calculated using the effective interest method)\"\n        }\n      ],\n      \"supported_statement\": \"20(b): disclose effective-interest totals for liabilities not measured at fair value through profit/loss. This is selected note content only.\",\n      \"status\": \"inspected_primary_conditional\"\n    }\n  ],\n  \"access_attempts\": [\n    {\n      \"id\": \"aasb9\",\n      \"url\": \"https://www.aasb.gov.au/admin/file/content105/c9/AASB9_12-14_COMPdec22_01-23.pdf\",\n      \"retrieved_at\": \"2026-10-03T01:04:23.430065+00:00\",\n      \"status\": 200,\n      \"final_url\": \"https://www.aasb.gov.au/admin/file/content105/c9/AASB9_12-14_COMPdec22_01-23.pdf\",\n      \"content_type\": \"application/pdf\",\n      \"path\": \"docs/design/research/p08-v1/aasb9.pdf\",\n      \"sha256\": \"8f5a87c67a76c193bedeee8ea7f3f21556b3886eee4184a62c7045256b3f84f0\",\n      \"bytes\": 2195229\n    },\n    {\n      \"id\": \"fasb2020_06\",\n      \"url\": \"https://storage.fasb.org/ASU%202020-06_0.pdf\",\n      \"retrieved_at\": \"2026-10-03T01:04:25.541355+00:00\",\n      \"error\": \"HTTP Error 403: Forbidden\",\n      \"access_status\": \"unavailable\"\n    },\n    {\n      \"id\": \"aasb7\",\n      \"url\": \"https://www.aasb.gov.au/admin/file/content105/c9/AASB7_08-15_COMPdec22_01-23.pdf\",\n      \"retrieved_at\": \"2026-10-03T01:04:26.758268+00:00\",\n      \"status\": 200,\n      \"final_url\": \"https://www.aasb.gov.au/admin/file/content105/c9/AASB7_08-15_COMPdec22_01-23.pdf\",\n      \"content_type\": \"application/pdf\",\n      \"path\": \"docs/design/research/p08-v1/aasb7.pdf\",\n      \"sha256\": \"215bbd5ea6850443303046ad5c8587467a5b643910d2a2b5716569be2644a1bc\",\n      \"bytes\": 1329611\n    },\n    {\n      \"id\": \"mof22_candidate\",\n      \"url\": \"https://kjs.mof.gov.cn/zhengcefabu/201704/t20170406_2579238.htm\",\n      \"retrieved_at\": \"2026-10-03T01:05:21.892559+00:00\",\n      \"access_status\": \"unavailable\",\n      \"error\": \"HTTP Error 502: Bad Gateway\"\n    },\n    {\n      \"id\": \"eu2023_1803\",\n      \"url\": \"https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32023R1803\",\n      \"retrieved_at\": \"2026-10-03T01:05:57.801400+00:00\",\n      \"status\": 202,\n      \"final_url\": \"https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32023R1803\",\n      \"path\": \"docs/design/research/p08-v1/eu2023_1803.html\",\n      \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n      \"bytes\": 0\n    }\n  ],\n  \"note_links\": {\n    \"financing_carrying\": [\n      \"note_carrying\",\n      \"measurement\"\n    ],\n    \"financing_interest\": [\n      \"note_interest\",\n      \"interest\"\n    ],\n    \"financing_equity\": [\n      \"split\",\n      \"residual_equity\",\n      \"conversion\"\n    ]\n  },\n  \"research\": [\n    {\n      \"source\": \"docs/design/research/standards/actus-techspecs.tex\",\n      \"sha256\": \"ceab659d35dca615287360b9266cf105a9e2a79e99ee75253ea8b3abc5af91d9\",\n      \"inspected_sections\": [\n        \"State Variables (sec:statevarsnotat)\",\n        \"Contract Events (sec:events)\",\n        \"Payoff Functions (sec:pof)\"\n      ],\n      \"decision\": \"defer integration; no ACTUS algorithm, schedule, code or forecast mechanism adopted\",\n      \"support\": \"Retained technical specification distinguishes dated events, state changes and cash-flow functions.\",\n      \"transfer_limit\": \"Implementation uses an explicit user-specified annual schedule and local accounting transitions. No ACTUS compatibility, official-code equivalence, empirical evaluation or company-simulation validity claim. Broader method/theory/evaluation and code audit required before future adoption.\"\n    }\n  ],\n  \"method_queue\": [\n    {\n      \"method\": \"revenue\",\n      \"operation_boundary\": \"single contract, performance obligation, delivery/collection\",\n      \"missing_authority\": \"Applicable AASB 15/ASC 606/ASBE 14 primary paragraphs\",\n      \"unresolved_interpretation\": \"Distinct promises, variable-consideration constraint and timing\",\n      \"next_exact_case\": \"Two obligations, advance cash, partial delivery and refund\",\n      \"requirements\": [\n        \"MC15\",\n        \"MC19\"\n      ],\n      \"gaps\": [\n        \"G4\",\n        \"G7\"\n      ],\n      \"status\": \"internal_follow_up\"\n    },\n    {\n      \"method\": \"tax\",\n      \"operation_boundary\": \"current tax and one temporary difference\",\n      \"missing_authority\": \"Applicable AASB 112/ASC 740/ASBE 18 and tax law\",\n      \"unresolved_interpretation\": \"Tax base, enacted rates and deferred-tax recoverability\",\n      \"next_exact_case\": \"Two-year depreciation difference and loss carryforward\",\n      \"requirements\": [\n        \"MC15\",\n        \"MC19\"\n      ],\n      \"gaps\": [\n        \"G4\",\n        \"G7\"\n      ],\n      \"status\": \"internal_follow_up\"\n    },\n    {\n      \"method\": \"leases\",\n      \"operation_boundary\": \"lessee recognition through one remeasurement\",\n      \"missing_authority\": \"Applicable AASB 16/ASC 842/ASBE 21\",\n      \"unresolved_interpretation\": \"Renewal certainty, lease term and discount-rate reset\",\n      \"next_exact_case\": \"Lease commencement, coupon, changed option and termination\",\n      \"requirements\": [\n        \"MC15\",\n        \"MC19\"\n      ],\n      \"gaps\": [\n        \"G4\",\n        \"G7\"\n      ],\n      \"status\": \"internal_follow_up\"\n    },\n    {\n      \"method\": \"FX\",\n      \"operation_boundary\": \"foreign-currency payable then settlement; translation separate\",\n      \"missing_authority\": \"Applicable AASB 121/ASC 830/ASBE 19\",\n      \"unresolved_interpretation\": \"Functional currency, monetary classification and translation reserves\",\n      \"next_exact_case\": \"Year-end payable remeasurement and next-year cash settlement\",\n      \"requirements\": [\n        \"MC06\",\n        \"MC15\",\n        \"MC19\"\n      ],\n      \"gaps\": [\n        \"G4\",\n        \"G7\"\n      ],\n      \"status\": \"internal_follow_up\"\n    },\n    {\n      \"method\": \"complex_groups\",\n      \"operation_boundary\": \"acquisition, NCI, eliminations and disposal\",\n      \"missing_authority\": \"Applicable AASB 3/10/128, ASC 805/810 and ASBE 20/33\",\n      \"unresolved_interpretation\": \"Control, substantive rights, common control and NCI measurement\",\n      \"next_exact_case\": \"Mid-year acquisition, intercompany sale, partial disposal\",\n      \"requirements\": [\n        \"MC06\",\n        \"MC15\",\n        \"MC19\"\n      ],\n      \"gaps\": [\n        \"G4\",\n        \"G7\"\n      ],\n      \"status\": \"internal_follow_up\"\n    },\n    {\n      \"method\": \"bonds\",\n      \"operation_boundary\": \"extend issuer lifecycle beyond fixed maturity conversion\",\n      \"missing_authority\": \"Applicable ASC 470/815, ASU 2020-06 and ASBE 22/37; further AASB provisions\",\n      \"unresolved_interpretation\": \"Early repurchase, inducement, modification, embedded terms, default and disclosure completeness\",\n      \"next_exact_case\": \"Early cash repurchase with separated consideration and reconciled equity\",\n      \"requirements\": [\n        \"MC17\",\n        \"MC19\",\n        \"MC29\",\n        \"MC30\"\n      ],\n      \"gaps\": [\n        \"G4\",\n        \"G7\",\n        \"G8\"\n      ],\n      \"status\": \"internal_follow_up\"\n    }\n  ],\n  \"prior_blocks\": \"The historical FASB ASU 2015-11 and MoF index blocks remain preserved in standards-support.json. New attempts above are distinct document routes; no challenge bypass or unchanged retry.\",\n  \"uninspected_standards\": [\n    \"ASC 470/815 and ASU 2020-06\",\n    \"ASBE 22/37\",\n    \"EU-endorsed IAS 32/IFRS 9\"\n  ],\n  \"inspection_limit\": \"Quotes and page resolution establish retained support, not exhaustive reading or full accounting compliance. Synthetic eligibility declarations need actual contract/yield evidence before real application.\"\n}\n","exit_code":0,"status":"completed"}}
