, target: Context | Mapping[str, Any],\nscripts/context_chronology_v1.py:264:def check_partition(population: Iterable[str], members: Mapping[str, Iterable[str]], *,\nscripts/context_chronology_v1.py:303:def map_components(source: Context, target: Context, rule: MappingRule, *,\nscripts/context_chronology_v1.py:306:    \"\"\"Finite exact sum/reclassification; each atomic value occurs once.\"\"\"\nscripts/context_chronology_v1.py:311:        target_context=rule.target_context, effective_start=rule.effective_start,\nscripts/context_chronology_v1.py:312:        effective_end=rule.effective_end, provenance=rule.provenance)], at=at)\nscripts/context_chronology_v1.py:322:def combine_partitions(partitions: Sequence[Mapping[str, Any]]) -> dict[str, Any]:\nscripts/context_chronology_v1.py:333:def _availability(value: Any, *, timezone_name: str | None, date_only_policy: str | None, where: str) -> datetime:\nscripts/context_chronology_v1.py:356:def _validate_assertions(assertions: Sequence[Mapping[str, Any]]) -> dict[str, Mapping[str, Any]]:\nscripts/context_chronology_v1.py:388:def select_evidence(assertions: Sequence[Mapping[str, Any]], cutoff: str | datetime | date, *,\nscripts/context_chronology_v1.py:462:def _row_context(row: Mapping[str, Any]) -> str:\nscripts/context_chronology_v1.py:466:def subtract_cumulative(total: Mapping[str, Any], earlier: Mapping[str, Any], *,\nscripts/context_chronology_v1.py:517:def _validate_joint_law(law: Any, where: str) -> list[dict[str, Any]]:\nscripts/context_chronology_v1.py:539:def admit_uncertainty(record: Mapping[str, Any], *, known_records: Mapping[str, Mapping[str, Any]] | None = None,\nscripts/context_chronology_v1.py:545:        \"AccountingElection\": (\"package\", \"permitted_treatments\", \"election\", \"effective_date\", \"eligibility_evidence\"),\nscripts/context_chronology_v1.py:621:        when = _iso_date(record[\"effective_date\"], \"election.date\")\nscripts/context_chronology_v1.py:688:def guard_information_view(view: Ma