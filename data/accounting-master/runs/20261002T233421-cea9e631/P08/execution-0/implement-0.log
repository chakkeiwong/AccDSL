{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport urllib.request,pathlib,json,hashlib,datetime\nbase=pathlib.Path('docs/design/research/p08-v1');records=[]\nurls=[('aasb9','https://www.aasb.gov.au/admin/file/content105/c9/AASB9_12-14_COMPdec22_01-23.pdf'),('fasb2020_06','https://storage.fasb.org/ASU%202020-06_0.pdf'),('aasb7','https://www.aasb.gov.au/admin/file/content105/c9/AASB7_08-15_COMPdec22_01-23.pdf')]\nfor name,url in urls:\n r={'id':name,'url':url,'retrieved_at':datetime.datetime.now(datetime.timezone.utc).isoformat()}\n try:\n  with urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'AccDSL source research'}),timeout=20) as response:\n   body=response.read();r.update(status=response.status,final_url=response.url,content_type=response.headers.get('Content-Type'))\n  path=base/(name+('.pdf' if body.startswith(b'%PDF') else '.html'));path.write_bytes(body);r.update(path=str(path),sha256=hashlib.sha256(body).hexdigest(),bytes=len(body))\n except Exception as e:r.update(error=str(e),access_status='unavailable')\n records.append(r);print(json.dumps(r))\n(base/'access-records.json').write_text(json.dumps(records,indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
