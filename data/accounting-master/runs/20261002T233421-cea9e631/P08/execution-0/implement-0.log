\", \"url\": \"https://www.aasb.gov.au/admin/file/content105/c9/AASB7_08-15_COMPdec22_01-23.pdf\", \"retrieved_at\": \"2026-10-03T01:04:26.758268+00:00\", \"status\": 200, \"final_url\": \"https://www.aasb.gov.au/admin/file/content105/c9/AASB7_08-15_COMPdec22_01-23.pdf\", \"content_type\": \"application/pdf\", \"path\": \"docs/design/research/p08-v1/aasb7.pdf\", \"sha256\": \"215bbd5ea6850443303046ad5c8587467a5b643910d2a2b5716569be2644a1bc\", \"bytes\": 1329611}\n","exit_code":0,"status":"completed"}}
