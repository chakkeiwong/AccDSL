r', 'plan_sha256', 'policies', 'reconciliations', 'recovery_plan_sha256', 'representation_comparison', 'rounding_model', 'schema_version', 'scope', 'source_acquisition', 'source_bindings', 'source_pins', 'unidentified_histories']\n19:from test_accounting_p03 import bindings, BASE\n60:    def test_p03_parent_views(self):\n65:            p=from_p03(c.ir,bindings(),{'DemoDebt@1/DebtMix':'fixed-floating-amounts-v1'})\n77:        self.record('p03_views',results)\n131:        measure=FiniteMeasure([{'id':'fixed','hypothesis':{'economic_state':'fixed'},'weight':'3/5','status':'complete','outcome':'5'}, {'id':'floating','hypothesis':{'economic_state':'floating'},'weight':'2/5','status':'unsupported','outcome':None}], 'explicit synthetic joint prior')\n137:        contracts=[{'id':str(i),'principal':str(10+i),'rate':'1/20','reset':'fixed','maturity':'2030','hedge':'none'} for i in range(2)]\n146:    def test_view_union_order_and_joint_outputs(self):\n148:        p=from_p03(compile_source(source,bindings()).ir,bindings(),{'DemoDebt@1/DebtMix':'fixed-floating-amounts-v1'})\n156:        pp=from_p03(compile_source(swapped,bindings()).ir,bindings(),{'DemoDebt@1/DebtMix':'fixed-floating-amounts-v1'})\n158:        joint=solve(p,B,extra=[p.outputs['fixed']==100,p.outputs['floating']==100])\n159:        self.assertEqual(joint['status'],'Infeasible')\n161:        self.record('view_union_joint',{'parent':parent,'intersection':intersection,'union':union,'incompatible_marginals':joint})\n248:        m=FiniteMeasure([{'id':'a','hypothesis':{'economic_state':'a'},'weight':'1/4','status':'default','outcome':None}, {'id':'b','hypothesis':{'economic_state':'b'},'weight':'1/4','status':'unresolved','outcome':None}, {'id':'c','hypothesis':{'economic_state':'c'},'weight':'1/2','status':'complete','outcome':'10'}], 'synthetic disjoint economic hypotheses')\n273:        contracts=[{'id':'duplicate','principal':'10','rate':'1/20','reset':'fixed','maturity':'2030','hedge':'none'}]*2\n299:    def test_p03_changed_principal_and_rates(self):\n301:        for principal,fixed,stress in ((150,'0.04','0.09'),(80,'0.06','0.03')):\n302:            source=BASE.replace('100 USD',f'{principal} USD').replace('0.05 per year',fixed+' per year').replace('0.07 per year',stress+' per year')\n303:            bound=bindings(principal);compiled=compile_source(source,bound)\n305:            p=from_p03(compiled.ir,bound,{'DemoDebt@1/DebtMix':'fixed-floating-amounts-v1'})\n307:            endpoints=sorted([F(principal)*F(fixed),F(principal)*F(stress)])\n310:            self.assertEqual([F(conditional['bounds'][d]['value']) for d in ('lower','upper')],[F(principal)*F(fixed)]*2)\n313:            self.assertEqual(F(middle['cells'][0]['outputs']['interest']),F(principal)*(F(fixed)+F(stress))/2)\n314:            evidence.append({'principal':principal,'rates':[fixed,stress],'oracle_endpoints':list(map(str,endpoints)),\n316:        self.record('p03_metamorphic_rates',evidence)\n","exit_code":0,"status":"completed"}}
