{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport json,pathlib\nfor f in ['docs/design/fixtures/northstar.json','docs/design/fixtures/temporal.json']:\n d=json.loads(pathlib.Path(f).read_text()); print(f, 'keys',list(d))\n for k in d:\n  if k not in ['historical_events','forecast_events','expected','scenarios']: print(k, str(d[k])[:1700])\n print('expected',str(d.get('expected'))[:1000])\nfor f in ['data/accounting-master/deliverables/P05/execution.json','data/accounting-master/deliverables/P05/result.md','tests/test_accounting_p05.py']:\n print(f,'exists',pathlib.Path(f).exists())\nPY\"","aggregated_output":"docs/design/fixtures/northstar.json keys ['schema', 'entity', 'currency', 'units', 'basis', 'disclosure_scope', 'assumptions', 'accounts', 'opening', 'historical_events', 'expected', 'forecast', 'coverage_units']\nschema accdsl-design-fixture/1\nentity Northstar Components (synthetic)\ncurrency USD\nunits one currency unit\nbasis DemoCorporate/1; not GAAP certification\ndisclosure_scope Closed synthetic goods company; the listed source package is complete by construction\nassumptions {'historical_resolution': 'half-year aggregate flows; existence of intraperiod schedules required, not recovered invoices', 'inventory': 'one homogeneous good at cost 5; purchases before delivery; quantities equal costs/5', 'sales': 'delivery transfers control; no returns, services, variable consideration or foreign currency', 'tax': '20% positive taxable profit, all expenses deductible, no deferred tax; excess payment is prepaid tax', 'plant': 'opening cost 100, annual depreciation 10; end-H1 addition 10 lives 5 years; end-H2 addition 12 lives 12 years; zero residuals', 'debt': '100 throughout; fixed and floating both 5% in 2024; fixed 5%, floating resets to 7% in 2025; all maturities after forecast', 'time': 'half-year accrual fractions 1/2, annual 1; explicit teaching convention', 'closing': 'temporary accounts closed after each H1/H2; annual income uses movements excluding closing', 'universe': 'no omitted company, OCI, acquisition, tax or off-balance-sheet operations inside this synthetic package'}\naccounts {'cash': 'asset', 'receivables': 'asset', 'inventory': 'asset', 'plant_cost': 'asset', 'accum_depreciation': 'contra_asset', 'tax_prepaid': 'asset', 'payables': 'liability', 'debt': 'liability', 'capital': 'equity', 'retained': 'equity', 'revenue': 'income', 'cost_of_sales': 'expense', 'payroll': 'expense', 'depreciation': 'expense', 'interest': 'expense', 'tax': 'expense'}\nopening {'cash': '60', 'receivables': '20', 'inventory': '30', 'plant_cost': '100', 'accum_depreciation': '-20', 'tax_prepaid': '0', 'payables': '-20', 'debt': '-100', 'capital': '-50', 'retained': '-20'}\nforecast {'start': '2025-01-01', 'end_exclusive': '2026-01-01', 'demand_units': '30', 'price': '10', 'unit_cost': '5', 'target_inventory_units': '8', 'current_sales_collection_fraction': '0.9', 'legacy_receivable_collections': '10', 'old_payables_paid': '30', 'new_purchases_paid': '130', 'payroll': '50', 'capex_at_period_end': '20', 'dividend': '8', 'tax_rate': '0.2', 'funding_limit': '0'}\ncoverage_units [{'id': 'NS.opening', 'kind': 'statement', 'disposition': 'structured', 'content': 'Opening balance sheet and account balances'}, {'id': 'NS.h1.original', 'kind': 'statement', 'disposition': 'superseded_reading_preserved', 'content': 'Originally revenue 120, receivables 30, tax expense/payment 3.5, profit 14, equity 80'}, {'id': 'NS.h1.correction', 'kind': 'note', 'disposition': 'structured', 'content': 'Premature invoice 10: reverse revenue and receivable; reduce tax expense 2 into tax prepayment; corrected profit 6'}, {'id': 'NS.fy', 'kind': 'statement', 'disposition': 'structured', 'content': 'Annual and revised interim statements derived from listed events'}, {'id': 'NS.operations', 'kind': 'policy', 'disposition': 'structured', 'content': 'Goods, inventory, asset and working-capital assumptions above'}, {'id': 'NS.debt', 'kind': 'note', 'disposition': 'alternative_family', 'content': 'Principal 100, interest 5; fixed/floating composition undisclosed'}, {'id': 'NS.equity', 'kind': 'note', 'disposition': 'structured', 'content': 'Capital 50; original retained 20; dividends H1 4, H2 5'}, {'id': 'NS.reference', 'kind': 'cross_reference', 'disposition': 'resolved', 'target': 'NS.debt', 'content': 'Financing note applies to debt and interest in every statement'}]\nexpected {'2024H1': {'cash': '65', 'receivables': '20', 'inventory': '25', 'plant_net': '85', 'tax_prepaid': '2', 'assets': '197', 'payables': '25', 'debt': '100', 'equity': '72', 'revenue': '110', 'profit': '6', 'operating_cash': '19', 'investing_cash': '-10', 'financing_cash': '-4'}, '2024H2': {'cash': '74.6', 'receivables': '35', 'inventory': '20', 'plant_net': '91', 'tax_prepaid': '0', 'assets': '220.6', 'payables': '30', 'debt': '100', 'equity': '90.6', 'revenue': '150', 'profit': '23.6', 'operating_cash': '26.6', 'investing_cash': '-12', 'financing_cash': '-5'}, '2024FY': {'revenue': '260', 'profit': '29.6', 'operating_cash': '45.6', 'investing_cash': '-22', 'financing_cash': '-9', 'cash_change': '14.6'}, '2025_fixed': {'cash': '95.2', 'receivables': '55', 'inventory': '40', 'plant_net': '98', 'tax_prepaid': '0', 'assets': '288.2', 'payables': '40', 'debt': '100', 'equity': '148.2', 'revenue': '300', 'profit': '65.6', 'interest': '5', 'tax': '16.4', 'operating_cash': '48.6', 'investing_ca\ndocs/design/fixtures/temporal.json keys ['availability_policy', 'assertions', 'queries', 'expected_valid_h2', 'incompatible_vintage_h2']\navailability_policy date-only filing is available at next midnight in stated reporting timezone\nassertions [{'id': 'h1-original', 'key': 'revenue:H1:USD:NS:Demo', 'value': '120', 'available': '2024-08-01T00:00:00Z', 'ingested': '2024-08-03T00:00:00Z', 'vintage': 'v1', 'supersedes': []}, {'id': 'h1-restated', 'key': 'revenue:H1:USD:NS:Demo', 'value': '110', 'available': '2025-03-02T00:00:00Z', 'ingested': '2025-03-05T00:00:00Z', 'vintage': 'v2', 'supersedes': ['h1-original']}, {'id': 'fy', 'key': 'revenue:FY:USD:NS:Demo', 'value': '260', 'available': '2025-03-02T00:00:00Z', 'ingested': '2025-03-05T00:00:00Z', 'vintage': 'v2', 'supersedes': []}]\nqueries [{'cutoff': '2024-09-01T00:00:00Z', 'system_as_of': None, 'expect': ['h1-original']}, {'cutoff': '2025-03-03T00:00:00Z', 'system_as_of': None, 'expect': ['h1-restated', 'fy']}, {'cutoff': '2025-03-03T00:00:00Z', 'system_as_of': '2025-03-04T00:00:00Z', 'expect': ['h1-original']}, {'cutoff': '2025-03-06T00:00:00Z', 'system_as_of': None, 'mode': 'original', 'expect': ['h1-original', 'fy']}]\nexpected_valid_h2 150\nincompatible_vintage_h2 140 must be rejected\nexpected None\ndata/accounting-master/deliverables/P05/execution.json exists False\ndata/accounting-master/deliverables/P05/result.md exists False\ntests/test_accounting_p05.py exists False\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,64p;160,206p;250,270p' docs/design/chapters/13-reference-company.tex; sed -n '178,194p;240,285p' scripts/reconstruction_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,64p;160,206p;250,270p' docs/design/chapters/13-reference-company.tex; sed -n '178,194p;240,285p' scripts/reconstruction_v1.py\"","aggregated_output":"\\chapter{A complete company and a real disclosure}\n\\label{ch:case}\n\n\\section{What a balance must remember}\n\nNorthstar Components is a synthetic seller of one homogeneous good. Its\ndisclosures, transactions and contract terms are specified together, so we can\ncheck whether reconstruction preserves a known possible history. All amounts\nin this example are currency units, not thousands. The company has no foreign\ncurrency, subsidiaries, leases, returns or other comprehensive income. These\nare declared features of the example, not assumptions to impose on an imported\ncompany. Its source package and expected results are supplied in\n\\code{fixtures/northstar.json}.\n\nAt the beginning of 2024, Northstar holds cash of 60, receivables of 20,\ninventory of 30 and plant costing 100 with accumulated depreciation of 20.\nIt owes suppliers 20 and lenders 100. Share capital is 50 and retained earnings\nare 20. Thus assets of 190 equal liabilities of 120 plus equity of 70.\nInventory consists of six units costing 5 each. The existing plant depreciates\nby 10 a year, with no residual value. The loan remains outstanding throughout\n2024; both possible contract types charge 5\\% during that year.\n\nThe six months ending June and December provide two successive observation\nperiods. Here the chosen accrual convention assigns one half-year to each.\nCash-flow dates within a half-year are not recovered from a period aggregate;\nthe synthetic history supplies a feasible ordering in which inventory is\npurchased before delivery and customer receipts precede the payments they fund.\nMore detailed liquidity questions require more detailed dates.\n\n\\begin{center}\n\\begin{tabular}{lrr}\n\\toprule Movement & First half & Second half\\\\\\midrule\nDelivered sales on credit &110&150\\\\\nCustomer collections &110&135\\\\\nInventory purchases on credit &70&85\\\\\nSupplier payments &65&80\\\\\nCost of goods delivered &75&90\\\\\nPayroll paid &20&22\\\\\nPlant purchased at period end &10&12\\\\\nDepreciation &5&6\\\\\nInterest accrued and paid &2.5&2.5\\\\\nTax expense &1.5&5.9\\\\\nTax paid &3.5&3.9\\\\\nDividends paid &4&5\\\\\\bottomrule\n\\end{tabular}\n\\end{center}\n\nEach row has an economic meaning before it has a posting. Delivery of the\ngood transfers control and creates an unconditional receivable; invoicing is\nassumed simultaneous in this example. Collection settles that receivable.\nPurchases increase inventory and trade payables; paying the supplier settles\nthe payable. Delivery separately removes inventory at cost. Plant purchases\nare capital expenditure, while depreciation consumes its service potential.\nThe addition of 10 enters service after June and has a five-year life, producing\none unit of second-half depreciation. The addition of 12 enters service after\nDecember and has a twelve-year life.\n\nTax is deliberately simple: 20\\% of positive profit before tax, with all these\nexpenses deductible and no deferred tax. The first-half payment exceeds its\ntax expense by 2, leaving prepaid tax; that prepayment is used in the second\nhalf. A genuine corporate tax package would need jurisdiction, tax basis,\nlosses, timing differences and payment schedules. The example's tax rule\ngoverns its own numbers only.\n\nsupports it. A later date alone does not establish such a relationship.\n\n\\section{One economic scenario, several complete futures}\n\nFor 2025, assume demand for 30 units at price 10, unit purchase cost 5 and a\ntarget closing inventory of eight units. Opening inventory is four units, so\nthe purchase decision is $30+8-4=34$ units, costing 170. Deliveries cost 150,\nleaving inventory of 40. Collect 90\\% of current sales and 10 of old\nreceivables: $270+10=280$, leaving receivables of 55. Pay old suppliers 30\nand 130 of the new purchases, leaving payables of 40. Payroll is 50, capital\nexpenditure of 20 occurs at year-end and dividends are 8.\n\nThese decisions are inputs to a conditional forecast. They are not estimates\nof demand or optimal management responses. No new borrowing is available.\nUnder the existing asset schedules, depreciation is $10+10/5+12/12=13$.\nThe new year-end asset begins depreciation in the next period. Let\n$\\alpha=F/100$. With the floating rate resetting to 7\\%, interest is\n$I=7-2\\alpha$. Profit before tax is\n$300-150-50-13-I=80+2\\alpha$, giving tax $16+0.4\\alpha$ and profit\n$64+1.6\\alpha$.\n\n\\begin{center}\n\\begin{tabular}{lrr}\n\\toprule 2025 statement amount & All fixed & All floating\\\\\\midrule\nRevenue &300&300\\\\\nInterest expense &5&7\\\\\nTax expense &16.4&16\\\\\nProfit and comprehensive income &65.6&64\\\\\nOperating cash flow &48.6&47\\\\\nInvesting cash flow &$-20$&$-20$\\\\\nFinancing cash flow &$-8$&$-8$\\\\\\midrule\nClosing cash &95.2&93.6\\\\\nReceivables / inventory / net plant &55 / 40 / 98&55 / 40 / 98\\\\\nAssets &288.2&286.6\\\\\nPayables / debt &40 / 100&40 / 100\\\\\nEquity &148.2&146.6\\\\\\bottomrule\n\\end{tabular}\n\\end{center}\n\nThe joint symbolic result is cash $93.6+1.6\\alpha$, profit\n$64+1.6\\alpha$ and equity $146.6+1.6\\alpha$, with the same\n$\\alpha\\in[0,1]$ throughout. Selecting the smallest cash and largest equity\nindependently would describe no feasible company. A requested distribution\nrequires a measure over that same historical family; the accounting equations\ndo not supply one.\n\n\\section{Apple: source labels do not identify exposure}\nTo demonstrate a source-to-forecast calculation, freeze the interim balance\nsheet and apply a \\emph{marginal} financing stress for a following 13-week\nperiod: a 200-basis-point rate increase, no principal change, no offsetting\nhedge beyond the explicitly selected exposure, immediate cash settlement and\nno tax effect. An assumed effective floating exposure $E=14{,}575$ million\nproduces $0.02\\times(13/52)E=72.875$ million additional interest. This exposure\nuses the annual notional as a conditional input; it is not asserted to be the\ninterim net sensitivity. Under that condition, debit interest expense and\ncredit cash by 72.875. The resulting marginal statements have cash 30,226.125,\nassets 344,012.125, liabilities 277,327, equity 66,685.125, profit and comprehensive\nincome of $-72.875$, and operating cash flow of $-72.875$ relative to the frozen\nbaseline. The balance-sheet difference equals the equity difference exactly.\n\nIf exposure is instead only restricted to $0\\leq E\\leq14{,}575$, the\nconditional added interest lies in $[0,72.875]$ before monetary rounding. That\nrestriction is a stress assumption and is not claimed to bound every real\nApple exposure. This real case verifies evidence, context, mappings and a\ncoherent marginal propagation. Northstar supplies the complete-company\nforecast; a complete Apple forecast remains dependent on its unmodelled\noperations and undisclosed terms.\ndef from_p03(ir, bindings, template_bindings):\n    from core0_ir_v1 import validate_ir\n    valid = validate_ir(ir, bindings)\n    if not valid.valid:\n        raise ValueError('P03 IR failed validation: ' + str(valid.diagnostics))\n    if set(template_bindings) != {'DemoDebt@1/DebtMix'} or template_bindings['DemoDebt@1/DebtMix'] != 'fixed-floating-amounts-v1':\n        raise ValueError('explicit supported template binding required')\n    family = ir['historyFamilies'][0]; scope = ir['modelScopes'][0]\n    p = Problem(scope['id'], family['evidence_view'], exclusions=scope['exclusions'], obligations=scope['obligations'])\n    p.provenance = {'p03_ir_sha256': hashlib.sha256(json.dumps(ir,sort_keys=True).encode()).hexdigest(),\n                    'template_bindings': dict(template_bindings), 'observation_ids': [x['id'] for x in ir['observations']],\n                    'source_refs': ir['contracts'][0]['source_refs']}\n    for row in ir['symbols']:\n        v = z3.Real(row['id']); p.variables[row['id']] = v\n        p.add('domain:'+row['id'],domain_formula(v,row['domain']))\n    observations = {r['id']: r for r in ir['observations']}\n    exprs = {r['id']:r for r in ir['expressions']}\nclass FiniteMeasure:\n    def __init__(self, atoms, justification, used=()):\n        if not justification:raise ValueError('explicit joint-measure justification required')\n        self.atoms=deepcopy(atoms);self.justification=justification;self.used=set(used)\n        ids=[a['id'] for a in atoms]\n        if len(ids)!=len(set(ids)) or not atoms:raise ValueError('distinct joint atoms required')\n        hypotheses = [a.get('hypothesis') for a in atoms]\n        if any(not isinstance(h, dict) or not h for h in hypotheses):\n            raise ValueError('explicit complete finite economic assignments required')\n        keys = set(hypotheses[0])\n        if any(set(h) != keys or any(isinstance(v, (dict,list)) for v in h.values()) for h in hypotheses):\n            raise ValueError('joint hypotheses require the same complete scalar coordinates')\n        if len({json.dumps(h,sort_keys=True) for h in hypotheses}) != len(hypotheses):\n            raise ValueError('overlapping identical economic hypotheses')\n        weights=[rational(a['weight']) for a in atoms]\n        if any(w<0 for w in weights) or sum(weights)!=1:raise ValueError('joint weights must sum to one')\n    def update(self, likelihood, information_blocks):\n        blocks=set(information_blocks)\n        if not blocks or len(blocks) != len(information_blocks) or blocks & self.used:raise ValueError('repeated/missing information block')\n        if set(likelihood)!={a['id'] for a in self.atoms}:raise ValueError('likelihood must cover every atom')\n        ls={k:rational(v) for k,v in likelihood.items()}\n        if any(v<0 or v>1 for v in ls.values()):raise ValueError('invalid event likelihood')\n        weights=[rational(a['weight'])*ls[a['id']] for a in self.atoms]; total=sum(weights)\n        if total==0:raise ValueError('zero-probability conditioning')\n        new=[dict(a,weight=str(w/total)) for a,w in zip(self.atoms,weights)]\n        return FiniteMeasure(new,self.justification,self.used|blocks)\n    def event(self, ids):\n        ids=set(ids)\n        if ids-{a['id'] for a in self.atoms}:raise ValueError('unknown atom')\n        return sum((rational(a['weight']) for a in self.atoms if a['id'] in ids),F(0))\n    def summary(self):\n        mass={};mean=F(0);available=True\n        for a in self.atoms:\n            w=rational(a['weight']); status=a['status'];mass[status]=mass.get(status,F(0))+w\n            if a.get('outcome') is None:\n                if w:available=False\n            else:mean+=w*rational(a['outcome'])\n        return {'mass':{k:str(v) for k,v in mass.items()},'mean':str(mean) if available else None,\n                'normalised_over_successful_only':False}\n\n\ndef weighted_summary(measure):\n    if not isinstance(measure,FiniteMeasure):raise ValueError('unweighted families have no mean')\n    return measure.summary()\n\n\n","exit_code":0,"status":"completed"}}
