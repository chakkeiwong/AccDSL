{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' scripts/check_repair_conformance.py; sed -n '178,240p' scripts/reconstruction_v1.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Deterministic reference checks for the design, not a product test suite.\n\nUses independently authored expectations and exact arithmetic. Z3 checks the\ndocument's supported rational-linear constraints; no statistical claim follows.\n\"\"\"\nfrom collections import defaultdict\nfrom copy import deepcopy\nfrom fractions import Fraction as Q\nimport hashlib\nimport json\nfrom pathlib import Path\nimport platform\nimport time\nimport z3\n\nROOT=Path(__file__).resolve().parents[1]\nFIX=ROOT/'docs/design/fixtures'\nchecks=[]\n\ndef load(name): return json.loads((FIX/name).read_text())\ndef check(name, condition, detail):\n    checks.append(dict(name=name,passed=bool(condition),detail=detail))\n    if not condition: raise AssertionError(name+': '+str(detail))\n\ndef post(state, e, committed):\n    \"\"\"Local oracle for atomic double-entry/idempotency, deliberately small.\"\"\"\n    payload=json.dumps(e,sort_keys=True,separators=(',',':'))\n    if e['id'] in committed:\n        if committed[e['id']]!=payload: raise ValueError('EventIdentityConflict')\n        return\n    entries=[(p['account'],Q(p['signed_amount'])) for p in e['postings']]\n    if sum(v for _,v in entries)!=0: raise ValueError('UnbalancedBatch')\n    proposed=deepcopy(state)\n    for a,v in entries: proposed[a]+=v\n    state.clear(); state.update(proposed); committed[e['id']]=payload\n\ndef report_close(state, events, roles, period):\n    selected=[e for e in events if e['period']==period]\n    flows=defaultdict(Q)\n    for e in selected:\n        for p in e['postings']:\n            if p['account']=='cash' and e['cash_class']:\n                flows[e['cash_class']]+=Q(p['signed_amount'])\n    profit=-sum(v for a,v in state.items() if roles[a] in ['income','expense'])\n    revenue=-state['revenue']\n    interest,tax=state['interest'],state['tax']\n    # Closing is independent of the event generator; no cash arises here.\n    for a in list(state):\n        if roles[a] in ['income','expense']:\n            state['retained']+=state[a];state[a]=Q(0)\n    result=dict(cash=state['cash'],receivables=state['receivables'],inventory=state['inventory'],\n        plant_net=state['plant_cost']+state['accum_depreciation'],tax_prepaid=state['tax_prepaid'],\n        assets=sum(v for a,v in state.items() if roles[a] in ['asset','contra_asset']),\n        payables=-state['payables'],debt=-state['debt'],\n        equity=-sum(v for a,v in state.items() if roles[a]=='equity'),\n        revenue=revenue,profit=profit,interest=interest,tax=tax,\n        operating_cash=flows['operating'],investing_cash=flows['investing'],financing_cash=flows['financing'])\n    check('balanced_'+period,sum(state.values())==0 and result['assets']==result['payables']+result['debt']+result['equity'],str(result))\n    return result\n\ndef compare(name,actual,expected):\n    check(name,all(actual[k]==Q(v) for k,v in expected.items()),{k:str(actual[k]) for k in expected})\n\ndef corporate():\n    f=load('northstar.json'); state=defaultdict(Q,{k:Q(v) for k,v in f['opening'].items()}); committed={}\n    check('opening_balance',sum(state.values())==0,'Signed account total is zero')\n    periods={}\n    for period in ['2024H1','2024H2']:\n        for e in f['historical_events']:\n            if e['period']==period:post(state,e,committed)\n        periods[period]=report_close(state,f['historical_events'],f['accounts'],period)\n        compare(period,periods[period],f['expected'][period])\n    annual={k:sum(r[k] for r in periods.values()) for k in ['revenue','profit','operating_cash','investing_cash','financing_cash']}\n    annual['cash_change']=state['cash']-Q(f['opening']['cash'])\n    compare('annual_statements',annual,f['expected']['2024FY'])\n    # Inverse construction from observed bridges. F,V remain a joint family.\n    sales,collection,purchase,payment,cost,F,V=z3.Reals('sales collection purchase payment cost F V')\n    constraints=[sales==260,35==20+sales-collection,20==30+purchase-cost,\n        30==20+purchase-payment,cost==165,F>=0,V>=0,F+V==100,QZ('0.05')*(F+V)==5]\n    solver=z3.Solver();solver.add(*constraints)\n    check('reconstruction_feasible',solver.check()==z3.sat,'Closed scope annual bridge family')\n    for x,value in [(collection,245),(purchase,155),(payment,145)]:\n        solver.push();solver.add(x!=value); r=solver.check();solver.pop()\n        check('recovered_'+str(x),r==z3.unsat,str(value))\n    for fixed in [0,25,100]:\n        solver.push();solver.add(F==fixed);r=solver.check();solver.pop()\n        check('family_retains_fixed_'+str(fixed),r==z3.sat,'Different exposures with same historical interest')\n    solver.push();solver.add(F==101);r=solver.check();solver.pop()\n    check('impossible_debt_mix_rejected',r==z3.unsat,'Nonnegative floating amount forbids F=101')\n    forecast=f['forecast']\n    for branch,interest in [('fixed',Q(5)),('floating',Q(7))]:\n        s=deepcopy(state); events=[]\n        def e(name,entries,cls=None):\n            record=dict(id='2025.'+name,period='2025_'+branch,date='2025-12-31',cash_class=cls,\n                        postings=[dict(account=a,signed_amount=str(v)) for a,v in entries])\n            events.append(record); post(s,record,{})\n        demand=Q(forecast['demand_units']);price=Q(forecast['price']);cost=Q(forecast['unit_cost'])\n        purchases=(demand+Q(forecast['target_inventory_units'])-s['inventory']/cost)*cost\n        sales=demand*price; cogs=demand*cost\n        collections=Q(forecast['current_sales_collection_fraction'])*sales+Q(forecast['legacy_receivable_collections'])\n        suppliers=Q(forecast['old_payables_paid'])+Q(forecast['new_purchases_paid'])\n        depreciation=Q(10)+Q(10)/5+Q(12)/12\n        tax=(sales-cogs-Q(forecast['payroll'])-depreciation-interest)*Q(forecast['tax_rate'])\n        e('sale',[('receivables',sales),('revenue',-sales)])\n        e('collect',[('cash',collections),('receivables',-collections)],'operating')\n        e('purchase',[('inventory',purchases),('payables',-purchases)])\n        e('supplier',[('payables',suppliers),('cash',-suppliers)],'operating')\n        e('deliver',[('cost_of_sales',cogs),('inventory',-cogs)])\n        e('payroll',[('payroll',50),('cash',-50)],'operating')\n        e('capex',[('plant_cost',20),('cash',-20)],'investing')\n        e('depreciate',[('depreciation',depreciation),('accum_depreciation',-depreciation)])\n        e('interest',[('interest',interest),('cash',-interest)],'operating')\n        e('tax',[('tax',tax),('cash',-tax)],'operating')\n        e('dividend',[('retained',8),('cash',-8)],'financing')\n        result=report_close(s,events,f['accounts'],'2025_'+branch)\n        compare('forecast_'+branch,result,f['expected']['2025_'+branch])\n        check('direct_indirect_cash_'+branch,\n              result['operating_cash']==result['profit']+depreciation-(s['receivables']-state['receivables'])-(s['inventory']-state['inventory'])-(s['payables']-state['payables']),\n              'Profit + noncash depreciation - asset increases + liability increases')\n    # Failure checks exercise atomicity and replay, not just successful sums.\n    s=defaultdict(Q);done={}; good=dict(id='e',postings=[dict(account='cash',signed_amount='1'),dict(account='capital',signed_amount='-1')])\n    post(s,good,done);post(s,good,done)\n    check('event_idempotency',s['cash']==1,'Second identical event is a no-op')\n    changed=deepcopy(good);changed['postings'][0]['signed_amount']='2'\n    try:post(s,changed,done);raise AssertionError('Expected identity error')\n    except ValueError as ex:check('event_identity_conflict',str(ex)=='EventIdentityConflict' and s['cash']==1,'Same ID different inputs rejected')\n    changed['id']='bad'\n    try:post(s,changed,done);raise AssertionError('Expected imbalance')\n    except ValueError as ex:check('atomic_rejection',str(ex)=='UnbalancedBatch' and s['cash']==1 and 'bad' not in done,'No partial state/journal mutation')\n\ndef QZ(x):\n    q=Q(x);return z3.RealVal(str(q.numerator)+'/'+str(q.denominator))\n\ndef bounds_and_weights():\n    f=load('borrowings.json');F,V=z3.Reals('rounded_F rounded_V');D=F+V\n    c=[F>=0,V>=0,D>=QZ('99.5'),D<QZ('100.5'),QZ('0.05')*D>=QZ('4.5'),QZ('0.05')*D<QZ('5.5')]\n    I=QZ('.05')*F+QZ('.07')*V;s=z3.Solver();s.add(*c)\n    for label,bound,comparison,attained in [('infimum','4.975',I<QZ('4.975'),True),('supremum','7.035',I>QZ('7.035'),False)]:\n        s.push();s.add(comparison);r=s.check();s.pop()\n        check('rounded_'+label+'_bound',r==z3.unsat,'Exact rational no-better-point certificate')\n        s.push();s.add(I==QZ(bound));r=s.check();s.pop()\n        check('rounded_'+label+'_attainment',(r==z3.sat)==attained,'Strict upper endpoint is not attained')\n    # A sequence approaching the open supremum establishes sharpness, alongside its bound proof.\n    for n in [10,100,1000]:\n        s.push();s.add(F==0,D==QZ('100.5')-QZ(Q(1,n)));r=s.check();s.pop()\n        check('upper_approach_'+str(n),r==z3.sat,'V = 100.5 - 1/n')\n    prior=list(map(Q,f['mixture']['prior']));lik=list(map(Q,f['mixture']['likelihood_new_evidence']))\n    mass=[a*b for a,b in zip(prior,lik)];postr=[x/sum(mass) for x in mass]\n    check('finite_bayes',postr==list(map(Q,f['mixture']['expected_posterior'])),'New evidence changes weights; stress selection alone does not')\ndef from_p03(ir, bindings, template_bindings):\n    from core0_ir_v1 import validate_ir\n    valid = validate_ir(ir, bindings)\n    if not valid.valid:\n        raise ValueError('P03 IR failed validation: ' + str(valid.diagnostics))\n    if set(template_bindings) != {'DemoDebt@1/DebtMix'} or template_bindings['DemoDebt@1/DebtMix'] != 'fixed-floating-amounts-v1':\n        raise ValueError('explicit supported template binding required')\n    family = ir['historyFamilies'][0]; scope = ir['modelScopes'][0]\n    p = Problem(scope['id'], family['evidence_view'], exclusions=scope['exclusions'], obligations=scope['obligations'])\n    p.provenance = {'p03_ir_sha256': hashlib.sha256(json.dumps(ir,sort_keys=True).encode()).hexdigest(),\n                    'template_bindings': dict(template_bindings), 'observation_ids': [x['id'] for x in ir['observations']],\n                    'source_refs': ir['contracts'][0]['source_refs']}\n    for row in ir['symbols']:\n        v = z3.Real(row['id']); p.variables[row['id']] = v\n        p.add('domain:'+row['id'],domain_formula(v,row['domain']))\n    observations = {r['id']: r for r in ir['observations']}\n    exprs = {r['id']:r for r in ir['expressions']}\n    def lower(name):\n        row=exprs[name]; op=row['op']\n        if op=='literal':\n            if row['type']=='Bool': return z3.BoolVal(row['text']=='true')\n            return q(row['rational'])\n        if op=='ref':\n            if row['target'] in p.variables:return p.variables[row['target']]\n            return lower(row['target'])\n        if op=='value':\n            target=exprs[row['args'][0]]['target'] if row['args'] else row['target']\n            return q(observations[target]['domain']['lower'])\n        if op=='call' and row['target']=='builtin:value@1':\n            return q(observations[exprs[row['args'][0]]['target']]['domain']['lower'])\n        args=[lower(a) for a in row['args']]\n        if op=='call' and row['target']=='builtin:constant@1':return args[0]\n        if op in ('constant','neg','not'):\n            return args[0] if op=='constant' else -args[0] if op=='neg' else z3.Not(args[0])\n        operations={'add':lambda a,b:a+b,'sub':lambda a,b:a-b,'mul':lambda a,b:a*b,'div':lambda a,b:a/b,\n                    'eq':lambda a,b:a==b,'lt':lambda a,b:a<b,'le':lambda a,b:a<=b,\n                    'gt':lambda a,b:a>b,'ge':lambda a,b:a>=b,'and':lambda *a:z3.And(*a),'or':lambda *a:z3.Or(*a)}\n        if op not in operations:raise UnsupportedFragment('P03 operation: '+op)\n        return operations[op](*args)\n    try:\n        rows={r['id']:r for r in ir['constraints']}\n        for cid in family['constraints']: p.add(cid,lower(rows[cid]['expression']))\n        for view in ir['alternatives']:\n            if view['choice_group'] is not None:raise UnsupportedFragment('P03 choice group requires explicit partition')\n            p.views[view['id']]=z3.And(*[lower(rows[c]['expression']) for c in view['constraints']])\n        fields={f['name']:lower(f['expression']) for f in ir['contracts'][0]['fields']}\n        from rational_solver_v1 import fraction\n        principal=fraction(fields['principal'])\n        if principal<=0:raise UnsupportedFragment('amount/fraction adapter requires positive exact principal')\n        fixed=z3.Real('amount:fixed'); floating=z3.Real('amount:floating')\n        p.variables.update({'amount:fixed':fixed,'amount:floating':floating})\n        p.add('template:principal', fixed+floating==q(principal))\n        p.add('template:fixed', fixed==q(principal)*fields['fixed_fraction'])\n        p.add('template:amounts',z3.And(fixed>=0,floating>=0))\n        rate=lower(ir['scenarios'][0]['drivers'][0]['expression'])\n        p.outputs={'interest':fields['fixed_rate']*fixed+rate*floating,\n                   'fixed':fixed,'floating':floating,'principal':fixed+floating}\n        p.slots=1\n    except UnsupportedFragment as exc:p.unsupported.append(str(exc))\n    return p\n\n\nclass FiniteMeasure:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '77,85p;108,111p' docs/plans/accounting-mission-requirements.md; sed -n '1,190p' docs/design/chapters/07-execution.tex\"","aggregated_output":"| MC13 | Drive economic events from contract state and explicit behaviour, then apply accounting rules and atomic journal/state updates. U2, D. | Specify one reference economic model, event payloads, recognition/measurement operations, preconditions, ordering and atomic transitions. Prove the stated bookkeeping invariant and separately define admissibility. | Specified Northstar economic decisions, event preconditions and operations in Chs. 2, 8. Reference journals, atomic rejection and idempotency checks pass. This verifies the bounded oracle, not a production event engine or accounting compliance. G2, G4, G6. |\n| MC14 | Give scenarios and decision information explicit meanings. U2, P, D. | Define supported exogenous stress, observational-conditioning and intervention modes, or explicitly scope unsupported modes; enforce information dates and distinguish real-world from pricing measures. | Specified exogenous stress, observational conditioning, intervention preconditions and information capabilities in Ch. 8/Core 0. Finite conditioning, an information-date example and debt stress typing/provenance are checked; causal intervention execution and arbitrary information-policy enforcement remain pending. G6, G14. |\n| MC15 | Specify ordinary corporate operations and accounting across periods. U1, U2, U3, D. | Provide a bounded coherent package for revenue/collections, purchases/payments, inventory/costs, assets/depreciation, payroll, financing and applicable closing/tax assumptions, with explicit exclusions. | Specified bounded corporate package in Chs. 2, 8 with exact annual/interim and forecast fixtures. Delivery, collection, purchase, payment, costs, plant, payroll, debt, simple tax and closing reconcile. Real tax/revenue/lease/FX packages remain separate work. G4, G5. |\n| MC16 | Produce coherent financial statements, movements and supported note schedules from the same underlying history/path. U1, U2, D. | Define balance sheet, income/comprehensive income, cash flow and equity mappings, non-cash movements, closing and note relationships; supply a full set of expected outputs. | Reference-checked complete Northstar balance sheet, income/zero OCI, direct/indirect cash flow and equity from common journals; Chs. 2, 8 and `northstar.json`. Apple checks a coherent marginal financing stress only. General note schedules and report engine remain pending. G4, G5, G6. |\n| MC17 | Represent financing instruments and their economic/accounting lifecycles, particularly bonds and equity. U1, U2, D. | Specify proceeds, principal, carrying/fair values, rates, calendars, maturities, rights and share quantities; work issuance, accrual, settlement and relevant modification/conversion/default cases under declared treatments. | Partially specified and reference-checked: Chs. 8–9 distinguish principal/carrying/fair values and work ordinary and convertible bond issue, accrual, redemption/conversion, shares and funding default. Detailed modification, early repurchase and other-basis hybrid classification remain open. G4, G7. |\n| MC18 | Preserve joint conditional future outcomes, honest bounds and distinct failure/completeness states. U2, P, D. | Define result payloads and queries that retain branch/path dependence, distinguish sampled ranges from certified bounds and distinguish default from unsupported/numerically failed output without silent dropping or renormalisation. | Specified result cells, branch statuses, strict bound attainment and unresolved mass in Chs. 6, 8, 10/Core 0. Exact linear, joint-output and funding/default reference checks pass; general simulation/result-query implementation remains pending. G2, G3, G6. |\n\n## M4 — Standards, sectors and company variation\n\n| MC29 | Conduct a broad, technically grounded literature survey beyond the original collection. U3, P. | Inspect relevant primary methods/theory/evaluation/appendices and official code where available; compare direct alternatives; make genuine backward/forward screening, source-specific omissions, corrections and claim support inspectable. | Partially repaired: 179 individual title/metadata decisions across 194 occurrences/72 searches replace generic exclusions; generation rejects unscreened candidates. Mack and selected rule sources add inspected technical support. All-candidate full-text review and later module literature are not complete. G8. |\n| MC30 | Preserve the relevant source library and precise provenance. U3, P. | Archive accessible relevant papers under the required naming convention, retain exact versions/anchors, preserve original files, and document unavailable sources without relying on their uninspected claims. | 32 catalogued paper PDFs verified by hash/page count, with original collection preserved; Apple filings and selected standards archived separately. Version/authority limits and four blocked papers remain recorded. Mechanical integrity does not certify every technical claim. G8. The additional financial-report corpus preserves 244 original versions, source/index/discovery hashes and an append-only attempt history; 192 target slots pass source acceptance. |\n| MC31 | Survey open-source tools and define evidence-based reuse boundaries. U3, P, D. | Inspect official interfaces/licences, identify supported subsets, specify adapter exchanges and version assumptions, and separate inspected capabilities from later integration/performance evidence. | Inspected software snapshots/licences retained; Ch. 10/Core 0 specify typed exchanges, errors and concrete examples. Z3 is exercised. Arelle/ACTUS/QuantLib/Docling/ledger integrations and pinned deployment combinations remain pending. G9. |\n\n\\chapter{Reconstruction and execution procedures}\n\\label{ch:execution}\n\n\\section{Ingest, reconcile and construct histories}\n\nThe historical procedure starts with a filing manifest. It records documents,\nreporting dates, publication dates, revisions and expected statements and\nnotes. Tagged filings are parsed through an XBRL adapter; PDF and HTML sources\nare segmented into text, tables, captions and references. The original bytes\nand extraction output remain immutable. Re-running an improved extractor\ncreates a new extraction version with links to the same source.\n\nFor each table, the importer first resolves headers, units, signs, periods and\ndimensions. It then proposes concept mappings. A deterministic validator checks\nsubtotal arithmetic, duplicate facts, comparative consistency and cross-note\nreferences. Every proposed repair creates a new reading. The system may suggest\nthat an OCR value is 10 rather than 70, but only a reviewed correction or an\nexplicit alternative allows that reading into a validated model.\n\nReconciliation proceeds from local totals to movement schedules. A debt bridge\nmay contain opening debt, issuance, repayment, acquired debt, interest\naccretion, currency effects, fair-value changes and closing debt. Every\ncomponent receives a movement type. An unexplained residual is stored as a\nresidual with a source and period; it is not automatically classified as\nrepayment or issuance. A model can introduce an unknown decomposition of that\nresidual, subject to evidence and economic constraints.\n\nThe reconstruction engine then performs the following finite procedure within\na declared model scope:\n\\begin{enumerate}\n\\item Build shared variables for observations, opening states, contract terms\nand supported movement amounts. Attach original rounding domains.\n\\item Add identities, roll-forwards, account restrictions, contractual\nrelationships and cross-period links. Add each semantic reading as a condition\non the same joint model.\n\\item Propagate types, units, intervals and simple equalities. Reject context\nmismatches before invoking a numerical solver.\n\\item Ask the solver for feasibility. On infeasibility, return a sufficient\nconflicting subset of constraints, its source spans and model assumptions.\nA solver's conflict core need not be the smallest possible explanation.\n\\item Retain finite alternatives and continuous solution families symbolically.\nMaterialise example histories only when needed for review or execution.\n\\item Check whether each requested simulation has sufficient economic state.\nMissing maturities, reset dates or cohort composition become declared\nassumptions or explicit unresolved inputs.\n\\end{enumerate}\n\nUnrestricted journal enumeration would be unbounded: arbitrary offsetting\ntransactions can be inserted without changing reports. The model therefore\ndeclares allowed event types, time resolution, relevant accounts, lot/cohort\nresolution and limits on latent contract instances. These limits describe the\nrepresented family; they are not evidence that all real possibilities were\nsearched. The compiler canonicalises syntactic duplicates and equivalences\nestablished by its supported rewrite rules. It does not decide arbitrary\neconomic equivalence. Probability measures attach to declared economic\nhypotheses or parameters, never to a count of encodings; adding a duplicate\nrepresentation therefore cannot create extra probability mass or coverage.\n\nThe first implementation uses symbolic linear bridges and finite structural\nchoices. Nonlinear economic models can be evaluated on feasible states through\nplugins. A solver timeout preserves the unresolved family and returns\n\\code{SolverIncomplete}; it does not prune the family as impossible. Search\nbudgets belong to run configuration and are recorded with the results.\n\n\\section{Condition a run without rewriting history}\n\nA run selects an evidence view and cutoff, a historical family, a forecast\nstarting date, scenario definitions, accounting packages, management policies,\noutput queries and numerical settings. A run may use a concrete history,\nan exact symbolic family, a finite set of conditional histories, or weighted\ndraws from a declared distribution. The output records which mode was used.\n\nSuppose no debt maturity is disclosed. An analyst may run a conditional case\nthat assumes all debt matures after the forecast horizon. The run is valid\nunder that assumption even though the historical representation remains\nincomplete. The interface must display the assumption next to the result and\nprovide sensitivity cases when the assumption is material. It must not label\nthe assumed maturity as a discovered historical fact.\n\nManagement behaviour normally uses only information available at the decision\ndate. A perfect-foresight stress case is a separate, explicitly labelled\npolicy. Scenarios should share the same underlying innovations when estimating\npaired differences where appropriate, with stable stream identifiers so\nbranch order does not change the draws. Common random numbers improve the\ncomparability of paired simulations; they do not imply that every branch has\nthe same economic event counts or shock distribution.\n\n\\section{Schedule and commit events}\n\nEach event carries an economic occurrence time, accrual interval when relevant,\nsettlement time, entity, contract or cohort identifier, currency, inputs and\nprovenance. Its ordering key consists of date, declared phase, dependency edges\nand a deterministic tie identifier. The reference phases are: opening and\nscheduled contractual changes; market observations and rate resets; business\nevents and decisions; accrual and measurement; settlement; period closing and\nreporting. A contract can require a more specific dependency. These phases are\nan engineering starting point, not a universal description of market timing.\n\nTwo events may share a tie order only if their order is either specified or\nirrelevant to the result. If payment before remeasurement and payment after\nremeasurement differ, an unresolved ordering is a model ambiguity or an error.\nThe engine does not conceal it behind alphabetical event IDs.\n\n\\begin{lstlisting}\nexecute_event(event, state, run_context):\n    verify prerequisites and information availability\n    resolve applicable measurement and recognition rules\n    compute proposed economic changes and measurements\n    compute proposed journal batch(es)\n    validate types, contexts, balance, constraints and idempotency\n    atomically commit state, journals and explanation edges\n    return new state, emitted dependent events, diagnostics\n\\end{lstlisting}\n\nThe atomic unit includes the economic state and its accounting effects.\nIf posting fails, neither state changes. A repeated event ID with identical\ninputs returns the existing result; the same ID with different inputs is a\nconflict. Consolidation runs after entity books reach the required date and\nstores its adjustments separately. A failure in one scenario branch cannot\nmutate another branch's state.\n\n\\section{Funding, tax and other simultaneous relations}\n\nSome financial models have circular dependencies. Interest affects taxable\nprofit; tax and investment affect funding needs; funding affects interest.\nThe reference executor first tries to resolve these through explicit timing.\nFor example, beginning-of-period debt can determine current interest, with\nnew borrowing affecting the next accrual period. That is acceptable only when\nthe model's timing assumption is stated and appropriate.\n\nWhere the economic model genuinely requires simultaneous decisions, the\ndependency graph identifies the strongly connected component and delegates it\nto a declared equation or optimisation solver. The solver must return a\nsolution, residuals, admissibility checks and uniqueness or multiplicity\nstatus. A contraction iteration requires a justified convergence condition;\nan arbitrary fixed iteration count is not a mathematical solution. Multiple\nadmissible equilibria become alternatives when material. No solution produces\na model outcome such as financing failure, or an explicit numerical failure,\ndepending on the cause.\n\nFunding policy must include available facilities, limits, covenants, collateral\nand allowed capital actions. The program cannot issue unlimited debt to keep\ncash positive. An inability to meet payments may be a legitimate default\noutcome. Default ends or changes contractual and accounting processes under\nthe relevant event rules; it is not quietly discarded as a bad simulation draw.\n\n\\section{Worked example: identical history, different future journals}\n\nReturn to the company in Chapter~\\ref{ch:purpose}. Immediately after the\nhistorical interest payment and closing, cash is 95, debt is 100 and equity\nis $-5$. There are no other assets, liabilities or transactions. Next year's\nexpense is 5 in the all-fixed branch and 7 in the all-floating branch under\nthe rate shock. The generated entries and closing statements are:\n\n\\begin{center}\n\\begin{tabular}{lrr}\n\\toprule Output & All fixed & All floating\\\\\\midrule\nDebit interest expense / credit cash &5&7\\\\\nClosing cash &90&88\\\\\nClosing debt &100&100\\\\\nCurrent-year profit & $-5$ & $-7$\\\\\nClosing equity after profit transfer &$-10$&$-12$\\\\\nCash change &$-5$&$-7$\\\\\\bottomrule\n\\end{tabular}\n\\end{center}\nThe balance-sheet identity holds in each branch: $90=100-10$ and\n$88=100-12$. The demonstration reporting profile classifies interest paid as\noperating cash flow. A different permitted reporting profile changes that\nclassification, while preserving the cash movement and source event. This\nexample proves the intended distinction and its arithmetic; it does not\nestimate the probability that either debt structure describes a real company.\n\n\\section{Worked example: a bond has several relevant amounts}\n\nA two-period zero-coupon bond raises cash of 100 and promises 110.25 at maturity.\nAssume a 5\\% effective rate per period, no transaction costs, no default, and\namortised-cost treatment under a demonstration rule. The effective-interest\nschedule follows directly from $100(1.05)^2=110.25$:\n\\begin{center}\n\\begin{tabular}{lrrr}\n\\toprule Date & Opening liability & Interest accretion & Closing liability\\\\\\midrule\nIssue &0&0&100\\\\\nEnd of period 1 &100&5&105\\\\\nEnd of period 2, before payment &105&5.25&110.25\\\\\nRedemption &110.25&0&0\\\\\\bottomrule\n\\end{tabular}\n\\end{center}\nIssuance debits cash and credits the liability by 100. Each accretion debits\ninterest expense and credits the liability. Redemption debits the liability\nand credits cash by 110.25. Legal face amount, carrying amount and market\n","exit_code":0,"status":"completed"}}
