isinstance(data, dict) or not data:\n        raise ValueError(\"inventory must be a nonempty path-to-SHA256 object\")\n    for name, value in data.items():\n        p = Path(name)\n        if p.is_absolute() or \"..\" in p.parts or p.as_posix() != name or not isinstance(value, str) or len(value) != 64:\n            raise ValueError(\"invalid inventory entry: \" + str(name))\n    return data\n\n\ndef approval_reference(root: Path, relative: str) -> dict[str, str]:\n    raw = (root / relative).read_bytes()\n    record = json.loads(raw, object_pairs_hook=unique_object)\n    if not isinstance(record, dict):\n        raise ValueError(\"approved plan is not an object\")\n    for name, verdict in ((\"plan\", \"PLAN\"), (\"review\", \"AGREE\")):\n        section = record.get(name)\n        if not isinstance(section, dict) or section.get(\"verdict\") != verdict:\n            raise ValueError(f\"approved plan lacks {name} {verdict}\")\n        if not isinstance(section.get(\"summary\"), str) or any(not isinstance(section.get(k), list) for k in (\"steps\", \"assumptions\", \"checks\", \"evidence\", \"issues\", \"residuals\", \"next_actions\")):\n            raise ValueError(\"malformed approved plan\")\n    if record[\"review\"].get(\"issues\") != []:\n        raise ValueError(\"approved plan has review issues\")\n    plan_hash = hashlib.sha256(json.dumps(record[\"plan\"], sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode()).hexdigest()\n    if record.get(\"plan_hash\") != plan_hash:\n        raise ValueError(\"approved plan hash mismatch\")\n    return {\"path\": relative, \"sha256\": hashlib.sha256(raw).hexdigest(), \"plan_hash\": plan_hash}\n\n\ndef protection(root: Path, phase_inventory: str, execution_inventory: str) -> dict:\n    historical = inventory(root, phase_inventory)\n    execution = inventory(root, execution_inventory)\n    protected = sorted((set(historical) | set(execution)) - WRITABLE)\n    before = {p: digest(root / p) for p in protected}\n    changed = [p for p in protected if before[p] != execution.get(p)]\n    missing = [p for p, h in before.items() if h is None]\n    return {\"historical_inventory\": phase_inventory, \"execution_inventory\": execution_inventory,\n            \"inventory_hashes\": {phase_inventory: digest(root / phase_inventory), execution_inventory: digest(root / execution_inventory)},\n            \"excluded_phase_files\": sorted(WRITABLE), \"before\": before, \"execution_baseline\": {p: execution.get(p) for p in protected},\n            \"changed_since_execution_entry\": changed, \"missing_before_check\": missing,\n            \"historical_differences\": [p for p in sorted(set(historical) & set(execution)) if historical[p] != execution[p]]}\n\n\ndef finish_protection(root: Path, report: dict) -> dict:\n    report[\"after\"] = {p: digest(root / p) for p in report[\"before\"]}\n    report[\"changed_during_check\"] = [p for p in report[\"before\"] if report[\"before\"][p] != report[\"after\"][p]]\n    report[\"changed_inventory_records\"] = [p for p, h in report[\"inventory_hashes\"].items() if h is None or digest(root / p) != h]\n    report[\"passed\"] = not any(report[k] for k in (\"changed_since_execution_entry\", \"missing_before_check\", \"changed_during_check\", \"changed_inventory_records\"))\n    return report\n\n\ndef run_suite(module_name: str) -> dict:\n    sys.path.insert(0, str(ROOT / \"tests\"))\n    stream = io.StringIO()\n    try:\n        module = __import__(module_name)\n        suite = unittest.defaultTestLoader.loadTestsFromModule(module)\n        result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)\n        return {\"module\": module_name, \"methods\": result.testsRun, \"failures\": len(result.failures), \"errors\": len(result.errors), \"skips\": len(result.skipped), \"passed\": bool(result.wasSuccessful() and result.testsRun > 0 and not result.skipped), \"output\": stream.getvalue()}\n    except Exception as exc:\n        return {\"module\": module_name, \"methods\": 0, \"failures\": 0, \"errors\": 1, \"skips\": 0, \"passed\": False, \"output\": stream.getvalue() + repr(exc)}\n\n\ndef probes() -> list[dict]:\n    \"\"\"Independent criterion probes; expected values are computed here, not imported from tests.\"\"\"\n    from context_chronology_v1 import (Context, MappingRule, P06Error, check_partition, compatible_context,\n                                        resolve_bullet_debt, select_evidence, subtract_cumulative, admit_uncertainty)\n    rows = []\n    def observe(identifier, fn):\n        try:\n            value = fn()\n            rows.append({\"id\": identifier, \"passed\": bool(value is not False), \"observed\": value})\n        except Exception as exc:\n            rows.append({\"id\": identifier, \"passed\": False, \"error\": type(exc).__name__ + \": \" + str(exc)})\n    base = {\"concept\":\"x\", \"entity\":\"A\", \"perimeter\":\"A\", \"perimeter_version\":\"1\", \"basis\":\"G\", \"measurement\":\"m\", \"unit\":\"USD\", \"currency\":\"USD\", \"calendar\":\"gregorian\", \"dimensions\":{}, \"gross_net\":\"gross\"}\n    observe(\"MC02\", lambda: compatible_context(Context.from_dict(base), Context.from_dict({**base, \"concept\":\"y\"}), [MappingRule(\"x\", \"y\", provenance=(\"probe\",))])[\"kind\"] == \"equivalent\")\n    observe(\"MC05\", lambda: check_partition([\"a\", \"b\"], {\"left\":[\"a\"], \"right\":[\"b\"]})[\"complete\"])\n    assertions = [{\"id\":\"old\", \"available\":\"2025-01-01\", \"ingested\":\"2025-01-01\", \"supersedes\":[], \"source\":\"s\"}, {\"id\":\"new\", \"available\":\"2026-01-01\", \"ingested\":\"2026-01-01\", \"supersedes\":[\"old\"], \"source\":\"s\"}]\n    observe(\"MC06\", lambda: select_evidence(assertions, \"2026-12-31\", timezone_name=\"UTC\", date_only_policy=\"next_local_midnight\")[\"selected_ids\"] == [\"new\"])\n    observe(\"MC07\", lambda: subtract_cumulative({\"kind\":\"cumulative\",\"amount\":260,\"concept\":\"x\",\"context\":{},\"calendar\":\"g\",\"revision_id\":\"r\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2025-12-31\"}}, {\"kind\":\"cumulative\",\"amount\":110,\"concept\":\"x\",\"context\":{},\"calendar\":\"g\",\"revision_id\":\"r\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2025-06-30\"}})[\"amount\"] == 150)\n    admission = {\"id\":\"r\",\"kind\":\"ExtractionReading\",\"scope\":\"s\",\"provenance\":[\"p\"],\"dependencies\":[],\"source\":\"d\",\"locator\":\"p1\",\"review_decision\":\"Accept\"}\n    observe(\"MC10\", lambda: admit_uncertainty(admission)[\"kind\"] == \"ExtractionReading\")\n    debt = [{\"id\":\"a\",\"principal\":\"100\",\"rate\":\"1/20\",\"maturity\":\"2\"}, {\"id\":\"b\",\"principal\":\"50\",\"rate\":\"7/100\",\"maturity\":\"2\"}]\n    query = {\"contract\":\"c\",\"context\":\"x\",\"evidence_view\":\"latest_available\",\"horizon\":\"1\",\"scenario\":\"base\",\"requested_outputs\":[\"interest\"],\"accrual_convention\":\"simple_actual_fraction\",\"group_by\":[\"rate\",\"maturity\",\"reset\",\"hedge\"]}\n    observe(\"MC11\", lambda: resolve_bullet_debt(debt, query)[\"outputs\"][\"interest\"] == Fraction(17, 2))\n    observe(\"MC14\", lambda: (lambda x: x[\"approximation\"][\"bound\"] == \"3/2\")(resolve_bullet_debt(debt, query, approximation={\"target_rate\":\"0.06\",\"tolerance\":\"2\",\"error_bound\":\"3/2\",\"scope\":\"fixed_rate_interest\",\"evidence\":[\"probe\"]})))\n    return rows\n\n\ndef main(argv=None) -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--output-dir\", required=True)\n    parser.add_argument(\"--approved-plan\", required=True)\n    parser.add_argument(\"--execution-inventory\", required=True)\n    parser.add_argument(\"--inject-failure\", action=\"store_true\", help=argparse.SUPPRESS)\n    args = parser.parse_args(argv)\n    out = Path(args.output_dir).resolve()\n    if out != ROOT / \"data/accounting-master/deliverables/P06\":\n        parser.error(\"use the declared P06 output directory\")\n    started = time.monotonic(); started_utc = datetime.now(timezone.utc).isoformat()\n    phase_inventory = str(Path(args.execution_inventory).parent.parent / \"phase-entry-inventory.json\")\n    try:\n        approved = approval_reference(ROOT, args.approved_plan)\n        protected = protection(ROOT, phase_inventory, args.execution_inventory)\n    except (OSError, ValueError) as exc:\n        parser.error(str(exc))\n    code_before = {p: digest(ROOT / p) for p in SOURCES}\n    os.environ[\"CUDA_VISIBLE_DEVICES\"] = \"-1\"\n    reports = {name: run_suite(name) for name in (\"test_accounting_p06\", \"test_accounting_p03\", \"test_accounting_p04\")}\n    observations = probes()\n    status = {\"required\": len(OBLIGATIONS), \"observed\": len(observations), \"missing\": sorted(set(OBLIGATIONS) - {x[\"id\"] for x in observations}), \"uncatalogued\": sorted({x[\"id\"] for x in observations} - set(OBLIGATIONS)), \"duplicate_ids\": [k for k, v in Counter(x[\"id\"] for x in observations).items() if v != 1], \"failed_observations\": [x[\"id\"] for x in observations if x.get(\"passed\") is not True]}\n    code_after = {p: digest(ROOT / p) for p in SOURCES}\n    protected = finish_protection(ROOT, protected)\n    stable = all(code_before[p] == code_after[p] for p in SOURCES)\n    passed = (all(x[\"passed\"] for x in reports.values()) and all(x.get(\"passed\") for x in observations) and not status[\"missing\"] and not status[\"uncatalogued\"] and not status[\"duplicate_ids\"] and protected[\"passed\"] and stable and not args.inject_failure)\n    command_args = sys.argv[1:] if argv is None else argv\n    command = shlex.join([\"CUDA_VISIBLE_DEVICES=-1\", \"python3\", \"-B\", \"scripts/check_accounting_p06.py\"] + command_args)\n    payload = {\"schema_version\":\"accdsl.p06.conformance.v1\", \"passed\": bool(passed), \"profile\":\"context-chronology-resolution-v1\", \"obligation_status\":status, \"observations\":observations, \"tests\":reports, \"protection\":protected, \"code_stable_during_check\":stable, \"provenance\":{\"approved_plan\":approved, \"phase_entry_inventory\":phase_inventory, \"execution_inventory\":args.execution_inventory}, \"hashes\":code_after, \"manifest\":{\"git_commit\":\"unavailable: existing marker is not a usable repository\", \"command\":command, \"working_directory\":str(ROOT), \"executable\":sys.executable, \"environment\":{\"python\":platform.python_version()}, \"hardware\":\"CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported\", \"random_seeds\":\"N/A: exact deterministic fixtures\", \"data_version\":\"p06-context-chronology-cases-v1\", \"started_utc\":started_utc, \"wall_seconds\":round(time.monotonic()-started, 6), \"plan\":args.approved_plan, \"plan_sha256\":approved[\"sha256\"], \"approved_plan_hash\":approved[\"plan_hash\"], \"execution_inventory\":args.execution_inventory, \"outputs\":OUTPUTS, \"result\":OUTPUTS[1], \"phase_contribution_files\":SOURCES + OUTPUTS}, \"requirement_coverage\":{\"MC02\":\"context-aware mappings and explicit mismatch rejection\", \"MC05\":\"finite partition membership and overlap checks\", \"MC06\":\"chronology, availability and YTD selection\", \"MC07\":\"revision-compatible cumulative subtraction\", \"MC10\":\"six category uncertainty admission\", \"MC11\":\"query-bound unhedged bullet debt grouping\", \"MC14\":\"approximation certificate and error evidence\"}, \"acceptance\":{\"engineering\":bool(passed), \"accounting_validity\":\"not established\", \"forecast_validity\":\"not established\", \"human_acceptance\":\"pending\", \"whole_gap_closure\":False}}\n    out.mkdir(parents=True, exist_ok=True)\n    out.joinpath(\"conformance.json\").write_text(json.dumps(payload, indent=2, default=str) + \"'\"\\\\n\\\")\n    decision = \\\"PASS\\\" if passed else \\\"FAIL\\\"\n    result_text = f'''# P06 context, chronology, and resolution result\n\n{decision}: {reports[\\\"test_accounting_p06\\\"][\\\"methods\\\"]} P06 tests, {reports[\\\"test_accounting_p03\\\"][\\\"methods\\\"]} P03 regression tests, and {reports[\\\"test_accounting_p04\\\"][\\\"methods\\\"]} P04 regression tests executed. The conformance file records every test outcome, independent criterion probe, source hash, inventory comparison, command, and manifest.\n\nThe implementation supplies explicit context mappings, finite partition enumeration, supersession-DAG evidence selection, date-only next-local-midnight handling, revision-compatible YTD subtraction, six category-specific uncertainty admission, information-view guards, and query-signature-bound fixed-rate unhedged bullet-debt resolution. Exact Fraction arithmetic is used throughout the supported scalar path. An approximation is accepted only with a fixed-rate scope, declared tolerance, and a triangle-inequality error certificate.\n\nThe tests independently verify 260 minus revised H1 110 equals H2 150 and reject subtraction using incompatible original H1 120. They reject parent/group, basis, measurement, currency, calendar, gross/net, overlap, omission, dangling/cyclic revision, future-information, unsupported treatment, unsupported scenario, stale-query, maturity-crossing, and missing-approximation-evidence cases. Historical byte availability marked unknown remains unresolved in evidence output.\n\n| Decision | Primary criterion | Veto status | Main uncertainty | Next justified action | Not concluded |\n| --- | --- | --- | --- | --- | --- |\n| {decision} for bounded engineering conformance | Independent P06 probes and focused/regression suites | tests={all(x[\\\"passed\\\"] for x in reports.values())}; protection={protected[\\\"passed\\\"]}; stable={stable}; failed_observations={status[\\\"failed_observations\\\"]} | finite synthetic cases and unannotated source availability | independent result review if PASS; repair if FAIL | professional accounting validity, empirical forecast validity, human acceptance, or wider MC01–MC35/G1–G18 closure |\n\nEngineering correctness, numerical validity, and interpretation remain separate. The exact outputs establish only the declared bounded operations. The strongest alternative explanation is a shared interpretation error in the synthetic fixtures; independent set and arithmetic probes reduce that risk but do not replace source or professional review. The weakest evidence is breadth: mappings, uncertainty, and grouping are finite bounded cases.\n\nResiduals: general measurement conversion, consolidation, arbitrary calendars, continuous or nonlinear uncertainty, empirical approximation validation, historical retained-byte availability, accounting validity, forecast validity, and human acceptance remain open. This phase does not rank stochastic candidates or establish a production default.\n\nActual command: \"'`{command}`. Python {platform.python_version()}, CPU only with accelerator devices intentionally hidden. Wall time: {payload[\"manifest\"][\"wall_seconds\"]} seconds. Git provenance is unavailable; content hashes and supervisor inventories are retained in conformance.json.\n'\"'''\n    out.joinpath(\\\"result.md\\\").write_text(result_text)\n    print(json.dumps({\\\"passed\\\":bool(passed), \\\"tests\\\":{k:{x:v[x] for x in (\\\"methods\\\",\\\"failures\\\",\\\"errors\\\",\\\"skips\\\",\\\"passed\\\")} for k,v in reports.items()}, \\\"obligations\\\":status, \\\"protected\\\":protected[\\\"passed\\\"], \\\"stable\\\":stable}))\n    return 0 if passed else 1\n\n\nif __name__ == \\\"__main__\\\":\n    raise SystemExit(main())\nPY\npython3 -m py_compile scripts/check_accounting_p06.py\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
