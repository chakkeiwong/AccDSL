{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat data/accounting-master/runs/20261002T233421-cea9e631/P06/phase-entry-inventory.json && sed -n '1,220p' data/accounting-master/runs/20261002T233421-cea9e631/P06/approved-plan.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' scripts/reconstruction_v1.py && sed -n '1,260p' tests/test_accounting_p03.py\"","aggregated_output":"\"\"\"Declared-template reconstruction and bounded uncertainty operations, version 1.\"\"\"\nfrom copy import deepcopy\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nimport z3\nfrom rational_solver_v1 import (Problem, Budget, UnsupportedFragment, q, rational, domain_formula,\n                                disclosure_domain, half_even, solve)\n\n\nADMISSION_FIELDS = {\n    'ExtractionReading': ('source', 'locator', 'review_decision'),\n    'HistoricalFact': ('evidence', 'reason'),\n    'AccountingElection': ('package', 'permitted_treatments', 'election', 'effective_date', 'eligibility_evidence'),\n    'MeasurementEstimate': ('method', 'measurement_date', 'inputs'),\n    'BehaviourPolicy': ('policy', 'information_set', 'decision_time'),\n    'FutureInnovation': ('driver', 'future_period', 'scenario', 'joint_law', 'measure'),\n}\n\n\ndef admit(record):\n    kind = record.get('kind')\n    if kind not in ADMISSION_FIELDS:\n        raise ValueError('unknown uncertainty category')\n    for key in ('id', 'scope', 'provenance', 'dependencies') + ADMISSION_FIELDS[kind]:\n        if key not in record or (key != 'dependencies' and not record[key]):\n            raise ValueError('missing admission field: ' + key)\n    if not isinstance(record['dependencies'], list) or not isinstance(record['provenance'], list):\n        raise ValueError('dependencies and provenance must be explicit lists')\n    if kind == 'ExtractionReading' and record['review_decision'] != 'Accept':\n        raise ValueError('extraction reading is not accepted')\n    if kind == 'AccountingElection' and record['election'] not in record['permitted_treatments']:\n        raise ValueError('treatment not permitted by declared package')\n    return deepcopy(record)\n\n\ndef expression(node, env):\n    if isinstance(node, bool):\n        return z3.BoolVal(node)\n    if isinstance(node, (str, int, F)):\n        return env[node] if isinstance(node, str) and node in env else q(node)\n    if not isinstance(node, list) or not node:\n        raise ValueError('expression must be exact scalar, reference or operation list')\n    op, *args = node\n    args = [expression(x, env) for x in args]\n    ops = {'+': lambda a,b:a+b, '-': lambda a,b:a-b, '*': lambda a,b:a*b,\n           '/': lambda a,b:a/b, '==': lambda a,b:a==b, '<=': lambda a,b:a<=b,\n           '>=': lambda a,b:a>=b, '<': lambda a,b:a<b, '>': lambda a,b:a>b,\n           'and': lambda *a:z3.And(*a), 'or': lambda *a:z3.Or(*a),\n           'not': lambda a:z3.Not(a), 'implies': lambda a,b:z3.Implies(a,b)}\n    if op not in ops:\n        raise UnsupportedFragment('unknown operation: ' + op)\n    return ops[op](*args)\n\n\ndef construct(spec):\n    if spec.get('schema_version') != 'accdsl.reconstruction.input.v1':\n        raise ValueError('unsupported reconstruction schema')\n    p = Problem(spec['scope'], spec['evidence_view'], exclusions=list(spec['exclusions']),\n                obligations=list(spec['obligations']), rounding_stage=spec['rounding_stage'])\n    if p.rounding_stage not in ('exact_rational', 'posting_half_even_quantized_units'):\n        raise ValueError('unsupported or undeclared rounding stage')\n    if len(set(spec['dates'])) != len(spec['dates']):\n        raise ValueError('duplicate dates')\n    date_index = {d: i for i, d in enumerate(spec['dates'])}\n    context = spec['context']; env = {}\n    records = [admit(a) for a in spec['admissions']]\n    if len({r['id'] for r in records}) != len(records):\n        raise ValueError('duplicate admission')\n    admitted_ids = {r['id'] for r in records}\n    if any(set(r['dependencies']) - admitted_ids for r in records):\n        raise ValueError('unresolved admission dependency')\n    p.provenance = {'input_sha256': hashlib.sha256(json.dumps(spec, sort_keys=True).encode()).hexdigest(),\n                    'admissions': records, 'context': context, 'observation_sources': {}}\n    def variable(name, kind, limits=None):\n        if kind not in ('Bool', 'Int', 'Real'):\n            raise ValueError('unsupported variable kind')\n        if name in env:\n            raise ValueError('duplicate economic identifier: ' + name)\n        v = z3.Bool(name) if kind == 'Bool' else z3.Int(name) if kind == 'Int' else z3.Real(name)\n        env[name] = v; p.variables[name] = v\n        if kind == 'Bool':\n            p.finite[name] = [False, True]\n        elif kind == 'Int':\n            if limits is None:\n                p.unsupported.append('unbounded integer domain: ' + name)\n            else:\n                lo, hi = limits\n                if type(lo) is not int or type(hi) is not int or lo > hi:\n                    raise ValueError('invalid integer bounds')\n                p.finite[name] = range(lo, hi+1)\n        return v\n    for c in spec['choices']:\n        if not c['values'] or any(type(v) is not int for v in c['values']) or len(set(c['values'])) != len(c['values']):\n            raise ValueError('finite choices need distinct integer codes')\n        variable(c['id'], 'Int', [0,0]); p.finite[c['id']] = list(c['values'])\n    for s in spec['symbols']:\n        if s['kind'] not in ('Real', 'Int'):\n            raise ValueError('unsupported symbol kind')\n        v = variable(s['id'], s['kind'], s.get('integer_bounds'))\n        p.add('domain:'+s['id'], domain_formula(v, s['domain']))\n    registry = spec['templates']\n    slots = []\n    for row in spec['slots']:\n        if row['template'] not in registry:\n            raise ValueError('unregistered template')\n        template = registry[row['template']]\n        if not template['provenance']:\n            raise ValueError('template provenance required')\n        if sum(rational(v) for v in template['postings'].values()) != 0:\n            raise ValueError('posting incidence must balance')\n        amount = variable(row['id'], row['kind'], row.get('integer_bounds'))\n        if p.rounding_stage == 'posting_half_even_quantized_units':\n            if row['kind'] != 'Int' or rational(row['quantum']) <= 0:\n                raise ValueError('posting quantisation requires bounded integer units and positive quantum')\n            amount = q(row['quantum']) * amount\n        elif 'quantum' in row:\n            raise ValueError('quantum requires an explicit posting quantisation stage')\n        p.add('nonnegative:'+row['id'], amount >= 0)\n        if row['active'] == 'choice':\n            active = variable(row['id']+':active', 'Bool')\n            p.add('activation:'+row['id'], z3.Implies(z3.Not(active), amount == 0))\n        elif type(row['active']) is bool:\n            if not row['active']:\n                p.add('activation:'+row['id'], amount == 0)\n        else:\n            raise ValueError('explicit activation required')\n        slots.append((row, template, amount))\n    p.slots = len(slots)\n    accounts = dict(spec['opening']); states = dict(spec['economic_opening'])\n    derived_names = [f'{prefix}:{date}:{name}' for date in spec['dates']\n                     for prefix, names in (('balance', accounts), ('state', states)) for name in names]\n    if len(set(derived_names)) != len(derived_names) or set(derived_names) & set(env):\n        raise ValueError('generated balance/state identifier collides with an economic identifier')\n    for r,t,a in slots:\n        if r['date'] not in date_index or set(t['postings'])-set(accounts) or set(t['state'])-set(states):\n            raise ValueError('slot date/account/state outside declared scope')\n    for date in spec['dates']:\n        for account, start in accounts.items():\n            env[f'balance:{date}:{account}'] = q(start) + sum((q(t['postings'].get(account,0))*a for r,t,a in slots if date_index[r['date']] <= date_index[date]), q(0))\n        for state, start in states.items():\n            env[f'state:{date}:{state}'] = q(start) + sum((q(t['state'].get(state,0))*a for r,t,a in slots if date_index[r['date']] <= date_index[date]), q(0))\n    for r,t,a in slots:\n        if r['date'] not in spec['dates'] or set(t['postings'])-set(accounts) or set(t['state'])-set(states):\n            raise ValueError('slot date/account/state outside declared scope')\n    try:\n        for name, node in spec['mappings'].items():\n            if name in env:\n                raise ValueError('mapping shadows an economic identifier: ' + name)\n            env[name] = expression(node, env); p.outputs[name] = env[name]\n        seen = {}\n        for obs in spec['observations']:\n            if obs['context'] != context or obs['action'] != 'Accept' or not obs['source']:\n                raise ValueError('observation context/admission mismatch')\n            if obs['id'] in seen:\n                if obs != seen[obs['id']]:\n                    raise ValueError('conflicting reuse of observation identity')\n                continue\n            seen[obs['id']] = obs\n            if obs['mapping'] not in p.outputs:\n                p.obligations.append('unmatched observation:'+obs['id']); continue\n            domain = obs['domain']\n            if domain.get('kind') == 'rounded':\n                if domain.get('convention') is None:\n                    p.obligations.append('unresolved rounding:'+obs['id']); continue\n                domain = disclosure_domain(domain['displayed'], domain['quantum'], domain['convention'])\n            p.add('observation:'+obs['id'], domain_formula(p.outputs[obs['mapping']], domain))\n            p.provenance['observation_sources'][obs['id']] = obs['source']\n        for row in spec['constraints']:\n            p.add(row['id'], expression(row['expression'], env))\n        for name, node in spec['views'].items():\n            p.views[name] = expression(node, env)\n    except UnsupportedFragment as exc:\n        p.unsupported.append(str(exc))\n    return p\n\n\ndef from_p03(ir, bindings, template_bindings):\n    from core0_ir_v1 import validate_ir\n    valid = validate_ir(ir, bindings)\n    if not valid.valid:\n        raise ValueError('P03 IR failed validation: ' + str(valid.diagnostics))\n    if set(template_bindings) != {'DemoDebt@1/DebtMix'} or template_bindings['DemoDebt@1/DebtMix'] != 'fixed-floating-amounts-v1':\n        raise ValueError('explicit supported template binding required')\n    family = ir['historyFamilies'][0]; scope = ir['modelScopes'][0]\n    p = Problem(scope['id'], family['evidence_view'], exclusions=scope['exclusions'], obligations=scope['obligations'])\n    p.provenance = {'p03_ir_sha256': hashlib.sha256(json.dumps(ir,sort_keys=True).encode()).hexdigest(),\n                    'template_bindings': dict(template_bindings), 'observation_ids': [x['id'] for x in ir['observations']],\n                    'source_refs': ir['contracts'][0]['source_refs']}\n    for row in ir['symbols']:\n        v = z3.Real(row['id']); p.variables[row['id']] = v\n        p.add('domain:'+row['id'],domain_formula(v,row['domain']))\n    observations = {r['id']: r for r in ir['observations']}\n    exprs = {r['id']:r for r in ir['expressions']}\n    def lower(name):\n        row=exprs[name]; op=row['op']\n        if op=='literal':\n            if row['type']=='Bool': return z3.BoolVal(row['text']=='true')\n            return q(row['rational'])\n        if op=='ref':\n            if row['target'] in p.variables:return p.variables[row['target']]\n            return lower(row['target'])\n        if op=='value':\n            target=exprs[row['args'][0]]['target'] if row['args'] else row['target']\n            return q(observations[target]['domain']['lower'])\n        if op=='call' and row['target']=='builtin:value@1':\n            return q(observations[exprs[row['args'][0]]['target']]['domain']['lower'])\n        args=[lower(a) for a in row['args']]\n        if op=='call' and row['target']=='builtin:constant@1':return args[0]\n        if op in ('constant','neg','not'):\n            return args[0] if op=='constant' else -args[0] if op=='neg' else z3.Not(args[0])\n        operations={'add':lambda a,b:a+b,'sub':lambda a,b:a-b,'mul':lambda a,b:a*b,'div':lambda a,b:a/b,\n                    'eq':lambda a,b:a==b,'lt':lambda a,b:a<b,'le':lambda a,b:a<=b,\n                    'gt':lambda a,b:a>b,'ge':lambda a,b:a>=b,'and':lambda *a:z3.And(*a),'or':lambda *a:z3.Or(*a)}\n        if op not in operations:raise UnsupportedFragment('P03 operation: '+op)\n        return operations[op](*args)\n    try:\n        rows={r['id']:r for r in ir['constraints']}\n        for cid in family['constraints']: p.add(cid,lower(rows[cid]['expression']))\n        for view in ir['alternatives']:\n            if view['choice_group'] is not None:raise UnsupportedFragment('P03 choice group requires explicit partition')\n            p.views[view['id']]=z3.And(*[lower(rows[c]['expression']) for c in view['constraints']])\n        fields={f['name']:lower(f['expression']) for f in ir['contracts'][0]['fields']}\n        from rational_solver_v1 import fraction\n        principal=fraction(fields['principal'])\n        if principal<=0:raise UnsupportedFragment('amount/fraction adapter requires positive exact principal')\n        fixed=z3.Real('amount:fixed'); floating=z3.Real('amount:floating')\n        p.variables.update({'amount:fixed':fixed,'amount:floating':floating})\n        p.add('template:principal', fixed+floating==q(principal))\n        p.add('template:fixed', fixed==q(principal)*fields['fixed_fraction'])\n        p.add('template:amounts',z3.And(fixed>=0,floating>=0))\n        rate=lower(ir['scenarios'][0]['drivers'][0]['expression'])\n        p.outputs={'interest':fields['fixed_rate']*fixed+rate*floating,\n                   'fixed':fixed,'floating':floating,'principal':fixed+floating}\n        p.slots=1\n    except UnsupportedFragment as exc:p.unsupported.append(str(exc))\n    return p\n\n\nclass FiniteMeasure:\n    def __init__(self, atoms, justification, used=()):\n        if not justification:raise ValueError('explicit joint-measure justification required')\n        self.atoms=deepcopy(atoms);self.justification=justification;self.used=set(used)\n        ids=[a['id'] for a in atoms]\n        if len(ids)!=len(set(ids)) or not atoms:raise ValueError('distinct joint atoms required')\n        hypotheses = [a.get('hypothesis') for a in atoms]\n        if any(not isinstance(h, dict) or not h for h in hypotheses):\n            raise ValueError('explicit complete finite economic assignments required')\n        keys = set(hypotheses[0])\n        if any(set(h) != keys or any(isinstance(v, (dict,list)) for v in h.values()) for h in hypotheses):\n            raise ValueError('joint hypotheses require the same complete scalar coordinates')\n        if len({json.dumps(h,sort_keys=True) for h in hypotheses}) != len(hypotheses):\n            raise ValueError('overlapping identical economic hypotheses')\n        weights=[rational(a['weight']) for a in atoms]\n        if any(w<0 for w in weights) or sum(weights)!=1:raise ValueError('joint weights must sum to one')\n    def update(self, likelihood, information_blocks):\n        blocks=set(information_blocks)\n        if not blocks or len(blocks) != len(information_blocks) or blocks & self.used:raise ValueError('repeated/missing information block')\n        if set(likelihood)!={a['id'] for a in self.atoms}:raise ValueError('likelihood must cover every atom')\n        ls={k:rational(v) for k,v in likelihood.items()}\n\"\"\"Executed P03 obligations; authored typed inputs never pass through the parser.\"\"\"\nimport copy\nfrom dataclasses import replace\nfrom fractions import Fraction as F\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'scripts'))\nimport core0_ir_v1 as ir\nfrom core0_frontends_v1 import compile_source\nimport jsonschema\n\nOBSERVATIONS = []\nBASE = (ROOT / 'docs/design/fixtures/borrowing.acc').read_text()\nREASON = 'Fixed-rate proportion not disclosed'\nRENAMED = '''module FinancingStudy version \"2\";\nuse DemoDebt version \"1\";\nsource disclosure = external(\"synthetic-note-7\");\nentity Beta functional USD;\nbook Statutory entity Beta basis DemoDebt version \"1\";\naccount Cash : Asset book Statutory;\naccount Debt : Liability book Statutory;\naccount InterestExpense : Expense book Statutory;\naccount Retained : Equity book Statutory;\nopening carried for Statutory from external(\"after-2025-close\");\nobservation borrowing : Money<USD> instant @2025-12-31 = 150 USD from disclosure;\nsymbol share : Real in [0, 1] because \"Fixed-rate proportion not disclosed\";\ncontract facility : DebtMix book Statutory {\n principal = value(borrowing); fixed_fraction = share;\n fixed_rate = 0.05 per year; initial_floating_rate = 0.05 per year;\n}\nalternative fixed { assume share == 1; }\nalternative floating { assume share == 0; }\nscenario shock { set market_rate = constant(0.08 per year); }\nreport financials for Statutory { mapping = external(\"DemoDebt.statements.v1\"); }\n'''\n\n\ndef bindings(principal=100, renamed=False):\n    \"\"\"Explicit synthetic evidence, separately authored from source and expected IR.\"\"\"\n    p = F(principal); stamp = '2026-01-01T00:00:00Z'\n    book, symbol = ('Statutory', 'share') if renamed else ('Local', 'alpha')\n    names = ('fixed', 'floating') if renamed else ('allFixed', 'allFloating')\n    package_path = ROOT / 'docs/design/fixtures/demo-debt-package.json'\n    return ir.CompileBindings(\n        packages=[ir.PackageBinding('DemoDebt', '1', hashlib.sha256(package_path.read_bytes()).hexdigest(),\n            'DemoDebt', '2025-01-01', '2028-01-01', ['reset','accrue_and_pay','close','statements'],\n            ['builtin:Core0@1','DemoCalendar@1'], ['fixture:demo-debt-package.json'])],\n        readings=[ir.ReadingBinding('synthetic-note-7', f'Synthetic disclosed debt {p} USD; split undisclosed', p,\n            'USD', '2025-12-31', 'fixture:p03-synthetic', 'synthetic-2025', stamp, stamp,\n            'synthetic-author', stamp, 'Explicit synthetic acceptance, not human approval', stamp,\n            system_as_of=stamp, action='Accept')],\n        openings=[ir.OpeningBinding('after-2025-close', '2025-12-31',\n            {'Cash':p-5, 'Debt':-p, 'InterestExpense':0, 'Retained':5}, book=book)],\n        reports=[ir.ReportBinding('DemoDebt.statements.v1','DemoDebt.statements.v1',\n            'interest_operating','close',['accrue_and_pay'])],\n        assumptions=[ir.AssumptionBinding(k, 'Synthetic explicit '+k, information_cutoff=stamp,\n            valid_start='2026-01-01',valid_end='2027-01-01')\n            for k in ('alternative','constraint','contract-rate','scenario')],\n        admissions=[ir.SymbolAdmission(symbol,'synthetic-note-7',REASON,'synthetic-author',stamp)],\n        alternatives=[ir.AlternativeBinding(n,'synthetic-author',stamp,'Synthetic endpoint') for n in names],\n        calendar_id='DemoCalendar@1',calendar_name='Gregorian',horizon_start='2026-01-01',\n        horizon_end='2027-01-01',symbol_uncertainty='HistoricalFact',\n        entity_perimeter='Beta-only' if renamed else 'Acme-only')\n\n\ndef typed(principal=100, stress=F(7,100), renamed=False, arithmetic=False):\n    mod, ver, src, ent, book, opening, obs, sym, contract, a1, a0, scenario, report = (\n        ('FinancingStudy','2','disclosure','Beta','Statutory','carried','borrowing','share','facility',\n         'fixed','floating','shock','financials') if renamed else\n        ('BorrowingExample','1','note7','Acme','Local','after2025','debt','alpha','loans',\n         'allFixed','allFloating','rateShock','statements'))\n    ds = [ir.SourceDecl(src,'synthetic-note-7'),ir.EntityDecl(ent,'USD'),ir.BookDecl(book,ent,'DemoDebt','1')]\n    ds += [ir.AccountDecl(n,r,book) for n,r in [('Cash','Asset'),('Debt','Liability'),('InterestExpense','Expense'),('Retained','Equity')]]\n    ds += [ir.OpeningDecl(opening,book,'after-2025-close'),\n           ir.ObservationDecl(obs,'Money<USD>','2025-12-31',ir.Literal(F(principal),unit='USD'),src),\n           ir.SymbolDecl(sym,'Real',ir.Literal(F(0)),ir.Literal(F(1)),REASON)]\n    fraction = ir.Ref(sym)\n    if arithmetic:\n        ds += [ir.LetDecl('mix',ir.Binary('/',ir.Binary('*',ir.Ref(sym),ir.Literal(F(2))),ir.Literal(F(2)))),\n               ir.ConstraintDecl('limit',ir.Binary('and',ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0))),\n                    ir.Binary('<=',ir.Ref(sym),ir.Literal(F(1)))))]\n        fraction=ir.Ref('mix')\n    ds += [ir.ContractDecl(contract,'DebtMix',book,[('principal',ir.Call('value',[ir.Ref(obs)])),\n           ('fixed_fraction',fraction),('fixed_rate',ir.Literal(F(1,20),unit='per year')),\n           ('initial_floating_rate',ir.Literal(F(1,20),unit='per year'))])]\n    for name,value in ((a1,1),(a0,0)):\n        conds=[ir.Binary('==',ir.Ref(sym),ir.Literal(F(value)))]\n        if arithmetic: conds += [ir.Binary('>=',ir.Ref(sym),ir.Literal(F(0)))]\n        ds.append(ir.AlternativeDecl(name,conds))\n    ds += [ir.ScenarioDecl(scenario,[('market_rate',ir.Call('constant',[ir.Literal(F(stress),unit='per year')]))]),\n           ir.ReportDecl(report,book,ir.External('DemoDebt.statements.v1'))]\n    return ir.Program(mod,ver,ds,[ir.UseDecl('DemoDebt','1')])\n\n\ndef arithmetic_source():\n    return BASE.replace('contract loans', 'let mix = alpha * 2 / 2;\\nconstraint limit: alpha >= 0 and alpha <= 1;\\ncontract loans').replace(\n        'fixed_fraction = alpha;', 'fixed_fraction = mix;').replace('assume alpha == 1;', 'assume alpha == 1; assume alpha >= 0;').replace(\n        'assume alpha == 0;', 'assume alpha == 0; assume alpha >= 0;')\n\n\nSOURCE_NEGATIVES = {\n 'unknown_report_field': (lambda s:s.replace('mapping =', 'extra = 3; mapping ='),'ParseError'),\n 'duplicate_report_field': (lambda s:s.replace('mapping = external(\"DemoDebt.statements.v1\");','mapping = external(\"DemoDebt.statements.v1\"); mapping = external(\"DemoDebt.statements.v1\");'),'ParseError'),\n 'missing_rate_unit': (lambda s:s.replace('fixed_rate = 0.05 per year','fixed_rate = 0.05'),'MissingRateUnit'),\n 'unsupported_event': (lambda s:s+'\\nevent maturity() book Local;','UnsupportedDeclaration'),\n 'reserved_identifier': (lambda s:s.replace('entity Acme','entity report'),'ReservedIdentifier'),\n 'invalid_date': (lambda s:s.replace('@2025-12-31','@2025-02-30'),'InvalidDate'),\n 'invalid_escape': (lambda s:s.replace('Fixed-rate',r'Fixed\\qrate'),'ParseError'),\n 'invalid_surrogate': (lambda s:s.replace('Fixed-rate',r'Fixed\\ud800rate'),'InvalidString'),\n 'duplicate_declaration': (lambda s:s+'\\nentity Acme functional USD;','DuplicateDeclaration'),\n 'duplicate_contract_field': (lambda s:s.replace('fixed_fraction = alpha;', 'fixed_fraction = alpha; fixed_fraction = alpha;'),'DuplicateField'),\n 'unknown_reference': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = absent'),'UnknownReference'),\n 'cyclic_lets': (lambda s:s.replace('contract loans','let first = second; let second = first; contract loans'),'ExpressionCycle'),\n 'unsupported_call': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = sqrt(alpha)'),'UnsupportedExpression'),\n 'unsupported_array': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = [alpha, 1]'),'UnsupportedExpression'),\n 'unsupported_field': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha.part'),'UnsupportedExpression'),\n 'wrong_dimensions': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD + 1'),'TypeMismatch'),\n 'rate_product': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 USD * 0.05 per year'),'UnsupportedOperation'),\n 'zero_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha / 0'),'UnprovedNonzeroDenominator'),\n 'unproved_divisor': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = 1 / alpha'),'UnprovedNonzeroDenominator'),\n 'bad_arity': (lambda s:s.replace('value(debt)','value(debt, debt)'),'ArityMismatch'),\n 'invalid_fraction_bounds': (lambda s:s.replace('fixed_fraction = alpha','fixed_fraction = alpha + 1'),'ContractDomain'),\n 'principal_disagreement': (lambda s:s.replace('principal = value(debt)','principal = 200 USD'),'ContractPrincipal'),\n 'malformed_syntax': (lambda s:s.replace('module BorrowingExample','module {'),'ParseError'),\n 'wrong_book': (lambda s:s.replace('account Cash : Asset book Local','account Cash : Asset book Elsewhere'),'BindingMismatch'),\n 'extra_scenario_setting': (lambda s:s.replace('set market_rate', 'set other = 1; set market_rate'),'ScenarioFields'),\n}\n\n\nclass P03Tests(unittest.TestCase):\n    def record(self, case, **values):\n        OBSERVATIONS.append(dict(id=case, passed=True, **values))\n\n    def test_checker_protection_provenance(self):\n        from check_accounting_p03 import capture_protection, finish_protection\n\n        def sha(text):\n            return hashlib.sha256(text.encode()).hexdigest()\n\n        # All mutations here affect disposable test inputs, never project files.\n        variants = ('historical_change', 'new_change', 'missing_file',\n                    'missing_inventory', 'empty_inventory', 'omitted_path',\n                    'during_check_change', 'during_check_delete',\n                    'inventory_change', 'duplicate_inventory', 'invalid_digest')\n        for variant in variants:\n            with self.subTest(variant=variant), tempfile.TemporaryDirectory() as folder:\n                root = Path(folder)\n                protected = root / 'protected.txt'\n                protected.write_text('current')\n                (root / 'contribution.py').write_text('worker edit')\n                historical = {'protected.txt': sha('historical')}\n                execution = {'protected.txt': sha('current'),\n                             'contribution.py': sha('before worker edit')}\n                (root / 'historical.json').write_text(json.dumps(historical))\n                (root / 'execution.json').write_text(json.dumps(execution))\n                if variant == 'new_change':\n                    protected.write_text('unauthorised change')\n                elif variant == 'missing_file':\n                    protected.unlink()\n                elif variant == 'missing_inventory':\n                    (root / 'execution.json').unlink()\n                elif variant == 'empty_inventory':\n                    (root / 'execution.json').write_text('{}')\n                elif variant == 'omitted_path':\n                    del execution['protected.txt']\n                    (root / 'execution.json').write_text(json.dumps(execution))\n                elif variant == 'duplicate_inventory':\n                    entry = '\"protected.txt\": \"' + sha('current') + '\"'\n                    (root / 'execution.json').write_text('{' + entry + ',' + entry + '}')\n                elif variant == 'invalid_digest':\n                    (root / 'execution.json').write_text('{\"protected.txt\": \"invalid\"}')\n                report = capture_protection(root, 'historical.json', 'execution.json',\n                                            writable=['contribution.py'])\n                if variant == 'during_check_change':\n                    protected.write_text('changed during check')\n                elif variant == 'during_check_delete':\n                    protected.unlink()\n                elif variant == 'inventory_change':\n                    (root / 'execution.json').write_text('{}')\n                finish_protection(root, report)\n                self.assertEqual(report['passed'], variant == 'historical_change', report)\n                self.assertNotIn('contribution.py', report['before'])\n                if variant == 'historical_change':\n                    self.assertEqual([r['path'] for r in report['historical_differences']],\n                                     ['protected.txt'])\n                    self.assertEqual(report['changed_since_execution_entry'], [])\n                if variant == 'new_change':\n                    self.assertEqual(report['changed_since_execution_entry'], ['protected.txt'])\n                if variant.startswith('during_check_'):\n                    self.assertEqual(report['changed_during_check'], ['protected.txt'])\n                self.record('checker_' + variant, protection_passed=report['passed'],\n                            errors=report['errors'],\n                            historical_differences=report['historical_differences'],\n                            changed_since_execution_entry=report['changed_since_execution_entry'],\n                            changed_during_check=report['changed_during_check'])\n\n    def test_checker_obligation_integrity(self):\n        from check_accounting_p03 import obligation_status\n        required = {'obligations': [{'id': 'one'}, {'id': 'two'}]}\n        observations = [{'id': 'one', 'passed': True}, {'id': 'two', 'passed': True}]\n        for name, catalog, observed, field, expected in (\n            ('missing', required, observations[:1], 'missing', ['two']),\n            ('uncatalogued', required, observations + [{'id': 'extra', 'passed': True}],\n             'uncatalogued', ['extra']),\n            ('duplicate_observation', required, observations * 2, 'duplicate_ids', ['one', 'two']),\n            ('duplicate_catalog', {'obligations': required['obligations'] * 2}, observations,\n             'duplicate_ids', ['one', 'two']),\n            ('failed_observation', required, [{'id': 'one', 'passed': False}, observations[1]],\n             'failed_observations', ['one']),\n        ):\n            with self.subTest(name=name):\n                status = obligation_status(catalog, observed)\n                self.assertEqual(status[field], expected)\n                self.record('checker_' + name, expected=expected, observed=status[field])\n\n    def success(self, source, program, b, case, expected):\n        before=ir.binding_projection(b); original=ir.binding_projection(program)\n        a=compile_source(source,b); t=ir.compile_program(program,b)\n        self.assertTrue(a.ok,[d.as_dict() for d in a.diagnostics]);self.assertTrue(t.ok,[d.as_dict() for d in t.diagnostics])\n        self.assertEqual(a.semantic_projection,t.semantic_projection)\n        self.assertEqual(a.binding_records,t.binding_records)\n        self.assertEqual(before,ir.binding_projection(b));self.assertEqual(original,ir.binding_projection(program))\n        self.assertEqual(a.ir,compile_source(source,b).ir)\n        fields={v['name']:v['expression'] for v in a.ir['contracts'][0]['fields']}\n        symbol=a.ir['symbols'][0]['id']; rates=[]\n        for alpha in (1,0):\n            ev=lambda eid:ir.evaluate_expression(a.ir,eid,{symbol:F(alpha)})\n            principal=ev(fields['principal']); weight=ev(fields['fixed_fraction']); fixed=ev(fields['fixed_rate'])\n            stress=ev(a.ir['scenarios'][0]['drivers'][0]['expression'])\n            rates.append(principal*(weight*fixed+(1-weight)*stress))\n        self.assertEqual(rates,list(map(F,expected)))\n        fam=a.ir['historyFamilies'][0]\n        self.assertEqual((fam['feasibility'],fam['coverage'],fam['completed_cells'],fam['unresolved_cells'],fam['witnesses'],fam['solver_results']),\n                         ('Unknown','PartialSearch',0,1,[],[]))\n        self.record(case,source=source,input_sha256=a.input_sha256,typed_sha256=t.input_sha256,\n                    ir=a.ir,typed_ir=t.ir,typed_program=ir.binding_projection(program),\n                    semantic_projection=a.semantic_projection,typed_semantic_projection=t.semantic_projection,\n                    bindings=a.binding_records,typed_bindings=t.binding_records,\n                    source_map=dict(a.source_map),typed_source_map=dict(t.source_map),\n                    expected_interest=list(map(str,expected)),observed_interest=list(map(str,rates)))\n        return a\n\n    def test_positive_pairs(self):\n        for case,source,program,b,expect in [\n          ('borrowing_baseline',BASE,typed(),bindings(),(5,7)),\n          ('borrowing_stress_09',BASE.replace('0.07 per year','0.09 per year'),typed(stress=F(9,100)),bindings(),(5,9)),\n          ('borrowing_principal_200',BASE.replace('= 100 USD','= 200 USD'),typed(200),bindings(200),(10,14)),\n          ('renamed_independent',RENAMED,typed(150,F(8,100),True),bindings(150,True),(F(15,2),12)),\n          ('borrowing_let_arithmetic',arithmetic_source(),typed(arithmetic=True),bindings(),(5,7))]:\n            with self.subTest(case=case):\n                result=self.success(source,program,b,case,expect)\n                if case=='borrowing_let_arithmetic':\n                    self.assertEqual(len(result.ir['historyFamilies'][0]['constraints']),1)\n","exit_code":0,"status":"completed"}}
