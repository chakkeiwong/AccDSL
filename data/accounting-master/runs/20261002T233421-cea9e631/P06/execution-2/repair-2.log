{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,620p' tests/test_accounting_p06.py\"","aggregated_output":"\n\nclass RepairRegressionTests(unittest.TestCase):\n    def test_finite_component_mapping_and_cross_axis_double_count(self):\n        source,target=ctx(concept=\"sales\"),ctx(concept=\"revenue\")\n        rule=MappingRule(\"sales\",\"revenue\",kind=\"component\",provenance=(\"review\",))\n        result=map_components(source,target,rule,population=[\"a\",\"b\"],members={\"one\":[\"a\"],\"two\":[\"b\"]},values={\"a\":\"3\",\"b\":\"5\"},axis=\"product\",at=\"2025-01-01\")\n        self.assertEqual(result[\"amount\"],8)\n        other=check_partition([\"a\",\"b\"],{\"north\":[\"a\",\"b\"]},axis=\"geography\")\n        with self.assertRaisesRegex(P06Error,\"OVERLAPPING_CLASSIFICATIONS\"):\n            combine_partitions([result[\"partition\"],other])\n        with self.assertRaisesRegex(P06Error,\"PARTITION_WITNESS_REQUIRED\"):\n            compatible_context(source,target,[rule])\n        residual=check_partition([\"a\",\"b\"],{\"one\":[\"a\"]},residual={\"members\":[\"b\"],\"known\":True},axis=\"x\")\n        self.assertTrue(residual[\"complete\"])\n        with self.assertRaisesRegex(P06Error,\"DUPLICATE_MEMBER\"):\n            check_partition([\"a\"],{\"one\":[\"a\",\"a\"]})\n\n    def test_transitive_revision_conflict_selectivity_and_ingestion(self):\n        base={\"source\":\"s\",\"available\":\"2025-01-01T00:00:00+00:00\",\"ingested\":\"2025-01-01T00:00:00+00:00\"}\n        rows=[dict(base,id=\"a\",supersedes=[]),dict(base,id=\"b\",supersedes=[\"a\"],available=\"unknown\"),dict(base,id=\"c\",supersedes=[\"b\"]),dict(base,id=\"note\",supersedes=[])]\n        self.assertEqual(select_evidence(rows,\"2026-01-01T00:00:00+00:00\")[\"selected_ids\"],[\"c\",\"note\"])\n        rows.append(dict(base,id=\"conflict\",supersedes=[\"a\"]))\n        self.assertEqual(set(select_evidence(rows,\"2026-01-01T00:00:00+00:00\")[\"selected_ids\"]),{\"c\",\"note\",\"conflict\"})\n        rows[-1][\"ingested\"]=\"2027-01-01T00:00:00+00:00\"\n        self.assertNotIn(\"conflict\",select_evidence(rows,\"2026-01-01T00:00:00+00:00\",system_as_of=\"2026-01-01T00:00:00+00:00\")[\"selected_ids\"])\n        self.assertEqual(select_evidence(rows,\"2026-01-01T00:00:00+00:00\",require_known_bytes=True)[\"selected_ids\"],[])\n\n    def test_named_zone_and_harmonisation_value_dependencies(self):\n        row={\"id\":\"x\",\"source\":\"s\",\"available\":\"2025-03-09\",\"supersedes\":[],\"amount\":\"12\"}\n        kw=dict(timezone_name=\"America/New_York\",date_only_policy=\"next_local_midnight\")\n        self.assertEqual(select_evidence([row],\"2025-03-10T03:59:59+00:00\",**kw)[\"selected_ids\"],[])\n        self.assertEqual(select_evidence([row],\"2025-03-10T04:00:00+00:00\",**kw)[\"selected_ids\"],[\"x\"])\n        h={\"source_id\":\"x\",\"target_id\":\"h\",\"review_decision\":\"Accept\",\"provenance\":[\"review\"]}\n        result=select_evidence([row],\"2026-01-01T00:00:00+00:00\",mode=\"harmonised\",harmonisations=[h],**kw)\n        self.assertEqual(result[\"derived\"][0][\"amount\"],\"12\")\n        self.assertEqual(result[\"derived\"][0][\"dependencies\"],[\"x\"])\n        with self.assertRaisesRegex(P06Error,\"UNSUPPORTED_HARMONISATION\"):\n            select_evidence([row],\"2026-01-01T00:00:00+00:00\",mode=\"harmonised\",harmonisations=[{**h,\"operation\":\"convert\"}],**kw)\n\n    def test_ytd_malformed_period_and_exception_scope(self):\n        a={\"id\":\"fy\",\"kind\":\"cumulative\",\"amount\":\"260\",\"concept\":\"sales\",\"context\":{},\"calendar\":\"gregorian\",\"revision_id\":\"r2\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2026-01-01\"}}\n        b={**a,\"id\":\"h1\",\"amount\":\"120\",\"revision_id\":\"r1\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2025-07-01\"}}\n        with self.assertRaisesRegex(P06Error,\"REVISION_COMPATIBILITY_SCOPE\"):\n            subtract_cumulative(a,b,revision_compatibility={\"accepted\":True,\"scope\":\"anything\",\"evidence\":[\"memo\"]})\n        scope={\"total_id\":\"fy\",\"earlier_id\":\"h1\",\"total_revision\":\"r2\",\"earlier_revision\":\"r1\",\"concept\":\"sales\",\"context\":{},\"total_period\":a[\"period\"],\"earlier_period\":b[\"period\"]}\n        self.assertEqual(subtract_cumulative(a,b,revision_compatibility={\"accepted\":True,\"scope\":scope,\"evidence\":[\"memo\"]})[\"amount\"],140)\n        with self.assertRaisesRegex(P06Error,\"INVALID_PERIOD\"):\n            subtract_cumulative(a,{**b,\"period\":{\"start\":\"2025-01-01\",\"end\":\"2024-01-01\"}})\n\n    def test_resolution_constituent_and_request_invalidation(self):\n        rows=ResolutionTests().rows();q=ResolutionTests().query()\n        prior=resolve_bullet_debt(rows,q)\n        changed=[DebtConstituent(\"a\",F(101),F(1,20),F(2)),rows[1]]\n        for key,value in [(\"horizon\",\"1/2\"),(\"scenario\",\"announced_stress\"),(\"requested_outputs\",[\"principal\"]),(\"evidence_view\",\"original\"),(\"context\",\"other\")]:\n            with self.subTest(key=key),self.assertRaisesRegex(P06Error,\"STALE_RESULT\"):\n                resolve_bullet_debt(rows,{**q,key:value},previous=prior)\n            self.assertTrue(resolve_bullet_debt(rows,{**q,key:value})[\"fresh\"])\n        with self.assertRaisesRegex(P06Error,\"STALE_RESULT\"):\n            resolve_bullet_debt(changed,q,previous=prior)\n        for patch,code in [({\"error_bound\":\"1\"},\"APPROXIMATION_BOUND_INVALID\"),({\"scope\":\"principal\"},\"APPROXIMATION_EVIDENCE_REQUIRED\"),({\"query_signature\":\"stale\"},\"STALE_APPROXIMATION\")]:\n            with self.assertRaisesRegex(P06Error,code):\n                resolve_bullet_debt(rows,q,approximation={\"target_rate\":\"0.06\",\"tolerance\":\"2\",\"error_bound\":\"3/2\",\"scope\":\"fixed_rate_interest\",\"evidence\":[\"triangle\"],**patch})\n        with self.assertRaisesRegex(P06Error,\"MATURITY_CROSSING\"):\n            resolve_bullet_debt(rows,{**q,\"horizon\":\"2\"})\n\n    def test_checker_failed_suite_returns_false_and_nonzero(self):\n        import check_accounting_p06 as checker\n        from unittest.mock import patch\n        from contextlib import redirect_stdout\n        import io\n        failure={\"methods\":1,\"failures\":1,\"errors\":0,\"skips\":0,\"passed\":False,\"output\":\"intentional failure\"}\n        args=[\"--output-dir\",str(ROOT/\"data/accounting-master/deliverables/P06\"),\"--approved-plan\",checker.DEFAULT_RUN+\"/approved-plan.json\",\"--execution-inventory\",checker.DEFAULT_RUN+\"/execution-1/pre-edit-files.json\"]\n        with patch.object(checker,\"run_suite\",return_value=failure), patch.object(Path,\"write_text\") as writes, redirect_stdout(io.StringIO()):\n            code=checker.main(args)\n        self.assertEqual(code,1)\n        payload=json.loads(writes.call_args_list[0].args[0])\n        self.assertIs(payload[\"passed\"],False)\n\n\nclass IntegrationTests(unittest.TestCase):\n    def setup_case(self):\n        fixture=json.loads((ROOT/'docs/design/fixtures/p06-context-chronology-cases-v1.json').read_text())\n        engine=P06Engine()\n        engine.add_context(\"source\",ctx(concept=\"sales\"));engine.add_context(\"target\",ctx(concept=\"revenue\"))\n        engine.add_mapping(MappingRule(\"sales\",\"revenue\",provenance=(\"fixture\",)))\n        for row in fixture[\"assertions\"]:\n            engine.add_assertion(row)\n        request={\"cutoff\":\"2026-12-31\",\"timezone\":\"UTC\",\"date_only_policy\":\"next_local_midnight\",\"evidence_view\":\"latest_available\",\"source_context\":\"source\",\"target_context\":\"target\",\"derive\":{\"total\":\"fy25\",\"earlier\":\"h1-original\"},\"registry\":registry(),\"uncertainty\":[admission_cases()[0]],\"constituents\":[{\"id\":\"d\",\"principal_from\":\"derived\",\"rate\":\"1/20\",\"maturity\":\"2\"}],\"query\":ResolutionTests().query(context=\"target\")}\n        return engine,request\n\n    def test_source_drives_period_and_resolution_and_freezes_prior_result(self):\n        engine,request=self.setup_case()\n        result=engine.evaluate(request)\n        self.assertEqual(result[\"derived\"][\"amount\"],150)\n        self.assertEqual(result[\"resolution\"][\"outputs\"][\"interest\"],F(15,2))\n        preserved=engine.preserve_result()\n        old=next(x for x in engine.assertions if x[\"id\"]==\"h1-revised\")\n        engine.revise(\"h1-revised\",{**old,\"id\":\"h1-new\",\"amount\":\"100\",\"supersedes\":[\"h1-revised\"]})\n        self.assertFalse(engine.current_results)\n        new=engine.evaluate(request)\n        self.assertEqual(new[\"derived\"][\"amount\"],160)\n        self.assertEqual(new[\"resolution\"][\"outputs\"][\"interest\"],8)\n        self.assertNotEqual(result[\"input_sha256\"],new[\"input_sha256\"])\n        preserved[\"derived\"][\"amount\"]=-1\n        self.assertEqual(engine.preserved_results[\"current\"][\"derived\"][\"amount\"],150)\n\n    def test_revision_links_affect_selection_and_failed_mutation_is_atomic(self):\n        engine,request=self.setup_case()\n        old=next(x for x in engine.assertions if x[\"id\"]==\"h1-revised\")\n        engine.revise(\"h1-original\",{**old,\"id\":\"competing\",\"supersedes\":[\"h1-original\"]})\n        with self.assertRaisesRegex(P06Error,\"EVIDENCE_UNAVAILABLE_OR_CONFLICTING\"):\n            engine.evaluate(request)\n        before=copy.deepcopy(engine.assertions)\n        with self.assertRaisesRegex(P06Error,\"DANGLING_SUPERSESSION\"):\n            engine.add_assertion({\"id\":\"bad\",\"source\":\"x\",\"supersedes\":[\"absent\"]})\n        self.assertEqual(engine.assertions,before)\n\n    def test_adapters_preserve_p03_source_and_p01_unknown(self):\n        from core0_ir_v1 import ReadingBinding\n        binding=ReadingBinding(\"reading\",\"USD 100\",\"100\",\"USD\",\"2025-01-01\",\"fixture:uri\",\"doc\",\"2025-02-01T00:00:00+00:00\",\"2025-02-02T00:00:00+00:00\",\"reviewer\",\"2025-02-02T00:00:00+00:00\",\"reviewed\",\"2025-03-01T00:00:00+00:00\",action=\"Accept\")\n        row=adapt_p03_reading(binding,ctx())\n        self.assertEqual(row[\"literal\"],\"USD 100\");self.assertEqual(row[\"amount\"],100)\n        core={**ctx().as_dict(),\"dimensions\":[{\"axis\":\"segment\",\"member\":\"retail\"}]}\n        self.assertEqual(adapt_core_context(core,perimeter_version=\"2026\",gross_net=\"gross\",calendar=\"gregorian\"),ctx())\n        records=json.loads((ROOT/'data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json').read_text())[\"records\"]\n        adapted=adapt_p01_source(records[0])\n        selected=select_evidence([adapted],\"2026-10-03T00:00:00+00:00\",require_known_bytes=True)\n        self.assertEqual(selected[\"selected_ids\"],[]);self.assertTrue(selected[\"unresolved\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' scripts/check_accounting_p06.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Execute P06 deterministic checks and write conformance/result evidence.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom collections import Counter\nfrom datetime import datetime, timezone\nfrom fractions import Fraction\nimport hashlib\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport shlex\nimport subprocess\nimport sys\nimport time\nimport unittest\n\nROOT = Path(__file__).resolve().parents[1]\nDEFAULT_RUN = \"data/accounting-master/runs/20261002T233421-cea9e631/P06\"\nSOURCES = [\n    \"scripts/context_chronology_v1.py\", \"scripts/check_accounting_p06.py\",\n    \"tests/test_accounting_p06.py\", \"docs/design/spec/context-chronology-profile-v1.md\",\n    \"docs/design/fixtures/p06-context-chronology-cases-v1.json\",\n]\nOUTPUTS = [\"data/accounting-master/deliverables/P06/conformance.json\",\n           \"data/accounting-master/deliverables/P06/result.md\"]\nWRITABLE = set(SOURCES + OUTPUTS + [\"data/accounting-master/deliverables/P06/progress.md\"])\nOBLIGATIONS = [\"MC02\", \"MC05\", \"MC06\", \"MC07\", \"MC10\", \"MC11\", \"MC14\", \"YTD\", \"APPROXIMATION\"]\n\n\ndef digest(path: Path) -> str | None:\n    try:\n        return hashlib.sha256(path.read_bytes()).hexdigest()\n    except OSError:\n        return None\n\n\ndef unique_object(pairs):\n    result = {}\n    for key, value in pairs:\n        if key in result:\n            raise ValueError(\"duplicate key: \" + key)\n        result[key] = value\n    return result\n\n\ndef inventory(root: Path, relative: str) -> dict[str, str]:\n    path = Path(relative)\n    if path.is_absolute() or \"..\" in path.parts or path.as_posix() != relative:\n        raise ValueError(\"inventory path must be repository-relative\")\n    data = json.loads((root / path).read_text(), object_pairs_hook=unique_object)\n    if not isinstance(data, dict) or not data:\n        raise ValueError(\"inventory must be a nonempty path-to-SHA256 object\")\n    for name, value in data.items():\n        p = Path(name)\n        if p.is_absolute() or \"..\" in p.parts or p.as_posix() != name or not isinstance(value, str) or len(value) != 64:\n            raise ValueError(\"invalid inventory entry: \" + str(name))\n    return data\n\n\ndef approval_reference(root: Path, relative: str) -> dict[str, str]:\n    raw = (root / relative).read_bytes()\n    record = json.loads(raw, object_pairs_hook=unique_object)\n    if not isinstance(record, dict):\n        raise ValueError(\"approved plan is not an object\")\n    for name, verdict in ((\"plan\", \"PLAN\"), (\"review\", \"AGREE\")):\n        section = record.get(name)\n        if not isinstance(section, dict) or section.get(\"verdict\") != verdict:\n            raise ValueError(f\"approved plan lacks {name} {verdict}\")\n        if not isinstance(section.get(\"summary\"), str) or any(not isinstance(section.get(k), list) for k in (\"steps\", \"assumptions\", \"checks\", \"evidence\", \"issues\", \"residuals\", \"next_actions\")):\n            raise ValueError(\"malformed approved plan\")\n    if record[\"review\"].get(\"issues\") != []:\n        raise ValueError(\"approved plan has review issues\")\n    plan_hash = hashlib.sha256(json.dumps(record[\"plan\"], sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode()).hexdigest()\n    if record.get(\"plan_hash\") != plan_hash:\n        raise ValueError(\"approved plan hash mismatch\")\n    return {\"path\": relative, \"sha256\": hashlib.sha256(raw).hexdigest(), \"plan_hash\": plan_hash}\n\n\ndef protection(root: Path, phase_inventory: str, execution_inventory: str) -> dict:\n    historical = inventory(root, phase_inventory)\n    execution = inventory(root, execution_inventory)\n    protected = sorted((set(historical) | set(execution)) - WRITABLE)\n    before = {p: digest(root / p) for p in protected}\n    changed = [p for p in protected if before[p] != execution.get(p)]\n    missing = [p for p, h in before.items() if h is None]\n    return {\"historical_inventory\": phase_inventory, \"execution_inventory\": execution_inventory,\n            \"inventory_hashes\": {phase_inventory: digest(root / phase_inventory), execution_inventory: digest(root / execution_inventory)},\n            \"excluded_phase_files\": sorted(WRITABLE), \"before\": before, \"execution_baseline\": {p: execution.get(p) for p in protected},\n            \"changed_since_execution_entry\": changed, \"missing_before_check\": missing,\n            \"historical_differences\": [p for p in sorted(set(historical) & set(execution)) if historical[p] != execution[p]]}\n\n\ndef finish_protection(root: Path, report: dict) -> dict:\n    report[\"after\"] = {p: digest(root / p) for p in report[\"before\"]}\n    report[\"changed_during_check\"] = [p for p in report[\"before\"] if report[\"before\"][p] != report[\"after\"][p]]\n    report[\"changed_inventory_records\"] = [p for p, h in report[\"inventory_hashes\"].items() if h is None or digest(root / p) != h]\n    report[\"passed\"] = not any(report[k] for k in (\"changed_since_execution_entry\", \"missing_before_check\", \"changed_during_check\", \"changed_inventory_records\"))\n    return report\n\n\ndef run_suite(module_name: str) -> dict:\n    sys.path.insert(0, str(ROOT / \"tests\"))\n    stream = io.StringIO()\n    try:\n        module = __import__(module_name)\n        suite = unittest.defaultTestLoader.loadTestsFromModule(module)\n        result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)\n        return {\"module\": module_name, \"methods\": result.testsRun, \"failures\": len(result.failures), \"errors\": len(result.errors), \"skips\": len(result.skipped), \"passed\": bool(result.wasSuccessful() and result.testsRun > 0 and not result.skipped), \"output\": stream.getvalue()}\n    except Exception as exc:\n        return {\"module\": module_name, \"methods\": 0, \"failures\": 0, \"errors\": 1, \"skips\": 0, \"passed\": False, \"output\": stream.getvalue() + repr(exc)}\n\n\ndef probes() -> list[dict]:\n    \"\"\"Independent criterion probes; expected values are computed here, not imported from tests.\"\"\"\n    from context_chronology_v1 import (Context, MappingRule, P06Error, check_partition, compatible_context,\n                                        resolve_bullet_debt, select_evidence, subtract_cumulative, admit_uncertainty, guard_information_view)\n    rows = []\n    def observe(identifier, fn):\n        try:\n            value = fn()\n            rows.append({\"id\": identifier, \"passed\": bool(value is not False), \"observed\": value})\n        except Exception as exc:\n            rows.append({\"id\": identifier, \"passed\": False, \"error\": type(exc).__name__ + \": \" + str(exc)})\n    base = {\"concept\":\"x\", \"entity\":\"A\", \"perimeter\":\"A\", \"perimeter_version\":\"1\", \"basis\":\"G\", \"measurement\":\"m\", \"unit\":\"USD\", \"currency\":\"USD\", \"calendar\":\"gregorian\", \"dimensions\":{}, \"gross_net\":\"gross\"}\n    observe(\"MC02\", lambda: compatible_context(Context.from_dict(base), Context.from_dict({**base, \"concept\":\"y\"}), [MappingRule(\"x\", \"y\", provenance=(\"probe\",))])[\"kind\"] == \"equivalent\")\n    observe(\"MC07\", lambda: check_partition([\"a\", \"b\"], {\"left\":[\"a\"], \"right\":[\"b\"]})[\"complete\"])\n    assertions = [{\"id\":\"old\", \"available\":\"2025-01-01\", \"ingested\":\"2025-01-01\", \"supersedes\":[], \"source\":\"s\"}, {\"id\":\"new\", \"available\":\"2026-01-01\", \"ingested\":\"2026-01-01\", \"supersedes\":[\"old\"], \"source\":\"s\"}]\n    observe(\"MC05\", lambda: select_evidence(assertions, \"2026-12-31\", timezone_name=\"UTC\", date_only_policy=\"next_local_midnight\")[\"selected_ids\"] == [\"new\"])\n    observe(\"YTD\", lambda: subtract_cumulative({\"kind\":\"cumulative\",\"amount\":260,\"concept\":\"x\",\"context\":{},\"calendar\":\"gregorian\",\"revision_id\":\"r\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2025-12-31\"}}, {\"kind\":\"cumulative\",\"amount\":110,\"concept\":\"x\",\"context\":{},\"calendar\":\"gregorian\",\"revision_id\":\"r\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2025-06-30\"}})[\"amount\"] == 150)\n    admission = {\"id\":\"r\",\"kind\":\"ExtractionReading\",\"scope\":\"s\",\"provenance\":[\"p\"],\"dependencies\":[],\"source\":\"d\",\"locator\":\"p1\",\"review_decision\":\"Accept\"}\n    observe(\"MC10\", lambda: admit_uncertainty(admission, known_records={\"d\":{\"kind\":\"Source\",\"locators\":[\"p1\"]}})[\"kind\"] == \"ExtractionReading\")\n    debt = [{\"id\":\"a\",\"principal\":\"100\",\"rate\":\"1/20\",\"maturity\":\"2\"}, {\"id\":\"b\",\"principal\":\"50\",\"rate\":\"7/100\",\"maturity\":\"2\"}]\n    query = {\"contract\":\"c\",\"context\":\"x\",\"evidence_view\":\"latest_available\",\"horizon\":\"1\",\"scenario\":\"base\",\"requested_outputs\":[\"interest\"],\"accrual_convention\":\"simple_actual_fraction\",\"group_by\":[\"rate\",\"maturity\",\"reset\",\"hedge\"]}\n    observe(\"MC11\", lambda: resolve_bullet_debt(debt, query)[\"outputs\"][\"interest\"] == Fraction(17, 2))\n    observe(\"APPROXIMATION\", lambda: (lambda x: x[\"approximation\"][\"bound\"] == \"3/2\")(resolve_bullet_debt(debt, query, approximation={\"target_rate\":\"0.06\",\"tolerance\":\"2\",\"error_bound\":\"3/2\",\"scope\":\"fixed_rate_interest\",\"evidence\":[\"probe\"]})))\n    def parent_rejected():\n        try:\n            compatible_context(base, {**base, \"perimeter\": \"Group\"})\n        except P06Error as exc:\n            return exc.code == \"PARENT_GROUP_MISMATCH\"\n        return False\n    observe(\"MC06\", parent_rejected)\n    observe(\"MC14\", lambda: guard_information_view({\"visible\":[],\"measure_id\":\"P\",\"pricing_measure_id\":\"Q\"},event_time=\"2025-01-01\")[\"selection_changes_history\"] is False)\n    return rows\n\n\ndef main(argv=None) -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--output-dir\", required=True)\n    parser.add_argument(\"--approved-plan\", required=True)\n    parser.add_argument(\"--execution-inventory\", required=True)\n    parser.add_argument(\"--inject-failure\", action=\"store_true\", help=argparse.SUPPRESS)\n    args = parser.parse_args(argv)\n    out = Path(args.output_dir).resolve()\n    if out != ROOT / \"data/accounting-master/deliverables/P06\":\n        parser.error(\"use the declared P06 output directory\")\n    started = time.monotonic(); started_utc = datetime.now(timezone.utc).isoformat()\n    phase_inventory = str(Path(args.execution_inventory).parent.parent / \"phase-entry-inventory.json\")\n    try:\n        approved = approval_reference(ROOT, args.approved_plan)\n        protected = protection(ROOT, phase_inventory, args.execution_inventory)\n    except (OSError, ValueError) as exc:\n        parser.error(str(exc))\n    code_before = {p: digest(ROOT / p) for p in SOURCES}\n    os.environ[\"CUDA_VISIBLE_DEVICES\"] = \"-1\"\n    reports = {name: run_suite(name) for name in (\"test_accounting_p06\", \"test_accounting_p03\", \"test_accounting_p04\")}\n    observations = probes()\n    status = {\"required\": len(OBLIGATIONS), \"observed\": len(observations), \"missing\": sorted(set(OBLIGATIONS) - {x[\"id\"] for x in observations}), \"uncatalogued\": sorted({x[\"id\"] for x in observations} - set(OBLIGATIONS)), \"duplicate_ids\": [k for k, v in Counter(x[\"id\"] for x in observations).items() if v != 1], \"failed_observations\": [x[\"id\"] for x in observations if x.get(\"passed\") is not True]}\n    code_after = {p: digest(ROOT / p) for p in SOURCES}\n    protected = finish_protection(ROOT, protected)\n    stable = all(code_before[p] == code_after[p] for p in SOURCES)\n    passed = (all(x[\"passed\"] for x in reports.values()) and all(x.get(\"passed\") for x in observations) and not status[\"missing\"] and not status[\"uncatalogued\"] and not status[\"duplicate_ids\"] and protected[\"passed\"] and stable and not args.inject_failure)\n    command_args = sys.argv[1:] if argv is None else argv\n    command = shlex.join([\"CUDA_VISIBLE_DEVICES=-1\", \"python3\", \"-B\", \"scripts/check_accounting_p06.py\"] + command_args)\n    payload = {\"schema_version\":\"accdsl.p06.conformance.v1\", \"passed\": bool(passed), \"profile\":\"context-chronology-resolution-v1\", \"obligation_status\":status, \"observations\":observations, \"tests\":reports, \"protection\":protected, \"code_stable_during_check\":stable, \"provenance\":{\"approved_plan\":approved, \"phase_entry_inventory\":phase_inventory, \"execution_inventory\":args.execution_inventory}, \"hashes\":code_after, \"input_hashes\":{p:digest(ROOT / p) for p in [\"scripts/core0_ir_v1.py\", \"scripts/reconstruction_v1.py\", \"docs/plans/accounting-mission-requirements.md\", \"data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json\"]}, \"manifest\":{\"git_commit\":\"unavailable: existing marker is not a usable repository\", \"command\":command, \"working_directory\":str(ROOT), \"executable\":sys.executable, \"environment\":{\"python\":platform.python_version()}, \"hardware\":\"CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported\", \"random_seeds\":\"N/A: exact deterministic fixtures\", \"data_version\":\"p06-context-chronology-cases-v1\", \"started_utc\":started_utc, \"wall_seconds\":round(time.monotonic()-started, 6), \"plan\":args.approved_plan, \"plan_sha256\":approved[\"sha256\"], \"approved_plan_hash\":approved[\"plan_hash\"], \"execution_inventory\":args.execution_inventory, \"outputs\":OUTPUTS, \"result\":OUTPUTS[1], \"phase_contribution_files\":sorted(WRITABLE)}, \"requirement_coverage\":{\"MC02\":\"context-aware mappings and explicit mismatch rejection\", \"MC05\":\"chronology, availability and revision-compatible YTD\", \"MC06\":\"entity/perimeter mismatch rejection; consolidation unsupported\", \"MC07\":\"finite mappings, partition membership and overlap rejection\", \"MC10\":\"six category uncertainty admission\", \"MC11\":\"constituent/query-bound debt grouping and approximation certificate\", \"MC14\":\"dated information admission and unsupported scenario modes\"}, \"acceptance\":{\"engineering\":bool(passed), \"accounting_validity\":\"not established\", \"forecast_validity\":\"not established\", \"human_acceptance\":\"pending\", \"whole_gap_closure\":False}}\n    out.mkdir(parents=True, exist_ok=True)\n    out.joinpath(\"conformance.json\").write_text(json.dumps(payload, indent=2, default=str) + \"\\n\")\n    decision = \"PASS\" if passed else \"FAIL\"\n    result_text = f'''# P06 context, chronology, and resolution result\n\n{decision}: {reports[\"test_accounting_p06\"][\"methods\"]} P06 tests, {reports[\"test_accounting_p03\"][\"methods\"]} P03 regression tests, and {reports[\"test_accounting_p04\"][\"methods\"]} P04 regression tests executed. The conformance file records every test outcome, independent criterion probe, source hash, inventory comparison, command, and manifest.\n\nRepair replaced metadata-only harmonisation with derived identity observations, enforced reference/date/domain admission, bound resolution to constituent values, and connected selected evidence to period derivation and debt arithmetic. The runtime preserves earlier result copies and rejects conflicting revisions.\n\nThe implementation supplies explicit context mappings, finite partition enumeration, supersession-DAG evidence selection, date-only next-local-midnight handling, revision-compatible YTD subtraction, six category-specific uncertainty admission, information-view guards, and query-signature-bound fixed-rate unhedged bullet-debt resolution. Exact Fraction arithmetic is used throughout the supported scalar path. An approximation is accepted only with a fixed-rate scope, declared tolerance, and a triangle-inequality error certificate.\n\nThe tests independently verify 260 minus revised H1 110 equals H2 150 and reject subtraction using incompatible original H1 120. They reject parent/group, basis, measurement, currency, calendar, gross/net, overlap, omission, dangling/cyclic revision, future-information, unsupported treatment, unsupported scenario, stale-query, maturity-crossing, and missing-approximation-evidence cases. Historical byte availability marked unknown remains unresolved and is excluded from the integrated historical computation. Tests also mutate the selected H1 amount from 110 to 100: derived H2 changes from 150 to 160, and the synthetic debt interest changes from 7.5 to 8, while the preserved earlier result remains 150.\n\nSpecified behaviour is recorded in the versioned profile. Implemented operations and independently tested invariants are bounded to those operations; synthetic permissions and evidence references do not establish accounting eligibility or source truth. Identity harmonisation, finite scalar historical domains, a hold policy, and exact integer-period DCF are supported; broader transformations/policies are explicitly unsupported.\n\n| Decision | Primary criterion | Veto status | Main uncertainty | Next justified action | Not concluded |\n| --- | --- | --- | --- | --- | --- |\n| {decision} for bounded engineering conformance | Independent P06 probes and focused/regression suites | tests={all(x[\"passed\"] for x in reports.values())}; protection={protected[\"passed\"]}; stable={stable}; failed_observations={status[\"failed_observations\"]} | finite synthetic cases and unannotated source availability | independent result review if PASS; repair if FAIL | professional accounting validity, empirical forecast validity, human acceptance, or wider MC01–MC35/G1–G18 closure |\n\nEngineering correctness, numerical validity, and interpretation remain separate. The exact outputs establish only the declared bounded operations. The strongest alternative explanation is a shared interpretation error in the synthetic fixtures; independent set and arithmetic probes reduce that risk but do not replace source or professional review. The weakest evidence is breadth: mappings, uncertainty, and grouping are finite bounded cases.\n\nResiduals: general measurement conversion, consolidation, arbitrary calendars, continuous or nonlinear uncertainty, empirical approximation validation, historical retained-byte availability, accounting validity, forecast validity, and human acceptance remain open. This phase does not rank stochastic candidates or establish a production default.\n\nActual command: `{command}`. Python {platform.python_version()}, CPU only with accelerator devices intentionally hidden. Wall time: {payload[\"manifest\"][\"wall_seconds\"]} seconds. Git provenance is unavailable; content hashes and supervisor inventories are retained in conformance.json.\n'''\n    out.joinpath(\"result.md\").write_text(result_text)\n    print(json.dumps({\"passed\":bool(passed), \"tests\":{k:{x:v[x] for x in (\"methods\",\"failures\",\"errors\",\"skips\",\"passed\")} for k,v in reports.items()}, \"obligations\":status, \"protected\":protected[\"passed\"], \"stable\":stable}))\n    return 0 if passed else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
