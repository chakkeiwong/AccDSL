{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"nl -ba scripts/context_chronology_v1.py | sed -n '500,590p'\"","aggregated_output":"   500\t            fail(\"REVISION_UNKNOWN\", \"subtraction requires explicit revision identities or a reviewed scoped exception\", \"ytd\")\n   501\t    if tr != er:\n   502\t        allowed = revision_compatibility and revision_compatibility.get(\"accepted\")\n   503\t        if not allowed or not revision_compatibility.get(\"scope\") or not revision_compatibility.get(\"evidence\"):\n   504\t            fail(\"REVISION_INCOMPATIBLE\", \"subtraction requires a common revision or reviewed scoped exception\", \"ytd\")\n   505\t    amount = _fraction(total[\"amount\"], \"total.amount\") - _fraction(earlier[\"amount\"], \"earlier.amount\")\n   506\t    return {\"kind\": \"flow\", \"amount\": amount, \"period\": {\"start\": ep[\"end\"], \"end\": tp[\"end\"]},\n   507\t            \"concept\": total[\"concept\"], \"context\": deepcopy(total.get(\"context\")), \"calendar\": total[\"calendar\"],\n   508\t            \"provenance\": {\"operation\": \"cumulative_subtraction\", \"total_id\": total.get(\"id\"), \"earlier_id\": earlier.get(\"id\"),\n   509\t                           \"revision_id\": tr or er}}\n   510\t\n   511\t\n   512\t_SUPPORTED_MEASUREMENT_METHODS = {\"direct\", \"discounted_cash_flow\", \"observable_input\"}\n   513\t_SUPPORTED_MEASURES = {\"real_world\", \"pricing\"}\n   514\t\n   515\t\n   516\tdef _validate_joint_law(law: Any, where: str) -> list[dict[str, Any]]:\n   517\t    atoms = law.get(\"atoms\") if isinstance(law, Mapping) else law\n   518\t    if not isinstance(atoms, list) or not atoms:\n   519\t        fail(\"INVALID_JOINT_LAW\", \"finite joint law needs atoms\", where)\n   520\t    ids = [a.get(\"id\") for a in atoms]\n   521\t    if any(not isinstance(x, str) for x in ids) or len(ids) != len(set(ids)):\n   522\t        fail(\"INVALID_JOINT_LAW\", \"atom IDs must be distinct\", where)\n   523\t    hypotheses = [a.get(\"hypothesis\") for a in atoms]\n   524\t    if any(not isinstance(h, Mapping) or not h or any(isinstance(v, (Mapping, list, tuple)) for v in h.values()) for h in hypotheses):\n   525\t        fail(\"INVALID_JOINT_LAW\", \"complete scalar hypotheses are required\", where)\n   526\t    if len({json.dumps(h, sort_keys=True) for h in hypotheses}) != len(hypotheses):\n   527\t        fail(\"INVALID_JOINT_LAW\", \"joint hypotheses overlap\", where)\n   528\t    if any(set(h) != set(hypotheses[0]) for h in hypotheses):\n   529\t        fail(\"INVALID_JOINT_LAW\", \"all atoms must assign the same variables\", where)\n   530\t    weights = [_fraction(a.get(\"weight\"), where) for a in atoms]\n   531\t    if any(w < 0 for w in weights) or sum(weights, Fraction()) != 1:\n   532\t        fail(\"INVALID_JOINT_LAW\", \"weights must be nonnegative and sum to one\", where)\n   533\t    return [dict(a) for a in atoms]\n   534\t\n   535\t\n   536\tdef admit_uncertainty(record: Mapping[str, Any], *, known_records: Mapping[str, Mapping[str, Any]] | None = None,\n   537\t                      available_information: Iterable[str] = ()) -> dict[str, Any]:\n   538\t    kind = record.get(\"kind\")\n   539\t    fields = {\n   540\t        \"ExtractionReading\": (\"source\", \"locator\", \"review_decision\"),\n   541\t        \"HistoricalFact\": (\"evidence\", \"reason\"),\n   542\t        \"AccountingElection\": (\"package\", \"permitted_treatments\", \"election\", \"effective_date\", \"eligibility_evidence\"),\n   543\t        \"MeasurementEstimate\": (\"method\", \"measurement_date\", \"inputs\"),\n   544\t        \"BehaviourPolicy\": (\"policy\", \"information_set\", \"decision_time\"),\n   545\t        \"FutureInnovation\": (\"driver\", \"future_period\", \"scenario\", \"joint_law\", \"measure\"),\n   546\t    }\n   547\t    if kind not in fields:\n   548\t        fail(\"UNKNOWN_UNCERTAINTY_CATEGORY\", f\"unsupported category {kind!r}\", \"kind\")\n   549\t    for key in (\"id\", \"scope\", \"provenance\", \"dependencies\") + fields[kind]:\n   550\t        if key not in record or (key != \"dependencies\" and not record[key]):\n   551\t            fail(\"MISSING_ADMISSION_FIELD\", f\"missing admission field {key}\", str(record.get(\"id\", \"\")))\n   552\t    if not isinstance(record[\"provenance\"], list) or not isinstance(record[\"dependencies\"], list):\n   553\t        fail(\"INVALID_ADMISSION_LIST\", \"provenance and dependencies must be lists\", str(record[\"id\"]))\n   554\t    known_records = known_records or {}\n   555\t    for dep in record[\"dependencies\"]:\n   556\t        if dep not in known_records:\n   557\t            fail(\"DANGLING_DEPENDENCY\", f\"unknown dependency {dep}\", str(record[\"id\"]))\n   558\t    graph = {key: list(value.get(\"dependencies\", ())) for key, value in known_records.items()}\n   559\t    graph[str(record[\"id\"])] = list(record[\"dependencies\"])\n   560\t    state: dict[str, int] = {}\n   561\t    def visit(node: str) -> None:\n   562\t        state[node] = 1\n   563\t        for dep in graph.get(node, ()):\n   564\t            if dep not in graph:\n   565\t                fail(\"DANGLING_DEPENDENCY\", dep, node)\n   566\t            if state.get(dep) == 1:\n   567\t                fail(\"CYCLIC_DEPENDENCY\", \"uncertainty dependencies contain a cycle\", str(record[\"id\"]))\n   568\t            if state.get(dep) != 2:\n   569\t                visit(dep)\n   570\t        state[node] = 2\n   571\t    for node in graph:\n   572\t        if state.get(node, 0) == 0:\n   573\t            visit(node)\n   574\t    def resolve(identifier, expected_kind=None):\n   575\t        row = known_records.get(identifier)\n   576\t        if row is None:\n   577\t            fail(\"UNRESOLVED_ADMISSION_REFERENCE\", str(identifier), record[\"id\"])\n   578\t        if expected_kind and row.get(\"kind\") != expected_kind:\n   579\t            fail(\"ADMISSION_REFERENCE_KIND\", str(identifier), record[\"id\"])\n   580\t        return row\n   581\t\n   582\t    def evidence(identifier):\n   583\t        row = resolve(identifier)\n   584\t        if row.get(\"review_decision\") != \"Accept\":\n   585\t            fail(\"EVIDENCE_NOT_ACCEPTED\", str(identifier))\n   586\t        return row\n   587\t\n   588\t    if kind == \"ExtractionReading\":\n   589\t        if record[\"review_decision\"] != \"Accept\":\n   590\t            fail(\"READING_NOT_ACCEPTED\", \"reading requires accepted review\")\n","exit_code":0,"status":"completed"}}
