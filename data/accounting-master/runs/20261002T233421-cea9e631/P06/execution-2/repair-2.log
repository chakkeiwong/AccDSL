{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"nl -ba tests/test_accounting_p06.py | sed -n '205,230p'\"","aggregated_output":"   205\t        innovation = admission_cases()[5]\n   206\t        for atoms in [\n   207\t            [{\"id\":\"a\",\"hypothesis\":{\"shock\":0},\"weight\":\"1/2\"}],\n   208\t            [{\"id\":\"a\",\"hypothesis\":{\"shock\":0},\"weight\":\"1/2\"},{\"id\":\"b\",\"hypothesis\":{\"other\":1},\"weight\":\"1/2\"}],\n   209\t            [{\"id\":\"a\",\"hypothesis\":{\"shock\":0},\"weight\":\"1/2\"},{\"id\":\"b\",\"hypothesis\":{\"shock\":0},\"weight\":\"1/2\"}],\n   210\t        ]:\n   211\t            with self.assertRaisesRegex(P06Error, \"INVALID_JOINT_LAW\"):\n   212\t                admit_uncertainty({**innovation, \"joint_law\": {\"measure\":\"real_world\",\"atoms\":atoms}})\n   213\t\n   214\t    def test_information_view_dates_and_modes(self):\n   215\t        view = {\"visible\": [\"past\", \"stress\"], \"future_announced\": [\"stress\"], \"future_realised\": [\"outcome\"], \"records\": registry(), \"measure_id\": \"P\", \"pricing_measure_id\": \"Q\"}\n   216\t        saved = copy.deepcopy(view)\n   217\t        self.assertFalse(guard_information_view(view, event_time=\"2025-01-01\")[\"selection_changes_history\"])\n   218\t        self.assertEqual(view, saved)\n   219\t        for patch, mode, code in [({\"future_announced\": []}, \"exogenous_stress\", \"FUTURE_INFORMATION_LEAKAGE\"), ({\"visible\":[\"outcome\"]}, \"exogenous_stress\", \"FUTURE_INFORMATION_LEAKAGE\"), ({\"pricing_measure_id\":\"P\"}, \"exogenous_stress\", \"INCOMPATIBLE_PROBABILITY_MEASURE\"), ({}, \"structural_intervention\", \"UNSUPPORTED_INFORMATION_OPERATION\"), ({}, \"observational_conditioning\", \"UNSUPPORTED_INFORMATION_OPERATION\"), ({}, \"typo\", \"UNSUPPORTED_INFORMATION_OPERATION\")]:\n   220\t            with self.assertRaisesRegex(P06Error, code):\n   221\t                guard_information_view({**view, **patch}, event_time=\"2025-01-01\", request=mode)\n   222\t\n   223\t\n   224\tclass ResolutionTests(unittest.TestCase):\n   225\t    def rows(self):\n   226\t        return [DebtConstituent(\"a\", F(100), F(5, 100), F(2)), DebtConstituent(\"b\", F(50), F(7, 100), F(2))]\n   227\t\n   228\t    def query(self, **extra):\n   229\t        q = {\"contract\": \"bullet-v1\", \"context\": \"usd\", \"evidence_view\": \"latest_available\", \"horizon\": \"1\", \"scenario\": \"base\", \"requested_outputs\": [\"interest\", \"principal\"], \"accrual_convention\": \"simple_actual_fraction\", \"group_by\": [\"rate\", \"maturity\", \"reset\", \"hedge\"]}\n   230\t        q.update(extra)\n","exit_code":0,"status":"completed"}}
