ting_p06.py:1:#!/usr/bin/env python3\\nscripts/check_accounting_p06.py:31:OBLIGATIONS = [\\\"MC02\\\", \\\"MC05\\\", \\\"MC06\\\", \\\"MC07\\\", \\\"MC10\\\", \\\"MC11\\\", \\\"MC14\\\"]\\nscripts/check_accounting_p06.py:34:def digest(path: Path) -> str | None:\\nscripts/check_accounting_p06.py:41:def unique_object(pairs):\\nscripts/check_accounting_p06.py:50:def inventory(root: Path, relative: str) -> dict[str, str]:\\nscripts/check_accounting_p06.py:64:def approval_reference(root: Path, relative: str) -> dict[str, str]:\\nscripts/check_accounting_p06.py:83:def protection(root: Path, phase_inventory: str, execution_inventory: str) -> dict:\\nscripts/check_accounting_p06.py:97:def finish_protection(root: Path, report: dict) -> dict:\\nscripts/check_accounting_p06.py:105:def run_suite(module_name: str) -> dict:\\nscripts/check_accounting_p06.py:117:def probes() -> list[dict]:\\nscripts/check_accounting_p06.py:122:    def observe(identifier, fn):\\nscripts/check_accounting_p06.py:129:    observe(\\\"MC02\\\", lambda: compatible_context(Context.from_dict(base), Context.from_dict({**base, \\\"concept\\\":\\\"y\\\"}), [MappingRule(\\\"x\\\", \\\"y\\\", provenance=(\\\"probe\\\",))])[\\\"kind\\\"] == \\\"equivalent\\\")\\nscripts/check_accounting_p06.py:130:    observe(\\\"MC05\\\", lambda: check_partition([\\\"a\\\", \\\"b\\\"], {\\\"left\\\":[\\\"a\\\"], \\\"right\\\":[\\\"b\\\"]})[\\\"complete\\\"])\\nscripts/check_accounting_p06.py:132:    observe(\\\"MC06\\\", lambda: select_evidence(assertions, \\\"2026-12-31\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")[\\\"selected_ids\\\"] == [\\\"new\\\"])\\nscripts/check_accounting_p06.py:133:    observe(\\\"MC07\\\", lambda: subtract_cumulative({\\\"kind\\\":\\\"cumulative\\\",\\\"amount\\\":260,\\\"concept\\\":\\\"x\\\",\\\"context\\\":{},\\\"calendar\\\":\\\"g\\\",\\\"revision_id\\\":\\\"r\\\",\\\"period\\\":{\\\"start\\\":\\\"2025-01-01\\\",\\\"end\\\":\\\"2025-12-31\\\"}}, {\\\"kind\\\":\\\"cumulative\\\",\\\"amount\\\":110,\\\"concept\\\":\\\"x\\\",\\\"context\\\":{},\\\"calendar\\\":\\\"g\\\",\\\"revision_id\\\":\\\"r\\\",\\\"period\\\":{\\\"start\\\":\\\"2025-01-01\\\",\\\"end\\\":\\\"2025-06-30\\\"}})[\\\"amount\\\"] == 150)\\nscripts/check_accounting_p06.py:135:    observe(\\\"MC10\\\", lambda: admit_uncertainty(admission)[\\\"kind\\\"] == \\\"ExtractionReading\\\")\\nscripts/check_accounting_p06.py:138:    observe(\\\"MC11\\\", lambda: resolve_bullet_debt(debt, query)[\\\"outputs\\\"][\\\"interest\\\"] == Fraction(17, 2))\\nscripts/check_accounting_p06.py:139:    observe(\\\"MC14\\\", lambda: (lambda x: x[\\\"approximation\\\"][\\\"bound\\\"] == \\\"3/2\\\")(resolve_bullet_debt(debt, query, approximation={\\\"target_rate\\\":\\\"0.06\\\",\\\"tolerance\\\":\\\"2\\\",\\\"error_bound\\\":\\\"3/2\\\",\\\"scope\\\":\\\"fixed_rate_interest\\\",\\\"evidence\\\":[\\\"probe\\\"]})))\\nscripts/check_accounting_p06.py:143:def main(argv=None) -> int:\\nscripts/check_accounting_p06.py:171:    payload = {\\\"schema_version\\\":\\\"accdsl.p06.conformance.v1\\\", \\\"passed\\\": bool(passed), \\\"profile\\\":\\\"context-chronology-resolution-v1\\\", \\\"obligation_status\\\":status, \\\"observations\\\":observations, \\\"tests\\\":reports, \\\"protection\\\":protected, \\\"code_stable_during_check\\\":stable, \\\"provenance\\\":{\\\"approved_plan\\\":approved, \\\"phase_entry_inventory\\\":phase_inventory, \\\"execution_inventory\\\":args.execution_inventory}, \\\"hashes\\\":code_after, \\\"manifest\\\":{\\\"git_commit\\\":\\\"unavailable: existing marker is not a usable repository\\\", \\\"command\\\":command, \\\"working_directory\\\":str(ROOT), \\\"executable\\\":sys.executable, \\\"environment\\\":{\\\"python\\\":platform.python_version()}, \\\"hardware\\\":\\\"CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported\\\", \\\"random_seeds\\\":\\\"N/A: exact deterministic fixtures\\\", \\\"data_version\\\":\\\"p06-context-chronology-cases-v1\\\", \\\"started_utc\\\":started_utc, \\\"wall_seconds\\\":round(time.monotonic()-started, 6), \\\"plan\\\":args.approved_plan, \\\"plan_sha256\\\":approved[\\\"sha256\\\"], \\\"approved_plan_hash\\\":approved[\\\"plan_hash\\\"], \\\"execution_inventory\\\":args.execution_inventory, \\\"outputs\\\":OUTPUTS, \\\"result\\\":OUTPUTS[1], \\\"phase_contribution_files\\\":SOURCES + OUTPUTS}, \\\"requirement_coverage\\\":{\\\"MC02\\\":\\\"context-aware mappings and explicit mismatch rejection\\\", \\\"MC05\\\":\\\"finite partition membership and overlap checks\\\", \\\"MC06\\\":\\\"chronology, availability and YTD selection\\\", \\\"MC07\\\":\\\"revision-compatible cumulative subtraction\\\", \\\"MC10\\\":\\\"six category uncertainty admission\\\", \\\"MC11\\\":\\\"query-bound unhedged bullet debt grouping\\\", \\\"MC14\\\":\\\"approximation certificate and error evidence\\\"}, \\\"acceptance\\\":{\\\"engineering\\\":bool(passed), \\\"accounting_validity\\\":\\\"not established\\\", \\\"forecast_validity\\\":\\\"not established\\\", \\\"human_acceptance\\\":\\\"pending\\\", \\\"whole_gap_closure\\\":False}}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '1,166p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '1,166p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"\\\"\\\"\\\"Bounded P06 context, chronology, uncertainty and resolution runtime.\\n\\nThe profile is intentionally explicit: it uses exact ``Fraction`` arithmetic,\\nGregorian half-open periods, finite populations, and a fixed-rate unhedged bullet\\ndebt resolver.  Every rejection has a stable ``P06Error.code``.  This module\\nchecks structural and computational contracts; it does not certify accounting\\neligibility or the truth of retained source evidence.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nfrom dataclasses import dataclass, field\\nfrom datetime import date, datetime, time, timedelta, timezone\\nfrom fractions import Fraction\\nimport hashlib\\nimport json\\nfrom types import MappingProxyType\\nfrom typing import Any, Iterable, Mapping, Sequence\\nfrom zoneinfo import ZoneInfo, ZoneInfoNotFoundError\\n\\n\\nclass P06Error(ValueError):\\n    \\\"\\\"\\\"A rejected P06 operation with a stable diagnostic code.\\\"\\\"\\\"\\n    def __init__(self, code: str, message: str, *, location: str = \\\"\\\"):\\n        self.code, self.location, self.message = code, location, message\\n        suffix = f\\\" at {location}\\\" if location else \\\"\\\"\\n        super().__init__(f\\\"{code}{suffix}: {message}\\\")\\n\\n\\ndef fail(code: str, message: str, location: str = \\\"\\\") -> None:\\n    raise P06Error(code, message, location=location)\\n\\n\\ndef _fraction(value: Any, where: str = \\\"value\\\") -> Fraction:\\n    if isinstance(value, Fraction):\\n        return value\\n    if isinstance(value, bool):\\n        fail(\\\"INVALID_RATIONAL\\\", \\\"boolean is not a scalar\\\", where)\\n    try:\\n        if isinstance(value, int):\\n            return Fraction(value)\\n        if isinstance(value, str):\\n            return Fraction(value)\\n        if isinstance(value, float):\\n            # Floats are rejected to keep exactness explicit.\\n            fail(\\\"INEXACT_RATIONAL\\\", \\\"float input is not accepted\\\", where)\\n        if isinstance(value, Mapping) and set(value) == {\\\"n\\\", \\\"d\\\"}:\\n            q = Fraction(int(value[\\\"n\\\"]), int(value[\\\"d\\\"]))\\n            if int(value[\\\"d\\\"]) <= 0:\\n                fail(\\\"INVALID_RATIONAL\\\", \\\"denominator must be positive\\\", where)\\n            if {\\\"n\\\": str(q.numerator), \\\"d\\\": str(q.denominator)} != {\\n                \\\"n\\\": str(value[\\\"n\\\"]), \\\"d\\\": str(value[\\\"d\\\"])\\n            }:\\n                fail(\\\"NONCANONICAL_RATIONAL\\\", \\\"fraction must be reduced\\\", where)\\n            return q\\n    except (ValueError, ZeroDivisionError) as exc:\\n        fail(\\\"INVALID_RATIONAL\\\", str(exc), where)\\n    fail(\\\"INVALID_RATIONAL\\\", \\\"expected an integer or canonical rational\\\", where)\\n\\n\\ndef _iso_date(value: Any, where: str) -> date:\\n    if not isinstance(value, str):\\n        fail(\\\"INVALID_DATE\\\", \\\"date must be YYYY-MM-DD\\\", where)\\n    try:\\n        parsed = date.fromisoformat(value)\\n    except ValueError as exc:\\n        fail(\\\"INVALID_DATE\\\", str(exc), where)\\n    if parsed.isoformat() != value:\\n        fail(\\\"INVALID_DATE\\\", \\\"noncanonical ISO date\\\", where)\\n    return parsed\\n\\n\\ndef _instant(value: Any, where: str) -> datetime:\\n    if not isinstance(value, str):\\n        fail(\\\"INVALID_TIMESTAMP\\\", \\\"timestamp must be an ISO string\\\", where)\\n    try:\\n        parsed = datetime.fromisoformat(value.replace(\\\"Z\\\", \\\"+00:00\\\"))\\n    except ValueError as exc:\\n        fail(\\\"INVALID_TIMESTAMP\\\", str(exc), where)\\n    if parsed.tzinfo is None:\\n        fail(\\\"MISSING_TIMEZONE\\\", \\\"timestamp requires an explicit timezone\\\", where)\\n    return parsed\\n\\n\\n@dataclass(frozen=True)\\nclass Context:\\n    concept: str\\n    entity: str\\n    perimeter: str\\n    perimeter_version: str\\n    basis: str\\n    measurement: str\\n    unit: str\\n    currency: str\\n    calendar: str\\n    dimensions: tuple[tuple[str, str], ...] = ()\\n    gross_net: str = \\\"gross\\\"\\n    parent: str | None = None\\n    group: str | None = None\\n    scale: Any = None\\n    sign: Any = None\\n    precision: Any = None\\n\\n    @classmethod\\n    def from_dict(cls, row: Mapping[str, Any]) -> \\\"Context\\\":\\n        required = (\\\"concept\\\", \\\"entity\\\", \\\"perimeter\\\", \\\"perimeter_version\\\", \\\"basis\\\",\\n                    \\\"measurement\\\", \\\"unit\\\", \\\"currency\\\", \\\"calendar\\\", \\\"dimensions\\\", \\\"gross_net\\\")\\n        for key in required:\\n            if key not in row:\\n                fail(\\\"MISSING_CONTEXT_FIELD\\\", f\\\"missing {key}\\\", \\\"context\\\")\\n        dims = row[\\\"dimensions\\\"]\\n        if not isinstance(dims, Mapping):\\n            fail(\\\"INVALID_DIMENSIONS\\\", \\\"dimensions must be an object\\\", \\\"context.dimensions\\\")\\n        if any(not isinstance(k, str) or not isinstance(v, str) for k, v in dims.items()):\\n            fail(\\\"INVALID_DIMENSIONS\\\", \\\"dimension keys and values must be strings\\\", \\\"context.dimensions\\\")\\n        if row[\\\"gross_net\\\"] not in {\\\"gross\\\", \\\"net\\\"}:\\n            fail(\\\"INVALID_GROSS_NET\\\", \\\"gross_net must be gross or net\\\", \\\"context.gross_net\\\")\\n        return cls(*(str(row[k]) for k in required[:9]),\\n                   tuple(sorted((str(k), str(v)) for k, v in dims.items())),\\n                   str(row[\\\"gross_net\\\"]), row.get(\\\"parent\\\"), row.get(\\\"group\\\"),\\n                   row.get(\\\"scale\\\"), row.get(\\\"sign\\\"), row.get(\\\"precision\\\"))\\n\\n    def as_dict(self) -> dict[str, Any]:\\n        return {\\n            \\\"concept\\\": self.concept, \\\"entity\\\": self.entity, \\\"perimeter\\\": self.perimeter,\\n            \\\"perimeter_version\\\": self.perimeter_version, \\\"basis\\\": self.basis,\\n            \\\"measurement\\\": self.measurement, \\\"unit\\\": self.unit, \\\"currency\\\": self.currency,\\n            \\\"calendar\\\": self.calendar, \\\"dimensions\\\": dict(self.dimensions),\\n            \\\"gross_net\\\": self.gross_net, \\\"parent\\\": self.parent, \\\"group\\\": self.group,\\n            \\\"scale\\\": self.scale, \\\"sign\\\": self.sign, \\\"precision\\\": self.precision,\\n        }\\n\\n\\n@dataclass(frozen=True)\\nclass MappingRule:\\n    source_concept: str\\n    target_concept: str\\n    kind: str = \\\"equivalent\\\"\\n    source_context: str | None = None\\n    target_context: str | None = None\\n    effective_start: date | None = None\\n    effective_end: date | None = None\\n    conversion: str | None = None\\n    provenance: tuple[str, ...] = ()\\n\\n    @classmethod\\n    def from_dict(cls, row: Mapping[str, Any]) -> \\\"MappingRule\\\":\\n        if not row.get(\\\"provenance\\\"):\\n            fail(\\\"MAPPING_PROVENANCE_REQUIRED\\\", \\\"mapping provenance is required\\\", \\\"mapping\\\")\\n        start = _iso_date(row[\\\"effective_start\\\"], \\\"mapping.effective_start\\\") if row.get(\\\"effective_start\\\") else None\\n        end = _iso_date(row[\\\"effective_end\\\"], \\\"mapping.effective_end\\\") if row.get(\\\"effective_end\\\") else None\\n        if start and end and end <= start:\\n            fail(\\\"INVALID_MAPPING_WINDOW\\\", \\\"effective end must follow start\\\", \\\"mapping\\\")\\n        kind = row.get(\\\"kind\\\", \\\"equivalent\\\")\\n        if kind not in {\\\"equivalent\\\", \\\"component\\\", \\\"reclassification\\\"}:\\n            fail(\\\"UNSUPPORTED_MAPPING\\\", f\\\"unsupported mapping kind {kind}\\\", \\\"mapping\\\")\\n        return cls(str(row[\\\"source_concept\\\"]), str(row[\\\"target_concept\\\"]), kind,\\n                   row.get(\\\"source_context\\\"), row.get(\\\"target_context\\\"), start, end,\\n                   row.get(\\\"conversion\\\"), tuple(str(x) for x in row[\\\"provenance\\\"]))\\n\\n    def active(self, when: date | None) -> bool:\\n        if when is None:\\n            return self.effective_start is None and self.effective_end is None\\n        return ((self.effective_start is None or when >= self.effective_start) and\\n                (self.effective_end is None or when < self.effective_end))\\n\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'cat AGENTS.md'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'cat AGENTS.md'\",\"aggregated_output\":\"# AccDSL project instructions\\n\\n## Mission entry point\\n\\nBefore substantive work in this project, read:\\n\\n1. [Mission control](MISSION_CONTROL.md).\\n2. [Requirements and acceptance evidence](docs/plans/accounting-mission-requirements.md).\\n3. [Current checkpoint](docs/plans/accounting-product-design-checkpoint.md).\\n4. The gap records relevant to the task:\\n   [initial audit](docs/design/review/gap-audit-2026-10-02.md) and\\n   [expanded mission audit](docs/design/review/mission-gap-audit-2026-10-02.md).\\n5. For the authorised master-program work, read the\\n   [master checkpoint](docs/plans/accounting-master-checkpoint.md), executable\\n   phase catalog and current `data/accounting-master/next-plan.md`. The older\\n   corpus checkpoint remains historical evidence; current phase execution is\\n   recorded by the master without rewriting frozen release hashes.\\n\\nThe mission preserves the user's goals across sessions. Current user directions\\nand higher-priority instructions still control. Local documents must not be\\nused to request fresh permission for work already authorised by the user.\\n\\n## Working rules\\n\\n- Identify the MC requirements addressed by each nontrivial plan or work unit.\\n  Audit the plan before implementation, experiments or long diagnostics.\\n- Preserve the full goals while staging execution. A small financing demo,\\n  clean PDF build or six populated research ledgers cannot close requirements\\n  for whole-company representation, research quality or implementation detail.\\n- Distinguish direct user requirements, policy requirements and derived\\n  engineering choices. Do not silently convert a convenient library, model\\n  assumption or stage boundary into an immutable product requirement.\\n- Keep source evidence, interpretations, assumptions, joint history families\\n  and scenario-specific results separate and traceable. Preserve unknowns;\\n  do not invent facts, probabilities, accounting compliance or completeness.\\n- Close gaps with the specified evidence, and update the requirements register\\n  and checkpoint after meaningful changes. Add newly discovered gaps rather\\n  than treating the current list as exhaustive.\\n- Follow the applicable policies under\\n  `/home/chakwong/python/claudecodex/policies`. Preserve unrelated work and the\\n  original paper collection. The existing `.git` marker is not a usable\\n  repository; do not initialise or commit merely to create provenance.\\n- Keep operational mission/checklist material out of the reader-facing\\n  scholarly narrative unless it serves a real implementation-reference purpose.\\n- Apply MC35, the user's internal-preparation-before-paid-review requirement.\\n  Finish feasible source research, facts, calculations, software checks and\\n  document repairs before referring a specific question to a professional.\\n  Supply a proposed answer, exact sources, competing interpretation and checked\\n  consequences. Keep unfinished internal work on the internal queue; “human\\n  review pending” is an acceptance status, not a reason to stop that work.\\n  Ordinary reader feedback need not be purchased from an accounting firm.\\n  No professional engagement, outreach or fees are authorised by this policy.\\n  See `docs/design/review/internal-before-expert.md` and the current checkpoint.\\n\\nThe current manuscript is specification-incomplete. Read the checkpoint and\\nrequirements before resuming from an older note that says only final review\\nremains. This file authorises no autonomous background campaign or external\\npublication; it directs work undertaken under the user's active instructions.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '321,419p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '167,320p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '321,419p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"def select_evidence(assertions: Sequence[Mapping[str, Any]], cutoff: str | datetime | date, *,\\n                    mode: str = \\\"latest_available\\\", system_as_of: str | datetime | date | None = None,\\n                    timezone_name: str | None = None, date_only_policy: str | None = None,\\n                    harmonisations: Sequence[Mapping[str, Any]] = ()) -> dict[str, Any]:\\n    rows = _validate_assertions(assertions)\\n    if mode not in {\\\"original\\\", \\\"latest_available\\\", \\\"harmonised\\\"}:\\n        fail(\\\"UNSUPPORTED_EVIDENCE_VIEW\\\", mode, \\\"mode\\\")\\n    if isinstance(cutoff, datetime):\\n        cut = cutoff if cutoff.tzinfo else fail(\\\"MISSING_TIMEZONE\\\", \\\"cutoff requires timezone\\\", \\\"cutoff\\\")\\n    else:\\n        cut = _availability(cutoff, timezone_name=timezone_name, date_only_policy=date_only_policy, where=\\\"cutoff\\\")\\n    asof = None\\n    if system_as_of is not None:\\n        asof = system_as_of if isinstance(system_as_of, datetime) else _availability(system_as_of, timezone_name=timezone_name, date_only_policy=date_only_policy, where=\\\"system_as_of\\\")\\n    eligible = []\\n    unresolved = []\\n    for row in assertions:\\n        if row.get(\\\"available\\\") in (None, \\\"unknown\\\", \\\"not_established\\\"):\\n            unresolved.append({\\\"id\\\": row[\\\"id\\\"], \\\"reason\\\": \\\"source_availability_unestablished\\\"})\\n            continue\\n        try:\\n            available = _availability(row[\\\"available\\\"], timezone_name=timezone_name, date_only_policy=date_only_policy, where=f\\\"{row['id']}.available\\\")\\n            ingested = _availability(row.get(\\\"ingested\\\", row[\\\"available\\\"]), timezone_name=timezone_name, date_only_policy=date_only_policy, where=f\\\"{row['id']}.ingested\\\")\\n        except P06Error:\\n            raise\\n        if available <= cut and (asof is None or ingested <= asof):\\n            eligible.append(row)\\n        if row.get(\\\"historical_byte_vintage\\\") in {\\\"not_established_by_this_inventory\\\", \\\"unknown\\\"}:\\n            unresolved.append({\\\"id\\\": row[\\\"id\\\"], \\\"reason\\\": \\\"historical_byte_vintage_unestablished\\\"})\\n    eligible_ids = {x[\\\"id\\\"] for x in eligible}\\n    if mode == \\\"original\\\":\\n        selected = [x for x in eligible if not any(parent in eligible_ids for parent in x.get(\\\"supersedes\\\", []))]\\n        # Roots are the first available assertions in a lineage: remove rows that supersede them.\\n        selected = [x for x in selected if not x.get(\\\"supersedes\\\")]\\n    else:\\n        superseded = {parent for x in eligible for parent in x.get(\\\"supersedes\\\", [])}\\n        selected = [x for x in eligible if x[\\\"id\\\"] not in superseded]\\n    transformations = []\\n    if mode == \\\"harmonised\\\":\\n        for h in harmonisations:\\n            source = h.get(\\\"source_id\\\")\\n            if source not in {x[\\\"id\\\"] for x in selected}:\\n                continue\\n            if h.get(\\\"review_decision\\\") != \\\"Accept\\\" or not h.get(\\\"provenance\\\"):\\n                fail(\\\"HARMONISATION_NOT_REVIEWED\\\", \\\"harmonisation requires accepted review and provenance\\\", str(source))\\n            if h.get(\\\"changes_basis\\\") or h.get(\\\"changes_measurement\\\"):\\n                fail(\\\"HARMONISATION_CONTEXT_CHANGE\\\", \\\"harmonisation cannot replace basis or measurement\\\", str(source))\\n            transformations.append({\\\"source_id\\\": source, \\\"target_id\\\": h.get(\\\"target_id\\\", source), \\\"provenance\\\": list(h[\\\"provenance\\\"])})\\n    return {\\\"mode\\\": mode, \\\"cutoff\\\": str(cutoff), \\\"selected\\\": [dict(x) for x in selected],\\n            \\\"selected_ids\\\": [x[\\\"id\\\"] for x in selected], \\\"eligible_ids\\\": sorted(eligible_ids),\\n            \\\"unresolved\\\": unresolved, \\\"transformations\\\": transformations}\\n\\n\\ndef _row_context(row: Mapping[str, Any]) -> str:\\n    return json.dumps(row.get(\\\"context\\\", {}), sort_keys=True, separators=(\\\",\\\", \\\":\\\"))\\n\\n\\ndef subtract_cumulative(total: Mapping[str, Any], earlier: Mapping[str, Any], *,\\n                        revision_compatibility: Mapping[str, Any] | None = None) -> dict[str, Any]:\\n    for label, row in ((\\\"total\\\", total), (\\\"earlier\\\", earlier)):\\n        if row.get(\\\"kind\\\") != \\\"cumulative\\\":\\n            fail(\\\"YTD_REQUIRES_CUMULATIVE\\\", f\\\"{label} must be cumulative\\\", label)\\n        if row.get(\\\"period\\\", {}).get(\\\"end\\\") is None:\\n            fail(\\\"INVALID_PERIOD\\\", \\\"cumulative period requires exclusive end\\\", label)\\n    if total.get(\\\"concept\\\") != earlier.get(\\\"concept\\\"):\\n        fail(\\\"CONCEPT_MISMATCH\\\", \\\"flow concepts differ\\\", \\\"ytd\\\")\\n    if _row_context(total) != _row_context(earlier):\\n        fail(\\\"CONTEXT_MISMATCH\\\", \\\"cumulative contexts differ\\\", \\\"ytd\\\")\\n    if total.get(\\\"calendar\\\") != earlier.get(\\\"calendar\\\"):\\n        fail(\\\"CALENDAR_MISMATCH\\\", \\\"calendars differ\\\", \\\"ytd\\\")\\n    tp, ep = total[\\\"period\\\"], earlier[\\\"period\\\"]\\n    if tp.get(\\\"start\\\") != ep.get(\\\"start\\\"):\\n        fail(\\\"PERIOD_START_MISMATCH\\\", \\\"cumulative periods must share a start\\\", \\\"ytd\\\")\\n    tend, eend = _iso_date(tp[\\\"end\\\"], \\\"total.period.end\\\"), _iso_date(ep[\\\"end\\\"], \\\"earlier.period.end\\\")\\n    if eend >= tend:\\n        fail(\\\"NONNESTED_PERIOD\\\", \\\"earlier period must end before total\\\", \\\"ytd\\\")\\n    tstart = _iso_date(tp[\\\"start\\\"], \\\"total.period.start\\\")\\n    if _iso_date(ep[\\\"start\\\"], \\\"earlier.period.start\\\") != tstart:\\n        fail(\\\"PERIOD_START_MISMATCH\\\", \\\"period starts differ\\\", \\\"ytd\\\")\\n    tr = total.get(\\\"revision_id\\\"); er = earlier.get(\\\"revision_id\\\")\\n    if not tr or not er:\\n        allowed = revision_compatibility and revision_compatibility.get(\\\"accepted\\\")\\n        if not allowed or not revision_compatibility.get(\\\"scope\\\") or not revision_compatibility.get(\\\"evidence\\\"):\\n            fail(\\\"REVISION_UNKNOWN\\\", \\\"subtraction requires explicit revision identities or a reviewed scoped exception\\\", \\\"ytd\\\")\\n    if tr != er:\\n        allowed = revision_compatibility and revision_compatibility.get(\\\"accepted\\\")\\n        if not allowed or not revision_compatibility.get(\\\"scope\\\") or not revision_compatibility.get(\\\"evidence\\\"):\\n            fail(\\\"REVISION_INCOMPATIBLE\\\", \\\"subtraction requires a common revision or reviewed scoped exception\\\", \\\"ytd\\\")\\n    amount = _fraction(total[\\\"amount\\\"], \\\"total.amount\\\") - _fraction(earlier[\\\"amount\\\"], \\\"earlier.amount\\\")\\n    return {\\\"kind\\\": \\\"flow\\\", \\\"amount\\\": amount, \\\"period\\\": {\\\"start\\\": ep[\\\"end\\\"], \\\"end\\\": tp[\\\"end\\\"]},\\n            \\\"concept\\\": total[\\\"concept\\\"], \\\"context\\\": total.get(\\\"context\\\"), \\\"calendar\\\": total[\\\"calendar\\\"],\\n            \\\"provenance\\\": {\\\"operation\\\": \\\"cumulative_subtraction\\\", \\\"total_id\\\": total.get(\\\"id\\\"), \\\"earlier_id\\\": earlier.get(\\\"id\\\"),\\n                           \\\"revision_id\\\": tr or er}}\\n\\n\\n_SUPPORTED_MEASUREMENT_METHODS = {\\\"direct\\\", \\\"discounted_cash_flow\\\", \\\"observable_input\\\"}\\n_SUPPORTED_MEASURES = {\\\"real_world\\\", \\\"pricing\\\"}\\n\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '167,320p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"def _context_mismatch(a: Context, b: Context) -> tuple[str, str] | None:\\n    fields = (\\\"entity\\\", \\\"perimeter\\\", \\\"perimeter_version\\\", \\\"basis\\\", \\\"measurement\\\", \\\"unit\\\",\\n              \\\"currency\\\", \\\"calendar\\\", \\\"dimensions\\\", \\\"gross_net\\\", \\\"parent\\\", \\\"group\\\",\\n              \\\"scale\\\", \\\"sign\\\", \\\"precision\\\")\\n    for field_name in fields:\\n        if getattr(a, field_name) != getattr(b, field_name):\\n            return field_name, getattr(a, field_name).__repr__() + \\\" != \\\" + getattr(b, field_name).__repr__()\\n    if a.concept != b.concept:\\n        return \\\"concept\\\", repr(a.concept) + \\\" != \\\" + repr(b.concept)\\n    return None\\n\\n\\ndef _check_mapping_graph(rules: Sequence[MappingRule]) -> None:\\n    graph: dict[str, set[str]] = {}\\n    for rule in rules:\\n        graph.setdefault(rule.source_concept, set()).add(rule.target_concept)\\n    state: dict[str, int] = {}\\n    def visit(node: str) -> None:\\n        state[node] = 1\\n        for nxt in graph.get(node, ()):\\n            if state.get(nxt) == 1:\\n                fail(\\\"MAPPING_CYCLE\\\", \\\"mapping graph contains a cycle\\\", node)\\n            if state.get(nxt) != 2:\\n                visit(nxt)\\n        state[node] = 2\\n    for node in graph:\\n        if state.get(node, 0) == 0:\\n            visit(node)\\n\\n\\ndef compatible_context(source: Context | Mapping[str, Any], target: Context | Mapping[str, Any],\\n                       rules: Sequence[MappingRule | Mapping[str, Any]] = (),\\n                       *, at: str | date | None = None) -> dict[str, Any]:\\n    \\\"\\\"\\\"Return a mapping witness or reject a context mismatch.\\\"\\\"\\\"\\n    a = source if isinstance(source, Context) else Context.from_dict(source)\\n    b = target if isinstance(target, Context) else Context.from_dict(target)\\n    when = _iso_date(at, \\\"mapping.at\\\") if isinstance(at, str) else at\\n    parsed = [x if isinstance(x, MappingRule) else MappingRule.from_dict(x) for x in rules]\\n    _check_mapping_graph(parsed)\\n    mismatch = _context_mismatch(a, b)\\n    if mismatch is None:\\n        return {\\\"status\\\": \\\"compatible\\\", \\\"kind\\\": \\\"identity\\\", \\\"source\\\": a.as_dict(), \\\"target\\\": b.as_dict()}\\n    field_name, detail = mismatch\\n    if field_name == \\\"concept\\\":\\n        eligible = [r for r in parsed if r.source_concept == a.concept and r.target_concept == b.concept and r.active(when)]\\n        if not eligible:\\n            fail(\\\"CONTEXT_MISMATCH\\\", f\\\"concept mismatch {detail} requires an explicit active mapping\\\", field_name)\\n        rule = eligible[0]\\n        if rule.kind == \\\"equivalent\\\" and (rule.conversion or \\\"\\\") not in {\\\"\\\", \\\"none\\\"}:\\n            fail(\\\"UNSUPPORTED_MEASUREMENT_CONVERSION\\\", \\\"equivalent mapping cannot convert measurements\\\", field_name)\\n        if rule.source_context and rule.source_context != a.entity:\\n            fail(\\\"MAPPING_SOURCE_CONTEXT_MISMATCH\\\", \\\"mapping source context does not match\\\", field_name)\\n        if rule.target_context and rule.target_context != b.entity:\\n            fail(\\\"MAPPING_TARGET_CONTEXT_MISMATCH\\\", \\\"mapping target context does not match\\\", field_name)\\n        return {\\\"status\\\": \\\"compatible\\\", \\\"kind\\\": rule.kind, \\\"source\\\": a.as_dict(), \\\"target\\\": b.as_dict(),\\n                \\\"provenance\\\": list(rule.provenance)}\\n    codes = {\\\"perimeter\\\": \\\"PARENT_GROUP_MISMATCH\\\", \\\"perimeter_version\\\": \\\"PERIMETER_VERSION_MISMATCH\\\",\\n             \\\"basis\\\": \\\"BASIS_MISMATCH\\\", \\\"measurement\\\": \\\"MEASUREMENT_MISMATCH\\\", \\\"currency\\\": \\\"CURRENCY_MISMATCH\\\",\\n             \\\"calendar\\\": \\\"CALENDAR_MISMATCH\\\", \\\"gross_net\\\": \\\"GROSS_NET_MISMATCH\\\", \\\"dimensions\\\": \\\"DIMENSION_MISMATCH\\\",\\n             \\\"scale\\\": \\\"UNSUPPORTED_MEASUREMENT_CONVERSION\\\", \\\"sign\\\": \\\"DISPLAY_METADATA_MISMATCH\\\", \\\"precision\\\": \\\"DISPLAY_METADATA_MISMATCH\\\",\\n             \\\"entity\\\": \\\"ENTITY_MISMATCH\\\", \\\"unit\\\": \\\"UNIT_MISMATCH\\\", \\\"parent\\\": \\\"PARENT_GROUP_MISMATCH\\\", \\\"group\\\": \\\"PARENT_GROUP_MISMATCH\\\"}\\n    fail(codes.get(field_name, \\\"CONTEXT_MISMATCH\\\"), f\\\"context field mismatch: {detail}\\\", field_name)\\n\\n\\ndef map_context(source: Context | Mapping[str, Any], target: Context | Mapping[str, Any],\\n                rules: Sequence[MappingRule | Mapping[str, Any]] = (), *, at: str | date | None = None) -> dict[str, Any]:\\n    return compatible_context(source, target, rules, at=at)\\n\\n\\ndef check_partition(population: Iterable[str], members: Mapping[str, Iterable[str]], *,\\n                    residual: Mapping[str, Any] | None = None, axis: str = \\\"\\\") -> dict[str, Any]:\\n    pop = list(population)\\n    if len(pop) != len(set(pop)):\\n        fail(\\\"DUPLICATE_POPULATION\\\", \\\"population identifiers must be unique\\\", axis)\\n    universe = set(pop)\\n    seen: dict[str, str] = {}\\n    normalized: dict[str, list[str]] = {}\\n    for label, values in members.items():\\n        vals = list(values)\\n        if len(vals) != len(set(vals)):\\n            fail(\\\"DUPLICATE_MEMBER\\\", f\\\"member repeated in {label}\\\", axis)\\n        unknown = set(vals) - universe\\n        if unknown:\\n            fail(\\\"UNKNOWN_MEMBER\\\", f\\\"members outside population: {sorted(unknown)}\\\", axis)\\n        for value in vals:\\n            if value in seen:\\n                fail(\\\"OVERLAPPING_PARTITION\\\", f\\\"{value} occurs in {seen[value]} and {label}\\\", axis)\\n            seen[value] = label\\n        normalized[label] = vals\\n    missing = universe - set(seen)\\n    if missing:\\n        if not residual:\\n            fail(\\\"INCOMPLETE_PARTITION\\\", f\\\"uncovered members: {sorted(missing)}\\\", axis)\\n        residual_values = set(residual.get(\\\"members\\\", ()))\\n        if residual_values != missing:\\n            fail(\\\"INVALID_RESIDUAL\\\", \\\"residual must identify exactly uncovered members\\\", axis)\\n        if not residual.get(\\\"known\\\", False):\\n            fail(\\\"UNKNOWN_RESIDUAL\\\", \\\"unknown residual cannot yield an exact total\\\", axis)\\n    if residual and set(residual.get(\\\"members\\\", ())) & set(seen):\\n        fail(\\\"OVERLAPPING_PARTITION\\\", \\\"residual overlaps a named member\\\", axis)\\n    return {\\\"status\\\": \\\"partitioned\\\", \\\"axis\\\": axis, \\\"population\\\": pop, \\\"members\\\": normalized,\\n            \\\"residual\\\": dict(residual) if residual else None, \\\"covered\\\": len(seen), \\\"complete\\\": not missing}\\n\\n\\ndef _availability(value: Any, *, timezone_name: str | None, date_only_policy: str | None, where: str) -> datetime:\\n    if isinstance(value, datetime):\\n        if value.tzinfo is None:\\n            fail(\\\"MISSING_TIMEZONE\\\", \\\"timestamp requires timezone\\\", where)\\n        return value\\n    if isinstance(value, date):\\n        value = value.isoformat()\\n    if not isinstance(value, str):\\n        fail(\\\"INVALID_AVAILABILITY\\\", \\\"availability must be date or timestamp\\\", where)\\n    if \\\"T\\\" in value or \\\" \\\" in value:\\n        return _instant(value, where)\\n    d = _iso_date(value, where)\\n    if date_only_policy != \\\"next_local_midnight\\\":\\n        fail(\\\"DATE_ONLY_POLICY_REQUIRED\\\", \\\"date-only availability requires next_local_midnight\\\", where)\\n    if not timezone_name:\\n        fail(\\\"TIMEZONE_REQUIRED\\\", \\\"named timezone required for date-only availability\\\", where)\\n    try:\\n        zone = ZoneInfo(timezone_name)\\n    except ZoneInfoNotFoundError:\\n        fail(\\\"UNKNOWN_TIMEZONE\\\", timezone_name, where)\\n    return datetime.combine(d + timedelta(days=1), time.min, zone)\\n\\n\\ndef _validate_assertions(assertions: Sequence[Mapping[str, Any]]) -> dict[str, Mapping[str, Any]]:\\n    rows = {str(a.get(\\\"id\\\")): a for a in assertions}\\n    if len(rows) != len(assertions) or None in rows:\\n        fail(\\\"DUPLICATE_ASSERTION\\\", \\\"assertion identifiers must be unique\\\", \\\"assertions\\\")\\n    for row in assertions:\\n        if not row.get(\\\"source\\\"):\\n            fail(\\\"MISSING_SOURCE\\\", \\\"assertion source is required\\\", str(row.get(\\\"id\\\")))\\n        for parent in row.get(\\\"supersedes\\\", []):\\n            if parent not in rows:\\n                fail(\\\"DANGLING_SUPERSESSION\\\", f\\\"unknown superseded assertion {parent}\\\", str(row.get(\\\"id\\\")))\\n            if parent == row[\\\"id\\\"]:\\n                fail(\\\"SUPERSESSION_CYCLE\\\", \\\"assertion cannot supersede itself\\\", str(row[\\\"id\\\"]))\\n    state: dict[str, int] = {}\\n    def visit(key: str) -> None:\\n        state[key] = 1\\n        for parent in rows[key].get(\\\"supersedes\\\", []):\\n            if state.get(parent) == 1:\\n                fail(\\\"SUPERSESSION_CYCLE\\\", \\\"supersession graph contains a cycle\\\", key)\\n            if state.get(parent) != 2:\\n                visit(parent)\\n        state[key] = 2\\n    for key in rows:\\n        if state.get(key, 0) == 0:\\n            visit(key)\\n    return rows\\n\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '420,548p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '549,677p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '549,677p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"def resolve_bullet_debt(constituents: Sequence[DebtConstituent | Mapping[str, Any]], query: Mapping[str, Any], *,\\n                       previous: Mapping[str, Any] | None = None,\\n                       approximation: Mapping[str, Any] | None = None) -> dict[str, Any]:\\n    rows = [x if isinstance(x, DebtConstituent) else DebtConstituent.from_dict(x) for x in constituents]\\n    if not rows:\\n        fail(\\\"EMPTY_DEBT_SET\\\", \\\"at least one constituent is required\\\", \\\"debt\\\")\\n    required = (\\\"contract\\\", \\\"context\\\", \\\"evidence_view\\\", \\\"horizon\\\", \\\"scenario\\\", \\\"requested_outputs\\\", \\\"accrual_convention\\\", \\\"group_by\\\")\\n    for key in required:\\n        if key not in query:\\n            fail(\\\"MISSING_QUERY_FIELD\\\", f\\\"missing {key}\\\", \\\"query\\\")\\n    signature = _query_signature(query)\\n    if previous is not None and previous.get(\\\"query_signature\\\") != signature:\\n        fail(\\\"STALE_RESULT\\\", \\\"query changed; grouping sufficiency must be revalidated\\\", \\\"query\\\")\\n    horizon = _fraction(query[\\\"horizon\\\"], \\\"query.horizon\\\")\\n    if horizon < 0:\\n        fail(\\\"INVALID_HORIZON\\\", \\\"horizon must be nonnegative\\\", \\\"query.horizon\\\")\\n    if query[\\\"scenario\\\"] not in {\\\"base\\\", \\\"announced_stress\\\"}:\\n        fail(\\\"UNSUPPORTED_SCENARIO\\\", str(query[\\\"scenario\\\"]), \\\"query.scenario\\\")\\n    if query[\\\"accrual_convention\\\"] != \\\"simple_actual_fraction\\\":\\n        fail(\\\"UNSUPPORTED_ACCRUAL\\\", str(query[\\\"accrual_convention\\\"]), \\\"query.accrual_convention\\\")\\n    if not isinstance(query[\\\"requested_outputs\\\"], list) or not query[\\\"requested_outputs\\\"]:\\n        fail(\\\"MISSING_OUTPUT_REQUEST\\\", \\\"requested_outputs must be nonempty\\\", \\\"query\\\")\\n    unsupported_outputs = set(query[\\\"requested_outputs\\\"]) - {\\\"interest\\\", \\\"principal\\\"}\\n    if unsupported_outputs:\\n        fail(\\\"UNSUPPORTED_OUTPUT\\\", f\\\"unsupported outputs: {sorted(unsupported_outputs)}\\\", \\\"query.requested_outputs\\\")\\n    dimensions = (\\\"rate\\\", \\\"maturity\\\", \\\"reset\\\", \\\"hedge\\\")\\n    group_by = set(query[\\\"group_by\\\"])\\n    if not group_by <= set(dimensions):\\n        fail(\\\"UNSUPPORTED_GROUP_DIMENSION\\\", \\\"group_by contains unsupported dimension\\\", \\\"query.group_by\\\")\\n    for dim in dimensions:\\n        values = {getattr(c, dim) for c in rows}\\n        if len(values) > 1 and dim not in group_by:\\n            fail(\\\"GROUPING_INSUFFICIENT\\\", f\\\"dimension {dim} varies but is not grouped\\\", \\\"query.group_by\\\")\\n    for c in rows:\\n        if c.hedge != \\\"unhedged\\\":\\n            fail(\\\"HEDGED_DEBT_UNSUPPORTED\\\", \\\"only unhedged debt is supported\\\", c.id)\\n        if c.reset != \\\"fixed\\\":\\n            fail(\\\"RESET_UNSUPPORTED\\\", \\\"only fixed reset is supported\\\", c.id)\\n        if c.maturity < horizon:\\n            fail(\\\"MATURITY_CROSSING\\\", \\\"maturity crosses the requested horizon\\\", c.id)\\n    groups: dict[tuple[Any, ...], list[DebtConstituent]] = {}\\n    for c in rows:\\n        key = tuple(getattr(c, dim) if dim in group_by else \\\"homogeneous\\\" for dim in dimensions)\\n        groups.setdefault(key, []).append(c)\\n    output: dict[str, Any] = {}\\n    if \\\"interest\\\" in query[\\\"requested_outputs\\\"]:\\n        output[\\\"interest\\\"] = sum((c.principal * c.rate * horizon for c in rows), Fraction())\\n    if \\\"principal\\\" in query[\\\"requested_outputs\\\"]:\\n        output[\\\"principal\\\"] = sum((c.principal for c in rows), Fraction())\\n    result = {\\\"status\\\": \\\"resolved\\\", \\\"query_signature\\\": signature,\\n              \\\"query\\\": json.loads(json.dumps(query, default=str)), \\\"groups\\\": [\\n                  {\\\"key\\\": [str(x) for x in key], \\\"constituent_ids\\\": [c.id for c in members],\\n                   \\\"principal\\\": sum((c.principal for c in members), Fraction()),\\n                   \\\"interest\\\": sum((c.principal * c.rate * horizon for c in members), Fraction())}\\n                  for key, members in groups.items()],\\n              \\\"outputs\\\": output, \\\"constituent_ids\\\": [c.id for c in rows], \\\"fresh\\\": True}\\n    if approximation is not None:\\n        if not approximation.get(\\\"scope\\\") or approximation.get(\\\"scope\\\") != \\\"fixed_rate_interest\\\" or not approximation.get(\\\"evidence\\\"):\\n            fail(\\\"APPROXIMATION_EVIDENCE_REQUIRED\\\", \\\"declared scope and evidence are required\\\", \\\"approximation\\\")\\n        cert = interest_certificate(rows, approximation.get(\\\"target_rate\\\"), horizon)\\n        tolerance = _fraction(approximation.get(\\\"tolerance\\\"), \\\"approximation.tolerance\\\")\\n        declared = _fraction(approximation.get(\\\"error_bound\\\"), \\\"approximation.error_bound\\\")\\n        if tolerance < 0 or declared < cert[\\\"error\\\"] or declared > tolerance or declared < cert[\\\"bound\\\"]:\\n            fail(\\\"APPROXIMATION_BOUND_INVALID\\\", \\\"declared bound must cover exact error and certificate within tolerance\\\", \\\"approximation\\\")\\n        result[\\\"approximation\\\"] = {k: str(v) for k, v in cert.items()} | {\\\"tolerance\\\": str(tolerance), \\\"declared_error_bound\\\": str(declared)}\\n    return result\\n\\n\\n@dataclass\\nclass P06Engine:\\n    contexts: dict[str, Context] = field(default_factory=dict)\\n    mappings: list[MappingRule] = field(default_factory=list)\\n    assertions: list[dict[str, Any]] = field(default_factory=list)\\n    uncertainty: dict[str, dict[str, Any]] = field(default_factory=dict)\\n    current_results: dict[str, dict[str, Any]] = field(default_factory=dict)\\n    preserved_results: dict[str, dict[str, Any]] = field(default_factory=dict)\\n\\n    def add_context(self, identifier: str, context: Context | Mapping[str, Any]) -> None:\\n        if identifier in self.contexts:\\n            fail(\\\"DUPLICATE_CONTEXT\\\", identifier, identifier)\\n        self.contexts[identifier] = context if isinstance(context, Context) else Context.from_dict(context)\\n\\n    def add_mapping(self, rule: MappingRule | Mapping[str, Any]) -> None:\\n        self.mappings.append(rule if isinstance(rule, MappingRule) else MappingRule.from_dict(rule))\\n        _check_mapping_graph(self.mappings)\\n\\n    def add_assertion(self, row: Mapping[str, Any]) -> None:\\n        self.assertions.append(dict(row))\\n        _validate_assertions(self.assertions)\\n\\n    def revise(self, assertion_id: str, replacement: Mapping[str, Any]) -> None:\\n        rows = {x[\\\"id\\\"]: x for x in self.assertions}\\n        if assertion_id not in rows:\\n            fail(\\\"UNKNOWN_ASSERTION\\\", assertion_id, \\\"revision\\\")\\n        replacement = dict(replacement)\\n        replacement.setdefault(\\\"supersedes\\\", [assertion_id])\\n        self.assertions = [replacement if x[\\\"id\\\"] == replacement[\\\"id\\\"] else x for x in self.assertions] + ([] if replacement[\\\"id\\\"] in rows else [replacement])\\n        _validate_assertions(self.assertions)\\n        self.current_results.clear()\\n\\n    def preserve_result(self, result_id: str = \\\"current\\\") -> dict[str, Any]:\\n        \\\"\\\"\\\"Retain an earlier result view while current evidence is revised.\\\"\\\"\\\"\\n        if result_id not in self.current_results:\\n            fail(\\\"UNKNOWN_RESULT\\\", result_id, \\\"preserve_result\\\")\\n        self.preserved_results[result_id] = self.current_results[result_id]\\n        return self.preserved_results[result_id]\\n\\n    def evaluate(self, request: Mapping[str, Any]) -> dict[str, Any]:\\n        evidence = select_evidence(self.assertions, request[\\\"cutoff\\\"], mode=request.get(\\\"evidence_view\\\", \\\"latest_available\\\"),\\n                                   system_as_of=request.get(\\\"system_as_of\\\"), timezone_name=request.get(\\\"timezone\\\"),\\n                                   date_only_policy=request.get(\\\"date_only_policy\\\"), harmonisations=request.get(\\\"harmonisations\\\", ()))\\n        source_context = self.contexts[request[\\\"source_context\\\"]]\\n        target_context = self.contexts[request[\\\"target_context\\\"]]\\n        mapping = compatible_context(source_context, target_context, self.mappings, at=request.get(\\\"as_of\\\"))\\n        admitted = []\\n        for row in request.get(\\\"uncertainty\\\", ()):\\n            admitted.append(admit_uncertainty(row, known_records=self.uncertainty))\\n            self.uncertainty[row[\\\"id\\\"]] = admitted[-1]\\n        resolution = resolve_bullet_debt(request[\\\"constituents\\\"], request[\\\"query\\\"], approximation=request.get(\\\"approximation\\\"))\\n        result = {\\\"evidence\\\": evidence, \\\"mapping\\\": mapping, \\\"uncertainty\\\": admitted, \\\"resolution\\\": resolution,\\n                  \\\"input_sha256\\\": hashlib.sha256(json.dumps(request, sort_keys=True, default=str).encode()).hexdigest()}\\n        key = request.get(\\\"result_id\\\", \\\"current\\\")\\n        self.current_results[key] = result\\n        return result\\n\\n\\n__all__ = [\\\"P06Error\\\", \\\"Context\\\", \\\"MappingRule\\\", \\\"compatible_context\\\", \\\"map_context\\\", \\\"check_partition\\\",\\n           \\\"select_evidence\\\", \\\"subtract_cumulative\\\", \\\"admit_uncertainty\\\", \\\"guard_information_view\\\",\\n           \\\"DebtConstituent\\\", \\\"interest_certificate\\\", \\\"resolve_bullet_debt\\\", \\\"P06Engine\\\"]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '420,548p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"def _validate_joint_law(law: Any, where: str) -> list[dict[str, Any]]:\\n    atoms = law.get(\\\"atoms\\\") if isinstance(law, Mapping) else law\\n    if not isinstance(atoms, list) or not atoms:\\n        fail(\\\"INVALID_JOINT_LAW\\\", \\\"finite joint law needs atoms\\\", where)\\n    ids = [a.get(\\\"id\\\") for a in atoms]\\n    if any(not isinstance(x, str) for x in ids) or len(ids) != len(set(ids)):\\n        fail(\\\"INVALID_JOINT_LAW\\\", \\\"atom IDs must be distinct\\\", where)\\n    hypotheses = [a.get(\\\"hypothesis\\\") for a in atoms]\\n    if any(not isinstance(h, Mapping) or not h or any(isinstance(v, (Mapping, list, tuple)) for v in h.values()) for h in hypotheses):\\n        fail(\\\"INVALID_JOINT_LAW\\\", \\\"complete scalar hypotheses are required\\\", where)\\n    if len({json.dumps(h, sort_keys=True) for h in hypotheses}) != len(hypotheses):\\n        fail(\\\"INVALID_JOINT_LAW\\\", \\\"joint hypotheses overlap\\\", where)\\n    weights = [_fraction(a.get(\\\"weight\\\"), where) for a in atoms]\\n    if any(w < 0 for w in weights) or sum(weights, Fraction()) != 1:\\n        fail(\\\"INVALID_JOINT_LAW\\\", \\\"weights must be nonnegative and sum to one\\\", where)\\n    return [dict(a) for a in atoms]\\n\\n\\ndef admit_uncertainty(record: Mapping[str, Any], *, known_records: Mapping[str, Mapping[str, Any]] | None = None,\\n                      available_information: Iterable[str] = ()) -> dict[str, Any]:\\n    kind = record.get(\\\"kind\\\")\\n    fields = {\\n        \\\"ExtractionReading\\\": (\\\"source\\\", \\\"locator\\\", \\\"review_decision\\\"),\\n        \\\"HistoricalFact\\\": (\\\"evidence\\\", \\\"reason\\\"),\\n        \\\"AccountingElection\\\": (\\\"package\\\", \\\"permitted_treatments\\\", \\\"election\\\", \\\"effective_date\\\", \\\"eligibility_evidence\\\"),\\n        \\\"MeasurementEstimate\\\": (\\\"method\\\", \\\"measurement_date\\\", \\\"inputs\\\"),\\n        \\\"BehaviourPolicy\\\": (\\\"policy\\\", \\\"information_set\\\", \\\"decision_time\\\"),\\n        \\\"FutureInnovation\\\": (\\\"driver\\\", \\\"future_period\\\", \\\"scenario\\\", \\\"joint_law\\\", \\\"measure\\\"),\\n    }\\n    if kind not in fields:\\n        fail(\\\"UNKNOWN_UNCERTAINTY_CATEGORY\\\", f\\\"unsupported category {kind!r}\\\", \\\"kind\\\")\\n    for key in (\\\"id\\\", \\\"scope\\\", \\\"provenance\\\", \\\"dependencies\\\") + fields[kind]:\\n        if key not in record or (key != \\\"dependencies\\\" and not record[key]):\\n            fail(\\\"MISSING_ADMISSION_FIELD\\\", f\\\"missing admission field {key}\\\", str(record.get(\\\"id\\\", \\\"\\\")))\\n    if not isinstance(record[\\\"provenance\\\"], list) or not isinstance(record[\\\"dependencies\\\"], list):\\n        fail(\\\"INVALID_ADMISSION_LIST\\\", \\\"provenance and dependencies must be lists\\\", str(record[\\\"id\\\"]))\\n    known_records = known_records or {}\\n    for dep in record[\\\"dependencies\\\"]:\\n        if dep not in known_records:\\n            fail(\\\"DANGLING_DEPENDENCY\\\", f\\\"unknown dependency {dep}\\\", str(record[\\\"id\\\"]))\\n    graph = {key: list(value.get(\\\"dependencies\\\", ())) for key, value in known_records.items()}\\n    graph[str(record[\\\"id\\\"])] = list(record[\\\"dependencies\\\"])\\n    state: dict[str, int] = {}\\n    def visit(node: str) -> None:\\n        state[node] = 1\\n        for dep in graph.get(node, ()):\\n            if state.get(dep) == 1:\\n                fail(\\\"CYCLIC_DEPENDENCY\\\", \\\"uncertainty dependencies contain a cycle\\\", str(record[\\\"id\\\"]))\\n            if state.get(dep) != 2:\\n                visit(dep)\\n        state[node] = 2\\n    for node in graph:\\n        if state.get(node, 0) == 0:\\n            visit(node)\\n    if kind == \\\"ExtractionReading\\\" and record[\\\"review_decision\\\"] != \\\"Accept\\\":\\n        fail(\\\"READING_NOT_ACCEPTED\\\", \\\"reading requires accepted review\\\", str(record[\\\"id\\\"]))\\n    if kind == \\\"AccountingElection\\\" and record[\\\"election\\\"] not in record[\\\"permitted_treatments\\\"]:\\n        fail(\\\"TREATMENT_NOT_PERMITTED\\\", \\\"election is outside package permissions\\\", str(record[\\\"id\\\"]))\\n    if kind == \\\"MeasurementEstimate\\\":\\n        if record[\\\"method\\\"] not in _SUPPORTED_MEASUREMENT_METHODS:\\n            fail(\\\"UNSUPPORTED_ESTIMATION_METHOD\\\", record[\\\"method\\\"], str(record[\\\"id\\\"]))\\n        if not isinstance(record[\\\"inputs\\\"], Mapping) or any(v is None for v in record[\\\"inputs\\\"].values()):\\n            fail(\\\"MISSING_ESTIMATE_INPUT\\\", \\\"measurement inputs must be available\\\", str(record[\\\"id\\\"]))\\n    if kind == \\\"BehaviourPolicy\\\":\\n        if not isinstance(record[\\\"information_set\\\"], list):\\n            fail(\\\"INVALID_INFORMATION_SET\\\", \\\"information_set must be a list\\\", str(record[\\\"id\\\"]))\\n        if any(str(x).startswith(\\\"future_realised:\\\") for x in record[\\\"information_set\\\"]):\\n            fail(\\\"FUTURE_INFORMATION_LEAKAGE\\\", \\\"future realised outcome is unavailable at decision time\\\", str(record[\\\"id\\\"]))\\n    if kind == \\\"FutureInnovation\\\":\\n        if record[\\\"measure\\\"] not in _SUPPORTED_MEASURES:\\n            fail(\\\"INCOMPATIBLE_PROBABILITY_MEASURE\\\", \\\"measure must be real_world or pricing\\\", str(record[\\\"id\\\"]))\\n        _validate_joint_law(record[\\\"joint_law\\\"], str(record[\\\"id\\\"]))\\n    return dict(record)\\n\\n\\ndef guard_information_view(view: Mapping[str, Any], *, event_time: str | date, request: str = \\\"exogenous_stress\\\") -> dict[str, Any]:\\n    if request in {\\\"observational_conditioning\\\", \\\"structural_intervention\\\"}:\\n        fail(\\\"UNSUPPORTED_INFORMATION_OPERATION\\\", request, \\\"information_view\\\")\\n    visible = set(view.get(\\\"visible\\\", ()))\\n    future_stress = set(view.get(\\\"future_announced\\\", ()))\\n    hidden = set(view.get(\\\"future_realised\\\", ()))\\n    if hidden & visible or any(str(x).startswith(\\\"future_realised:\\\") for x in visible):\\n        fail(\\\"FUTURE_INFORMATION_LEAKAGE\\\", \\\"future realised outcomes cannot be visible\\\", \\\"information_view\\\")\\n    if not view.get(\\\"measure_id\\\"):\\n        fail(\\\"MISSING_PROBABILITY_MEASURE\\\", \\\"information view needs an explicit measure\\\", \\\"information_view\\\")\\n    if view.get(\\\"pricing_measure_id\\\") and view[\\\"pricing_measure_id\\\"] == view[\\\"measure_id\\\"]:\\n        fail(\\\"INCOMPATIBLE_PROBABILITY_MEASURE\\\", \\\"real-world and pricing measures must be distinct\\\", \\\"information_view\\\")\\n    return {\\\"status\\\": \\\"accepted\\\", \\\"event_time\\\": str(event_time), \\\"visible\\\": sorted(visible),\\n            \\\"future_announced\\\": sorted(future_stress), \\\"future_realised_hidden\\\": sorted(hidden),\\n            \\\"measure_id\\\": view[\\\"measure_id\\\"], \\\"selection_changes_history\\\": False}\\n\\n\\n@dataclass(frozen=True)\\nclass DebtConstituent:\\n    id: str\\n    principal: Fraction\\n    rate: Fraction\\n    maturity: Fraction\\n    reset: str = \\\"fixed\\\"\\n    hedge: str = \\\"unhedged\\\"\\n\\n    @classmethod\\n    def from_dict(cls, row: Mapping[str, Any]) -> \\\"DebtConstituent\\\":\\n        principal = _fraction(row.get(\\\"principal\\\"), f\\\"{row.get('id')}.principal\\\")\\n        if principal < 0:\\n            fail(\\\"NEGATIVE_PRINCIPAL\\\", \\\"principal must be nonnegative\\\", str(row.get(\\\"id\\\")))\\n        return cls(str(row[\\\"id\\\"]), principal, _fraction(row.get(\\\"rate\\\"), f\\\"{row.get('id')}.rate\\\"),\\n                   _fraction(row.get(\\\"maturity\\\"), f\\\"{row.get('id')}.maturity\\\"), str(row.get(\\\"reset\\\", \\\"fixed\\\")), str(row.get(\\\"hedge\\\", \\\"unhedged\\\")))\\n\\n\\ndef _query_signature(query: Mapping[str, Any]) -> str:\\n    return hashlib.sha256(json.dumps(query, sort_keys=True, default=str, separators=(\\\",\\\", \\\":\\\")).encode()).hexdigest()\\n\\n\\ndef interest_certificate(constituents: Sequence[DebtConstituent], target_rate: Fraction | str | int,\\n                         horizon: Fraction | str | int) -> dict[str, Fraction]:\\n    T = _fraction(horizon, \\\"horizon\\\")\\n    if T < 0:\\n        fail(\\\"INVALID_HORIZON\\\", \\\"horizon must be nonnegative\\\", \\\"horizon\\\")\\n    rstar = _fraction(target_rate, \\\"target_rate\\\")\\n    exact = sum((c.principal * c.rate * T for c in constituents), Fraction())\\n    approx = sum((c.principal * rstar * T for c in constituents), Fraction())\\n    bound = T * sum((c.principal * abs(c.rate - rstar) for c in constituents), Fraction())\\n    difference = abs(exact - approx)\\n    if difference > bound:\\n        fail(\\\"INVALID_APPROXIMATION_CERTIFICATE\\\", \\\"triangle-inequality bound is violated\\\", \\\"approximation\\\")\\n    return {\\\"exact\\\": exact, \\\"approximate\\\": approx, \\\"error\\\": difference, \\\"bound\\\": bound}\\n\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'cat tests/test_accounting_p06.py'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'cat tests/test_accounting_p06.py'\",\"aggregated_output\":\"\\\"\\\"\\\"Deterministic P06 conformance tests with independent arithmetic/set oracles.\\\"\\\"\\\"\\nfrom datetime import date\\nfrom fractions import Fraction as F\\nfrom pathlib import Path\\nimport copy\\nimport json\\nimport sys\\nimport unittest\\n\\nROOT = Path(__file__).resolve().parents[1]\\nsys.path.insert(0, str(ROOT / \\\"scripts\\\"))\\nfrom context_chronology_v1 import (  # noqa: E402\\n    Context, DebtConstituent, MappingRule, P06Engine, P06Error,\\n    admit_uncertainty, check_partition, compatible_context, guard_information_view,\\n    interest_certificate, resolve_bullet_debt, select_evidence, subtract_cumulative,\\n)\\n\\n\\ndef ctx(**overrides):\\n    row = {\\n        \\\"concept\\\": \\\"revenue\\\", \\\"entity\\\": \\\"Acme\\\", \\\"perimeter\\\": \\\"Acme\\\", \\\"perimeter_version\\\": \\\"2026\\\",\\n        \\\"basis\\\": \\\"GAAP\\\", \\\"measurement\\\": \\\"historical_cost\\\", \\\"unit\\\": \\\"USD\\\", \\\"currency\\\": \\\"USD\\\",\\n        \\\"calendar\\\": \\\"gregorian\\\", \\\"dimensions\\\": {\\\"segment\\\": \\\"retail\\\"}, \\\"gross_net\\\": \\\"gross\\\",\\n    }\\n    row.update(overrides)\\n    return Context.from_dict(row)\\n\\n\\ndef assertions():\\n    return [\\n        {\\\"id\\\": \\\"h1-original\\\", \\\"concept\\\": \\\"sales\\\", \\\"value\\\": \\\"120\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-06-30\\\"}, \\\"available\\\": \\\"2025-08-01\\\", \\\"ingested\\\": \\\"2025-08-02\\\", \\\"supersedes\\\": [], \\\"source\\\": \\\"fixture:original\\\", \\\"historical_byte_vintage\\\": \\\"unknown\\\"},\\n        {\\\"id\\\": \\\"h1-revised\\\", \\\"concept\\\": \\\"sales\\\", \\\"value\\\": \\\"110\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-06-30\\\"}, \\\"available\\\": \\\"2026-02-01\\\", \\\"ingested\\\": \\\"2026-02-02\\\", \\\"supersedes\\\": [\\\"h1-original\\\"], \\\"source\\\": \\\"fixture:revision\\\", \\\"historical_byte_vintage\\\": \\\"unknown\\\"},\\n        {\\\"id\\\": \\\"fy25\\\", \\\"concept\\\": \\\"sales\\\", \\\"value\\\": \\\"260\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}, \\\"available\\\": \\\"2026-02-01\\\", \\\"ingested\\\": \\\"2026-02-02\\\", \\\"supersedes\\\": [], \\\"source\\\": \\\"fixture:annual\\\", \\\"historical_byte_vintage\\\": \\\"unknown\\\"},\\n    ]\\n\\n\\nclass ContextPartitionTests(unittest.TestCase):\\n    def test_equivalent_context_mapping_and_spelling_preserved(self):\\n        source, target = ctx(concept=\\\"sales\\\", scale=\\\"thousands\\\", sign=\\\"credit\\\", precision=2), ctx(concept=\\\"revenue\\\", scale=\\\"thousands\\\", sign=\\\"credit\\\", precision=2)\\n        rule = MappingRule(\\\"sales\\\", \\\"revenue\\\", provenance=(\\\"fixture:review\\\",))\\n        witness = compatible_context(source, target, [rule], at=\\\"2026-01-01\\\")\\n        self.assertEqual(witness[\\\"kind\\\"], \\\"equivalent\\\")\\n        self.assertEqual(witness[\\\"source\\\"][\\\"concept\\\"], \\\"sales\\\")\\n        self.assertEqual(witness[\\\"target\\\"][\\\"concept\\\"], \\\"revenue\\\")\\n        self.assertEqual(witness[\\\"source\\\"][\\\"scale\\\"], \\\"thousands\\\")\\n        self.assertEqual(witness[\\\"source\\\"][\\\"precision\\\"], 2)\\n\\n    def test_context_rejects_parent_basis_measurement_currency_calendar_gross_net(self):\\n        for field, a, b, code in [\\n            (\\\"perimeter\\\", \\\"Acme\\\", \\\"Group\\\", \\\"PARENT_GROUP_MISMATCH\\\"),\\n            (\\\"perimeter_version\\\", \\\"2026\\\", \\\"2025\\\", \\\"PERIMETER_VERSION_MISMATCH\\\"),\\n            (\\\"basis\\\", \\\"GAAP\\\", \\\"IFRS\\\", \\\"BASIS_MISMATCH\\\"),\\n            (\\\"measurement\\\", \\\"historical_cost\\\", \\\"fair_value\\\", \\\"MEASUREMENT_MISMATCH\\\"),\\n            (\\\"currency\\\", \\\"USD\\\", \\\"EUR\\\", \\\"CURRENCY_MISMATCH\\\"),\\n            (\\\"calendar\\\", \\\"gregorian\\\", \\\"fiscal_445\\\", \\\"CALENDAR_MISMATCH\\\"),\\n            (\\\"gross_net\\\", \\\"gross\\\", \\\"net\\\", \\\"GROSS_NET_MISMATCH\\\"),\\n        ]:\\n            with self.subTest(field=field):\\n                with self.assertRaisesRegex(P06Error, code):\\n                    compatible_context(ctx(**{field: a}), ctx(**{field: b}))\\n\\n    def test_expired_cycle_and_measurement_conversion_rejected(self):\\n        with self.assertRaisesRegex(P06Error, \\\"CONTEXT_MISMATCH\\\"):\\n            compatible_context(ctx(concept=\\\"a\\\"), ctx(concept=\\\"b\\\"), [MappingRule(\\\"a\\\", \\\"b\\\", effective_end=date(2025, 1, 1), provenance=(\\\"x\\\",))], at=\\\"2026-01-01\\\")\\n        with self.assertRaisesRegex(P06Error, \\\"MAPPING_CYCLE\\\"):\\n            compatible_context(ctx(concept=\\\"a\\\"), ctx(concept=\\\"b\\\"), [MappingRule(\\\"a\\\", \\\"b\\\", provenance=(\\\"x\\\",)), MappingRule(\\\"b\\\", \\\"a\\\", provenance=(\\\"y\\\",))])\\n        with self.assertRaisesRegex(P06Error, \\\"UNSUPPORTED_MEASUREMENT_CONVERSION\\\"):\\n            compatible_context(ctx(concept=\\\"a\\\"), ctx(concept=\\\"b\\\"), [MappingRule(\\\"a\\\", \\\"b\\\", conversion=\\\"USD_to_EUR\\\", provenance=(\\\"x\\\",))])\\n        with self.assertRaisesRegex(P06Error, \\\"UNSUPPORTED_MEASUREMENT_CONVERSION\\\"):\\n            compatible_context(ctx(concept=\\\"a\\\", scale=\\\"units\\\"), ctx(concept=\\\"a\\\", scale=\\\"thousands\\\"))\\n\\n    def test_partition_independent_enumeration_and_unknown_residual(self):\\n        ok = check_partition([\\\"e1\\\", \\\"e2\\\", \\\"e3\\\"], {\\\"north\\\": [\\\"e1\\\"], \\\"south\\\": [\\\"e2\\\", \\\"e3\\\"]}, axis=\\\"geo\\\")\\n        self.assertTrue(ok[\\\"complete\\\"])\\n        for members in ({\\\"north\\\": [\\\"e1\\\", \\\"e2\\\"], \\\"south\\\": [\\\"e2\\\", \\\"e3\\\"]}, {\\\"north\\\": [\\\"e1\\\"]}):\\n            with self.assertRaisesRegex(P06Error, \\\"OVERLAPPING_PARTITION|INCOMPLETE_PARTITION\\\"):\\n                check_partition([\\\"e1\\\", \\\"e2\\\", \\\"e3\\\"], members, axis=\\\"geo\\\")\\n        with self.assertRaisesRegex(P06Error, \\\"UNKNOWN_RESIDUAL\\\"):\\n            check_partition([\\\"e1\\\", \\\"e2\\\"], {\\\"north\\\": [\\\"e1\\\"]}, residual={\\\"members\\\": [\\\"e2\\\"], \\\"known\\\": False}, axis=\\\"geo\\\")\\n\\n    def test_partition_population_and_axis_prevent_double_counting(self):\\n        self.assertEqual(check_partition([\\\"a\\\", \\\"b\\\"], {\\\"x\\\": [\\\"a\\\"], \\\"y\\\": [\\\"b\\\"]}, axis=\\\"product\\\")[\\\"axis\\\"], \\\"product\\\")\\n        with self.assertRaisesRegex(P06Error, \\\"OVERLAPPING_PARTITION\\\"):\\n            check_partition([\\\"a\\\", \\\"b\\\"], {\\\"x\\\": [\\\"a\\\"], \\\"all\\\": [\\\"a\\\", \\\"b\\\"]}, axis=\\\"product\\\")\\n\\n\\nclass ChronologyYTDTests(unittest.TestCase):\\n    def test_original_latest_and_harmonised_selection(self):\\n        rows = assertions()\\n        original = select_evidence(rows, \\\"2025-12-31\\\", mode=\\\"original\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        self.assertEqual(original[\\\"selected_ids\\\"], [\\\"h1-original\\\"])\\n        latest = select_evidence(rows, \\\"2026-12-31\\\", mode=\\\"latest_available\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        self.assertEqual(set(latest[\\\"selected_ids\\\"]), {\\\"h1-revised\\\", \\\"fy25\\\"})\\n        harm = select_evidence(rows, \\\"2026-12-31\\\", mode=\\\"harmonised\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\", harmonisations=[{\\\"source_id\\\": \\\"h1-revised\\\", \\\"target_id\\\": \\\"sales-harmonised\\\", \\\"review_decision\\\": \\\"Accept\\\", \\\"provenance\\\": [\\\"review:1\\\"]}])\\n        self.assertEqual(harm[\\\"transformations\\\"][0][\\\"target_id\\\"], \\\"sales-harmonised\\\")\\n        self.assertTrue(harm[\\\"unresolved\\\"])\\n\\n    def test_cutoff_ingestion_and_date_only_boundary(self):\\n        row = {\\\"id\\\": \\\"d\\\", \\\"available\\\": \\\"2025-01-01\\\", \\\"ingested\\\": \\\"2025-01-01\\\", \\\"supersedes\\\": [], \\\"source\\\": \\\"x\\\"}\\n        before = select_evidence([row], \\\"2025-01-01T23:59:59+00:00\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        equal = select_evidence([row], \\\"2025-01-02T00:00:00+00:00\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        self.assertEqual(before[\\\"selected_ids\\\"], [])\\n        self.assertEqual(equal[\\\"selected_ids\\\"], [\\\"d\\\"])\\n        with self.assertRaisesRegex(P06Error, \\\"DATE_ONLY_POLICY_REQUIRED\\\"):\\n            select_evidence([row], \\\"2025-01-02\\\", timezone_name=\\\"UTC\\\")\\n        with self.assertRaisesRegex(P06Error, \\\"TIMEZONE_REQUIRED\\\"):\\n            select_evidence([row], \\\"2025-01-02\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        unknown = {\\\"id\\\": \\\"unknown\\\", \\\"available\\\": \\\"unknown\\\", \\\"supersedes\\\": [], \\\"source\\\": \\\"unretained\\\"}\\n        unresolved = select_evidence([unknown], \\\"2026-01-01T00:00:00+00:00\\\")\\n        self.assertEqual(unresolved[\\\"selected_ids\\\"], [])\\n        self.assertIn(\\\"source_availability_unestablished\\\", {x[\\\"reason\\\"] for x in unresolved[\\\"unresolved\\\"]})\\n\\n    def test_dangling_and_cyclic_supersession_rejected(self):\\n        bad = {\\\"id\\\": \\\"a\\\", \\\"available\\\": \\\"2025-01-01T00:00:00+00:00\\\", \\\"supersedes\\\": [\\\"z\\\"], \\\"source\\\": \\\"x\\\"}\\n        with self.assertRaisesRegex(P06Error, \\\"DANGLING_SUPERSESSION\\\"):\\n            select_evidence([bad], \\\"2026-01-01T00:00:00+00:00\\\")\\n        a = {\\\"id\\\": \\\"a\\\", \\\"available\\\": \\\"2025-01-01T00:00:00+00:00\\\", \\\"supersedes\\\": [\\\"b\\\"], \\\"source\\\": \\\"x\\\"}\\n        b = {\\\"id\\\": \\\"b\\\", \\\"available\\\": \\\"2025-01-01T00:00:00+00:00\\\", \\\"supersedes\\\": [\\\"a\\\"], \\\"source\\\": \\\"x\\\"}\\n        with self.assertRaisesRegex(P06Error, \\\"SUPERSESSION_CYCLE\\\"):\\n            select_evidence([a, b], \\\"2026-01-01T00:00:00+00:00\\\")\\n\\n    def test_ytd_valid_subtraction_uses_revised_h1(self):\\n        result = subtract_cumulative(\\n            {\\\"id\\\": \\\"fy\\\", \\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 260, \\\"concept\\\": \\\"sales\\\", \\\"context\\\": {\\\"entity\\\": \\\"A\\\"}, \\\"calendar\\\": \\\"gregorian\\\", \\\"revision_id\\\": \\\"r2\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}},\\n            {\\\"id\\\": \\\"h1\\\", \\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 110, \\\"concept\\\": \\\"sales\\\", \\\"context\\\": {\\\"entity\\\": \\\"A\\\"}, \\\"calendar\\\": \\\"gregorian\\\", \\\"revision_id\\\": \\\"r2\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-06-30\\\"}},\\n        )\\n        self.assertEqual(result[\\\"amount\\\"], F(150))\\n        self.assertEqual(result[\\\"period\\\"], {\\\"start\\\": \\\"2025-06-30\\\", \\\"end\\\": \\\"2025-12-31\\\"})\\n        with self.assertRaisesRegex(P06Error, \\\"REVISION_INCOMPATIBLE\\\"):\\n            subtract_cumulative({\\\"id\\\": \\\"fy\\\", \\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 260, \\\"concept\\\": \\\"sales\\\", \\\"context\\\": {\\\"entity\\\": \\\"A\\\"}, \\\"calendar\\\": \\\"gregorian\\\", \\\"revision_id\\\": \\\"r2\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}}, {\\\"id\\\": \\\"h1\\\", \\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 120, \\\"concept\\\": \\\"sales\\\", \\\"context\\\": {\\\"entity\\\": \\\"A\\\"}, \\\"calendar\\\": \\\"gregorian\\\", \\\"revision_id\\\": \\\"r1\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-06-30\\\"}})\\n\\n    def test_ytd_rejects_instant_start_and_nonnested(self):\\n        base = {\\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 1, \\\"concept\\\": \\\"x\\\", \\\"context\\\": {}, \\\"calendar\\\": \\\"g\\\", \\\"revision_id\\\": \\\"r\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-06-30\\\"}}\\n        with self.assertRaisesRegex(P06Error, \\\"YTD_REQUIRES_CUMULATIVE\\\"):\\n            subtract_cumulative({**base, \\\"kind\\\": \\\"instant\\\"}, base)\\n        with self.assertRaisesRegex(P06Error, \\\"PERIOD_START_MISMATCH\\\"):\\n            subtract_cumulative({**base, \\\"period\\\": {\\\"start\\\": \\\"2025-02-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}}, base)\\n        with self.assertRaisesRegex(P06Error, \\\"REVISION_UNKNOWN\\\"):\\n            subtract_cumulative({**base, \\\"revision_id\\\": None, \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}}, {**base, \\\"revision_id\\\": None})\\n\\n\\nclass UncertaintyTests(unittest.TestCase):\\n    def _base(self, kind, **extra):\\n        row = {\\\"id\\\": kind.lower(), \\\"kind\\\": kind, \\\"scope\\\": \\\"demo\\\", \\\"provenance\\\": [\\\"fixture\\\"], \\\"dependencies\\\": []}\\n        row.update(extra)\\n        return row\\n\\n    def test_all_six_categories_and_dependencies(self):\\n        records = {}\\n        cases = [\\n            self._base(\\\"ExtractionReading\\\", source=\\\"doc\\\", locator=\\\"p1\\\", review_decision=\\\"Accept\\\"),\\n            self._base(\\\"HistoricalFact\\\", evidence=\\\"doc\\\", reason=\\\"dated\\\"),\\n            self._base(\\\"AccountingElection\\\", package=\\\"pkg\\\", permitted_treatments=[\\\"A\\\"], election=\\\"A\\\", effective_date=\\\"2025-01-01\\\", eligibility_evidence=\\\"memo\\\"),\\n            self._base(\\\"MeasurementEstimate\\\", method=\\\"direct\\\", measurement_date=\\\"2025-01-01\\\", inputs={\\\"x\\\": 1}),\\n            self._base(\\\"BehaviourPolicy\\\", policy=\\\"hold\\\", information_set=[\\\"past:price\\\"], decision_time=\\\"2025-01-01\\\"),\\n            self._base(\\\"FutureInnovation\\\", driver=\\\"shock\\\", future_period=\\\"2026\\\", scenario=\\\"base\\\", joint_law={\\\"atoms\\\":[{\\\"id\\\":\\\"a\\\",\\\"hypothesis\\\":{\\\"x\\\":0},\\\"weight\\\":\\\"1\\\"}]}, measure=\\\"real_world\\\"),\\n        ]\\n        for row in cases:\\n            records[row[\\\"id\\\"]] = admit_uncertainty(row, known_records=records)\\n        self.assertEqual(set(records), {x[\\\"id\\\"] for x in cases})\\n\\n    def test_uncertainty_negative_semantics(self):\\n        b = self._base\\n        for row, code in [\\n            (b(\\\"ExtractionReading\\\", source=\\\"d\\\", locator=\\\"p\\\", review_decision=\\\"Reject\\\"), \\\"READING_NOT_ACCEPTED\\\"),\\n            (b(\\\"AccountingElection\\\", package=\\\"p\\\", permitted_treatments=[\\\"A\\\"], election=\\\"B\\\", effective_date=\\\"x\\\", eligibility_evidence=\\\"e\\\"), \\\"TREATMENT_NOT_PERMITTED\\\"),\\n            (b(\\\"MeasurementEstimate\\\", method=\\\"unknown\\\", measurement_date=\\\"x\\\", inputs={\\\"x\\\": 1}), \\\"UNSUPPORTED_ESTIMATION_METHOD\\\"),\\n            (b(\\\"MeasurementEstimate\\\", method=\\\"direct\\\", measurement_date=\\\"x\\\", inputs={\\\"x\\\": None}), \\\"MISSING_ESTIMATE_INPUT\\\"),\\n            (b(\\\"BehaviourPolicy\\\", policy=\\\"x\\\", information_set=[\\\"future_realised:y\\\"], decision_time=\\\"x\\\"), \\\"FUTURE_INFORMATION_LEAKAGE\\\"),\\n            (b(\\\"FutureInnovation\\\", driver=\\\"x\\\", future_period=\\\"x\\\", scenario=\\\"x\\\", joint_law={\\\"atoms\\\":[{\\\"id\\\":\\\"a\\\",\\\"hypothesis\\\":{\\\"x\\\":0},\\\"weight\\\":\\\"1/2\\\"}]}, measure=\\\"pricing\\\"), \\\"INVALID_JOINT_LAW\\\"),\\n            (b(\\\"Mystery\\\", x=\\\"x\\\"), \\\"UNKNOWN_UNCERTAINTY_CATEGORY\\\"),\\n        ]:\\n            with self.subTest(code=code), self.assertRaisesRegex(P06Error, code):\\n                admit_uncertainty(row)\\n        a = b(\\\"HistoricalFact\\\", evidence=\\\"d\\\", reason=\\\"r\\\", dependencies=[\\\"z\\\"])\\n        z = b(\\\"HistoricalFact\\\", evidence=\\\"d\\\", reason=\\\"r\\\", id=\\\"z\\\", dependencies=[\\\"historicalfact\\\"])\\n        with self.assertRaisesRegex(P06Error, \\\"CYCLIC_DEPENDENCY\\\"):\\n            admit_uncertainty(a, known_records={\\\"z\\\": z})\\n\\n    def test_information_view_blocks_leakage_and_unimplemented_modes(self):\\n        accepted = guard_information_view({\\\"visible\\\": [\\\"past:x\\\"], \\\"future_announced\\\": [\\\"stress:y\\\"], \\\"future_realised\\\": [\\\"outcome:z\\\"], \\\"measure_id\\\": \\\"P\\\", \\\"pricing_measure_id\\\": \\\"Q\\\"}, event_time=\\\"2025-01-01\\\")\\n        self.assertFalse(accepted[\\\"selection_changes_history\\\"])\\n        with self.assertRaisesRegex(P06Error, \\\"FUTURE_INFORMATION_LEAKAGE\\\"):\\n            guard_information_view({\\\"visible\\\": [\\\"future_realised:z\\\"], \\\"measure_id\\\": \\\"P\\\"}, event_time=\\\"x\\\")\\n        with self.assertRaisesRegex(P06Error, \\\"UNSUPPORTED_INFORMATION_OPERATION\\\"):\\n            guard_information_view({\\\"visible\\\": [], \\\"measure_id\\\": \\\"P\\\"}, event_time=\\\"x\\\", request=\\\"structural_intervention\\\")\\n\\n\\nclass ResolutionTests(unittest.TestCase):\\n    def rows(self):\\n        return [DebtConstituent(\\\"a\\\", F(100), F(5, 100), F(2)), DebtConstituent(\\\"b\\\", F(50), F(7, 100), F(2))]\\n\\n    def query(self, **extra):\\n        q = {\\\"contract\\\": \\\"bullet-v1\\\", \\\"context\\\": \\\"usd\\\", \\\"evidence_view\\\": \\\"latest_available\\\", \\\"horizon\\\": \\\"1\\\", \\\"scenario\\\": \\\"base\\\", \\\"requested_outputs\\\": [\\\"interest\\\", \\\"principal\\\"], \\\"accrual_convention\\\": \\\"simple_actual_fraction\\\", \\\"group_by\\\": [\\\"rate\\\", \\\"maturity\\\", \\\"reset\\\", \\\"hedge\\\"]}\\n        q.update(extra)\\n        return q\\n\\n    def test_exact_grouped_resolution_and_independent_oracle(self):\\n        result = resolve_bullet_debt(self.rows(), self.query())\\n        self.assertEqual(result[\\\"outputs\\\"][\\\"interest\\\"], F(17, 2))\\n        self.assertEqual(result[\\\"outputs\\\"][\\\"principal\\\"], F(150))\\n        self.assertEqual(sum(g[\\\"interest\\\"] for g in result[\\\"groups\\\"]), F(17, 2))\\n\\n    def test_query_horizon_scenario_and_grouping_sufficiency(self):\\n        with self.assertRaisesRegex(P06Error, \\\"GROUPING_INSUFFICIENT\\\"):\\n            resolve_bullet_debt(self.rows(), self.query(group_by=[\\\"maturity\\\", \\\"reset\\\", \\\"hedge\\\"]))\\n        with self.assertRaisesRegex(P06Error, \\\"UNSUPPORTED_SCENARIO\\\"):\\n            resolve_bullet_debt(self.rows(), self.query(scenario=\\\"future_realised\\\"))\\n        with self.assertRaisesRegex(P06Error, \\\"MATURITY_CROSSING\\\"):\\n            resolve_bullet_debt(self.rows(), self.query(horizon=\\\"3\\\"))\\n\\n    def test_approximation_requires_declared_error_evidence(self):\\n        with self.assertRaisesRegex(P06Error, \\\"APPROXIMATION_EVIDENCE_REQUIRED\\\"):\\n            resolve_bullet_debt(self.rows(), self.query(), approximation={\\\"target_rate\\\": \\\"0.06\\\", \\\"tolerance\\\": \\\"1\\\", \\\"error_bound\\\": \\\"1\\\"})\\n        result = resolve_bullet_debt(self.rows(), self.query(), approximation={\\\"target_rate\\\": \\\"0.06\\\", \\\"tolerance\\\": \\\"2\\\", \\\"error_bound\\\": \\\"3/2\\\", \\\"scope\\\": \\\"fixed_rate_interest\\\", \\\"evidence\\\": [\\\"certificate:triangle\\\"]})\\n        self.assertEqual(result[\\\"approximation\\\"][\\\"error\\\"], \\\"1/2\\\")\\n        self.assertEqual(result[\\\"approximation\\\"][\\\"bound\\\"], \\\"3/2\\\")\\n\\n    def test_stale_result_and_unsupported_dynamics(self):\\n        previous = resolve_bullet_debt(self.rows(), self.query())\\n        with self.assertRaisesRegex(P06Error, \\\"STALE_RESULT\\\"):\\n            resolve_bullet_debt(self.rows(), self.query(horizon=\\\"2\\\"), previous=previous)\\n        with self.assertRaisesRegex(P06Error, \\\"RESET_UNSUPPORTED\\\"):\\n            resolve_bullet_debt([DebtConstituent(\\\"a\\\", F(1), F(1, 10), F(2), reset=\\\"floating\\\")], self.query(group_by=[\\\"rate\\\", \\\"maturity\\\", \\\"reset\\\", \\\"hedge\\\"]))\\n\\n\\nclass IntegrationTests(unittest.TestCase):\\n    def test_public_entrypoint_selects_maps_admits_and_resolves(self):\\n        engine = P06Engine()\\n        engine.add_context(\\\"source\\\", ctx(concept=\\\"sales\\\"))\\n        engine.add_context(\\\"target\\\", ctx(concept=\\\"revenue\\\"))\\n        engine.add_mapping({\\\"source_concept\\\": \\\"sales\\\", \\\"target_concept\\\": \\\"revenue\\\", \\\"provenance\\\": [\\\"fixture:mapping\\\"]})\\n        for row in assertions():\\n            engine.add_assertion(row)\\n        reading = {\\\"id\\\": \\\"read\\\", \\\"kind\\\": \\\"ExtractionReading\\\", \\\"scope\\\": \\\"demo\\\", \\\"provenance\\\": [\\\"fixture\\\"], \\\"dependencies\\\": [], \\\"source\\\": \\\"doc\\\", \\\"locator\\\": \\\"p1\\\", \\\"review_decision\\\": \\\"Accept\\\"}\\n        request = {\\\"cutoff\\\": \\\"2026-12-31\\\", \\\"timezone\\\": \\\"UTC\\\", \\\"date_only_policy\\\": \\\"next_local_midnight\\\", \\\"evidence_view\\\": \\\"latest_available\\\", \\\"source_context\\\": \\\"source\\\", \\\"target_context\\\": \\\"target\\\", \\\"uncertainty\\\": [reading], \\\"constituents\\\": [{\\\"id\\\": \\\"a\\\", \\\"principal\\\": \\\"100\\\", \\\"rate\\\": \\\"1/20\\\", \\\"maturity\\\": \\\"2\\\"}], \\\"query\\\": {\\\"contract\\\": \\\"bullet-v1\\\", \\\"context\\\": \\\"usd\\\", \\\"evidence_view\\\": \\\"latest_available\\\", \\\"horizon\\\": \\\"1\\\", \\\"scenario\\\": \\\"base\\\", \\\"requested_outputs\\\": [\\\"interest\\\"], \\\"accrual_convention\\\": \\\"simple_actual_fraction\\\", \\\"group_by\\\": [\\\"rate\\\", \\\"maturity\\\", \\\"reset\\\", \\\"hedge\\\"]}}\\n        result = engine.evaluate(request)\\n        self.assertEqual(result[\\\"resolution\\\"][\\\"outputs\\\"][\\\"interest\\\"], F(5))\\n        self.assertEqual(result[\\\"mapping\\\"][\\\"kind\\\"], \\\"equivalent\\\")\\n        preserved = engine.preserve_result()\\n        engine.revise(\\\"h1-original\\\", {\\\"id\\\": \\\"h1-new\\\", \\\"available\\\": \\\"2026-03-01\\\", \\\"ingested\\\": \\\"2026-03-02\\\", \\\"supersedes\\\": [\\\"h1-original\\\"], \\\"source\\\": \\\"fixture:new\\\"})\\n        self.assertFalse(engine.current_results)\\n        self.assertEqual(preserved[\\\"resolution\\\"][\\\"outputs\\\"][\\\"interest\\\"], F(5))\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '1,116p' scripts/check_accounting_p06.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '1,116p' scripts/check_accounting_p06.py\\\"\",\"aggregated_output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Execute P06 deterministic checks and write conformance/result evidence.\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nfrom collections import Counter\\nfrom datetime import datetime, timezone\\nfrom fractions import Fraction\\nimport hashlib\\nimport io\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport platform\\nimport shlex\\nimport subprocess\\nimport sys\\nimport time\\nimport unittest\\n\\nROOT = Path(__file__).resolve().parents[1]\\nDEFAULT_RUN = \\\"data/accounting-master/runs/20261002T233421-cea9e631/P06\\\"\\nSOURCES = [\\n    \\\"scripts/context_chronology_v1.py\\\", \\\"scripts/check_accounting_p06.py\\\",\\n    \\\"tests/test_accounting_p06.py\\\", \\\"docs/design/spec/context-chronology-profile-v1.md\\\",\\n    \\\"docs/design/fixtures/p06-context-chronology-cases-v1.json\\\",\\n]\\nOUTPUTS = [\\\"data/accounting-master/deliverables/P06/conformance.json\\\",\\n           \\\"data/accounting-master/deliverables/P06/result.md\\\"]\\nWRITABLE = set(SOURCES + OUTPUTS + [\\\"data/accounting-master/deliverables/P06/progress.md\\\"])\\nOBLIGATIONS = [\\\"MC02\\\", \\\"MC05\\\", \\\"MC06\\\", \\\"MC07\\\", \\\"MC10\\\", \\\"MC11\\\", \\\"MC14\\\"]\\n\\n\\ndef digest(path: Path) -> str | None:\\n    try:\\n        return hashlib.sha256(path.read_bytes()).hexdigest()\\n    except OSError:\\n        return None\\n\\n\\ndef unique_object(pairs):\\n    result = {}\\n    for key, value in pairs:\\n        if key in result:\\n            raise ValueError(\\\"duplicate key: \\\" + key)\\n        result[key] = value\\n    return result\\n\\n\\ndef inventory(root: Path, relative: str) -> dict[str, str]:\\n    path = Path(relative)\\n    if path.is_absolute() or \\\"..\\\" in path.parts or path.as_posix() != relative:\\n        raise ValueError(\\\"inventory path must be repository-relative\\\")\\n    data = json.loads((root / path).read_text(), object_pairs_hook=unique_object)\\n    if not isinstance(data, dict) or not data:\\n        raise ValueError(\\\"inventory must be a nonempty path-to-SHA256 object\\\")\\n    for name, value in data.items():\\n        p = Path(name)\\n        if p.is_absolute() or \\\"..\\\" in p.parts or p.as_posix() != name or not isinstance(value, str) or len(value) != 64:\\n            raise ValueError(\\\"invalid inventory entry: \\\" + str(name))\\n    return data\\n\\n\\ndef approval_reference(root: Path, relative: str) -> dict[str, str]:\\n    raw = (root / relative).read_bytes()\\n    record = json.loads(raw, object_pairs_hook=unique_object)\\n    if not isinstance(record, dict):\\n        raise ValueError(\\\"approved plan is not an object\\\")\\n    for name, verdict in ((\\\"plan\\\", \\\"PLAN\\\"), (\\\"review\\\", \\\"AGREE\\\")):\\n        section = record.get(name)\\n        if not isinstance(section, dict) or section.get(\\\"verdict\\\") != verdict:\\n            raise ValueError(f\\\"approved plan lacks {name} {verdict}\\\")\\n        if not isinstance(section.get(\\\"summary\\\"), str) or any(not isinstance(section.get(k), list) for k in (\\\"steps\\\", \\\"assumptions\\\", \\\"checks\\\", \\\"evidence\\\", \\\"issues\\\", \\\"residuals\\\", \\\"next_actions\\\")):\\n            raise ValueError(\\\"malformed approved plan\\\")\\n    if record[\\\"review\\\"].get(\\\"issues\\\") != []:\\n        raise ValueError(\\\"approved plan has review issues\\\")\\n    plan_hash = hashlib.sha256(json.dumps(record[\\\"plan\\\"], sort_keys=True, ensure_ascii=False, separators=(\\\",\\\", \\\":\\\"), allow_nan=False).encode()).hexdigest()\\n    if record.get(\\\"plan_hash\\\") != plan_hash:\\n        raise ValueError(\\\"approved plan hash mismatch\\\")\\n    return {\\\"path\\\": relative, \\\"sha256\\\": hashlib.sha256(raw).hexdigest(), \\\"plan_hash\\\": plan_hash}\\n\\n\\ndef protection(root: Path, phase_inventory: str, execution_inventory: str) -> dict:\\n    historical = inventory(root, phase_inventory)\\n    execution = inventory(root, execution_inventory)\\n    protected = sorted((set(historical) | set(execution)) - WRITABLE)\\n    before = {p: digest(root / p) for p in protected}\\n    changed = [p for p in protected if before[p] != execution.get(p)]\\n    missing = [p for p, h in before.items() if h is None]\\n    return {\\\"historical_inventory\\\": phase_inventory, \\\"execution_inventory\\\": execution_inventory,\\n            \\\"inventory_hashes\\\": {phase_inventory: digest(root / phase_inventory), execution_inventory: digest(root / execution_inventory)},\\n            \\\"excluded_phase_files\\\": sorted(WRITABLE), \\\"before\\\": before, \\\"execution_baseline\\\": {p: execution.get(p) for p in protected},\\n            \\\"changed_since_execution_entry\\\": changed, \\\"missing_before_check\\\": missing,\\n            \\\"historical_differences\\\": [p for p in sorted(set(historical) & set(execution)) if historical[p] != execution[p]]}\\n\\n\\ndef finish_protection(root: Path, report: dict) -> dict:\\n    report[\\\"after\\\"] = {p: digest(root / p) for p in report[\\\"before\\\"]}\\n    report[\\\"changed_during_check\\\"] = [p for p in report[\\\"before\\\"] if report[\\\"before\\\"][p] != report[\\\"after\\\"][p]]\\n    report[\\\"changed_inventory_records\\\"] = [p for p, h in report[\\\"inventory_hashes\\\"].items() if h is None or digest(root / p) != h]\\n    report[\\\"passed\\\"] = not any(report[k] for k in (\\\"changed_since_execution_entry\\\", \\\"missing_before_check\\\", \\\"changed_during_check\\\", \\\"changed_inventory_records\\\"))\\n    return report\\n\\n\\ndef run_suite(module_name: str) -> dict:\\n    sys.path.insert(0, str(ROOT / \\\"tests\\\"))\\n    stream = io.StringIO()\\n    try:\\n        module = __import__(module_name)\\n        suite = unittest.defaultTestLoader.loadTestsFromModule(module)\\n        result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)\\n        return {\\\"module\\\": module_name, \\\"methods\\\": result.testsRun, \\\"failures\\\": len(result.failures), \\\"errors\\\": len(result.errors), \\\"skips\\\": len(result.skipped), \\\"passed\\\": bool(result.wasSuccessful() and result.testsRun > 0 and not result.skipped), \\\"output\\\": stream.getvalue()}\\n    except Exception as exc:\\n        return {\\\"module\\\": module_name, \\\"methods\\\": 0, \\\"failures\\\": 0, \\\"errors\\\": 1, \\\"skips\\\": 0, \\\"passed\\\": False, \\\"output\\\": stream.getvalue() + repr(exc)}\\n\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"agent_message\",\"text\":\"The recovered report says PASS, but the code has material gaps: harmonisation only records metadata, uncertainty admission mostly checks fields, and the integrated path does not use selected evidence to derive the period. I’m repairing those paths and adding tests that change source inputs and check the resulting calculations.\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 -B - <<'PY'\\nfrom pathlib import Path\\np=Path('data/accounting-master/deliverables/P06/progress.md')\\np.write_text('''# P06 repair progress\\n\\nRecovery verified: all eight phase files exist; the prior process timed out despite a worker-authored passing report. The approved plan and execution inventories are present. No independent result acceptance exists.\\n\\nSkeptical audit found material omissions in the recovered candidate: component mappings lacked membership semantics; harmonisation only recorded metadata; supersession selection missed transitive unavailable intermediates; uncertainty categories mostly checked field presence; source evidence did not drive integrated derivation; grouping reuse was not bound to constituent data. Existing passing probes are insufficient for the approved criteria.\\n\\nRepair scope: only the existing P06 runtime, profile, fixture, tests, checker and declared outputs. Preserve all protected inputs and prior snapshots. Exact Fraction arithmetic, finite populations, Gregorian intervals and fixed unhedged bullet debt remain bounded assumptions. No scientific experiment or default promotion is being run.\\n\\nNext checks: add semantic negative and input-sensitivity cases; run P06/P03/P04 unittest discovery with CUDA_VISIBLE_DEVICES=-1; regenerate checker results with approved-plan.json and execution-1/pre-edit-files.json; verify failed-check exit and source/protection hashes. Remaining deliverables: repaired conformance.json and result.md with honest scope limits, then independent result review.\\n''')\\nprint('Checkpoint records verified gaps and repair audit.')\\nPY\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 -B - <<'PY'\\nfrom pathlib import Path\\np=Path('data/accounting-master/deliverables/P06/progress.md')\\np.write_text('''# P06 repair progress\\n\\nRecovery verified: all eight phase files exist; the prior process timed out despite a worker-authored passing report. The approved plan and execution inventories are present. No independent result acceptance exists.\\n\\nSkeptical audit found material omissions in the recovered candidate: component mappings lacked membership semantics; harmonisation only recorded metadata; supersession selection missed transitive unavailable intermediates; uncertainty categories mostly checked field presence; source evidence did not drive integrated derivation; grouping reuse was not bound to constituent data. Existing passing probes are insufficient for the approved criteria.\\n\\nRepair scope: only the existing P06 runtime, profile, fixture, tests, checker and declared outputs. Preserve all protected inputs and prior snapshots. Exact Fraction arithmetic, finite populations, Gregorian intervals and fixed unhedged bullet debt remain bounded assumptions. No scientific experiment or default promotion is being run.\\n\\nNext checks: add semantic negative and input-sensitivity cases; run P06/P03/P04 unittest discovery with CUDA_VISIBLE_DEVICES=-1; regenerate checker results with approved-plan.json and execution-1/pre-edit-files.json; verify failed-check exit and source/protection hashes. Remaining deliverables: repaired conformance.json and result.md with honest scope limits, then independent result review.\\n''')\\nprint('Checkpoint records verified gaps and repair audit.')\\nPY\\\"\",\"aggregated_output\":\"Checkpoint records verified gaps and repair audit.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '117,199p' scripts/check_accounting_p06.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '117,199p' scripts/check_accounting_p06.py\\\"\",\"aggregated_output\":\"def probes() -> list[dict]:\\n    \\\"\\\"\\\"Independent criterion probes; expected values are computed here, not imported from tests.\\\"\\\"\\\"\\n    from context_chronology_v1 import (Context, MappingRule, P06Error, check_partition, compatible_context,\\n                                        resolve_bullet_debt, select_evidence, subtract_cumulative, admit_uncertainty)\\n    rows = []\\n    def observe(identifier, fn):\\n        try:\\n            value = fn()\\n            rows.append({\\\"id\\\": identifier, \\\"passed\\\": bool(value is not False), \\\"observed\\\": value})\\n        except Exception as exc:\\n            rows.append({\\\"id\\\": identifier, \\\"passed\\\": False, \\\"error\\\": type(exc).__name__ + \\\": \\\" + str(exc)})\\n    base = {\\\"concept\\\":\\\"x\\\", \\\"entity\\\":\\\"A\\\", \\\"perimeter\\\":\\\"A\\\", \\\"perimeter_version\\\":\\\"1\\\", \\\"basis\\\":\\\"G\\\", \\\"measurement\\\":\\\"m\\\", \\\"unit\\\":\\\"USD\\\", \\\"currency\\\":\\\"USD\\\", \\\"calendar\\\":\\\"gregorian\\\", \\\"dimensions\\\":{}, \\\"gross_net\\\":\\\"gross\\\"}\\n    observe(\\\"MC02\\\", lambda: compatible_context(Context.from_dict(base), Context.from_dict({**base, \\\"concept\\\":\\\"y\\\"}), [MappingRule(\\\"x\\\", \\\"y\\\", provenance=(\\\"probe\\\",))])[\\\"kind\\\"] == \\\"equivalent\\\")\\n    observe(\\\"MC05\\\", lambda: check_partition([\\\"a\\\", \\\"b\\\"], {\\\"left\\\":[\\\"a\\\"], \\\"right\\\":[\\\"b\\\"]})[\\\"complete\\\"])\\n    assertions = [{\\\"id\\\":\\\"old\\\", \\\"available\\\":\\\"2025-01-01\\\", \\\"ingested\\\":\\\"2025-01-01\\\", \\\"supersedes\\\":[], \\\"source\\\":\\\"s\\\"}, {\\\"id\\\":\\\"new\\\", \\\"available\\\":\\\"2026-01-01\\\", \\\"ingested\\\":\\\"2026-01-01\\\", \\\"supersedes\\\":[\\\"old\\\"], \\\"source\\\":\\\"s\\\"}]\\n    observe(\\\"MC06\\\", lambda: select_evidence(assertions, \\\"2026-12-31\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")[\\\"selected_ids\\\"] == [\\\"new\\\"])\\n    observe(\\\"MC07\\\", lambda: subtract_cumulative({\\\"kind\\\":\\\"cumulative\\\",\\\"amount\\\":260,\\\"concept\\\":\\\"x\\\",\\\"context\\\":{},\\\"calendar\\\":\\\"g\\\",\\\"revision_id\\\":\\\"r\\\",\\\"period\\\":{\\\"start\\\":\\\"2025-01-01\\\",\\\"end\\\":\\\"2025-12-31\\\"}}, {\\\"kind\\\":\\\"cumulative\\\",\\\"amount\\\":110,\\\"concept\\\":\\\"x\\\",\\\"context\\\":{},\\\"calendar\\\":\\\"g\\\",\\\"revision_id\\\":\\\"r\\\",\\\"period\\\":{\\\"start\\\":\\\"2025-01-01\\\",\\\"end\\\":\\\"2025-06-30\\\"}})[\\\"amount\\\"] == 150)\\n    admission = {\\\"id\\\":\\\"r\\\",\\\"kind\\\":\\\"ExtractionReading\\\",\\\"scope\\\":\\\"s\\\",\\\"provenance\\\":[\\\"p\\\"],\\\"dependencies\\\":[],\\\"source\\\":\\\"d\\\",\\\"locator\\\":\\\"p1\\\",\\\"review_decision\\\":\\\"Accept\\\"}\\n    observe(\\\"MC10\\\", lambda: admit_uncertainty(admission)[\\\"kind\\\"] == \\\"ExtractionReading\\\")\\n    debt = [{\\\"id\\\":\\\"a\\\",\\\"principal\\\":\\\"100\\\",\\\"rate\\\":\\\"1/20\\\",\\\"maturity\\\":\\\"2\\\"}, {\\\"id\\\":\\\"b\\\",\\\"principal\\\":\\\"50\\\",\\\"rate\\\":\\\"7/100\\\",\\\"maturity\\\":\\\"2\\\"}]\\n    query = {\\\"contract\\\":\\\"c\\\",\\\"context\\\":\\\"x\\\",\\\"evidence_view\\\":\\\"latest_available\\\",\\\"horizon\\\":\\\"1\\\",\\\"scenario\\\":\\\"base\\\",\\\"requested_outputs\\\":[\\\"interest\\\"],\\\"accrual_convention\\\":\\\"simple_actual_fraction\\\",\\\"group_by\\\":[\\\"rate\\\",\\\"maturity\\\",\\\"reset\\\",\\\"hedge\\\"]}\\n    observe(\\\"MC11\\\", lambda: resolve_bullet_debt(debt, query)[\\\"outputs\\\"][\\\"interest\\\"] == Fraction(17, 2))\\n    observe(\\\"MC14\\\", lambda: (lambda x: x[\\\"approximation\\\"][\\\"bound\\\"] == \\\"3/2\\\")(resolve_bullet_debt(debt, query, approximation={\\\"target_rate\\\":\\\"0.06\\\",\\\"tolerance\\\":\\\"2\\\",\\\"error_bound\\\":\\\"3/2\\\",\\\"scope\\\":\\\"fixed_rate_interest\\\",\\\"evidence\\\":[\\\"probe\\\"]})))\\n    return rows\\n\\n\\ndef main(argv=None) -> int:\\n    parser = argparse.ArgumentParser()\\n    parser.add_argument(\\\"--output-dir\\\", required=True)\\n    parser.add_argument(\\\"--approved-plan\\\", required=True)\\n    parser.add_argument(\\\"--execution-inventory\\\", required=True)\\n    parser.add_argument(\\\"--inject-failure\\\", action=\\\"store_true\\\", help=argparse.SUPPRESS)\\n    args = parser.parse_args(argv)\\n    out = Path(args.output_dir).resolve()\\n    if out != ROOT / \\\"data/accounting-master/deliverables/P06\\\":\\n        parser.error(\\\"use the declared P06 output directory\\\")\\n    started = time.monotonic(); started_utc = datetime.now(timezone.utc).isoformat()\\n    phase_inventory = str(Path(args.execution_inventory).parent.parent / \\\"phase-entry-inventory.json\\\")\\n    try:\\n        approved = approval_reference(ROOT, args.approved_plan)\\n        protected = protection(ROOT, phase_inventory, args.execution_inventory)\\n    except (OSError, ValueError) as exc:\\n        parser.error(str(exc))\\n    code_before = {p: digest(ROOT / p) for p in SOURCES}\\n    os.environ[\\\"CUDA_VISIBLE_DEVICES\\\"] = \\\"-1\\\"\\n    reports = {name: run_suite(name) for name in (\\\"test_accounting_p06\\\", \\\"test_accounting_p03\\\", \\\"test_accounting_p04\\\")}\\n    observations = probes()\\n    status = {\\\"required\\\": len(OBLIGATIONS), \\\"observed\\\": len(observations), \\\"missing\\\": sorted(set(OBLIGATIONS) - {x[\\\"id\\\"] for x in observations}), \\\"uncatalogued\\\": sorted({x[\\\"id\\\"] for x in observations} - set(OBLIGATIONS)), \\\"duplicate_ids\\\": [k for k, v in Counter(x[\\\"id\\\"] for x in observations).items() if v != 1], \\\"failed_observations\\\": [x[\\\"id\\\"] for x in observations if x.get(\\\"passed\\\") is not True]}\\n    code_after = {p: digest(ROOT / p) for p in SOURCES}\\n    protected = finish_protection(ROOT, protected)\\n    stable = all(code_before[p] == code_after[p] for p in SOURCES)\\n    passed = (all(x[\\\"passed\\\"] for x in reports.values()) and all(x.get(\\\"passed\\\") for x in observations) and not status[\\\"missing\\\"] and not status[\\\"uncatalogued\\\"] and not status[\\\"duplicate_ids\\\"] and protected[\\\"passed\\\"] and stable and not args.inject_failure)\\n    command_args = sys.argv[1:] if argv is None else argv\\n    command = shlex.join([\\\"CUDA_VISIBLE_DEVICES=-1\\\", \\\"python3\\\", \\\"-B\\\", \\\"scripts/check_accounting_p06.py\\\"] + command_args)\\n    payload = {\\\"schema_version\\\":\\\"accdsl.p06.conformance.v1\\\", \\\"passed\\\": bool(passed), \\\"profile\\\":\\\"context-chronology-resolution-v1\\\", \\\"obligation_status\\\":status, \\\"observations\\\":observations, \\\"tests\\\":reports, \\\"protection\\\":protected, \\\"code_stable_during_check\\\":stable, \\\"provenance\\\":{\\\"approved_plan\\\":approved, \\\"phase_entry_inventory\\\":phase_inventory, \\\"execution_inventory\\\":args.execution_inventory}, \\\"hashes\\\":code_after, \\\"manifest\\\":{\\\"git_commit\\\":\\\"unavailable: existing marker is not a usable repository\\\", \\\"command\\\":command, \\\"working_directory\\\":str(ROOT), \\\"executable\\\":sys.executable, \\\"environment\\\":{\\\"python\\\":platform.python_version()}, \\\"hardware\\\":\\\"CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported\\\", \\\"random_seeds\\\":\\\"N/A: exact deterministic fixtures\\\", \\\"data_version\\\":\\\"p06-context-chronology-cases-v1\\\", \\\"started_utc\\\":started_utc, \\\"wall_seconds\\\":round(time.monotonic()-started, 6), \\\"plan\\\":args.approved_plan, \\\"plan_sha256\\\":approved[\\\"sha256\\\"], \\\"approved_plan_hash\\\":approved[\\\"plan_hash\\\"], \\\"execution_inventory\\\":args.execution_inventory, \\\"outputs\\\":OUTPUTS, \\\"result\\\":OUTPUTS[1], \\\"phase_contribution_files\\\":SOURCES + OUTPUTS}, \\\"requirement_coverage\\\":{\\\"MC02\\\":\\\"context-aware mappings and explicit mismatch rejection\\\", \\\"MC05\\\":\\\"finite partition membership and overlap checks\\\", \\\"MC06\\\":\\\"chronology, availability and YTD selection\\\", \\\"MC07\\\":\\\"revision-compatible cumulative subtraction\\\", \\\"MC10\\\":\\\"six category uncertainty admission\\\", \\\"MC11\\\":\\\"query-bound unhedged bullet debt grouping\\\", \\\"MC14\\\":\\\"approximation certificate and error evidence\\\"}, \\\"acceptance\\\":{\\\"engineering\\\":bool(passed), \\\"accounting_validity\\\":\\\"not established\\\", \\\"forecast_validity\\\":\\\"not established\\\", \\\"human_acceptance\\\":\\\"pending\\\", \\\"whole_gap_closure\\\":False}}\\n    out.mkdir(parents=True, exist_ok=True)\\n    out.joinpath(\\\"conformance.json\\\").write_text(json.dumps(payload, indent=2, default=str) + \\\"\\\\n\\\")\\n    decision = \\\"PASS\\\" if passed else \\\"FAIL\\\"\\n    result_text = f'''# P06 context, chronology, and resolution result\\n\\n{decision}: {reports[\\\"test_accounting_p06\\\"][\\\"methods\\\"]} P06 tests, {reports[\\\"test_accounting_p03\\\"][\\\"methods\\\"]} P03 regression tests, and {reports[\\\"test_accounting_p04\\\"][\\\"methods\\\"]} P04 regression tests executed. The conformance file records every test outcome, independent criterion probe, source hash, inventory comparison, command, and manifest.\\n\\nThe implementation supplies explicit context mappings, finite partition enumeration, supersession-DAG evidence selection, date-only next-local-midnight handling, revision-compatible YTD subtraction, six category-specific uncertainty admission, information-view guards, and query-signature-bound fixed-rate unhedged bullet-debt resolution. Exact Fraction arithmetic is used throughout the supported scalar path. An approximation is accepted only with a fixed-rate scope, declared tolerance, and a triangle-inequality error certificate.\\n\\nThe tests independently verify 260 minus revised H1 110 equals H2 150 and reject subtraction using incompatible original H1 120. They reject parent/group, basis, measurement, currency, calendar, gross/net, overlap, omission, dangling/cyclic revision, future-information, unsupported treatment, unsupported scenario, stale-query, maturity-crossing, and missing-approximation-evidence cases. Historical byte availability marked unknown remains unresolved in evidence output.\\n\\n| Decision | Primary criterion | Veto status | Main uncertainty | Next justified action | Not concluded |\\n| --- | --- | --- | --- | --- | --- |\\n| {decision} for bounded engineering conformance | Independent P06 probes and focused/regression suites | tests={all(x[\\\"passed\\\"] for x in reports.values())}; protection={protected[\\\"passed\\\"]}; stable={stable}; failed_observations={status[\\\"failed_observations\\\"]} | finite synthetic cases and unannotated source availability | independent result review if PASS; repair if FAIL | professional accounting validity, empirical forecast validity, human acceptance, or wider MC01–MC35/G1–G18 closure |\\n\\nEngineering correctness, numerical validity, and interpretation remain separate. The exact outputs establish only the declared bounded operations. The strongest alternative explanation is a shared interpretation error in the synthetic fixtures; independent set and arithmetic probes reduce that risk but do not replace source or professional review. The weakest evidence is breadth: mappings, uncertainty, and grouping are finite bounded cases.\\n\\nResiduals: general measurement conversion, consolidation, arbitrary calendars, continuous or nonlinear uncertainty, empirical approximation validation, historical retained-byte availability, accounting validity, forecast validity, and human acceptance remain open. This phase does not rank stochastic candidates or establish a production default.\\n\\nActual command: `{command}`. Python {platform.python_version()}, CPU only with accelerator devices intentionally hidden. Wall time: {payload[\\\"manifest\\\"][\\\"wall_seconds\\\"]} seconds. Git provenance is unavailable; content hashes and supervisor inventories are retained in conformance.json.\\n'''\\n    out.joinpath(\\\"result.md\\\").write_text(result_text)\\n    print(json.dumps({\\\"passed\\\":bool(passed), \\\"tests\\\":{k:{x:v[x] for x in (\\\"methods\\\",\\\"failures\\\",\\\"errors\\\",\\\"skips\\\",\\\"passed\\\")} for k,v in reports.items()}, \\\"obligations\\\":status, \\\"protected\\\":protected[\\\"passed\\\"], \\\"stable\\\":stable}))\\n    return 0 if passed else 1\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '83,162p' tests/test_accounting_p06.py\\nsed -n '604,640p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '83,162p' tests/test_accounting_p06.py\\nsed -n '604,640p' scripts/context_chronology_v1.py\\\"\",\"aggregated_output\":\"        with self.assertRaisesRegex(P06Error, \\\"OVERLAPPING_PARTITION\\\"):\\n            check_partition([\\\"a\\\", \\\"b\\\"], {\\\"x\\\": [\\\"a\\\"], \\\"all\\\": [\\\"a\\\", \\\"b\\\"]}, axis=\\\"product\\\")\\n\\n\\nclass ChronologyYTDTests(unittest.TestCase):\\n    def test_original_latest_and_harmonised_selection(self):\\n        rows = assertions()\\n        original = select_evidence(rows, \\\"2025-12-31\\\", mode=\\\"original\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        self.assertEqual(original[\\\"selected_ids\\\"], [\\\"h1-original\\\"])\\n        latest = select_evidence(rows, \\\"2026-12-31\\\", mode=\\\"latest_available\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        self.assertEqual(set(latest[\\\"selected_ids\\\"]), {\\\"h1-revised\\\", \\\"fy25\\\"})\\n        harm = select_evidence(rows, \\\"2026-12-31\\\", mode=\\\"harmonised\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\", harmonisations=[{\\\"source_id\\\": \\\"h1-revised\\\", \\\"target_id\\\": \\\"sales-harmonised\\\", \\\"review_decision\\\": \\\"Accept\\\", \\\"provenance\\\": [\\\"review:1\\\"]}])\\n        self.assertEqual(harm[\\\"transformations\\\"][0][\\\"target_id\\\"], \\\"sales-harmonised\\\")\\n        self.assertTrue(harm[\\\"unresolved\\\"])\\n\\n    def test_cutoff_ingestion_and_date_only_boundary(self):\\n        row = {\\\"id\\\": \\\"d\\\", \\\"available\\\": \\\"2025-01-01\\\", \\\"ingested\\\": \\\"2025-01-01\\\", \\\"supersedes\\\": [], \\\"source\\\": \\\"x\\\"}\\n        before = select_evidence([row], \\\"2025-01-01T23:59:59+00:00\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        equal = select_evidence([row], \\\"2025-01-02T00:00:00+00:00\\\", timezone_name=\\\"UTC\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        self.assertEqual(before[\\\"selected_ids\\\"], [])\\n        self.assertEqual(equal[\\\"selected_ids\\\"], [\\\"d\\\"])\\n        with self.assertRaisesRegex(P06Error, \\\"DATE_ONLY_POLICY_REQUIRED\\\"):\\n            select_evidence([row], \\\"2025-01-02\\\", timezone_name=\\\"UTC\\\")\\n        with self.assertRaisesRegex(P06Error, \\\"TIMEZONE_REQUIRED\\\"):\\n            select_evidence([row], \\\"2025-01-02\\\", date_only_policy=\\\"next_local_midnight\\\")\\n        unknown = {\\\"id\\\": \\\"unknown\\\", \\\"available\\\": \\\"unknown\\\", \\\"supersedes\\\": [], \\\"source\\\": \\\"unretained\\\"}\\n        unresolved = select_evidence([unknown], \\\"2026-01-01T00:00:00+00:00\\\")\\n        self.assertEqual(unresolved[\\\"selected_ids\\\"], [])\\n        self.assertIn(\\\"source_availability_unestablished\\\", {x[\\\"reason\\\"] for x in unresolved[\\\"unresolved\\\"]})\\n\\n    def test_dangling_and_cyclic_supersession_rejected(self):\\n        bad = {\\\"id\\\": \\\"a\\\", \\\"available\\\": \\\"2025-01-01T00:00:00+00:00\\\", \\\"supersedes\\\": [\\\"z\\\"], \\\"source\\\": \\\"x\\\"}\\n        with self.assertRaisesRegex(P06Error, \\\"DANGLING_SUPERSESSION\\\"):\\n            select_evidence([bad], \\\"2026-01-01T00:00:00+00:00\\\")\\n        a = {\\\"id\\\": \\\"a\\\", \\\"available\\\": \\\"2025-01-01T00:00:00+00:00\\\", \\\"supersedes\\\": [\\\"b\\\"], \\\"source\\\": \\\"x\\\"}\\n        b = {\\\"id\\\": \\\"b\\\", \\\"available\\\": \\\"2025-01-01T00:00:00+00:00\\\", \\\"supersedes\\\": [\\\"a\\\"], \\\"source\\\": \\\"x\\\"}\\n        with self.assertRaisesRegex(P06Error, \\\"SUPERSESSION_CYCLE\\\"):\\n            select_evidence([a, b], \\\"2026-01-01T00:00:00+00:00\\\")\\n\\n    def test_ytd_valid_subtraction_uses_revised_h1(self):\\n        result = subtract_cumulative(\\n            {\\\"id\\\": \\\"fy\\\", \\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 260, \\\"concept\\\": \\\"sales\\\", \\\"context\\\": {\\\"entity\\\": \\\"A\\\"}, \\\"calendar\\\": \\\"gregorian\\\", \\\"revision_id\\\": \\\"r2\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}},\\n            {\\\"id\\\": \\\"h1\\\", \\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 110, \\\"concept\\\": \\\"sales\\\", \\\"context\\\": {\\\"entity\\\": \\\"A\\\"}, \\\"calendar\\\": \\\"gregorian\\\", \\\"revision_id\\\": \\\"r2\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-06-30\\\"}},\\n        )\\n        self.assertEqual(result[\\\"amount\\\"], F(150))\\n        self.assertEqual(result[\\\"period\\\"], {\\\"start\\\": \\\"2025-06-30\\\", \\\"end\\\": \\\"2025-12-31\\\"})\\n        with self.assertRaisesRegex(P06Error, \\\"REVISION_INCOMPATIBLE\\\"):\\n            subtract_cumulative({\\\"id\\\": \\\"fy\\\", \\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 260, \\\"concept\\\": \\\"sales\\\", \\\"context\\\": {\\\"entity\\\": \\\"A\\\"}, \\\"calendar\\\": \\\"gregorian\\\", \\\"revision_id\\\": \\\"r2\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}}, {\\\"id\\\": \\\"h1\\\", \\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 120, \\\"concept\\\": \\\"sales\\\", \\\"context\\\": {\\\"entity\\\": \\\"A\\\"}, \\\"calendar\\\": \\\"gregorian\\\", \\\"revision_id\\\": \\\"r1\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-06-30\\\"}})\\n\\n    def test_ytd_rejects_instant_start_and_nonnested(self):\\n        base = {\\\"kind\\\": \\\"cumulative\\\", \\\"amount\\\": 1, \\\"concept\\\": \\\"x\\\", \\\"context\\\": {}, \\\"calendar\\\": \\\"g\\\", \\\"revision_id\\\": \\\"r\\\", \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-06-30\\\"}}\\n        with self.assertRaisesRegex(P06Error, \\\"YTD_REQUIRES_CUMULATIVE\\\"):\\n            subtract_cumulative({**base, \\\"kind\\\": \\\"instant\\\"}, base)\\n        with self.assertRaisesRegex(P06Error, \\\"PERIOD_START_MISMATCH\\\"):\\n            subtract_cumulative({**base, \\\"period\\\": {\\\"start\\\": \\\"2025-02-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}}, base)\\n        with self.assertRaisesRegex(P06Error, \\\"REVISION_UNKNOWN\\\"):\\n            subtract_cumulative({**base, \\\"revision_id\\\": None, \\\"period\\\": {\\\"start\\\": \\\"2025-01-01\\\", \\\"end\\\": \\\"2025-12-31\\\"}}, {**base, \\\"revision_id\\\": None})\\n\\n\\nclass UncertaintyTests(unittest.TestCase):\\n    def _base(self, kind, **extra):\\n        row = {\\\"id\\\": kind.lower(), \\\"kind\\\": kind, \\\"scope\\\": \\\"demo\\\", \\\"provenance\\\": [\\\"fixture\\\"], \\\"dependencies\\\": []}\\n        row.update(extra)\\n        return row\\n\\n    def test_all_six_categories_and_dependencies(self):\\n        records = {}\\n        cases = [\\n            self._base(\\\"ExtractionReading\\\", source=\\\"doc\\\", locator=\\\"p1\\\", review_decision=\\\"Accept\\\"),\\n            self._base(\\\"HistoricalFact\\\", evidence=\\\"doc\\\", reason=\\\"dated\\\"),\\n            self._base(\\\"AccountingElection\\\", package=\\\"pkg\\\", permitted_treatments=[\\\"A\\\"], election=\\\"A\\\", effective_date=\\\"2025-01-01\\\", eligibility_evidence=\\\"memo\\\"),\\n            self._base(\\\"MeasurementEstimate\\\", method=\\\"direct\\\", measurement_date=\\\"2025-01-01\\\", inputs={\\\"x\\\": 1}),\\n            self._base(\\\"BehaviourPolicy\\\", policy=\\\"hold\\\", information_set=[\\\"past:price\\\"], decision_time=\\\"2025-01-01\\\"),\\n            self._base(\\\"FutureInnovation\\\", driver=\\\"shock\\\", future_period=\\\"2026\\\", scenario=\\\"base\\\", joint_law={\\\"atoms\\\":[{\\\"id\\\":\\\"a\\\",\\\"hypothesis\\\":{\\\"x\\\":0},\\\"weight\\\":\\\"1\\\"}]}, measure=\\\"real_world\\\"),\\n        ]\\n        for row in cases:\\n            records[row[\\\"id\\\"]] = admit_uncertainty(row, known_records=records)\\n        self.assertEqual(set(records), {x[\\\"id\\\"] for x in cases})\\n\\n    def test_uncertainty_negative_semantics(self):\\n              \\\"outputs\\\": output, \\\"constituent_ids\\\": [c.id for c in rows], \\\"fresh\\\": True}\\n    if approximation is not None:\\n        if not approximation.get(\\\"scope\\\") or approximation.get(\\\"scope\\\") != \\\"fixed_rate_interest\\\" or not approximation.get(\\\"evidence\\\"):\\n            fail(\\\"APPROXIMATION_EVIDENCE_REQUIRED\\\", \\\"declared scope and evidence are required\\\", \\\"approximation\\\")\\n        cert = interest_certificate(rows, approximation.get(\\\"target_rate\\\"), horizon)\\n        tolerance = _fraction(approximation.get(\\\"tolerance\\\"), \\\"approximation.tolerance\\\")\\n        declared = _fraction(approximation.get(\\\"error_bound\\\"), \\\"approximation.error_bound\\\")\\n        if tolerance < 0 or declared < cert[\\\"error\\\"] or declared > tolerance or declared < cert[\