{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '720,980p' scripts/context_chronology_v1.py\"","aggregated_output":"        if self.maturity <= 0 or not self.id:\n            fail(\"INVALID_DEBT\", \"positive maturity and ID required\")\n\n    @classmethod\n    def from_dict(cls, row: Mapping[str, Any]) -> \"DebtConstituent\":\n        principal = _fraction(row.get(\"principal\"), f\"{row.get('id')}.principal\")\n        if principal < 0:\n            fail(\"NEGATIVE_PRINCIPAL\", \"principal must be nonnegative\", str(row.get(\"id\")))\n        return cls(str(row[\"id\"]), principal, _fraction(row.get(\"rate\"), f\"{row.get('id')}.rate\"),\n                   _fraction(row.get(\"maturity\"), f\"{row.get('id')}.maturity\"), str(row.get(\"reset\", \"fixed\")), str(row.get(\"hedge\", \"unhedged\")))\n\n\ndef _query_signature(query: Mapping[str, Any]) -> str:\n    return hashlib.sha256(json.dumps(query, sort_keys=True, default=str, separators=(\",\", \":\")).encode()).hexdigest()\n\n\ndef interest_certificate(constituents: Sequence[DebtConstituent], target_rate: Fraction | str | int,\n                         horizon: Fraction | str | int) -> dict[str, Fraction]:\n    T = _fraction(horizon, \"horizon\")\n    if T < 0:\n        fail(\"INVALID_HORIZON\", \"horizon must be nonnegative\", \"horizon\")\n    rstar = _fraction(target_rate, \"target_rate\")\n    exact = sum((c.principal * c.rate * T for c in constituents), Fraction())\n    approx = sum((c.principal * rstar * T for c in constituents), Fraction())\n    bound = T * sum((c.principal * abs(c.rate - rstar) for c in constituents), Fraction())\n    difference = abs(exact - approx)\n    if difference > bound:\n        fail(\"INVALID_APPROXIMATION_CERTIFICATE\", \"triangle-inequality bound is violated\", \"approximation\")\n    return {\"exact\": exact, \"approximate\": approx, \"error\": difference, \"bound\": bound}\n\n\ndef resolve_bullet_debt(constituents: Sequence[DebtConstituent | Mapping[str, Any]], query: Mapping[str, Any], *,\n                       previous: Mapping[str, Any] | None = None,\n                       approximation: Mapping[str, Any] | None = None) -> dict[str, Any]:\n    rows = [x if isinstance(x, DebtConstituent) else DebtConstituent.from_dict(x) for x in constituents]\n    if not rows:\n        fail(\"EMPTY_DEBT_SET\", \"at least one constituent is required\", \"debt\")\n    required = (\"contract\", \"context\", \"evidence_view\", \"horizon\", \"scenario\", \"requested_outputs\", \"accrual_convention\", \"group_by\")\n    for key in required:\n        if key not in query:\n            fail(\"MISSING_QUERY_FIELD\", f\"missing {key}\", \"query\")\n    if len({c.id for c in rows}) != len(rows):\n        fail(\"DUPLICATE_CONSTITUENT\", \"debt IDs must be unique\")\n    signature = _query_signature({\"query\": query, \"constituents\": [vars(c) for c in rows]})\n    if previous is not None and previous.get(\"query_signature\") != signature:\n        fail(\"STALE_RESULT\", \"query changed; grouping sufficiency must be revalidated\", \"query\")\n    horizon = _fraction(query[\"horizon\"], \"query.horizon\")\n    if horizon < 0:\n        fail(\"INVALID_HORIZON\", \"horizon must be nonnegative\", \"query.horizon\")\n    if query[\"scenario\"] not in {\"base\", \"announced_stress\"}:\n        fail(\"UNSUPPORTED_SCENARIO\", str(query[\"scenario\"]), \"query.scenario\")\n    if query[\"accrual_convention\"] != \"simple_actual_fraction\":\n        fail(\"UNSUPPORTED_ACCRUAL\", str(query[\"accrual_convention\"]), \"query.accrual_convention\")\n    if not isinstance(query[\"requested_outputs\"], list) or not query[\"requested_outputs\"]:\n        fail(\"MISSING_OUTPUT_REQUEST\", \"requested_outputs must be nonempty\", \"query\")\n    unsupported_outputs = set(query[\"requested_outputs\"]) - {\"interest\", \"principal\"}\n    if unsupported_outputs:\n        fail(\"UNSUPPORTED_OUTPUT\", f\"unsupported outputs: {sorted(unsupported_outputs)}\", \"query.requested_outputs\")\n    dimensions = (\"rate\", \"maturity\", \"reset\", \"hedge\")\n    group_by = set(query[\"group_by\"])\n    if not group_by <= set(dimensions):\n        fail(\"UNSUPPORTED_GROUP_DIMENSION\", \"group_by contains unsupported dimension\", \"query.group_by\")\n    for dim in dimensions:\n        values = {getattr(c, dim) for c in rows}\n        if len(values) > 1 and dim not in group_by:\n            fail(\"GROUPING_INSUFFICIENT\", f\"dimension {dim} varies but is not grouped\", \"query.group_by\")\n    for c in rows:\n        if c.hedge != \"unhedged\":\n            fail(\"HEDGED_DEBT_UNSUPPORTED\", \"only unhedged debt is supported\", c.id)\n        if c.reset != \"fixed\":\n            fail(\"RESET_UNSUPPORTED\", \"only fixed reset is supported\", c.id)\n        if c.maturity <= horizon:\n            fail(\"MATURITY_CROSSING\", \"maturity crosses the requested horizon\", c.id)\n    groups: dict[tuple[Any, ...], list[DebtConstituent]] = {}\n    for c in rows:\n        key = tuple(getattr(c, dim) if dim in group_by else \"homogeneous\" for dim in dimensions)\n        groups.setdefault(key, []).append(c)\n    output: dict[str, Any] = {}\n    if \"interest\" in query[\"requested_outputs\"]:\n        output[\"interest\"] = sum((c.principal * c.rate * horizon for c in rows), Fraction())\n    if \"principal\" in query[\"requested_outputs\"]:\n        output[\"principal\"] = sum((c.principal for c in rows), Fraction())\n    result = {\"status\": \"resolved\", \"query_signature\": signature,\n              \"query\": json.loads(json.dumps(query, default=str)), \"groups\": [\n                  {\"key\": [str(x) for x in key], \"constituent_ids\": [c.id for c in members],\n                   \"principal\": sum((c.principal for c in members), Fraction()),\n                   \"interest\": sum((c.principal * c.rate * horizon for c in members), Fraction())}\n                  for key, members in groups.items()],\n              \"outputs\": output, \"constituent_ids\": [c.id for c in rows], \"constituents\": deepcopy(rows), \"fresh\": True}\n    if approximation is not None:\n        if not approximation.get(\"scope\") or approximation.get(\"scope\") != \"fixed_rate_interest\" or not approximation.get(\"evidence\"):\n            fail(\"APPROXIMATION_EVIDENCE_REQUIRED\", \"declared scope and evidence are required\", \"approximation\")\n        if approximation.get(\"query_signature\", signature) != signature:\n            fail(\"STALE_APPROXIMATION\", \"error evidence is for different query/constituents\")\n        cert = interest_certificate(rows, approximation.get(\"target_rate\"), horizon)\n        tolerance = _fraction(approximation.get(\"tolerance\"), \"approximation.tolerance\")\n        declared = _fraction(approximation.get(\"error_bound\"), \"approximation.error_bound\")\n        if tolerance < 0 or declared < cert[\"error\"] or declared > tolerance or declared < cert[\"bound\"]:\n            fail(\"APPROXIMATION_BOUND_INVALID\", \"declared bound must cover exact error and certificate within tolerance\", \"approximation\")\n        result[\"approximation\"] = {k: str(v) for k, v in cert.items()} | {\"tolerance\": str(tolerance), \"declared_error_bound\": str(declared), \"query_signature\": signature, \"evidence\": deepcopy(approximation[\"evidence\"])}\n    return result\n\n\ndef adapt_core_context(row: Mapping[str, Any], *, perimeter_version: str, gross_net: str,\n                       calendar: str, display: Mapping[str, Any] | None = None) -> Context:\n    \"\"\"Core 0 omits perimeter version/gross-net; require explicit supplements.\"\"\"\n    dimensions = row.get(\"dimensions\", [])\n    if len({d[\"axis\"] for d in dimensions}) != len(dimensions):\n        fail(\"INVALID_DIMENSIONS\", \"duplicate Core 0 axis\")\n    return Context.from_dict({k: row[k] for k in (\"concept\", \"entity\", \"perimeter\", \"basis\", \"measurement\", \"unit\", \"currency\")} |\n                             {\"perimeter_version\": perimeter_version, \"gross_net\": gross_net,\n                              \"calendar\": calendar, \"dimensions\": {d[\"axis\"]: d[\"member\"] for d in dimensions}} | dict(display or {}))\n\n\ndef adapt_p03_reading(binding: Any, context: Context, *, historical_byte_vintage: str = \"unknown\") -> dict[str, Any]:\n    if binding.currency != context.currency:\n        fail(\"CURRENCY_MISMATCH\", \"reading and context differ\")\n    return {\"id\": binding.key, \"kind\": \"instant\", \"amount\": _fraction(binding.amount),\n            \"concept\": context.concept, \"context\": context.as_dict(), \"calendar\": context.calendar,\n            \"period\": {\"start\": binding.instant, \"end\": None}, \"available\": binding.available,\n            \"ingested\": binding.ingested, \"source\": binding.filing_id, \"supersedes\": [],\n            \"historical_byte_vintage\": historical_byte_vintage, \"literal\": binding.literal,\n            \"review\": {\"reviewer\": binding.reviewer, \"date\": binding.review_date, \"reason\": binding.review_reason, \"action\": binding.action},\n            \"uri\": binding.uri, \"uncertainty\": \"ExtractionReading\"}\n\n\ndef adapt_p01_source(row: Mapping[str, Any]) -> dict[str, Any]:\n    # Filing metadata cannot establish availability of the retained bytes.\n    return {\"id\": row[\"document_id\"], \"source\": row[\"document_id\"], \"supersedes\": [],\n            \"available\": \"unknown\", \"historical_byte_vintage\": row.get(\"historical_byte_vintage\", \"unknown\"),\n            \"publication_metadata\": deepcopy(row.get(\"publication_metadata\")),\n            \"original_path\": row[\"original_path\"], \"original_sha256\": row[\"original_sha256\"]}\n\n\n@dataclass\nclass P06Engine:\n    contexts: dict[str, Context] = field(default_factory=dict)\n    mappings: list[MappingRule] = field(default_factory=list)\n    assertions: list[dict[str, Any]] = field(default_factory=list)\n    uncertainty: dict[str, dict[str, Any]] = field(default_factory=dict)\n    current_results: dict[str, dict[str, Any]] = field(default_factory=dict)\n    preserved_results: dict[str, dict[str, Any]] = field(default_factory=dict)\n\n    def add_context(self, identifier: str, context: Context | Mapping[str, Any]) -> None:\n        if identifier in self.contexts:\n            fail(\"DUPLICATE_CONTEXT\", identifier)\n        self.contexts[identifier] = context if isinstance(context, Context) else Context.from_dict(context)\n\n    def add_mapping(self, rule: MappingRule | Mapping[str, Any]) -> None:\n        rules = self.mappings + [rule if isinstance(rule, MappingRule) else MappingRule.from_dict(rule)]\n        _check_mapping_graph(rules)\n        self.mappings = rules\n        self.current_results.clear()\n\n    def add_assertion(self, row: Mapping[str, Any]) -> None:\n        rows = self.assertions + [deepcopy(row)]\n        _validate_assertions(rows)\n        self.assertions = rows\n        self.current_results.clear()\n\n    def revise(self, assertion_id: str, replacement: Mapping[str, Any]) -> None:\n        rows = {x[\"id\"]: x for x in self.assertions}\n        if assertion_id not in rows:\n            fail(\"UNKNOWN_ASSERTION\", assertion_id)\n        replacement = deepcopy(replacement)\n        replacement.setdefault(\"supersedes\", [assertion_id])\n        if replacement.get(\"id\") in rows or assertion_id not in replacement[\"supersedes\"]:\n            fail(\"INVALID_REVISION\", \"revision needs new ID and explicit supersession\")\n        candidate = self.assertions + [replacement]\n        _validate_assertions(candidate)\n        self.assertions = candidate\n        for key in list(self.current_results):\n            if assertion_id in self.current_results[key][\"dependencies\"]:\n                del self.current_results[key]\n\n    def preserve_result(self, result_id: str = \"current\") -> dict[str, Any]:\n        if result_id not in self.current_results:\n            fail(\"UNKNOWN_RESULT\", result_id)\n        self.preserved_results[result_id] = deepcopy(self.current_results[result_id])\n        return deepcopy(self.preserved_results[result_id])\n\n    def evaluate(self, request: Mapping[str, Any]) -> dict[str, Any]:\n        evidence = select_evidence(self.assertions, request[\"cutoff\"], mode=request.get(\"evidence_view\", \"latest_available\"),\n                                   system_as_of=request.get(\"system_as_of\"), timezone_name=request.get(\"timezone\"),\n                                   date_only_policy=request.get(\"date_only_policy\"), harmonisations=request.get(\"harmonisations\", ()),\n                                   require_known_bytes=request.get(\"require_known_bytes\", True))\n        for key in (\"source_context\", \"target_context\"):\n            if request[key] not in self.contexts:\n                fail(\"UNKNOWN_CONTEXT\", request[key])\n        mapping = compatible_context(self.contexts[request[\"source_context\"]], self.contexts[request[\"target_context\"]], self.mappings, at=request.get(\"as_of\"))\n        rows = {x[\"id\"]: x for x in self.assertions}\n        def descends(row, identifier):\n            return row[\"id\"] == identifier or any(descends(rows[p], identifier) for p in row.get(\"supersedes\", ()))\n        def choose(identifier):\n            options = [x for x in evidence[\"selected\"] if descends(x, identifier)]\n            if len(options) != 1:\n                fail(\"EVIDENCE_UNAVAILABLE_OR_CONFLICTING\", identifier)\n            return options[0]\n        derived = None\n        if request.get(\"derive\"):\n            d = request[\"derive\"]\n            total, earlier = choose(d[\"total\"]), choose(d[\"earlier\"])\n            for row in (total, earlier):\n                compatible_context(row[\"context\"], self.contexts[request[\"source_context\"]])\n            derived = subtract_cumulative(total, earlier, revision_compatibility=d.get(\"revision_compatibility\"))\n            derived[\"mapped_concept\"] = mapping[\"target\"][\"concept\"]\n        registry = deepcopy(self.uncertainty)\n        for key, value in request.get(\"registry\", {}).items():\n            if key in registry and registry[key] != value:\n                fail(\"DUPLICATE_ADMISSION_ID\", key)\n            registry[key] = deepcopy(value)\n        information = None\n        if request.get(\"information_view\"):\n            information = guard_information_view(request[\"information_view\"], event_time=request[\"decision_time\"], request=request.get(\"scenario_mode\", \"exogenous_stress\"))\n        elif request.get(\"scenario_mode\", \"exogenous_stress\") != \"exogenous_stress\":\n            fail(\"UNSUPPORTED_INFORMATION_OPERATION\", request[\"scenario_mode\"])\n        admitted = []\n        for row in request.get(\"uncertainty\", ()):\n            value = admit_uncertainty(row, known_records=registry, available_information=information[\"visible\"] if information else ())\n            if row[\"id\"] in registry and registry[row[\"id\"]] != value:\n                fail(\"DUPLICATE_ADMISSION_ID\", row[\"id\"])\n            admitted.append(value)\n            registry[row[\"id\"]] = value\n        constituents = deepcopy(request[\"constituents\"])\n        for row in constituents:\n            if \"principal_from\" in row:\n                ref = row.pop(\"principal_from\")\n                if ref == \"derived\":\n                    if derived is None:\n                        fail(\"MISSING_DERIVATION\", \"principal references derived period\")\n                    row[\"principal\"] = derived[\"amount\"]\n                else:\n                    row[\"principal\"] = choose(ref)[\"amount\"]\n        query = deepcopy(request[\"query\"])\n        if query[\"evidence_view\"] != evidence[\"mode\"] or query[\"context\"] != request[\"target_context\"]:\n            fail(\"QUERY_CONTEXT_MISMATCH\", \"query must match selected view and mapped context\")\n        if query[\"scenario\"] == \"announced_stress\" and information is None:\n            fail(\"MISSING_INFORMATION_VIEW\", \"announced stress requires dated information\")\n        query[\"evidence_digest\"] = _query_signature(evidence)\n        resolution = resolve_bullet_debt(constituents, query, approximation=request.get(\"approximation\"))\n        result = {\"evidence\": evidence, \"mapping\": mapping, \"derived\": derived, \"uncertainty\": admitted,\n                  \"information\": information, \"resolution\": resolution, \"dependencies\": list(rows),\n                  \"input_sha256\": _query_signature({\"request\": request, \"assertions\": self.assertions, \"contexts\": {k:v.as_dict() for k,v in self.contexts.items()}, \"registry\": registry})}\n        self.uncertainty = registry\n        self.current_results[request.get(\"result_id\", \"current\")] = deepcopy(result)\n        return result\n\n\n__all__ = [\"P06Error\", \"Context\", \"MappingRule\", \"compatible_context\", \"map_context\", \"map_components\", \"combine_partitions\",\n           \"select_evidence\", \"subtract_cumulative\", \"admit_uncertainty\", \"guard_information_view\",\n           \"DebtConstituent\", \"interest_certificate\", \"resolve_bullet_debt\", \"P06Engine\",\n           \"adapt_core_context\", \"adapt_p03_reading\", \"adapt_p01_source\"]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' tests/test_accounting_p06.py\"","aggregated_output":"\"\"\"Deterministic P06 conformance tests with independent arithmetic/set oracles.\"\"\"\nfrom datetime import date\nfrom fractions import Fraction as F\nfrom pathlib import Path\nimport copy\nimport json\nimport sys\nimport unittest\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / \"scripts\"))\nfrom context_chronology_v1 import (  # noqa: E402\n    Context, DebtConstituent, MappingRule, P06Engine, P06Error,\n    map_components, combine_partitions, adapt_core_context, adapt_p03_reading, adapt_p01_source,\n    admit_uncertainty, check_partition, compatible_context, guard_information_view,\n    interest_certificate, resolve_bullet_debt, select_evidence, subtract_cumulative,\n)\n\n\ndef ctx(**overrides):\n    row = {\n        \"concept\": \"revenue\", \"entity\": \"Acme\", \"perimeter\": \"Acme\", \"perimeter_version\": \"2026\",\n        \"basis\": \"GAAP\", \"measurement\": \"historical_cost\", \"unit\": \"USD\", \"currency\": \"USD\",\n        \"calendar\": \"gregorian\", \"dimensions\": {\"segment\": \"retail\"}, \"gross_net\": \"gross\",\n    }\n    row.update(overrides)\n    return Context.from_dict(row)\n\n\ndef assertions():\n    return [\n        {\"id\": \"h1-original\", \"concept\": \"sales\", \"value\": \"120\", \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-06-30\"}, \"available\": \"2025-08-01\", \"ingested\": \"2025-08-02\", \"supersedes\": [], \"source\": \"fixture:original\", \"historical_byte_vintage\": \"unknown\"},\n        {\"id\": \"h1-revised\", \"concept\": \"sales\", \"value\": \"110\", \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-06-30\"}, \"available\": \"2026-02-01\", \"ingested\": \"2026-02-02\", \"supersedes\": [\"h1-original\"], \"source\": \"fixture:revision\", \"historical_byte_vintage\": \"unknown\"},\n        {\"id\": \"fy25\", \"concept\": \"sales\", \"value\": \"260\", \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-12-31\"}, \"available\": \"2026-02-01\", \"ingested\": \"2026-02-02\", \"supersedes\": [], \"source\": \"fixture:annual\", \"historical_byte_vintage\": \"unknown\"},\n    ]\n\n\nclass ContextPartitionTests(unittest.TestCase):\n    def test_equivalent_context_mapping_and_spelling_preserved(self):\n        source, target = ctx(concept=\"sales\", scale=\"thousands\", sign=\"credit\", precision=2), ctx(concept=\"revenue\", scale=\"thousands\", sign=\"credit\", precision=2)\n        rule = MappingRule(\"sales\", \"revenue\", provenance=(\"fixture:review\",))\n        witness = compatible_context(source, target, [rule], at=\"2026-01-01\")\n        self.assertEqual(witness[\"kind\"], \"equivalent\")\n        self.assertEqual(witness[\"source\"][\"concept\"], \"sales\")\n        self.assertEqual(witness[\"target\"][\"concept\"], \"revenue\")\n        self.assertEqual(witness[\"source\"][\"scale\"], \"thousands\")\n        self.assertEqual(witness[\"source\"][\"precision\"], 2)\n\n    def test_context_rejects_parent_basis_measurement_currency_calendar_gross_net(self):\n        for field, a, b, code in [\n            (\"perimeter\", \"Acme\", \"Group\", \"PARENT_GROUP_MISMATCH\"),\n            (\"perimeter_version\", \"2026\", \"2025\", \"PERIMETER_VERSION_MISMATCH\"),\n            (\"basis\", \"GAAP\", \"IFRS\", \"BASIS_MISMATCH\"),\n            (\"measurement\", \"historical_cost\", \"fair_value\", \"MEASUREMENT_MISMATCH\"),\n            (\"currency\", \"USD\", \"EUR\", \"CURRENCY_MISMATCH\"),\n            (\"calendar\", \"gregorian\", \"fiscal_445\", \"CALENDAR_MISMATCH\"),\n            (\"gross_net\", \"gross\", \"net\", \"GROSS_NET_MISMATCH\"),\n        ]:\n            with self.subTest(field=field):\n                with self.assertRaisesRegex(P06Error, code):\n                    compatible_context(ctx(**{field: a}), ctx(**{field: b}))\n\n    def test_expired_cycle_and_measurement_conversion_rejected(self):\n        with self.assertRaisesRegex(P06Error, \"CONTEXT_MISMATCH\"):\n            compatible_context(ctx(concept=\"a\"), ctx(concept=\"b\"), [MappingRule(\"a\", \"b\", effective_end=date(2025, 1, 1), provenance=(\"x\",))], at=\"2026-01-01\")\n        with self.assertRaisesRegex(P06Error, \"MAPPING_CYCLE\"):\n            compatible_context(ctx(concept=\"a\"), ctx(concept=\"b\"), [MappingRule(\"a\", \"b\", provenance=(\"x\",)), MappingRule(\"b\", \"a\", provenance=(\"y\",))])\n        with self.assertRaisesRegex(P06Error, \"UNSUPPORTED_MEASUREMENT_CONVERSION\"):\n            compatible_context(ctx(concept=\"a\"), ctx(concept=\"b\"), [MappingRule(\"a\", \"b\", conversion=\"USD_to_EUR\", provenance=(\"x\",))])\n        with self.assertRaisesRegex(P06Error, \"UNSUPPORTED_MEASUREMENT_CONVERSION\"):\n            compatible_context(ctx(concept=\"a\", scale=\"units\"), ctx(concept=\"a\", scale=\"thousands\"))\n\n    def test_partition_independent_enumeration_and_unknown_residual(self):\n        ok = check_partition([\"e1\", \"e2\", \"e3\"], {\"north\": [\"e1\"], \"south\": [\"e2\", \"e3\"]}, axis=\"geo\")\n        self.assertTrue(ok[\"complete\"])\n        for members in ({\"north\": [\"e1\", \"e2\"], \"south\": [\"e2\", \"e3\"]}, {\"north\": [\"e1\"]}):\n            with self.assertRaisesRegex(P06Error, \"OVERLAPPING_PARTITION|INCOMPLETE_PARTITION\"):\n                check_partition([\"e1\", \"e2\", \"e3\"], members, axis=\"geo\")\n        with self.assertRaisesRegex(P06Error, \"UNKNOWN_RESIDUAL\"):\n            check_partition([\"e1\", \"e2\"], {\"north\": [\"e1\"]}, residual={\"members\": [\"e2\"], \"known\": False}, axis=\"geo\")\n\n    def test_partition_population_and_axis_prevent_double_counting(self):\n        self.assertEqual(check_partition([\"a\", \"b\"], {\"x\": [\"a\"], \"y\": [\"b\"]}, axis=\"product\")[\"axis\"], \"product\")\n        with self.assertRaisesRegex(P06Error, \"OVERLAPPING_PARTITION\"):\n            check_partition([\"a\", \"b\"], {\"x\": [\"a\"], \"all\": [\"a\", \"b\"]}, axis=\"product\")\n\n\nclass ChronologyYTDTests(unittest.TestCase):\n    def test_original_latest_and_harmonised_selection(self):\n        rows = assertions()\n        original = select_evidence(rows, \"2025-12-31\", mode=\"original\", timezone_name=\"UTC\", date_only_policy=\"next_local_midnight\")\n        self.assertEqual(original[\"selected_ids\"], [\"h1-original\"])\n        latest = select_evidence(rows, \"2026-12-31\", mode=\"latest_available\", timezone_name=\"UTC\", date_only_policy=\"next_local_midnight\")\n        self.assertEqual(set(latest[\"selected_ids\"]), {\"h1-revised\", \"fy25\"})\n        harm = select_evidence(rows, \"2026-12-31\", mode=\"harmonised\", timezone_name=\"UTC\", date_only_policy=\"next_local_midnight\", harmonisations=[{\"source_id\": \"h1-revised\", \"target_id\": \"sales-harmonised\", \"review_decision\": \"Accept\", \"provenance\": [\"review:1\"]}])\n        self.assertEqual(harm[\"transformations\"][0][\"target_id\"], \"sales-harmonised\")\n        self.assertTrue(harm[\"unresolved\"])\n\n    def test_cutoff_ingestion_and_date_only_boundary(self):\n        row = {\"id\": \"d\", \"available\": \"2025-01-01\", \"ingested\": \"2025-01-01\", \"supersedes\": [], \"source\": \"x\"}\n        before = select_evidence([row], \"2025-01-01T23:59:59+00:00\", timezone_name=\"UTC\", date_only_policy=\"next_local_midnight\")\n        equal = select_evidence([row], \"2025-01-02T00:00:00+00:00\", timezone_name=\"UTC\", date_only_policy=\"next_local_midnight\")\n        self.assertEqual(before[\"selected_ids\"], [])\n        self.assertEqual(equal[\"selected_ids\"], [\"d\"])\n        with self.assertRaisesRegex(P06Error, \"DATE_ONLY_POLICY_REQUIRED\"):\n            select_evidence([row], \"2025-01-02\", timezone_name=\"UTC\")\n        with self.assertRaisesRegex(P06Error, \"TIMEZONE_REQUIRED\"):\n            select_evidence([row], \"2025-01-02\", date_only_policy=\"next_local_midnight\")\n        unknown = {\"id\": \"unknown\", \"available\": \"unknown\", \"supersedes\": [], \"source\": \"unretained\"}\n        unresolved = select_evidence([unknown], \"2026-01-01T00:00:00+00:00\")\n        self.assertEqual(unresolved[\"selected_ids\"], [])\n        self.assertIn(\"source_availability_unestablished\", {x[\"reason\"] for x in unresolved[\"unresolved\"]})\n\n    def test_dangling_and_cyclic_supersession_rejected(self):\n        bad = {\"id\": \"a\", \"available\": \"2025-01-01T00:00:00+00:00\", \"supersedes\": [\"z\"], \"source\": \"x\"}\n        with self.assertRaisesRegex(P06Error, \"DANGLING_SUPERSESSION\"):\n            select_evidence([bad], \"2026-01-01T00:00:00+00:00\")\n        a = {\"id\": \"a\", \"available\": \"2025-01-01T00:00:00+00:00\", \"supersedes\": [\"b\"], \"source\": \"x\"}\n        b = {\"id\": \"b\", \"available\": \"2025-01-01T00:00:00+00:00\", \"supersedes\": [\"a\"], \"source\": \"x\"}\n        with self.assertRaisesRegex(P06Error, \"SUPERSESSION_CYCLE\"):\n            select_evidence([a, b], \"2026-01-01T00:00:00+00:00\")\n\n    def test_ytd_valid_subtraction_uses_revised_h1(self):\n        result = subtract_cumulative(\n            {\"id\": \"fy\", \"kind\": \"cumulative\", \"amount\": 260, \"concept\": \"sales\", \"context\": {\"entity\": \"A\"}, \"calendar\": \"gregorian\", \"revision_id\": \"r2\", \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-12-31\"}},\n            {\"id\": \"h1\", \"kind\": \"cumulative\", \"amount\": 110, \"concept\": \"sales\", \"context\": {\"entity\": \"A\"}, \"calendar\": \"gregorian\", \"revision_id\": \"r2\", \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-06-30\"}},\n        )\n        self.assertEqual(result[\"amount\"], F(150))\n        self.assertEqual(result[\"period\"], {\"start\": \"2025-06-30\", \"end\": \"2025-12-31\"})\n        with self.assertRaisesRegex(P06Error, \"REVISION_INCOMPATIBLE\"):\n            subtract_cumulative({\"id\": \"fy\", \"kind\": \"cumulative\", \"amount\": 260, \"concept\": \"sales\", \"context\": {\"entity\": \"A\"}, \"calendar\": \"gregorian\", \"revision_id\": \"r2\", \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-12-31\"}}, {\"id\": \"h1\", \"kind\": \"cumulative\", \"amount\": 120, \"concept\": \"sales\", \"context\": {\"entity\": \"A\"}, \"calendar\": \"gregorian\", \"revision_id\": \"r1\", \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-06-30\"}})\n\n    def test_ytd_rejects_instant_start_and_nonnested(self):\n        base = {\"kind\": \"cumulative\", \"amount\": 1, \"concept\": \"x\", \"context\": {}, \"calendar\": \"gregorian\", \"revision_id\": \"r\", \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-06-30\"}}\n        with self.assertRaisesRegex(P06Error, \"YTD_REQUIRES_CUMULATIVE\"):\n            subtract_cumulative({**base, \"kind\": \"instant\"}, base)\n        with self.assertRaisesRegex(P06Error, \"PERIOD_START_MISMATCH\"):\n            subtract_cumulative({**base, \"period\": {\"start\": \"2025-02-01\", \"end\": \"2025-12-31\"}}, base)\n        with self.assertRaisesRegex(P06Error, \"REVISION_UNKNOWN\"):\n            subtract_cumulative({**base, \"revision_id\": None, \"period\": {\"start\": \"2025-01-01\", \"end\": \"2025-12-31\"}}, {**base, \"revision_id\": None})\n\n\ndef registry():\n    return {\n        \"doc\": {\"kind\": \"Source\", \"locators\": [\"p1\"]},\n        \"memo\": {\"review_decision\": \"Accept\", \"package\": \"pkg\", \"scope\": \"demo\", \"eligible_treatments\": [\"A\"]},\n        \"pkg\": {\"kind\": \"AccountingPackage\", \"scope\": \"demo\", \"review_decision\": \"Accept\", \"start\": \"2025-01-01\", \"end\": \"2026-01-01\", \"permitted_treatments\": [\"A\"]},\n        \"input\": {\"review_decision\": \"Accept\", \"available_date\": \"2025-01-01\", \"value\": \"10\"},\n        \"past\": {\"kind\": \"Information\", \"available_date\": \"2025-01-01\", \"event_date\": \"2025-01-01\", \"information_kind\": \"observation\"},\n        \"stress\": {\"kind\": \"Information\", \"available_date\": \"2025-01-01\", \"event_date\": \"2026-01-01\", \"information_kind\": \"announced_stress\"},\n    }\n\n\ndef admission_cases():\n    specific = [\n        (\"ExtractionReading\", dict(source=\"doc\", locator=\"p1\", review_decision=\"Accept\")),\n        (\"HistoricalFact\", dict(evidence=[\"memo\"], reason=\"finite unknown\", domain=[\"1\", \"2\"], evidence_constraints=[{\"evidence\": \"memo\", \"lower\": \"1\", \"upper\": \"2\"}])),\n        (\"AccountingElection\", dict(package=\"pkg\", permitted_treatments=[\"A\"], election=\"A\", effective_date=\"2025-01-01\", eligibility_evidence=\"memo\")),\n        (\"MeasurementEstimate\", dict(method=\"direct\", measurement_date=\"2025-01-01\", inputs={\"value\": \"input\"})),\n        (\"BehaviourPolicy\", dict(policy=\"hold\", information_set=[\"past\"], decision_time=\"2025-01-01\")),\n        (\"FutureInnovation\", dict(driver=\"shock\", future_period={\"start\": \"2026-01-01\", \"end\": \"2027-01-01\"}, decision_time=\"2025-01-01\", scenario=\"base\", joint_law={\"measure\": \"real_world\", \"atoms\":[{\"id\":\"a\",\"hypothesis\":{\"shock\":0},\"weight\":\"1\"}]}, measure=\"real_world\")),\n    ]\n    return [{\"id\": k, \"kind\": k, \"scope\": \"demo\", \"provenance\": [\"fixture\"], \"dependencies\": [], **v} for k,v in specific]\n\n\nclass UncertaintyTests(unittest.TestCase):\n    def test_all_six_categories(self):\n        for row in admission_cases():\n            with self.subTest(kind=row[\"kind\"]):\n                result = admit_uncertainty(row, known_records=registry(), available_information=[\"past\"])\n                self.assertEqual(result[\"kind\"], row[\"kind\"])\n                if row[\"kind\"] == \"MeasurementEstimate\":\n                    self.assertEqual(result[\"admitted_value\"], F(10))\n\n    def test_category_specific_rejections(self):\n        cases = admission_cases()\n        changes = [\n            (0, {\"source\": \"missing\"}, \"UNRESOLVED_ADMISSION_REFERENCE\"),\n            (0, {\"locator\": \"p2\"}, \"UNRESOLVED_LOCATOR\"),\n            (0, {\"review_decision\": \"Reject\"}, \"READING_NOT_ACCEPTED\"),\n            (1, {\"domain\": []}, \"HISTORICAL_DOMAIN_REQUIRED\"),\n            (1, {\"domain\": [\"3\"]}, \"HISTORICAL_CONSTRAINT_VIOLATION\"),\n            (2, {\"election\": \"B\"}, \"TREATMENT_NOT_PERMITTED\"),\n            (2, {\"effective_date\": \"2026-01-01\"}, \"PACKAGE_NOT_EFFECTIVE\"),\n            (2, {\"permitted_treatments\": [\"A\", \"B\"]}, \"TREATMENT_NOT_PERMITTED\"),\n            (3, {\"inputs\": {\"value\": None}}, \"MISSING_ESTIMATE_INPUT\"),\n            (3, {\"measurement_date\": \"2024-12-31\"}, \"ESTIMATE_INPUT_UNAVAILABLE\"),\n            (3, {\"method\": \"magic\"}, \"UNSUPPORTED_ESTIMATION_METHOD\"),\n            (4, {\"information_set\": [\"stress\"]}, \"FUTURE_INFORMATION_LEAKAGE\"),\n            (4, {\"decision_time\": \"2024-12-31\"}, \"FUTURE_INFORMATION_LEAKAGE\"),\n            (5, {\"measure\": \"pricing\"}, \"INCOMPATIBLE_PROBABILITY_MEASURE\"),\n            (5, {\"decision_time\": \"2026-01-01\"}, \"INVALID_FUTURE_PERIOD\"),\n            (5, {\"scenario\": \"conditioned\"}, \"UNSUPPORTED_SCENARIO\"),\n            (0, {\"kind\": \"Mystery\"}, \"UNKNOWN_UNCERTAINTY_CATEGORY\"),\n        ]\n        for index, patch, code in changes:\n            with self.subTest(code=code), self.assertRaisesRegex(P06Error, code):\n                admit_uncertainty({**cases[index], **patch}, known_records=registry(), available_information=[\"past\"])\n\n    def test_dependencies_and_joint_law(self):\n        row = admission_cases()[1]\n        for known, deps, code in [({}, [\"absent\"], \"DANGLING_DEPENDENCY\"), ({\"x\": {\"dependencies\": [\"absent\"]}}, [\"x\"], \"DANGLING_DEPENDENCY\"), ({\"x\": {\"dependencies\": [row[\"id\"]]}}, [\"x\"], \"CYCLIC_DEPENDENCY\")]:\n            with self.assertRaisesRegex(P06Error, code):\n                admit_uncertainty({**row, \"dependencies\": deps}, known_records=known)\n        innovation = admission_cases()[5]\n        for atoms in [\n            [{\"id\":\"a\",\"hypothesis\":{\"shock\":0},\"weight\":\"1/2\"}],\n            [{\"id\":\"a\",\"hypothesis\":{\"shock\":0},\"weight\":\"1/2\"},{\"id\":\"b\",\"hypothesis\":{\"other\":1},\"weight\":\"1/2\"}],\n            [{\"id\":\"a\",\"hypothesis\":{\"shock\":0},\"weight\":\"1/2\"},{\"id\":\"b\",\"hypothesis\":{\"shock\":0},\"weight\":\"1/2\"}],\n        ]:\n            with self.assertRaisesRegex(P06Error, \"INVALID_JOINT_LAW\"):\n                admit_uncertainty({**innovation, \"joint_law\": {\"measure\":\"real_world\",\"atoms\":atoms}})\n\n    def test_information_view_dates_and_modes(self):\n        view = {\"visible\": [\"past\", \"stress\"], \"future_announced\": [\"stress\"], \"future_realised\": [\"outcome\"], \"records\": registry(), \"measure_id\": \"P\", \"pricing_measure_id\": \"Q\"}\n        saved = copy.deepcopy(view)\n        self.assertFalse(guard_information_view(view, event_time=\"2025-01-01\")[\"selection_changes_history\"])\n        self.assertEqual(view, saved)\n        for patch, mode, code in [({\"future_announced\": []}, \"exogenous_stress\", \"FUTURE_INFORMATION_LEAKAGE\"), ({\"visible\":[\"outcome\"]}, \"exogenous_stress\", \"FUTURE_INFORMATION_LEAKAGE\"), ({\"pricing_measure_id\":\"P\"}, \"exogenous_stress\", \"INCOMPATIBLE_PROBABILITY_MEASURE\"), ({}, \"structural_intervention\", \"UNSUPPORTED_INFORMATION_OPERATION\"), ({}, \"observational_conditioning\", \"UNSUPPORTED_INFORMATION_OPERATION\"), ({}, \"typo\", \"UNSUPPORTED_INFORMATION_OPERATION\")]:\n            with self.assertRaisesRegex(P06Error, code):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '220,460p' tests/test_accounting_p06.py\"","aggregated_output":"            with self.assertRaisesRegex(P06Error, code):\n                guard_information_view({**view, **patch}, event_time=\"2025-01-01\", request=mode)\n\n\nclass ResolutionTests(unittest.TestCase):\n    def rows(self):\n        return [DebtConstituent(\"a\", F(100), F(5, 100), F(2)), DebtConstituent(\"b\", F(50), F(7, 100), F(2))]\n\n    def query(self, **extra):\n        q = {\"contract\": \"bullet-v1\", \"context\": \"usd\", \"evidence_view\": \"latest_available\", \"horizon\": \"1\", \"scenario\": \"base\", \"requested_outputs\": [\"interest\", \"principal\"], \"accrual_convention\": \"simple_actual_fraction\", \"group_by\": [\"rate\", \"maturity\", \"reset\", \"hedge\"]}\n        q.update(extra)\n        return q\n\n    def test_exact_grouped_resolution_and_independent_oracle(self):\n        result = resolve_bullet_debt(self.rows(), self.query())\n        self.assertEqual(result[\"outputs\"][\"interest\"], F(17, 2))\n        self.assertEqual(result[\"outputs\"][\"principal\"], F(150))\n        self.assertEqual(sum(g[\"interest\"] for g in result[\"groups\"]), F(17, 2))\n\n    def test_query_horizon_scenario_and_grouping_sufficiency(self):\n        with self.assertRaisesRegex(P06Error, \"GROUPING_INSUFFICIENT\"):\n            resolve_bullet_debt(self.rows(), self.query(group_by=[\"maturity\", \"reset\", \"hedge\"]))\n        with self.assertRaisesRegex(P06Error, \"UNSUPPORTED_SCENARIO\"):\n            resolve_bullet_debt(self.rows(), self.query(scenario=\"future_realised\"))\n        with self.assertRaisesRegex(P06Error, \"MATURITY_CROSSING\"):\n            resolve_bullet_debt(self.rows(), self.query(horizon=\"3\"))\n\n    def test_approximation_requires_declared_error_evidence(self):\n        with self.assertRaisesRegex(P06Error, \"APPROXIMATION_EVIDENCE_REQUIRED\"):\n            resolve_bullet_debt(self.rows(), self.query(), approximation={\"target_rate\": \"0.06\", \"tolerance\": \"1\", \"error_bound\": \"1\"})\n        result = resolve_bullet_debt(self.rows(), self.query(), approximation={\"target_rate\": \"0.06\", \"tolerance\": \"2\", \"error_bound\": \"3/2\", \"scope\": \"fixed_rate_interest\", \"evidence\": [\"certificate:triangle\"]})\n        self.assertEqual(result[\"approximation\"][\"error\"], \"1/2\")\n        self.assertEqual(result[\"approximation\"][\"bound\"], \"3/2\")\n\n    def test_stale_result_and_unsupported_dynamics(self):\n        previous = resolve_bullet_debt(self.rows(), self.query())\n        with self.assertRaisesRegex(P06Error, \"STALE_RESULT\"):\n            resolve_bullet_debt(self.rows(), self.query(horizon=\"2\"), previous=previous)\n        with self.assertRaisesRegex(P06Error, \"RESET_UNSUPPORTED\"):\n            resolve_bullet_debt([DebtConstituent(\"a\", F(1), F(1, 10), F(2), reset=\"floating\")], self.query(group_by=[\"rate\", \"maturity\", \"reset\", \"hedge\"]))\n\n\nclass RepairRegressionTests(unittest.TestCase):\n    def test_finite_component_mapping_and_cross_axis_double_count(self):\n        source,target=ctx(concept=\"sales\"),ctx(concept=\"revenue\")\n        rule=MappingRule(\"sales\",\"revenue\",kind=\"component\",provenance=(\"review\",))\n        result=map_components(source,target,rule,population=[\"a\",\"b\"],members={\"one\":[\"a\"],\"two\":[\"b\"]},values={\"a\":\"3\",\"b\":\"5\"},axis=\"product\",at=\"2025-01-01\")\n        self.assertEqual(result[\"amount\"],8)\n        other=check_partition([\"a\",\"b\"],{\"north\":[\"a\",\"b\"]},axis=\"geography\")\n        with self.assertRaisesRegex(P06Error,\"OVERLAPPING_CLASSIFICATIONS\"):\n            combine_partitions([result[\"partition\"],other])\n        with self.assertRaisesRegex(P06Error,\"PARTITION_WITNESS_REQUIRED\"):\n            compatible_context(source,target,[rule])\n        residual=check_partition([\"a\",\"b\"],{\"one\":[\"a\"]},residual={\"members\":[\"b\"],\"known\":True},axis=\"x\")\n        self.assertTrue(residual[\"complete\"])\n        with self.assertRaisesRegex(P06Error,\"DUPLICATE_MEMBER\"):\n            check_partition([\"a\"],{\"one\":[\"a\",\"a\"]})\n\n    def test_transitive_revision_conflict_selectivity_and_ingestion(self):\n        base={\"source\":\"s\",\"available\":\"2025-01-01T00:00:00+00:00\",\"ingested\":\"2025-01-01T00:00:00+00:00\"}\n        rows=[dict(base,id=\"a\",supersedes=[]),dict(base,id=\"b\",supersedes=[\"a\"],available=\"unknown\"),dict(base,id=\"c\",supersedes=[\"b\"]),dict(base,id=\"note\",supersedes=[])]\n        self.assertEqual(select_evidence(rows,\"2026-01-01T00:00:00+00:00\")[\"selected_ids\"],[\"c\",\"note\"])\n        rows.append(dict(base,id=\"conflict\",supersedes=[\"a\"]))\n        self.assertEqual(set(select_evidence(rows,\"2026-01-01T00:00:00+00:00\")[\"selected_ids\"]),{\"c\",\"note\",\"conflict\"})\n        rows[-1][\"ingested\"]=\"2027-01-01T00:00:00+00:00\"\n        self.assertNotIn(\"conflict\",select_evidence(rows,\"2026-01-01T00:00:00+00:00\",system_as_of=\"2026-01-01T00:00:00+00:00\")[\"selected_ids\"])\n        self.assertEqual(select_evidence(rows,\"2026-01-01T00:00:00+00:00\",require_known_bytes=True)[\"selected_ids\"],[])\n\n    def test_named_zone_and_harmonisation_value_dependencies(self):\n        row={\"id\":\"x\",\"source\":\"s\",\"available\":\"2025-03-09\",\"supersedes\":[],\"amount\":\"12\"}\n        kw=dict(timezone_name=\"America/New_York\",date_only_policy=\"next_local_midnight\")\n        self.assertEqual(select_evidence([row],\"2025-03-10T03:59:59+00:00\",**kw)[\"selected_ids\"],[])\n        self.assertEqual(select_evidence([row],\"2025-03-10T04:00:00+00:00\",**kw)[\"selected_ids\"],[\"x\"])\n        h={\"source_id\":\"x\",\"target_id\":\"h\",\"review_decision\":\"Accept\",\"provenance\":[\"review\"]}\n        result=select_evidence([row],\"2026-01-01T00:00:00+00:00\",mode=\"harmonised\",harmonisations=[h],**kw)\n        self.assertEqual(result[\"derived\"][0][\"amount\"],\"12\")\n        self.assertEqual(result[\"derived\"][0][\"dependencies\"],[\"x\"])\n        with self.assertRaisesRegex(P06Error,\"UNSUPPORTED_HARMONISATION\"):\n            select_evidence([row],\"2026-01-01T00:00:00+00:00\",mode=\"harmonised\",harmonisations=[{**h,\"operation\":\"convert\"}],**kw)\n\n    def test_ytd_malformed_period_and_exception_scope(self):\n        a={\"id\":\"fy\",\"kind\":\"cumulative\",\"amount\":\"260\",\"concept\":\"sales\",\"context\":{},\"calendar\":\"gregorian\",\"revision_id\":\"r2\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2026-01-01\"}}\n        b={**a,\"id\":\"h1\",\"amount\":\"120\",\"revision_id\":\"r1\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2025-07-01\"}}\n        with self.assertRaisesRegex(P06Error,\"REVISION_COMPATIBILITY_SCOPE\"):\n            subtract_cumulative(a,b,revision_compatibility={\"accepted\":True,\"scope\":\"anything\",\"evidence\":[\"memo\"]})\n        scope={\"total_id\":\"fy\",\"earlier_id\":\"h1\",\"total_revision\":\"r2\",\"earlier_revision\":\"r1\",\"concept\":\"sales\",\"context\":{},\"total_period\":a[\"period\"],\"earlier_period\":b[\"period\"]}\n        self.assertEqual(subtract_cumulative(a,b,revision_compatibility={\"accepted\":True,\"scope\":scope,\"evidence\":[\"memo\"]})[\"amount\"],140)\n        with self.assertRaisesRegex(P06Error,\"INVALID_PERIOD\"):\n            subtract_cumulative(a,{**b,\"period\":{\"start\":\"2025-01-01\",\"end\":\"2024-01-01\"}})\n\n    def test_resolution_constituent_and_request_invalidation(self):\n        rows=ResolutionTests().rows();q=ResolutionTests().query()\n        prior=resolve_bullet_debt(rows,q)\n        changed=[DebtConstituent(\"a\",F(101),F(1,20),F(2)),rows[1]]\n        for key,value in [(\"horizon\",\"1/2\"),(\"scenario\",\"announced_stress\"),(\"requested_outputs\",[\"principal\"]),(\"evidence_view\",\"original\"),(\"context\",\"other\")]:\n            with self.subTest(key=key),self.assertRaisesRegex(P06Error,\"STALE_RESULT\"):\n                resolve_bullet_debt(rows,{**q,key:value},previous=prior)\n            self.assertTrue(resolve_bullet_debt(rows,{**q,key:value})[\"fresh\"])\n        with self.assertRaisesRegex(P06Error,\"STALE_RESULT\"):\n            resolve_bullet_debt(changed,q,previous=prior)\n        for patch,code in [({\"error_bound\":\"1\"},\"APPROXIMATION_BOUND_INVALID\"),({\"scope\":\"principal\"},\"APPROXIMATION_EVIDENCE_REQUIRED\"),({\"query_signature\":\"stale\"},\"STALE_APPROXIMATION\")]:\n            with self.assertRaisesRegex(P06Error,code):\n                resolve_bullet_debt(rows,q,approximation={\"target_rate\":\"0.06\",\"tolerance\":\"2\",\"error_bound\":\"3/2\",\"scope\":\"fixed_rate_interest\",\"evidence\":[\"triangle\"],**patch})\n        with self.assertRaisesRegex(P06Error,\"MATURITY_CROSSING\"):\n            resolve_bullet_debt(rows,{**q,\"horizon\":\"2\"})\n\n    def test_checker_failed_suite_returns_false_and_nonzero(self):\n        import check_accounting_p06 as checker\n        from unittest.mock import patch\n        from contextlib import redirect_stdout\n        import io\n        failure={\"methods\":1,\"failures\":1,\"errors\":0,\"skips\":0,\"passed\":False,\"output\":\"intentional failure\"}\n        args=[\"--output-dir\",str(ROOT/\"data/accounting-master/deliverables/P06\"),\"--approved-plan\",checker.DEFAULT_RUN+\"/approved-plan.json\",\"--execution-inventory\",checker.DEFAULT_RUN+\"/execution-1/pre-edit-files.json\"]\n        with patch.object(checker,\"run_suite\",return_value=failure), patch.object(Path,\"write_text\") as writes, redirect_stdout(io.StringIO()):\n            code=checker.main(args)\n        self.assertEqual(code,1)\n        payload=json.loads(writes.call_args_list[0].args[0])\n        self.assertIs(payload[\"passed\"],False)\n\n\nclass IntegrationTests(unittest.TestCase):\n    def setup_case(self):\n        fixture=json.loads((ROOT/'docs/design/fixtures/p06-context-chronology-cases-v1.json').read_text())\n        engine=P06Engine()\n        engine.add_context(\"source\",ctx(concept=\"sales\"));engine.add_context(\"target\",ctx(concept=\"revenue\"))\n        engine.add_mapping(MappingRule(\"sales\",\"revenue\",provenance=(\"fixture\",)))\n        for row in fixture[\"assertions\"]:\n            engine.add_assertion(row)\n        request={\"cutoff\":\"2026-12-31\",\"timezone\":\"UTC\",\"date_only_policy\":\"next_local_midnight\",\"evidence_view\":\"latest_available\",\"source_context\":\"source\",\"target_context\":\"target\",\"derive\":{\"total\":\"fy25\",\"earlier\":\"h1-original\"},\"registry\":registry(),\"uncertainty\":[admission_cases()[0]],\"constituents\":[{\"id\":\"d\",\"principal_from\":\"derived\",\"rate\":\"1/20\",\"maturity\":\"2\"}],\"query\":ResolutionTests().query(context=\"target\")}\n        return engine,request\n\n    def test_source_drives_period_and_resolution_and_freezes_prior_result(self):\n        engine,request=self.setup_case()\n        result=engine.evaluate(request)\n        self.assertEqual(result[\"derived\"][\"amount\"],150)\n        self.assertEqual(result[\"resolution\"][\"outputs\"][\"interest\"],F(15,2))\n        preserved=engine.preserve_result()\n        old=next(x for x in engine.assertions if x[\"id\"]==\"h1-revised\")\n        engine.revise(\"h1-revised\",{**old,\"id\":\"h1-new\",\"amount\":\"100\",\"supersedes\":[\"h1-revised\"]})\n        self.assertFalse(engine.current_results)\n        new=engine.evaluate(request)\n        self.assertEqual(new[\"derived\"][\"amount\"],160)\n        self.assertEqual(new[\"resolution\"][\"outputs\"][\"interest\"],8)\n        self.assertNotEqual(result[\"input_sha256\"],new[\"input_sha256\"])\n        preserved[\"derived\"][\"amount\"]=-1\n        self.assertEqual(engine.preserved_results[\"current\"][\"derived\"][\"amount\"],150)\n\n    def test_revision_links_affect_selection_and_failed_mutation_is_atomic(self):\n        engine,request=self.setup_case()\n        old=next(x for x in engine.assertions if x[\"id\"]==\"h1-revised\")\n        engine.revise(\"h1-original\",{**old,\"id\":\"competing\",\"supersedes\":[\"h1-original\"]})\n        with self.assertRaisesRegex(P06Error,\"EVIDENCE_UNAVAILABLE_OR_CONFLICTING\"):\n            engine.evaluate(request)\n        before=copy.deepcopy(engine.assertions)\n        with self.assertRaisesRegex(P06Error,\"DANGLING_SUPERSESSION\"):\n            engine.add_assertion({\"id\":\"bad\",\"source\":\"x\",\"supersedes\":[\"absent\"]})\n        self.assertEqual(engine.assertions,before)\n\n    def test_adapters_preserve_p03_source_and_p01_unknown(self):\n        from core0_ir_v1 import ReadingBinding\n        binding=ReadingBinding(\"reading\",\"USD 100\",\"100\",\"USD\",\"2025-01-01\",\"fixture:uri\",\"doc\",\"2025-02-01T00:00:00+00:00\",\"2025-02-02T00:00:00+00:00\",\"reviewer\",\"2025-02-02T00:00:00+00:00\",\"reviewed\",\"2025-03-01T00:00:00+00:00\",action=\"Accept\")\n        row=adapt_p03_reading(binding,ctx())\n        self.assertEqual(row[\"literal\"],\"USD 100\");self.assertEqual(row[\"amount\"],100)\n        core={**ctx().as_dict(),\"dimensions\":[{\"axis\":\"segment\",\"member\":\"retail\"}]}\n        self.assertEqual(adapt_core_context(core,perimeter_version=\"2026\",gross_net=\"gross\",calendar=\"gregorian\"),ctx())\n        records=json.loads((ROOT/'data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json').read_text())[\"records\"]\n        adapted=adapt_p01_source(records[0])\n        selected=select_evidence([adapted],\"2026-10-03T00:00:00+00:00\",require_known_bytes=True)\n        self.assertEqual(selected[\"selected_ids\"],[]);self.assertTrue(selected[\"unresolved\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '320,520p' scripts/context_chronology_v1.py\"","aggregated_output":"\n\ndef combine_partitions(partitions: Sequence[Mapping[str, Any]]) -> dict[str, Any]:\n    \"\"\"Only disjoint populations may be added, even across different axes.\"\"\"\n    seen = set()\n    for p in partitions:\n        check_partition(p[\"population\"], p[\"members\"], residual=p.get(\"residual\"), axis=p[\"axis\"])\n        if seen.intersection(p[\"population\"]):\n            fail(\"OVERLAPPING_CLASSIFICATIONS\", \"alternative classifications count the same population\")\n        seen.update(p[\"population\"])\n    return {\"population\": sorted(seen), \"complete\": True}\n\n\ndef _availability(value: Any, *, timezone_name: str | None, date_only_policy: str | None, where: str) -> datetime:\n    if isinstance(value, datetime):\n        if value.tzinfo is None:\n            fail(\"MISSING_TIMEZONE\", \"timestamp requires timezone\", where)\n        return value\n    if isinstance(value, date):\n        value = value.isoformat()\n    if not isinstance(value, str):\n        fail(\"INVALID_AVAILABILITY\", \"availability must be date or timestamp\", where)\n    if \"T\" in value or \" \" in value:\n        return _instant(value, where)\n    d = _iso_date(value, where)\n    if date_only_policy != \"next_local_midnight\":\n        fail(\"DATE_ONLY_POLICY_REQUIRED\", \"date-only availability requires next_local_midnight\", where)\n    if not timezone_name:\n        fail(\"TIMEZONE_REQUIRED\", \"named timezone required for date-only availability\", where)\n    try:\n        zone = ZoneInfo(timezone_name)\n    except ZoneInfoNotFoundError:\n        fail(\"UNKNOWN_TIMEZONE\", timezone_name, where)\n    return datetime.combine(d + timedelta(days=1), time.min, zone)\n\n\ndef _validate_assertions(assertions: Sequence[Mapping[str, Any]]) -> dict[str, Mapping[str, Any]]:\n    if any(not isinstance(a.get(\"id\"), str) or not a[\"id\"] for a in assertions):\n        fail(\"INVALID_ASSERTION_ID\", \"nonempty assertion IDs required\")\n    rows = {a[\"id\"]: a for a in assertions}\n    if len(rows) != len(assertions):\n        fail(\"DUPLICATE_ASSERTION\", \"assertion identifiers must be unique\", \"assertions\")\n    for row in assertions:\n        if not row.get(\"source\"):\n            fail(\"MISSING_SOURCE\", \"assertion source is required\", str(row.get(\"id\")))\n        for parent in row.get(\"supersedes\", []):\n            if parent not in rows:\n                fail(\"DANGLING_SUPERSESSION\", f\"unknown superseded assertion {parent}\", str(row.get(\"id\")))\n            for key in (\"concept\", \"period\", \"context\", \"lineage\"):\n                if row.get(key) != rows[parent].get(key):\n                    fail(\"SUPERSESSION_SCOPE_MISMATCH\", key, row[\"id\"])\n            if parent == row[\"id\"]:\n                fail(\"SUPERSESSION_CYCLE\", \"assertion cannot supersede itself\", str(row[\"id\"]))\n    state: dict[str, int] = {}\n    def visit(key: str) -> None:\n        state[key] = 1\n        for parent in rows[key].get(\"supersedes\", []):\n            if state.get(parent) == 1:\n                fail(\"SUPERSESSION_CYCLE\", \"supersession graph contains a cycle\", key)\n            if state.get(parent) != 2:\n                visit(parent)\n        state[key] = 2\n    for key in rows:\n        if state.get(key, 0) == 0:\n            visit(key)\n    return rows\n\n\ndef select_evidence(assertions: Sequence[Mapping[str, Any]], cutoff: str | datetime | date, *,\n                    mode: str = \"latest_available\", system_as_of: str | datetime | date | None = None,\n                    timezone_name: str | None = None, date_only_policy: str | None = None,\n                    harmonisations: Sequence[Mapping[str, Any]] = (), require_known_bytes: bool = False) -> dict[str, Any]:\n    rows = _validate_assertions(assertions)\n    if mode not in {\"original\", \"latest_available\", \"harmonised\"}:\n        fail(\"UNSUPPORTED_EVIDENCE_VIEW\", mode, \"mode\")\n    if isinstance(cutoff, datetime):\n        cut = cutoff if cutoff.tzinfo else fail(\"MISSING_TIMEZONE\", \"cutoff requires timezone\", \"cutoff\")\n    else:\n        cut = _availability(cutoff, timezone_name=timezone_name, date_only_policy=date_only_policy, where=\"cutoff\")\n    asof = None\n    if system_as_of is not None:\n        asof = _availability(system_as_of, timezone_name=timezone_name, date_only_policy=date_only_policy, where=\"system_as_of\")\n    eligible = []\n    unresolved = []\n    for row in assertions:\n        if row.get(\"available\") in (None, \"unknown\", \"not_established\"):\n            unresolved.append({\"id\": row[\"id\"], \"reason\": \"source_availability_unestablished\"})\n            continue\n        try:\n            available = _availability(row[\"available\"], timezone_name=timezone_name, date_only_policy=date_only_policy, where=f\"{row['id']}.available\")\n            ingested = _availability(row.get(\"ingested\", row[\"available\"]), timezone_name=timezone_name, date_only_policy=date_only_policy, where=f\"{row['id']}.ingested\")\n        except P06Error:\n            raise\n        known_bytes = row.get(\"historical_byte_vintage\") == \"established\"\n        if available <= cut and (asof is None or ingested <= asof) and (not require_known_bytes or known_bytes):\n            eligible.append(row)\n        if not known_bytes:\n            unresolved.append({\"id\": row[\"id\"], \"reason\": \"historical_byte_vintage_unestablished\"})\n    eligible_ids = {x[\"id\"] for x in eligible}\n    if mode == \"original\":\n        selected = [x for x in eligible if not any(parent in eligible_ids for parent in x.get(\"supersedes\", []))]\n        # Roots are the first available assertions in a lineage: remove rows that supersede them.\n        selected = [x for x in selected if not x.get(\"supersedes\")]\n    else:\n        superseded = set()\n        def ancestors(key):\n            for parent in rows[key].get(\"supersedes\", []):\n                if parent not in superseded:\n                    superseded.add(parent)\n                    ancestors(parent)\n        for x in eligible:\n            ancestors(x[\"id\"])\n        selected = [x for x in eligible if x[\"id\"] not in superseded]\n    transformations = []\n    derived = []\n    if mode == \"harmonised\":\n        targets = set(rows)\n        for h in harmonisations:\n            source = h.get(\"source_id\")\n            original = next((x for x in selected if x[\"id\"] == source), None)\n            if original is None:\n                fail(\"HARMONISATION_SOURCE_UNAVAILABLE\", str(source))\n            if h.get(\"review_decision\") != \"Accept\" or not h.get(\"provenance\"):\n                fail(\"HARMONISATION_NOT_REVIEWED\", \"accepted review and provenance required\")\n            if h.get(\"changes_basis\") or h.get(\"changes_measurement\"):\n                fail(\"HARMONISATION_CONTEXT_CHANGE\", \"basis/measurement changes unsupported\")\n            if h.get(\"operation\", \"identity\") != \"identity\":\n                fail(\"UNSUPPORTED_HARMONISATION\", \"only reviewed identity is implemented\")\n            target = h.get(\"target_id\")\n            if not target or target in targets:\n                fail(\"DUPLICATE_ASSERTION\", \"new harmonised ID required\")\n            targets.add(target)\n            new = deepcopy(original)\n            new.update(id=target, dependencies=[source], transformation=deepcopy(h))\n            derived.append(new)\n            transformations.append(deepcopy(h))\n    return {\"mode\": mode, \"cutoff\": str(cutoff), \"selected\": deepcopy(selected),\n            \"selected_ids\": [x[\"id\"] for x in selected], \"eligible_ids\": sorted(eligible_ids),\n            \"unresolved\": unresolved, \"transformations\": transformations, \"derived\": derived}\n\n\ndef _row_context(row: Mapping[str, Any]) -> str:\n    return json.dumps(row.get(\"context\", {}), sort_keys=True, separators=(\",\", \":\"))\n\n\ndef subtract_cumulative(total: Mapping[str, Any], earlier: Mapping[str, Any], *,\n                        revision_compatibility: Mapping[str, Any] | None = None) -> dict[str, Any]:\n    for label, row in ((\"total\", total), (\"earlier\", earlier)):\n        if row.get(\"kind\") != \"cumulative\":\n            fail(\"YTD_REQUIRES_CUMULATIVE\", f\"{label} must be cumulative\", label)\n        if row.get(\"period\", {}).get(\"end\") is None:\n            fail(\"INVALID_PERIOD\", \"cumulative period requires exclusive end\", label)\n    if total.get(\"concept\") != earlier.get(\"concept\"):\n        fail(\"CONCEPT_MISMATCH\", \"flow concepts differ\", \"ytd\")\n    if _row_context(total) != _row_context(earlier):\n        fail(\"CONTEXT_MISMATCH\", \"cumulative contexts differ\", \"ytd\")\n    if total.get(\"calendar\") != earlier.get(\"calendar\") or total.get(\"calendar\") != \"gregorian\":\n        fail(\"CALENDAR_MISMATCH\", \"calendars differ\", \"ytd\")\n    tp, ep = total[\"period\"], earlier[\"period\"]\n    if tp.get(\"start\") != ep.get(\"start\"):\n        fail(\"PERIOD_START_MISMATCH\", \"cumulative periods must share a start\", \"ytd\")\n    tend, eend = _iso_date(tp[\"end\"], \"total.period.end\"), _iso_date(ep[\"end\"], \"earlier.period.end\")\n    if eend >= tend:\n        fail(\"NONNESTED_PERIOD\", \"earlier period must end before total\", \"ytd\")\n    tstart = _iso_date(tp[\"start\"], \"total.period.start\")\n    if _iso_date(ep[\"start\"], \"earlier.period.start\") != tstart:\n        fail(\"PERIOD_START_MISMATCH\", \"period starts differ\", \"ytd\")\n    if not tstart < eend:\n        fail(\"INVALID_PERIOD\", \"cumulative intervals must have positive length\")\n    tr = total.get(\"revision_id\"); er = earlier.get(\"revision_id\")\n    if revision_compatibility is not None:\n        expected = {\"total_id\": total.get(\"id\"), \"earlier_id\": earlier.get(\"id\"),\n                    \"total_revision\": tr, \"earlier_revision\": er,\n                    \"concept\": total.get(\"concept\"), \"context\": total.get(\"context\"),\n                    \"total_period\": tp, \"earlier_period\": ep}\n        if revision_compatibility.get(\"scope\") != expected or not revision_compatibility.get(\"evidence\") or revision_compatibility.get(\"accepted\") is not True:\n            fail(\"REVISION_COMPATIBILITY_SCOPE\", \"exception must match exact observations, revisions, context and periods\")\n    if not tr or not er:\n        allowed = revision_compatibility and revision_compatibility.get(\"accepted\")\n        if not allowed or not revision_compatibility.get(\"scope\") or not revision_compatibility.get(\"evidence\"):\n            fail(\"REVISION_UNKNOWN\", \"subtraction requires explicit revision identities or a reviewed scoped exception\", \"ytd\")\n    if tr != er:\n        allowed = revision_compatibility and revision_compatibility.get(\"accepted\")\n        if not allowed or not revision_compatibility.get(\"scope\") or not revision_compatibility.get(\"evidence\"):\n            fail(\"REVISION_INCOMPATIBLE\", \"subtraction requires a common revision or reviewed scoped exception\", \"ytd\")\n    amount = _fraction(total[\"amount\"], \"total.amount\") - _fraction(earlier[\"amount\"], \"earlier.amount\")\n    return {\"kind\": \"flow\", \"amount\": amount, \"period\": {\"start\": ep[\"end\"], \"end\": tp[\"end\"]},\n            \"concept\": total[\"concept\"], \"context\": deepcopy(total.get(\"context\")), \"calendar\": total[\"calendar\"],\n            \"provenance\": {\"operation\": \"cumulative_subtraction\", \"total_id\": total.get(\"id\"), \"earlier_id\": earlier.get(\"id\"),\n                           \"revision_id\": tr or er}}\n\n\n_SUPPORTED_MEASUREMENT_METHODS = {\"direct\", \"discounted_cash_flow\", \"observable_input\"}\n_SUPPORTED_MEASURES = {\"real_world\", \"pricing\"}\n\n\ndef _validate_joint_law(law: Any, where: str) -> list[dict[str, Any]]:\n    atoms = law.get(\"atoms\") if isinstance(law, Mapping) else law\n    if not isinstance(atoms, list) or not atoms:\n        fail(\"INVALID_JOINT_LAW\", \"finite joint law needs atoms\", where)\n    ids = [a.get(\"id\") for a in atoms]\n","exit_code":0,"status":"completed"}}
