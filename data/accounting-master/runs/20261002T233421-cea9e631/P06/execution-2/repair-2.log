{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"nl -ba scripts/check_accounting_p06.py | sed -n '1,230p'\"","aggregated_output":"     1\t#!/usr/bin/env python3\n     2\t\"\"\"Execute P06 deterministic checks and write conformance/result evidence.\"\"\"\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport argparse\n     6\tfrom collections import Counter\n     7\tfrom datetime import datetime, timezone\n     8\tfrom fractions import Fraction\n     9\timport hashlib\n    10\timport io\n    11\timport json\n    12\timport os\n    13\tfrom pathlib import Path\n    14\timport platform\n    15\timport shlex\n    16\timport subprocess\n    17\timport sys\n    18\timport time\n    19\timport unittest\n    20\t\n    21\tROOT = Path(__file__).resolve().parents[1]\n    22\tDEFAULT_RUN = \"data/accounting-master/runs/20261002T233421-cea9e631/P06\"\n    23\tSOURCES = [\n    24\t    \"scripts/context_chronology_v1.py\", \"scripts/check_accounting_p06.py\",\n    25\t    \"tests/test_accounting_p06.py\", \"docs/design/spec/context-chronology-profile-v1.md\",\n    26\t    \"docs/design/fixtures/p06-context-chronology-cases-v1.json\",\n    27\t]\n    28\tOUTPUTS = [\"data/accounting-master/deliverables/P06/conformance.json\",\n    29\t           \"data/accounting-master/deliverables/P06/result.md\"]\n    30\tWRITABLE = set(SOURCES + OUTPUTS + [\"data/accounting-master/deliverables/P06/progress.md\"])\n    31\tOBLIGATIONS = [\"MC02\", \"MC05\", \"MC06\", \"MC07\", \"MC10\", \"MC11\", \"MC14\", \"YTD\", \"APPROXIMATION\"]\n    32\t\n    33\t\n    34\tdef digest(path: Path) -> str | None:\n    35\t    try:\n    36\t        return hashlib.sha256(path.read_bytes()).hexdigest()\n    37\t    except OSError:\n    38\t        return None\n    39\t\n    40\t\n    41\tdef unique_object(pairs):\n    42\t    result = {}\n    43\t    for key, value in pairs:\n    44\t        if key in result:\n    45\t            raise ValueError(\"duplicate key: \" + key)\n    46\t        result[key] = value\n    47\t    return result\n    48\t\n    49\t\n    50\tdef inventory(root: Path, relative: str) -> dict[str, str]:\n    51\t    path = Path(relative)\n    52\t    if path.is_absolute() or \"..\" in path.parts or path.as_posix() != relative:\n    53\t        raise ValueError(\"inventory path must be repository-relative\")\n    54\t    data = json.loads((root / path).read_text(), object_pairs_hook=unique_object)\n    55\t    if not isinstance(data, dict) or not data:\n    56\t        raise ValueError(\"inventory must be a nonempty path-to-SHA256 object\")\n    57\t    for name, value in data.items():\n    58\t        p = Path(name)\n    59\t        if p.is_absolute() or \"..\" in p.parts or p.as_posix() != name or not isinstance(value, str) or len(value) != 64:\n    60\t            raise ValueError(\"invalid inventory entry: \" + str(name))\n    61\t    return data\n    62\t\n    63\t\n    64\tdef approval_reference(root: Path, relative: str) -> dict[str, str]:\n    65\t    raw = (root / relative).read_bytes()\n    66\t    record = json.loads(raw, object_pairs_hook=unique_object)\n    67\t    if not isinstance(record, dict):\n    68\t        raise ValueError(\"approved plan is not an object\")\n    69\t    for name, verdict in ((\"plan\", \"PLAN\"), (\"review\", \"AGREE\")):\n    70\t        section = record.get(name)\n    71\t        if not isinstance(section, dict) or section.get(\"verdict\") != verdict:\n    72\t            raise ValueError(f\"approved plan lacks {name} {verdict}\")\n    73\t        if not isinstance(section.get(\"summary\"), str) or any(not isinstance(section.get(k), list) for k in (\"steps\", \"assumptions\", \"checks\", \"evidence\", \"issues\", \"residuals\", \"next_actions\")):\n    74\t            raise ValueError(\"malformed approved plan\")\n    75\t    if record[\"review\"].get(\"issues\") != []:\n    76\t        raise ValueError(\"approved plan has review issues\")\n    77\t    plan_hash = hashlib.sha256(json.dumps(record[\"plan\"], sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode()).hexdigest()\n    78\t    if record.get(\"plan_hash\") != plan_hash:\n    79\t        raise ValueError(\"approved plan hash mismatch\")\n    80\t    return {\"path\": relative, \"sha256\": hashlib.sha256(raw).hexdigest(), \"plan_hash\": plan_hash}\n    81\t\n    82\t\n    83\tdef protection(root: Path, phase_inventory: str, execution_inventory: str) -> dict:\n    84\t    historical = inventory(root, phase_inventory)\n    85\t    execution = inventory(root, execution_inventory)\n    86\t    protected = sorted((set(historical) | set(execution)) - WRITABLE)\n    87\t    before = {p: digest(root / p) for p in protected}\n    88\t    changed = [p for p in protected if before[p] != execution.get(p)]\n    89\t    missing = [p for p, h in before.items() if h is None]\n    90\t    return {\"historical_inventory\": phase_inventory, \"execution_inventory\": execution_inventory,\n    91\t            \"inventory_hashes\": {phase_inventory: digest(root / phase_inventory), execution_inventory: digest(root / execution_inventory)},\n    92\t            \"excluded_phase_files\": sorted(WRITABLE), \"before\": before, \"execution_baseline\": {p: execution.get(p) for p in protected},\n    93\t            \"changed_since_execution_entry\": changed, \"missing_before_check\": missing,\n    94\t            \"historical_differences\": [p for p in sorted(set(historical) & set(execution)) if historical[p] != execution[p]]}\n    95\t\n    96\t\n    97\tdef finish_protection(root: Path, report: dict) -> dict:\n    98\t    report[\"after\"] = {p: digest(root / p) for p in report[\"before\"]}\n    99\t    report[\"changed_during_check\"] = [p for p in report[\"before\"] if report[\"before\"][p] != report[\"after\"][p]]\n   100\t    report[\"changed_inventory_records\"] = [p for p, h in report[\"inventory_hashes\"].items() if h is None or digest(root / p) != h]\n   101\t    report[\"passed\"] = not any(report[k] for k in (\"changed_since_execution_entry\", \"missing_before_check\", \"changed_during_check\", \"changed_inventory_records\"))\n   102\t    return report\n   103\t\n   104\t\n   105\tdef run_suite(module_name: str) -> dict:\n   106\t    sys.path.insert(0, str(ROOT / \"tests\"))\n   107\t    stream = io.StringIO()\n   108\t    try:\n   109\t        module = __import__(module_name)\n   110\t        suite = unittest.defaultTestLoader.loadTestsFromModule(module)\n   111\t        result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)\n   112\t        return {\"module\": module_name, \"methods\": result.testsRun, \"failures\": len(result.failures), \"errors\": len(result.errors), \"skips\": len(result.skipped), \"passed\": bool(result.wasSuccessful() and result.testsRun > 0 and not result.skipped), \"output\": stream.getvalue()}\n   113\t    except Exception as exc:\n   114\t        return {\"module\": module_name, \"methods\": 0, \"failures\": 0, \"errors\": 1, \"skips\": 0, \"passed\": False, \"output\": stream.getvalue() + repr(exc)}\n   115\t\n   116\t\n   117\tdef probes() -> list[dict]:\n   118\t    \"\"\"Independent criterion probes; expected values are computed here, not imported from tests.\"\"\"\n   119\t    from context_chronology_v1 import (Context, MappingRule, P06Error, check_partition, compatible_context,\n   120\t                                        resolve_bullet_debt, select_evidence, subtract_cumulative, admit_uncertainty, guard_information_view)\n   121\t    rows = []\n   122\t    def observe(identifier, fn):\n   123\t        try:\n   124\t            value = fn()\n   125\t            rows.append({\"id\": identifier, \"passed\": bool(value is not False), \"observed\": value})\n   126\t        except Exception as exc:\n   127\t            rows.append({\"id\": identifier, \"passed\": False, \"error\": type(exc).__name__ + \": \" + str(exc)})\n   128\t    base = {\"concept\":\"x\", \"entity\":\"A\", \"perimeter\":\"A\", \"perimeter_version\":\"1\", \"basis\":\"G\", \"measurement\":\"m\", \"unit\":\"USD\", \"currency\":\"USD\", \"calendar\":\"gregorian\", \"dimensions\":{}, \"gross_net\":\"gross\"}\n   129\t    observe(\"MC02\", lambda: compatible_context(Context.from_dict(base), Context.from_dict({**base, \"concept\":\"y\"}), [MappingRule(\"x\", \"y\", provenance=(\"probe\",))])[\"kind\"] == \"equivalent\")\n   130\t    observe(\"MC07\", lambda: check_partition([\"a\", \"b\"], {\"left\":[\"a\"], \"right\":[\"b\"]})[\"complete\"])\n   131\t    assertions = [{\"id\":\"old\", \"available\":\"2025-01-01\", \"ingested\":\"2025-01-01\", \"supersedes\":[], \"source\":\"s\"}, {\"id\":\"new\", \"available\":\"2026-01-01\", \"ingested\":\"2026-01-01\", \"supersedes\":[\"old\"], \"source\":\"s\"}]\n   132\t    observe(\"MC05\", lambda: select_evidence(assertions, \"2026-12-31\", timezone_name=\"UTC\", date_only_policy=\"next_local_midnight\")[\"selected_ids\"] == [\"new\"])\n   133\t    observe(\"YTD\", lambda: subtract_cumulative({\"kind\":\"cumulative\",\"amount\":260,\"concept\":\"x\",\"context\":{},\"calendar\":\"gregorian\",\"revision_id\":\"r\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2025-12-31\"}}, {\"kind\":\"cumulative\",\"amount\":110,\"concept\":\"x\",\"context\":{},\"calendar\":\"gregorian\",\"revision_id\":\"r\",\"period\":{\"start\":\"2025-01-01\",\"end\":\"2025-06-30\"}})[\"amount\"] == 150)\n   134\t    admission = {\"id\":\"r\",\"kind\":\"ExtractionReading\",\"scope\":\"s\",\"provenance\":[\"p\"],\"dependencies\":[],\"source\":\"d\",\"locator\":\"p1\",\"review_decision\":\"Accept\"}\n   135\t    observe(\"MC10\", lambda: admit_uncertainty(admission, known_records={\"d\":{\"kind\":\"Source\",\"locators\":[\"p1\"]}})[\"kind\"] == \"ExtractionReading\")\n   136\t    debt = [{\"id\":\"a\",\"principal\":\"100\",\"rate\":\"1/20\",\"maturity\":\"2\"}, {\"id\":\"b\",\"principal\":\"50\",\"rate\":\"7/100\",\"maturity\":\"2\"}]\n   137\t    query = {\"contract\":\"c\",\"context\":\"x\",\"evidence_view\":\"latest_available\",\"horizon\":\"1\",\"scenario\":\"base\",\"requested_outputs\":[\"interest\"],\"accrual_convention\":\"simple_actual_fraction\",\"group_by\":[\"rate\",\"maturity\",\"reset\",\"hedge\"]}\n   138\t    observe(\"MC11\", lambda: resolve_bullet_debt(debt, query)[\"outputs\"][\"interest\"] == Fraction(17, 2))\n   139\t    observe(\"APPROXIMATION\", lambda: (lambda x: x[\"approximation\"][\"bound\"] == \"3/2\")(resolve_bullet_debt(debt, query, approximation={\"target_rate\":\"0.06\",\"tolerance\":\"2\",\"error_bound\":\"3/2\",\"scope\":\"fixed_rate_interest\",\"evidence\":[\"probe\"]})))\n   140\t    def parent_rejected():\n   141\t        try:\n   142\t            compatible_context(base, {**base, \"perimeter\": \"Group\"})\n   143\t        except P06Error as exc:\n   144\t            return exc.code == \"PARENT_GROUP_MISMATCH\"\n   145\t        return False\n   146\t    observe(\"MC06\", parent_rejected)\n   147\t    observe(\"MC14\", lambda: guard_information_view({\"visible\":[],\"measure_id\":\"P\",\"pricing_measure_id\":\"Q\"},event_time=\"2025-01-01\")[\"selection_changes_history\"] is False)\n   148\t    return rows\n   149\t\n   150\t\n   151\tdef main(argv=None) -> int:\n   152\t    parser = argparse.ArgumentParser()\n   153\t    parser.add_argument(\"--output-dir\", required=True)\n   154\t    parser.add_argument(\"--approved-plan\", required=True)\n   155\t    parser.add_argument(\"--execution-inventory\", required=True)\n   156\t    parser.add_argument(\"--inject-failure\", action=\"store_true\", help=argparse.SUPPRESS)\n   157\t    args = parser.parse_args(argv)\n   158\t    out = Path(args.output_dir).resolve()\n   159\t    if out != ROOT / \"data/accounting-master/deliverables/P06\":\n   160\t        parser.error(\"use the declared P06 output directory\")\n   161\t    started = time.monotonic(); started_utc = datetime.now(timezone.utc).isoformat()\n   162\t    phase_inventory = str(Path(args.execution_inventory).parent.parent / \"phase-entry-inventory.json\")\n   163\t    try:\n   164\t        approved = approval_reference(ROOT, args.approved_plan)\n   165\t        protected = protection(ROOT, phase_inventory, args.execution_inventory)\n   166\t    except (OSError, ValueError) as exc:\n   167\t        parser.error(str(exc))\n   168\t    code_before = {p: digest(ROOT / p) for p in SOURCES}\n   169\t    os.environ[\"CUDA_VISIBLE_DEVICES\"] = \"-1\"\n   170\t    reports = {name: run_suite(name) for name in (\"test_accounting_p06\", \"test_accounting_p03\", \"test_accounting_p04\")}\n   171\t    observations = probes()\n   172\t    status = {\"required\": len(OBLIGATIONS), \"observed\": len(observations), \"missing\": sorted(set(OBLIGATIONS) - {x[\"id\"] for x in observations}), \"uncatalogued\": sorted({x[\"id\"] for x in observations} - set(OBLIGATIONS)), \"duplicate_ids\": [k for k, v in Counter(x[\"id\"] for x in observations).items() if v != 1], \"failed_observations\": [x[\"id\"] for x in observations if x.get(\"passed\") is not True]}\n   173\t    code_after = {p: digest(ROOT / p) for p in SOURCES}\n   174\t    protected = finish_protection(ROOT, protected)\n   175\t    stable = all(code_before[p] == code_after[p] for p in SOURCES)\n   176\t    passed = (all(x[\"passed\"] for x in reports.values()) and all(x.get(\"passed\") for x in observations) and not status[\"missing\"] and not status[\"uncatalogued\"] and not status[\"duplicate_ids\"] and protected[\"passed\"] and stable and not args.inject_failure)\n   177\t    command_args = sys.argv[1:] if argv is None else argv\n   178\t    command = shlex.join([\"CUDA_VISIBLE_DEVICES=-1\", \"python3\", \"-B\", \"scripts/check_accounting_p06.py\"] + command_args)\n   179\t    payload = {\"schema_version\":\"accdsl.p06.conformance.v1\", \"passed\": bool(passed), \"profile\":\"context-chronology-resolution-v1\", \"obligation_status\":status, \"observations\":observations, \"tests\":reports, \"protection\":protected, \"code_stable_during_check\":stable, \"provenance\":{\"approved_plan\":approved, \"phase_entry_inventory\":phase_inventory, \"execution_inventory\":args.execution_inventory}, \"hashes\":code_after, \"input_hashes\":{p:digest(ROOT / p) for p in [\"scripts/core0_ir_v1.py\", \"scripts/reconstruction_v1.py\", \"docs/plans/accounting-mission-requirements.md\", \"data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json\"]}, \"manifest\":{\"git_commit\":\"unavailable: existing marker is not a usable repository\", \"command\":command, \"working_directory\":str(ROOT), \"executable\":sys.executable, \"environment\":{\"python\":platform.python_version()}, \"hardware\":\"CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported\", \"random_seeds\":\"N/A: exact deterministic fixtures\", \"data_version\":\"p06-context-chronology-cases-v1\", \"started_utc\":started_utc, \"wall_seconds\":round(time.monotonic()-started, 6), \"plan\":args.approved_plan, \"plan_sha256\":approved[\"sha256\"], \"approved_plan_hash\":approved[\"plan_hash\"], \"execution_inventory\":args.execution_inventory, \"outputs\":OUTPUTS, \"result\":OUTPUTS[1], \"phase_contribution_files\":sorted(WRITABLE)}, \"requirement_coverage\":{\"MC02\":\"context-aware mappings and explicit mismatch rejection\", \"MC05\":\"chronology, availability and revision-compatible YTD\", \"MC06\":\"entity/perimeter mismatch rejection; consolidation unsupported\", \"MC07\":\"finite mappings, partition membership and overlap rejection\", \"MC10\":\"six category uncertainty admission\", \"MC11\":\"constituent/query-bound debt grouping and approximation certificate\", \"MC14\":\"dated information admission and unsupported scenario modes\"}, \"acceptance\":{\"engineering\":bool(passed), \"accounting_validity\":\"not established\", \"forecast_validity\":\"not established\", \"human_acceptance\":\"pending\", \"whole_gap_closure\":False}}\n   180\t    out.mkdir(parents=True, exist_ok=True)\n   181\t    out.joinpath(\"conformance.json\").write_text(json.dumps(payload, indent=2, default=str) + \"\\n\")\n   182\t    decision = \"PASS\" if passed else \"FAIL\"\n   183\t    result_text = f'''# P06 context, chronology, and resolution result\n   184\t\n   185\t{decision}: {reports[\"test_accounting_p06\"][\"methods\"]} P06 tests, {reports[\"test_accounting_p03\"][\"methods\"]} P03 regression tests, and {reports[\"test_accounting_p04\"][\"methods\"]} P04 regression tests executed. The conformance file records every test outcome, independent criterion probe, source hash, inventory comparison, command, and manifest.\n   186\t\n   187\tRepair replaced metadata-only harmonisation with derived identity observations, enforced reference/date/domain admission, bound resolution to constituent values, and connected selected evidence to period derivation and debt arithmetic. The runtime preserves earlier result copies and rejects conflicting revisions.\n   188\t\n   189\tThe implementation supplies explicit context mappings, finite partition enumeration, supersession-DAG evidence selection, date-only next-local-midnight handling, revision-compatible YTD subtraction, six category-specific uncertainty admission, information-view guards, and query-signature-bound fixed-rate unhedged bullet-debt resolution. Exact Fraction arithmetic is used throughout the supported scalar path. An approximation is accepted only with a fixed-rate scope, declared tolerance, and a triangle-inequality error certificate.\n   190\t\n   191\tThe tests independently verify 260 minus revised H1 110 equals H2 150 and reject subtraction using incompatible original H1 120. They reject parent/group, basis, measurement, currency, calendar, gross/net, overlap, omission, dangling/cyclic revision, future-information, unsupported treatment, unsupported scenario, stale-query, maturity-crossing, and missing-approximation-evidence cases. Historical byte availability marked unknown remains unresolved and is excluded from the integrated historical computation. Tests also mutate the selected H1 amount from 110 to 100: derived H2 changes from 150 to 160, and the synthetic debt interest changes from 7.5 to 8, while the preserved earlier result remains 150.\n   192\t\n   193\tSpecified behaviour is recorded in the versioned profile. Implemented operations and independently tested invariants are bounded to those operations; synthetic permissions and evidence references do not establish accounting eligibility or source truth. Identity harmonisation, finite scalar historical domains, a hold policy, and exact integer-period DCF are supported; broader transformations/policies are explicitly unsupported.\n   194\t\n   195\t| Decision | Primary criterion | Veto status | Main uncertainty | Next justified action | Not concluded |\n   196\t| --- | --- | --- | --- | --- | --- |\n   197\t| {decision} for bounded engineering conformance | Independent P06 probes and focused/regression suites | tests={all(x[\"passed\"] for x in reports.values())}; protection={protected[\"passed\"]}; stable={stable}; failed_observations={status[\"failed_observations\"]} | finite synthetic cases and unannotated source availability | independent result review if PASS; repair if FAIL | professional accounting validity, empirical forecast validity, human acceptance, or wider MC01–MC35/G1–G18 closure |\n   198\t\n   199\tEngineering correctness, numerical validity, and interpretation remain separate. The exact outputs establish only the declared bounded operations. The strongest alternative explanation is a shared interpretation error in the synthetic fixtures; independent set and arithmetic probes reduce that risk but do not replace source or professional review. The weakest evidence is breadth: mappings, uncertainty, and grouping are finite bounded cases.\n   200\t\n   201\tResiduals: general measurement conversion, consolidation, arbitrary calendars, continuous or nonlinear uncertainty, empirical approximation validation, historical retained-byte availability, accounting validity, forecast validity, and human acceptance remain open. This phase does not rank stochastic candidates or establish a production default.\n   202\t\n   203\tActual command: `{command}`. Python {platform.python_version()}, CPU only with accelerator devices intentionally hidden. Wall time: {payload[\"manifest\"][\"wall_seconds\"]} seconds. Git provenance is unavailable; content hashes and supervisor inventories are retained in conformance.json.\n   204\t'''\n   205\t    out.joinpath(\"result.md\").write_text(result_text)\n   206\t    print(json.dumps({\"passed\":bool(passed), \"tests\":{k:{x:v[x] for x in (\"methods\",\"failures\",\"errors\",\"skips\",\"passed\")} for k,v in reports.items()}, \"obligations\":status, \"protected\":protected[\"passed\"], \"stable\":stable}))\n   207\t    return 0 if passed else 1\n   208\t\n   209\t\n   210\tif __name__ == \"__main__\":\n   211\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
