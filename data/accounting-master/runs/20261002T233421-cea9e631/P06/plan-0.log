325:| ingest | bytes/hash, filing_id, availability, extractor_lock, request_id | SourceDocument, source units, proposed readings, coverage obligations |\n330:| report | committed run/date/period, mapping, view, queries | contextual joint cells and explanation references |\n364:### Concrete adapter exchanges\n376:  metadata is retained separately from that nominal value. An uncertainty\nscripts/check_core_contract.py:98:    partitions={'geography':{'domestic':Q(180),'overseas':Q(80)},'channel':{'wholesale':Q(200),'retail':Q(60)}}\nscripts/check_core_contract.py:99:    ck('overlapping_axes',all(sum(v.values())==260 for v in partitions.values()) and sum(sum(v.values()) for v in partitions.values())==520,'Adding both axes double-counts the same population; require one partition')\ntests/test_accounting_p04.py:138:        scenario={'rate':'7/100','year_fraction':'1'};horizon=['2026','2027'];group=group_contracts(contracts,scenario,horizon)\ntests/test_accounting_p04.py:141:            with self.assertRaises(ValueError):group_contracts(altered,scenario,horizon,group)\ntests/test_accounting_p04.py:142:        with self.assertRaises(ValueError):group_contracts(contracts,dict(scenario,rate='8/100'),horizon,group)\ntests/test_accounting_p04.py:143:        with self.assertRaises(ValueError):group_contracts(contracts,scenario,['2026','2028'],group)\ntests/test_accounting_p04.py:144:        self.record('uncertainty_probability_grouping',{'admissions':accepted,'posterior':posterior.atoms,'mass':measure.summary(),'group':group})\ntests/test_accounting_p04.py:274:        with self.assertRaises(ValueError):group_contracts(contracts,{'rate':'1/20','year_fraction':'1'},['2026','2027'])\ntests/test_accounting_p04.py:281:    def test_large_integer_domain_and_partition_oracle(self):\ntests/test_accounting_p04.py:297:        self.record('large_domain_partition',{'large_domain':r,'independent_integer_oracle':expected,'partition':r2})\nscripts/check_repair_conformance.py:154:def temporal():\nscripts/check_repair_conformance.py:155:    f=load('temporal.json')\nscripts/check_repair_conformance.py:161:        check('temporal_query_'+str(i),{a['id'] for a in eligible}==set(q['expect']),q)\nscripts/check_repair_conformance.py:192:    started=time.monotonic();corporate();bounds_and_weights();temporal();sector_checks()\nscripts/check_repair_conformance.py:194:        scope='Design reference arithmetic, rational-linear solver, temporal selection and event oracle; no product implementation or accounting certification',\n","exit_code":0,"status":"completed"}}
