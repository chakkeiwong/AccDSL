ion. | Specified result cells, branch statuses, strict bound attainment and unresolved mass in Chs. 6, 8, 10/Core 0. Exact linear, joint-output and funding/default reference checks pass; general simulation/result-query implementation remains pending. G2, G3, G6. |\ndocs/plans/accounting-mission-requirements.md:100:| MC26 | Specify supported numerical/solver operations and their limits. U3, P, D. | Define formula fragments, reformulations, exact/approximate monetary treatment, rounding, strict-domain bounds, infeasibility/conflict evidence, timeout and resource behaviour. | Specified rational-linear/finite-choice scope, amount reformulation, quantisation distinctions and typed unknowns in Ch. 6/Core 0. Z3 checks 4.975 attained and 7.035 unattained and concrete histories. Nonlinear solvers and a production rounding/optimization layer remain pending. G3, G10. |\nscripts/rational_solver_v1.py:10:class UnsupportedFragment(ValueError):\nscripts/rational_solver_v1.py:14:def rational(value):\nscripts/rational_solver_v1.py:27:def q(value):\nscripts/rational_solver_v1.py:32:def fraction(value):\nscripts/rational_solver_v1.py:42:class Budget:\nscripts/rational_solver_v1.py:58:class Problem:\nscripts/rational_solver_v1.py:81:class Backend:\nscripts/rational_solver_v1.py:93:def affine(expr):\nscripts/rational_solver_v1.py:116:def validate_formula(expr):\nscripts/rational_solver_v1.py:132:def nodes(expr):\nscripts/rational_solver_v1.py:136:def conjunction(expr):\nscripts/rational_solver_v1.py:143:def atoms(expr):\nscripts/rational_solver_v1.py:149:def close(expr):\nscripts/rational_solver_v1.py:172:def _value(model, expr):\nscripts/rational_solver_v1.py:179:def domain_size(values):\nscripts/rational_solver_v1.py:187:def lazy_product(values):\nscripts/rational_solver_v1.py:203:def solve(problem, budget, objective=None, *, selected_views=(), view_operator=None,\nscripts/rational_solver_v1.py:427:def half_even(value, quantum):\nscripts/rational_solver_v1.py:437:def disclosure_domain(displayed, quantum, convention):\nscripts/rational_solver_v1.py:447:def domain_formula(expr, domain):\nscripts/rational_solver_v1.py:471:def fixed_fraction_constraint(numerator, denominator, comparator, threshold, constraints, budget, backend=None):\nscripts/reconstruction_v1.py:21:def admit(record):\nscripts/reconstruction_v1.py:37:def expression(node, env):\nscripts/reconstruction_v1.py:56:def construct(spec):\nscripts/reconstruction_v1.py:178:def from_p03(ir, bindings, template_bindings):\nscripts/reconstruction_v1.py:240:class FiniteMeasure:\nscripts/reconstruction_v1.py:281:def weighted_summary(measure):\nscripts/reconstruction_v1.py:286:def group_contracts(contracts, scenario, horizon, previous=None):\ntests/test_accounting_p04.py:26:def spec():\ntests/test_accounting_p04.py:30:def observation(s,amount):\ntests/test_accounting_p04.py:35:class ReconstructionTests(unittest.TestCase):\ntests/test_accounting_p04.py:37:    def test_independent_enumeration(self):\ntests/test_accounting_p04.py:60:    def test_p03_parent_views(self):\ntests/test_accounting_p04.py:78:    def test_rounded_strict_and_unbounded(self):\ntests/test_accounting_p04.py:92:    def test_rounding_and_integer_gaps(self):\ntests/test_accounting_p04.py:99:    def test_incomplete_unsupported_unknown(self):\ntests/test_accounting_p04.py:111:    def test_identity_context_conflicts(self):\ntests/test_accounting_p04.py:122:    def test_admission_measure_grouping(self):\ntests/test_accounting_p04.py:146:    def test_view_union_order_and_joint_outputs(self):\ntests/test_accounting_p04.py:163:    def test_genuine_choice_and_activation(self):\ntests/test_accounting_p04.py:175:    def test_limits_and_unknown_bound_stages(self):\ntests/test_accounting_p04.py:188:    def test_posting_units_and_disclosure_rounding(self):\ntests/test_accounting_p04.py:202:    def test_fraction_rewrite_and_nonlinearity(self):\ntests/test_accounting_p04.py:217:    def test_northstar_known_history_and_renaming(self):\ntests/test_accounting_p04.py:240:    def test_input_validation_and_probability_mass(self):\ntests/test_accounting_p04.py:259:    def test_exact_input_boundaries(self):\ntests/test_accounting_p04.py:281:    def test_large_integer_domain_and_partition_oracle(self):\ntests/test_accounting_p04.py:299:    def test_p03_changed_principal_and_rates(self):\ntests/test_accounting_p04.py:319:class CheckerProvenanceTests(unittest.TestCase):\ntests/test_accounting_p04.py:365:    def test_checker_rejects_bad_approvals_before_writes(self):\ntests/test_accounting_p04.py:383:    def test_checker_rejects_bad_inventories_before_writes(self):\ntests/test_accounting_p04.py:417:    def test_checker_manifest_uses_current_provenance(self):\ntests/test_accounting_p04.py:440:    def test_checker_failure_report_does_not_claim_success(self):\n# Bounded reconstruction v1\n\nThis executable profile addresses MC08–MC12, MC18 and MC26. It constructs a joint\nfamily from declared templates, slots, openings, dated mappings and admitted\nobservations. It does not discover templates or infer arbitrary company histories.\n\n## Pre-execution research intent and evidence contract\n\nQuestion: do declared inputs generate the correct family within their finite\nscope? Mechanism: rational linear constraints with shared economic identifiers,\nexplicit finite choices and bounded integer domains. Expected failure modes are\nlost dependence, wrong strict endpoints, unexamined rounding and false completeness.\nComparators are an independent Fraction replay/enumerator over original fixtures\nand analytic continuous bounds. Exact feasible-set equality and endpoint proofs\nare pass criteria. Unsupported operations, unknown backend replies, unfinished\ncells or unresolved matching obligations veto exact certification. Corrupted\ninputs or protection failures veto acceptance and stop the checker. A numerical\nfailure triggers repair, not rejection of the research direction. Runtime is\nexplanatory only. No superiority, general accounting validity, forecast validity,\ncontinuous probabilistic inference or human acceptance follows from these checks.\nConformance JSON and result.md preserve results; progress.md is a reset checkpoint.\n\nSkeptical audit: the earlier ambiguity between named views and search choices is\nresolved explicitly below. Baselines use original inputs, not generated expected\nanswers. Fixture sizes and budgets are engineering choices. No stochastic ranking\nor production-default promotion is attempted. A successful command can still be\nmisleading if both construction and oracle share lowering; the oracle therefore\nreplays postings independently. The integration checks inspect the unnamed\ninterior, not only endpoint extrema.\n\n## Assumptions and defaults\n\n| Choice | Provenance/status | Justification | Failure mode / early diagnostic |\n| --- | --- | --- | --- |\n| Fraction arithmetic | Core contract, reviewed requirement | exact disclosed decimals | binary-float drift; reject floats |\n| Z3 rational linear solving | existing 4.16.0, implementation hypothesis | exact linear SAT and optimisation | shared backend error; independent enumeration and algebra |\n| finite templates/slots | explicit input, scope hypothesis | tractable reconstruction | omitted histories; preserve exclusions and obligations |\n| budgets | explicit caller input, convenience | bounded execution | premature stop; zero-work and one-cell tests |\n| rounding convention/stage | explicit input, no inferred default | preserve disclosure versus posting semantics | wrong ties; negative/parity fixtures |\n| finite probability measure | explicit joint atoms, hypothesis | dependence and exact Bayes update | overlap/double use; reject duplicate atoms/information |\n| grouping | explicit additive debt profile only | retain contract memory | different resets/maturities/horizon; revalidation tests |\n| deterministic fixtures | engineering comparator | exhaustive small checks | not representative; no empirical forecast claim |\n\n## Family and query semantics\n\nParent P contains opening, slot, transition, mapping and observation constraints.\nNamed view i supplies A_i only. A parent query uses P; a single-view query uses\nP AND A_i. Multiple views require explicit intersection or union. Views may\noverlap or fail to cover P; labels supply neither exclusivity nor probabilities.\nActual finite choices enumerate all declared values jointly. Boolean predicates\nare split by an exhaustive truth-assignment partition of their atomic comparisons;\neach cell includes the formula and its decision prefix. The partition is disjoint\nby construction. Integer variables are enumerated only with finite declared bounds.\nEach candidate assignment/predicate cell is counted once, including infeasible\ncells. Views do not add cells unless their explicit Boolean predicate requires a\nlogical partition. Continuous regions remain symbolic. Unvisited suffixes are\nrepresented by ordinal range and the unchanged family formula.\n\nSlots instantiate nonnegative amounts and an active flag; inactive means zero.\nActive zero is permitted. Both signed posting incidence and economic-state\ncoefficients are declared by the template. Exact context equality is required\nfor observations. One observation ID cannot silently supply incompatible domains.\nUnmatched obligations remain unresolved. Admission records keep six uncertainty\ncategories separate. Stress is conditional, not observed evidence or a likelihood.\n\n## Numerical semantics\n\nFeasibility is checked on each original strict cell before closure optimisation.\nA nonempty convex linear cell has the same infimum/supremum as its closure: for\nany original feasible point x and any closure point y, (1-t)y+t x satisfies every\nstrict inequality for 0<t<=1 and tends to y. The solver therefore optimises closed\ninequalities, proves no better closed value, then tests equality with the endpoint\nunder original constraints. Empty strict cells never acquire relaxation witnesses.\nUnknown in any proof or endpoint test leaves the bound uncertified. Unbounded,\nUnknown, Infeasible and PartialSearch remain distinct. Partial-cell extrema are\nexplored-only, never global certificates.\n\nDebt amounts F,V satisfy F>=0, V>=0, F+V=D. For exact D>0, alpha=F/D is equivalent\nto the fraction parameterisation. With rounded D, use amounts directly. A fixed\nfraction comparison F/D op a may multiply by D only after proving D>0 (or reverse\nthe comparison after proving D<0). Unknown sign or an unknown threshold is\nunsupported. Unknown-by-unknown products and unbounded integer domains are also\nunsupported; they never imply infeasibility.\n\nDisclosure intervals retain inclusion flags. Half-even display domains include\nboth ties for an even displayed minor-unit integer and neither for an odd one.\nPosting quantisation rounds exact rationals at the declared boundary. Symbolic\nposting amounts use bounded integers; continuous relaxation is forbidden.\n\nFinite measures use unique joint atom IDs with weights summing to one. Conditional\nviews are events on atoms. Likelihood information blocks can be used once. Default\nand unresolved mass are retained; unavailable outcomes prevent an unconditional\nmean. Grouping requires matching rate/reset/maturity/hedge keys and additive\ntransition/report checks for the explicit scenario and horizon; contract memory\nis retained. These tests do not prove general aggregation equivalence.\n\n## Execution\n\nUse existing Python/Z3, standard library and accepted P03 dependencies; install\nnothing. Run `CUDA_VISIBLE_DEVICES=-1 python3 -B -m unittest discover -s tests -p 'test_accounting_p04.py' -v`\nand the analogous P03 regression, followed by `CUDA_VISIBLE_DEVICES=-1 python3 -B scripts/check_accounting_p04.py\n--output-dir data/accounting-master/deliverables/P04 --execution-inventory\ndata/accounting-master/runs/20261002T233421-cea9e631/P04/execution-0/pre-edit-files.json\n--approved-plan data/accounting-master/runs/20261002T233421-cea9e631/P04/approved-plan.json`.\nNo accelerator framework is used; CPU-only checks intentionally hide GPU devices.\nThe checker records actual versions, elapsed time, hashes, generated formulas,\nproof queries, observations and protection comparisons. Git is unavailable; content\nhashes preserve provenance. Human acceptance remains pending.\n\n## Recovery provenance\n\nEach execution supplies its supervisor-issued approval and pre-edit inventory\nexplicitly. Their repository-relative paths must identify the same P04 run.\nThe approval must contain a structurally valid PLAN, an issue-free AGREE review\nand the controller's canonical plan hash. Missing, malformed or unapproved\nrecords are rejected before numerical checks or deliverable writes. The original\napproved design and historical phase-entry inventory remain separate references;\nneither substitutes for the current execution baseline. The existing protection\nhelper validates inventory entries, required protected files and current hashes.\nThe nine permitted P04 paths remain the only protection exclusions.\n\nConformance records both inventory references, both plan references and their\nhashes; it distinguishes historical differences from execution-time changes and\nall phase contributions from files actually changed during this execution.\nFailed checks produce a failure report without numerical success assertions.\nDisposable-tree tests exercise these admission and reporting paths with simulated\ncheck outcomes; they do not replace the independent numerical tests. Provenance\nvalidation presumes supervisor-issued files and does not authenticate an external\nissuer or establish accounting validity.\n\n## Implemented input details and residual scope\n\nDates are ordered by the explicit `dates` array, which is the caller's declared\nchronology; strings are not sorted to infer time. `exact_rational` slots carry\nexact amounts. `posting_half_even_quantized_units` slots carry bounded integer\nminor-unit counts and a positive rational quantum. Their posting amount is count\ntimes quantum. Known exact values can be quantised with `half_even` before this\nboundary; no general symbolic rounding of real-valued expressions is implemented.\nMappings cannot shadow economic identifiers. The solver rejects undeclared free\nvariables. Finite domains and comparison predicates accompany unfinished ordinal\nranges so later inspection can reconstruct unvisited regions.\n\nExact rational records require integral numerator and denominator components;\nfractional, Boolean and floating-point components are rejected before conversion.\nDomains must explicitly supply bounds (null permits an unbounded side) and Boolean\ninclusion flags for finite endpoints. Unsupported finite-set domain encodings are\nrejected rather than treated as empty constraints. Generated balance/state names\ncannot replace caller identifiers. Finite choice values are distinct and match\ntheir variable sort. Large finite ranges use exact integer cardinalities and an\niterative lazy enumeration, retaining the unvisited suffix under small budgets.\nGrouping rejects repeated contract IDs to prevent duplicate principal.\n\nFinite-measure atoms must supply complete scalar economic assignments with the\nsame coordinate keys. Distinct assignments are disjoint; repeated assignments\nunder different labels are rejected. The caller supplies the exhaustive joint\nsupport and its justification. View events can overlap as sets of atom IDs, while\natom weights are counted once. Completeness of this external modeling assumption\nis not inferred from normalization. Admission checks validate category fields,\nprovenance, dependencies and declared treatment membership. They do not establish\nthe external truth of evidence, package eligibility or statistical identification.\n\nGrouping supports nonnegative, unhedged, fixed/floating bullet debt only. Principal\nis unchanged within the declared horizon and no maturity occurs there; interest\nis principal times the common rate times the declared year fraction. Summation\npreserves both expressions by distributivity. Additional contract fields,\nhedges, amortization and more general transitions are unsupported. Matching memory\nkeys and request hashes enforce revalidation after relevant changes.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,202p' scripts/rational_solver_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,202p' scripts/rational_solver_v1.py\"","aggregated_output":"\"\"\"Exact, bounded rational-linear cells; no implicit integer relaxation.\"\"\"\nfrom dataclasses import dataclass, field\nfrom fractions import Fraction as F\nfrom itertools import product\nimport math\nimport time\nimport z3\n\n\nclass UnsupportedFragment(ValueError):\n    pass\n\n\ndef rational(value):\n    if isinstance(value, bool) or isinstance(value, float):\n        raise ValueError('exact rational required; booleans/floats are not amounts')\n    if isinstance(value, dict):\n        if set(value) != {'n', 'd'}:\n            raise ValueError('rational record requires exactly n and d')\n        parts = [rational(value[k]) for k in ('n', 'd')]\n        if any(x.denominator != 1 for x in parts) or parts[1] == 0:\n            raise ValueError('rational numerator/denominator must be integers with nonzero denominator')\n        return F(parts[0].numerator, parts[1].numerator)\n    return F(value)\n\n\ndef q(value):\n    x = rational(value)\n    return z3.RealVal(f'{x.numerator}/{x.denominator}')\n\n\ndef fraction(value):\n    value = z3.simplify(value)\n    if z3.is_int_value(value):\n        return F(value.as_long())\n    if z3.is_rational_value(value):\n        return F(value.numerator_as_long(), value.denominator_as_long())\n    raise UnsupportedFragment('non-rational solver value: ' + str(value))\n\n\n@dataclass(frozen=True)\nclass Budget:\n    max_slots: int\n    max_formula_nodes: int\n    max_integer_assignments: int\n    max_cells: int\n    elapsed_ms: int\n    solver_timeout_ms: int\n    solver_rlimit: int\n\n    def __post_init__(self):\n        for v in self.__dict__.values():\n            if type(v) is not int or v < 0:\n                raise ValueError('budgets must be explicit nonnegative integers')\n\n\n@dataclass\nclass Problem:\n    scope: str\n    evidence_view: str\n    variables: dict = field(default_factory=dict)\n    finite: dict = field(default_factory=dict)\n    constraints: list = field(default_factory=list)  # (source/assumption label, BoolRef)\n    views: dict = field(default_factory=dict)\n    outputs: dict = field(default_factory=dict)\n    obligations: list = field(default_factory=list)\n    exclusions: list = field(default_factory=list)\n    provenance: dict = field(default_factory=dict)\n    slots: int = 0\n    unsupported: list = field(default_factory=list)\n    rounding_stage: str = 'exact_rational'\n\n    def add(self, label, condition):\n        if any(label == x[0] for x in self.constraints):\n            raise ValueError('duplicate constraint identity: ' + label)\n        if not z3.is_bool(condition):\n            raise ValueError('constraint must be Boolean')\n        self.constraints.append((label, condition))\n\n\nclass Backend:\n    \"\"\"Injection seam for deterministic Unknown tests; production uses Z3.\"\"\"\n    def check(self, solver, stage):\n        return solver.check()\n\n    def optimize(self, solver, stage):\n        return solver.check()\n\n\nCOMPARISONS = {z3.Z3_OP_EQ, z3.Z3_OP_LE, z3.Z3_OP_GE, z3.Z3_OP_LT, z3.Z3_OP_GT}\n\n\ndef affine(expr):\n    \"\"\"Reject unsupported arithmetic before passing a formula to a solver.\"\"\"\n    if z3.is_rational_value(expr) or z3.is_int_value(expr):\n        return False\n    if z3.is_const(expr) and expr.sort().kind() in (z3.Z3_REAL_SORT, z3.Z3_INT_SORT):\n        return True\n    op = expr.decl().kind()\n    children = expr.children()\n    if op in (z3.Z3_OP_ADD, z3.Z3_OP_SUB, z3.Z3_OP_UMINUS, z3.Z3_OP_TO_REAL):\n        return any([affine(c) for c in children])\n    if op == z3.Z3_OP_MUL:\n        flags = [affine(c) for c in children]\n        if sum(flags) > 1:\n            raise UnsupportedFragment('unknown-by-unknown product: ' + expr.sexpr())\n        return any(flags)\n    if op == z3.Z3_OP_DIV:\n        lhs = affine(children[0]); rhs = affine(children[1])\n        if rhs or fraction(children[1]) == 0:\n            raise UnsupportedFragment('symbolic/zero divisor: ' + expr.sexpr())\n        return lhs\n    raise UnsupportedFragment('unsupported arithmetic: ' + expr.sexpr())\n\n\ndef validate_formula(expr):\n    if z3.is_true(expr) or z3.is_false(expr):\n        return\n    if z3.is_const(expr) and z3.is_bool(expr):\n        return\n    op = expr.decl().kind()\n    if op in COMPARISONS and all(z3.is_arith(c) for c in expr.children()):\n        for c in expr.children():\n            affine(c)\n    elif op in (z3.Z3_OP_AND, z3.Z3_OP_OR, z3.Z3_OP_NOT, z3.Z3_OP_IMPLIES):\n        for c in expr.children():\n            validate_formula(c)\n    else:\n        raise UnsupportedFragment('unsupported formula: ' + expr.sexpr())\n\n\ndef nodes(expr):\n    return 1 + sum(nodes(c) for c in expr.children())\n\n\ndef conjunction(expr):\n    if z3.is_and(expr):\n        return all(conjunction(c) for c in expr.children())\n    return (z3.is_true(expr) or z3.is_false(expr) or\n            expr.decl().kind() in COMPARISONS and all(z3.is_arith(c) for c in expr.children()))\n\n\ndef atoms(expr):\n    if expr.decl().kind() in COMPARISONS and all(z3.is_arith(c) for c in expr.children()):\n        return [expr]\n    return [a for c in expr.children() for a in atoms(c)]\n\n\ndef close(expr):\n    if z3.is_const(expr) and z3.is_bool(expr) or z3.is_eq(expr) and all(z3.is_bool(c) for c in expr.children()):\n        return expr\n    if z3.is_and(expr):\n        return z3.And(*[close(c) for c in expr.children()])\n    # simplify represents strict arithmetic comparisons as negated weak ones.\n    if z3.is_not(expr):\n        inner = expr.arg(0)\n        op = inner.decl().kind()\n        if op in (z3.Z3_OP_LE, z3.Z3_OP_LT):\n            return inner.arg(0) >= inner.arg(1)\n        if op in (z3.Z3_OP_GE, z3.Z3_OP_GT):\n            return inner.arg(0) <= inner.arg(1)\n    op = expr.decl().kind()\n    if op == z3.Z3_OP_LT:\n        return expr.arg(0) <= expr.arg(1)\n    if op == z3.Z3_OP_GT:\n        return expr.arg(0) >= expr.arg(1)\n    if not conjunction(expr):\n        raise UnsupportedFragment('cell is not a convex conjunction: ' + expr.sexpr())\n    return expr\n\n\ndef _value(model, expr):\n    v = model.eval(expr, model_completion=True)\n    if z3.is_bool(v):\n        return z3.is_true(v)\n    return str(fraction(v))\n\n\ndef domain_size(values):\n    # len(range(...)) overflows at sys.maxsize even though indexing remains exact.\n    if isinstance(values, range):\n        distance = values.stop - values.start if values.step > 0 else values.start - values.stop\n        return max(0, (distance + abs(values.step) - 1) // abs(values.step))\n    return len(values)\n\n\ndef lazy_product(values):\n    sizes = [domain_size(v) for v in values]\n    if any(n == 0 for n in sizes):\n        return\n    indices = [0] * len(values)\n    while True:\n        yield tuple(v[i] for v, i in zip(values, indices))\n        for axis in range(len(values) - 1, -1, -1):\n            indices[axis] += 1\n            if indices[axis] < sizes[axis]:\n                break\n            indices[axis] = 0\n        else:\n            return\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '203,335p' scripts/rational_solver_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '203,335p' scripts/rational_solver_v1.py\"","aggregated_output":"def solve(problem, budget, objective=None, *, selected_views=(), view_operator=None,\n          extra=(), backend=None):\n    backend = backend or Backend()\n    started = time.monotonic()\n    result = {'schema_version': 'accdsl.reconstruction.result.v1', 'scope': problem.scope,\n              'evidence_view': problem.evidence_view, 'query': {'views': list(selected_views),\n              'operator': view_operator, 'extra': [x.sexpr() for x in extra]},\n              'status': 'Unknown', 'feasibility': 'Unknown', 'cells': [],\n              'obligations': list(problem.obligations), 'exclusions': list(problem.exclusions),\n              'provenance': problem.provenance, 'rounding_stage': problem.rounding_stage,\n              'coverage': {'total': None, 'completed': 0, 'feasible': 0, 'infeasible': 0,\n                           'unresolved': None, 'partition': 'finite assignments and disjoint comparison signs'},\n              'bounds': None, 'generated_constraints': [], 'unsupported': list(problem.unsupported)}\n    labels = list(problem.constraints)\n    if selected_views:\n        if len(selected_views) > 1 and view_operator not in ('intersection', 'union'):\n            raise ValueError('multiple views require explicit intersection or union')\n        if view_operator not in (None, 'intersection', 'union'):\n            raise ValueError('unknown view operator')\n        views = [problem.views[n] for n in selected_views]\n        condition = z3.Or(*views) if view_operator == 'union' else z3.And(*views)\n        labels.append(('query:views', condition))\n    labels.extend((f'query:extra:{i}', x) for i, x in enumerate(extra))\n    result['generated_constraints'] = [{'id': n, 'formula': e.sexpr()} for n, e in labels]\n    result['finite_domains'] = {n: ({'start': v.start, 'stop': v.stop, 'step': v.step}\n                                  if isinstance(v, range) else list(v))\n                               for n, v in problem.finite.items()}\n    try:\n        if problem.unsupported:\n            raise UnsupportedFragment('; '.join(problem.unsupported))\n        symbols = [v.sexpr() for v in problem.variables.values()]\n        if len(set(symbols)) != len(symbols):\n            raise ValueError('economic identifiers must name distinct solver variables')\n        for name, values in problem.finite.items():\n            if name not in problem.variables or not isinstance(values, (list, tuple, range)):\n                raise ValueError('finite domain must be an indexed domain of a declared variable')\n            v = problem.variables[name]\n            if not (z3.is_int(v) or z3.is_bool(v)) or not domain_size(values):\n                raise ValueError('finite choices require nonempty integer/Boolean domains')\n            if isinstance(values, range):\n                if z3.is_bool(v):\n                    raise ValueError('Boolean choices require Boolean values')\n            elif (any(type(x) is not (bool if z3.is_bool(v) else int) for x in values)\n                  or len(set(values)) != len(values)):\n                raise ValueError('finite domain values must be distinct and match the variable sort')\n        for _, e in labels:\n            validate_formula(e)\n        for e in problem.outputs.values():\n            affine(e)\n        if objective is not None:\n            affine(objective)\n        from z3.z3util import get_vars\n        declared = {v.sexpr() for v in problem.variables.values()}\n        expressions = [e for _, e in labels] + list(problem.outputs.values())\n        if objective is not None:\n            expressions.append(objective)\n        if any(v.sexpr() not in declared for e in expressions for v in get_vars(e)):\n            raise UnsupportedFragment('undeclared symbolic variable in query or constraints')\n        for name, v in problem.variables.items():\n            if (z3.is_int(v) or z3.is_bool(v)) and name not in problem.finite:\n                raise UnsupportedFragment('unbounded integer/Boolean domain: ' + name)\n    except UnsupportedFragment as exc:\n        result.update(status='UnsupportedFragment', reason=str(exc))\n        return result\n    count_nodes = sum(nodes(e) for _, e in labels) + sum(nodes(e) for e in problem.outputs.values())\n    if objective is not None:\n        count_nodes += nodes(objective)\n    if problem.slots > budget.max_slots or count_nodes > budget.max_formula_nodes:\n        result.update(status='PartialSearch', reason='slot/formula resource limit')\n        return result\n    assignment_count = math.prod(domain_size(v) for v in problem.finite.values())\n    # Only comparisons inside non-conjunctive Boolean formulae require sign cells.\n    split = {}\n    for _, e in labels:\n        if not conjunction(e):\n            for a in atoms(e):\n                split[a.sexpr()] = a\n    split = [split[k] for k in sorted(split)]\n    result['partition_predicates'] = [e.sexpr() for e in split]\n    signs_count = 3 ** len(split)\n    total = assignment_count * signs_count\n    result['coverage']['total'] = total\n    result['coverage']['unresolved'] = total\n    result['coverage']['integer_choice_assignments'] = assignment_count\n    result['coverage']['view_labels_counted_as_choices'] = False\n    finite_names = sorted(problem.finite)\n    finite_values = [problem.finite[n] for n in finite_names]\n    next_ordinal = 0\n    stopped = None\n\n    def remaining():\n        return budget.elapsed_ms - int((time.monotonic() - started) * 1000)\n\n    def configure(solver):\n        if remaining() <= 0 or budget.solver_timeout_ms == 0 or budget.solver_rlimit == 0:\n            return False\n        solver.set(timeout=max(1, min(budget.solver_timeout_ms, remaining())), rlimit=budget.solver_rlimit)\n        return True\n\n    def check(formulas, stage):\n        s = z3.Solver()\n        if not configure(s):\n            return z3.unknown, s\n        s.add(*formulas)\n        return backend.check(s, stage), s\n\n    def endpoint(original, obj, direction):\n        closure = [close(x) for x in original]\n        opt = z3.Optimize()\n        if not configure(opt):\n            return {'certified': False, 'status': 'Unknown', 'reason': 'resource limit'}\n        opt.add(*closure)\n        handle = opt.minimize(obj) if direction == 'lower' else opt.maximize(obj)\n        reply = backend.optimize(opt, 'optimize:' + direction)\n        if reply != z3.sat:\n            return {'certified': False, 'status': 'Unknown', 'reason': str(reply)}\n        val = handle.value()\n        if 'oo' in str(val):\n            return {'certified': True, 'status': 'Unbounded', 'value': None, 'attained': False,\n                    'certificate': {'closure': [x.sexpr() for x in closure], 'optimizer_value': str(val)}}\n        bound = fraction(val)\n        better = obj < q(bound) if direction == 'lower' else obj > q(bound)\n        proof, _ = check(closure + [better], 'bound-proof:' + direction)\n        attain, ss = check(original + [obj == q(bound)], 'attainment:' + direction)\n        ok = proof == z3.unsat and attain in (z3.sat, z3.unsat)\n        return {'certified': ok, 'status': 'Finite' if ok else 'Unknown', 'value': str(bound),\n                'attained': (attain == z3.sat) if attain != z3.unknown else None,\n                'witness': {n: _value(ss.model(), v) for n, v in problem.variables.items()} if attain == z3.sat else None,\n                'certificate': {'no_better': str(proof), 'no_better_query': better.sexpr(),\n                                'attainment': str(attain), 'attainment_query': (obj == q(bound)).sexpr()}}\n\n    for ai, values in enumerate(lazy_product(finite_values)):\n        if ai >= budget.max_integer_assignments:\n","exit_code":0,"status":"completed"}}
