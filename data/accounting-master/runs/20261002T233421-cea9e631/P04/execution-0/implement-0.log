{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '20,80p' scripts/check_accounting_p04.py\nsed -n '1,125p' scripts/check_accounting_p03.py\"","aggregated_output":"SOURCES=['scripts/rational_solver_v1.py','scripts/reconstruction_v1.py','scripts/check_accounting_p04.py','tests/test_accounting_p04.py','docs/design/spec/reconstruction-profile-v1.md','docs/design/fixtures/p04-reconstruction-cases-v1.json']\nOUTPUTS=['data/accounting-master/deliverables/P04/'+p for p in ('conformance.json','result.md','progress.md')]\n\ndef main(argv=None):\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--output-dir',required=True)\n    parser.add_argument('--execution-inventory',required=True)\n    args=parser.parse_args(argv)\n    if Path(args.output_dir).resolve()!=ROOT/'data/accounting-master/deliverables/P04':\n        parser.error('use the declared P04 output directory')\n    if args.execution_inventory!=INVENTORY:\n        parser.error('use the supplied supervisor phase-entry inventory')\n    os.environ['CUDA_VISIBLE_DEVICES']='-1'\n    started=time.monotonic();utc=datetime.now(timezone.utc).isoformat()\n    protected=capture_protection(ROOT,INVENTORY,INVENTORY,writable=SOURCES+OUTPUTS,\n                                 required_paths=('docs/design/fixtures/borrowings.json','docs/design/fixtures/northstar.json','scripts/core0_ir_v1.py'))\n    approved=json.loads((ROOT/PLAN).read_text())\n    if approved['review']['verdict']!='AGREE' or approved['review']['issues']:\n        raise ValueError('no issue-free approved plan')\n    if protected['errors'] or protected['changed_since_execution_entry'] or protected['missing_before_check']:\n        raise ValueError('protection failure before execution: '+str(protected['errors']+protected['changed_since_execution_entry']))\n    source_before={p:digest(ROOT/p) for p in SOURCES+[PLAN]}\n    sys.path.insert(0,str(ROOT/'tests'))\n    import test_accounting_p04 as p04\n    import test_accounting_p03 as p03\n    p04.OBSERVATIONS.clear();p03.OBSERVATIONS.clear()\n    reports={}\n    for name,module in [('P04',p04),('P03_regression',p03)]:\n        stream=io.StringIO();suite=unittest.defaultTestLoader.loadTestsFromModule(module)\n        result=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)\n        reports[name]={'methods':result.testsRun,'failures':len(result.failures),'errors':len(result.errors),\n                       'skips':len(result.skipped),'passed':result.wasSuccessful() and result.testsRun>0 and not result.skipped,'output':stream.getvalue()}\n    catalog=json.loads((ROOT/SOURCES[-1]).read_text())\n    required=Counter(x['id'] for x in catalog['obligations']);observed=Counter(x['obligation'] for x in p04.OBSERVATIONS)\n    status={'required':len(required),'observed':len(observed),'missing':sorted(required.keys()-observed.keys()),\n            'uncatalogued':sorted(observed.keys()-required.keys()),\n            'duplicate_ids':sorted(k for k in required.keys()|observed.keys() if required[k]>1 or observed[k]>1),\n            'failed_observations':[x['obligation'] for x in p04.OBSERVATIONS if x.get('passed') is not True]}\n    finish_protection(ROOT,protected)\n    source_after={p:digest(ROOT/p) for p in source_before}\n    stable=all(h is not None and source_after[p]==h for p,h in source_before.items())\n    passed=all(r['passed'] for r in reports.values()) and protected['passed'] and stable and bool(required) and not any(status[k] for k in ('missing','uncatalogued','duplicate_ids','failed_observations'))\n    command=shlex.join(['python3','-B','scripts/check_accounting_p04.py']+(sys.argv[1:] if argv is None else argv))\n    payload={'schema_version':'accdsl.p04.conformance.v1','passed':bool(passed),'obligation_status':status,\n        'tests':reports,'observations':p04.OBSERVATIONS,'protection':protected,'code_stable_during_check':stable,\n        'input_source_test_hashes':dict(protected['before'],**source_before),\n        'manifest':{'git_commit':'unavailable: existing marker is not a usable repository','command':command,\n            'working_directory':str(ROOT),'executable':sys.executable,'environment':{'python':platform.python_version(),'z3':z3.get_version_string()},\n            'hardware':'CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported','random_seeds':'N/A: exact deterministic fixtures',\n            'data_version':'p04-reconstruction-cases-v1 plus preserved borrowing/Northstar fixtures','started_utc':utc,\n            'wall_seconds':round(time.monotonic()-started,6),'plan':PLAN,'plan_sha256':source_before[PLAN],\n            'execution_inventory':INVENTORY,'changed_source_code_test_files':SOURCES,'changed_files':SOURCES+OUTPUTS,\n            'outputs':OUTPUTS[:2],'result':OUTPUTS[1]},\n        'requirement_coverage':{'MC08':'shared symbols, choices, views and joint queries','MC09':'declared posting templates and bounded coverage',\n            'MC10':'six structural admission categories with provenance; external eligibility not independently certified',\n            'MC11':'unhedged additive bullet-debt grouping with retained memory','MC12':'explicit finite joint weights and retained mass',\n            'MC18':'strict bounds and unfinished cells','MC26':'exact rational linear and bounded integer numerical operations'},\n        'unsupported':catalog['unsupported'],\n        'acceptance':{'engineering':bool(passed),'accounting_validity':'not established','forecast_validity':'not established','human_acceptance':'pending','whole_gap_closure':False}}\n    decision='PASS' if passed else 'FAIL'\n    text=f'''# P04 bounded reconstruction result\n#!/usr/bin/env python3\n\"\"\"Execute catalogued P03 obligations with durable protection provenance.\"\"\"\nimport argparse\nfrom collections import Counter\nfrom datetime import datetime, timezone\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport platform\nimport re\nimport shlex\nimport sys\nimport time\nimport unittest\nfrom importlib.metadata import version\n\nROOT = Path(__file__).resolve().parents[1]\nCHANGED = ['scripts/core0_frontends_v1.py', 'scripts/core0_ir_v1.py',\n           'scripts/check_accounting_p03.py', 'tests/test_accounting_p03.py',\n           'docs/design/spec/core0-lowering-profile-v1.md',\n           'docs/design/fixtures/p03-lowering-cases-v1.json']\nOUTPUTS = ['data/accounting-master/deliverables/P03/' + name\n           for name in ('conformance.json', 'result.md', 'progress.md')]\nPHASE_FILES = CHANGED + OUTPUTS\nPHASE_INVENTORY = 'data/accounting-master/runs/20261002T181809-4cb566e0/P03/phase-entry-inventory.json'\nEXECUTION_INVENTORY = 'data/accounting-master/runs/20261002T221346-d54a6552/P03/execution-0/pre-edit-files.json'\nAPPROVED_PLAN = 'data/accounting-master/runs/20261002T221346-d54a6552/P03/approved-plan.json'\n\n\ndef digest(path):\n    try:\n        return hashlib.sha256(path.read_bytes()).hexdigest()\n    except OSError:\n        return None\n\n\ndef _unique_object(pairs):\n    result = {}\n    for key, value in pairs:\n        if key in result:\n            raise ValueError('duplicate inventory key: ' + key)\n        result[key] = value\n    return result\n\n\ndef _inventory(root, relative):\n    path = Path(relative)\n    if path.is_absolute() or '..' in path.parts or path.as_posix() != relative:\n        raise ValueError('inventory path must be repository-relative')\n    data = json.loads((root / path).read_text(), object_pairs_hook=_unique_object)\n    if not isinstance(data, dict) or not data:\n        raise ValueError('inventory must be a nonempty path-to-SHA256 object')\n    for name, value in data.items():\n        p = Path(name)\n        if (p.is_absolute() or '..' in p.parts or p.as_posix() != name\n                or not isinstance(value, str) or not re.fullmatch('[0-9a-f]{64}', value)):\n            raise ValueError('invalid inventory entry: ' + name)\n    return data\n\n\ndef capture_protection(root, historical_path, execution_path, writable=PHASE_FILES,\n                       required_paths=()):\n    \"\"\"Keep historical differences separate; never replace the execution baseline.\"\"\"\n    errors = []\n    inventories = []\n    for name in (historical_path, execution_path):\n        try:\n            inventories.append(_inventory(root, name))\n        except (OSError, ValueError) as exc:\n            errors.append(f'{name}: {exc}')\n            inventories.append({})\n    historical, execution = inventories\n    protected = sorted((set(historical) | set(execution) | set(required_paths)) - set(writable))\n    absent = sorted(set(protected) - set(execution))\n    if absent:\n        errors.append('execution inventory omits protected paths: ' + ', '.join(absent))\n    before = {p: digest(root / p) for p in protected}\n    return {\n        'historical_inventory': historical_path,\n        'execution_inventory': execution_path,\n        'inventory_hashes': {p: digest(root / p) for p in (historical_path, execution_path)},\n        'excluded_phase_files': list(writable),\n        'errors': errors,\n        'execution_baseline': {p: execution.get(p) for p in protected},\n        'before': before,\n        'missing_before_check': [p for p, h in before.items() if h is None],\n        'changed_since_execution_entry': [p for p in protected if before[p] != execution.get(p)],\n        'historical_differences': [\n            {'path': p, 'phase_entry_sha256': historical[p], 'execution_entry_sha256': execution[p],\n             'attribution': 'Predates this execution, as recorded by the supervisor pre-edit inventory.'}\n            for p in sorted(set(historical) & set(execution) - set(writable))\n            if historical[p] != execution[p]],\n    }\n\n\ndef finish_protection(root, report):\n    report['after'] = {p: digest(root / p) for p in report['before']}\n    report['changed_during_check'] = [p for p in report['before'] if report['before'][p] != report['after'][p]]\n    report['changed_inventory_records'] = [p for p, h in report['inventory_hashes'].items()\n                                           if h is None or digest(root / p) != h]\n    report['passed'] = not any(report[k] for k in (\n        'errors', 'missing_before_check', 'changed_since_execution_entry',\n        'changed_during_check', 'changed_inventory_records'))\n    return report\n\n\ndef obligation_status(catalog, observations):\n    required_counts = Counter(c['id'] for c in catalog['obligations'])\n    observed_counts = Counter(c['id'] for c in observations)\n    required, observed = set(required_counts), set(observed_counts)\n    return {\n        'obligations_required': len(required), 'obligations_run': len(observed),\n        'missing': sorted(required - observed), 'uncatalogued': sorted(observed - required),\n        'duplicate_ids': sorted(k for k in required | observed\n                                if required_counts[k] > 1 or observed_counts[k] > 1),\n        'failed_observations': [c['id'] for c in observations if c.get('passed') is not True],\n    }\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--output-dir', required=True)\n    parser.add_argument('--execution-inventory', default=EXECUTION_INVENTORY)\n    args = parser.parse_args(argv)\n","exit_code":0,"status":"completed"}}
