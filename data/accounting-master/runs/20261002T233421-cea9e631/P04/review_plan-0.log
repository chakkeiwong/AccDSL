approved['review'].get('issues') != []:\n143:            protection['errors'].append('approved plan lacks an issue-free AGREE review')\n157:        protection['errors'].append('approved plan changed during check')\n175:            'execution_inventory': args.execution_inventory,\n178:                if code_after[p] != _inventory(ROOT, args.execution_inventory).get(p)]\n228:Protection uses the durable historical inventory `{PHASE_INVENTORY}` and current\n229:supervisor execution inventory `{args.execution_inventory}`. There are\n232:inventory evidence, absent protected paths, changes since execution entry or\n234:Conformance JSON preserves the inventory hashes, per-file baselines, actual IR,\n#!/usr/bin/env python3\n\"\"\"Execute catalogued P03 obligations with durable protection provenance.\"\"\"\nimport argparse\nfrom collections import Counter\nfrom datetime import datetime, timezone\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport platform\nimport re\nimport shlex\nimport sys\nimport time\nimport unittest\nfrom importlib.metadata import version\n\nROOT = Path(__file__).resolve().parents[1]\nCHANGED = ['scripts/core0_frontends_v1.py', 'scripts/core0_ir_v1.py',\n           'scripts/check_accounting_p03.py', 'tests/test_accounting_p03.py',\n           'docs/design/spec/core0-lowering-profile-v1.md',\n           'docs/design/fixtures/p03-lowering-cases-v1.json']\nOUTPUTS = ['data/accounting-master/deliverables/P03/' + name\n           for name in ('conformance.json', 'result.md', 'progress.md')]\nPHASE_FILES = CHANGED + OUTPUTS\nPHASE_INVENTORY = 'data/accounting-master/runs/20261002T181809-4cb566e0/P03/phase-entry-inventory.json'\nEXECUTION_INVENTORY = 'data/accounting-master/runs/20261002T221346-d54a6552/P03/execution-0/pre-edit-files.json'\nAPPROVED_PLAN = 'data/accounting-master/runs/20261002T221346-d54a6552/P03/approved-plan.json'\n\n\ndef digest(path):\n    try:\n        return hashlib.sha256(path.read_bytes()).hexdigest()\n    except OSError:\n        return None\n\n\ndef _unique_object(pairs):\n    result = {}\n    for key, value in pairs:\n        if key in result:\n            raise ValueError('duplicate inventory key: ' + key)\n        result[key] = value\n    return result\n\n\ndef _inventory(root, relative):\n    path = Path(relative)\n    if path.is_absolute() or '..' in path.parts or path.as_posix() != relative:\n        raise ValueError('inventory path must be repository-relative')\n    data = json.loads((root / path).read_text(), object_pairs_hook=_unique_object)\n    if not isinstance(data, dict) or not data:\n        raise ValueError('inventory must be a nonempty path-to-SHA256 object')\n    for name, value in data.items():\n        p = Path(name)\n        if (p.is_absolute() or '..' in p.parts or p.as_posix() != name\n                or not isinstance(value, str) or not re.fullmatch('[0-9a-f]{64}', value)):\n            raise ValueError('invalid inventory entry: ' + name)\n    return data\n\n\ndef capture_protection(root, historical_path, execution_path, writable=PHASE_FILES,\n                       required_paths=()):\n    \"\"\"Keep historical differences separate; never replace the execution baseline.\"\"\"\n    errors = []\n    inventories = []\n    for name in (historical_path, execution_path):\n        try:\n            inventories.append(_inventory(root, name))\n        except (OSError, ValueError) as exc:\n            errors.append(f'{name}: {exc}')\n            inventories.append({})\n    historical, execution = inventories\n    protected = sorted((set(historical) | set(execution) | set(required_paths)) - set(writable))\n    absent = sorted(set(protected) - set(execution))\n    if absent:\n        errors.append('execution inventory omits protected paths: ' + ', '.join(absent))\n    before = {p: digest(root / p) for p in protected}\n    return {\n        'historical_inventory': historical_path,\n        'execution_inventory': execution_path,\n        'inventory_hashes': {p: digest(root / p) for p in (historical_path, execution_path)},\n        'excluded_phase_files': list(writable),\n        'errors': errors,\n        'execution_baseline': {p: execution.get(p) for p in protected},\n        'before': before,\n        'missing_before_check': [p for p, h in before.items() if h is None],\n        'changed_since_execution_entry': [p for p in protected if before[p] != execution.get(p)],\n        'historical_differences': [\n            {'path': p, 'phase_entry_sha256': historical[p], 'execution_entry_sha256': execution[p],\n             'attribution': 'Predates this execution, as recorded by the supervisor pre-edit inventory.'}\n            for p in sorted(set(historical) & set(execution) - set(writable))\n            if historical[p] != execution[p]],\n    }\n\n\ndef finish_protection(root, report):\n    report['after'] = {p: digest(root / p) for p in report['before']}\n    report['changed_during_check'] = [p for p in report['before'] if report['before'][p] != report['after'][p]]\n    report['changed_inventory_records'] = [p for p, h in report['inventory_hashes'].items()\n                                           if h is None or digest(root / p) != h]\n    report['passed'] = not any(report[k] for k in (\n        'errors', 'missing_before_check', 'changed_since_execution_entry',\n        'changed_during_check', 'changed_inventory_records'))\n    return report\n\n\ndef obligation_status(catalog, observations):\n    required_counts = Counter(c['id'] for c in catalog['obligations'])\n    observed_counts = Counter(c['id'] for c in observations)\n    required, observed = set(required_counts), set(observed_counts)\n    return {\n        'obligations_required': len(required), 'obligations_run': len(observed),\n        'missing': sorted(required - observed), 'uncatalogued': sorted(observed - required),\n        'duplicate_ids': sorted(k for k in required | observed\n                                if required_counts[k] > 1 or observed_counts[k] > 1),\n        'failed_observations': [c['id'] for c in observations if c.get('passed') is not True],\n    }\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--output-dir', required=True)\n    parser.add_argument('--execution-inventory', default=EXECUTION_INVENTORY)\n    args = parser.parse_args(argv)\n    out = Path(args.output_dir).resolve()\n    if out != ROOT / 'data/accounting-master/deliverables/P03':\n        parser.error('output-dir must be the declared P03 output directory')\n    started = time.monotonic()\n    started_utc = datetime.now(timezone.utc).isoformat()\n    protection = capture_protection(ROOT, PHASE_INVENTORY, args.execution_inventory,\n                                    required_paths=('docs/design/spec/core-0.lark',\n                                                    'docs/design/spec/core-ir.schema.json',\n                                                    'docs/design/fixtures/borrowing.acc',\n                                                    'docs/design/fixtures/demo-debt-package.json'))\n    code_before = {p: digest(ROOT / p) for p in CHANGED}\n    plan_hash = digest(ROOT / APPROVED_PLAN)\n    if plan_hash is None:\n        protection['errors'].append('approved plan is missing or unreadable')\n    else:\n        approved = json.loads((ROOT / APPROVED_PLAN).read_text())\n        if approved.get('review', {}).get('verdict') != 'AGREE' or approved['review'].get('issues') != []:\n            protection['errors'].append('approved plan lacks an issue-free AGREE review')\n    # Lazy import keeps checker helpers usable by the required regression suite.\n    sys.path.insert(0, str(ROOT / 'tests'))\n    import test_accounting_p03 as cases\n    cases.OBSERVATIONS.clear()\n    stream = io.StringIO()\n    suite = unittest.defaultTestLoader.loadTestsFromModule(cases)\n    result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)\n    catalog = json.loads((ROOT / 'docs/design/fixtures/p03-lowering-cases-v1.json').read_text())\n    status = obligation_status(catalog, cases.OBSERVATIONS)\n    finish_protection(ROOT, protection)\n    code_after = {p: digest(ROOT / p) for p in CHANGED}\n    changed_code = [p for p in CHANGED if code_before[p] is None or code_before[p] != code_after[p]]\n    if digest(ROOT / APPROVED_PLAN) != plan_hash:\n        protection['errors'].append('approved plan changed during check')\n        protection['passed'] = False\n    passed = (result.wasSuccessful() and result.testsRun > 0 and not result.skipped\n              and bool(status['obligations_required']) and not changed_code and protection['passed']\n              and not any(status[k] for k in ('missing', 'uncatalogued', 'duplicate_ids', 'failed_observations')))\n    command_args = sys.argv[1:] if argv is None else argv\n    payload = {\n        'schema_version': 'accdsl.p03.conformance.v1', 'passed': bool(passed), 'profile': catalog['profile'],\n        'manifest': {\n            'git_commit': 'unavailable: existing marker is not a usable repository',\n            'command': shlex.join(['python3', '-B', 'scripts/check_accounting_p03.py'] + command_args),\n            'working_directory': str(ROOT), 'executable': sys.executable,\n            'environment': {'python': platform.python_version(), 'lark': version('lark'), 'jsonschema': version('jsonschema')},\n            'hardware': 'CPU only; no accelerator framework imported', 'random_seeds': 'N/A: deterministic checks',\n            'data_version': 'synthetic P03 bindings and digest-locked DemoDebt@1',\n            'started_utc': started_utc, 'utc': datetime.now(timezone.utc).isoformat(),\n            'wall_seconds': round(time.monotonic() - started, 3),\n            'plan': APPROVED_PLAN, 'plan_sha256': plan_hash,\n            'execution_inventory': args.execution_inventory,\n            'result': OUTPUTS[1], 'outputs': OUTPUTS[:2], 'changed_files': PHASE_FILES,\n            'changed_this_execution': [p for p in CHANGED\n                if code_after[p] != _inventory(ROOT, args.execution_inventory).get(p)]\n                if not protection['errors'] else 'unavailable: protection evidence failed'},\n        'tests': dict(status, methods_run=result.testsRun, skipped=result.skipped,\n                      failures=[{'test': str(t), 'detail': d} for t, d in result.failures + result.errors],\n                      runner_output=stream.getvalue()),\n        'observations': cases.OBSERVATIONS, 'hashes': code_after,\n        'checked_input_integrity': {'before': code_before, 'after': code_after, 'changed': changed_code},\n        'protected_files': protection,\n        'requirement_coverage': {\n            'MC02': 'bounded context and numeric/source provenance',\n            'MC04': 'separate evidence, assumptions, alternatives and global constraints',\n            'MC10': 'explicit factual admission and scenario assumptions; broader uncertainty unsupported',\n            'MC20': 'DemoDebt package digest/applicability and report policies; cross-company mappings unsupported',\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' docs/design/spec/reconstruction-profile-v1.md; rg -n '\"'^    def test_|MC08|MC09|MC10|MC11|MC12|MC18|MC26'\"' tests/test_accounting_p04.py docs/plans/accounting-mission-requirements.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' docs/design/spec/reconstruction-profile-v1.md; rg -n '\"'^    def test_|MC08|MC09|MC10|MC11|MC12|MC18|MC26'\"' tests/test_accounting_p04.py docs/plans/accounting-mission-requirements.md\"","aggregated_output":"# Bounded reconstruction v1\n\nThis executable profile addresses MC08–MC12, MC18 and MC26. It constructs a joint\nfamily from declared templates, slots, openings, dated mappings and admitted\nobservations. It does not discover templates or infer arbitrary company histories.\n\n## Pre-execution research intent and evidence contract\n\nQuestion: do declared inputs generate the correct family within their finite\nscope? Mechanism: rational linear constraints with shared economic identifiers,\nexplicit finite choices and bounded integer domains. Expected failure modes are\nlost dependence, wrong strict endpoints, unexamined rounding and false completeness.\nComparators are an independent Fraction replay/enumerator over original fixtures\nand analytic continuous bounds. Exact feasible-set equality and endpoint proofs\nare pass criteria. Unsupported operations, unknown backend replies, unfinished\ncells or unresolved matching obligations veto exact certification. Corrupted\ninputs or protection failures veto acceptance and stop the checker. A numerical\nfailure triggers repair, not rejection of the research direction. Runtime is\nexplanatory only. No superiority, general accounting validity, forecast validity,\ncontinuous probabilistic inference or human acceptance follows from these checks.\nConformance JSON and result.md preserve results; progress.md is a reset checkpoint.\n\nSkeptical audit: the earlier ambiguity between named views and search choices is\nresolved explicitly below. Baselines use original inputs, not generated expected\nanswers. Fixture sizes and budgets are engineering choices. No stochastic ranking\nor production-default promotion is attempted. A successful command can still be\nmisleading if both construction and oracle share lowering; the oracle therefore\nreplays postings independently. The integration checks inspect the unnamed\ninterior, not only endpoint extrema.\n\n## Assumptions and defaults\n\n| Choice | Provenance/status | Justification | Failure mode / early diagnostic |\n| --- | --- | --- | --- |\n| Fraction arithmetic | Core contract, reviewed requirement | exact disclosed decimals | binary-float drift; reject floats |\n| Z3 rational linear solving | existing 4.16.0, implementation hypothesis | exact linear SAT and optimisation | shared backend error; independent enumeration and algebra |\n| finite templates/slots | explicit input, scope hypothesis | tractable reconstruction | omitted histories; preserve exclusions and obligations |\n| budgets | explicit caller input, convenience | bounded execution | premature stop; zero-work and one-cell tests |\n| rounding convention/stage | explicit input, no inferred default | preserve disclosure versus posting semantics | wrong ties; negative/parity fixtures |\n| finite probability measure | explicit joint atoms, hypothesis | dependence and exact Bayes update | overlap/double use; reject duplicate atoms/information |\n| grouping | explicit additive debt profile only | retain contract memory | different resets/maturities/horizon; revalidation tests |\n| deterministic fixtures | engineering comparator | exhaustive small checks | not representative; no empirical forecast claim |\n\n## Family and query semantics\n\nParent P contains opening, slot, transition, mapping and observation constraints.\nNamed view i supplies A_i only. A parent query uses P; a single-view query uses\nP AND A_i. Multiple views require explicit intersection or union. Views may\noverlap or fail to cover P; labels supply neither exclusivity nor probabilities.\nActual finite choices enumerate all declared values jointly. Boolean predicates\nare split by an exhaustive truth-assignment partition of their atomic comparisons;\neach cell includes the formula and its decision prefix. The partition is disjoint\nby construction. Integer variables are enumerated only with finite declared bounds.\nEach candidate assignment/predicate cell is counted once, including infeasible\ncells. Views do not add cells unless their explicit Boolean predicate requires a\nlogical partition. Continuous regions remain symbolic. Unvisited suffixes are\nrepresented by ordinal range and the unchanged family formula.\n\nSlots instantiate nonnegative amounts and an active flag; inactive means zero.\nActive zero is permitted. Both signed posting incidence and economic-state\ncoefficients are declared by the template. Exact context equality is required\nfor observations. One observation ID cannot silently supply incompatible domains.\nUnmatched obligations remain unresolved. Admission records keep six uncertainty\ncategories separate. Stress is conditional, not observed evidence or a likelihood.\n\n## Numerical semantics\n\nFeasibility is checked on each original strict cell before closure optimisation.\nA nonempty convex linear cell has the same infimum/supremum as its closure: for\nany original feasible point x and any closure point y, (1-t)y+t x satisfies every\nstrict inequality for 0<t<=1 and tends to y. The solver therefore optimises closed\ninequalities, proves no better closed value, then tests equality with the endpoint\nunder original constraints. Empty strict cells never acquire relaxation witnesses.\nUnknown in any proof or endpoint test leaves the bound uncertified. Unbounded,\nUnknown, Infeasible and PartialSearch remain distinct. Partial-cell extrema are\nexplored-only, never global certificates.\n\nDebt amounts F,V satisfy F>=0, V>=0, F+V=D. For exact D>0, alpha=F/D is equivalent\nto the fraction parameterisation. With rounded D, use amounts directly. A fixed\nfraction comparison F/D op a may multiply by D only after proving D>0 (or reverse\nthe comparison after proving D<0). Unknown sign or an unknown threshold is\nunsupported. Unknown-by-unknown products and unbounded integer domains are also\nunsupported; they never imply infeasibility.\n\nDisclosure intervals retain inclusion flags. Half-even display domains include\nboth ties for an even displayed minor-unit integer and neither for an odd one.\nPosting quantisation rounds exact rationals at the declared boundary. Symbolic\nposting amounts use bounded integers; continuous relaxation is forbidden.\n\nFinite measures use unique joint atom IDs with weights summing to one. Conditional\nviews are events on atoms. Likelihood information blocks can be used once. Default\nand unresolved mass are retained; unavailable outcomes prevent an unconditional\nmean. Grouping requires matching rate/reset/maturity/hedge keys and additive\ntransition/report checks for the explicit scenario and horizon; contract memory\nis retained. These tests do not prove general aggregation equivalence.\n\n## Execution\n\nUse existing Python/Z3, standard library and accepted P03 dependencies; install\nnothing. Run `python3 -B -m unittest discover -s tests -p 'test_accounting_p04.py' -v`\nand the analogous P03 regression, followed by `python3 -B scripts/check_accounting_p04.py\n--output-dir data/accounting-master/deliverables/P04 --execution-inventory\n data/accounting-master/runs/20261002T221346-d54a6552/P04/phase-entry-inventory.json`.\nNo accelerator framework is used; CPU-only checks intentionally hide GPU devices.\nThe checker records actual versions, elapsed time, hashes, generated formulas,\nproof queries, observations and protection comparisons. Git is unavailable; content\nhashes preserve provenance. Human acceptance remains pending.\n\n## Implemented input details and residual scope\n\nDates are ordered by the explicit `dates` array, which is the caller's declared\nchronology; strings are not sorted to infer time. `exact_rational` slots carry\nexact amounts. `posting_half_even_quantized_units` slots carry bounded integer\nminor-unit counts and a positive rational quantum. Their posting amount is count\ntimes quantum. Known exact values can be quantised with `half_even` before this\nboundary; no general symbolic rounding of real-valued expressions is implemented.\nMappings cannot shadow economic identifiers. The solver rejects undeclared free\nvariables. Finite domains and comparison predicates accompany unfinished ordinal\nranges so later inspection can reconstruct unvisited regions.\n\nExact rational records require integral numerator and denominator components;\nfractional, Boolean and floating-point components are rejected before conversion.\nDomains must explicitly supply bounds (null permits an unbounded side) and Boolean\ninclusion flags for finite endpoints. Unsupported finite-set domain encodings are\nrejected rather than treated as empty constraints. Generated balance/state names\ncannot replace caller identifiers. Finite choice values are distinct and match\ntheir variable sort. Large finite ranges use exact integer cardinalities and an\niterative lazy enumeration, retaining the unvisited suffix under small budgets.\nGrouping rejects repeated contract IDs to prevent duplicate principal.\n\nFinite-measure atoms must supply complete scalar economic assignments with the\nsame coordinate keys. Distinct assignments are disjoint; repeated assignments\nunder different labels are rejected. The caller supplies the exhaustive joint\nsupport and its justification. View events can overlap as sets of atom IDs, while\natom weights are counted once. Completeness of this external modeling assumption\nis not inferred from normalization. Admission checks validate category fields,\nprovenance, dependencies and declared treatment membership. They do not establish\nthe external truth of evidence, package eligibility or statistical identification.\n\nGrouping supports nonnegative, unhedged, fixed/floating bullet debt only. Principal\nis unchanged within the declared horizon and no maturity occurs there; interest\nis principal times the common rate times the declared year fraction. Summation\npreserves both expressions by distributivity. Additional contract fields,\nhedges, amortization and more general transitions are unsupported. Matching memory\nkeys and request hashes enforce revalidation after relevant changes.\ndocs/plans/accounting-mission-requirements.md:67:| MC08 | Preserve jointly consistent discrete alternatives and continuous unknowns across accounts, notes and dates. U2, D. | Define history-family and choice/constraint semantics; provide cases preserving linked alternatives and rejecting incompatible combinations without independent account-by-account selection. | Specified shared symbols, choices and joint formulas in Chs. 2, 6–8. Exact reference checks retain fixed/floating histories, reject incompatible debt and reject incompatible marginal extrema. General reconstruction implementation remains pending. G1, G2, G15. |\ndocs/plans/accounting-mission-requirements.md:68:| MC09 | Construct historical families through a specified method, with honest scope and search completeness. U2, U3, D. | Define candidate templates, model-scope records, instantiation and constraint lowering, feasible/infeasible/unknown results, truncation and coverage evidence. | Specified finite template/slot construction and coverage rules in Ch. 6/Core 0. Northstar bridges are solved and checked within the declared scope; completeness concerns that model only. A compiler for arbitrary supported template registries remains pending. G1, G3. |\ndocs/plans/accounting-mission-requirements.md:69:| MC10 | Distinguish uncertainty about facts, disclosure readings, admissible accounting treatment, estimates, behaviour and future shocks. U2, P, D. | Specify the categories, dependencies and admissibility checks; show why a factual unknown, permitted election and unsupported treatment cannot be substituted for one another. | Specified six uncertainty kinds with separate admission/provenance/dependency rules in Core 0 and Chs. 6–8. Examples distinguish factual composition, permitted inventory election and unsupported treatment. Factual/assumption admission is now tested for the authored debt case; all-category semantic validation remains pending. G6, G15. |\ndocs/plans/accounting-mission-requirements.md:70:| MC11 | Preserve the economic memory and scenario responses needed when histories are aggregated or refined. U2, D. | Define required state by contract/lot/cohort, permitted grouping transformations, supported horizon/scenarios, exact versus approximate status and invalidation when the query changes. | Specified grouping keys, additive transition/report proof, exact/approximate status and query invalidation in Ch. 6/Core 0. Debt, lot and cohort counterexamples are given; a general equivalence checker or empirical approximate-cohort error bound is not established. G1, G16. |\ndocs/plans/accounting-mission-requirements.md:71:| MC12 | Add probabilities only under an explicit justified joint measure, and retain unweighted alternatives when weights are unsupported. U2, P, D. | Specify optional weight/prior/likelihood records, dependence, overlaps, updates and mass preservation; provide a worked weighted and unweighted example with clear interpretation. | Specified finite joint weighting and one-use likelihood update in Ch. 6/Core 0; exact posterior 3/11 and 8/11, mixture and retained unresolved mass are checked. Continuous inference requires a target-specific method and validation. G2, G6, G15. |\ndocs/plans/accounting-mission-requirements.md:82:| MC18 | Preserve joint conditional future outcomes, honest bounds and distinct failure/completeness states. U2, P, D. | Define result payloads and queries that retain branch/path dependence, distinguish sampled ranges from certified bounds and distinguish default from unsupported/numerically failed output without silent dropping or renormalisation. | Specified result cells, branch statuses, strict bound attainment and unresolved mass in Chs. 6, 8, 10/Core 0. Exact linear, joint-output and funding/default reference checks pass; general simulation/result-query implementation remains pending. G2, G3, G6. |\ndocs/plans/accounting-mission-requirements.md:100:| MC26 | Specify supported numerical/solver operations and their limits. U3, P, D. | Define formula fragments, reformulations, exact/approximate monetary treatment, rounding, strict-domain bounds, infeasibility/conflict evidence, timeout and resource behaviour. | Specified rational-linear/finite-choice scope, amount reformulation, quantisation distinctions and typed unknowns in Ch. 6/Core 0. Z3 checks 4.975 attained and 7.035 unattained and concrete histories. Nonlinear solvers and a production rounding/optimization layer remain pending. G3, G10. |\ntests/test_accounting_p04.py:32:    def test_independent_enumeration(self):\ntests/test_accounting_p04.py:55:    def test_p03_parent_views(self):\ntests/test_accounting_p04.py:73:    def test_rounded_strict_and_unbounded(self):\ntests/test_accounting_p04.py:87:    def test_rounding_and_integer_gaps(self):\ntests/test_accounting_p04.py:94:    def test_incomplete_unsupported_unknown(self):\ntests/test_accounting_p04.py:106:    def test_identity_context_conflicts(self):\ntests/test_accounting_p04.py:117:    def test_admission_measure_grouping(self):\ntests/test_accounting_p04.py:141:    def test_view_union_order_and_joint_outputs(self):\ntests/test_accounting_p04.py:158:    def test_genuine_choice_and_activation(self):\ntests/test_accounting_p04.py:170:    def test_limits_and_unknown_bound_stages(self):\ntests/test_accounting_p04.py:183:    def test_posting_units_and_disclosure_rounding(self):\ntests/test_accounting_p04.py:197:    def test_fraction_rewrite_and_nonlinearity(self):\ntests/test_accounting_p04.py:212:    def test_northstar_known_history_and_renaming(self):\ntests/test_accounting_p04.py:235:    def test_input_validation_and_probability_mass(self):\ntests/test_accounting_p04.py:254:    def test_exact_input_boundaries(self):\ntests/test_accounting_p04.py:276:    def test_large_integer_domain_and_partition_oracle(self):\ntests/test_accounting_p04.py:294:    def test_p03_changed_principal_and_rates(self):\n","exit_code":0,"status":"completed"}}
