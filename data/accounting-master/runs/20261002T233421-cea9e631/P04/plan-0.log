{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,88p' scripts/check_accounting_p04.py\nsed -n '1,55p' tests/test_accounting_p04.py\nsed -n '1,43p' docs/design/spec/reconstruction-profile-v1.md\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Execute P04 obligations, regress P03, and retain supervisor inventory evidence.\"\"\"\nimport argparse\nfrom collections import Counter\nfrom datetime import datetime, timezone\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport shlex\nimport sys\nimport time\nimport unittest\nimport z3\nfrom check_accounting_p03 import capture_protection, finish_protection, digest\nROOT=Path(__file__).resolve().parents[1]\nINVENTORY='data/accounting-master/runs/20261002T221346-d54a6552/P04/phase-entry-inventory.json'\nPLAN='data/accounting-master/runs/20261002T221346-d54a6552/P04/approved-plan.json'\nSOURCES=['scripts/rational_solver_v1.py','scripts/reconstruction_v1.py','scripts/check_accounting_p04.py','tests/test_accounting_p04.py','docs/design/spec/reconstruction-profile-v1.md','docs/design/fixtures/p04-reconstruction-cases-v1.json']\nOUTPUTS=['data/accounting-master/deliverables/P04/'+p for p in ('conformance.json','result.md','progress.md')]\n\ndef main(argv=None):\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--output-dir',required=True)\n    parser.add_argument('--execution-inventory',required=True)\n    args=parser.parse_args(argv)\n    if Path(args.output_dir).resolve()!=ROOT/'data/accounting-master/deliverables/P04':\n        parser.error('use the declared P04 output directory')\n    if args.execution_inventory!=INVENTORY:\n        parser.error('use the supplied supervisor phase-entry inventory')\n    os.environ['CUDA_VISIBLE_DEVICES']='-1'\n    started=time.monotonic();utc=datetime.now(timezone.utc).isoformat()\n    protected=capture_protection(ROOT,INVENTORY,INVENTORY,writable=SOURCES+OUTPUTS,\n                                 required_paths=('docs/design/fixtures/borrowings.json','docs/design/fixtures/northstar.json','scripts/core0_ir_v1.py'))\n    approved=json.loads((ROOT/PLAN).read_text())\n    if approved['review']['verdict']!='AGREE' or approved['review']['issues']:\n        raise ValueError('no issue-free approved plan')\n    if protected['errors'] or protected['changed_since_execution_entry'] or protected['missing_before_check']:\n        raise ValueError('protection failure before execution: '+str(protected['errors']+protected['changed_since_execution_entry']))\n    source_before={p:digest(ROOT/p) for p in SOURCES+[PLAN]}\n    sys.path.insert(0,str(ROOT/'tests'))\n    import test_accounting_p04 as p04\n    import test_accounting_p03 as p03\n    p04.OBSERVATIONS.clear();p03.OBSERVATIONS.clear()\n    reports={}\n    for name,module in [('P04',p04),('P03_regression',p03)]:\n        stream=io.StringIO();suite=unittest.defaultTestLoader.loadTestsFromModule(module)\n        result=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)\n        reports[name]={'methods':result.testsRun,'failures':len(result.failures),'errors':len(result.errors),\n                       'skips':len(result.skipped),'passed':result.wasSuccessful() and result.testsRun>0 and not result.skipped,'output':stream.getvalue()}\n    catalog=json.loads((ROOT/SOURCES[-1]).read_text())\n    required=Counter(x['id'] for x in catalog['obligations']);observed=Counter(x['obligation'] for x in p04.OBSERVATIONS)\n    status={'required':len(required),'observed':len(observed),'missing':sorted(required.keys()-observed.keys()),\n            'uncatalogued':sorted(observed.keys()-required.keys()),\n            'duplicate_ids':sorted(k for k in required.keys()|observed.keys() if required[k]>1 or observed[k]>1),\n            'failed_observations':[x['obligation'] for x in p04.OBSERVATIONS if x.get('passed') is not True]}\n    finish_protection(ROOT,protected)\n    source_after={p:digest(ROOT/p) for p in source_before}\n    stable=all(h is not None and source_after[p]==h for p,h in source_before.items())\n    passed=all(r['passed'] for r in reports.values()) and protected['passed'] and stable and bool(required) and not any(status[k] for k in ('missing','uncatalogued','duplicate_ids','failed_observations'))\n    command=shlex.join(['python3','-B','scripts/check_accounting_p04.py']+(sys.argv[1:] if argv is None else argv))\n    payload={'schema_version':'accdsl.p04.conformance.v1','passed':bool(passed),'obligation_status':status,\n        'tests':reports,'observations':p04.OBSERVATIONS,'protection':protected,'code_stable_during_check':stable,\n        'input_source_test_hashes':dict(protected['before'],**source_before),\n        'manifest':{'git_commit':'unavailable: existing marker is not a usable repository','command':command,\n            'working_directory':str(ROOT),'executable':sys.executable,'environment':{'python':platform.python_version(),'z3':z3.get_version_string()},\n            'hardware':'CPU only; CUDA_VISIBLE_DEVICES=-1; no accelerator framework imported','random_seeds':'N/A: exact deterministic fixtures',\n            'data_version':'p04-reconstruction-cases-v1 plus preserved borrowing/Northstar fixtures','started_utc':utc,\n            'wall_seconds':round(time.monotonic()-started,6),'plan':PLAN,'plan_sha256':source_before[PLAN],\n            'execution_inventory':INVENTORY,'changed_source_code_test_files':SOURCES,'changed_files':SOURCES+OUTPUTS,\n            'outputs':OUTPUTS[:2],'result':OUTPUTS[1]},\n        'requirement_coverage':{'MC08':'shared symbols, choices, views and joint queries','MC09':'declared posting templates and bounded coverage',\n            'MC10':'six structural admission categories with provenance; external eligibility not independently certified',\n            'MC11':'unhedged additive bullet-debt grouping with retained memory','MC12':'explicit finite joint weights and retained mass',\n            'MC18':'strict bounds and unfinished cells','MC26':'exact rational linear and bounded integer numerical operations'},\n        'unsupported':catalog['unsupported'],\n        'acceptance':{'engineering':bool(passed),'accounting_validity':'not established','forecast_validity':'not established','human_acceptance':'pending','whole_gap_closure':False}}\n    decision='PASS' if passed else 'FAIL'\n    text=f'''# P04 bounded reconstruction result\n\n{decision}: {reports['P04']['methods']} P04 tests cover {status['observed']}/{status['required']} catalogued obligations; {reports['P03_regression']['methods']} P03 regression tests executed. Full executed outcomes, formulas, cell assignments, witnesses, conflicts, source hashes and proof queries are in conformance.json.\n\nDeclared templates construct account and economic-state roll-forwards. Independent Fraction enumeration checks three finite input variants; a selected Northstar receivables bridge replays original events to create observations before reconstruction. P03 integration preserves alpha=1/2, isolates endpoint conditions, retains overlapping views and rejects incompatible joint extrema. Parent coverage remains one continuous cell without genuine choices.\n\nExact debt interest ranges from 5 to 7. The rounded fixture has infimum 199/40, attained, and supremum 1407/200, unattained. Original strict feasibility precedes closure optimisation. Half-even negative ties, posting minor units, integer gaps, source conflicts, unsupported arithmetic, zero budgets and injected Unknown responses are checked. Incomplete search retains domains, predicates, ordinals and formulas; explored bounds cannot be global certificates.\n\nRecovery repairs reject lossy rational-record coercion, malformed or unsupported domains, generated-name collisions, duplicate finite values and repeated contract identities. A bounded domain with 10^30 integer values stops after one completed cell and retains its exact unvisited cardinality. An independent integer predicate oracle checks disjoint coverage of overlapping guards. Changed principal and rate inputs, including reversed endpoint order, verify that P03 bounds come from generated inputs rather than fixed expected amounts.\n\"\"\"Independent input replay and exact algebra; P04 executed obligations.\"\"\"\nimport copy\nfrom dataclasses import replace\nfrom fractions import Fraction as F\nfrom itertools import product\nimport json\nfrom pathlib import Path\nimport sys\nimport unittest\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'scripts'))\nimport z3\nfrom rational_solver_v1 import *\nfrom reconstruction_v1 import *\nfrom test_accounting_p03 import bindings, BASE\nfrom core0_frontends_v1 import compile_source\nROOT=Path(__file__).resolve().parents[1]\nOBSERVATIONS=[]\nB=Budget(20,10000,500,500,20000,1000,1000000)\n\n\ndef spec():\n    return json.loads((ROOT/'docs/design/fixtures/p04-reconstruction-cases-v1.json').read_text())['input_fixture']\n\n\ndef observation(s,amount):\n    return {'id':'cash-note','context':copy.deepcopy(s['context']),'action':'Accept','source':['synthetic:cash-note'],\n            'mapping':'cash','domain':{'lower':str(amount),'upper':str(amount),'lower_closed':True,'upper_closed':True}}\n\n\nclass ReconstructionTests(unittest.TestCase):\n    def record(self,name,result):OBSERVATIONS.append({'obligation':name,'passed':True,'result':result})\n    def test_independent_enumeration(self):\n        evidence=[]\n        # Oracle replays original template incidence; no production expressions or Z3.\n        for opening,total,limit,coefficient in [(10,13,3,1),(4,8,4,1),(7,13,3,2)]:\n            s=spec();s['opening']={'Cash':str(opening),'Equity':str(-opening)}\n            s['templates']['sale']['postings']={'Cash':str(coefficient),'Equity':str(-coefficient)}\n            for row in s['slots']:row['integer_bounds']=[0,limit]\n            s['observations']=[observation(s,total)]\n            p=construct(s);r=solve(p,B)\n            actual={(int(F(c['witness']['a'])),int(F(c['witness']['b']))) for c in r['cells'] if c['feasibility']=='sat'}\n            expected=set()\n            for a,b in product(range(limit+1),repeat=2):\n                cash=F(opening)\n                for amount in (a,b):cash+=F(coefficient)*amount\n                if cash==total:expected.add((a,b))\n            self.assertEqual(actual,expected);self.assertEqual(r['status'],'ExactWithinScope')\n            for c in r['cells']:\n                if c['feasibility']=='sat':self.assertEqual(F(c['outputs']['cash'])+F(c['outputs']['equity']),0)\n            s['slots'].reverse();rr=solve(construct(s),B)\n            self.assertEqual({tuple(c['witness'][n] for n in ('a','b')) for c in rr['cells'] if c['feasibility']=='sat'},\n                             {tuple(c['witness'][n] for n in ('a','b')) for c in r['cells'] if c['feasibility']=='sat'})\n            evidence.append({'inputs':s,'oracle':sorted(expected),'actual':r})\n        self.record('enumeration',evidence)\n    def test_p03_parent_views(self):\n# Bounded reconstruction v1\n\nThis executable profile addresses MC08–MC12, MC18 and MC26. It constructs a joint\nfamily from declared templates, slots, openings, dated mappings and admitted\nobservations. It does not discover templates or infer arbitrary company histories.\n\n## Pre-execution research intent and evidence contract\n\nQuestion: do declared inputs generate the correct family within their finite\nscope? Mechanism: rational linear constraints with shared economic identifiers,\nexplicit finite choices and bounded integer domains. Expected failure modes are\nlost dependence, wrong strict endpoints, unexamined rounding and false completeness.\nComparators are an independent Fraction replay/enumerator over original fixtures\nand analytic continuous bounds. Exact feasible-set equality and endpoint proofs\nare pass criteria. Unsupported operations, unknown backend replies, unfinished\ncells or unresolved matching obligations veto exact certification. Corrupted\ninputs or protection failures veto acceptance and stop the checker. A numerical\nfailure triggers repair, not rejection of the research direction. Runtime is\nexplanatory only. No superiority, general accounting validity, forecast validity,\ncontinuous probabilistic inference or human acceptance follows from these checks.\nConformance JSON and result.md preserve results; progress.md is a reset checkpoint.\n\nSkeptical audit: the earlier ambiguity between named views and search choices is\nresolved explicitly below. Baselines use original inputs, not generated expected\nanswers. Fixture sizes and budgets are engineering choices. No stochastic ranking\nor production-default promotion is attempted. A successful command can still be\nmisleading if both construction and oracle share lowering; the oracle therefore\nreplays postings independently. The integration checks inspect the unnamed\ninterior, not only endpoint extrema.\n\n## Assumptions and defaults\n\n| Choice | Provenance/status | Justification | Failure mode / early diagnostic |\n| --- | --- | --- | --- |\n| Fraction arithmetic | Core contract, reviewed requirement | exact disclosed decimals | binary-float drift; reject floats |\n| Z3 rational linear solving | existing 4.16.0, implementation hypothesis | exact linear SAT and optimisation | shared backend error; independent enumeration and algebra |\n| finite templates/slots | explicit input, scope hypothesis | tractable reconstruction | omitted histories; preserve exclusions and obligations |\n| budgets | explicit caller input, convenience | bounded execution | premature stop; zero-work and one-cell tests |\n| rounding convention/stage | explicit input, no inferred default | preserve disclosure versus posting semantics | wrong ties; negative/parity fixtures |\n| finite probability measure | explicit joint atoms, hypothesis | dependence and exact Bayes update | overlap/double use; reject duplicate atoms/information |\n| grouping | explicit additive debt profile only | retain contract memory | different resets/maturities/horizon; revalidation tests |\n| deterministic fixtures | engineering comparator | exhaustive small checks | not representative; no empirical forecast claim |\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '178,239p' scripts/reconstruction_v1.py\nsed -n '1,80p' scripts/rational_solver_v1.py\nsed -n '276,326p' tests/test_accounting_p04.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '178,239p' scripts/reconstruction_v1.py\nsed -n '1,80p' scripts/rational_solver_v1.py\nsed -n '276,326p' tests/test_accounting_p04.py\"","aggregated_output":"def from_p03(ir, bindings, template_bindings):\n    from core0_ir_v1 import validate_ir\n    valid = validate_ir(ir, bindings)\n    if not valid.valid:\n        raise ValueError('P03 IR failed validation: ' + str(valid.diagnostics))\n    if set(template_bindings) != {'DemoDebt@1/DebtMix'} or template_bindings['DemoDebt@1/DebtMix'] != 'fixed-floating-amounts-v1':\n        raise ValueError('explicit supported template binding required')\n    family = ir['historyFamilies'][0]; scope = ir['modelScopes'][0]\n    p = Problem(scope['id'], family['evidence_view'], exclusions=scope['exclusions'], obligations=scope['obligations'])\n    p.provenance = {'p03_ir_sha256': hashlib.sha256(json.dumps(ir,sort_keys=True).encode()).hexdigest(),\n                    'template_bindings': dict(template_bindings), 'observation_ids': [x['id'] for x in ir['observations']],\n                    'source_refs': ir['contracts'][0]['source_refs']}\n    for row in ir['symbols']:\n        v = z3.Real(row['id']); p.variables[row['id']] = v\n        p.add('domain:'+row['id'],domain_formula(v,row['domain']))\n    observations = {r['id']: r for r in ir['observations']}\n    exprs = {r['id']:r for r in ir['expressions']}\n    def lower(name):\n        row=exprs[name]; op=row['op']\n        if op=='literal':\n            if row['type']=='Bool': return z3.BoolVal(row['text']=='true')\n            return q(row['rational'])\n        if op=='ref':\n            if row['target'] in p.variables:return p.variables[row['target']]\n            return lower(row['target'])\n        if op=='value':\n            target=exprs[row['args'][0]]['target'] if row['args'] else row['target']\n            return q(observations[target]['domain']['lower'])\n        if op=='call' and row['target']=='builtin:value@1':\n            return q(observations[exprs[row['args'][0]]['target']]['domain']['lower'])\n        args=[lower(a) for a in row['args']]\n        if op=='call' and row['target']=='builtin:constant@1':return args[0]\n        if op in ('constant','neg','not'):\n            return args[0] if op=='constant' else -args[0] if op=='neg' else z3.Not(args[0])\n        operations={'add':lambda a,b:a+b,'sub':lambda a,b:a-b,'mul':lambda a,b:a*b,'div':lambda a,b:a/b,\n                    'eq':lambda a,b:a==b,'lt':lambda a,b:a<b,'le':lambda a,b:a<=b,\n                    'gt':lambda a,b:a>b,'ge':lambda a,b:a>=b,'and':lambda *a:z3.And(*a),'or':lambda *a:z3.Or(*a)}\n        if op not in operations:raise UnsupportedFragment('P03 operation: '+op)\n        return operations[op](*args)\n    try:\n        rows={r['id']:r for r in ir['constraints']}\n        for cid in family['constraints']: p.add(cid,lower(rows[cid]['expression']))\n        for view in ir['alternatives']:\n            if view['choice_group'] is not None:raise UnsupportedFragment('P03 choice group requires explicit partition')\n            p.views[view['id']]=z3.And(*[lower(rows[c]['expression']) for c in view['constraints']])\n        fields={f['name']:lower(f['expression']) for f in ir['contracts'][0]['fields']}\n        from rational_solver_v1 import fraction\n        principal=fraction(fields['principal'])\n        if principal<=0:raise UnsupportedFragment('amount/fraction adapter requires positive exact principal')\n        fixed=z3.Real('amount:fixed'); floating=z3.Real('amount:floating')\n        p.variables.update({'amount:fixed':fixed,'amount:floating':floating})\n        p.add('template:principal', fixed+floating==q(principal))\n        p.add('template:fixed', fixed==q(principal)*fields['fixed_fraction'])\n        p.add('template:amounts',z3.And(fixed>=0,floating>=0))\n        rate=lower(ir['scenarios'][0]['drivers'][0]['expression'])\n        p.outputs={'interest':fields['fixed_rate']*fixed+rate*floating,\n                   'fixed':fixed,'floating':floating,'principal':fixed+floating}\n        p.slots=1\n    except UnsupportedFragment as exc:p.unsupported.append(str(exc))\n    return p\n\n\n\"\"\"Exact, bounded rational-linear cells; no implicit integer relaxation.\"\"\"\nfrom dataclasses import dataclass, field\nfrom fractions import Fraction as F\nfrom itertools import product\nimport math\nimport time\nimport z3\n\n\nclass UnsupportedFragment(ValueError):\n    pass\n\n\ndef rational(value):\n    if isinstance(value, bool) or isinstance(value, float):\n        raise ValueError('exact rational required; booleans/floats are not amounts')\n    if isinstance(value, dict):\n        if set(value) != {'n', 'd'}:\n            raise ValueError('rational record requires exactly n and d')\n        parts = [rational(value[k]) for k in ('n', 'd')]\n        if any(x.denominator != 1 for x in parts) or parts[1] == 0:\n            raise ValueError('rational numerator/denominator must be integers with nonzero denominator')\n        return F(parts[0].numerator, parts[1].numerator)\n    return F(value)\n\n\ndef q(value):\n    x = rational(value)\n    return z3.RealVal(f'{x.numerator}/{x.denominator}')\n\n\ndef fraction(value):\n    value = z3.simplify(value)\n    if z3.is_int_value(value):\n        return F(value.as_long())\n    if z3.is_rational_value(value):\n        return F(value.numerator_as_long(), value.denominator_as_long())\n    raise UnsupportedFragment('non-rational solver value: ' + str(value))\n\n\n@dataclass(frozen=True)\nclass Budget:\n    max_slots: int\n    max_formula_nodes: int\n    max_integer_assignments: int\n    max_cells: int\n    elapsed_ms: int\n    solver_timeout_ms: int\n    solver_rlimit: int\n\n    def __post_init__(self):\n        for v in self.__dict__.values():\n            if type(v) is not int or v < 0:\n                raise ValueError('budgets must be explicit nonnegative integers')\n\n\n@dataclass\nclass Problem:\n    scope: str\n    evidence_view: str\n    variables: dict = field(default_factory=dict)\n    finite: dict = field(default_factory=dict)\n    constraints: list = field(default_factory=list)  # (source/assumption label, BoolRef)\n    views: dict = field(default_factory=dict)\n    outputs: dict = field(default_factory=dict)\n    obligations: list = field(default_factory=list)\n    exclusions: list = field(default_factory=list)\n    provenance: dict = field(default_factory=dict)\n    slots: int = 0\n    unsupported: list = field(default_factory=list)\n    rounding_stage: str = 'exact_rational'\n\n    def add(self, label, condition):\n        if any(label == x[0] for x in self.constraints):\n            raise ValueError('duplicate constraint identity: ' + label)\n        if not z3.is_bool(condition):\n            raise ValueError('constraint must be Boolean')\n        self.constraints.append((label, condition))\n\n\n    def test_large_integer_domain_and_partition_oracle(self):\n        k=z3.Int('large-k');size=10**30\n        p=Problem('large bounded integer','test',variables={'k':k},finite={'k':range(size)})\n        r=solve(p,replace(B,max_cells=1,max_integer_assignments=1),k)\n        self.assertEqual(r['status'],'PartialSearch');self.assertEqual(r['coverage']['total'],size)\n        self.assertEqual(r['coverage']['completed'],1)\n        self.assertEqual(r['coverage']['unvisited']['stop_ordinal'],size)\n        self.assertFalse(r['bounds']['upper']['certified'])\n        self.assertEqual(list(lazy_product([range(2),range(3)])),list(product(range(2),range(3))))\n        p=Problem('overlapping guards','test',variables={'k':k},finite={'k':range(-2,5)})\n        p.add('overlap',z3.Or(k<=1,k>=0));p.add('hole',z3.Not(k==2))\n        r2=solve(p,B,k)\n        actual=[int(c['witness']['k']) for c in r2['cells'] if c['feasibility']=='sat']\n        expected=[n for n in range(-2,5) if (n<=1 or n>=0) and n!=2]\n        self.assertEqual(sorted(actual),expected);self.assertEqual(len(actual),len(set(actual)))\n        self.assertEqual(r2['status'],'ExactWithinScope');self.assertEqual(r2['coverage']['unresolved'],0)\n        self.record('large_domain_partition',{'large_domain':r,'independent_integer_oracle':expected,'partition':r2})\n\n    def test_p03_changed_principal_and_rates(self):\n        evidence=[]\n        for principal,fixed,stress in ((150,'0.04','0.09'),(80,'0.06','0.03')):\n            source=BASE.replace('100 USD',f'{principal} USD').replace('0.05 per year',fixed+' per year').replace('0.07 per year',stress+' per year')\n            bound=bindings(principal);compiled=compile_source(source,bound)\n            self.assertTrue(compiled.ok)\n            p=from_p03(compiled.ir,bound,{'DemoDebt@1/DebtMix':'fixed-floating-amounts-v1'})\n            result=solve(p,B,p.outputs['interest'])\n            endpoints=sorted([F(principal)*F(fixed),F(principal)*F(stress)])\n            self.assertEqual([F(result['bounds'][d]['value']) for d in ('lower','upper')],endpoints)\n            conditional=solve(p,B,p.outputs['interest'],selected_views=['allFixed'])\n            self.assertEqual([F(conditional['bounds'][d]['value']) for d in ('lower','upper')],[F(principal)*F(fixed)]*2)\n            middle=solve(p,B,extra=[p.variables['alpha']==q('1/2')])\n            self.assertEqual(middle['coverage']['total'],1)\n            self.assertEqual(F(middle['cells'][0]['outputs']['interest']),F(principal)*(F(fixed)+F(stress))/2)\n            evidence.append({'principal':principal,'rates':[fixed,stress],'oracle_endpoints':list(map(str,endpoints)),\n                             'parent':result,'fixed':conditional,'interior':middle})\n        self.record('p03_metamorphic_rates',evidence)\n","exit_code":0,"status":"completed"}}
