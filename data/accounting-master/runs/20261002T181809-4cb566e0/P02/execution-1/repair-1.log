{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' scripts/apple_case_v1.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Bounded, source-bound Apple case. No acquisition or forecasting at build time.\n\nMappings below are annotations; numbers are read from pinned source bytes.\nAll amounts used by the arithmetic engine are exact rational USD amounts.\nRevalidation rebuilds from sources, so editing an observation's metadata cannot\nchange its source meaning. This is a case adapter, not a general XBRL processor.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom datetime import date, datetime, timedelta, timezone\nfrom fractions import Fraction\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\n\nfrom bs4 import BeautifulSoup\n\nROOT = Path(__file__).resolve().parents[1]\nAPPLE = \"docs/design/cases/apple/\"\nNEW = APPLE + \"p02-v1/\"\nREGISTER = \"data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json\"\nINDEX = \"data/financial-report-benchmark/landing/apple/21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42.json\"\nPLAN_HASH = \"916a4c80553bebee3ca0b6399ba8d4e54a6f5d3bd2975cda75815b95e8f45f59\"\nPINS = {\n    APPLE + \"annual-2024.pdf\": \"ec74758cd767465362c641cf2fd5d8fedd477aed2bf7f62117e67610435dcb88\",\n    APPLE + \"annual-2024.txt\": \"caaf182340d3846ff54cf967a2d3da7dce82505170665943ea7227e6bed8336e\",\n    APPLE + \"interim-2025q1.html\": \"2f7629f0733f75b3155dd52f7ae6a8724468e3cde1a9ce32fbce96d98f1ec27e\",\n    APPLE + \"interim-2025q1.txt\": \"ab8e06fc35957f43a355d0d1d11d57d203b494a4008edb39cff162e984ef633b\",\n    APPLE + \"manifest.json\": \"f25b63803d8a7e136befa10d68b935f521aa42ffc95663b6c26d792b0e4e5fc7\",\n    INDEX: \"21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42\",\n}\nMILLION = 10**6\nENTITY = \"0000320193\"\nPRODUCTS = [\"iPhone\", \"Mac\", \"iPad\", \"Wearables, Home and Accessories\", \"Services\"]\nSEGMENTS = [\"Americas\", \"Europe\", \"Greater China\", \"Japan\", \"Rest of Asia Pacific\"]\nPRODUCT_MEMBERS = [\"aapl:IPhoneMember\", \"aapl:MacMember\", \"aapl:IPadMember\",\n                   \"aapl:WearablesHomeandAccessoriesMember\", \"us-gaap:ServiceMember\"]\nSEGMENT_MEMBERS = [\"aapl:\" + n.replace(\" \", \"\") + \"SegmentMember\" for n in SEGMENTS]\nREV = \"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"\nCF_BAL = \"us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents\"\n\n\nclass CaseError(ValueError):\n    \"\"\"A source or interpretation fails the supported case contract.\"\"\"\n\n\ndef require(condition, message):\n    if not condition:\n        raise CaseError(message)\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef file_hash(path):\n    return sha((ROOT / path).read_bytes())\n\n\ndef power10(n):\n    return Fraction(10)**n\n\n\ndef number(literal):\n    s = re.sub(r\"[\\s,$]\", \"\", literal)\n    if s in (\"—\", \"–\"):\n        return Fraction(0)\n    require(bool(re.fullmatch(r\"(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\", s)) or\n            bool(re.fullmatch(r\"\\(\\d+(?:\\.\\d+)?\\)\", s)), \"unsupported numeric literal: \" + literal)\n    return -Fraction(s[1:-1]) if s.startswith(\"(\") else Fraction(s)\n\n\ndef interval(value, quantum):\n    v, q = Fraction(value), Fraction(quantum)\n    require(q > 0, \"precision must be positive\")\n    return [str(v-q/2), str(v+q/2)]\n\n\ndef interval_sum(observations, coefficients=None):\n    coefs = coefficients or [1]*len(observations)\n    require(len(coefs) == len(observations), \"coefficient count\")\n    lo = hi = Fraction(0)\n    for obs, c in zip(observations, coefs):\n        a, b = map(Fraction, obs[\"rounding_interval_usd\"])\n        lo += min(c*a, c*b)\n        hi += max(c*a, c*b)\n    return lo, hi\n\n\ndef compatible(left, right):\n    return max(Fraction(left[0]), Fraction(right[0])) <= min(Fraction(left[1]), Fraction(right[1]))\n\n\nclass Document:\n    def __init__(self, identity, original, extraction, pdf=False):\n        self.identity, self.original, self.extraction, self.pdf = identity, original, extraction, pdf\n        self.original_hash, self.extraction_hash = file_hash(original), file_hash(extraction)\n        self.text = (ROOT/extraction).read_text()\n\n    def anchor(self, start, end):\n        require(0 <= start < end <= len(self.text), \"anchor range\")\n        out = dict(document=self.identity, original_path=self.original,\n                   original_sha256=self.original_hash, extraction_path=self.extraction,\n                   extraction_sha256=self.extraction_hash, offset_unit=\"Unicode code points\",\n                   start=start, end=end, quote=self.text[start:end])\n        if self.pdf:\n            page_start = self.text.rfind(\"\\f\", 0, start)+1\n            page_end = self.text.find(\"\\f\", start)\n            page = self.text[page_start:page_end if page_end >= 0 else len(self.text)]\n            m = re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| (\\d+)\", page)\n            out.update(pdf_page=self.text.count(\"\\f\", 0, start)+1,\n                       printed_page=int(m[1]) if m else None,\n                       ending_pdf_page=self.text.count(\"\\f\", 0, end-1)+1)\n        return out\n\n    def find(self, pattern, bounds=None, flags=0):\n        start, end = bounds or (0, len(self.text))\n        matches = list(re.finditer(pattern, self.text[start:end], flags))\n        require(len(matches) == 1, f\"{self.identity}: expected unique span {pattern!r}, got {len(matches)}\")\n        m = matches[0]\n        return self.anchor(start+m.start(), start+m.end())\n\n    def page(self, printed):\n        offset = 0\n        for page in self.text.split(\"\\f\"):\n            if re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| \" + str(printed) + r\"\\s*$\", page):\n                return offset, offset+len(page)\n            offset += len(page)+1\n        raise CaseError(\"printed page missing\")\n\n    def binding(self):\n        return dict(id=self.identity, original_path=self.original, original_sha256=self.original_hash,\n                    extraction_path=self.extraction, extraction_sha256=self.extraction_hash)\n\n\ndef discover_notes(doc, expected):\n    matches = list(re.finditer(r\"(?m)^[\\f \\t]*Note (\\d+)\\s*[–-]\\s*([^\\n]+)\", doc.text))\n    require([int(m[1]) for m in matches] == list(range(1, expected+1)), \"missing, duplicate or reordered notes\")\n    marker = \"Report of Independent Registered\" if doc.pdf else \"Item 2.\"\n    out = []\n    for i, m in enumerate(matches):\n        end = matches[i+1].start() if i+1 < len(matches) else doc.text.find(marker, m.end())\n        require(end > m.end(), \"final note boundary missing\")\n        out.append(dict(id=f\"{doc.identity}.note.{m[1]}\", number=int(m[1]), title=m[2].strip(),\n                        anchor=doc.anchor(m.start(), end), heading=doc.anchor(m.start(), m.end())))\n    return out\n\n\ndef context(period, dimensions=None):\n    return dict(entity=ENTITY, entity_scheme=\"http://www.sec.gov/CIK\", perimeter=\"consolidated\",\n                basis=\"US GAAP\", currency=\"USD\", period=period, dimensions=dimensions or {})\n\n\ndef observation(oid, concept, value, literal, scale, quantum, ctx, measurement, anchors, **extra):\n    out = dict(id=oid, concept=concept, displayed_literal=literal, scale=scale,\n               value_usd=str(value), presentation_quantum_usd=str(quantum), context=ctx,\n               measurement=measurement, rounding_interval_usd=interval(value, quantum),\n               source_readings=anchors, status=\"extracted_reading\", **extra)\n    return out\n\n\ndef annual_row(doc, label, column, ctx, concept, measurement, bounds, columns,\n               header, oid, partition=None):\n    # A row is selected by its label within a scoped table, never by its value.\n    a = doc.find(r\"^[ \\t]*\" + re.escape(label) + r\"[ \\t]{2,}[^\\n]+\", bounds, re.M)\n    line = a[\"quote\"]\n    begin = line.index(label)+len(label)\n    tokens = list(re.finditer(r\"\\(?[\\d,]+(?:\\.\\d+)?\\)?|—\", line[begin:]))\n    require(len(tokens) == columns, f\"{label}: ambiguous table columns\")\n    token = tokens[column]\n    start = a[\"start\"]+begin+token.start()\n    literal = token[0]\n    return observation(oid, concept, number(literal)*MILLION, literal, 6, MILLION,\n                       ctx, measurement, [dict(row=a, cell=doc.anchor(start, start+len(literal)),\n                                               table_header=header, column_index=column)], partition=partition)\n\n\nclass InlineReader:\n    \"\"\"Strict subset of inline-XBRL used in this case, retaining raw ID anchors.\"\"\"\n    def __init__(self, doc):\n        self.doc = doc\n        self.raw = (ROOT/doc.original).read_text()\n        self.soup = BeautifulSoup(self.raw, \"html.parser\")\n        self.ids = {}\n        for el in self.soup.find_all(id=True):\n            require(el[\"id\"] not in self.ids, \"duplicate HTML/XBRL id\")\n            self.ids[el[\"id\"]] = el\n        self.facts = self.soup.find_all(\"ix:nonfraction\")\n\n    def raw_anchor(self, el):\n        # Exact original bytes (ASCII-compatible UTF-8 text offsets), not soup serialization.\n        pattern = r\"<\" + re.escape(el.name) + r\"\\b[^>]*\\bid=[\\\"']\" + re.escape(el[\"id\"]) + r\"[\\\"'][^>]*>.*?</\" + re.escape(el.name) + r\">\"\n        matches = list(re.finditer(pattern, self.raw, re.S | re.I))\n        require(len(matches) == 1, \"raw ID anchor missing/ambiguous\")\n        m = matches[0]\n        return dict(path=self.doc.original, sha256=self.doc.original_hash,\n                    start=m.start(), end=m.end(), quote=m[0], offset_unit=\"Unicode code points\", id=el[\"id\"])\n\n    def resolve(self, ref, tag):\n        require(ref in self.ids and self.ids[ref].name == tag, f\"broken {tag} reference {ref}\")\n        return self.ids[ref]\n\n    def parse_context(self, el):\n        identifier = el.find_all(\"xbrli:identifier\")\n        require(len(identifier) == 1, \"ambiguous entity\")\n        require(identifier[0].get(\"scheme\") == \"http://www.sec.gov/CIK\", \"unsupported entity scheme\")\n        period = el.find(\"xbrli:period\")\n        require(period is not None, \"missing period\")\n        tags = [n for n in period.children if getattr(n, \"name\", None)]\n        names = [n.name for n in tags]\n        require(names in [[\"xbrli:instant\"], [\"xbrli:startdate\", \"xbrli:enddate\"]], \"unsupported period\")\n        dates = [date.fromisoformat(n.get_text()).isoformat() for n in tags]\n        require(len(dates) == 1 or dates[0] <= dates[1], \"reversed period\")\n        p = dict(instant=dates[0]) if len(dates) == 1 else dict(start=dates[0], end=dates[1])\n        require(not el.find(\"xbrldi:typedmember\") and not el.find(\"xbrli:scenario\"), \"unsupported context content\")\n        dims = {}\n        for d in el.find_all(\"xbrldi:explicitmember\"):\n            require(d.get(\"dimension\") and d[\"dimension\"] not in dims, \"duplicate/missing dimension\")\n            dims[d[\"dimension\"]] = d.get_text()\n        out = context(p, dims)\n        out[\"entity\"] = identifier[0].get_text()\n        return out\n\n    def parse(self, fact):\n        cid, uid = fact.get(\"contextref\"), fact.get(\"unitref\")\n        c, u = self.resolve(cid, \"xbrli:context\"), self.resolve(uid, \"xbrli:unit\")\n        ctx = self.parse_context(c)\n        measures = u.find_all(\"xbrli:measure\")\n        require(len(measures) == 1 and measures[0].get_text() == \"iso4217:USD\" and\n                not u.find(\"xbrli:divide\"), \"unsupported currency/unit\")\n        require(fact.get(\"sign\") in [None, \"-\"], \"unsupported sign\")\n        require(not fact.get(\"xsi:nil\") and not fact.get(\"continuedat\"), \"nil/continued numeric unsupported\")\n        require(re.fullmatch(r\"-?\\d+\", fact.get(\"scale\", \"0\")) is not None, \"invalid scale\")\n        require(re.fullmatch(r\"-?\\d+\", fact.get(\"decimals\", \"\")) is not None, \"unsupported precision\")\n        scale, decimals = int(fact.get(\"scale\", \"0\")), int(fact[\"decimals\"])\n        require(-12 <= scale <= 12 and -12 <= decimals <= 12, \"unbounded scale/precision\")\n        fmt, lit = fact.get(\"format\"), fact.get_text(strip=True)\n        if fmt == \"ixt:fixed-zero\":\n            require(lit in (\"—\", \"–\", \"0\"), \"invalid zero transform\")\n            v = Fraction(0)\n        elif fmt == \"ixt:num-dot-decimal\":\n            require(re.fullmatch(r\"(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\", lit) is not None, \"invalid decimal transform\")\n            v = number(lit)\n        elif fmt is None:\n            require(re.fullmatch(r\"\\d+(?:\\.\\d+)?\", lit) is not None, \"unformatted nonnumeric fact\")\n            v = Fraction(lit)\n        else:\n            raise CaseError(\"unsupported inline transform \" + fmt)\n        v *= power10(scale) * (-1 if fact.get(\"sign\") == \"-\" else 1)\n        row = fact.find_parent(\"tr\")\n        # Selected monetary rows must agree with the visual sign, unless narrative.\n        cell = fact.find_parent(\"td\")\n        if cell:\n            visible = cell.get_text(\"\", strip=True)\n            require((\"(\" in visible and \")\" in visible) == (v < 0), \"rendered/tagged sign mismatch\")\n        rowtext = row.get_text(\" \", strip=True) if row else fact.parent.get_text(\" \", strip=True)\n        return dict(value=v, literal=lit, scale=scale, quantum=power10(-decimals), context=ctx,\n                    raw=dict(fact=self.raw_anchor(fact), context=self.raw_anchor(c), unit=self.raw_anchor(u),\n                             fact_id=fact[\"id\"], context_id=cid, unit_id=uid, decimals=decimals,\n                             sign=fact.get(\"sign\"), transform=fmt, rendered_text=rowtext))\n\n    def select(self, concept, ctx, measurement, oid, scale=6, decimals=-6, partition=None,\n               label=None):\n        candidates = []\n        for f in self.facts:\n            if f.get(\"name\") != concept:\n                continue\n            c = self.resolve(f.get(\"contextref\"), \"xbrli:context\")\n            parsed_ctx = self.parse_context(c)\n            if parsed_ctx == ctx:\n                candidates.append(self.parse(f))\n        require(candidates, f\"missing required fact/context {concept} {ctx}\")\n        first = candidates[0]\n        for c in candidates:\n            require(c[\"value\"] == first[\"value\"] and c[\"quantum\"] == first[\"quantum\"], \"conflicting repeated readings\")\n            require(c[\"scale\"] == scale and c[\"raw\"][\"decimals\"] == decimals, \"wrong presentation scale/precision\")\n        if label:\n            require(any(label in c[\"raw\"][\"rendered_text\"] for c in candidates), \"rendered label not found\")\n        return observation(oid, concept, first[\"value\"], first[\"literal\"], scale, first[\"quantum\"],\n                           ctx, measurement, [c[\"raw\"] for c in candidates], partition=partition)\n\n\ndef same_context(obs, ignore=()):\n    require(obs, \"no operands\")\n    base = {k: v for k, v in obs[0][\"context\"].items() if k not in ignore}\n    require(all({k: v for k, v in x[\"context\"].items() if k not in ignore} == base for x in obs),\n            \"entity/currency/perimeter/basis/period/dimensions mismatch\")\n    require(base.get(\"entity\") == ENTITY and base.get(\"perimeter\") == \"consolidated\" and\n            base.get(\"currency\") == \"USD\" and base.get(\"basis\") == \"US GAAP\", \"unsupported case context\")\n\n\ndef reconcile(bridge_id, kind, operands, target, partition=None):\n    all_obs = operands+[target]\n    transformations = []\n    if kind == \"cash_flow\":\n        require(len(operands) == 4, \"cash flow operands\")\n        opening, *flows = operands\n        require(opening[\"measurement\"] == target[\"measurement\"] == \"cash_including_restricted\", \"cash perimeter mismatch\")\n        require(all(o[\"measurement\"] == \"cash_flow\" for o in flows), \"cash movement type\")\n        same_context(all_obs, (\"period\",))\n        per = flows[0][\"context\"][\"period\"]\n        require(all(x[\"context\"][\"period\"] == per for x in flows), \"flow period mismatch\")\n        require(opening[\"context\"][\"period\"] == {\"instant\": (date.fromisoformat(per[\"start\"])-timedelta(days=1)).isoformat()} and\n                target[\"context\"][\"period\"] == {\"instant\": per[\"end\"]}, \"stock/flow date mismatch\")\n        transformations.append(\"Opening instant is the day before the disclosed flow period; closing instant is its end. Cash includes restricted cash on both sides.\")\n    elif kind == \"partition\":\n        same_context(all_obs, (\"dimensions\",))\n        require(partition in (\"product\", \"segment\"), \"unknown partition\")\n        expected = PRODUCTS if partition == \"product\" else SEGMENTS\n        require([o.get(\"partition\") for o in operands] == [partition]*len(expected), \"overlapping or wrong partitions\")\n        require([o.get(\"member_label\") for o in operands] == expected, \"duplicate/missing partition member\")\n        require(all(o[\"measurement\"] == \"net_revenue\" for o in all_obs) and not target[\"context\"][\"dimensions\"], \"revenue target\")\n        require(len({json.dumps(o[\"context\"][\"dimensions\"], sort_keys=True) for o in operands}) == len(expected), \"duplicate dimension members\")\n        transformations.append(\"Sum one disclosed exhaustive table partition; product and geography are separate classifications of the same revenue.\")\n    else:\n        same_context(all_obs)\n","exit_code":0,"status":"completed"}}
