{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc 'wc -l scripts/apple_case_v1.py; tail -n 200 scripts/apple_case_v1.py'","aggregated_output":"548 scripts/apple_case_v1.py\ndef html_text(raw):\n    soup = BeautifulSoup(raw, \"html.parser\")\n    for el in soup([\"script\", \"style\"]):\n        el.decompose()\n    return soup.get_text(\"\\n\", strip=True)\n\n\ndef load_sources():\n    for p, h in PINS.items():\n        require(file_hash(p) == h, \"source hash mismatch: \" + p)\n    annual = Document(\"annual\", APPLE+\"annual-2024.pdf\", APPLE+\"annual-2024.txt\", pdf=True)\n    interim = Document(\"interim\", APPLE+\"interim-2025q1.html\", APPLE+\"interim-2025q1.txt\")\n    extracted = subprocess.run([\"pdftotext\", \"-layout\", str(ROOT/annual.original), \"-\"],\n                               capture_output=True, check=True, timeout=30).stdout\n    require(sha(extracted) == annual.extraction_hash, \"PDF extraction does not reproduce retained text\")\n    require(html_text((ROOT/interim.original).read_text()) == interim.text, \"HTML extraction mismatch\")\n    register = json.loads((ROOT/REGISTER).read_text())\n    bindings = []\n    for d, name in [(annual, \"apple-2024-annual\"), (interim, \"apple-2025-q1\")]:\n        candidates = [r for r in register[\"records\"] if r[\"document_id\"] == name]\n        require(len(candidates) == 1, \"P01 source identity\")\n        r = candidates[0]\n        require(r[\"original_sha256\"] == d.original_hash == file_hash(r[\"original_path\"]), \"P01 original binding\")\n        require(r[\"extracted_sha256\"] == file_hash(r[\"extracted_path\"]), \"P01 extraction binding\")\n        bindings.append(dict(**d.binding(), p01_document=name, p01_original_path=r[\"original_path\"],\n                             p01_extraction_path=r[\"extracted_path\"], p01_extraction_sha256=r[\"extracted_sha256\"],\n                             extraction_relation=\"identical\" if r[\"extracted_sha256\"] == d.extraction_hash else\n                             \"distinct text versions; offsets must not transfer\",\n                             p01_publication_metadata=r[\"publication_metadata\"]))\n    acquisitions = json.loads((ROOT/NEW/\"acquisition.json\").read_text())\n    external_docs = {}\n    for rec in acquisitions[\"records\"]:\n        if \"path\" not in rec:\n            continue\n        require(file_hash(rec[\"path\"]) == rec[\"sha256\"], \"acquired bytes changed\")\n        if rec[\"path\"].endswith(\".html\"):\n            p = Path(rec[\"path\"])\n            extracted_path = str(p.with_suffix(\".txt\"))\n            require((ROOT/extracted_path).exists(), \"missing acquired text\")\n            require(html_text((ROOT/p).read_text()) == (ROOT/extracted_path).read_text(), \"external extraction mismatch\")\n            d = Document(p.stem, str(p), extracted_path)\n            external_docs[p.stem] = d\n            bindings.append(dict(**d.binding(), acquisition=rec,\n                                 historical_byte_vintage=\"not established by current retrieval\"))\n    return annual, interim, external_docs, bindings, acquisitions\n\n\ndef collect_observations(annual, interim):\n    observations, bridges = [], []\n    def put(o):\n        require(o[\"id\"] not in {x[\"id\"] for x in observations}, \"duplicate observation id\")\n        observations.append(o)\n        return o\n    def bridge(name, kind, operands, target, **kw):\n        bridges.append(reconcile(name, kind, operands, target, **kw))\n    def scope(page, start=None, end=None):\n        lo, hi = annual.page(page)\n        if start:\n            lo = annual.find(re.escape(start), (lo, hi))[\"start\"]\n        if end:\n            stop = annual.text.find(end, lo, hi)\n            require(stop >= 0, \"scope terminator missing\")\n            hi = stop\n        return lo, hi\n    def arow(label, col, ctx, concept, measure, bounds, cols, oid, partition=None):\n        # Include the table's actual date headings and declared presentation scale.\n        yr = annual.find(r\"^[ \\t]*2024[ \\t]+2023(?:[ \\t]+2022)?[ \\t]*$\", bounds, re.M)\n        header = annual.anchor(bounds[0], yr[\"end\"])\n        return put(annual_row(annual, label, col, ctx, concept, measure, bounds, cols, header, oid, partition))\n    a_bs = {}\n    for col, day in enumerate([\"2024-09-28\", \"2023-09-30\"]):\n        ctx = context(dict(instant=day))\n        rows = {}\n        for key, label, concept in [\n            (\"assets\", \"Total assets\", \"us-gaap:Assets\"),\n            (\"liabilities\", \"Total liabilities\", \"us-gaap:Liabilities\"),\n            (\"equity\", \"Total shareholders’ equity\", \"us-gaap:StockholdersEquity\"),\n            (\"cash\", \"Cash and cash equivalents\", \"us-gaap:CashAndCashEquivalentsAtCarryingValue\"),\n            (\"ppe\", \"Property, plant and equipment, net\", \"us-gaap:PropertyPlantAndEquipmentNet\")]:\n            measure = \"cash_excluding_restricted\" if key == \"cash\" else \"carrying_amount\"\n            rows[key] = arow(label, col, ctx, concept, measure, scope(31), 2, f\"annual.bs.{day}.{key}\")\n        for key, start, end, concept in [\n            (\"debt_current\", \"Current liabilities:\", \"Non-current liabilities:\", \"us-gaap:LongTermDebtCurrent\"),\n            (\"debt_noncurrent\", \"Non-current liabilities:\", \"Commitments and contingencies\", \"us-gaap:LongTermDebtNoncurrent\")]:\n            bounds = scope(31, start, end)\n            header = annual.anchor(annual.page(31)[0], annual.page(31)[0]+450)\n            rows[key] = put(annual_row(annual, \"Term debt\", col, ctx, concept, \"carrying_amount\", bounds, 2,\n                                      header, f\"annual.bs.{day}.{key}\"))\n        bridge(f\"annual.balance.{day}\", \"balance\", [rows[\"liabilities\"], rows[\"equity\"]], rows[\"assets\"])\n        a_bs[day] = rows\n        debt_bounds = scope(43, \"Term Debt\", \"To manage interest rate risk\")\n        d = {}\n        for key, label, measurement in [\n            (\"principal\", \"Total term debt principal\", \"principal\"),\n            (\"discount\", \"Unamortized premium/(discount) and issuance costs, net\", \"carrying_adjustment\"),\n            (\"hedge\", \"Hedge accounting fair value adjustments\", \"carrying_adjustment\"),\n            (\"carrying\", \"Total term debt\", \"carrying_amount\")]:\n            d[key] = arow(label, col, ctx, \"apple:Debt\"+key.title(), measurement, debt_bounds, 2,\n                          f\"annual.debt.{day}.{key}\")\n        bridge(f\"annual.principal_to_carrying.{day}\", \"principal_to_carrying\", [d[k] for k in [\"principal\", \"discount\", \"hedge\"]], d[\"carrying\"])\n        bridge(f\"annual.debt_components.{day}\", \"debt_components\", [rows[\"debt_current\"], rows[\"debt_noncurrent\"]], d[\"carrying\"])\n        p = {}\n        for key, label, measure in [(\"gross\", \"Gross property, plant and equipment\", \"gross_cost\"),\n                                    (\"depreciation\", \"Accumulated depreciation\", \"accumulated_depreciation\"),\n                                    (\"net\", \"Total property, plant and equipment, net\", \"carrying_amount\")]:\n            p[key] = arow(label, col, ctx, \"apple:PPE\"+key.title(), measure,\n                          scope(39, \"Note 5\", \"Note 6\"), 2, f\"annual.ppe.{day}.{key}\")\n        bridge(f\"annual.ppe.{day}\", \"ppe\", [p[\"gross\"], p[\"depreciation\"]], p[\"net\"])\n        bridge(f\"annual.ppe_statement.{day}\", \"equality\", [p[\"net\"]], rows[\"ppe\"])\n    # Years and week lengths are read from the actual Note 1 calendar paragraph.\n    calendar = annual.find(r\"The Company’s fiscal year is the 52- or 53-week period.*?associated quarters, months and periods of those fiscal years\\.\",\n                           scope(34), re.S)\n    m = re.search(r\"years (\\d{4}) and (\\d{4}) spanned (\\d+) weeks each, whereas fiscal year (\\d{4}) spanned (\\d+) weeks\", calendar[\"quote\"])\n    require(m is not None, \"fiscal week lengths missing\")\n    weeks = {m[1]: int(m[3]), m[2]: int(m[3]), m[4]: int(m[5])}\n    # The dates are bound to the split-line date header on printed page 33.\n    for col, day in enumerate([\"2024-09-28\", \"2023-09-30\", \"2022-09-24\"]):\n        end = date.fromisoformat(day)\n        require(end.strftime(\"%B\")+\" \"+str(end.day)+\",\" in annual.text[slice(*annual.page(33))], \"annual end header missing\")\n        start = end+timedelta(days=1-weeks[str(end.year)]*7)\n        per = dict(start=start.isoformat(), end=day)\n        ctx = context(per)\n        rev = arow(\"Total net sales\", col, ctx, REV, \"net_revenue\", scope(29), 3, f\"annual.revenue.{end.year}\")\n        for partition, members in [(\"product\", PRODUCTS), (\"segment\", SEGMENTS)]:\n            parts = []\n            for i, member in enumerate(members):\n                dims = {\"srt:ProductOrServiceAxis\": PRODUCT_MEMBERS[i]} if partition == \"product\" else {\"us-gaap:StatementBusinessSegmentsAxis\": SEGMENT_MEMBERS[i]}\n                bounds = scope(35) if partition == \"product\" else scope(47, member+\":\", \"Operating income\")\n                label = \"Services (1)\" if member == \"Services\" else member\n                if partition == \"segment\":\n                    o = put(annual_row(annual, \"Net sales\", col, context(per, dims), REV, \"net_revenue\", bounds, 3,\n                                      annual.anchor(annual.page(47)[0], scope(47, \"Americas:\")[0]), f\"annual.{partition}.{end.year}.{i}\", partition))\n                else:\n                    o = arow(label, col, context(per, dims), REV, \"net_revenue\", bounds, 3,\n                              f\"annual.{partition}.{end.year}.{i}\", partition)\n                o[\"member_label\"] = member\n                parts.append(o)\n            bridge(f\"annual.revenue_{partition}.{end.year}\", \"partition\", parts, rev, partition=partition)\n        flows = []\n        opening = arow(\"Cash, cash equivalents, and restricted cash and cash equivalents, beginning balances\", col,\n                       context(dict(instant=(start-timedelta(days=1)).isoformat())), CF_BAL, \"cash_including_restricted\",\n                       scope(33), 3, f\"annual.cf.{end.year}.opening\")\n        for key, label in [(\"operating\", \"Cash generated by operating activities\"),\n                            (\"investing\", \"Cash generated by/(used in) investing activities\"),\n                            (\"financing\", \"Cash used in financing activities\")]:\n            flows.append(arow(label, col, ctx, \"us-gaap:NetCashProvidedByUsedIn\"+key.title()+\"Activities\", \"cash_flow\",\n                              scope(33), 3, f\"annual.cf.{end.year}.{key}\"))\n        closing = arow(\"Cash, cash equivalents, and restricted cash and cash equivalents, ending balances\", col,\n                       context(dict(instant=day)), CF_BAL, \"cash_including_restricted\", scope(33), 3,\n                       f\"annual.cf.{end.year}.closing\")\n        bridge(f\"annual.cash_flow.{end.year}\", \"cash_flow\", [opening]+flows, closing)\n    # The annual notional is retained as notional, never recast as debt exposure.\n    bounds = scope(38, \"The notional amounts\", \"The carrying amounts\")\n    notional = arow(\"Interest rate contracts\", 0, context(dict(instant=\"2024-09-28\"), {\n        \"us-gaap:DerivativeInstrumentRiskAxis\": \"us-gaap:InterestRateContractMember\",\n        \"us-gaap:HedgingDesignationAxis\": \"us-gaap:DesignatedAsHedgingInstrumentMember\"}),\n        \"us-gaap:DerivativeNotionalAmount\", \"derivative_notional\", bounds, 2, \"annual.notional.2024\")\n    reader = InlineReader(interim)\n    def iread(concept, ctx, measurement, oid, **kw):\n        return put(reader.select(concept, ctx, measurement, oid, **kw))\n    for day in [\"2024-12-28\", \"2024-09-28\"]:\n        ctx = context(dict(instant=day))\n        rows = {}\n        for key, concept, label in [\n            (\"assets\", \"us-gaap:Assets\", \"Total assets\"),\n            (\"liabilities\", \"us-gaap:Liabilities\", \"Total liabilities\"),\n            (\"equity\", \"us-gaap:StockholdersEquity\", \"Total shareholders’ equity\"),\n            (\"debt_current\", \"us-gaap:LongTermDebtCurrent\", \"Term debt\"),\n            (\"debt_noncurrent\", \"us-gaap:LongTermDebtNoncurrent\", \"Term debt\")]:\n            rows[key] = iread(concept, ctx, \"carrying_amount\", f\"interim.bs.{day}.{key}\", label=label)\n        bridge(f\"interim.balance.{day}\", \"balance\", [rows[\"liabilities\"], rows[\"equity\"]], rows[\"assets\"])\n        rounded = iread(\"us-gaap:LongTermDebt\", ctx, \"carrying_amount\", f\"interim.debt.{day}.rounded\", scale=9, decimals=-8)\n        bridge(f\"interim.rounded_debt.{day}\", \"rounded_debt\", [rows[\"debt_current\"], rows[\"debt_noncurrent\"]], rounded)\n        iread(\"us-gaap:LongTermDebtFairValue\", context(dict(instant=day), {\"us-gaap:FairValueByFairValueHierarchyLevelAxis\": \"us-gaap:FairValueInputsLevel2Member\"}),\n              \"fair_value\", f\"interim.debt.{day}.fair_value\", scale=9, decimals=-8)\n        iread(\"us-gaap:DerivativeNotionalAmount\", context(dict(instant=day), notional[\"context\"][\"dimensions\"]),\n              \"derivative_notional\", f\"interim.notional.{day}\", label=\"Interest rate contracts\")\n        if day in a_bs:\n            for key in rows:\n                bridge(f\"annual_interim_comparative.{key}\", \"equality\", [rows[key]], a_bs[day][key])\n    for start, end in [(\"2024-09-29\", \"2024-12-28\"), (\"2023-10-01\", \"2023-12-30\")]:\n        ctx = context(dict(start=start, end=end))\n        rev = iread(REV, ctx, \"net_revenue\", \"interim.revenue.\"+end, label=\"Total net sales\")\n        for partition, members, dimnames, axis in [\n            (\"product\", PRODUCTS, PRODUCT_MEMBERS, \"srt:ProductOrServiceAxis\"),\n            (\"segment\", SEGMENTS, SEGMENT_MEMBERS, \"us-gaap:StatementBusinessSegmentsAxis\")]:\n            parts = []\n            for i, (member, dim) in enumerate(zip(members, dimnames)):\n                o = iread(REV, context(ctx[\"period\"], {axis: dim}), \"net_revenue\", f\"interim.{partition}.{end}.{i}\",\n                          partition=partition, label=member if partition == \"product\" else \"Net sales\")\n                o[\"member_label\"] = member\n                parts.append(o)\n            bridge(f\"interim.revenue_{partition}.{end}\", \"partition\", parts, rev, partition=partition)\n        opening = iread(CF_BAL, context(dict(instant=(date.fromisoformat(start)-timedelta(days=1)).isoformat())),\n                        \"cash_including_restricted\", \"interim.cf.\"+end+\".opening\", label=\"beginning balances\")\n        flows = [iread(\"us-gaap:NetCashProvidedByUsedIn\"+kind+\"Activities\", ctx, \"cash_flow\", f\"interim.cf.{end}.{kind.lower()}\")\n                 for kind in [\"Operating\", \"Investing\", \"Financing\"]]\n        closing = iread(CF_BAL, context(dict(instant=end)), \"cash_including_restricted\", \"interim.cf.\"+end+\".closing\", label=\"ending balances\")\n        bridge(\"interim.cash_flow.\"+end, \"cash_flow\", [opening]+flows, closing)\n    return observations, bridges, calendar\n","exit_code":0,"status":"completed"}}
