\"context\"], o[\"measurement\"], \"issuer_html.\"+o[\"id\"])\n920:                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n927:                        tested_invariants=\"see result.md for executed tests\", accounting_validity=\"selected displayed identities only; no compliance determination\",\n930:    return out\n933:def validate_case(candidate):\n934:    \"\"\"Rebuild from independently pinned sources, rejecting supplied metadata edits.\"\"\"\n936:    expected = build_case()\n937:    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n938:    return {\"status\": \"pass\", \"observations\": len(expected[\"observations\"]),\n943:def main():\n946:    parser.add_argument(\"--check\", action=\"store_true\", help=\"read-only rebuild and comparison\")\n948:    target = ROOT / args.output_dir / \"case.json\"\n949:    if args.check:\n950:        report = validate_case(json.loads(target.read_text()))\n952:        case = build_case()\n959:if __name__ == \"__main__\":\n\n--- tail ---\n                        6: [\"interim.debt.\"], 10: [\"interim.segment.\"]}.get(note[\"number\"], [])\n            note[\"linked_quantities\"] = [o[\"id\"] for o in observations if any(o[\"id\"].startswith(p) for p in prefixes)]\n        note[\"linked_quantities\"] = sorted(set(note[\"linked_quantities\"]))\n        if note[\"linked_quantities\"]:\n            note[\"disposition\"] = \"selected_quantities_mapped_with_unresolved_remainder\"\n        targets = sorted(set(int(n) for n in re.findall(r\"Note\\s+(\\d+)\", a[\"quote\"])))\n        note[\"cross_references\"] = [dict(target=f\"{a['document']}.note.{n}\",\n                                         relation=\"literal note reference\", status=\"source_present; meaning not necessarily executed\")\n                                    for n in targets if n != note[\"number\"]]\n        require(all(t[\"target\"] in {n[\"id\"] for n in notes} for t in note[\"cross_references\"]), \"unresolved internal note target\")\n    by_id = {n[\"id\"]: n for n in notes}\n    by_id[\"annual.note.9\"][\"cross_references\"].append(dict(target=\"annual.note.4\", relation=\"analyst link: debt and interest-rate swaps\", status=\"source_present\"))\n    by_id[\"interim.note.1\"][\"cross_references\"].append(dict(target=\"annual.note.1\", relation=\"explicit read-with-2024-10-K qualification\", status=\"source_present\"))\n    contingency = by_id[\"interim.note.9\"]\n    contingency[\"assertion\"] = dict(kind=\"reported_management_assessment\", speaker=\"Apple management\",\n        subject=\"asserted legal and other claims\", modal_operator=\"not at least a reasonable possibility\",\n        assessed_event=\"material loss, or material loss greater than a recorded accrual\",\n        unresolved_outcomes=True, probability=None, liability_amount=None,\n        anchor=interim.find(r\"The Company is subject to various legal proceedings.*?asserted legal and other claims\\.\",\n                            (contingency[\"anchor\"][\"start\"], contingency[\"anchor\"][\"end\"]), re.S))\n    return notes\n\n\ndef supported_excerpt(doc, pattern, bounds=None):\n    return doc.find(pattern, bounds, re.S)\n\n\ndef policy_records(annual, interim, notes):\n    n = {r[\"id\"]: r for r in notes}\n    def within(doc, pattern):\n        a = n[doc.identity+\".note.1\"][\"anchor\"]\n        return supported_excerpt(doc, pattern, (a[\"start\"], a[\"end\"]))\n    return [\n        dict(id=\"annual.perimeter\", status=\"reported_policy\", anchor=within(annual, r\"The consolidated financial statements include.*?wholly owned subsidiaries\\.\")),\n        dict(id=\"annual.reclassification\", status=\"reported_qualification\", anchor=within(annual, r\"Certain prior period amounts.*?current period’s presentation\\.\"),\n             interpretation=\"Comparatives are as presented in the 2024 report; original historical presentation has not been reconstructed.\"),\n        dict(id=\"annual.inventory\", status=\"reported_policy\", anchor=within(annual, r\"Inventories are measured using the first-in, first-out method\\.\")),\n        dict(id=\"annual.depreciation\", status=\"reported_policy\", anchor=within(annual, r\"Depreciation on property, plant and equipment.*?straight-line basis\\.\")),\n        dict(id=\"interim.preparation\", status=\"reported_management_assertion\", anchor=within(interim, r\"In the opinion of the Company’s management.*?2024 Form 10-K”\\)\\.\"),\n             interpretation=\"Normal recurring adjustments and management estimates; read together with annual statements, not an independently complete annual policy disclosure.\"),\n        dict(id=\"interim.calendar\", status=\"reported_policy\", anchor=within(interim, r\"The Company’s fiscal year.*?those fiscal years\\.\")),\n    ]\n\n\ndef filing_records():\n    raw = json.loads((ROOT/INDEX).read_text())[\"filings\"][\"recent\"]\n    out = []\n    for identity, accession in [(\"annual\", \"0000320193-24-000123\"),\n                                (\"interim\", \"0000320193-25-000008\"),\n                                (\"proxy\", \"0001308179-25-000008\")]:\n        require(raw[\"accessionNumber\"].count(accession) == 1, \"filing identity missing/ambiguous\")\n        i = raw[\"accessionNumber\"].index(accession)\n        out.append(dict(id=identity, accession=accession, form=raw[\"form\"][i], report_date=raw[\"reportDate\"][i],\n                        filing_date=raw[\"filingDate\"][i], acceptance_timestamp=raw[\"acceptanceDateTime\"][i],\n                        primary_document=raw[\"primaryDocument\"][i], index_path=INDEX, index_sha256=file_hash(INDEX),\n                        json_pointer=f\"/filings/recent/accessionNumber/{i}\",\n                        public_dissemination_timestamp=None, retained_byte_publication_date=None,\n                        qualification=\"Acceptance is index metadata, not independently verified public dissemination or retained-byte vintage.\"))\n    return out\n\n\ndef availability(record, cutoff, scope=\"filing_identity\"):\n    \"\"\"Date-resolution query; unknown byte vintage never inherits a filing date.\"\"\"\n    cutoff = date.fromisoformat(cutoff)\n    require(scope in (\"filing_identity\", \"retained_bytes\"), \"unsupported availability scope\")\n    day = record.get(\"filing_date\" if scope == \"filing_identity\" else \"retained_byte_publication_date\")\n    return \"unknown\" if day is None else (\"available_by_filing_day\" if date.fromisoformat(day) <= cutoff else \"later\")\n\n\ndef version_view(records, cutoff, scope=\"retained_bytes\"):\n    require(len({r[\"id\"] for r in records}) == len(records), \"duplicate version identity\")\n    decisions = [{\"id\": r[\"id\"], \"availability\": availability(r, cutoff, scope)} for r in records]\n    eligible = [d[\"id\"] for d in decisions if d[\"availability\"] == \"available_by_filing_day\"]\n    return dict(versions=decisions, eligible=eligible,\n                resolution=\"retain_all_no_automatic_supersession\", conflict_resolution=\"unsupported\")\n\n\ndef exhibit_records(annual, official, interim):\n    \"\"\"Read exhibit target/version columns; distinguish a link from its contents.\"\"\"\n    result = []\n    for doc, prefix in [(official, \"annual\"), (interim, \"interim\")]:\n        soup = BeautifulSoup((ROOT/doc.original).read_text(), \"html.parser\")\n        for tr in soup.find_all(\"tr\"):\n            cells = [c.get_text(\" \", strip=True) for c in tr.find_all(\"td\", recursive=False)]\n            cells = [c for c in cells if c]\n            if len(cells) < 2 or not re.fullmatch(r\"(?:\\d+\\.\\d+|101|104)[*, ]*\", cells[0]):\n                continue\n            # Exclude financial rows and identify only the exhibit-index description cells.\n            if not tr.find(\"a\", href=True) and \"**\" not in cells[0]:\n                continue\n            number = re.match(r\"\\d+(?:\\.\\d+)?\", cells[0])[0]\n            row_text = tr.get_text(\"\\n\", strip=True)\n            anchor = doc.find(re.escape(row_text))\n            links = [a[\"href\"] for a in tr.find_all(\"a\", href=True)]\n            internal = [u for u in links if u.startswith(\"#\")]\n            external = [u for u in links if u.startswith(\"http\")]\n            record = dict(id=f\"{prefix}.exhibit.{number}\", number=number, description=cells[1],\n                          filed_marker=cells[0], source=anchor, target_links=links,\n                          referenced_form=cells[2] if len(cells) >= 5 else None,\n                          referenced_exhibit=cells[3] if len(cells) >= 5 else None,\n                          referenced_date_or_period=cells[4] if len(cells) >= 5 else None,\n                          contents_status=\"unresolved\", missing_terms=\"Full substantive interpretation and applicability to current contracts.\",\n                          consequence=\"No complete incorporated-package or contract-history claim.\",\n                          next_route=\"Use the exact SEC accession in the link or the issuer filing feed for the stated form and date.\")\n            if internal:\n                require(all(soup.find(id=u[1:]) is not None or soup.find(attrs={\"name\": u[1:]}) is not None for u in internal),\n                        \"broken internal exhibit link\")\n                record[\"contents_status\"] = \"within_retained_issuer_html; semantics_unresolved\"\n            if external:\n                record[\"contents_status\"] = \"external_target_not_acquired\"\n            if number in (\"101\", \"104\"):\n                record[\"contents_status\"] = \"inline_facts_present; complete_taxonomy_package_not_acquired\"\n                record[\"missing_terms\"] = \"Separate taxonomy/linkbase files and complete package validation.\"\n            if prefix == \"annual\":\n                # Bind each issuer index row independently to the mirrored PDF index.\n                lo, hi = annual.page(53)[0], annual.page(56)[1]\n                record[\"pdf_index_row\"] = annual.find(r\"^[ \\t]*\"+re.escape(number)+r\"(?=[* \\t])[^\\n]+\", (lo, hi), re.M)\n            result.append(record)\n    require(len({r[\"id\"] for r in result}) == len(result), \"duplicate exhibit rows\")\n    return result\n\n\ndef external_records(annual, interim, docs):\n    proxy, reg, official = [docs[k] for k in (\"proxy-2025\", \"registration-2021\", \"annual-2024-official\")]\n    exhibits = exhibit_records(annual, official, interim)\n    obligations = []\n    proxy_patterns = {\n        10: r\"Board Independence\\nApple’s Corporate Governance Guidelines.*?applicable rules of The Nasdaq Stock Market LLC.*?\\(“Nasdaq”\\)\\.\",\n        11: r\"Compensation Discussion and Analysis\\nThis Compensation.*?paid to our named executive officers\\.\",\n        12: r\"Security\\nOwnership of Certain Beneficial Owners and Management\\nThe\\nfollowing table.*?\\(the “Table Date”\\)\",\n        13: r\"Related Party Policy and Transactions\\nThe Board has.*?\\$120,000 in a single fiscal year\",\n        14: r\"Audit Fees\\n\\(1\\).*?Total\\n30,270,822\\n25,403,329\",\n    }\n    lo, hi = annual.page(52)\n    for item, pat in proxy_patterns.items():\n        start = annual.find(r\"Item \"+str(item)+r\"\\.[^\\n]+\", (lo, hi))[\"start\"]\n        stop = annual.text.find(\"Item \"+str(item+1)+\".\", start, hi) if item < 14 else hi\n        obligations.append(dict(id=f\"annual.partIII.item{item}\", target=\"2025 proxy, accession 0001308179-25-000008\",\n                                incorporation=annual.anchor(start, stop), support=proxy.find(pat, flags=re.S),\n                                status=\"target_acquired_selected_passage_inspected\",\n                                unresolved=\"Complete item-level semantics, exceptions and references beyond the selected passage remain unmodelled.\",\n                                consequence=\"Proxy information cannot be backdated to the annual filing.\",\n                                next_route=\"Inspect remaining sections in the retained proxy and its exact incorporated targets.\"))\n    title = reg.find(r\"Exhibit 4\\.1\\nApple Inc\\..*?Dated as of October\\s+28, 2021\", flags=re.S)\n    terms = reg.find(r\"Section\\s+301\\.\\nAmount\\nUnlimited; Issuable in Series.*?Section\\s+302\\.\", flags=re.S)\n    defaults = reg.find(r\"Section\\s+501\\.\\nEvents of Default\\n.*?Section\\s+502\\.\", flags=re.S)\n    for e in exhibits:\n        if e[\"id\"] == \"annual.exhibit.4.26\":\n            e.update(contents_status=\"acquired_in_registration_2021; selected_sections_inspected\", acquired_support=title,\n                     section_301=terms, section_501=defaults,\n                     missing_terms=\"Series-specific officer certificates, outstanding balances, amendments and swap confirmations/allocation.\")\n    # Source content after the annual report includes filed exhibits; 4.1 is not a missing external indenture.\n    securities = annual.find(r\"(?m)^[ \\t]*DESCRIPTION OF SECURITIES[^\\n]*\")\n    obligations.append(dict(id=\"annual.exhibit.4.1.in_pdf\", target=\"Description of Securities, filed exhibit 4.1\",\n                            support=securities, status=\"heading_and_contents_retained_in_pdf\",\n                            unresolved=\"Description is not the complete incorporated indentures and series certificates.\",\n                            consequence=\"General descriptions do not identify all current debt terms.\",\n                            next_route=\"Inspect specific 4.2–4.28 index targets for contract reconstruction.\"))\n    omissions = annual.find(r\"Certain instruments defining the rights of holders.*?copies of any such instruments\\.\", annual.page(56), re.S)\n    obligations.append(dict(id=\"omitted_debt_instruments\", target=\"Instruments omitted under Item 601(b)(4)(iii)\", support=omissions,\n                            status=\"expressly_omitted_from_filing\", unresolved=\"Instrument identities and complete terms not specified by this index.\",\n                            consequence=\"No complete debt-contract inventory is established.\",\n                            next_route=\"Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach.\"))\n    return dict(partIII_and_package_obligations=obligations, exhibit_inventory=exhibits,\n                agreement_interpretation=dict(status=\"selected_contract_sections_only\", support=[title, terms, defaults],\n                    interpretation=\"Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.\",\n                    missing=\"2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule.\"))\n\n\ndef unidentified_records(notes):\n    n = {r[\"id\"]: r for r in notes}\n    specs = [\n        (\"debt_and_swaps\", [\"annual.note.9\", \"annual.note.4\", \"interim.note.6\", \"interim.note.4\"],\n         \"Annual interest-rate notional and interim notional are disclosed but contract allocation, resets, hedge coverage and net economic exposure remain unidentified.\",\n         \"Obtain series certificates and public hedge terms; never equate derivative notional with floating-rate debt exposure.\"),\n        (\"debt_movements\", [\"annual.note.9\", \"interim.note.6\"],\n         \"Carrying differences cannot be identified solely from cash issuance/repayment; FX and noncash measurement changes remain separate unknowns.\",\n         \"Reconstruct movements only with sourced FX, hedge, discount and noncash adjustments.\"),\n        (\"asset_cohorts\", [\"annual.note.5\", \"interim.note.5\"],\n         \"Gross/net balances do not identify vintages, remaining useful lives, additions and retirements.\",\n         \"Retain alternative cohort histories until transaction or asset-register evidence supports a narrower family.\"),\n        (\"contingent_outcomes\", [\"annual.note.12\", \"interim.note.9\"],\n         \"Management's loss assessment and commitment amounts do not provide a loss probability measure or a zero liability.\",\n         \"Maintain unresolved outcomes and revisit dated legal disclosures; do not assign equal or confidence-derived probabilities.\"),\n    ]\n    return [dict(id=key, supports=[n[k][\"anchor\"] for k in ids], unresolved=meaning, next_action=action,\n                 status=\"not_identified\", probability=None) for key, ids, meaning, action in specs]\n\n\ndef build_case():\n    annual, interim, docs, bindings, acquisitions = load_sources()\n    observations, bridges, calendar = collect_observations(annual, interim)\n    notes = note_records(annual, interim, observations)\n    # A selected-table check relates representations, not whole-document publication vintage.\n    official_reader = InlineReader(docs[\"annual-2024-official\"])\n    matched = []\n    for o in list(observations):\n        if o[\"id\"] in (\"annual.bs.2024-09-28.assets\", \"annual.bs.2024-09-28.liabilities\",\n                       \"annual.bs.2024-09-28.equity\", \"annual.bs.2024-09-28.debt_current\",\n                       \"annual.bs.2024-09-28.debt_noncurrent\", \"annual.revenue.2024\"):\n            other = official_reader.select(o[\"concept\"], o[\"context\"], o[\"measurement\"], \"issuer_html.\"+o[\"id\"])\n            observations.append(other)\n            bridges.append(reconcile(\"representation.\"+o[\"id\"], \"equality\", [other], o))\n            matched.append(o[\"id\"])\n    policy = policy_records(annual, interim, notes)\n    external = external_records(annual, interim, docs)\n    records = filing_records()\n    out = dict(schema_version=\"accdsl.apple_case.v1\", plan_sha256=PLAN_HASH,\n        scope=\"Retained Apple FY2024 annual, FY2025 Q1 interim and disclosed comparatives; selected numerical bridges only.\",\n        source_bindings=bindings, source_pins=PINS, p01_register=dict(path=REGISTER, sha256=file_hash(REGISTER)),\n        source_acquisition=acquisitions, fiscal_calendar=calendar, policies=policy,\n        observations=observations, notes=notes, reconciliations=bridges, external=external,\n        filing_availability=records, unidentified_histories=unidentified_records(notes),\n        rounding_model=dict(arithmetic=\"exact rational USD\", model=\"closed half-unit nearest-rounding intervals\",\n                            issuer_tie_rule=\"unknown\", inference=\"compatibility only; no distribution or identified underlying exact amounts\"),\n        representation_comparison=dict(matched_observations=matched, whole_document_equivalence=False,\n                                       mirror_publication_date=None, historical_byte_vintage=\"not established\"),\n        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n        mapping_contract=dict(kind=\"explicit case annotations\", context_source=\"Report policies, table headings and original inline contexts\",\n            annual_dates=\"Fiscal year-end table headings plus Note 1 week lengths; duration starts are derived, not calendar-year substitutions.\",\n            partitions=\"Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.\",\n            measurements=\"Debt principal, carrying amount, fair value and derivative notional remain distinct.\",\n            supported_transformations=\"Only the recorded partition aggregation, gross/net signed addition, comparative equality and dated cash movement bridges.\"),\n        acceptance=dict(specified_behavior=\"reviewed P02 plan\", implemented=\"bounded reusable source/context/reconciliation adapter\",\n                        tested_invariants=\"see result.md for executed tests\", accounting_validity=\"selected displayed identities only; no compliance determination\",\n                        empirical_forecast_validity=\"not evaluated; no forecast generated\", human_acceptance=\"pending\"))\n    out[\"anchor_count\"] = validate_anchors(out)\n    return out\n\n\ndef validate_case(candidate):\n    \"\"\"Rebuild from independently pinned sources, rejecting supplied metadata edits.\"\"\"\n    validate_anchors(candidate)\n    expected = build_case()\n    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n    return {\"status\": \"pass\", \"observations\": len(expected[\"observations\"]),\n            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n            \"anchors\": expected[\"anchor_count\"]}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--output-dir\", default=\"data/accounting-master/deliverables/P02\")\n    parser.add_argument(\"--check\", action=\"store_true\", help=\"read-only rebuild and comparison\")\n    args = parser.parse_args()\n    target = ROOT / args.output_dir / \"case.json\"\n    if args.check:\n        report = validate_case(json.loads(target.read_text()))\n    else:\n        case = build_case()\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(case, ensure_ascii=False, indent=2, sort_keys=True)+\"\\n\")\n        report = dict(status=\"built\", **case[\"coverage\"])\n    print(json.dumps(report, sort_keys=True))\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
