{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '300,690p' scripts/apple_case_v1.py\"","aggregated_output":"\ndef validate_value(obs):\n    \"\"\"Check value, precision and sign against the retained numeric reading.\"\"\"\n    value = Fraction(obs[\"value_usd\"])\n    require(obs[\"rounding_interval_usd\"] == interval(value, obs[\"presentation_quantum_usd\"]),\n            \"altered rounding interval\")\n    require(abs(value) == abs(number(obs[\"displayed_literal\"])*power10(obs[\"scale\"])),\n            \"literal/scale/value mismatch\")\n    require(obs[\"source_readings\"], \"missing numeric source\")\n    for source in obs[\"source_readings\"]:\n        if \"cell\" in source:\n            require(value == number(source[\"cell\"][\"quote\"])*MILLION and obs[\"scale\"] == 6 and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == MILLION, \"annual cell/value mismatch\")\n        elif \"fact\" in source:\n            fact = BeautifulSoup(source[\"fact\"][\"quote\"], \"html.parser\").find(\"ix:nonfraction\")\n            require(fact is not None, \"missing inline source\")\n            sign = -1 if fact.get(\"sign\") == \"-\" else 1\n            require(value == number(fact.get_text(strip=True))*power10(int(fact.get(\"scale\", \"0\")))*sign,\n                    \"inline source/value mismatch\")\n            require(obs[\"scale\"] == int(fact.get(\"scale\", \"0\")) and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == power10(-int(fact[\"decimals\"])),\n                    \"inline precision mismatch\")\n        else:\n            raise CaseError(\"unsupported numeric reading\")\n\n\ndef reconcile(bridge_id, kind, operands, target, partition=None):\n    all_obs = operands+[target]\n    for obs in all_obs:\n        validate_value(obs)\n    transformations = []\n    if kind == \"cash_flow\":\n        require(len(operands) == 4, \"cash flow operands\")\n        opening, *flows = operands\n        require(opening[\"measurement\"] == target[\"measurement\"] == \"cash_including_restricted\", \"cash perimeter mismatch\")\n        require(all(o[\"measurement\"] == \"cash_flow\" for o in flows), \"cash movement type\")\n        same_context(all_obs, (\"period\",))\n        per = flows[0][\"context\"][\"period\"]\n        require(all(x[\"context\"][\"period\"] == per for x in flows), \"flow period mismatch\")\n        require(opening[\"context\"][\"period\"] == {\"instant\": (date.fromisoformat(per[\"start\"])-timedelta(days=1)).isoformat()} and\n                target[\"context\"][\"period\"] == {\"instant\": per[\"end\"]}, \"stock/flow date mismatch\")\n        transformations.append(\"Opening instant is the day before the disclosed flow period; closing instant is its end. Cash includes restricted cash on both sides.\")\n    elif kind == \"partition\":\n        same_context(all_obs, (\"dimensions\",))\n        require(partition in (\"product\", \"segment\"), \"unknown partition\")\n        expected = PRODUCTS if partition == \"product\" else SEGMENTS\n        require([o.get(\"partition\") for o in operands] == [partition]*len(expected), \"overlapping or wrong partitions\")\n        require([o.get(\"member_label\") for o in operands] == expected, \"duplicate/missing partition member\")\n        require(all(o[\"measurement\"] == \"net_revenue\" for o in all_obs) and not target[\"context\"][\"dimensions\"], \"revenue target\")\n        require(len({json.dumps(o[\"context\"][\"dimensions\"], sort_keys=True) for o in operands}) == len(expected), \"duplicate dimension members\")\n        axis, members = ((\"srt:ProductOrServiceAxis\", PRODUCT_MEMBERS) if partition == \"product\" else\n                         (\"us-gaap:StatementBusinessSegmentsAxis\", SEGMENT_MEMBERS))\n        require([o[\"context\"][\"dimensions\"] for o in operands] == [{axis: m} for m in members] and\n                all(o[\"concept\"] == REV for o in all_obs), \"partition axis/member/concept mismatch\")\n        transformations.append(\"Sum one disclosed exhaustive table partition; product and geography are separate classifications of the same revenue.\")\n    else:\n        same_context(all_obs)\n        measurements = [o[\"measurement\"] for o in operands]\n        allowed = {\n            \"balance\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n            \"debt_components\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n            \"principal_to_carrying\": ([\"principal\", \"carrying_adjustment\", \"carrying_adjustment\"], \"carrying_amount\"),\n            \"ppe\": ([\"gross_cost\", \"accumulated_depreciation\"], \"carrying_amount\"),\n            \"equality\": ([target[\"measurement\"]], target[\"measurement\"]),\n            \"rounded_debt\": ([\"carrying_amount\", \"carrying_amount\"], \"carrying_amount\"),\n        }\n        require(kind in allowed and (measurements, target[\"measurement\"]) == allowed[kind], \"measurement substitution\")\n        if kind == \"balance\":\n            require([o[\"concept\"] for o in all_obs] == [\"us-gaap:Liabilities\", \"us-gaap:StockholdersEquity\", \"us-gaap:Assets\"],\n                    \"balance concept mismatch\")\n        if kind in (\"debt_components\", \"rounded_debt\"):\n            require([o[\"concept\"] for o in operands] == [\"us-gaap:LongTermDebtCurrent\", \"us-gaap:LongTermDebtNoncurrent\"],\n                    \"debt component concept mismatch\")\n    value = sum(Fraction(o[\"value_usd\"]) for o in operands)\n    target_value = Fraction(target[\"value_usd\"])\n    lhs_interval = interval_sum(operands)\n    rhs_interval = target[\"rounding_interval_usd\"]\n    rounding = compatible(lhs_interval, rhs_interval)\n    require(rounding, \"incompatible rounding intervals\")\n    if kind != \"rounded_debt\":\n        require(value == target_value, \"displayed arithmetic mismatch\")\n    return dict(id=bridge_id, kind=kind, operands=[o[\"id\"] for o in operands], target=target[\"id\"],\n                lhs_usd=str(value), rhs_usd=str(target_value), residual_usd=str(value-target_value),\n                lhs_interval_usd=list(map(str, lhs_interval)), rhs_interval_usd=rhs_interval,\n                displayed_identity=value == target_value, rounding_compatible=rounding,\n                status=\"pass\", transformations=transformations,\n                conclusion=\"displayed identity\" if kind != \"rounded_debt\" else \"rounding compatibility only\")\n\n\ndef html_text(raw):\n    soup = BeautifulSoup(raw, \"html.parser\")\n    for el in soup([\"script\", \"style\"]):\n        el.decompose()\n    return soup.get_text(\"\\n\", strip=True)\n\n\ndef load_sources():\n    for p, h in PINS.items():\n        require(file_hash(p) == h, \"source hash mismatch: \" + p)\n    annual = Document(\"annual\", APPLE+\"annual-2024.pdf\", APPLE+\"annual-2024.txt\", pdf=True)\n    interim = Document(\"interim\", APPLE+\"interim-2025q1.html\", APPLE+\"interim-2025q1.txt\")\n    extracted = subprocess.run([\"pdftotext\", \"-layout\", str(ROOT/annual.original), \"-\"],\n                               capture_output=True, check=True, timeout=30).stdout\n    require(sha(extracted) == annual.extraction_hash, \"PDF extraction does not reproduce retained text\")\n    require(html_text((ROOT/interim.original).read_text()) == interim.text, \"HTML extraction mismatch\")\n    register = json.loads((ROOT/REGISTER).read_text())\n    bindings = []\n    for d, name in [(annual, \"apple-2024-annual\"), (interim, \"apple-2025-q1\")]:\n        candidates = [r for r in register[\"records\"] if r[\"document_id\"] == name]\n        require(len(candidates) == 1, \"P01 source identity\")\n        r = candidates[0]\n        require(r[\"original_sha256\"] == d.original_hash == file_hash(r[\"original_path\"]), \"P01 original binding\")\n        require(r[\"extracted_sha256\"] == file_hash(r[\"extracted_path\"]), \"P01 extraction binding\")\n        bindings.append(dict(**d.binding(), p01_document=name, p01_original_path=r[\"original_path\"],\n                             p01_extraction_path=r[\"extracted_path\"], p01_extraction_sha256=r[\"extracted_sha256\"],\n                             extraction_relation=\"identical\" if r[\"extracted_sha256\"] == d.extraction_hash else\n                             \"distinct text versions; offsets must not transfer\",\n                             p01_publication_metadata=r[\"publication_metadata\"]))\n    acquisitions = json.loads((ROOT/NEW/\"acquisition.json\").read_text())\n    external_docs = {}\n    for rec in acquisitions[\"records\"]:\n        if \"path\" not in rec:\n            continue\n        require(file_hash(rec[\"path\"]) == rec[\"sha256\"], \"acquired bytes changed\")\n        if rec[\"path\"].endswith(\".html\"):\n            p = Path(rec[\"path\"])\n            extracted_path = str(p.with_suffix(\".txt\"))\n            require((ROOT/extracted_path).exists(), \"missing acquired text\")\n            require(html_text((ROOT/p).read_text()) == (ROOT/extracted_path).read_text(), \"external extraction mismatch\")\n            d = Document(p.stem, str(p), extracted_path)\n            external_docs[p.stem] = d\n            bindings.append(dict(**d.binding(), acquisition=rec,\n                                 historical_byte_vintage=\"not established by current retrieval\"))\n    return annual, interim, external_docs, bindings, acquisitions\n\n\ndef collect_observations(annual, interim):\n    observations, bridges = [], []\n    def put(o):\n        require(o[\"id\"] not in {x[\"id\"] for x in observations}, \"duplicate observation id\")\n        observations.append(o)\n        return o\n    def bridge(name, kind, operands, target, **kw):\n        bridges.append(reconcile(name, kind, operands, target, **kw))\n    def scope(page, start=None, end=None):\n        lo, hi = annual.page(page)\n        if start:\n            lo = annual.find(re.escape(start), (lo, hi))[\"start\"]\n        if end:\n            stop = annual.text.find(end, lo, hi)\n            require(stop >= 0, \"scope terminator missing\")\n            hi = stop\n        return lo, hi\n    def arow(label, col, ctx, concept, measure, bounds, cols, oid, partition=None):\n        # Include the table's actual date headings and declared presentation scale.\n        yr = annual.find(r\"^[ \\t]*2024[ \\t]+2023(?:[ \\t]+2022)?[ \\t]*$\", bounds, re.M)\n        header = annual.anchor(bounds[0], yr[\"end\"])\n        return put(annual_row(annual, label, col, ctx, concept, measure, bounds, cols, header, oid, partition))\n    a_bs = {}\n    for col, day in enumerate([\"2024-09-28\", \"2023-09-30\"]):\n        ctx = context(dict(instant=day))\n        rows = {}\n        for key, label, concept in [\n            (\"assets\", \"Total assets\", \"us-gaap:Assets\"),\n            (\"liabilities\", \"Total liabilities\", \"us-gaap:Liabilities\"),\n            (\"equity\", \"Total shareholders’ equity\", \"us-gaap:StockholdersEquity\"),\n            (\"cash\", \"Cash and cash equivalents\", \"us-gaap:CashAndCashEquivalentsAtCarryingValue\"),\n            (\"ppe\", \"Property, plant and equipment, net\", \"us-gaap:PropertyPlantAndEquipmentNet\")]:\n            measure = \"cash_excluding_restricted\" if key == \"cash\" else \"carrying_amount\"\n            rows[key] = arow(label, col, ctx, concept, measure, scope(31), 2, f\"annual.bs.{day}.{key}\")\n        for key, start, end, concept in [\n            (\"debt_current\", \"Current liabilities:\", \"Non-current liabilities:\", \"us-gaap:LongTermDebtCurrent\"),\n            (\"debt_noncurrent\", \"Non-current liabilities:\", \"Commitments and contingencies\", \"us-gaap:LongTermDebtNoncurrent\")]:\n            bounds = scope(31, start, end)\n            header = annual.anchor(annual.page(31)[0], annual.page(31)[0]+450)\n            rows[key] = put(annual_row(annual, \"Term debt\", col, ctx, concept, \"carrying_amount\", bounds, 2,\n                                      header, f\"annual.bs.{day}.{key}\"))\n        bridge(f\"annual.balance.{day}\", \"balance\", [rows[\"liabilities\"], rows[\"equity\"]], rows[\"assets\"])\n        a_bs[day] = rows\n        debt_bounds = scope(43, \"Term Debt\", \"To manage interest rate risk\")\n        d = {}\n        for key, label, measurement in [\n            (\"principal\", \"Total term debt principal\", \"principal\"),\n            (\"discount\", \"Unamortized premium/(discount) and issuance costs, net\", \"carrying_adjustment\"),\n            (\"hedge\", \"Hedge accounting fair value adjustments\", \"carrying_adjustment\"),\n            (\"carrying\", \"Total term debt\", \"carrying_amount\")]:\n            d[key] = arow(label, col, ctx, \"apple:Debt\"+key.title(), measurement, debt_bounds, 2,\n                          f\"annual.debt.{day}.{key}\")\n        bridge(f\"annual.principal_to_carrying.{day}\", \"principal_to_carrying\", [d[k] for k in [\"principal\", \"discount\", \"hedge\"]], d[\"carrying\"])\n        bridge(f\"annual.debt_components.{day}\", \"debt_components\", [rows[\"debt_current\"], rows[\"debt_noncurrent\"]], d[\"carrying\"])\n        p = {}\n        for key, label, measure in [(\"gross\", \"Gross property, plant and equipment\", \"gross_cost\"),\n                                    (\"depreciation\", \"Accumulated depreciation\", \"accumulated_depreciation\"),\n                                    (\"net\", \"Total property, plant and equipment, net\", \"carrying_amount\")]:\n            p[key] = arow(label, col, ctx, \"apple:PPE\"+key.title(), measure,\n                          scope(39, \"Note 5\", \"Note 6\"), 2, f\"annual.ppe.{day}.{key}\")\n        bridge(f\"annual.ppe.{day}\", \"ppe\", [p[\"gross\"], p[\"depreciation\"]], p[\"net\"])\n        bridge(f\"annual.ppe_statement.{day}\", \"equality\", [p[\"net\"]], rows[\"ppe\"])\n    # Years and week lengths are read from the actual Note 1 calendar paragraph.\n    calendar = annual.find(r\"The Company’s fiscal year is the 52- or 53-week period.*?associated quarters, months and periods of those fiscal years\\.\",\n                           scope(34), re.S)\n    m = re.search(r\"years (\\d{4}) and (\\d{4}) spanned (\\d+) weeks each, whereas fiscal year (\\d{4}) spanned (\\d+) weeks\", calendar[\"quote\"])\n    require(m is not None, \"fiscal week lengths missing\")\n    weeks = {m[1]: int(m[3]), m[2]: int(m[3]), m[4]: int(m[5])}\n    # The dates are bound to the split-line date header on printed page 33.\n    for col, day in enumerate([\"2024-09-28\", \"2023-09-30\", \"2022-09-24\"]):\n        end = date.fromisoformat(day)\n        require(end.strftime(\"%B\")+\" \"+str(end.day)+\",\" in annual.text[slice(*annual.page(33))], \"annual end header missing\")\n        start = end+timedelta(days=1-weeks[str(end.year)]*7)\n        per = dict(start=start.isoformat(), end=day)\n        ctx = context(per)\n        rev = arow(\"Total net sales\", col, ctx, REV, \"net_revenue\", scope(29), 3, f\"annual.revenue.{end.year}\")\n        for partition, members in [(\"product\", PRODUCTS), (\"segment\", SEGMENTS)]:\n            parts = []\n            for i, member in enumerate(members):\n                dims = {\"srt:ProductOrServiceAxis\": PRODUCT_MEMBERS[i]} if partition == \"product\" else {\"us-gaap:StatementBusinessSegmentsAxis\": SEGMENT_MEMBERS[i]}\n                bounds = scope(35) if partition == \"product\" else scope(47, member+\":\", \"Operating income\")\n                label = \"Services (1)\" if member == \"Services\" else member\n                if partition == \"segment\":\n                    o = put(annual_row(annual, \"Net sales\", col, context(per, dims), REV, \"net_revenue\", bounds, 3,\n                                      annual.anchor(annual.page(47)[0], scope(47, \"Americas:\")[0]), f\"annual.{partition}.{end.year}.{i}\", partition))\n                else:\n                    o = arow(label, col, context(per, dims), REV, \"net_revenue\", bounds, 3,\n                              f\"annual.{partition}.{end.year}.{i}\", partition)\n                o[\"member_label\"] = member\n                parts.append(o)\n            bridge(f\"annual.revenue_{partition}.{end.year}\", \"partition\", parts, rev, partition=partition)\n        flows = []\n        opening = arow(\"Cash, cash equivalents, and restricted cash and cash equivalents, beginning balances\", col,\n                       context(dict(instant=(start-timedelta(days=1)).isoformat())), CF_BAL, \"cash_including_restricted\",\n                       scope(33), 3, f\"annual.cf.{end.year}.opening\")\n        for key, label in [(\"operating\", \"Cash generated by operating activities\"),\n                            (\"investing\", \"Cash generated by/(used in) investing activities\"),\n                            (\"financing\", \"Cash used in financing activities\")]:\n            flows.append(arow(label, col, ctx, \"us-gaap:NetCashProvidedByUsedIn\"+key.title()+\"Activities\", \"cash_flow\",\n                              scope(33), 3, f\"annual.cf.{end.year}.{key}\"))\n        closing = arow(\"Cash, cash equivalents, and restricted cash and cash equivalents, ending balances\", col,\n                       context(dict(instant=day)), CF_BAL, \"cash_including_restricted\", scope(33), 3,\n                       f\"annual.cf.{end.year}.closing\")\n        bridge(f\"annual.cash_flow.{end.year}\", \"cash_flow\", [opening]+flows, closing)\n    # The annual notional is retained as notional, never recast as debt exposure.\n    bounds = scope(38, \"The notional amounts\", \"The carrying amounts\")\n    notional = arow(\"Interest rate contracts\", 0, context(dict(instant=\"2024-09-28\"), {\n        \"us-gaap:DerivativeInstrumentRiskAxis\": \"us-gaap:InterestRateContractMember\",\n        \"us-gaap:HedgingDesignationAxis\": \"us-gaap:DesignatedAsHedgingInstrumentMember\"}),\n        \"us-gaap:DerivativeNotionalAmount\", \"derivative_notional\", bounds, 2, \"annual.notional.2024\")\n    reader = InlineReader(interim)\n    def iread(concept, ctx, measurement, oid, **kw):\n        return put(reader.select(concept, ctx, measurement, oid, **kw))\n    for day in [\"2024-12-28\", \"2024-09-28\"]:\n        ctx = context(dict(instant=day))\n        rows = {}\n        for key, concept, label in [\n            (\"assets\", \"us-gaap:Assets\", \"Total assets\"),\n            (\"liabilities\", \"us-gaap:Liabilities\", \"Total liabilities\"),\n            (\"equity\", \"us-gaap:StockholdersEquity\", \"Total shareholders’ equity\"),\n            (\"debt_current\", \"us-gaap:LongTermDebtCurrent\", \"Term debt\"),\n            (\"debt_noncurrent\", \"us-gaap:LongTermDebtNoncurrent\", \"Term debt\")]:\n            rows[key] = iread(concept, ctx, \"carrying_amount\", f\"interim.bs.{day}.{key}\", label=label)\n        bridge(f\"interim.balance.{day}\", \"balance\", [rows[\"liabilities\"], rows[\"equity\"]], rows[\"assets\"])\n        rounded = iread(\"us-gaap:LongTermDebt\", ctx, \"carrying_amount\", f\"interim.debt.{day}.rounded\", scale=9, decimals=-8)\n        bridge(f\"interim.rounded_debt.{day}\", \"rounded_debt\", [rows[\"debt_current\"], rows[\"debt_noncurrent\"]], rounded)\n        iread(\"us-gaap:LongTermDebtFairValue\", context(dict(instant=day), {\"us-gaap:FairValueByFairValueHierarchyLevelAxis\": \"us-gaap:FairValueInputsLevel2Member\"}),\n              \"fair_value\", f\"interim.debt.{day}.fair_value\", scale=9, decimals=-8)\n        iread(\"us-gaap:DerivativeNotionalAmount\", context(dict(instant=day), notional[\"context\"][\"dimensions\"]),\n              \"derivative_notional\", f\"interim.notional.{day}\", label=\"Interest rate contracts\")\n        if day in a_bs:\n            for key in rows:\n                bridge(f\"annual_interim_comparative.{key}\", \"equality\", [rows[key]], a_bs[day][key])\n    for start, end in [(\"2024-09-29\", \"2024-12-28\"), (\"2023-10-01\", \"2023-12-30\")]:\n        ctx = context(dict(start=start, end=end))\n        rev = iread(REV, ctx, \"net_revenue\", \"interim.revenue.\"+end, label=\"Total net sales\")\n        for partition, members, dimnames, axis in [\n            (\"product\", PRODUCTS, PRODUCT_MEMBERS, \"srt:ProductOrServiceAxis\"),\n            (\"segment\", SEGMENTS, SEGMENT_MEMBERS, \"us-gaap:StatementBusinessSegmentsAxis\")]:\n            parts = []\n            for i, (member, dim) in enumerate(zip(members, dimnames)):\n                o = iread(REV, context(ctx[\"period\"], {axis: dim}), \"net_revenue\", f\"interim.{partition}.{end}.{i}\",\n                          partition=partition, label=member if partition == \"product\" else \"Net sales\")\n                o[\"member_label\"] = member\n                parts.append(o)\n            bridge(f\"interim.revenue_{partition}.{end}\", \"partition\", parts, rev, partition=partition)\n        opening = iread(CF_BAL, context(dict(instant=(date.fromisoformat(start)-timedelta(days=1)).isoformat())),\n                        \"cash_including_restricted\", \"interim.cf.\"+end+\".opening\", label=\"beginning balances\")\n        flows = [iread(\"us-gaap:NetCashProvidedByUsedIn\"+kind+\"Activities\", ctx, \"cash_flow\", f\"interim.cf.{end}.{kind.lower()}\")\n                 for kind in [\"Operating\", \"Investing\", \"Financing\"]]\n        closing = iread(CF_BAL, context(dict(instant=end)), \"cash_including_restricted\", \"interim.cf.\"+end+\".closing\", label=\"ending balances\")\n        bridge(\"interim.cash_flow.\"+end, \"cash_flow\", [opening]+flows, closing)\n    return observations, bridges, calendar\n\n\n# Interpretation annotations, not extracted values or executable accounting rules.\nNOTE_MEANING = {\n    \"Summary of Significant Accounting Policies\": (\n        [\"consolidation\", \"calendar\", \"measurement policies\"],\n        \"Use the disclosed fiscal calendar and consolidated perimeter; annual policies and interim preparation qualifications remain distinct.\",\n        \"Legal-entity control histories, estimate changes and full policy-to-posting rules are not reconstructed.\"),\n    \"Revenue\": ([\"revenue\", \"deferred revenue\", \"returns\"],\n        \"Keep the disclosed product/service partition separate from geographic segment revenue.\",\n        \"Contract performance, return estimates, transaction-price allocation and deferred-revenue movements remain unidentified.\"),\n    \"Earnings Per Share\": ([\"earnings\", \"share denominators\", \"dilution\"],\n        \"Retain the EPS numerator and dated weighted-average basic/diluted share table as unresolved typed meaning.\",\n        \"Share counts are in thousands and EPS is per share; this USD-only extractor does not implement dilution or per-share division.\"),\n    \"Financial Instruments\": ([\"investments\", \"derivatives\", \"hedging\", \"OCI\"],\n        \"Retain interest-rate derivative notional separately from debt carrying amount and rate exposure.\",\n        \"Notional does not identify hedge allocation, reset dates, currency sensitivities or future OCI recycling.\"),\n    \"Property, Plant and Equipment\": ([\"fixed assets\", \"depreciation\"],\n        \"Reconcile gross cost plus signed accumulated depreciation to net carrying amount and the balance sheet.\",\n        \"Acquisition cohorts, disposals, asset lives and future depreciation are not identified by the gross/net bridge.\"),\n    \"Consolidated Financial Statement Details\": ([\"deferred taxes\", \"other assets\", \"other liabilities\"],\n        \"Retain component schedules with explicit unresolved movement and recognition meaning.\",\n        \"Components of other assets and liabilities are not converted to a unique transaction history or posting rules.\"),\n    \"Condensed Consolidated Financial Statement Details\": ([\"inventories\", \"fixed assets\"],\n        \"Retain inventory components and gross/net PP&E schedules with their interim dates and presentation units.\",\n        \"Inventory purchase/consumption histories and asset cohorts remain unidentified; interim detail schedules are not executed here.\"),\n    \"Income Taxes\": ([\"current taxes\", \"deferred taxes\", \"state aid\"],\n        \"Keep the State Aid Decision and current/deferred tax schedules as dated disclosures.\",\n        \"Jurisdiction-specific settlements, taxable bases and future effective rates cannot be inferred from the totals.\"),\n    \"Leases\": ([\"lease liabilities\", \"right-of-use assets\", \"lease expense\"],\n        \"Retain maturity buckets and fixed/variable payment distinctions without treating commitments as an undiscounted liability.\",\n        \"Individual lease discounting, renewal choices, modifications and variable-payment drivers remain unidentified.\"),\n    \"Debt\": ([\"financing\", \"cash flow\", \"interest\", \"hedging\"],\n        \"Separate principal, carrying adjustments, current/noncurrent carrying value, rounded narrative amounts and fair value.\",\n        \"Cash repayments alone cannot produce a debt roll-forward: FX, noncash and measurement movements and contract allocations are missing.\"),\n    \"Shareholders’ Equity\": ([\"repurchases\", \"equity\", \"dividends\"],\n        \"Repurchase permission is not an obligation to acquire a minimum number of shares.\",\n        \"Future repurchases, dividends and issuance timing remain choices, not deterministic consequences of authorization.\"),\n    \"Share-Based Compensation\": ([\"compensation\", \"equity\", \"tax withholding\"],\n        \"Retain award/vesting disclosures and expense/related tax effects as separate accounting quantities.\",\n        \"Grant-level vesting, forfeiture, performance outcomes and future cash-tax settlement histories remain unresolved.\"),\n    \"Commitments, Contingencies and Supply Concentrations\": ([\"purchase commitments\", \"litigation\", \"supplier concentration\"],\n        \"Preserve conditional litigation language, contractual purchase schedules and qualitative supplier concentration.\",\n        \"No loss probabilities, universal materiality threshold, provision equal to commitments or numerical supplier haircut is inferred.\"),\n    \"Contingencies\": ([\"litigation\", \"accruals\", \"material loss\"],\n        \"Retain management's dated assessment of asserted legal and other claims, including its uncertainty and recorded-accrual qualification.\",\n        \"The assertion supplies neither a zero liability nor a numerical loss probability or quantified materiality threshold.\"),\n    \"Segment Information and Geographic Data\": ([\"segment revenue\", \"segment profit\", \"geography\"],\n        \"Geographic segments form one revenue partition; product/service revenue is another partition of the same consolidated sales.\",\n        \"Cross-classified product-by-geography cells, future regional behavior and full segment-profit cost allocations remain unidentified.\"),\n}\n\n\ndef walk_anchors(value):\n    if isinstance(value, dict):\n        if {\"start\", \"end\", \"quote\", \"offset_unit\"} <= value.keys():\n            yield value\n        for item in value.values():\n            yield from walk_anchors(item)\n    elif isinstance(value, list):\n        for item in value:\n            yield from walk_anchors(item)\n\n\ndef validate_anchors(value):\n    cache = {}\n    def read(path, digest):\n        resolved = (ROOT/path).resolve()\n        require(resolved.is_relative_to(ROOT), \"anchor outside repository\")\n        if path not in cache:\n            data = resolved.read_bytes()\n            cache[path] = (sha(data), None if path.endswith('.pdf') else data.decode('utf-8'))\n        require(cache[path][0] == digest, \"anchor source hash mismatch\")\n        return cache[path][1]\n    count = 0\n    for a in walk_anchors(value):\n        if \"original_path\" in a:\n            read(a[\"original_path\"], a[\"original_sha256\"])\n            text = read(a[\"extraction_path\"], a[\"extraction_sha256\"])\n        else:\n            text = read(a[\"path\"], a[\"sha256\"])\n        require(a[\"offset_unit\"] == \"Unicode code points\" and\n                0 <= a[\"start\"] < a[\"end\"] <= len(text) and\n                text[a[\"start\"]:a[\"end\"]] == a[\"quote\"], \"broken source quotation/offset\")\n        if \"pdf_page\" in a:\n            doc = Document(a[\"document\"], a[\"original_path\"], a[\"extraction_path\"], True)\n            require(doc.anchor(a[\"start\"], a[\"end\"]) == a, \"PDF page/anchor mismatch\")\n        count += 1\n    return count\n\n\ndef note_records(annual, interim, observations):\n    notes = discover_notes(annual, 13)+discover_notes(interim, 10)\n    inventory = json.loads((ROOT/APPLE/\"manifest.json\").read_text())[\"notes\"]\n    require([(n[\"id\"], n[\"title\"]) for n in notes] == [(n[\"id\"], n[\"title\"]) for n in inventory],\n            \"note inventory disagreement\")\n    for note in notes:\n        areas, interpretation, unknown = NOTE_MEANING[note[\"title\"]]\n        note.update(disposition=\"partially_mapped\" if note[\"number\"] in (1, 2, 4) else \"unresolved_meaning_retained\",\n                    affected_model_areas=areas, interpretation=interpretation,\n                    unresolved_meaning=unknown, semantic_completion=False, linked_quantities=[],\n                    qualifications=\"The full bounded source passage is retained; only the stated interpretation is applied.\")\n","exit_code":0,"status":"completed"}}
