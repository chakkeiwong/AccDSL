     \"reason\": \"Composition undisclosed\",\n      \"probability\": null\n    }\n  },\n  \"currency\": {\n    \"USD\": {\n      \"scale\": 2,\n      \"posting_rounding\": \"half_even\"\n    }\n  },\n  \"DebtMix\": {\n    \"fields\": {\n      \"principal\": \"Money<book.currency>, >=0\",\n      \"fixed_fraction\": \"Real [0,1]\",\n      \"fixed_rate\": \"Rate<annual_simple> >=0\",\n      \"initial_floating_rate\": \"Rate<annual_simple> >=0\"\n    },\n    \"additional_terms\": {\n      \"maturity\": \"2027-12-31\",\n      \"fees\": \"0\",\n      \"currency\": \"USD\",\n      \"pay_date\": \"2026-12-31\",\n      \"accrual_period\": [\n        \"2026-01-01\",\n        \"2027-01-01\"\n      ],\n      \"year_fraction\": \"1\",\n      \"default_rule\": \"halt settlement with unpaid obligation; no hidden credit facility\"\n    },\n    \"state\": [\n      \"principal\",\n      \"fixed_principal\",\n      \"floating_principal\",\n      \"current_floating_rate\",\n      \"unpaid_interest\",\n      \"status\"\n    ],\n    \"initialization\": \"F=alpha*principal; V=(1-alpha)*principal; current_floating_rate=initial_floating_rate; unpaid_interest=0; status=performing\",\n    \"operations\": [\n      {\n        \"name\": \"reset\",\n        \"phase\": \"market\",\n        \"precondition\": \"date=2026-01-01; driver available\",\n        \"payload\": [\n          \"market_rate\"\n        ],\n        \"effect\": \"current_floating_rate=market_rate\",\n        \"postings\": \"none; explicit non-recognition operation\"\n      },\n      {\n        \"name\": \"accrue_and_pay\",\n        \"phase\": \"settlement\",\n        \"precondition\": \"principal>=0 and cash>=rounded_interest\",\n        \"payload\": [\n          \"F\",\n          \"V\",\n          \"fixed_rate\",\n          \"current_floating_rate\",\n          \"year_fraction\"\n        ],\n        \"amount\": \"roundMoney((F*fixed_rate+V*current_floating_rate)*year_fraction,2,half_even)\",\n        \"postings\": [\n          \"Dr InterestExpense amount\",\n          \"Cr Cash amount\"\n        ],\n        \"effect\": \"interest obligation accrued and settled atomically\"\n      },\n      {\n        \"name\": \"close\",\n        \"phase\": \"closing\",\n        \"precondition\": \"all required period operations committed\",\n        \"payload\": [\n          \"InterestExpense balance\"\n        ],\n        \"postings\": [\n          \"Dr Retained expense\",\n          \"Cr InterestExpense expense\"\n        ],\n        \"effect\": \"temporary account zero\"\n      }\n    ]\n  },\n  \"request\": {\n    \"model\": \"BorrowingExample@1\",\n    \"evidence_view\": \"synthetic-2025-exact\",\n    \"initial_state\": \"after-2025-close\",\n    \"horizon\": [\n      \"2026-01-01\",\n      \"2027-01-01\"\n    ],\n    \"conditions\": [\n      \"allFixed\",\n      \"allFloating\"\n    ],\n    \"scenarios\": [\n      \"rateShock\"\n    ],\n    \"mode\": \"conditional\",\n    \"weight_model\": null,\n    \"reports\": [\n      \"balance_sheet\",\n      \"income\",\n      \"comprehensive_income\",\n      \"cash_flow\",\n      \"equity\",\n      \"journals\"\n    ]\n  },\n  \"expected\": {\n    \"allFixed\": {\n      \"interest\": \"5\",\n      \"cash\": \"90\",\n      \"debt\": \"100\",\n      \"profit\": \"-5\",\n      \"equity\": \"-10\"\n    },\n    \"allFloating\": {\n      \"interest\": \"7\",\n      \"cash\": \"88\",\n      \"debt\": \"100\",\n      \"profit\": \"-7\",\n      \"equity\": \"-12\"\n    },\n    \"parent\": {\n      \"interest\": \"7-2*alpha\",\n      \"bounds\": [\n        \"5\",\n        \"7\"\n      ],\n      \"measure\": null\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
