  },\n        \"basis\": {\n          \"type\": \"string\"\n        },\n        \"date\": {\n          \"type\": \"string\"\n        },\n        \"information_view\": {\n          \"type\": \"string\"\n        },\n        \"method\": {\n          \"type\": \"string\"\n        },\n        \"numerical_status\": {\n          \"enum\": [\n            \"exact\",\n            \"approximate\",\n            \"failed\"\n          ]\n        },\n        \"error\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/Rational\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n        \"provenance\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"value_expression\",\n        \"basis\",\n        \"date\",\n        \"information_view\",\n        \"method\",\n        \"numerical_status\",\n        \"error\",\n        \"provenance\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"Journal\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\"\n        },\n        \"event\": {\n          \"type\": \"string\"\n        },\n        \"book\": {\n          \"type\": \"string\"\n        },\n        \"date\": {\n          \"type\": \"string\"\n        },\n        \"accrual_period\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/Time\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n        \"postings\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/Posting\"\n          }\n        },\n        \"rule\": {\n          \"type\": \"string\"\n        },\n        \"measurements\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"assumptions\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"precondition_hash\": {\n          \"type\": \"string\"\n        },\n        \"explanation\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"event\",\n        \"book\",\n        \"date\",\n        \"accrual_period\",\n        \"postings\",\n        \"rule\",\n        \"measurements\",\n        \"assumptions\",\n        \"precondition_hash\",\n        \"explanation\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"Scenario\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"ExogenousStress\",\n            \"ObservationalConditioning\",\n            \"StructuralIntervention\"\n          ]\n        },\n        \"drivers\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/FieldBinding\"\n          }\n        },\n        \"probability_model\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n        \"observed_event\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"templates\",\n        \"slot_limits\",\n        \"resolution\",\n        \"calendars\",\n        \"choices\",\n        \"exclusions\",\n        \"obligations\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"HistoryFamily\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\"\n        },\n        \"scope\": {\n          \"type\": \"string\"\n        },\n        \"evidence_view\": {\n          \"type\": \"string\"\n        },\n        \"opening_state\": {\n          \"type\": \"string\"\n        },\n        \"symbols\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"choices\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"constraints\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"alternatives\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"feasibility\": {\n          \"enum\": [\n            \"Feasible\",\n            \"Infeasible\",\n            \"Unknown\"\n          ]\n        },\n        \"coverage\": {\n          \"enum\": [\n            \"ExactWithinScope\",\n            \"PartialSearch\",\n            \"Approximate\"\n          ]\n        },\n        \"completed_cells\": {\n          \"type\": \"integer\",\n          \"minimum\": 0\n        },\n        \"unresolved_cells\": {\n          \"type\": \"integer\",\n          \"minimum\": 0\n        },\n        \"witnesses\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"solver_results\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"scope\",\n        \"evidence_view\",\n        \"opening_state\",\n        \"symbols\",\n        \"choices\",\n        \"constraints\",\n        \"alternatives\",\n        \"feasibility\",\n        \"coverage\",\n        \"completed_cells\",\n        \"unresolved_cells\",\n        \"witnesse