{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '620,1180p' scripts/core0_ir_v1.py\"","aggregated_output":"        \"journals\", \"scenarios\", \"informationViews\", \"reviewDecisions\", \"evidenceViews\",\n        \"modelScopes\", \"historyFamilies\", \"probabilityModels\", \"reportMappings\", \"resultCells\",\n        \"branchResults\", \"runs\", \"diagnostics\",\n    ]\n    out = {k: [] for k in keys}\n    out[\"schema_version\"] = \"0.1\"\n    return out\n\n\ndef _diag(code: str, message: str, location: str, capability: Optional[str] = None,\n          span: Optional[tuple[int, int]] = None) -> _Failure:\n    return _Failure(Diagnostic(code, message, location, capability=capability, span=span))\n\n\nclass _Compiler:\n    def __init__(self, program: Program, bindings: CompileBindings,\n                 source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,\n                 input_text: Optional[str] = None):\n        self.program = program\n        self.bindings = bindings\n        self.source_spans = source_spans or {}\n        self.input_text = input_text\n        self.ir = _empty_ir()\n        self.source_map: dict[str, dict[str, Any]] = {}\n        self.expr_rows: dict[str, dict[str, Any]] = {}\n        self.expr_info: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.decls: dict[str, Any] = {}\n        self.lets: dict[str, LetDecl] = {}\n        self.let_ids: dict[str, str] = {}\n        self.lowering_lets: set[str] = set()\n        self.observations: dict[str, ObservationDecl] = {}\n        self.symbols: dict[str, SymbolDecl] = {}\n        self.sources: dict[str, SourceDecl] = {}\n        self.entities: dict[str, EntityDecl] = {}\n        self.books: dict[str, BookDecl] = {}\n        self.accounts: dict[str, AccountDecl] = {}\n        self.openings: dict[str, OpeningDecl] = {}\n        self.contracts: dict[str, ContractDecl] = {}\n        self.alternatives: dict[str, AlternativeDecl] = {}\n        self.scenarios: dict[str, ScenarioDecl] = {}\n        self.reports: dict[str, ReportDecl] = {}\n        self.constraints: dict[str, ConstraintDecl] = {}\n        self.package: Optional[PackageBinding] = None\n        self.entity: Optional[EntityDecl] = None\n        self.book: Optional[BookDecl] = None\n        self.scope_id = f\"scope:{_clean_id(program.module)}@{_clean_id(program.version)}\"\n        self.model_id = f\"{program.module}@{program.version}\"\n\n    def fail(self, code: str, message: str, location: str, capability: Optional[str] = None,\n             node: Any = None) -> None:\n        span = None\n        if node is not None and id(node) in self.source_spans:\n            item = self.source_spans[id(node)]\n            span = (item.get(\"start\", 0), item.get(\"end\", 0))\n        raise _diag(code, message, location, capability, span)\n\n    def collect(self) -> None:\n        if not self.program.module or not self.program.version:\n            self.fail(\"InvalidModule\", \"module name and version are required\", \"module\")\n        reserved = {\n            \"module\", \"version\", \"use\", \"source\", \"entity\", \"functional\", \"book\", \"basis\",\n            \"account\", \"opening\", \"observation\", \"instant\", \"period\", \"symbol\", \"in\", \"because\",\n            \"choice\", \"binding\", \"let\", \"constraint\", \"alternative\", \"assume\", \"contract\", \"event\",\n            \"rule\", \"for\", \"as\", \"when\", \"require\", \"post\", \"scenario\", \"set\", \"report\", \"from\",\n            \"to\", \"true\", \"false\", \"and\", \"or\", \"not\", \"debit\", \"credit\",\n        }\n        declared_uses = tuple(d for d in self.program.declarations if isinstance(d, UseDecl))\n        all_uses = tuple(self.program.uses) + declared_uses\n        seen_use_ids: set[str] = set()\n        for use in all_uses:\n            self._check_name(use.name, \"use\", reserved)\n            if (use.name, use.version) in seen_use_ids:\n                self.fail(\"DuplicateDeclaration\", f\"duplicate package use {use.name!r}\", use.name)\n            seen_use_ids.add((use.name, use.version))\n            try:\n                package = self.bindings.package(use.name, use.version)\n            except _Failure:\n                raise\n            if self.package is not None and self.package.id != package.id:\n                self.fail(\"PackageCollision\", \"multiple package bases are outside Core0.1\", use.name)\n            self.package = package\n        for decl in self.program.declarations:\n            if isinstance(decl, UseDecl):\n                # A use is allowed either in Program.uses or declarations, but\n                # it must not be silently duplicated.\n                continue\n            if isinstance(decl, UnsupportedDecl):\n                self.fail(\"UnsupportedDeclaration\", f\"{decl.kind} is outside Core0.1\", decl.name or decl.kind,\n                          capability=decl.kind)\n            name = getattr(decl, \"name\", None)\n            if name:\n                self._check_name(name, type(decl).__name__, reserved)\n                if name in self.decls:\n                    self.fail(\"DuplicateDeclaration\", f\"duplicate declaration {name!r}\", name)\n                self.decls[name] = decl\n            if isinstance(decl, SourceDecl):\n                self.sources[decl.name] = decl\n            elif isinstance(decl, EntityDecl):\n                self.entities[decl.name] = decl\n            elif isinstance(decl, BookDecl):\n                self.books[decl.name] = decl\n            elif isinstance(decl, AccountDecl):\n                self.accounts[decl.name] = decl\n            elif isinstance(decl, OpeningDecl):\n                self.openings[decl.name] = decl\n            elif isinstance(decl, ObservationDecl):\n                self.observations[decl.name] = decl\n            elif isinstance(decl, SymbolDecl):\n                self.symbols[decl.name] = decl\n            elif isinstance(decl, LetDecl):\n                self.lets[decl.name] = decl\n            elif isinstance(decl, ConstraintDecl):\n                self.constraints[decl.name] = decl\n            elif isinstance(decl, ContractDecl):\n                self.contracts[decl.name] = decl\n            elif isinstance(decl, AlternativeDecl):\n                self.alternatives[decl.name] = decl\n            elif isinstance(decl, ScenarioDecl):\n                self.scenarios[decl.name] = decl\n            elif isinstance(decl, ReportDecl):\n                self.reports[decl.name] = decl\n            else:\n                self.fail(\"UnsupportedDeclaration\", f\"{type(decl).__name__} is outside Core0.1\", str(decl))\n        # A typed program may pass uses separately; source frontend does this.\n        if self.package is None and all_uses:\n            self.fail(\"MissingPackageBinding\", \"a Core0.1 program requires one package use\", \"use\")\n        if self.package is None:\n            self.fail(\"MissingPackageBinding\", \"a Core0.1 program requires one package use\", \"use\")\n        if len(self.entities) != 1 or len(self.books) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires exactly one entity and one book\", \"profile\")\n        if len(self.observations) < 1 or len(self.symbols) < 1 or len(self.contracts) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires an observation, symbol and one contract\", \"profile\")\n        if len(self.openings) != 1 or len(self.reports) != 1 or len(self.scenarios) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires one opening, scenario and report\", \"profile\")\n        if len(self.alternatives) < 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires at least one named alternative\", \"profile\")\n        self.entity = next(iter(self.entities.values()))\n        self.book = next(iter(self.books.values()))\n        if self.book.entity != self.entity.name:\n            self.fail(\"BindingMismatch\", \"book entity must name the declared entity\", self.book.name)\n        if self.book.basis != self.package.name or self.book.version != self.package.version:\n            self.fail(\"PackageBinding\", \"book basis/version must match the locked package\", self.book.name)\n\n    @staticmethod\n    def _check_name(name: str, where: str, reserved: set[str]) -> None:\n        if not re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", name):\n            raise _diag(\"InvalidIdentifier\", f\"invalid identifier {name!r}\", where)\n        if name in reserved:\n            raise _diag(\"ReservedIdentifier\", f\"reserved keyword {name!r} cannot be declared\", where)\n\n    def _external_ids(self) -> dict[str, Any]:\n        return {\n            **{r.key: r for r in self.bindings.readings},\n            **{o.key: o for o in self.bindings.openings},\n            **{r.key: r for r in self.bindings.reports},\n        }\n\n    def _expr_id(self, owner: str, path: str) -> str:\n        return f\"expr:{_clean_id(owner)}:{_clean_id(path)}\"\n\n    def _record_source(self, expr_id: str, expr: Any, owner: str, path: str) -> None:\n        item = self.source_spans.get(id(expr))\n        if item:\n            self.source_map[expr_id] = dict(item, owner=owner, path=path)\n\n    def _add_expr(self, expr_id: str, row: dict[str, Any], typ: str,\n                  context: Optional[str], value: Any = None, expr: Any = None,\n                  owner: str = \"\", path: str = \"\") -> tuple[str, str, Optional[str], Any]:\n        if expr_id in self.expr_rows:\n            prior = self.expr_rows[expr_id]\n            if prior != row:\n                self.fail(\"ExpressionIdentityCollision\", f\"two expressions map to {expr_id}\", expr_id)\n            return expr_id, typ, context, value\n        self.expr_rows[expr_id] = row\n        self.expr_info[expr_id] = (typ, context, value)\n        self._record_source(expr_id, expr, owner, path)\n        return expr_id, typ, context, value\n\n    def _lookup_type(self, name: str) -> tuple[str, Optional[str], Any]:\n        if name in self.let_ids:\n            return self.expr_info[self.let_ids[name]]\n        if name in self.observations:\n            obs = self.observations[name]\n            ctx = f\"context:{_clean_id(obs.name)}\"\n            return f\"Observation<{obs.type_name}>\", ctx, None\n        if name in self.symbols:\n            return self.symbols[name].type_name, None, None\n        self.fail(\"UnknownReference\", f\"reference {name!r} is not declared\", name)\n\n    def _constant(self, expr_id: str) -> Optional[Fraction]:\n        if expr_id not in self.expr_info:\n            return None\n        value = self.expr_info[expr_id][2]\n        return value if isinstance(value, Fraction) else None\n\n    def lower_expr(self, expr: Expr, owner: str, path: str,\n                   expected: Optional[str] = None) -> tuple[str, str, Optional[str], Any]:\n        expr_id = self._expr_id(owner, path)\n        if isinstance(expr, Literal):\n            value = expr.value\n            typ = expr.type_name\n            unit = expr.unit\n            display = expr.display\n            if isinstance(value, bool):\n                typ = typ or \"Bool\"\n                text = \"true\" if value else \"false\"\n                row = dict(id=expr_id, op=\"literal\", type=typ, context=None, args=[], rational=None,\n                           text=text, target=None, field_names=[])\n                return self._add_expr(expr_id, row, typ, None, value, expr, owner, path)\n            if isinstance(value, Fraction) or isinstance(value, (int, Decimal)):\n                q = _fraction(value)\n                if unit == \"per year\":\n                    typ = typ or \"Rate<annual_simple>\"\n                elif unit:\n                    if not re.fullmatch(r\"[A-Z]{3}\", unit):\n                        self.fail(\"UnsupportedUnit\", f\"unit {unit!r} is outside Core0.1\", owner)\n                    typ = typ or f\"Money<{unit}>\"\n                else:\n                    if expected and expected.startswith(\"Rate<\"):\n                        self.fail(\"MissingRateUnit\", \"annual rates require the explicit `per year` unit\", owner, \"rate\", expr)\n                    typ = typ or \"Real\"\n                if typ == \"Int\" and q.denominator != 1:\n                    self.fail(\"TypeMismatch\", \"fractional literal cannot have Int type\", owner, node=expr)\n                context = None\n                row = dict(id=expr_id, op=\"literal\", type=typ, context=context, args=[], rational=rational(q),\n                           text=None, target=None, field_names=[])\n                return self._add_expr(expr_id, row, typ, context, q, expr, owner, path)\n            if isinstance(value, str):\n                if value.startswith(\"@\"):\n                    _iso(value[1:], owner)\n                    typ = typ or \"Date\"\n                else:\n                    typ = typ or \"String\"\n                row = dict(id=expr_id, op=\"literal\", type=typ, context=None, args=[], rational=None,\n                           text=value, target=None, field_names=[])\n                return self._add_expr(expr_id, row, typ, None, value, expr, owner, path)\n            self.fail(\"UnsupportedLiteral\", f\"literal {type(value).__name__} is outside Core0.1\", owner, node=expr)\n        if isinstance(expr, External):\n            # External source references are admitted only by declaration-level\n            # handlers.  Keeping this operation explicit prevents accidental\n            # fixture or filesystem lookup from an arbitrary expression.\n            self.fail(\"UnsupportedExternalExpression\", \"external references are only valid in source/opening/report declarations\", owner, \"external\", expr)\n        if isinstance(expr, Ref):\n            if expr.name in self.lets and expr.name not in self.let_ids:\n                self._lower_let(expr.name)\n            typ, context, value = self._lookup_type(expr.name)\n            if expr.name in self.lets:\n                target = self.let_ids[expr.name]\n            else:\n                target = expr.name\n            row = dict(id=expr_id, op=\"ref\", type=typ, context=context, args=[], rational=None,\n                       text=None, target=target, field_names=[])\n            return self._add_expr(expr_id, row, typ, context, value, expr, owner, path)\n        if isinstance(expr, Call):\n            args = [self.lower_expr(a, owner, f\"{path}.arg{i}\") for i, a in enumerate(expr.args)]\n            if expr.name == \"value\":\n                if len(args) != 1 or not args[0][1].startswith(\"Observation<\"):\n                    self.fail(\"TypeMismatch\", \"value requires exactly one observation\", owner, node=expr)\n                typ = args[0][1][12:-1]\n                context = args[0][2]\n                target = \"builtin:value@1\"\n            elif expr.name == \"constant\":\n                if len(args) != 1 or not args[0][1].startswith(\"Rate<\"):\n                    self.fail(\"TypeMismatch\", \"constant requires one explicitly annual rate\", owner, node=expr)\n                typ = f\"Driver<{args[0][1]}>\"\n                context = args[0][2]\n                target = \"builtin:constant@1\"\n            else:\n                self.fail(\"UnsupportedExpression\", f\"call {expr.name!r} is not admitted in Core0.1\", owner,\n                          capability=f\"call:{expr.name}\", node=expr)\n            row = dict(id=expr_id, op=\"call\", type=typ, context=context,\n                       args=[a[0] for a in args], rational=None, text=None, target=target, field_names=[])\n            return self._add_expr(expr_id, row, typ, context, args[0][3] if args else None, expr, owner, path)\n        if isinstance(expr, Unary):\n            arg = self.lower_expr(expr.arg, owner, f\"{path}.arg0\")\n            if expr.op == \"not\":\n                if arg[1] != \"Bool\":\n                    self.fail(\"TypeMismatch\", \"not requires a Boolean operand\", owner, node=expr)\n                typ, value = \"Bool\", (not arg[3]) if isinstance(arg[3], bool) else None\n            elif expr.op == \"-\":\n                if not _numeric_type(arg[1]):\n                    self.fail(\"TypeMismatch\", \"negation requires a numeric operand\", owner, node=expr)\n                typ, value = arg[1], (-arg[3]) if isinstance(arg[3], Fraction) else None\n            else:\n                self.fail(\"UnsupportedExpression\", f\"unary operator {expr.op!r} is unsupported\", owner, node=expr)\n            row = dict(id=expr_id, op=\"not\" if expr.op == \"not\" else \"negate\", type=typ,\n                       context=arg[2], args=[arg[0]], rational=None, text=None, target=None, field_names=[])\n            return self._add_expr(expr_id, row, typ, arg[2], value, expr, owner, path)\n        if isinstance(expr, Binary):\n            left = self.lower_expr(expr.left, owner, f\"{path}.left\")\n            right = self.lower_expr(expr.right, owner, f\"{path}.right\")\n            op = expr.op\n            context = _merge_context(left[2], right[2], owner, self)\n            if op in {\"and\", \"or\"}:\n                if left[1] != right[1] or left[1] != \"Bool\":\n                    self.fail(\"TypeMismatch\", \"Boolean operands are required\", owner, node=expr)\n                typ, value = \"Bool\", _fold_bool(op, left[3], right[3])\n            elif op in {\"==\", \"!=\", \"<\", \"<=\", \">\", \">=\"}:\n                if left[1] != right[1]:\n                    self.fail(\"TypeMismatch\", \"comparison operands must have identical types\", owner, node=expr)\n                typ, value = \"Bool\", _compare(op, left[3], right[3])\n            elif op in {\"+\", \"-\"}:\n                if left[1] != right[1] or not _numeric_type(left[1]):\n                    self.fail(\"TypeMismatch\", \"addition/subtraction requires compatible numeric quantities\", owner, node=expr)\n                typ, value = left[1], _arithmetic(op, left[3], right[3])\n            elif op == \"*\":\n                if not _numeric_type(left[1]) or not _numeric_type(right[1]):\n                    self.fail(\"TypeMismatch\", \"multiplication requires numeric quantities\", owner, node=expr)\n                if _is_scalar(left[1]) and not _is_scalar(right[1]):\n                    typ = right[1]\n                elif _is_scalar(right[1]) and not _is_scalar(left[1]):\n                    typ = left[1]\n                elif _is_scalar(left[1]) and _is_scalar(right[1]):\n                    typ = \"Real\"\n                else:\n                    self.fail(\"UnsupportedOperation\", \"product of two dimensional quantities is outside Core0.1\", owner, \"multiply\", expr)\n                value = _arithmetic(op, left[3], right[3])\n            elif op == \"/\":\n                if not _numeric_type(left[1]) or not _numeric_type(right[1]):\n                    self.fail(\"TypeMismatch\", \"division requires numeric quantities\", owner, node=expr)\n                denominator = right[3]\n                if not isinstance(denominator, Fraction) or denominator == 0:\n                    self.fail(\"UnprovedNonzeroDenominator\", \"division denominator must be a nonzero constant\", owner, \"divide\", expr)\n                if not _is_scalar(right[1]):\n                    self.fail(\"UnsupportedOperation\", \"division by a dimensional quantity is outside Core0.1\", owner, \"divide\", expr)\n                typ = left[1] if not _is_scalar(left[1]) else \"Real\"\n                value = _arithmetic(op, left[3], right[3])\n            else:\n                self.fail(\"UnsupportedExpression\", f\"operator {op!r} is unsupported\", owner, capability=f\"operator:{op}\", node=expr)\n            row = dict(id=expr_id, op=_IR_OPS[op], type=typ, context=context,\n                       args=[left[0], right[0]], rational=None, text=None, target=None, field_names=[])\n            return self._add_expr(expr_id, row, typ, context, value, expr, owner, path)\n        if isinstance(expr, (ArrayExpr, RecordExpr)):\n            self.fail(\"UnsupportedExpression\", \"arrays and records are outside Core0.1\", owner,\n                      capability=type(expr).__name__, node=expr)\n        self.fail(\"UnsupportedExpression\", f\"unknown typed expression {type(expr).__name__}\", owner, node=expr)\n\n    def _lower_let(self, name: str) -> None:\n        if name in self.let_ids:\n            return\n        if name in self.lowering_lets:\n            self.fail(\"ExpressionCycle\", f\"cyclic let binding involving {name!r}\", name)\n        decl = self.lets.get(name)\n        if decl is None:\n            self.fail(\"UnknownReference\", f\"unknown let binding {name!r}\", name)\n        self.lowering_lets.add(name)\n        expr_id, typ, context, _ = self.lower_expr(decl.value, f\"let:{name}\", \"value\", decl.declared_type)\n        if decl.declared_type and decl.declared_type != typ:\n            self.fail(\"TypeMismatch\", f\"let {name!r} declares {decl.declared_type}, inferred {typ}\", name)\n        self.let_ids[name] = expr_id\n        self.lowering_lets.remove(name)\n\n    def _external(self, key: str, where: str) -> Any:\n        if key in {r.key for r in self.bindings.readings}:\n            return self.bindings.reading(key)\n        if key in {o.key for o in self.bindings.openings}:\n            return self.bindings.opening(key)\n        if key in {r.key for r in self.bindings.reports}:\n            return self.bindings.report(key)\n        self.fail(\"MissingExternalBinding\", f\"external export {key!r} is not supplied\", where)\n\n    def _lower_source_metadata(self) -> tuple[dict[str, str], dict[str, str], dict[str, str]]:\n        source_keys: dict[str, str] = {}\n        for name, decl in self.sources.items():\n            source_keys[name] = decl.external\n            self._external(decl.external, name)\n        return source_keys, {}, {}\n\n    def _build_evidence(self, source_keys: Mapping[str, str]) -> dict[str, tuple[str, str, str]]:\n        # Return source-key -> (document, span, view) IDs.\n        out: dict[str, tuple[str, str, str]] = {}\n        for key in sorted(set(source_keys.values())):\n            reading = self.bindings.reading(key)\n            _instant(reading.available, f\"reading:{key}.available\")\n            _instant(reading.ingested, f\"reading:{key}.ingested\")\n            _instant(reading.review_date, f\"reading:{key}.review_date\")\n            _instant(reading.cutoff, f\"reading:{key}.cutoff\")\n            _iso(reading.instant, f\"reading:{key}.instant\")\n            if reading.system_as_of is not None:\n                _instant(reading.system_as_of, f\"reading:{key}.system_as_of\")\n            document_id = f\"document:{_clean_id(key)}\"\n            span_id = f\"span:{_clean_id(key)}\"\n            reading_id = f\"reading:{_clean_id(key)}\"\n            review_id = f\"review:{_clean_id(key)}\"\n            view_id = f\"evidence:{_clean_id(key)}\"\n            self.ir[\"sourceSpans\"].append({\n                \"id\": span_id, \"document\": document_id, \"locator\": f\"binding:{key}\",\n                \"literal\": reading.literal, \"extraction\": reading.extraction,\n            })\n            self.ir[\"documents\"].append({\n                \"id\": document_id, \"sha256\": hashlib.sha256(reading.literal.encode(\"utf-8\")).hexdigest(),\n                \"uri\": reading.uri, \"filing_id\": reading.filing_id, \"available\": reading.available,\n                \"availability_policy\": \"explicit_binding_timestamp\", \"ingested\": reading.ingested,\n            })\n            self.ir[\"reviewDecisions\"].append({\n                \"id\": review_id, \"reading_ids\": [reading_id], \"action\": \"Accept\",\n                \"reviewer\": reading.reviewer, \"date\": reading.review_date,\n                \"reason\": reading.review_reason, \"evidence\": [span_id],\n                \"prior_view\": reading.prior_view, \"new_view\": view_id,\n                \"invalidated_descendants\": [],\n            })\n            self.ir[\"evidenceViews\"].append({\n                \"id\": view_id, \"cutoff\": reading.cutoff, \"system_as_of\": reading.system_as_of,\n                \"mode\": \"ExplicitSelection\", \"documents\": [document_id], \"observations\": [],\n                \"decisions\": [review_id], \"conflict_sets\": [], \"transforms\": [],\n            })\n            out[key] = (document_id, span_id, view_id)\n            # The reading object is a small external export represented by the\n            # binding.  It is referenced by observations but is not embedded as\n            # an executable package or expected-result fixture.\n            self._reading_ids[key] = reading_id\n        return out\n\n    def build(self) -> CompileResult:\n        self.collect()\n        source_keys, _, _ = self._lower_source_metadata()\n        self._reading_ids: dict[str, str] = {}\n        evidence = self._build_evidence(source_keys)\n        assert self.entity is not None and self.book is not None and self.package is not None\n        entity = self.entity\n        book = self.book\n        package = self.package\n        model_scope = self.scope_id\n        # Core declarations and package context.\n        self.ir[\"entities\"].append({\"id\": entity.name, \"functional_currency\": entity.currency})\n        self.ir[\"packages\"].append({\n            \"id\": package.id, \"version\": package.version, \"digest\": package.digest,\n            \"basis\": package.basis,\n            \"effective\": _time(\"interval\", package.effective_start, package.effective_end, self.bindings.calendar_id),\n            \"operations\": [f\"{package.id}/{x}\" for x in package.operations],\n            \"extension_points\": [], \"dependencies\": list(package.dependencies),\n            \"authority\": list(package.authority), \"review_status\": package.review_status,\n            \"implementation\": package.implementation,\n        })\n        self.ir[\"books\"].append({\"id\": book.name, \"entity\": book.entity, \"basis\": package.id,\n                                  \"package\": package.id, \"currency\": entity.currency})\n        for account in self.accounts.values():\n            if account.book != book.name:\n                self.fail(\"BindingMismatch\", \"all accounts must belong to the declared book\", account.name)\n            if account.role not in {\"Asset\", \"Liability\", \"Expense\", \"Equity\"}:\n                self.fail(\"UnsupportedAccountRole\", f\"account role {account.role!r} is outside profile\", account.name)\n            self.ir[\"accounts\"].append({\"id\": account.name, \"book\": account.book,\n                                         \"role\": account.role, \"report_concept\": account.name})\n        # Time/context and observations.\n        observation_contexts: dict[str, str] = {}\n        for obs in self.observations.values():\n            if not obs.type_name.startswith(\"Money<\"):\n                self.fail(\"UnsupportedObservationType\", \"Core0.1 observations are monetary\", obs.name)\n            currency = obs.type_name[6:-1]\n            if currency != entity.currency:\n                self.fail(\"ContextMismatch\", \"observation currency must match the entity currency\", obs.name)\n            key = source_keys.get(obs.source)\n            if key is None:\n                self.fail(\"UnknownReference\", f\"observation source {obs.source!r} is not a source alias\", obs.name)\n            reading = self.bindings.reading(key)\n            if _fraction(_literal_value(obs.value, obs.name)) != reading.amount:\n                self.fail(\"SourceReadingMismatch\", \"surface observation and bound reading disagree\", obs.name)\n            if reading.currency != currency or reading.instant != obs.instant:\n                self.fail(\"ReadingContextMismatch\", \"bound reading does not match observation context\", obs.name)\n            context_id = f\"context:{_clean_id(obs.name)}\"\n            observation_contexts[obs.name] = context_id\n            self.ir[\"contexts\"].append({\n                \"id\": context_id, \"entity\": entity.name, \"perimeter\": self.bindings.entity_perimeter,\n                \"concept\": \"debt_principal\", \"basis\": package.id, \"measurement\": \"principal\",\n                \"time\": _time(\"instant\", obs.instant, None, self.bindings.calendar_id),\n                \"unit\": currency, \"currency\": currency, \"taxonomy_version\": None, \"dimensions\": [],\n            })\n            document_id, span_id, view_id = evidence[key]\n            reading_id = self._reading_ids[key]\n            review_id = f\"review:{_clean_id(key)}\"\n            self.ir[\"observations\"].append({\n                \"id\": obs.name, \"context\": context_id, \"domain\": {\n                    \"kind\": \"exact\", \"lower\": rational(reading.amount), \"upper\": rational(reading.amount),\n                    \"lower_closed\": True, \"upper_closed\": True, \"values\": [], \"missing_reason\": None,\n                    \"display\": obs.value.display or f\"{reading.amount} {currency}\",\n                    \"rounding_rule\": \"exact_binding\",\n                }, \"source_spans\": [span_id], \"reading\": reading_id,\n                \"review_decision\": review_id, \"supersedes\": [], \"revision_group\": f\"binding-{_clean_id(key)}\",\n            })\n            for view in self.ir[\"evidenceViews\"]:\n                if view[\"id\"] == view_id:\n                    view[\"observations\"].append(obs.name)\n        # Symbols and declarations.\n        for symbol in self.symbols.values():\n            if symbol.type_name != \"Real\":\n                self.fail(\"UnsupportedSymbol\", \"Core0.1 admits one Real interval symbol\", symbol.name)\n            low = self.lower_expr(symbol.lower, f\"symbol:{symbol.name}\", \"lower\", \"Real\")\n            high = self.lower_expr(symbol.upper, f\"symbol:{symbol.name}\", \"upper\", \"Real\")\n            if low[3] is None or high[3] is None or low[3] > high[3]:\n                self.fail(\"InvalidDomain\", \"symbol bounds must be ordered constants\", symbol.name)\n            source_key = next(iter(source_keys.values()))\n            span_id = evidence[source_key][1]\n            self.ir[\"symbols\"].append({\n                \"id\": symbol.name, \"type\": symbol.type_name, \"context\": None,\n                \"domain\": {\"kind\": \"interval\", \"lower\": rational(low[3]), \"upper\": rational(high[3]),\n                            \"lower_closed\": True, \"upper_closed\": True, \"values\": [],\n                            \"missing_reason\": None, \"display\": None, \"rounding_rule\": None},\n                \"uncertainty_kind\": self.bindings.symbol_uncertainty, \"scope\": self.model_id,\n                \"dependencies\": [], \"admission\": f\"review:{_clean_id(source_key)}\", \"provenance\": [span_id],\n            })\n        for name in self.lets:\n            self._lower_let(name)\n        # Contract, alternatives, and scenario expressions.\n        contract = next(iter(self.contracts.values()))\n        fields = dict(contract.fields)\n        required_fields = {\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"}\n        if set(fields) != required_fields:\n            self.fail(\"ContractFields\", \"DebtMix requires principal, fraction and two rates\", contract.name)\n        field_rows = []\n        for name in (\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"):\n            expected = {\"principal\": f\"Money<{entity.currency}>\", \"fixed_fraction\": \"Real\",\n                        \"fixed_rate\": \"Rate<annual_simple>\", \"initial_floating_rate\": \"Rate<annual_simple>\"}[name]\n            info = self.lower_expr(fields[name], f\"contract:{contract.name}\", f\"field:{name}\", expected)\n            if info[1] != expected:\n                self.fail(\"ContractType\", f\"field {name!r} has type {info[1]}, expected {expected}\", contract.name)\n            if name in {\"fixed_rate\", \"initial_floating_rate\"}:\n                self._assumption_row(f\"contract:{contract.name}:{name}\", info[0], contract.name, evidence)\n            field_rows.append({\"name\": name, \"expression\": info[0]})\n        self.ir[\"contracts\"].append({\"id\": contract.name, \"type\": f\"{package.id}/{contract.type_name}\",\n                                      \"book\": contract.book, \"fields\": field_rows, \"package\": package.id,\n                                      \"source_refs\": [evidence[next(iter(source_keys.values()))][1]]})\n        alt_ids = []\n        constraint_ids = []\n        for alt in self.alternatives.values():\n            alt_ids.append(alt.name)\n            alt_constraints = []\n            for index, assumption in enumerate(alt.assumptions):\n                eid = self.lower_expr(assumption, f\"alternative:{alt.name}\", f\"assumption:{index}\")[0]\n                cid = f\"constraint:{_clean_id(alt.name)}:{index}\"\n                self.ir[\"constraints\"].append({\"id\": cid, \"expression\": eid, \"kind\": \"assumption\",\n                                                \"scope\": alt.name, \"source_refs\": []})\n                alt_constraints.append(cid); constraint_ids.append(cid)\n                self._assumption_row(f\"alternative:{alt.name}\", eid, alt.name, evidence)\n            if not alt_constraints:\n                self.fail(\"MissingAlternativeCondition\", \"named alternatives require a Boolean condition\", alt.name)\n            self.ir[\"alternatives\"].append({\n                \"id\": alt.name, \"parent\": f\"history:{_clean_id(self.model_id)}\", \"scope\": model_scope,\n                \"author\": self.bindings.reading(next(iter(source_keys.values()))).reviewer,\n                \"created_at\": self.bindings.reading(next(iter(source_keys.values()))).review_date,\n                \"constraints\": alt_constraints, \"choice_group\": None,\n                \"reason\": \"Named conditional alternative supplied by the program\", \"evidence\": [evidence[next(iter(source_keys.values()))][1]],\n                \"opposing_evidence\": [],\n            })\n        scenario = next(iter(self.scenarios.values()))\n        settings = dict(scenario.settings)\n        if set(settings) != {\"market_rate\"}:\n            self.fail(\"ScenarioFields\", \"Core0.1 scenario requires one market_rate setting\", scenario.name)\n        driver = self.lower_expr(settings[\"market_rate\"], f\"scenario:{scenario.name}\", \"market_rate\")\n        if not driver[1].startswith(\"Driver<Rate<\"):\n            self.fail(\"ScenarioType\", \"market_rate must be a constant annual rate driver\", scenario.name)\n        self._assumption_row(f\"scenario:{scenario.name}\", driver[0], scenario.name, evidence)\n        self.ir[\"scenarios\"].append({\"id\": scenario.name, \"kind\": \"ExogenousStress\",\n                                      \"drivers\": [{\"name\": \"market_rate\", \"expression\": driver[0]}],\n                                      \"probability_model\": None, \"observed_event\": None, \"structural_model\": None,\n                                      \"replaced_equations\": [], \"visibility\": \"announced\"})\n        # Opening state and report mapping.\n        opening_decl = next(iter(self.openings.values()))\n        opening = self.bindings.opening(opening_decl.external)\n        if opening.book is not None and opening.book != opening_decl.book:\n            self.fail(\"OpeningStateMismatch\", \"opening binding belongs to another book\", opening_decl.name)\n        account_names = {a.name for a in self.accounts.values()}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '180,310p' scripts/core0_frontends_v1.py\"","aggregated_output":"    return (_expr(node.children[0], source, spans), _expr(node.children[1], source, spans))\n\n\ndef parse_program(source: str) -> FrontendProgram:\n    parser = Lark(GRAMMAR_PATH.read_text(encoding=\"utf-8\"), parser=\"lalr\",\n                  propagate_positions=True, maybe_placeholders=False)\n    tree = _node(parser.parse(source))\n    if not isinstance(tree, _Node) or tree.data != \"start\" or len(tree.children) < 2:\n        raise ValueError(\"module header is required\")\n    module, version = _text(tree.children[0]), _strip_string(_text(tree.children[1]), \"module version\")\n    spans: dict[int, dict[str, Any]] = {}\n    declarations: list[Any] = []\n    uses: list[UseDecl] = []\n    unsupported = {\"choice\", \"event\", \"rule\", \"require\", \"post\", \"setting\", \"parameters\"}\n    for item in tree.children[2:]:\n        if not isinstance(item, _Node):\n            raise ValueError(\"unexpected module token\")\n        d, c = item.data, item.children\n        try:\n            if d == \"use\":\n                uses.append(UseDecl(_text(c[0]), _strip_string(_text(c[1]), \"use version\")))\n            elif d == \"source\":\n                value = _expr(c[1], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"source requires external(string)\")\n                declarations.append(SourceDecl(_text(c[0]), value.key))\n            elif d == \"entity\":\n                declarations.append(EntityDecl(_text(c[0]), _text(c[1])))\n            elif d == \"book\":\n                declarations.append(BookDecl(_text(c[0]), _text(c[1]), _text(c[2]), _strip_string(_text(c[3]), \"book version\")))\n            elif d == \"account\":\n                declarations.append(AccountDecl(_text(c[0]), _text(c[1]), _text(c[2])))\n            elif d == \"opening\":\n                value = _expr(c[2], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"opening requires external(string)\")\n                declarations.append(OpeningDecl(_text(c[0]), _text(c[1]), value.key))\n            elif d == \"observation\":\n                typ = _type(c[1])\n                ts = c[2]\n                if not isinstance(ts, _Node) or ts.data != \"time_spec\":\n                    raise ValueError(\"observation time is required\")\n                if len(ts.children) == 1:\n                    instant = _text(ts.children[0]).lstrip(\"@\")\n                else:\n                    raise ValueError(\"period observations are outside Core0.1\")\n                value = _expr(c[3], source, spans)\n                declarations.append(ObservationDecl(_text(c[0]), typ, instant, value, _text(c[4])))\n            elif d == \"symbol\":\n                typ = _type(c[1]); bounds = _domain(c[2], source, spans)\n                if bounds is None:\n                    declarations.append(UnsupportedDecl(\"finite-domain\", _text(c[0])))\n                else:\n                    declarations.append(SymbolDecl(_text(c[0]), typ, bounds[0], bounds[1],\n                                                   _strip_string(_text(c[3]), \"symbol reason\")))\n            elif d == \"binding\":\n                name = _text(c[0]); idx = 1; declared = None\n                if isinstance(c[idx], _Node) and c[idx].data == \"type\":\n                    declared = _type(c[idx]); idx += 1\n                declarations.append(LetDecl(name, _expr(c[idx], source, spans), declared))\n            elif d == \"constraint\":\n                declarations.append(ConstraintDecl(_text(c[0]), _expr(c[1], source, spans)))\n            elif d == \"contract\":\n                fields = []\n                for field_node in c[3:]:\n                    if not isinstance(field_node, _Node) or field_node.data != \"field\":\n                        raise ValueError(\"invalid contract field\")\n                    fields.append((_text(field_node.children[0]), _expr(field_node.children[1], source, spans)))\n                declarations.append(ContractDecl(_text(c[0]), _text(c[1]), _text(c[2]), fields))\n            elif d == \"alternative\":\n                assumptions = []\n                for assumption in c[1:]:\n                    if not isinstance(assumption, _Node) or assumption.data != \"assumption\":\n                        raise ValueError(\"invalid alternative assumption\")\n                    assumptions.append(_expr(assumption.children[0], source, spans))\n                declarations.append(AlternativeDecl(_text(c[0]), assumptions))\n            elif d == \"scenario\":\n                settings = []\n                for setting in c[1:]:\n                    if not isinstance(setting, _Node) or setting.data != \"setting\":\n                        raise ValueError(\"invalid scenario setting\")\n                    settings.append((_text(setting.children[0]), _expr(setting.children[1], source, spans)))\n                declarations.append(ScenarioDecl(_text(c[0]), settings))\n            elif d == \"report\":\n                fields = [x for x in c[2:] if isinstance(x, _Node) and x.data == \"field\"]\n                mappings = [x for x in fields if _text(x.children[0]) == \"mapping\"]\n                if len(mappings) != 1:\n                    raise ValueError(\"report requires one mapping field\")\n                mapping = _expr(mappings[0].children[1], source, spans)\n                declarations.append(ReportDecl(_text(c[0]), _text(c[1]), mapping))\n            elif d in unsupported:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n            else:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n        except (IndexError, TypeError, ValueError) as exc:\n            raise ValueError(f\"invalid {d} declaration at {item.start}: {exc}\") from exc\n    return FrontendProgram(Program(module, version, declarations, uses), spans)\n\n\ndef compile_source(source: str, bindings: CompileBindings):\n    \"\"\"Parse and lower a source program through the shared compiler.\"\"\"\n    try:\n        parsed = parse_program(source)\n    except UnexpectedInput as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        start = getattr(exc, \"pos_in_stream\", None)\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\",\n                                               span=(start, start) if start is not None else None),), {})\n    except ValueError as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\"),), {})\n    return compile_program(parsed.program, bindings, source_spans=parsed.source_spans, input_text=source)\n\n\n__all__ = [\"FrontendProgram\", \"compile_source\", \"parse_program\"]\n","exit_code":0,"status":"completed"}}
