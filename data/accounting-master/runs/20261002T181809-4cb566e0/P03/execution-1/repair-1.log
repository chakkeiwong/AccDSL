{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '1370,1665p' scripts/core0_ir_v1.py\"","aggregated_output":"def _ref(nodes: Mapping[str, tuple[str, Mapping[str, Any]]], identifier: str,\n         sections: Optional[set[str]], where: str) -> Optional[Diagnostic]:\n    if identifier not in nodes:\n        return _invalid(\"UnknownReference\", f\"unknown reference {identifier!r}\", where)\n    if sections and nodes[identifier][0] not in sections:\n        return _invalid(\"ReferenceKind\", f\"{identifier!r} has kind {nodes[identifier][0]}, expected {sorted(sections)}\", where)\n    return None\n\n\nclass _IRTypeChecker:\n    def __init__(self, ir: Mapping[str, Any], nodes: Mapping[str, tuple[str, Mapping[str, Any]]]):\n        self.ir, self.nodes = ir, nodes\n        self.memo: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.active: set[str] = set()\n\n    def expr(self, identifier: str) -> tuple[str, Optional[str], Any]:\n        if identifier in self.memo:\n            return self.memo[identifier]\n        if identifier in self.active:\n            raise _Failure(Diagnostic(\"ExpressionCycle\", \"cyclic expression dependency\", identifier))\n        if identifier not in self.nodes or self.nodes[identifier][0] != \"expressions\":\n            raise _Failure(Diagnostic(\"UnknownReference\", f\"expression {identifier!r} is not declared\", identifier))\n        self.active.add(identifier)\n        e = self.nodes[identifier][1]\n        op, target = e[\"op\"], e[\"target\"]\n        args = [self.expr(a) for a in e[\"args\"]]\n        types = [a[0] for a in args]\n        if op == \"literal\":\n            if e[\"rational\"] is not None:\n                value = parse_rational(e[\"rational\"])\n            elif e[\"text\"] is not None:\n                value = e[\"text\"]\n            else:\n                raise _Failure(Diagnostic(\"ExpressionPayload\", \"literal has no payload\", identifier))\n            result, context = e[\"type\"], e[\"context\"]\n        elif op == \"ref\":\n            if target not in self.nodes:\n                raise _Failure(Diagnostic(\"UnknownReference\", f\"reference {target!r} is not declared\", identifier))\n            section, row = self.nodes[target]\n            if section == \"expressions\":\n                result, context, value = self.expr(target)\n            elif section == \"symbols\":\n                result, context, value = row[\"type\"], row[\"context\"], None\n            elif section == \"observations\":\n                ctx = self.nodes[row[\"context\"]][1]\n                result, context, value = f\"Observation<Money<{ctx['currency']}>>\", row[\"context\"], None\n            else:\n                raise _Failure(Diagnostic(\"ReferenceKind\", f\"cannot reference {section} from expression\", identifier))\n            value = None\n        elif op == \"call\":\n            if target == \"builtin:value@1\":\n                if len(args) != 1 or not types[0].startswith(\"Observation<\"):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"value requires one observation\", identifier))\n                result, context = types[0][12:-1], args[0][1]\n                value = args[0][2]\n            elif target == \"builtin:constant@1\":\n                if len(args) != 1 or not types[0].startswith(\"Rate<\"):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"constant requires one annual rate\", identifier))\n                result, context, value = f\"Driver<{types[0]}>\", args[0][1], args[0][2]\n            else:\n                raise _Failure(Diagnostic(\"UnsupportedExpression\", \"unknown builtin call\", identifier))\n        else:\n            arity = 1 if op in {\"negate\", \"not\"} else 2\n            if len(args) != arity:\n                raise _Failure(Diagnostic(\"ArityMismatch\", \"wrong expression arity\", identifier))\n            if op in {\"not\", \"and\", \"or\"}:\n                if any(t != \"Bool\" for t in types):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"Boolean operands required\", identifier))\n                result, context = \"Bool\", None\n                value = None\n            elif op in {\"eq\", \"ne\", \"lt\", \"le\", \"gt\", \"ge\"}:\n                if types[0] != types[1]:\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"comparison types differ\", identifier))\n                result, context, value = \"Bool\", None, None\n            elif op in {\"add\", \"subtract\"}:\n                if types[0] != types[1] or not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"compatible numeric operands required\", identifier))\n                result, context, value = types[0], args[0][1] or args[1][1], None\n            elif op == \"negate\":\n                if not _numeric_type(types[0]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"numeric operand required\", identifier))\n                result, context, value = types[0], args[0][1], None\n            elif op in {\"multiply\", \"divide\"}:\n                if not _numeric_type(types[0]) or not _numeric_type(types[1]):\n                    raise _Failure(Diagnostic(\"TypeMismatch\", \"numeric operands required\", identifier))\n                if op == \"divide\" and not _is_scalar(types[1]):\n                    raise _Failure(Diagnostic(\"UnsupportedOperation\", \"divisor must be scalar\", identifier))\n                if op == \"divide\" and not isinstance(args[1][2], Fraction):\n                    raise _Failure(Diagnostic(\"UnprovedNonzeroDenominator\", \"divisor must be constant\", identifier))\n                if op == \"divide\" and args[1][2] == 0:\n                    raise _Failure(Diagnostic(\"UnprovedNonzeroDenominator\", \"divisor is zero\", identifier))\n                result = types[0] if not _is_scalar(types[0]) else (types[1] if op == \"multiply\" else \"Real\")\n                context, value = args[0][1] or args[1][1], None\n            else:\n                raise _Failure(Diagnostic(\"UnsupportedExpression\", f\"operator {op!r} unsupported\", identifier))\n        declared = (e[\"type\"], e[\"context\"])\n        if declared != (result, context):\n            raise _Failure(Diagnostic(\"TypeMismatch\", f\"declared {declared}, inferred {(result, context)}\", identifier))\n        self.active.remove(identifier)\n        self.memo[identifier] = (result, context, value)\n        return self.memo[identifier]\n\n\ndef validate_ir(ir: Mapping[str, Any], bindings: CompileBindings,\n                *, schema: Optional[Mapping[str, Any]] = None) -> ValidationResult:\n    \"\"\"Validate closed-schema shape and independent Core0.1 semantics.\"\"\"\n    diagnostics: list[Diagnostic] = []\n    if not isinstance(ir, Mapping):\n        return ValidationResult(False, (_invalid(\"StructuralError\", \"IR must be a mapping\", \"ir\"),))\n    schema = schema or _load_schema()\n    if jsonschema is None:\n        return ValidationResult(False, (_invalid(\"MissingDependency\", \"jsonschema is required for closed-schema validation\", \"validator\"),))\n    try:\n        jsonschema.Draft202012Validator(schema).validate(ir)\n    except jsonschema.ValidationError as exc:\n        return ValidationResult(False, (_invalid(\"StructuralError\", exc.message, \"/\".join(map(str, exc.path))),))\n    nodes, duplicate = _nodes(ir)\n    if duplicate:\n        return ValidationResult(False, (duplicate,))\n    try:\n        packages = {p.id: p for p in bindings.packages}\n        package_rows = {r[\"id\"]: r for r in ir[\"packages\"]}\n        if set(package_rows) != set(packages):\n            raise _Failure(Diagnostic(\"PackageBinding\", \"IR package lock differs from supplied package bindings\", \"packages\"))\n        for pid, package in packages.items():\n            row = package_rows[pid]\n            if row[\"digest\"] != package.digest or row[\"basis\"] != package.basis:\n                raise _Failure(Diagnostic(\"PackageDigestMismatch\", \"package digest/basis differs from binding\", pid))\n            if row[\"operations\"] != [f\"{pid}/{x}\" for x in package.operations]:\n                raise _Failure(Diagnostic(\"PackageBinding\", \"package operation lock differs from binding\", pid))\n        entities = {r[\"id\"]: r for r in ir[\"entities\"]}\n        books = {r[\"id\"]: r for r in ir[\"books\"]}\n        if len(entities) != 1 or len(books) != 1:\n            raise _Failure(Diagnostic(\"ProfileCardinality\", \"one entity and book are required\", \"profile\"))\n        for row in ir[\"contexts\"]:\n            if (err := _ref(nodes, row[\"entity\"], {\"entities\"}, row[\"id\"])):\n                raise _Failure(err)\n            _time(\"instant\" if row[\"time\"][\"kind\"] == \"instant\" else \"interval\", row[\"time\"][\"start\"], row[\"time\"][\"end_exclusive\"], row[\"time\"][\"calendar\"])\n        for row in ir[\"sourceSpans\"]:\n            if (err := _ref(nodes, row[\"document\"], {\"documents\"}, row[\"id\"])):\n                raise _Failure(err)\n        for row in ir[\"documents\"]:\n            _instant(row[\"available\"], row[\"id\"]); _instant(row[\"ingested\"], row[\"id\"])\n        for row in ir[\"observations\"]:\n            if (err := _ref(nodes, row[\"context\"], {\"contexts\"}, row[\"id\"])):\n                raise _Failure(err)\n            for rid in row[\"source_spans\"]:\n                if (err := _ref(nodes, rid, {\"sourceSpans\"}, row[\"id\"])):\n                    raise _Failure(err)\n            reading_key = next((r.key for r in bindings.readings if f\"reading:{_clean_id(r.key)}\" == row[\"reading\"]), None)\n            if reading_key is None:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"observation reading is not bound\", row[\"id\"]))\n            reading = bindings.reading(reading_key)\n            if row[\"domain\"][\"lower\"] != rational(reading.amount) or row[\"domain\"][\"upper\"] != rational(reading.amount):\n                raise _Failure(Diagnostic(\"SourceReadingMismatch\", \"observation domain differs from bound reading\", row[\"id\"]))\n            document_id = f\"document:{_clean_id(reading.key)}\"\n            span = next((s for s in ir[\"sourceSpans\"] if s[\"id\"] in row[\"source_spans\"]), None)\n            if span is None or span[\"literal\"] != reading.literal:\n                raise _Failure(Diagnostic(\"SourceLiteralMismatch\", \"source span literal differs from binding\", row[\"id\"]))\n            doc = next((d for d in ir[\"documents\"] if d[\"id\"] == document_id), None)\n            if doc is None or doc[\"sha256\"] != hashlib.sha256(reading.literal.encode()).hexdigest():\n                raise _Failure(Diagnostic(\"SourceDigestMismatch\", \"document digest differs from binding\", row[\"id\"]))\n        for row in ir[\"books\"]:\n            if row[\"package\"] not in package_rows:\n                raise _Failure(Diagnostic(\"PackageBinding\", \"book package is not locked\", row[\"id\"]))\n            if row[\"currency\"] != entities[row[\"entity\"]][\"functional_currency\"]:\n                raise _Failure(Diagnostic(\"ContextMismatch\", \"book currency differs from entity\", row[\"id\"]))\n        for row in ir[\"accounts\"]:\n            if (err := _ref(nodes, row[\"book\"], {\"books\"}, row[\"id\"])):\n                raise _Failure(err)\n        checker = _IRTypeChecker(ir, nodes)\n        for row in ir[\"expressions\"]:\n            checker.expr(row[\"id\"])\n        for row in ir[\"constraints\"]:\n            inferred = checker.expr(row[\"expression\"])\n            if inferred[0] != \"Bool\":\n                raise _Failure(Diagnostic(\"ConstraintType\", \"constraint expression must be Boolean\", row[\"id\"]))\n        for row in ir[\"contracts\"]:\n            if row[\"book\"] not in books:\n                raise _Failure(Diagnostic(\"UnknownReference\", \"contract book is unknown\", row[\"id\"]))\n            fields = {f[\"name\"]: f[\"expression\"] for f in row[\"fields\"]}\n            if set(fields) != {\"principal\", \"fixed_fraction\", \"fixed_rate\", \"initial_floating_rate\"}:\n                raise _Failure(Diagnostic(\"ContractFields\", \"contract fields are incomplete or duplicated\", row[\"id\"]))\n            expected = {\"principal\": f\"Money<{books[row['book']]['currency']}>\", \"fixed_fraction\": \"Real\",\n                        \"fixed_rate\": \"Rate<annual_simple>\", \"initial_floating_rate\": \"Rate<annual_simple>\"}\n            for name, typ in expected.items():\n                if checker.expr(fields[name])[0] != typ:\n                    raise _Failure(Diagnostic(\"ContractType\", f\"{name} has the wrong type\", row[\"id\"]))\n        for row in ir[\"states\"]:\n            total = Fraction(0); seen = set()\n            for balance in row[\"balances\"]:\n                if balance[\"account\"] in seen:\n                    raise _Failure(Diagnostic(\"DuplicateBalance\", \"opening account occurs twice\", row[\"id\"]))\n                seen.add(balance[\"account\"]); total += parse_rational(balance[\"signed_amount\"])\n            if total != 0:\n                raise _Failure(Diagnostic(\"UnbalancedState\", \"opening balances do not sum to zero\", row[\"id\"]))\n            expected_accounts = {a[\"id\"] for a in ir[\"accounts\"] if a[\"book\"] == row[\"book\"]}\n            if seen != expected_accounts:\n                raise _Failure(Diagnostic(\"IncompleteState\", \"opening state must include every account\", row[\"id\"]))\n        for row in ir[\"historyFamilies\"]:\n            if row[\"feasibility\"] == \"Feasible\" and not row[\"witnesses\"]:\n                raise _Failure(Diagnostic(\"MissingWitness\", \"feasible family requires a witness\", row[\"id\"]))\n            if row[\"coverage\"] == \"ExactWithinScope\" and (row[\"unresolved_cells\"] or not row[\"completed_cells\"]):\n                raise _Failure(Diagnostic(\"FalseCoverage\", \"exact coverage requires completed cells and no unresolved cells\", row[\"id\"]))\n            if row[\"coverage\"] != \"PartialSearch\" or row[\"feasibility\"] != \"Unknown\" or row[\"completed_cells\"] != 0 or row[\"unresolved_cells\"] != 1:\n                raise _Failure(Diagnostic(\"CoverageClaim\", \"Core0.1 family must remain explicitly unsearched\", row[\"id\"]))\n        for row in ir[\"reportMappings\"]:\n            if not row[\"rows\"] or row[\"rows\"][0][\"expression\"] not in checker.memo:\n                raise _Failure(Diagnostic(\"ReportMapping\", \"report mapping expression is not compiled\", row[\"id\"]))\n        if not ir[\"diagnostics\"]:\n            pass\n    except _Failure as exc:\n        return ValidationResult(False, (exc.diagnostic,))\n    return ValidationResult(True, ())\n\n\n@dataclass(frozen=True)\nclass _Symbolic:\n    name: str\n\n\ndef evaluate_expression(ir: Mapping[str, Any], identifier: str,\n                        symbols: Mapping[str, Fraction | int | str] | None = None) -> Any:\n    \"\"\"Evaluate exact supported expressions for a supplied symbol assignment.\"\"\"\n    nodes = {e[\"id\"]: e for e in ir.get(\"expressions\", [])}\n    symbol_values = {k: _fraction(v) for k, v in (symbols or {}).items()}\n    observations = {o[\"id\"]: o for o in ir.get(\"observations\", [])}\n    contexts = {c[\"id\"]: c for c in ir.get(\"contexts\", [])}\n    seen: set[str] = set()\n\n    def go(eid: str) -> Any:\n        if eid in seen:\n            raise ValueError(f\"expression cycle at {eid}\")\n        if eid not in nodes:\n            raise KeyError(eid)\n        e = nodes[eid]; op = e[\"op\"]\n        if op == \"literal\":\n            if e[\"rational\"] is not None:\n                return parse_rational(e[\"rational\"])\n            if e[\"type\"] == \"Bool\":\n                return e[\"text\"] == \"true\"\n            return e[\"text\"]\n        seen.add(eid)\n        try:\n            if op == \"ref\":\n                target = e[\"target\"]\n                if target in nodes:\n                    return go(target)\n                if target in symbol_values:\n                    return symbol_values[target]\n                if target in observations:\n                    return parse_rational(observations[target][\"domain\"][\"lower\"])\n                return _Symbolic(target)\n            if op == \"call\":\n                value = go(e[\"args\"][0])\n                return value\n            args = [go(a) for a in e[\"args\"]]\n            if any(isinstance(a, _Symbolic) for a in args):\n                return _Symbolic(eid)\n            if op == \"add\": return args[0] + args[1]\n            if op == \"subtract\": return args[0] - args[1]\n            if op == \"multiply\": return args[0] * args[1]\n            if op == \"divide\": return args[0] / args[1]\n            if op == \"negate\": return -args[0]\n            if op == \"not\": return not args[0]\n            if op == \"and\": return args[0] and args[1]\n            if op == \"or\": return args[0] or args[1]\n            return {\"eq\": args[0] == args[1], \"ne\": args[0] != args[1], \"lt\": args[0] < args[1],\n                    \"le\": args[0] <= args[1], \"gt\": args[0] > args[1], \"ge\": args[0] >= args[1]}[op]\n        finally:\n            seen.remove(eid)\n    return go(identifier)\n\n\ndef semantic_projection(ir: Mapping[str, Any] | None) -> Optional[dict[str, Any]]:\n    if ir is None:\n        return None\n    # Source offsets live in CompileResult.source_map.  IR itself retains\n    # source context, package locks, assumptions, alternatives and bindings.\n    projected = copy.deepcopy(dict(ir))\n    projected.pop(\"diagnostics\", None)\n    return projected\n\n\n__all__ = [\n    \"AccountDecl\", \"AlternativeDecl\", \"ArrayExpr\", \"AssumptionBinding\", \"Binary\", \"BookDecl\",\n    \"Call\", \"CompileBindings\", \"CompileResult\", \"ConstraintDecl\", \"ContractDecl\", \"Diagnostic\",\n    \"EntityDecl\", \"Expr\", \"External\", \"LetDecl\", \"Literal\", \"OpeningBinding\", \"OpeningDecl\",\n    \"ObservationDecl\", \"PackageBinding\", \"Program\", \"RecordExpr\", \"Ref\", \"ReportBinding\",\n    \"ReportDecl\", \"ScenarioDecl\", \"SourceDecl\", \"SymbolDecl\", \"Unary\", \"UnsupportedDecl\", \"UseDecl\",\n    \"ValidationResult\", \"compile_program\", \"evaluate_expression\", \"rational\", \"semantic_projection\",\n    \"validate_ir\",\n]\n","exit_code":0,"status":"completed"}}
