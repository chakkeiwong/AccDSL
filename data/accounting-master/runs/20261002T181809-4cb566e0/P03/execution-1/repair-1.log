{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' scripts/core0_ir_v1.py\"","aggregated_output":"\"\"\"Core 0.1 source-independent typed IR and bounded lowering profile.\n\nThe module deliberately implements a small, explicit profile.  It does not\nload an authored expected IR and it does not infer missing evidence, review,\npackage, or accounting metadata.  Callers provide those facts through\n``CompileBindings``.  ``core0_frontends_v1`` supplies the textual parser; this\nmodule is also the typed-library entrypoint.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom datetime import date, datetime, timezone\nfrom decimal import Decimal, InvalidOperation\nfrom fractions import Fraction\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nfrom types import MappingProxyType\nfrom typing import Any, Iterable, Mapping, Optional, Sequence\n\ntry:  # The repository already uses jsonschema; no new dependency is added.\n    import jsonschema\nexcept Exception:  # pragma: no cover - reported by validation when absent.\n    jsonschema = None\n\n\nROOT = Path(__file__).resolve().parents[1]\nSCHEMA_PATH = ROOT / \"docs/design/spec/core-ir.schema.json\"\n\n\nclass _Failure(Exception):\n    def __init__(self, diagnostic: \"Diagnostic\"):\n        self.diagnostic = diagnostic\n        super().__init__(diagnostic.message)\n\n\n@dataclass(frozen=True)\nclass Diagnostic:\n    code: str\n    message: str\n    location: str = \"program\"\n    severity: str = \"error\"\n    capability: Optional[str] = None\n    span: Optional[tuple[int, int]] = None\n\n    def as_dict(self) -> dict[str, Any]:\n        return {\n            \"code\": self.code,\n            \"message\": self.message,\n            \"location\": self.location,\n            \"severity\": self.severity,\n            \"capability\": self.capability,\n            \"span\": list(self.span) if self.span is not None else None,\n        }\n\n\n@dataclass(frozen=True)\nclass CompileResult:\n    ir: Optional[dict[str, Any]]\n    diagnostics: tuple[Diagnostic, ...] = ()\n    source_map: Mapping[str, Mapping[str, Any]] = field(default_factory=dict)\n    input_sha256: Optional[str] = None\n\n    @property\n    def ok(self) -> bool:\n        return self.ir is not None and not self.diagnostics\n\n    @property\n    def semantic_projection(self) -> Optional[dict[str, Any]]:\n        return semantic_projection(self.ir) if self.ir is not None else None\n\n\n@dataclass(frozen=True)\nclass ValidationResult:\n    valid: bool\n    diagnostics: tuple[Diagnostic, ...] = ()\n\n    @property\n    def ok(self) -> bool:\n        return self.valid and not self.diagnostics\n\n\ndef _pairs(value: Mapping[str, Any] | Iterable[tuple[str, Any]] | None) -> tuple[tuple[str, Any], ...]:\n    if value is None:\n        return ()\n    if isinstance(value, Mapping):\n        return tuple((str(k), v) for k, v in value.items())\n    return tuple((str(k), v) for k, v in value)\n\n\ndef _tuple(value: Iterable[Any] | None) -> tuple[Any, ...]:\n    return tuple(value or ())\n\n\ndef _fraction(value: Fraction | int | str | Decimal) -> Fraction:\n    if isinstance(value, Fraction):\n        return value\n    if isinstance(value, int):\n        return Fraction(value, 1)\n    if isinstance(value, Decimal):\n        return Fraction(value)\n    if isinstance(value, str):\n        try:\n            return Fraction(Decimal(value))\n        except (InvalidOperation, ValueError, ZeroDivisionError) as exc:\n            raise ValueError(f\"invalid decimal literal {value!r}\") from exc\n    raise TypeError(f\"unsupported numeric value {type(value)!r}\")\n\n\ndef rational(value: Fraction | int | str | Decimal) -> dict[str, str]:\n    q = _fraction(value)\n    return {\"n\": str(q.numerator), \"d\": str(q.denominator)}\n\n\ndef parse_rational(value: Mapping[str, str]) -> Fraction:\n    try:\n        n, d = int(value[\"n\"]), int(value[\"d\"])\n    except (KeyError, TypeError, ValueError) as exc:\n        raise ValueError(\"invalid rational\") from exc\n    if d <= 0 or Fraction(n, d) != Fraction(n, d):\n        raise ValueError(\"invalid rational denominator\")\n    q = Fraction(n, d)\n    if (str(q.numerator), str(q.denominator)) != (str(n), str(d)):\n        raise ValueError(\"noncanonical rational\")\n    return q\n\n\ndef _clean_id(value: str) -> str:\n    value = re.sub(r\"[^A-Za-z0-9_.-]+\", \"_\", value)\n    return value.strip(\".\") or \"anonymous\"\n\n\ndef _iso(value: str, where: str) -> str:\n    try:\n        parsed = date.fromisoformat(value)\n    except ValueError as exc:\n        raise _Failure(Diagnostic(\"InvalidDate\", f\"{value!r} is not a Gregorian date\", where)) from exc\n    if parsed.isoformat() != value:\n        raise _Failure(Diagnostic(\"InvalidDate\", f\"use canonical YYYY-MM-DD for {value!r}\", where))\n    return value\n\n\ndef _instant(value: str, where: str) -> str:\n    try:\n        parsed = datetime.fromisoformat(value.replace(\"Z\", \"+00:00\"))\n    except ValueError as exc:\n        raise _Failure(Diagnostic(\"InvalidTimestamp\", f\"invalid timestamp {value!r}\", where)) from exc\n    if parsed.tzinfo is None:\n        raise _Failure(Diagnostic(\"MissingTimezone\", \"timestamps require an explicit timezone\", where))\n    return value\n\n\ndef _time(kind: str, start: str, end: Optional[str], calendar: str) -> dict[str, Any]:\n    _iso(start, \"time.start\")\n    if kind == \"interval\":\n        if end is None or date.fromisoformat(end) <= date.fromisoformat(start):\n            raise _Failure(Diagnostic(\"InvalidPeriod\", \"interval end must be after start\", \"time\"))\n        _iso(end, \"time.end_exclusive\")\n    elif end is not None:\n        raise _Failure(Diagnostic(\"InvalidPeriod\", \"instant cannot have an end\", \"time\"))\n    return {\"kind\": kind, \"start\": start, \"end_exclusive\": end, \"calendar\": calendar}\n\n\n# ---------------------------------------------------------------------------\n# Typed-library constructors\n\n\n@dataclass(frozen=True)\nclass Expr:\n    \"\"\"Marker class for typed expressions.\"\"\"\n\n\n@dataclass(frozen=True)\nclass Literal(Expr):\n    value: Any\n    type_name: Optional[str] = None\n    unit: Optional[str] = None\n    display: Optional[str] = None\n\n\n@dataclass(frozen=True)\nclass Ref(Expr):\n    name: str\n\n\n@dataclass(frozen=True)\nclass External(Expr):\n    key: str\n\n\n@dataclass(frozen=True)\nclass Call(Expr):\n    name: str\n    args: tuple[Expr, ...] = ()\n\n    def __init__(self, name: str, args: Sequence[Expr] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"args\", tuple(args))\n\n\n@dataclass(frozen=True)\nclass Binary(Expr):\n    op: str\n    left: Expr\n    right: Expr\n\n\n@dataclass(frozen=True)\nclass Unary(Expr):\n    op: str\n    arg: Expr\n\n\n@dataclass(frozen=True)\nclass ArrayExpr(Expr):\n    items: tuple[Expr, ...] = ()\n\n    def __init__(self, items: Sequence[Expr] = ()):\n        object.__setattr__(self, \"items\", tuple(items))\n\n\n@dataclass(frozen=True)\nclass RecordExpr(Expr):\n    fields: tuple[tuple[str, Expr], ...] = ()\n\n    def __init__(self, fields: Mapping[str, Expr] | Sequence[tuple[str, Expr]] = ()):\n        object.__setattr__(self, \"fields\", _pairs(fields))\n\n\n@dataclass(frozen=True)\nclass UseDecl:\n    name: str\n    version: str\n\n\n@dataclass(frozen=True)\nclass SourceDecl:\n    name: str\n    external: str\n\n\n@dataclass(frozen=True)\nclass EntityDecl:\n    name: str\n    currency: str\n\n\n@dataclass(frozen=True)\nclass BookDecl:\n    name: str\n    entity: str\n    basis: str\n    version: str\n\n\n@dataclass(frozen=True)\nclass AccountDecl:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' scripts/core0_frontends_v1.py\"","aggregated_output":"\"\"\"Textual Core 0.1 frontend.\n\nThe frontend retains token spelling and source positions while translating the\ngrammar into the typed constructors in :mod:`core0_ir_v1`.  It deliberately\ndoes not construct IR from a fixture or from a JSON schema.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nfrom typing import Any, Mapping, Optional\n\nfrom lark import Lark, Token, Tree, UnexpectedInput\n\ntry:  # Support both ``scripts.core0_frontends_v1`` and direct script imports.\n    from .core0_ir_v1 import (\n        AccountDecl, AlternativeDecl, ArrayExpr, Binary, BookDecl, Call, CompileBindings,\n        ConstraintDecl, ContractDecl, EntityDecl, External, Expr, LetDecl, Literal,\n        ObservationDecl, OpeningDecl, Program, RecordExpr, Ref, ReportDecl, ScenarioDecl,\n        SourceDecl, SymbolDecl, Unary, UnsupportedDecl, UseDecl, compile_program,\n    )\nexcept ImportError:  # pragma: no cover - used when scripts/ is sys.path[0].\n    from core0_ir_v1 import (\n        AccountDecl, AlternativeDecl, ArrayExpr, Binary, BookDecl, Call, CompileBindings,\n        ConstraintDecl, ContractDecl, EntityDecl, External, Expr, LetDecl, Literal,\n        ObservationDecl, OpeningDecl, Program, RecordExpr, Ref, ReportDecl, ScenarioDecl,\n        SourceDecl, SymbolDecl, Unary, UnsupportedDecl, UseDecl, compile_program,\n    )\n\n\nROOT = Path(__file__).resolve().parents[1]\nGRAMMAR_PATH = ROOT / \"docs/design/spec/core-0.lark\"\n\n\n@dataclass(frozen=True)\nclass _Node:\n    data: str\n    children: tuple[Any, ...]\n    start: int\n    end: int\n\n\n@dataclass(frozen=True)\nclass FrontendProgram:\n    program: Program\n    source_spans: Mapping[int, Mapping[str, Any]]\n\n\ndef _node(value: Any) -> Any:\n    if isinstance(value, Tree):\n        meta = value.meta\n        return _Node(value.data, tuple(_node(c) for c in value.children),\n                     int(getattr(meta, \"start_pos\", 0)), int(getattr(meta, \"end_pos\", 0)))\n    return value\n\n\ndef _text(value: Any) -> str:\n    return str(value)\n\n\ndef _strip_string(value: str, where: str) -> str:\n    try:\n        parsed = json.loads(value)\n    except (TypeError, json.JSONDecodeError) as exc:\n        raise ValueError(f\"invalid JSON string at {where}\") from exc\n    if not isinstance(parsed, str):\n        raise ValueError(f\"expected a string at {where}\")\n    return parsed\n\n\ndef _type(node: Any) -> str:\n    if not isinstance(node, _Node) or node.data != \"type\":\n        raise ValueError(\"expected type node\")\n    if not node.children:\n        raise ValueError(\"empty type\")\n    name = _text(node.children[0])\n    if len(node.children) == 1:\n        return name\n    return f\"{name}<{','.join(_type(c) for c in node.children[1:])}>\"\n\n\ndef _mark(expr: Expr, node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\n    spans[id(expr)] = {\"start\": node.start, \"end\": node.end,\n                       \"text\": source[node.start:node.end]}\n    return expr\n\n\ndef _operator_fold(node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\n    if not node.children:\n        raise ValueError(f\"empty {node.data}\")\n    current = _expr(node.children[0], source, spans)\n    i = 1\n    while i < len(node.children):\n        op = _text(node.children[i])\n        right = _expr(node.children[i + 1], source, spans)\n        current = _mark(Binary(op, current, right), node, source, spans)\n        i += 2\n    return current\n\n\ndef _expr(value: Any, source: str, spans: dict[int, dict[str, Any]]) -> Expr:\n    if isinstance(value, Token):\n        if value.type == \"NAME\":\n            return _mark(Ref(_text(value)), _Node(\"token\", (), value.start_pos, value.end_pos), source, spans)\n        if value.type == \"BOOL\":\n            node = _Node(\"bool\", (), value.start_pos, value.end_pos)\n            return _mark(Literal(_text(value) == \"true\", type_name=\"Bool\", display=_text(value)), node, source, spans)\n        if value.type == \"DATE\":\n            node = _Node(\"date\", (), value.start_pos, value.end_pos)\n            return _mark(Literal(_text(value), type_name=\"Date\", display=_text(value)), node, source, spans)\n        if value.type == \"STRING\":\n            node = _Node(\"string\", (), value.start_pos, value.end_pos)\n            return _mark(Literal(_strip_string(_text(value), \"string\"), type_name=\"String\", display=_text(value)), node, source, spans)\n        raise ValueError(f\"unexpected token {_text(value)!r}\")\n    if not isinstance(value, _Node):\n        raise ValueError(\"expected expression node\")\n    if value.data == \"number\":\n        if not value.children:\n            raise ValueError(\"empty number\")\n        spelling = _text(value.children[0])\n        try:\n            number = Fraction(spelling) if \".\" not in spelling else Fraction(spelling)\n        except ValueError as exc:\n            raise ValueError(f\"invalid number {spelling!r}\") from exc\n        raw = source[value.start:value.end].strip()\n        unit: Optional[str] = None\n        if re.search(r\"\\bper\\s+year\\s*$\", raw):\n            unit = \"per year\"\n        elif len(value.children) > 1:\n            unit = _text(value.children[1])\n        return _mark(Literal(number, unit=unit, display=raw), value, source, spans)\n    if value.data in {\"disjunction\", \"conjunction\", \"comparison\", \"sum\", \"product\"}:\n        return _operator_fold(value, source, spans)\n    if value.data == \"unary\":\n        if len(value.children) == 1:\n            return _expr(value.children[0], source, spans)\n        op, child = _text(value.children[0]), _expr(value.children[1], source, spans)\n        return _mark(Unary(op, child), value, source, spans)\n    if value.data == \"postfix\":\n        current = _expr(value.children[0], source, spans)\n        for child in value.children[1:]:\n            current = _mark(Call(\"field\", (current, Ref(_text(child)))), value, source, spans)\n        return current\n    if value.data == \"call\":\n        if not value.children:\n            raise ValueError(\"empty call\")\n        name = _text(value.children[0])\n        args = tuple(_expr(c, source, spans) for c in value.children[1:])\n        if name == \"external\":\n            if len(args) != 1 or not isinstance(args[0], Literal) or not isinstance(args[0].value, str):\n                raise ValueError(\"external requires one string literal\")\n            return _mark(External(args[0].value), value, source, spans)\n        return _mark(Call(name, args), value, source, spans)\n    if value.data == \"array\":\n        return _mark(ArrayExpr(tuple(_expr(c, source, spans) for c in value.children)), value, source, spans)\n    if value.data == \"record\":\n        fields: list[tuple[str, Expr]] = []\n        for child in value.children:\n            if not isinstance(child, _Node) or child.data != \"record_field\":\n                raise ValueError(\"invalid record field\")\n            fields.append((_text(child.children[0]), _expr(child.children[1], source, spans)))\n        return _mark(RecordExpr(fields), value, source, spans)\n    if value.data == \"record_field\":\n        raise ValueError(\"record field outside record\")\n    if value.data == \"atom\" and value.children:\n        return _expr(value.children[0], source, spans)\n    raise ValueError(f\"unsupported expression syntax {value.data!r}\")\n\n\ndef _domain(node: _Node, source: str, spans: dict[int, dict[str, Any]]) -> tuple[Expr, Expr] | None:\n    if node.data != \"domain\" or len(node.children) != 2:\n        return None\n    raw = source[node.start:node.end].lstrip()\n    if not raw.startswith(\"[\"):\n        return None  # finite choices are outside Core0.1\n    return (_expr(node.children[0], source, spans), _expr(node.children[1], source, spans))\n\n\ndef parse_program(source: str) -> FrontendProgram:\n    parser = Lark(GRAMMAR_PATH.read_text(encoding=\"utf-8\"), parser=\"lalr\",\n                  propagate_positions=True, maybe_placeholders=False)\n    tree = _node(parser.parse(source))\n    if not isinstance(tree, _Node) or tree.data != \"start\" or len(tree.children) < 2:\n        raise ValueError(\"module header is required\")\n    module, version = _text(tree.children[0]), _strip_string(_text(tree.children[1]), \"module version\")\n    spans: dict[int, dict[str, Any]] = {}\n    declarations: list[Any] = []\n    uses: list[UseDecl] = []\n    unsupported = {\"choice\", \"event\", \"rule\", \"require\", \"post\", \"setting\", \"parameters\"}\n    for item in tree.children[2:]:\n        if not isinstance(item, _Node):\n            raise ValueError(\"unexpected module token\")\n        d, c = item.data, item.children\n        try:\n            if d == \"use\":\n                uses.append(UseDecl(_text(c[0]), _strip_string(_text(c[1]), \"use version\")))\n            elif d == \"source\":\n                value = _expr(c[1], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"source requires external(string)\")\n                declarations.append(SourceDecl(_text(c[0]), value.key))\n            elif d == \"entity\":\n                declarations.append(EntityDecl(_text(c[0]), _text(c[1])))\n            elif d == \"book\":\n                declarations.append(BookDecl(_text(c[0]), _text(c[1]), _text(c[2]), _strip_string(_text(c[3]), \"book version\")))\n            elif d == \"account\":\n                declarations.append(AccountDecl(_text(c[0]), _text(c[1]), _text(c[2])))\n            elif d == \"opening\":\n                value = _expr(c[2], source, spans)\n                if not isinstance(value, External):\n                    raise ValueError(\"opening requires external(string)\")\n                declarations.append(OpeningDecl(_text(c[0]), _text(c[1]), value.key))\n            elif d == \"observation\":\n                typ = _type(c[1])\n                ts = c[2]\n                if not isinstance(ts, _Node) or ts.data != \"time_spec\":\n                    raise ValueError(\"observation time is required\")\n                if len(ts.children) == 1:\n                    instant = _text(ts.children[0]).lstrip(\"@\")\n                else:\n                    raise ValueError(\"period observations are outside Core0.1\")\n                value = _expr(c[3], source, spans)\n                declarations.append(ObservationDecl(_text(c[0]), typ, instant, value, _text(c[4])))\n            elif d == \"symbol\":\n                typ = _type(c[1]); bounds = _domain(c[2], source, spans)\n                if bounds is None:\n                    declarations.append(UnsupportedDecl(\"finite-domain\", _text(c[0])))\n                else:\n                    declarations.append(SymbolDecl(_text(c[0]), typ, bounds[0], bounds[1],\n                                                   _strip_string(_text(c[3]), \"symbol reason\")))\n            elif d == \"binding\":\n                name = _text(c[0]); idx = 1; declared = None\n                if isinstance(c[idx], _Node) and c[idx].data == \"type\":\n                    declared = _type(c[idx]); idx += 1\n                declarations.append(LetDecl(name, _expr(c[idx], source, spans), declared))\n            elif d == \"constraint\":\n                declarations.append(ConstraintDecl(_text(c[0]), _expr(c[1], source, spans)))\n            elif d == \"contract\":\n                fields = []\n                for field_node in c[3:]:\n                    if not isinstance(field_node, _Node) or field_node.data != \"field\":\n                        raise ValueError(\"invalid contract field\")\n                    fields.append((_text(field_node.children[0]), _expr(field_node.children[1], source, spans)))\n                declarations.append(ContractDecl(_text(c[0]), _text(c[1]), _text(c[2]), fields))\n            elif d == \"alternative\":\n                assumptions = []\n                for assumption in c[1:]:\n                    if not isinstance(assumption, _Node) or assumption.data != \"assumption\":\n                        raise ValueError(\"invalid alternative assumption\")\n                    assumptions.append(_expr(assumption.children[0], source, spans))\n                declarations.append(AlternativeDecl(_text(c[0]), assumptions))\n            elif d == \"scenario\":\n                settings = []\n                for setting in c[1:]:\n                    if not isinstance(setting, _Node) or setting.data != \"setting\":\n                        raise ValueError(\"invalid scenario setting\")\n                    settings.append((_text(setting.children[0]), _expr(setting.children[1], source, spans)))\n                declarations.append(ScenarioDecl(_text(c[0]), settings))\n            elif d == \"report\":\n                fields = [x for x in c[2:] if isinstance(x, _Node) and x.data == \"field\"]\n                mappings = [x for x in fields if _text(x.children[0]) == \"mapping\"]\n                if len(mappings) != 1:\n                    raise ValueError(\"report requires one mapping field\")\n                mapping = _expr(mappings[0].children[1], source, spans)\n                declarations.append(ReportDecl(_text(c[0]), _text(c[1]), mapping))\n            elif d in unsupported:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n            else:\n                declarations.append(UnsupportedDecl(d, _text(c[0]) if c else d))\n        except (IndexError, TypeError, ValueError) as exc:\n            raise ValueError(f\"invalid {d} declaration at {item.start}: {exc}\") from exc\n    return FrontendProgram(Program(module, version, declarations, uses), spans)\n\n\ndef compile_source(source: str, bindings: CompileBindings):\n    \"\"\"Parse and lower a source program through the shared compiler.\"\"\"\n    try:\n        parsed = parse_program(source)\n    except UnexpectedInput as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        start = getattr(exc, \"pos_in_stream\", None)\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\",\n                                               span=(start, start) if start is not None else None),), {})\n    except ValueError as exc:\n        try:\n            from .core0_ir_v1 import CompileResult, Diagnostic\n        except ImportError:  # pragma: no cover\n            from core0_ir_v1 import CompileResult, Diagnostic\n        return CompileResult(None, (Diagnostic(\"ParseError\", str(exc), \"source\"),), {})\n    return compile_program(parsed.program, bindings, source_spans=parsed.source_spans, input_text=source)\n\n\n__all__ = [\"FrontendProgram\", \"compile_source\", \"parse_program\"]\n","exit_code":0,"status":"completed"}}
