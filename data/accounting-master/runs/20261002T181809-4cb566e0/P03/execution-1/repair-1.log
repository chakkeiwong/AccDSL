{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,760p' scripts/core0_ir_v1.py\"","aggregated_output":"class AccountDecl:\n    name: str\n    role: str\n    book: str\n\n\n@dataclass(frozen=True)\nclass OpeningDecl:\n    name: str\n    book: str\n    external: str\n\n\n@dataclass(frozen=True)\nclass ObservationDecl:\n    name: str\n    type_name: str\n    instant: str\n    value: Expr\n    source: str\n\n\n@dataclass(frozen=True)\nclass SymbolDecl:\n    name: str\n    type_name: str\n    lower: Expr\n    upper: Expr\n    reason: str\n\n\n@dataclass(frozen=True)\nclass LetDecl:\n    name: str\n    value: Expr\n    declared_type: Optional[str] = None\n\n\n@dataclass(frozen=True)\nclass ConstraintDecl:\n    name: str\n    expression: Expr\n\n\n@dataclass(frozen=True)\nclass ContractDecl:\n    name: str\n    type_name: str\n    book: str\n    fields: tuple[tuple[str, Expr], ...] = ()\n\n    def __init__(self, name: str, type_name: str, book: str,\n                 fields: Mapping[str, Expr] | Sequence[tuple[str, Expr]] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"type_name\", type_name)\n        object.__setattr__(self, \"book\", book)\n        object.__setattr__(self, \"fields\", _pairs(fields))\n\n\n@dataclass(frozen=True)\nclass AlternativeDecl:\n    name: str\n    assumptions: tuple[Expr, ...] = ()\n\n    def __init__(self, name: str, assumptions: Sequence[Expr] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"assumptions\", tuple(assumptions))\n\n\n@dataclass(frozen=True)\nclass ScenarioDecl:\n    name: str\n    settings: tuple[tuple[str, Expr], ...] = ()\n\n    def __init__(self, name: str, settings: Mapping[str, Expr] | Sequence[tuple[str, Expr]] = ()):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"settings\", _pairs(settings))\n\n\n@dataclass(frozen=True)\nclass ReportDecl:\n    name: str\n    book: str\n    mapping: Expr\n\n\n@dataclass(frozen=True)\nclass UnsupportedDecl:\n    kind: str\n    name: str = \"\"\n\n\nDeclaration = (UseDecl | SourceDecl | EntityDecl | BookDecl | AccountDecl | OpeningDecl |\n               ObservationDecl | SymbolDecl | LetDecl | ConstraintDecl | ContractDecl |\n               AlternativeDecl | ScenarioDecl | ReportDecl | UnsupportedDecl)\n\n\n@dataclass(frozen=True)\nclass Program:\n    module: str\n    version: str\n    declarations: tuple[Declaration, ...] = ()\n    uses: tuple[UseDecl, ...] = ()\n\n    def __init__(self, module: str, version: str,\n                 declarations: Sequence[Declaration] = (), uses: Sequence[UseDecl] = ()):\n        if isinstance(declarations, Mapping) or isinstance(uses, Mapping):\n            raise TypeError(\"Program requires typed declarations, not an IR dictionary\")\n        object.__setattr__(self, \"module\", str(module))\n        object.__setattr__(self, \"version\", str(version))\n        object.__setattr__(self, \"declarations\", tuple(declarations))\n        object.__setattr__(self, \"uses\", tuple(uses))\n\n\n# ---------------------------------------------------------------------------\n# Explicit compiler bindings\n\n\n@dataclass(frozen=True)\nclass ReadingBinding:\n    key: str\n    literal: str\n    amount: Fraction | int | str\n    currency: str\n    instant: str\n    uri: str\n    filing_id: str\n    available: str\n    ingested: str\n    reviewer: str\n    review_date: str\n    review_reason: str\n    cutoff: str\n    system_as_of: Optional[str] = None\n    prior_view: str = \"fixture:empty-view\"\n    extraction: str = \"provided-binding\"\n\n    def __post_init__(self):\n        object.__setattr__(self, \"amount\", _fraction(self.amount))\n\n\n@dataclass(frozen=True)\nclass OpeningBinding:\n    key: str\n    date: str\n    balances: tuple[tuple[str, Fraction | int | str], ...]\n    book: Optional[str] = None\n    contracts: tuple[str, ...] = ()\n    dependencies: tuple[str, ...] = ()\n\n    def __init__(self, key: str, date: str,\n                 balances: Mapping[str, Fraction | int | str] | Sequence[tuple[str, Fraction | int | str]],\n                 book: Optional[str] = None, contracts: Sequence[str] = (),\n                 dependencies: Sequence[str] = ()):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"date\", date)\n        object.__setattr__(self, \"balances\", tuple((k, _fraction(v)) for k, v in _pairs(balances)))\n        object.__setattr__(self, \"book\", book)\n        object.__setattr__(self, \"contracts\", tuple(contracts))\n        object.__setattr__(self, \"dependencies\", tuple(dependencies))\n\n\n@dataclass(frozen=True)\nclass ReportBinding:\n    key: str\n    mapping: str\n    cash_flow_policy: str\n    closing_policy: str\n    required_operations: tuple[str, ...]\n\n    def __init__(self, key: str, mapping: str, cash_flow_policy: str,\n                 closing_policy: str, required_operations: Sequence[str]):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"mapping\", mapping)\n        object.__setattr__(self, \"cash_flow_policy\", cash_flow_policy)\n        object.__setattr__(self, \"closing_policy\", closing_policy)\n        object.__setattr__(self, \"required_operations\", tuple(required_operations))\n\n\n@dataclass(frozen=True)\nclass PackageBinding:\n    name: str\n    version: str\n    digest: str\n    basis: str\n    effective_start: str\n    effective_end: str\n    operations: tuple[str, ...]\n    dependencies: tuple[str, ...]\n    authority: tuple[str, ...]\n    review_status: str = \"illustrative\"\n    implementation: Optional[str] = None\n    contract_types: tuple[str, ...] = (\"DebtMix\",)\n\n    @property\n    def id(self) -> str:\n        return f\"{self.name}@{self.version}\"\n\n    def __init__(self, name: str, version: str, digest: str, basis: str,\n                 effective_start: str, effective_end: str,\n                 operations: Sequence[str], dependencies: Sequence[str],\n                 authority: Sequence[str], review_status: str = \"illustrative\",\n                 implementation: Optional[str] = None,\n                 contract_types: Sequence[str] = (\"DebtMix\",)):\n        object.__setattr__(self, \"name\", name)\n        object.__setattr__(self, \"version\", version)\n        object.__setattr__(self, \"digest\", digest)\n        object.__setattr__(self, \"basis\", basis)\n        object.__setattr__(self, \"effective_start\", effective_start)\n        object.__setattr__(self, \"effective_end\", effective_end)\n        object.__setattr__(self, \"operations\", tuple(operations))\n        object.__setattr__(self, \"dependencies\", tuple(dependencies))\n        object.__setattr__(self, \"authority\", tuple(authority))\n        object.__setattr__(self, \"review_status\", review_status)\n        object.__setattr__(self, \"implementation\", implementation)\n        object.__setattr__(self, \"contract_types\", tuple(contract_types))\n\n\n@dataclass(frozen=True)\nclass AssumptionBinding:\n    key: str\n    rationale: str\n    provenance: str = \"ScenarioDesign\"\n    role: str = \"Hypothesis\"\n    source_refs: tuple[str, ...] = ()\n    information_cutoff: Optional[str] = None\n    valid_start: Optional[str] = None\n    valid_end: Optional[str] = None\n\n    def __init__(self, key: str, rationale: str, provenance: str = \"ScenarioDesign\",\n                 role: str = \"Hypothesis\", source_refs: Sequence[str] = (),\n                 information_cutoff: Optional[str] = None,\n                 valid_start: Optional[str] = None, valid_end: Optional[str] = None):\n        object.__setattr__(self, \"key\", key)\n        object.__setattr__(self, \"rationale\", rationale)\n        object.__setattr__(self, \"provenance\", provenance)\n        object.__setattr__(self, \"role\", role)\n        object.__setattr__(self, \"source_refs\", tuple(source_refs))\n        object.__setattr__(self, \"information_cutoff\", information_cutoff)\n        object.__setattr__(self, \"valid_start\", valid_start)\n        object.__setattr__(self, \"valid_end\", valid_end)\n\n\n@dataclass(frozen=True)\nclass CompileBindings:\n    packages: tuple[PackageBinding, ...] = ()\n    readings: tuple[ReadingBinding, ...] = ()\n    openings: tuple[OpeningBinding, ...] = ()\n    reports: tuple[ReportBinding, ...] = ()\n    assumptions: tuple[AssumptionBinding, ...] = ()\n    calendar_id: str = \"DemoCalendar@1\"\n    calendar_name: str = \"Gregorian\"\n    horizon_start: str = \"2026-01-01\"\n    horizon_end: str = \"2027-01-01\"\n    symbol_uncertainty: str = \"HistoricalFact\"\n    entity_perimeter: str = \"Acme-only\"\n\n    def __init__(self, packages: Sequence[PackageBinding] = (), readings: Sequence[ReadingBinding] = (),\n                 openings: Sequence[OpeningBinding] = (), reports: Sequence[ReportBinding] = (),\n                 assumptions: Sequence[AssumptionBinding] = (), calendar_id: str = \"DemoCalendar@1\",\n                 calendar_name: str = \"Gregorian\", horizon_start: str = \"2026-01-01\",\n                 horizon_end: str = \"2027-01-01\", symbol_uncertainty: str = \"HistoricalFact\",\n                 entity_perimeter: str = \"Acme-only\"):\n        object.__setattr__(self, \"packages\", tuple(packages))\n        object.__setattr__(self, \"readings\", tuple(readings))\n        object.__setattr__(self, \"openings\", tuple(openings))\n        object.__setattr__(self, \"reports\", tuple(reports))\n        object.__setattr__(self, \"assumptions\", tuple(assumptions))\n        object.__setattr__(self, \"calendar_id\", calendar_id)\n        object.__setattr__(self, \"calendar_name\", calendar_name)\n        object.__setattr__(self, \"horizon_start\", horizon_start)\n        object.__setattr__(self, \"horizon_end\", horizon_end)\n        object.__setattr__(self, \"symbol_uncertainty\", symbol_uncertainty)\n        object.__setattr__(self, \"entity_perimeter\", entity_perimeter)\n\n    def package(self, name: str, version: Optional[str] = None) -> PackageBinding:\n        candidates = [p for p in self.packages if p.name == name and (version is None or p.version == version)]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingPackageBinding\", f\"package {name!r} is not uniquely bound\", name))\n        return candidates[0]\n\n    def reading(self, key: str) -> ReadingBinding:\n        candidates = [r for r in self.readings if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"reading {key!r} is not bound\", key))\n        return candidates[0]\n\n    def opening(self, key: str) -> OpeningBinding:\n        candidates = [r for r in self.openings if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"opening {key!r} is not bound\", key))\n        return candidates[0]\n\n    def report(self, key: str) -> ReportBinding:\n        candidates = [r for r in self.reports if r.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingExternalBinding\", f\"report mapping {key!r} is not bound\", key))\n        return candidates[0]\n\n    def assumption(self, key: str) -> AssumptionBinding:\n        candidates = [a for a in self.assumptions if a.key == key]\n        if len(candidates) != 1:\n            raise _Failure(Diagnostic(\"MissingAssumptionMetadata\", f\"assumption metadata {key!r} is not bound\", key))\n        return candidates[0]\n\n    @classmethod\n    def demo(cls, root: Path | str | None = None, principal: Fraction | int | str = 100,\n             stress_rate: Fraction | int | str = Fraction(7, 100),\n             fixed_rate: Fraction | int | str = Fraction(1, 20),\n             opening_balances: Mapping[str, Fraction | int | str] | None = None) -> \"CompileBindings\":\n        \"\"\"Create explicit synthetic bindings for the bounded demonstration profile.\n\n        This helper is a convenience for tests and examples.  The compiler\n        still receives all evidence/package/assumption records as arguments;\n        it does not inspect the authored expected IR.\n        \"\"\"\n        root_path = Path(root) if root is not None else ROOT\n        package_path = root_path / \"docs/design/fixtures/demo-debt-package.json\"\n        digest = hashlib.sha256(package_path.read_bytes()).hexdigest() if package_path.is_file() else \"\"\n        p = _fraction(principal)\n        stress = _fraction(stress_rate)\n        fixed = _fraction(fixed_rate)\n        literal = f\"Debt {p}; interest 5; fixed/floating split not disclosed\"\n        reading = ReadingBinding(\n            key=\"synthetic-note-7\", literal=literal, amount=p, currency=\"USD\",\n            instant=\"2025-12-31\", uri=\"fixture:demo-debt-package.json#registry/synthetic-note-7\",\n            filing_id=\"synthetic-2025\", available=\"2026-01-01T00:00:00Z\",\n            ingested=\"2026-01-01T00:00:00Z\", reviewer=\"synthetic-fixture-author\",\n            review_date=\"2026-01-01T00:00:00Z\",\n            review_reason=\"Explicit synthetic disclosure supplied by the caller\",\n            cutoff=\"2026-01-01T00:00:00Z\")\n        balances = opening_balances or {\"Cash\": p - 5, \"Debt\": -p, \"InterestExpense\": 0, \"Retained\": 5}\n        opening = OpeningBinding(\"after-2025-close\", \"2025-12-31\", balances, book=\"Local\")\n        package = PackageBinding(\n            \"DemoDebt\", \"1\", digest, \"DemoDebt\", \"2025-01-01\", \"2028-01-01\",\n            (\"reset\", \"accrue_and_pay\", \"close\", \"statements\"),\n            (\"builtin:Core0@1\", \"DemoCalendar@1\"), (\"fixture:demo-debt-package.json\",))\n        report = ReportBinding(\"DemoDebt.statements.v1\", \"DemoDebt.statements.v1\",\n                               \"interest_operating\", \"close\", (\"accrue_and_pay\",))\n        assumptions = (\n            AssumptionBinding(\"alternative\", \"Named endpoint condition supplied for comparison\"),\n            AssumptionBinding(\"contract-rate\", \"Component rates are explicit scenario inputs supplied by the caller\"),\n            AssumptionBinding(\"scenario\", f\"Illustrative constant annual stress {stress}; not an estimated future rate\"),\n        )\n        # Retain values for callers that want to inspect the intended defaults;\n        # rate values remain in the typed/source program itself.\n        _ = fixed\n        return cls((package,), (reading,), (opening,), (report,), assumptions)\n\n\n# ---------------------------------------------------------------------------\n# Lowering\n\n\ndef _empty_ir() -> dict[str, Any]:\n    keys = [\n        \"models\", \"contexts\", \"sourceSpans\", \"documents\", \"observations\", \"narratives\",\n        \"coverageUnits\", \"mappings\", \"partitions\", \"entities\", \"controls\", \"books\", \"accounts\",\n        \"symbols\", \"choices\", \"expressions\", \"constraints\", \"assumptions\", \"alternatives\",\n        \"contracts\", \"postings\", \"states\", \"events\", \"rules\", \"packages\", \"measurements\",\n        \"journals\", \"scenarios\", \"informationViews\", \"reviewDecisions\", \"evidenceViews\",\n        \"modelScopes\", \"historyFamilies\", \"probabilityModels\", \"reportMappings\", \"resultCells\",\n        \"branchResults\", \"runs\", \"diagnostics\",\n    ]\n    out = {k: [] for k in keys}\n    out[\"schema_version\"] = \"0.1\"\n    return out\n\n\ndef _diag(code: str, message: str, location: str, capability: Optional[str] = None,\n          span: Optional[tuple[int, int]] = None) -> _Failure:\n    return _Failure(Diagnostic(code, message, location, capability=capability, span=span))\n\n\nclass _Compiler:\n    def __init__(self, program: Program, bindings: CompileBindings,\n                 source_spans: Optional[Mapping[int, Mapping[str, Any]]] = None,\n                 input_text: Optional[str] = None):\n        self.program = program\n        self.bindings = bindings\n        self.source_spans = source_spans or {}\n        self.input_text = input_text\n        self.ir = _empty_ir()\n        self.source_map: dict[str, dict[str, Any]] = {}\n        self.expr_rows: dict[str, dict[str, Any]] = {}\n        self.expr_info: dict[str, tuple[str, Optional[str], Any]] = {}\n        self.decls: dict[str, Any] = {}\n        self.lets: dict[str, LetDecl] = {}\n        self.let_ids: dict[str, str] = {}\n        self.lowering_lets: set[str] = set()\n        self.observations: dict[str, ObservationDecl] = {}\n        self.symbols: dict[str, SymbolDecl] = {}\n        self.sources: dict[str, SourceDecl] = {}\n        self.entities: dict[str, EntityDecl] = {}\n        self.books: dict[str, BookDecl] = {}\n        self.accounts: dict[str, AccountDecl] = {}\n        self.openings: dict[str, OpeningDecl] = {}\n        self.contracts: dict[str, ContractDecl] = {}\n        self.alternatives: dict[str, AlternativeDecl] = {}\n        self.scenarios: dict[str, ScenarioDecl] = {}\n        self.reports: dict[str, ReportDecl] = {}\n        self.constraints: dict[str, ConstraintDecl] = {}\n        self.package: Optional[PackageBinding] = None\n        self.entity: Optional[EntityDecl] = None\n        self.book: Optional[BookDecl] = None\n        self.scope_id = f\"scope:{_clean_id(program.module)}@{_clean_id(program.version)}\"\n        self.model_id = f\"{program.module}@{program.version}\"\n\n    def fail(self, code: str, message: str, location: str, capability: Optional[str] = None,\n             node: Any = None) -> None:\n        span = None\n        if node is not None and id(node) in self.source_spans:\n            item = self.source_spans[id(node)]\n            span = (item.get(\"start\", 0), item.get(\"end\", 0))\n        raise _diag(code, message, location, capability, span)\n\n    def collect(self) -> None:\n        if not self.program.module or not self.program.version:\n            self.fail(\"InvalidModule\", \"module name and version are required\", \"module\")\n        reserved = {\n            \"module\", \"version\", \"use\", \"source\", \"entity\", \"functional\", \"book\", \"basis\",\n            \"account\", \"opening\", \"observation\", \"instant\", \"period\", \"symbol\", \"in\", \"because\",\n            \"choice\", \"binding\", \"let\", \"constraint\", \"alternative\", \"assume\", \"contract\", \"event\",\n            \"rule\", \"for\", \"as\", \"when\", \"require\", \"post\", \"scenario\", \"set\", \"report\", \"from\",\n            \"to\", \"true\", \"false\", \"and\", \"or\", \"not\", \"debit\", \"credit\",\n        }\n        declared_uses = tuple(d for d in self.program.declarations if isinstance(d, UseDecl))\n        all_uses = tuple(self.program.uses) + declared_uses\n        seen_use_ids: set[str] = set()\n        for use in all_uses:\n            self._check_name(use.name, \"use\", reserved)\n            if (use.name, use.version) in seen_use_ids:\n                self.fail(\"DuplicateDeclaration\", f\"duplicate package use {use.name!r}\", use.name)\n            seen_use_ids.add((use.name, use.version))\n            try:\n                package = self.bindings.package(use.name, use.version)\n            except _Failure:\n                raise\n            if self.package is not None and self.package.id != package.id:\n                self.fail(\"PackageCollision\", \"multiple package bases are outside Core0.1\", use.name)\n            self.package = package\n        for decl in self.program.declarations:\n            if isinstance(decl, UseDecl):\n                # A use is allowed either in Program.uses or declarations, but\n                # it must not be silently duplicated.\n                continue\n            if isinstance(decl, UnsupportedDecl):\n                self.fail(\"UnsupportedDeclaration\", f\"{decl.kind} is outside Core0.1\", decl.name or decl.kind,\n                          capability=decl.kind)\n            name = getattr(decl, \"name\", None)\n            if name:\n                self._check_name(name, type(decl).__name__, reserved)\n                if name in self.decls:\n                    self.fail(\"DuplicateDeclaration\", f\"duplicate declaration {name!r}\", name)\n                self.decls[name] = decl\n            if isinstance(decl, SourceDecl):\n                self.sources[decl.name] = decl\n            elif isinstance(decl, EntityDecl):\n                self.entities[decl.name] = decl\n            elif isinstance(decl, BookDecl):\n                self.books[decl.name] = decl\n            elif isinstance(decl, AccountDecl):\n                self.accounts[decl.name] = decl\n            elif isinstance(decl, OpeningDecl):\n                self.openings[decl.name] = decl\n            elif isinstance(decl, ObservationDecl):\n                self.observations[decl.name] = decl\n            elif isinstance(decl, SymbolDecl):\n                self.symbols[decl.name] = decl\n            elif isinstance(decl, LetDecl):\n                self.lets[decl.name] = decl\n            elif isinstance(decl, ConstraintDecl):\n                self.constraints[decl.name] = decl\n            elif isinstance(decl, ContractDecl):\n                self.contracts[decl.name] = decl\n            elif isinstance(decl, AlternativeDecl):\n                self.alternatives[decl.name] = decl\n            elif isinstance(decl, ScenarioDecl):\n                self.scenarios[decl.name] = decl\n            elif isinstance(decl, ReportDecl):\n                self.reports[decl.name] = decl\n            else:\n                self.fail(\"UnsupportedDeclaration\", f\"{type(decl).__name__} is outside Core0.1\", str(decl))\n        # A typed program may pass uses separately; source frontend does this.\n        if self.package is None and all_uses:\n            self.fail(\"MissingPackageBinding\", \"a Core0.1 program requires one package use\", \"use\")\n        if self.package is None:\n            self.fail(\"MissingPackageBinding\", \"a Core0.1 program requires one package use\", \"use\")\n        if len(self.entities) != 1 or len(self.books) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires exactly one entity and one book\", \"profile\")\n        if len(self.observations) < 1 or len(self.symbols) < 1 or len(self.contracts) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires an observation, symbol and one contract\", \"profile\")\n        if len(self.openings) != 1 or len(self.reports) != 1 or len(self.scenarios) != 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires one opening, scenario and report\", \"profile\")\n        if len(self.alternatives) < 1:\n            self.fail(\"ProfileCardinality\", \"Core0.1 requires at least one named alternative\", \"profile\")\n        self.entity = next(iter(self.entities.values()))\n        self.book = next(iter(self.books.values()))\n        if self.book.entity != self.entity.name:\n            self.fail(\"BindingMismatch\", \"book entity must name the declared entity\", self.book.name)\n        if self.book.basis != self.package.name or self.book.version != self.package.version:\n","exit_code":0,"status":"completed"}}
