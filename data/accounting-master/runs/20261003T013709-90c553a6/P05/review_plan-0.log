policy', 'information_set', 'decision_time'),\nscripts/reconstruction_v1.py:17:    'FutureInnovation': ('driver', 'future_period', 'scenario', 'joint_law', 'measure'),\nscripts/reconstruction_v1.py:21:def admit(record):\nscripts/reconstruction_v1.py:37:def expression(node, env):\nscripts/reconstruction_v1.py:56:def construct(spec):\nscripts/reconstruction_v1.py:178:def from_p03(ir, bindings, template_bindings):\nscripts/reconstruction_v1.py:232:        rate=lower(ir['scenarios'][0]['drivers'][0]['expression'])\nscripts/reconstruction_v1.py:240:class FiniteMeasure:\nscripts/reconstruction_v1.py:256:    def update(self, likelihood, information_blocks):\nscripts/reconstruction_v1.py:257:        blocks=set(information_blocks)\nscripts/reconstruction_v1.py:258:        if not blocks or len(blocks) != len(information_blocks) or blocks & self.used:raise ValueError('repeated/missing information block')\nscripts/reconstruction_v1.py:263:        if total==0:raise ValueError('zero-probability conditioning')\nscripts/reconstruction_v1.py:281:def weighted_summary(measure):\nscripts/reconstruction_v1.py:286:def group_contracts(contracts, scenario, horizon, previous=None):\nscripts/reconstruction_v1.py:288:    request={'contracts':contracts,'scenario':scenario,'horizon':horizon}\nscripts/reconstruction_v1.py:302:    rate=rational(scenario['rate'] if contracts[0]['reset']=='floating' else contracts[0]['rate'])\nscripts/reconstruction_v1.py:303:    year_fraction=rational(scenario['year_fraction'])\nscripts/reconstruction_v1.py:311:            'scenario':deepcopy(scenario),'horizon':list(horizon),'principal':str(principal),\nscripts/check_accounting_p06.py:154:    parser.add_argument(\"--approved-plan\", required=True)\nscripts/check_accounting_p06.py:155:    parser.add_argument(\"--execution-inventory\", required=True)\nscripts/check_accounting_p04.py:21:ORIGINAL_PLAN='data/accounting-master/runs/20261002T221346-d54a6552/P04/approved-plan.json'\nscripts/check_accounting_p04.py:60:    if (plan.name!='approved-plan.json' or plan.parent.name!='P04'\nscripts/check_accounting_p04.py:101:    parser.add_argument('--execution-inventory',required=True)\nscripts/check_accounting_p04.py:102:    parser.add_argument('--approved-plan',required=True)\nscripts/check_accounting_p04.py:155:The current recovery accepts explicit supervisor approval and execution-inventory paths, checks approval structure and plan-hash integrity, and retains the original design and historical inventory separately. Four checker obligations exercise malformed or unapproved inputs, rejection before writes, current manifest selection, unchanged protection exclusions and failure reporting in disposable trees. Their simulated test outcomes concern reporting behavior only; the reconstruction tests supply the numerical evidence below.\nscripts/accounting_master_catalog.json:176:      \"id\": \"P05\",\nscripts/accounting_master_catalog.json:210:      \"output_dir\": \"data/accounting-master/deliverables/P05\"\nscripts/accounting_master_catalog.json:255:        \"P05\",\nscripts/accounting_master_catalog.json:417:        \"P05\",\nscripts/accounting_master_catalog.json:450:        \"P05\",\n","exit_code":0,"status":"completed"}}
