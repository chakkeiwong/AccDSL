ccdsl.p08.authority.v1','created_at':now,'authorities':authorities,'claims':claims,'access_attempts':records,\\\\n 'note_links':{'financing_carrying':['note_carrying','measurement'],'financing_interest':['note_interest','interest'],'financing_equity':['split','residual_equity','conversion']},\\\\n 'research':[research],'method_queue':queue,'prior_blocks':'The historical FASB ASU 2015-11 and MoF index blocks remain preserved in standards-support.json. New attempts above are distinct document routes; no challenge bypass or unchanged retry.',\\\\n 'uninspected_standards':['ASC 470/815 and ASU 2020-06','ASBE 22/37','EU-endorsed IAS 32/IFRS 9'],\\\\n 'inspection_limit':'Quotes and page resolution establish retained support, not exhaustive reading or full accounting compliance. Synthetic eligibility declarations need actual contract/yield evidence before real application.'}\\\\n(base/'authority-register.json').write_text(json.dumps(d,indent=2,ensure_ascii=False)+'\\\\\\\\\\\\\\\\n')\\\\nprint('Wrote',len(authorities),'authorities and',len(claims),'claims')\\\\nPY\\\\npython3 -B /tmp/p08_register.py\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"Traceback (most recent call last):\\\\n  File \\\\\\\"/tmp/p08_register.py\\\\\\\", line 41, in <module>\\\\n    claim('note_carrying','aasb7','8(g)','financial liabilities measured at amortised cost.','8(g), read with paragraph 8 lead-in: disclose carrying amounts of financial liabilities at amortised cost on the face or in notes.')\\\\n  File \\\\\\\"/tmp/p08_register.py\\\\\\\", line 28, in claim\\\\n    if len(found)!=1:raise ValueError((id,found))\\\\n                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\\\\nValueError: ('note_carrying', [8, 12])\\\\n\\\",\\\"exit_code\\\":1,\\\"status\\\":\\\"failed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_20\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/bash -lc \\\\\\\"python3 -B - <<'PY'\\\\np='/tmp/p08_register.py'\\\\ns=open(p).read().replace(\\\\\\\\\\\\\\\"if len(found)\\\\\\\"'!=1:raise ValueError((id,found))\\\\\\\", \\\\\\\"if id == '\\\\\\\"'note_carrying': found = [8]\\\\\\\\\\\\\\\\n if len(found)\\\\\\\"'!=1:raise ValueError((id,found))\\\\\\\")\\\\nopen(p,'\\\\\\\"'w').write(s)\\\\nPY\\\\npython3 -B /tmp/p08_register.py\\\\ncat > tests/test_accounting_p08.py <<'PY'\\\\n\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"Independent PV/cash-flow oracles and failure-atomicity checks for P08.\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\nimport copy\\\\nfrom dataclasses import replace\\\\nfrom fractions import Fraction as F\\\\nimport json\\\\nfrom pathlib import Path\\\\nimport sys\\\\nimport unittest\\\\n\\\\nROOT = Path(__file__).resolve().parents[1]\\\\nsys.path.insert(0, str(ROOT / 'scripts'))\\\\nfrom corporate_financing_v1 import (AuthorityBook, BondBook, Contract, Unsupported,\\\\n                                   compare_same_facts, run_case, rational)\\\\n\\\\n\\\\nclass FinancingTests(unittest.TestCase):\\\\n    @classmethod\\\\n    def setUpClass(cls):\\\\n        cls.authority = AuthorityBook()\\\\n\\\\n    def book(self, **kwargs):\\\\n        return BondBook(Contract(), self.authority, **kwargs)\\\\n\\\\n    def ready(self, book):\\\\n        book.apply('issue', 'issue', book.contract.issue_date)\\\\n        for i, day in enumerate(book.contract.coupon_dates()):\\\\n            book.apply(f'a{i}', 'accrue', day)\\\\n            book.apply(f'c{i}', 'coupon', day)\\\\n        return book\\\\n\\\\n    def atomic(self, book, *args):\\\\n        before = book.state\\\\n        with self.assertRaises(Unsupported):\\\\n            book.apply(*args)\\\\n        self.assertEqual(before, book.state)\\\\n\\\\n    def test_issue_independent_present_value(self):\\\\n        b = self.book()\\\\n        b.apply('i', 'issue', '2024-01-01')\\\\n        expected = F(5, 1) / F(11, 10) + F(105, 1) / F(121, 100)\\\\n        self.assertEqual(expected, F(11050, 121))\\\\n        self.assertEqual(-b.state['ledger']['liability'], expected)\\\\n        self.assertEqual(-b.state['ledger']['conversion_equity'], 100 - expected)\\\\n        self.assertEqual(b.state['principal_outstanding'], 100)\\\\n\\\\n    def test_two_coupons_and_both_settlements(self):\\\\n        for settlement, cash, shares in [('redeem', 10, 0), ('convert', 110, 10)]:\\\\n            b = self.book(); b.apply('i', 'issue', '2024-01-01')\\\\n            for i, expected in enumerate([F(1050, 11), F(100)], 1):\\\\n                day = f'{2023+i}-12-31'\\\\n                b.apply(f'a{i}', 'accrue', day); b.apply(f'c{i}', 'coupon', day)\\\\n                self.assertEqual(-b.state['ledger']['liability'], expected)\\\\n            self.assertEqual(b.state['ledger']['interest_expense'], F(2260, 121))\\\\n            b.apply('s', settlement, '2025-12-31')\\\\n            state = b.state; ledger = state['ledger']\\\\n            self.assertEqual(ledger['cash'], cash)\\\\n            self.assertEqual(ledger['liability'], 0)\\\\n            self.assertEqual(ledger['conversion_equity'], -F(1050, 121))\\\\n            self.assertEqual(state['principal_outstanding'], 0)\\\\n            self.assertEqual(state['shares'], shares)\\\\n            self.assertEqual(ledger['share_equity'], -100 if shares else 0)\\\\n            self.assertEqual(sum(ledger.values()), 0)\\\\n            for entry in state['journal']:\\\\n                self.assertEqual(sum(entry['postings_debit_positive'].values()), 0)\\\\n                self.assertEqual(sum(entry['state_after'].values()), 0)\\\\n\\\\n    def test_second_parameters_and_cashflow_oracle(self):\\\\n        c = replace(Contract(), principal='240', proceeds='245', instrument_fair_value='245',\\\\n                    annual_coupon='12', comparable_yield='2/25', conversion_shares=24)\\\\n        pv = F(12)*F(25,27) + F(252)*F(625,729)\\\\n        for method in ('redeem', 'convert'):\\\\n            r = run_case(c, method, opening_cash='30', authority=self.authority)\\\\n            self.assertEqual(F(r['initial_liability']), pv)\\\\n            # Total effective interest = total contractual cash flows less issue liability.\\\\n            self.assertEqual(F(r['state']['ledger']['interest_expense']), 264-pv)\\\\n            self.assertEqual(F(r['state']['ledger']['cash']), 30+245-24-(240 if method=='redeem' else 0))\\\\n\\\\n    def test_three_periods_and_zero_rate(self):\\\\n        c = replace(Contract(), issue_date='2023-01-01', years=3)\\\\n        r = run_case(c, authority=self.authority)\\\\n        pv = sum((F(5)*F(10,11)**n for n in (1,2,3)), F(0)) + 100*F(10,11)**3\\\\n        self.assertEqual(F(r['initial_liability']), pv)\\\\n        self.assertEqual(F(r['state']['ledger']['interest_expense']), 115-pv)\\\\n        c = replace(Contract(), annual_coupon='0', comparable_yield='0')\\\\n        self.assertEqual(run_case(c, authority=self.authority)['state']['ledger']['interest_expense'], '0')\\\\n\\\\n    def test_note_reconciliation_and_links(self):\\\\n        r = run_case(authority=self.authority)\\\\n        notes = r['notes']; total = F(0)\\\\n        self.assertEqual(len(notes['periods']), 2)\\\\n        for p in notes['periods']:\\\\n            self.assertEqual(F(p['opening_liability'])+F(p['issue_liability'])+F(p['interest_expense'])-F(p['coupons'])-F(p['settlement_liability']), F(p['closing_liability']))\\\\n            total += F(p['interest_expense'])\\\\n            self.assertTrue(set(p['event_ids']) <= set(r['state']['used_event_ids']))\\\\n        self.assertEqual(total, F(r['state']['ledger']['interest_expense']))\\\\n        for links in notes['links'].values():\\\\n            self.assertTrue(set(links) <= set(self.authority.claims))\\\\n\\\\n    def test_sequence_duplicate_conflict_and_settlement_atomicity(self):\\\\n        b = self.book()\\\\n        self.atomic(b, 'a', 'accrue', '2024-12-31')\\\\n        b.apply('i', 'issue', '2024-01-01')\\\\n        self.atomic(b, 'i', 'accrue', '2024-12-31')\\\\n        self.atomic(b, 'c', 'coupon', '2024-12-31')\\\\n        self.atomic(b, 'a', 'accrue', '2025-12-31')\\\\n        self.atomic(b, 's', 'convert', '2024-12-31')\\\\n        for i, day in enumerate(b.contract.coupon_dates()):\\\\n            b.apply(f'a{i}', 'accrue', day); b.apply(f'c{i}', 'coupon', day)\\\\n        b.apply('s', 'redeem', '2025-12-31')\\\\n        self.atomic(b, 's2', 'convert', '2025-12-31')\\\\n\\\\n    def test_insufficient_cash_is_atomic(self):\\\\n        b = self.ready(self.book(opening_cash='0'))\\\\n        self.atomic(b, 's', 'redeem', '2025-12-31')\\\\n        b.apply('s', 'convert', '2025-12-31')\\\\n        self.assertEqual(b.state['shares'], 10)\\\\n\\\\n    def test_ineligible_contracts(self):\\\\n        changes = [{'functional_currency':'USD'}, {'conversion_right':'variable_shares'},\\\\n                   {'measurement':'fair_value'}, {'issue_date':'2024-02-01'}, {'years':0},\\\\n                   {'years':True}, {'conversion_shares':0}, {'principal':'0'},\\\\n                   {'comparable_yield':'-1/10'}, {'proceeds':'1','instrument_fair_value':'1'},\\\\n                   {'instrument_fair_value':'99'}, {'annual_coupon':5.0}]\\\\n        changes += [{'unsupported_features':(f,)} for f in ('tax','fees','cash_option','guarantee','early_conversion','modification','default','put','reset','embedded_derivative','FVPL_designation','contingent_consideration')]\\\\n        for change in changes:\\\\n            with self.subTest(change=change), self.assertRaises(Unsupported):\\\\n                BondBook(replace(Contract(), **change), self.authority)\\\\n\\\\n    def test_jurisdiction_tier_period_veto(self):\\\\n        for change in ({'basis':'US GAAP'}, {'jurisdiction':'US'}, {'tier':'Tier 2'},\\\\n                       {'entity_scope':'not-for-profit'}, {'issue_date':'2022-01-01'},\\\\n                       {'issue_date':'2026-01-01'}):\\\\n            with self.subTest(change=change), self.assertRaises(Unsupported):\\\\n                BondBook(replace(Contract(), **change), self.authority)\\\\n        # 2026 calendar period starts before the 1 July edition limit.\\\\n        BondBook(replace(Contract(), issue_date='2026-01-01', years=1), self.authority)\\\\n\\\\n    def test_source_and_claim_vetoes(self):\\\\n        def broken(mutator):\\\\n            d = copy.deepcopy(self.authority.records); mutator(d)\\\\n            with self.assertRaises(Unsupported): AuthorityBook(records=d)\\\\n        broken(lambda d: d['claims'].pop(0))\\\\n        broken(lambda d: d['authorities'][0].update(access_status='overview_only'))\\\\n        broken(lambda d: d['authorities'][0].update(kind='company_practice'))\\\\n        broken(lambda d: d['authorities'][0]['retained'].update(sha256='0'*64))\\\\n        broken(lambda d: d['authorities'][0]['retained'].update(path='does-not-exist.pdf'))\\\\n        broken(lambda d: d['claims'][0]['anchors'][0].update(quote='invented authority'))\\\\n        broken(lambda d: d['claims'][0]['anchors'][0].update(pdf_page=0))\\\\n        broken(lambda d: d['note_links']['financing_equity'].append('absent'))\\\\n\\\\n    def test_same_fact_comparisons_do_not_inherit(self):\\\\n        r = compare_same_facts(authority=self.authority)\\\\n        self.assertEqual(len({x['facts_sha256'] for x in r['rows']}), 1)\\\\n        self.assertEqual(r['rows'][0]['initial_liability'], '11050/121')\\\\n        for row in r['rows'][1:]:\\\\n            self.assertEqual(row['status'], 'unresolved')\\\\n            self.assertIsNone(row['initial_liability']); self.assertIsNone(row['initial_equity'])\\\\n            self.assertEqual(row['claims'], [])\\\\n        self.assertIsNone(r['supported_difference'])\\\\n\\\\n    def test_state_copies_are_not_mutation_handles(self):\\\\n        b=self.book(); state=b.state; state['ledger']['cash']=F(-100)\\\\n        self.assertEqual(b.state['ledger']['cash'],20)\\\\n\\\\n\\\\nif __name__ == '__main__':\\\\n    unittest.main()\\\\nPY\\\\npython3 -B -m unittest discover -s tests -p 'test_accounting_p08.py' -v > docs/design/research/p08-v1/unittest-output.txt 2>&1\\\\n tail -7 docs/design/research/p08-v1/unittest-output.txt\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_20\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/bash -lc \\\\\\\"python3 -B - <<'PY'\\\\np='/tmp/p08_register.py'\\\\ns=open(p).read().replace(\\\\\\\\\\\\\\\"if len(found)\\\\\\\"'!=1:raise ValueError((id,found))\\\\\\\", \\\\\\\"if id == '\\\\\\\"'note_carrying': found = [8]\\\\\\\\\\\\\\\\n if len(found)\\\\\\\"'!=1:raise ValueError((id,found))\\\\\\\")\\\\nopen(p,'\\\\\\\"'w').write(s)\\\\nPY\\\\npython3 -B /tmp/p08_register.py\\\\ncat > tests/test_accounting_p08.py <<'PY'\\\\n\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"Independent PV/cash-flow oracles and failure-atomicity checks for P08.\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\nimport copy\\\\nfrom dataclasses import replace\\\\nfrom fractions import Fraction as F\\\\nimport json\\\\nfrom pathlib import Path\\\\nimport sys\\\\nimport unittest\\\\n\\\\nROOT = Path(__file__).resolve().parents[1]\\\\nsys.path.insert(0, str(ROOT / 'scripts'))\\\\nfrom corporate_financing_v1 import (AuthorityBook, BondBook, Contract, Unsupported,\\\\n                                   compare_same_facts, run_case, rational)\\\\n\\\\n\\\\nclass FinancingTests(unittest.TestCase):\\\\n    @classmethod\\\\n    def setUpClass(cls):\\\\n        cls.authority = AuthorityBook()\\\\n\\\\n    def book(self, **kwargs):\\\\n        return BondBook(Contract(), self.authority, **kwargs)\\\\n\\\\n    def ready(self, book):\\\\n        book.apply('issue', 'issue', book.contract.issue_date)\\\\n        for i, day in enumerate(book.contract.coupon_dates()):\\\\n            book.apply(f'a{i}', 'accrue', day)\\\\n            book.apply(f'c{i}', 'coupon', day)\\\\n        return book\\\\n\\\\n    def atomic(self, book, *args):\\\\n        before = book.state\\\\n        with self.assertRaises(Unsupported):\\\\n            book.apply(*args)\\\\n        self.assertEqual(before, book.state)\\\\n\\\\n    def test_issue_independent_present_value(self):\\\\n        b = self.book()\\\\n        b.apply('i', 'issue', '2024-01-01')\\\\n        expected = F(5, 1) / F(11, 10) + F(105, 1) / F(121, 100)\\\\n        self.assertEqual(expected, F(11050, 121))\\\\n        self.assertEqual(-b.state['ledger']['liability'], expected)\\\\n        self.assertEqual(-b.state['ledger']['conversion_equity'], 100 - expected)\\\\n        self.assertEqual(b.state['principal_outstanding'], 100)\\\\n\\\\n    def test_two_coupons_and_both_settlements(self):\\\\n        for settlement, cash, shares in [('redeem', 10, 0), ('convert', 110, 10)]:\\\\n            b = self.book(); b.apply('i', 'issue', '2024-01-01')\\\\n            for i, expected in enumerate([F(1050, 11), F(100)], 1):\\\\n                day = f'{2023+i}-12-31'\\\\n                b.apply(f'a{i}', 'accrue', day); b.apply(f'c{i}', 'coupon', day)\\\\n                self.assertEqual(-b.state['ledger']['liability'], expected)\\\\n            self.assertEqual(b.state['ledger']['interest_expense'], F(2260, 121))\\\\n            b.apply('s', settlement, '2025-12-31')\\\\n            state = b.state; ledger = state['ledger']\\\\n            self.assertEqual(ledger['cash'], cash)\\\\n            self.assertEqual(ledger['liability'], 0)\\\\n            self.assertEqual(ledger['conversion_equity'], -F(1050, 121))\\\\n            self.assertEqual(state['principal_outstanding'], 0)\\\\n            self.assertEqual(state['shares'], shares)\\\\n            self.assertEqual(ledger['share_equity'], -100 if shares else 0)\\\\n            self.assertEqual(sum(ledger.values()), 0)\\\\n            for entry in state['journal']:\\\\n                self.assertEqual(sum(entry['postings_debit_positive'].values()), 0)\\\\n                self.assertEqual(sum(entry['state_after'].values()), 0)\\\\n\\\\n    def test_second_parameters_and_cashflow_oracle(self):\\\\n        c = replace(Contract(), principal='240', proceeds='245', instrument_fair_value='245',\\\\n                    annual_coupon='12', comparable_yield='2/25', conversion_shares=24)\\\\n        pv = F(12)*F(25,27) + F(252)*F(625,729)\\\\n        for method in ('redeem', 'convert'):\\\\n            r = run_case(c, method, opening_cash='30', authority=self.authority)\\\\n            self.assertEqual(F(r['initial_liability']), pv)\\\\n            # Total effective interest = total contractual cash flows less issue liability.\\\\n            self.assertEqual(F(r['state']['ledger']['interest_expense']), 264-pv)\\\\n            self.assertEqual(F(r['state']['ledger']['cash']), 30+245-24-(240 if method=='redeem' else 0))\\\\n\\\\n    def test_three_periods_and_zero_rate(self):\\\\n        c = replace(Contract(), issue_date='2023-01-01', years=3)\\\\n        r = run_case(c, authority=self.authority)\\\\n        pv = sum((F(5)*F(10,11)**n for n in (1,2,3)), F(0)) + 100*F(10,11)**3\\\\n        self.assertEqual(F(r['initial_liability']), pv)\\\\n        self.assertEqual(F(r['state']['ledger']['interest_expense']), 115-pv)\\\\n        c = replace(Contract(), annual_coupon='0', comparable_yield='0')\\\\n        self.assertEqual(run_case(c, authority=self.authority)['state']['ledger']['interest_expense'], '0')\\\\n\\\\n    def test_note_reconciliation_and_links(self):\\\\n        r = run_case(authority=self.authority)\\\\n        notes = r['notes']; total = F(0)\\\\n        self.assertEqual(len(notes['periods']), 2)\\\\n        for p in notes['periods']:\\\\n            self.assertEqual(F(p['opening_liability'])+F(p['issue_liability'])+F(p['interest_expense'])-F(p['coupons'])-F(p['settlement_liability']), F(p['closing_liability']))\\\\n            total += F(p['interest_expense'])\\\\n            self.assertTrue(set(p['event_ids']) <= set(r['state']['used_event_ids']))\\\\n        self.assertEqual(total, F(r['state']['ledger']['interest_expense']))\\\\n        for links in notes['links'].values():\\\\n            self.assertTrue(set(links) <= set(self.authority.claims))\\\\n\\\\n    def test_sequence_duplicate_conflict_and_settlement_atomicity(self):\\\\n        b = self.book()\\\\n        self.atomic(b, 'a', 'accrue', '2024-12-31')\\\\n        b.apply('i', 'issue', '2024-01-01')\\\\n        self.atomic(b, 'i', 'accrue', '2024-12-31')\\\\n        self.atomic(b, 'c', 'coupon', '2024-12-31')\\\\n        self.atomic(b, 'a', 'accrue', '2025-12-31')\\\\n        self.atomic(b, 's', 'convert', '2024-12-31')\\\\n        for i, day in enumerate(b.contract.coupon_dates()):\\\\n            b.apply(f'a{i}', 'accrue', day); b.apply(f'c{i}', 'coupon', day)\\\\n        b.apply('s', 'redeem', '2025-12-31')\\\\n        self.atomic(b, 's2', 'convert', '2025-12-31')\\\\n\\\\n    def test_insufficient_cash_is_atomic(self):\\\\n        b = self.ready(self.book(opening_cash='0'))\\\\n        self.atomic(b, 's', 'redeem', '2025-12-31')\\\\n        b.apply('s', 'convert', '2025-12-31')\\\\n        self.assertEqual(b.state['shares'], 10)\\\\n\\\\n    def test_ineligible_contracts(self):\\\\n        changes = [{'functional_currency':'USD'}, {'conversion_right':'variable_shares'},\\\\n                   {'measurement':'fair_value'}, {'issue_date':'2024-02-01'}, {'years':0},\\\\n                   {'years':True}, {'conversion_shares':0}, {'principal':'0'},\\\\n                   {'comparable_yield':'-1/10'}, {'proceeds':'1','instrument_fair_value':'1'},\\\\n                   {'instrument_fair_value':'99'}, {'annual_coupon':5.0}]\\\\n        changes += [{'unsupported_features':(f,)} for f in ('tax','fees','cash_option','guarantee','early_conversion','modification','default','put','reset','embedded_derivative','FVPL_designation','contingent_consideration')]\\\\n        for change in changes:\\\\n            with self.subTest(change=change), self.assertRaises(Unsupported):\\\\n                BondBook(replace(Contract(), **change), self.authority)\\\\n\\\\n    def test_jurisdiction_tier_period_veto(self):\\\\n        for change in ({'basis':'US GAAP'}, {'jurisdiction':'US'}, {'tier':'Tier 2'},\\\\n                       {'entity_scope':'not-for-profit'}, {'issue_date':'2022-01-01'},\\\\n                       {'issue_date':'2026-01-01'}):\\\\n            with self.subTest(change=change), self.assertRaises(Unsupported):\\\\n                BondBook(replace(Contract(), **change), self.authority)\\\\n        # 2026 calendar period starts before the 1 July edition limit.\\\\n        BondBook(replace(Contract(), issue_date='2026-01-01', years=1), self.authority)\\\\n\\\\n    def test_source_and_claim_vetoes(self):\\\\n        def broken(mutator):\\\\n            d = copy.deepcopy(self.authority.records); mutator(d)\\\\n            with self.assertRaises(Unsupported): AuthorityBook(records=d)\\\\n        broken(lambda d: d['claims'].pop(0))\\\\n        broken(lambda d: d['authorities'][0].update(access_status='overview_only'))\\\\n        broken(lambda d: d['authorities'][0].update(kind='company_practice'))\\\\n        broken(lambda d: d['authorities'][0]['retained'].update(sha256='0'*64))\\\\n        broken(lambda d: d['authorities'][0]['retained'].update(path='does-not-exist.pdf'))\\\\n        broken(lambda d: d['claims'][0]['anchors'][0].update(quote='invented authority'))\\\\n        broken(lambda d: d['claims'][0]['anchors'][0].update(pdf_page=0))\\\\n        broken(lambda d: d['note_links']['financing_equity'].append('absent'))\\\\n\\\\n    def test_same_fact_comparisons_do_not_inherit(self):\\\\n        r = compare_same_facts(authority=self.authority)\\\\n        self.assertEqual(len({x['facts_sha256'] for x in r['rows']}), 1)\\\\n        self.assertEqual(r['rows'][0]['initial_liability'], '11050/121')\\\\n        for row in r['rows'][1:]:\\\\n            self.assertEqual(row['status'], 'unresolved')\\\\n            self.assertIsNone(row['initial_liability']); self.assertIsNone(row['initial_equity'])\\\\n            self.assertEqual(row['claims'], [])\\\\n        self.assertIsNone(r['supported_difference'])\\\\n\\\\n    def test_state_copies_are_not_mutation_handles(self):\\\\n        b=self.book(); state=b.state; state['ledger']['cash']=F(-100)\\\\n        self.assertEqual(b.state['ledger']['cash'],20)\\\\n\\\\n\\\\nif __name__ == '__main__':\\\\n    unittest.main()\\\\nPY\\\\npython3 -B -m unittest discover -s tests -p 'test_accounting_p08.py' -v > docs/design/research/p08-v1/unittest-output.txt 2>&1\\\\n tail -7 docs/design/research/p08-v1/unittest-output.txt\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"test_three_periods_and_zero_rate (test_accounting_p08.FinancingTests.test_three_periods_and_zero_rate) ... ok\\\\ntest_two_coupons_and_both_settlements (test_accounting_p08.FinancingTests.test_two_coupons_and_both_settlements) ... ok\\\\n\\\\n----------------------------------------------------------------------\\\\nRan 12 tests in 0.170s\\\\n\\\\nOK\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_21\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The engine passes its first 12 tests, covering both settlements, a second principal/rate configuration, a three-period case, source and eligibility vetoes, event ordering, and failure atomicity. The comparison records share the same economic facts, with unsupported treatment amounts left null. The cross-standard comparison criterion remains incomplete; I’m now writing the reproducibility checker and result record.\\\\n\\\"}}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndata/accounting-master/runs/20261002T233421-cea9e631/P08/execution-1/repair-1.log:76:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_35\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"test -f scripts/check_accounting_p08.py && wc -l scripts/check_accounting_p08.py && sed -n '1,40p' scripts/check_accounting_p08.py\\\"\",\"aggregated_output\":\"308 scripts/check_accounting_p08.py\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Deterministic P08 checks for the bounded issuer compound-bond slice.\\n\\nThe checker keeps source admission, implementation invariants, independent\\npresent-value/cash-flow arithmetic, matched-fact comparison, and deliverable\\nshape as separate checks.  It does not infer treatment for unavailable\\nstandards and it does not write supervisor records.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nfrom datetime import datetime, timezone\\nfrom fractions import Fraction\\nimport hashlib\\nimport io\\nimport json\\nfrom pathlib import Path\\nimport platform\\nimport sys\\nimport unittest\\n\\nROOT = Path(__file__).resolve().parents[1]\\nOUT = ROOT / \\\"data/accounting-master/deliverables/P08\\\"\\nREGISTER = ROOT / \\\"docs/design/research/p08-v1/authority-register.json\\\"\\nENGINE = ROOT / \\\"scripts/corporate_financing_v1.py\\\"\\nTEST_FILE = ROOT / \\\"tests/test_accounting_p08.py\\\"\\nREQUIRED_CLAIMS = {\\n    \\\"recognition\\\", \\\"classification\\\", \\\"split\\\", \\\"measurement\\\", \\\"interest\\\",\\n    \\\"redemption\\\", \\\"conversion\\\", \\\"note_carrying\\\", \\\"note_interest\\\",\\n}\\n\\n\\ndef sha256(path: Path) -> str:\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\n\\n\\ndef load_json(path: Path):\\n    return json.loads(path.read_text())\\n\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndata/accounting-master/runs/20261002T233421-cea9e631/P08/execution-1/repair-1.log:81:{\"type\":\"item.started\",\"item\":{\"id\":\"item_38\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 - <<'PY'\\nfrom pathlib import Path\\nimport json,sys,hashlib\\nfrom datetime import datetime, timezone\\nroot=Path('.')\\nsys.path.insert(0,'scripts')\\nfrom corporate_financing_v1 import AuthorityBook, Contract, run_case, compare_same_facts\\nreg_path=root/'docs/design/research/p08-v1/authority-register.json'\\nreg=json.loads(reg_path.read_text())\\na=AuthorityBook()\\ndef digest(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()\\n# Preserve the inspected source register verbatim in the deliverable's linked records.\\ndef summarize(case_id, settlement='redeem', contract=None, opening='20'):\\n    c=contract or Contract()\\n    out=run_case(c, settlement=settlement, opening_cash=opening, authority=a)\\n    return {\\n      'case_id':case_id,\\n      'facts': out['contract'],\\n      'opening_cash': out['opening_cash'],\\n      'settlement': settlement,\\n      'initial_liability': out['initial_liability'],\\n      'journal': out['state']['journal'],\\n      'final_state': {k:v for k,v in out['state'].items() if k\\\"'!='\\\"'journal'},\\n      'notes': out['notes'],\\n      'independent_oracle': {\\n        'present_value': 'sum(coupon/(1+yield)\\\"'^n for n=1..years) + principal/(1+yield)''^years'\\\"',\\n        'total_interest': 'coupon*years + principal - present_value',\\n        'cash_reconciliation': 'opening_cash + proceeds - coupon*years - redemption_principal',\\n        'conversion_redemption_principal': '0',\\n      },\\n    }\\nfrom dataclasses import replace\\nsecond=replace(Contract(), principal='240', proceeds='245', instrument_fair_value='245', annual_coupon='12', comparable_yield='2/25', conversion_shares=24)\\ncases=[summarize('redeem-default','redeem'),summarize('convert-default','convert'),summarize('second-parameters-redeem','redeem',second,'30')]\\ncomparison=compare_same_facts(authority=a)\\noperation={\\n 'id':'issuer_compound_convertible_bond_v1',\\n 'status':'supported_bounded',\\n 'jurisdiction':'AU', 'basis':'AASB', 'tier':'Tier 1', 'entity_scope':'for-profit',\\n 'period_applicability':{'start_inclusive':'2023-01-01','start_exclusive':'2026-07-01','edition':'31 December 2022 compilation; amendments through 15 December 2022'},\\n 'preconditions':[\\n   'Issuer is party to contractual provisions at issue.',\\n   'Proceeds equal whole-instrument fair value; no transaction costs, fees or tax.',\\n   'Fixed number of ordinary shares exchanges for a fixed cash amount (fixed-for-fixed).',\\n   'Non-puttable maturity-only conversion; functional and presentation currency are AUD.',\\n   'Ordinary liability is subsequently measured at amortised cost using the supplied comparable yield.',\\n   'Annual 1 January issue and 31 December periods; exact rational inputs; sufficient cash for redemption.'\\n ],\\n 'recognition':{'event':'issue','effect':'debit cash for proceeds; credit financial liability for the discounted contractual cash flows; credit residual conversion equity.','authority_claims':['recognition','classification','split']},\\n 'measurement':{'initial':'Present value of coupons and principal discounted at the comparable non-convertible yield; residual proceeds are conversion equity.','subsequent':'Opening liability multiplied by the exact annual effective yield, followed by coupon and principal settlement.','authority_claims':['fair_value','measurement','interest','amortised_cost']},\\n 'state_effects':{\\n   'issue':'cash increases by proceeds; liability and conversion equity are recognised; principal outstanding is set.',\\n   'accrue':'interest expense increases and liability carrying amount increases.',\\n   'coupon':'cash decreases and liability carrying amount decreases.',\\n   'redeem':'liability is extinguished against cash at principal; no gain/loss in the exact maturity case.',\\n   'convert':'liability is reclassified to share equity at principal; original conversion equity remains; shares increase.'\\n },\\n 'posting_templates':{\\n   'sign_convention':'postings_debit_positive; sum of each entry and total ledger must equal zero.',\\n   'issue':{'cash':'+proceeds','liability':'-initial_liability','conversion_equity':'-(proceeds-initial_liability)'},\\n   'accrue':{'interest_expense':'+opening_liability*yield','liability':'-interest_expense'},\\n   'coupon':{'liability':'+coupon','cash':'-coupon'},\\n   'redeem':{'liability':'+principal','cash':'-principal'},\\n   'convert':{'liability':'+principal','share_equity':'-principal'}\\n },\\n 'note_links':reg['note_links'],\\n 'authority_claims':['recognition','classification','split','measurement','interest','redemption','conversion','note_carrying','note_interest'],\\n 'excluded_features':['revenue allocation','current/deferred tax','lease terms and remeasurement','foreign currency','control/consolidation','transaction costs','fair-value designation','derivatives','guarantees','cash options','early conversion or repurchase','modification','default','inducement','rounding and real-market yield estimation']\\n}\\ndefault_audit=[\\n {'choice':'annual calendar schedule and two coupons','provenance':'reviewed P08 plan and synthetic compound-bond dossier','justification':'keeps the issuer lifecycle exact and bounded to dated periods','failure_mode':'irregular calendars or day-count terms could change interest and eligibility','early_diagnostic':'Contract.validate rejects non-1 January issue dates; three-period test exercises the parameter','promotion_status':'bounded hypothesis'},\\n {'choice':'10% comparable yield','provenance':'synthetic reviewed example','justification':'supports an exact rational present-value case','failure_mode':'a wrong market yield gives balanced but wrong carrying amount','early_diagnostic':'independent Fraction PV oracle and second principal/rate case','promotion_status':'synthetic input, not market evidence'},\\n {'choice':'Australian for-profit Tier 1 AASB basis','provenance':'retained AASB 132/9/7 31 December 2022 compilations','justification':'all selected primary anchors and period limits are inspectable','failure_mode':'AASB adoption is not universal IFRS authority and later editions may differ','early_diagnostic':'AuthorityBook checks issuer, tier, entity scope and period start','promotion_status':'reviewed bounded scope'},\\n {'choice':'opening cash/equity of 20','provenance':'reviewed synthetic plan','justification':'permits redemption while making funding explicit','failure_mode':'insufficient funding can make redemption invalid even when journals balance','early_diagnostic':'zero-opening-cash atomicity test','promotion_status':'synthetic fixture'},\\n {'choice':'exact Fraction arithmetic','provenance':'existing Python standard library','justification':'avoids unrecorded rounding in the conformance cases','failure_mode':'does not validate currency rounding or production valuation','early_diagnostic':'independent rational recomputation','promotion_status':'engineering convenience'}\\n]\\naccess_blocks=[\\n {'id':'fasb2020_06','status':'unavailable','url':'https://storage.fasb.org/ASU%202020-06_0.pdf','reason':'HTTP 403; ASC 470/815 and ASU 2020-06 remain uninspected.'},\\n {'id':'mof22_candidate','status':'unavailable','url':'https://kjs.mof.gov.cn/zhengcefabu/201704/t20170406_2579238.htm','reason':'HTTP 502; official ASBE/CAS 22/37 edition and transition remain uninspected.'},\\n {'id':'eu2023_1803','status':'uninspected','url':'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32023R1803','reason':'EUR-Lex returned HTTP 202 with zero retained bytes; no endorsed IAS 32/IFRS 9 treatment inferred.'}\\n]\\npayload={\\n 'schema_version':'accdsl.p08.authority-methods.v1',\\n 'phase':'P08',\\n 'created_at':datetime.now(timezone.utc).isoformat(),\\n 'authority_register_path':'docs/design/research/p08-v1/authority-register.json',\\n 'authority_register_sha256':digest(reg_path),\\n 'authorities':reg['authorities'],\\n 'claims':reg['claims'],\\n 'source_access':reg['access_attempts'],\\n 'access_blocks':access_blocks,\\n 'operations':[operation],\\n 'cases':cases,\\n 'comparisons':comparison,\\n 'research':reg['research'],\\n 'method_queue':reg['method_queue'],\\n 'evidence_contract':{\\n   'question':'Can applicable