)}\\n        if any(v<0 or v>1 for v in ls.values()):raise ValueError('invalid event likelihood')\\n        weights=[rational(a['weight'])*ls[a['id']] for a in self.atoms]; total=sum(weights)\\n        if total==0:raise ValueError('zero-probability conditioning')\\n        new=[dict(a,weight=str(w/total)) for a,w in zip(self.atoms,weights)]\\n        return FiniteMeasure(new,self.justification,self.used|blocks)\\n    def event(self, ids):\\n        ids=set(ids)\\n        if ids-{a['id'] for a in self.atoms}:raise ValueError('unknown atom')\\n        return sum((rational(a['weight']) for a in self.atoms if a['id'] in ids),F(0))\\n    def summary(self):\\n        mass={};mean=F(0);available=True\\n        for a in self.atoms:\\n            w=rational(a['weight']); status=a['status'];mass[status]=mass.get(status,F(0))+w\\n            if a.get('outcome') is None:\\n                if w:available=False\\n            else:mean+=w*rational(a['outcome'])\\n        return {'mass':{k:str(v) for k,v in mass.items()},'mean':str(mean) if available else None,\\n                'normalised_over_successful_only':False}\\n\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Execute P04 obligations, regress P03, and retain supervisor inventory evidence.\\\"\\\"\\\"\\nimport argparse\\nfrom collections import Counter\\nfrom datetime import datetime, timezone\\nimport hashlib\\nimport io\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport platform\\nimport re\\nimport shlex\\nimport sys\\nimport time\\nimport unittest\\nimport z3\\nfrom check_accounting_p03 import capture_protection, finish_protection, digest, _inventory, _unique_object\\nROOT=Path(__file__).resolve().parents[1]\\nHISTORICAL_INVENTORY='data/accounting-master/runs/20261002T221346-d54a6552/P04/phase-entry-inventory.json'\\nORIGINAL_PLAN='data/accounting-master/runs/20261002T221346-d54a6552/P04/approved-plan.json'\\nSOURCES=['scripts/rational_solver_v1.py','scripts/reconstruction_v1.py','scripts/check_accounting_p04.py','tests/test_accounting_p04.py','docs/design/spec/reconstruction-profile-v1.md','docs/design/fixtures/p04-reconstruction-cases-v1.json']\\nOUTPUTS=['data/accounting-master/deliverables/P04/'+p for p in ('conformance.json','result.md','progress.md')]\\n\\ndef repository_path(root, relative):\\n    path=Path(relative)\\n    if (path.is_absolute() or '..' in path.parts or path.as_posix()!=relative\\n            or not (root/path).resolve().is_relative_to(root.resolve())):\\n        raise ValueError('provenance path must be repository-relative and remain inside the repository')\\n    return path\\n\\n\\ndef approval_reference(root, relative):\\n    path=repository_path(root,relative)\\n    raw=(root/path).read_bytes()\\n    record=json.loads(raw,object_pairs_hook=_unique_object)\\n    if not isinstance(record,dict):\\n        raise ValueError('approval must be an object')\\n    for name,verdict in (('plan','PLAN'),('review','AGREE')):\\n        response=record.get(name)\\n        if not isinstance(response,dict) or response.get('verdict')!=verdict:\\n            raise ValueError('approval requires a PLAN and an AGREE review')\\n68:starting date, scenario definitions, accounting packages, management policies,\\n80:Management behaviour normally uses only information available at the decision\\n95:events and decisions; accrual and measurement; settlement; period closing and\\n100:irrelevant to the result. If payment before remeasurement and payment after\\n101:remeasurement differ, an unresolved ordering is a model ambiguity or an error.\\n106:    verify prerequisites and information availability\\n107:    resolve applicable measurement and recognition rules\\n108:    compute proposed economic changes and measurements\\n119:stores its adjustments separately. A failure in one scenario branch cannot\\n125:profit; tax and investment affect funding needs; funding affects interest.\\n199:hedges and foreign currency require additional event and measurement rules.\\n214:period, scenario and interpretation. A comparative table cannot combine an\\n232:assumption IDs and an information-view ID. Amounts are exact before the\\n285:\\\\section{Scenario meaning and information access}\\n295:The textual Core 0 \\\\code{scenario} declaration is an exogenous stress only;\\n298:At each decision date the runtime constructs an information view containing\\n311:remains due, record an economic funding failure and the unpaid obligation.\\ntests/test_accounting_p02.py\\ntests/test_accounting_master.py\\ntests/test_accounting_p04.py\\ntests/test_accounting_p03.py\\ndocs/design/fixtures/corpus-protocol.json\\ndocs/design/fixtures/p04-reconstruction-cases-v1.json\\ndocs/design/fixtures/p03-lowering-cases-v1.json\\ndocs/design/fixtures/demo-debt-package.json\\ndocs/design/fixtures/core-demo-registry.json\\ndocs/design/fixtures/temporal.json\\ndocs/design/fixtures/core-ir-demo.json\\ndocs/design/fixtures/core-ir-structure.json\\ndocs/design/fixtures/borrowing.acc\\ndocs/design/fixtures/northstar.json\\ndocs/design/fixtures/sectors.json\\ndocs/design/fixtures/borrowings.json\\ndocs/design/spec/core-contract.md\\ndocs/design/spec/core0-lowering-profile-v1.md\\ndocs/design/spec/reconstruction-profile-v1.md\\ndocs/design/spec/core-ir.schema.json\\ndocs/design/spec/core-0.lark\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 -B - <<'PY'\\nimport json,pathlib\\nx=json.loads(pathlib.Path('scripts/accounting_master_catalog.json').read_text())\\nrows=x.get('phases',[]) if isinstance(x,dict) else x\\nif isinstance(rows,dict): rows=list(rows.values())\\nfor r in rows:\\n if r.get('id')=='P05': print(json.dumps(r))\\nx=json.loads(pathlib.Path('docs/design/fixtures/p04-reconstruction-cases-v1.json').read_text());print('P04 keys',list(x))\\nfor k,v in x.items():\\n if isinstance(v,list):print(k,[r.get('id',r.get('name','')) for r in v if isinstance(r,dict)])\\np=pathlib.Path('/home/chakwong/python/claudecodex/policies/global-scientific-coding-agent-policy.md');t=p.read_text(); print('policy headings',[s for s in t.splitlines() if s.startswith('## ')])\\nPY\\nsed -n '1,24p' data/accounting-master/next-plan.md\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 -B - <<'PY'\\nimport json,pathlib\\nx=json.loads(pathlib.Path('scripts/accounting_master_catalog.json').read_text())\\nrows=x.get('phases',[]) if isinstance(x,dict) else x\\nif isinstance(rows,dict): rows=list(rows.values())\\nfor r in rows:\\n if r.get('id')=='P05': print(json.dumps(r))\\nx=json.loads(pathlib.Path('docs/design/fixtures/p04-reconstruction-cases-v1.json').read_text());print('P04 keys',list(x))\\nfor k,v in x.items():\\n if isinstance(v,list):print(k,[r.get('id',r.get('name','')) for r in v if isinstance(r,dict)])\\np=pathlib.Path('/home/chakwong/python/claudecodex/policies/global-scientific-coding-agent-policy.md');t=p.read_text(); print('policy headings',[s for s in t.splitlines() if s.startswith('## ')])\\nPY\\nsed -n '1,24p' data/accounting-master/next-plan.md\\\"\",\"aggregated_output\":\"{\\\"id\\\": \\\"P05\\\", \\\"kind\\\": \\\"worker\\\", \\\"name\\\": \\\"Execute the bounded company path\\\", \\\"deps\\\": [\\\"P03\\\", \\\"P04\\\"], \\\"gaps\\\": [\\\"G4\\\", \\\"G5\\\", \\\"G14\\\", \\\"G18\\\"], \\\"requirements\\\": [\\\"MC13\\\", \\\"MC14\\\", \\\"MC15\\\", \\\"MC16\\\", \\\"MC17\\\", \\\"MC18\\\", \\\"MC28\\\"], \\\"objective\\\": \\\"Build an executable Northstar economic-event -> state/journal -> statements path using the existing known-history cases. Produce balance sheet, income/OCI, cash-flow and equity outputs from common journals; preserve event failures and supported scenario/history branches. Apply a supported bounded path to the prepared real case without inventing