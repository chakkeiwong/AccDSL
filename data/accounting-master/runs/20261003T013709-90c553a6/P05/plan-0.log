xtures.py\\nsed -n '1,135p' scripts/check_repair_conformance.py\\\"\",\"aggregated_output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Author-entered design fixtures. Expected values are not calculated here.\\n\\nThis is not an importer, accounting engine or inference implementation.\\nThe separate checker evaluates journals/constraints against these expectations.\\n\\\"\\\"\\\"\\nimport json\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parents[1]\\nOUT = ROOT / 'docs/design/fixtures'\\n\\ndef write(name, data):\\n    OUT.mkdir(parents=True, exist_ok=True)\\n    (OUT / name).write_text(json.dumps(data, indent=2, ensure_ascii=False) + '\\\\n')\\n\\ndef event(id, date, period, postings, cash_class=None, **state):\\n    return dict(id=id, date=date, period=period,\\n                postings=[dict(account=a, signed_amount=str(v)) for a, v in postings],\\n                cash_class=cash_class, state_changes=state)\\n\\ndef main():\\n    accounts = {\\n        'cash':'asset', 'receivables':'asset', 'inventory':'asset', 'plant_cost':'asset',\\n        'accum_depreciation':'contra_asset', 'tax_prepaid':'asset', 'payables':'liability',\\n        'debt':'liability', 'capital':'equity', 'retained':'equity', 'revenue':'income',\\n        'cost_of_sales':'expense', 'payroll':'expense', 'depreciation':'expense',\\n        'interest':'expense', 'tax':'expense'}\\n    opening = dict(cash='60', receivables='20', inventory='30', plant_cost='100',\\n                   accum_depreciation='-20', tax_prepaid='0', payables='-20',\\n                   debt='-100', capital='-50', retained='-20')\\n    events=[]\\n    for period,date,rows in [\\n        ('2024H1','2024-06-30',[\\n            ('sale',[('receivables',110),('revenue',-110)],None),\\n            ('collect',[('cash',110),('receivables',-110)],'operating'),\\n            ('buy',[('inventory',70),('payables',-70)],None),\\n            ('supplier',[('payables',65),('cash',-65)],'operating'),\\n            ('deliver',[('cost_of_sales',75),('inventory',-75)],None),\\n            ('wages',[('payroll',20),('cash',-20)],'operating'),\\n            ('plant',[('plant_cost',10),('cash',-10)],'investing'),\\n            ('depreciate',[('depreciation',5),('accum_depreciation',-5)],None),\\n            ('interest',[('interest','2.5'),('cash','-2.5')],'operating'),\\n            ('tax',[('tax','1.5'),('tax_prepaid',2),('cash','-3.5')],'operating'),\\n            ('dividend',[('retained',4),('cash',-4)],'financing')]),\\n        ('2024H2','2024-12-31',[\\n            ('sale',[('receivables',150),('revenue',-150)],None),\\n            ('collect',[('cash',135),('receivables',-135)],'operating'),\\n            ('buy',[('inventory',85),('payables',-85)],None),\\n            ('supplier',[('payables',80),('cash',-80)],'operating'),\\n            ('deliver',[('cost_of_sales',90),('inventory',-90)],None),\\n            ('wages',[('payroll',22),('cash',-22)],'operating'),\\n            ('plant',[('plant_cost',12),('cash',-12)],'investing'),\\n            ('depreciate',[('depreciation',6),('accum_depreciation',-6)],None),\\n            ('interest',[('interest','2.5'),('cash','-2.5')],'operating'),\\n            ('tax',[('tax','5.9'),('tax_prepaid',-2),('cash','-3.9')],'operating'),\\n            ('dividend',[('retained',5),('cash',-5)],'financing')])]:\\n        for name,postings,cls in rows:events.append(event(period+'.'+name,date,period,postings,cls))\\n    write('northstar.json',dict(\\n        schema='accdsl-design-fixture/1', entity='Northstar Components (synthetic)',\\n        currency='USD', units='one currency unit', basis='DemoCorporate/1; not GAAP certification',\\n        disclosure_scope='Closed synthetic goods company; the listed source package is complete by construction',\\n        assumptions={\\n            'historical_resolution':'half-year aggregate flows; existence of intraperiod schedules required, not recovered invoices',\\n            'inventory':'one homogeneous good at cost 5; purchases before delivery; quantities equal costs/5',\\n            'sales':'delivery transfers control; no returns, services, variable consideration or foreign currency',\\n            'tax':'20% positive taxable profit, all expenses deductible, no deferred tax; excess payment is prepaid tax',\\n            'plant':'opening cost 100, annual depreciation 10; end-H1 addition 10 lives 5 years; end-H2 addition 12 lives 12 years; zero residuals',\\n            'debt':'100 throughout; fixed and floating both 5% in 2024; fixed 5%, floating resets to 7% in 2025; all maturities after forecast',\\n            'time':'half-year accrual fractions 1/2, annual 1; explicit teaching convention',\\n            'closing':'temporary accounts closed after each H1/H2; annual income uses movements excluding closing',\\n            'universe':'no omitted company, OCI, acquisition, tax or off-balance-sheet operations inside this synthetic package'},\\n        accounts=accounts, opening=opening, historical_events=events,\\n        expected={\\n            '2024H1':dict(cash='65',receivables='20',inventory='25',plant_net='85',tax_prepaid='2',assets='197',payables='25',debt='100',equity='72',revenue='110',profit='6',operating_cash='19',investing_cash='-10',financing_cash='-4'),\\n            '2024H2':dict(cash='74.6',receivables='35',inventory='20',plant_net='91',tax_prepaid='0',assets='220.6',payables='30',debt='100',equity='90.6',revenue='150',profit='23.6',operating_cash='26.6',investing_cash='-12',financing_cash='-5'),\\n            '2024FY':dict(revenue='260',profit='29.6',operating_cash='45.6',investing_cash='-22',financing_cash='-9',cash_change='14.6'),\\n            '2025_fixed':dict(cash='95.2',receivables='55',inventory='40',plant_net='98',tax_prepaid='0',assets='288.2',payables='40',debt='100',equity='148.2',revenue='300',profit='65.6',interest='5',tax='16.4',operating_cash='48.6',investing_cash='-20',financing_cash='-8'),\\n            '2025_floating':dict(cash='93.6',receivables='55',inventory='40',plant_net='98',tax_prepaid='0',assets='286.6',payables='40',debt='100',equity='146.6',revenue='300',profit='64',interest='7',tax='16',operating_cash='47',investing_cash='-20',financing_cash='-8')},\\n        forecast=dict(start='2025-01-01',end_exclusive='2026-01-01',\\n            demand_units='30',price='10',unit_cost='5',target_inventory_units='8',\\n            current_sales_collection_fraction='0.9',legacy_receivable_collections='10',\\n            old_payables_paid='30',new_purchases_paid='130',payroll='50',\\n            capex_at_period_end='20',dividend='8',tax_rate='0.2',funding_limit='0'),\\n        coverage_units=[\\n            dict(id='NS.opening',kind='statement',disposition='structured',content='Opening balance sheet and account balances'),\\n            dict(id='NS.h1.original',kind='statement',disposition='superseded_reading_preserved',content='Originally revenue 120, receivables 30, tax expense/payment 3.5, profit 14, equity 80'),\\n            dict(id='NS.h1.correction',kind='note',disposition='structured',content='Premature invoice 10: reverse revenue and receivable; reduce tax expense 2 into tax prepayment; corrected profit 6'),\\n            dict(id='NS.fy',kind='statement',disposition='structured',content='Annual and revised interim statements derived from listed events'),\\n            dict(id='NS.operations',kind='policy',disposition='structured',content='Goods, inventory, asset and working-capital assumptions above'),\\n            dict(id='NS.debt',kind='note',disposition='alternative_family',content='Principal 100, interest 5; fixed/floating composition undisclosed'),\\n            dict(id='NS.equity',kind='note',disposition='structured',content='Capital 50; original retained 20; dividends H1 4, H2 5'),\\n            dict(id='NS.reference',kind='cross_reference',disposition='resolved',target='NS.debt',content='Financing note applies to debt and interest in every statement')]))\\n    write('temporal.json',dict(\\n        availability_policy='date-only filing is available at next midnight in stated reporting timezone',\\n        assertions=[\\n            dict(id='h1-original',key='revenue:H1:USD:NS:Demo',value='120',available='2024-08-01T00:00:00Z',ingested='2024-08-03T00:00:00Z',vintage='v1',supersedes=[]),\\n            dict(id='h1-restated',key='revenue:H1:USD:NS:Demo',value='110',available='2025-03-02T00:00:00Z',ingested='2025-03-05T00:00:00Z',vintage='v2',supersedes=['h1-original']),\\n            dict(id='fy',key='revenue:FY:USD:NS:Demo',value='260',available='2025-03-02T00:00:00Z',ingested='2025-03-05T00:00:00Z',vintage='v2',supersedes=[])],\\n        queries=[\\n            dict(cutoff='2024-09-01T00:00:00Z',system_as_of=None,expect=['h1-original']),\\n            dict(cutoff='2025-03-03T00:00:00Z',system_as_of=None,expect=['h1-restated','fy']),\\n            dict(cutoff='2025-03-03T00:00:00Z',system_as_of='2025-03-04T00:00:00Z',expect=['h1-original']),\\n            dict(cutoff='2025-03-06T00:00:00Z',system_as_of=None,mode='original',expect=['h1-original','fy'])],\\n        expected_valid_h2='150', incompatible_vintage_h2='140 must be rejected'))\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Deterministic reference checks for the design, not a product test suite.\\n\\nUses independently authored expectations and exact arithmetic. Z3 checks the\\ndocument's supported rational-linear constraints; no statistical claim follows.\\n\\\"\\\"\\\"\\nfrom collections import defaultdict\\nfrom copy import deepcopy\\nfrom fractions import Fraction as Q\\nimport hashlib\\nimport json\\nfrom pathlib import Path\\nimport platform\\nimport time\\nimport z3\\n\\nROOT=Path(__file__).resolve().parents[1]\\nFIX=ROOT/'docs/design/fixtures'\\nchecks=[]\\n\\ndef load(name): return json.loads((FIX/name).read_text())\\ndef check(name, condition, detail):\\n    checks.append(dict(name=name,passed=bool(condition),detail=detail))\\n    if not condition: raise AssertionError(name+': '+str(detail))\\n\\ndef post(state, e, committed):\\n    \\\"\\\"\\\"Local oracle for atomic double-entry/idempotency, deliberately small.\\\"\\\"\\\"\\n    payload=json.dumps(e,sort_keys=True,separators=(',',':'))\\n    if e['id'] in committed:\\n        if committed[e['id']]!=payload: raise ValueError('EventIdentityConflict')\\n        return\\n    entries=[(p['account'],Q(p['signed_amount'])) for p in e['postings']]\\n    if sum(v for _,v in entries)!=0: raise ValueError('UnbalancedBatch')\\n    proposed=deepcopy(state)\\n    for a,v in entries: proposed[a]+=v\\n    state.clear(); state.update(proposed); committed[e['id']]=payload\\n\\ndef report_close(state, events, roles, period):\\n    selected=[e for e in events if e['period']==period]\\n    flows=defaultdict(Q)\\n    for e in selected:\\n        for p in e['postings']:\\n            if p['account']=='cash' and e['cash_class']:\\n                flows[e['cash_class']]+=Q(p['signed_amount'])\\n    profit=-sum(v for a,v in state.items() if roles[a] in ['income','expense'])\\n    revenue=-state['revenue']\\n    interest,tax=state['interest'],state['tax']\\n    # Closing is independent of the event generator; no cash arises here.\\n    for a in list(state):\\n        if roles[a] in ['income','expense']:\\n            state['retained']+=state[a];state[a]=Q(0)\\n    result=dict(cash=state['cash'],receivables=state['receivables'],inventory=state['inventory'],\\n        plant_net=state['plant_cost']+state['accum_depreciation'],tax_prepaid=state['tax_prepaid'],\\n        assets=sum(v for a,v in state.items() if roles[a] in ['asset','contra_asset']),\\n        payables=-state['payables'],debt=-state['debt'],\\n        equity=-sum(v for a,v in state.items() if roles[a]=='equity'),\\n        revenue=revenue,profit=profit,interest=interest,tax=tax,\\n        operating_cash=flows['operating'],investing_cash=flows['investing'],financing_cash=flows['financing'])\\n    check('balanced_'+period,sum(state.values())==0 and result['assets']==result['payables']+result['debt']+result['equity'],str(result))\\n    return result\\n\\ndef compare(name,actual,expected):\\n    check(name,all(actual[k]==Q(v) for k,v in expected.items()),{k:str(actual[k]) for k in expected})\\n\\ndef corporate():\\n    f=load('northstar.json'); state=defaultdict(Q,{k:Q(v) for k,v in f['opening'].items()}); committed={}\\n    check('opening_balance',sum(state.values())==0,'Signed account total is zero')\\n    periods={}\\n    for period in ['2024H1','2024H2']:\\n        for e in f['historical_events']:\\n            if e['period']==period:post(state,e,committed)\\n        periods[period]=report_close(state,f['historical_events'],f['accounts'],period)\\n        compare(period,periods[period],f['expected'][period])\\n    annual={k:sum(r[k] for r in periods.values()) for k in ['revenue','profit','operating_cash','investing_cash','financing_cash']}\\n    annual['cash_change']=state['cash']-Q(f['opening']['cash'])\\n    compare('annual_statements',annual,f['expected']['2024FY'])\\n    # Inverse construction from observed bridges. F,V remain a joint family.\\n    sales,collection,purchase,payment,cost,F,V=z3.Reals('sales collection purchase payment cost F V')\\n    constraints=[sales==260,35==20+sales-collection,20==30+purchase-cost,\\n        30==20+purchase-payment,cost==165,F>=0,V>=0,F+V==100,QZ('0.05')*(F+V)==5]\\n    solver=z3.Solver();solver.add(*constraints)\\n    check('reconstruction_feasible',solver.check()==z3.sat,'Closed scope annual bridge family')\\n    for x,value in [(collection,245),(purchase,155),(payment,145)]:\\n        solver.push();solver.add(x!=value); r=solver.check();solver.pop()\\n        check('recovered_'+str(x),r==z3.unsat,str(value))\\n    for fixed in [0,25,100]:\\n        solver.push();solver.add(F==fixed);r=solver.check();solver.pop()\\n        check('family_retains_fixed_'+str(fixed),r==z3.sat,'Different exposures with same historical interest')\\n    solver.push();solver.add(F==101);r=solver.check();solver.pop()\\n    check('impossible_debt_mix_rejected',r==z3.unsat,'Nonnegative floating amount forbids F=101')\\n    forecast=f['forecast']\\n    for branch,interest in [('fixed',Q(5)),('floating',Q(7))]:\\n        s=deepcopy(state); events=[]\\n        def e(name,entries,cls=None):\\n            record=dict(id='2025.'+name,period='2025_'+branch,date='2025-12-31',cash_class=cls,\\n                        postings=[dict(account=a,signed_amount=str(v)) for a,v in entries])\\n            events.append(record); post(s,record,{})\\n        demand=Q(forecast['demand_units']);price=Q(forecast['price']);cost=Q(forecast['unit_cost'])\\n        purchases=(demand+Q(forecast['target_inventory_units'])-s['inventory']/cost)*cost\\n        sales=demand*price; cogs=demand*cost\\n        collections=Q(forecast['current_sales_collection_fraction'])*sales+Q(forecast['legacy_receivable_collections'])\\n        suppliers=Q(forecast['old_payables_paid'])+Q(forecast['new_purchases_paid'])\\n        depreciation=Q(10)+Q(10)/5+Q(12)/12\\n        tax=(sales-cogs-Q(forecast['payroll'])-depreciation-interest)*Q(forecast['tax_rate'])\\n        e('sale',[('receivables',sales),('revenue',-sales)])\\n        e('collect',[('cash',collections),('receivables',-collections)],'operating')\\n        e('purchase',[('inventory',purchases),('payables',-purchases)])\\n        e('supplier',[('payables',suppliers),('cash',-suppliers)],'operating')\\n        e('deliver',[('cost_of_sales',cogs),('inventory',-cogs)])\\n        e('payroll',[('payroll',50),('cash',-50)],'operating')\\n        e('capex',[('plant_cost',20),('cash',-20)],'investing')\\n        e('depreciate',[('depreciation',depreciation),('accum_depreciation',-depreciation)])\\n        e('interest',[('interest',interest),('cash',-interest)],'operating')\\n        e('tax',[('tax',tax),('cash',-tax)],'operating')\\n        e('dividend',[('retained',8),('cash',-8)],'financing')\\n        result=report_close(s,events,f['accounts'],'2025_'+branch)\\n        compare('forecast_'+branch,result,f['expected']['2025_'+branch])\\n        check('direct_indirect_cash_'+branch,\\n              result['operating_cash']==result['profit']+depreciation-(s['receivables']-state['receivables'])-(s['inventory']-state['inventory'])-(s['payables']-state['payables']),\\n              'Profit + noncash depreciation - asset increases + liability increases')\\n    # Failure checks exercise atomicity and replay, not just successful sums.\\n    s=defaultdict(Q);done={}; good=dict(id='e',postings=[dict(account='cash',signed_amount='1'),dict(account='capital',signed_amount='-1')])\\n    post(s,good,done);post(s,good,done)\\n    check('event_idempotency',s['cash']==1,'Second identical event is a no-op')\\n    changed=deepcopy(good);changed['postings'][0]['signed_amount']='2'\\n    try:post(s,changed,done);raise AssertionError('Expected identity error')\\n    except ValueError as ex:check('event_identity_conflict',str(ex)=='EventIdentityConflict' and s['cash']==1,'Same ID different inputs rejected')\\n    changed['id']='bad'\\n    try:post(s,changed,done);raise AssertionError('Expected imbalance')\\n    except ValueError as ex:check('atomic_rejection',str(ex)=='UnbalancedBatch' and s['cash']==1 and 'bad' not in done,'No partial state/journal mutation')\\n\\ndef QZ(x):\\n    q=Q(x);return z3.RealVal(str(q.numerator)+'/'+str(q.denominator))\\n\\ndef bounds_and_weights():\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"rg -n '\\\"'^'\\\"\\\\\\\\\\\\\\\\(section|subsection)|Northstar|information|Information|atomic|default|conditional|revolv|intervention|behaviour|measurement' docs/design/chapters/07-execution.tex docs/design/chapters/13-reference-company.tex\\nsed -n '1,115p' scripts/reconstruction_v1.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"rg -n '\\\"'^'\\\"\\\\\\\\\\\\\\\\(section|subsection)|Northstar|information|Information|atomic|default|conditional|revolv|intervention|behaviour|measurement' docs/design/chapters/07-execution.tex docs/design/chapters/13-reference-company.tex\\nsed -n '1,115p' scripts/reconstruction_v1.py\\\"\",\"aggregated_output\":\"docs/design/chapters/13-reference-company.tex:4:\\\\section{What a balance must remember}\\ndocs/design/chapters/13-reference-company.tex:6:Northstar Components is a synthetic seller of one homogeneous good. Its\\ndocs/design/chapters/13-reference-company.tex:15:At the beginning of 2024, Northstar holds cash of 60, receivables of 20,\\ndocs/design/chapters/13-reference-company.tex:49:good transfers control and creates an unconditional receivable; invoicing is\\ndocs/design/chapters/13-reference-company.tex:65:\\\\section{Recovering movements without inventing invoices}\\ndocs/design/chapters/13-reference-company.tex:69:totals are hidden. Under Northstar's explicit no-write-off, no-acquisition and\\ndocs/design/chapters/13-reference-company.tex:85:$0.05F+0.05V=5$. The last equality adds no information about the split.\\ndocs/design/chapters/13-reference-company.tex:86:Both endpoints and every intermediate allocation survive. Northstar therefore\\ndocs/design/chapters/13-reference-company.tex:99:\\\\section{The complete historical statements}\\ndocs/design/chapters/13-reference-company.tex:136:use different information and therefore provide a useful check on classification.\\ndocs/design/chapters/13-reference-company.tex:138:\\\\section{A correction changes what was knowable}\\ndocs/design/chapters/13-reference-company.tex:150:available on 2 March 2025 and are ingested on 5 March. An investor-information\\ndocs/design/chapters/13-reference-company.tex:162:\\\\section{One economic scenario, several complete futures}\\ndocs/design/chapters/13-reference-company.tex:172:These decisions are inputs to a conditional forecast. They are not estimates\\ndocs/design/chapters/13-reference-company.tex:206:\\\\section{Apple: source labels do not identify exposure}\\ndocs/design/chapters/13-reference-company.tex:233:three measurements may replace another merely because a table calls it debt.\\ndocs/design/chapters/13-reference-company.tex:238:neither a liability carrying amount nor sufficient information for an exact\\ndocs/design/chapters/13-reference-company.tex:256:uses the annual notional as a conditional input; it is not asserted to be the\\ndocs/design/chapters/13-reference-company.tex:264:conditional added interest lies in $[0,72.875]$ before monetary rounding. That\\ndocs/design/chapters/13-reference-company.tex:267:coherent marginal propagation. Northstar supplies the complete-company\\ndocs/design/chapters/07-execution.tex:4:\\\\section{Ingest, reconcile and construct histories}\\ndocs/design/chapters/07-execution.tex:65:\\\\section{Condition a run without rewriting history}\\ndocs/design/chapters/07-execution.tex:70:an exact symbolic family, a finite set of conditional histories, or weighted\\ndocs/design/chapters/07-execution.tex:73:Suppose no debt maturity is disclosed. An analyst may run a conditional case\\ndocs/design/chapters/07-execution.tex:80:Management behaviour normally uses only information available at the decision\\ndocs/design/chapters/07-execution.tex:88:\\\\section{Schedule and commit events}\\ndocs/design/chapters/07-execution.tex:95:events and decisions; accrual and measurement; settlement; period closing and\\ndocs/design/chapters/07-execution.tex:100:irrelevant to the result. If payment before remeasurement and payment after\\ndocs/design/chapters/07-execution.tex:101:remeasurement differ, an unresolved ordering is a model ambiguity or an error.\\ndocs/design/chapters/07-execution.tex:106:    verify prerequisites and information availability\\ndocs/design/chapters/07-execution.tex:107:    resolve applicable measurement and recognition rules\\ndocs/design/chapters/07-execution.tex:108:    compute proposed economic changes and measurements\\ndocs/design/chapters/07-execution.tex:111:    atomically commit state, journals and explanation edges\\ndocs/design/chapters/07-execution.tex:115:The atomic unit includes the economic state and its accounting effects.\\ndocs/design/chapters/07-execution.tex:122:\\\\section{Funding, tax and other simultaneous relations}\\ndocs/design/chapters/07-execution.tex:143:cash positive. An inability to meet payments may be a legitimate default\\ndocs/design/chapters/07-execution.tex:147:\\\\section{Worked example: identical history, different future journals}\\ndocs/design/chapters/07-execution.tex:173:\\\\section{Worked example: a bond has several relevant amounts}\\ndocs/design/chapters/07-execution.tex:176:Assume a 5\\\\% effective rate per period, no transaction costs, no default, and\\ndocs/design/chapters/07-execution.tex:199:hedges and foreign currency require additional event and measurement rules.\\ndocs/design/chapters/07-execution.tex:209:\\\\section{Reporting and explanations}\\ndocs/design/chapters/07-execution.tex:226:\\\\section{The corporate reference package as operations}\\ndocs/design/chapters/07-execution.tex:228:The Northstar example defines a closed, reproducible corporate package rather\\ndocs/design/chapters/07-execution.tex:232:assumption IDs and an information-view ID. Amounts are exact before the\\ndocs/design/chapters/07-execution.tex:238:removed at selected cost; unconditional amount due added & Debit receivable,\\ndocs/design/chapters/07-execution.tex:279:operation: Northstar's collections, suppliers, payroll, interest and taxes\\ndocs/design/chapters/07-execution.tex:285:\\\\section{Scenario meaning and information access}\\ndocs/design/chapters/07-execution.tex:290:in Chapter~\\\\ref{ch:math} evaluates the conditional distribution when its\\ndocs/design/chapters/07-execution.tex:294:intervention inferred from an accounting identity \\\\citep[Section 3.2.1]{pearl2009}.\\ndocs/design/chapters/07-execution.tex:298:At each decision date the runtime constructs an information view containing\\ndocs/design/chapters/07-execution.tex:304:forecast distribution of defaults; it must not inspect the outer simulation's\\ndocs/design/chapters/07-execution.tex:305:future realised default. Inner valuation randomness has a separate stream\\n\\\"\\\"\\\"Declared-template reconstruction and bounded uncertainty operations, version 1.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom fractions import Fraction as F\\nimport hashlib\\nimport json\\nimport z3\\nfrom rational_solver_v1 import (Problem, Budget, UnsupportedFragment, q, rational, domain_formula,\\n                                disclosure_domain, half_even, solve)\\n\\n\\nADMISSION_FIELDS = {\\n    'ExtractionReading': ('source', 'locator', 'review_decision'),\\n    'HistoricalFact': ('evidence', 'reason'),\\n    'AccountingElection': ('package', 'permitted_treatments', 'election', 'effective_date', 'eligibility_evidence'),\\n    'MeasurementEstimate': ('method', 'measurement_date', 'inputs'),\\n    'BehaviourPolicy': ('policy', 'information_set', 'decision_time'),\\n    'FutureInnovation': ('driver', 'future_period', 'scenario', 'joint_law', 'measure'),\\n}\\n\\n\\ndef admit(record):\\n    kind = record.get('kind')\\n    if kind not in ADMISSION_FIELDS:\\n        raise ValueError('unknown uncertainty category')\\n    for key in ('id', 'scope', 'provenance', 'dependencies') + ADMISSION_FIELDS[kind]:\\n        if key not in record or (key != 'dependencies' and not record[key]):\\n            raise ValueError('missing admission field: ' + key)\\n    if not isinstance(record['dependencies'], list) or not isinstance(record['provenance'], list):\\n        raise ValueError('dependencies and provenance must be explicit lists')\\n    if kind == 'ExtractionReading' and record['review_decision'] != 'Accept':\\n        raise ValueError('extraction reading is not accepted')\\n    if kind == 'AccountingElection' and record['election'] not in record['permitted_treatments']:\\n        raise ValueError('treatment not permitted by declared package')\\n    return deepcopy(record)\\n\\n\\ndef expression(node, env):\\n    if isinstance(node, bool):\\n        return z3.BoolVal(node)\\n    if isinstance(node, (str, int, F)):\\n        return env[node] if isinstance(node, str) and node in env else q(node)\\n    if not isinstance(node, list) or not node:\\n        raise ValueError('expression must be exact scalar, reference or operation list')\\n    op, *args = node\\n    args = [expression(x, env) for x in args]\\n    ops = {'+': lambda a,b:a+b, '-': lambda a,b:a-b, '*': lambda a,b:a*b,\\n           '/': lambda a,b:a/b, '==': lambda a,b:a==b, '<=': lambda a,b:a<=b,\\n           '>=': lambda a,b:a>=b, '<': lambda a,b:a<b, '>': lambda a,b:a>b,\\n           'and': lambda *a:z3.And(*a), 'or': lambda *a:z3.Or(*a),\\n           'not': lambda a:z3.Not(a), 'implies': lambda a,b:z3.Implies(a,b)}\\n    if op not in ops:\\n        raise UnsupportedFragment('unknown operation: ' + op)\\n    return ops[op](*args)\\n\\n\\ndef construct(spec):\\n    if spec.get('schema_version') != 'accdsl.reconstruction.input.v1':\\n        raise ValueError('unsupported reconstruction schema')\\n    p = Problem(spec['scope'], spec['evidence_view'], exclusions=list(spec['exclusions']),\\n                obligations=list(spec['obligations']), rounding_stage=spec['rounding_stage'])\\n    if p.rounding_stage not in ('exact_rational', 'posting_half_even_quantized_units'):\\n        raise ValueError('unsupported or undeclared rounding stage')\\n    if len(set(spec['dates'])) != len(spec['dates']):\\n        raise ValueError('duplicate dates')\\n    date_index = {d: i for i, d in enumerate(spec['dates'])}\\n    context = spec['context']; env = {}\\n    records = [admit(a) for a in spec['admissions']]\\n    if len({r['id'] for r in records}) != len(records):\\n        raise ValueError('duplicate admission')\\n    admitted_ids = {r['id'] for r in records}\\n    if any(set(r['dependencies']) - admitted_ids for r in records):\\n        raise ValueError('unresolved admission dependency')\\n    p.provenance = {'input_sha256': hashlib.sha256(json.dumps(spec, sort_keys=True).encode()).hexdigest(),\\n                    'admissions': records, 'context': context, 'observation_sources': {}}\\n    def variable(name, kind, limits=None):\\n        if kind not in ('Bool', 'Int', 'Real'):\\n            raise ValueError('unsupported variable kind')\\n        if name in env:\\n            raise ValueError('duplicate economic identifier: ' + name)\\n        v = z3.Bool(name) if kind == 'Bool' else z3.Int(name) if kind == 'Int' else z3.Real(name)\\n        env[name] = v; p.variables[name] = v\\n        if kind == 'Bool':\\n            p.finite[name] = [False, True]\\n        elif kind == 'Int':\\n            if limits is None:\\n                p.unsupported.append('unbounded integer domain: ' + name)\\n            else:\\n                lo, hi = limits\\n                if type(lo) is not int or type(hi) is not int or lo > hi:\\n                    raise ValueError('invalid integer bounds')\\n                p.finite[name] = range(lo, hi+1)\\n        return v\\n    for c in spec['choices']:\\n        if not c['values'] or any(type(v) is not int for v in c['values']) or len(set(c['values'])) != len(c['values']):\\n            raise ValueError('finite choices need distinct integer codes')\\n        variable(c['id'], 'Int', [0,0]); p.finite[c['id']] = list(c['values'])\\n    for s in spec['symbols']:\\n        if s['kind'] not in ('Real', 'Int'):\\n            raise ValueError('unsupported symbol kind')\\n        v = variable(s['id'], s['kind'], s.get('integer_bounds'))\\n        p.add('domain:'+s['id'], domain_formula(v, s['domain']))\\n    registry = spec['templates']\\n    slots = []\\n    for row in spec['slots']:\\n        if row['template'] not in registry:\\n            raise ValueError('unregistered template')\\n        template = registry[row['template']]\\n        if not template['provenance']:\\n            raise ValueError('template provenance required')\\n        if sum(rational(v) for v in template['postings'].values()) != 0:\\n            raise ValueError('posting incidence must balance')\\n        amount = variable(row['id'], row['kind'], row.get('integer_bounds'))\\n        if p.rounding_stage == 'posting_half_even_quantized_units':\\n            if row['kind'] != 'Int' or rational(row['quantum']) <= 0:\\n                raise ValueError('posting quantisation requires bounded integer units and positive quantum')\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '88,162p' docs/design/chapters/07-execution.tex\\nsed -n '162,205p' docs/design/chapters/13-reference-company.tex\\nsed -n '24,62p' scripts/check_repair_conformance.py\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '88,162p' docs/design/chapters/07-execution.tex\\nsed -n '162,205p' docs/design/chapters/13-reference-company.tex\\nsed -n '24,62p' scripts/check_repair_conformance.py\\\"\",\"aggregated_output\":\"\\\\section{Schedule and commit events}\\n\\nEach event carries an economic occurrence time, accrual interval when relevant,\\nsettlement time, entity, contract or cohort identifier, currency, inputs and\\nprovenance. Its ordering key consists of date, declared phase, dependency edges\\nand a deterministic tie identifier. The reference phases are: opening and\\nscheduled contractual changes; market observations and rate resets; business\\nevents and decisions; accrual and measurement; settlement; period closing and\\nreporting. A contract can require a more specific dependency. These phases are\\nan engineering starting point, not a universal description of market timing.\\n\\nTwo events may share a tie order only if their order is either specified or\\nirrelevant to the result. If payment before remeasurement and payment after\\nremeasurement differ, an unresolved ordering is a model ambiguity or an error.\\nThe engine does not conceal it behind alphabetical event IDs.\\n\\n\\\\begin{lstlisting}\\nexecute_event(event, state, run_context):\\n    verify prerequisites and information availability\\n    resolve applicable measurement and recognition rules\\n    compute proposed economic changes and measurements\\n    compute proposed journal batch(es)\\n    validate types, contexts, balance, constraints and idempotency\\n    atomically commit state, journals and explanation edges\\n    return new state, emitted dependent events, diagnostics\\n\\\\end{lstlisting}\\n\\nThe atomic unit includes the economic state and its accounting effects.\\nIf posting fails, neither state changes. A repeated event ID with identical\\ninputs returns the existing result; the same ID with different inputs is a\\nconflict. Consolidation runs after entity books reach the required date and\\nstores its adjustments separately. A failure in one scenario branch cannot\\nmutate another branch's state.\\n\\n\\\\section{Funding, tax and other simultaneous relations}\\n\\nSome financial models have circular dependencies. Interest affects taxable\\nprofit; tax and investment affect funding needs; funding affects interest.\\nThe reference executor first tries to resolve these through explicit timing.\\nFor example, beginning-of-period debt can determine current interest, with\\nnew borrowing affecting the next accrual period. That is acceptable only when\\nthe model's timing assumption is stated and appropriate.\\n\\nWhere the economic model genuinely requires simultaneous decisions, the\\ndependency graph identifies the strongly connected component and delegates it\\nto a declared equation or optimisation solver. The solver must return a\\nsolution, residuals, admissibility checks and uniqueness or multiplicity\\nstatus. A contraction iteration requires a justified convergence condition;\\nan arbitrary fixed iteration count is not a mathematical solution. Multiple\\nadmissible equilibria become alternatives when material. No solution produces\\na model outcome such as financing failure, or an explicit numerical failure,\\ndepending on the cause.\\n\\nFunding policy must include available facilities, limits, covenants, collateral\\nand allowed capital actions. The program cannot issue unlimited debt to keep\\ncash positive. An inability to meet payments may be a legitimate default\\noutcome. Default ends or changes contractual and accounting processes under\\nthe relevant event rules; it is not quietly discarded as a bad simulation draw.\\n\\n\\\\section{Worked example: identical history, different future journals}\\n\\nReturn to the company in Chapter~\\\\ref{ch:purpose}. Immediately after the\\nhistorical interest payment and closing, cash is 95, debt is 100 and equity\\nis $-5$. There are no other assets, liabilities or transactions. Next year's\\nexpense is 5 in the all-fixed branch and 7 in the all-floating branch under\\nthe rate shock. The generated entries and closing statements are:\\n\\n\\\\begin{center}\\n\\\\begin{tabular}{lrr}\\n\\\\toprule Output & All fixed & All floating\\\\\\\\\\\\midrule\\nDebit interest expense / credit cash &5&7\\\\\\\\\\nClosing cash &90&88\\\\\\\\\\nClosing debt &100&100\\\\\\\\\\nCurrent-year profit & $-5$ & $-7$\\\\\\\\\\nClosing equity after profit transfer &$-10$&$-12$\\\\\\\\\\n\\\\section{One economic scenario, several complete futures}\\n\\nFor 2025, assume demand for 30 units at price 10, unit purchase cost 5 and a\\ntarget closing inventory of eight units. Opening inventory is four units, so\\nthe purchase decision is $30+8-4=34$ units, costing 170. Deliveries cost 150,\\nleaving inventory of 40. Collect 90\\\\% of current sales and 10 of old\\nreceivables: $270+10=280$, leaving receivables of 55. Pay old suppliers 30\\nand 130 of the new purchases, leaving payables of 40. Payroll is 50, capital\\nexpenditure of 20 occurs at year-end and dividends are 8.\\n\\nThese decisions are inputs to a conditional forecast. They are not estimates\\nof demand or optimal management responses. No new borrowing is available.\\nUnder the existing asset schedules, depreciation is $10+10/5+12/12=13$.\\nThe new year-end asset begins depreciation in the next period. Let\\n$\\\\alpha=F/100$. With the floating rate resetting to 7\\\\%, interest is\\n$I=7-2\\\\alpha$. Profit before tax is\\n$300-150-50-13-I=80+2\\\\alpha$, giving tax $16+0.4\\\\alpha$ and profit\\n$64+1.6\\\\alpha$.\\n\\n\\\\begin{center}\\n\\\\begin{tabular}{lrr}\\n\\\\toprule 2025 statement amount & All fixed & All floating\\\\\\\\\\\\midrule\\nRevenue &300&300\\\\\\\\\\nInterest expense &5&7\\\\\\\\\\nTax expense &16.4&16\\\\\\\\\\nProfit and comprehensive income &65.6&64\\\\\\\\\\nOperating cash flow &48.6&47\\\\\\\\\\nInvesting cash flow &$-20$&$-20$\\\\\\\\\\nFinancing cash flow &$-8$&$-8$\\\\\\\\\\\\midrule\\nClosing cash &95.2&93.6\\\\\\\\\\nReceivables / inventory / net plant &55 / 40 / 98&55 / 40 / 98\\\\\\\\\\nAssets &288.2&286.6\\\\\\\\\\nPayables / debt &40 / 100&40 / 100\\\\\\\\\\nEquity &148.2&146.6\\\\\\\\\\\\bottomrule\\n\\\\end{tabular}\\n\\\\end{center}\\n\\nThe joint symbolic result is cash $93.6+1.6\\\\alpha$, profit\\n$64+1.6\\\\alpha$ and equity $146.6+1.6\\\\alpha$, with the same\\n$\\\\alpha\\\\in[0,1]$ throughout. Selecting the smallest cash and largest equity\\nindependently would describe no feasible company. A requested distribution\\nrequires a measure over that same historical family; the accounting equations\\ndo not supply one.\\n\\n    if not condition: raise AssertionError(name+': '+str(detail))\\n\\ndef post(state, e, committed):\\n    \\\"\\\"\\\"Local oracle for atomic double-entry/idempotency, deliberately small.\\\"\\\"\\\"\\n    payload=json.dumps(e,sort_keys=True,separators=(',',':'))\\n    if e['id'] in committed:\\n        if committed[e['id']]!=payload: raise ValueError('EventIdentityConflict')\\n        return\\n    entries=[(p['account'],Q(p['signed_amount'])) for p in e['postings']]\\n    if sum(v for _,v in entries)!=0: raise ValueError('UnbalancedBatch')\\n    proposed=deepcopy(state)\\n    for a,v in entries: proposed[a]+=v\\n    state.clear(); state.update(proposed); committed[e['id']]=payload\\n\\ndef report_close(state, events, roles, period):\\n    selected=[e for e in events if e['period']==period]\\n    flows=defaultdict(Q)\\n    for e in selected:\\n        for p in e['postings']:\\n            if p['account']=='cash' and e['cash_class']:\\n                flows[e['cash_class']]+=Q(p['signed_amount'])\\n    profit=-sum(v for a,v in state.items() if roles[a] in ['income','expense'])\\n    revenue=-state['revenue']\\n    interest,tax=state['interest'],state['tax']\\n    # Closing is independent of the event generator; no cash arises here.\\n    for a in list(state):\\n        if roles[a] in ['income','expense']:\\n            state['retained']+=state[a];state[a]=Q(0)\\n    result=dict(cash=state['cash'],receivables=state['receivables'],inventory=state['inventory'],\\n        plant_net=state['plant_cost']+state['accum_depreciation'],tax_prepaid=state['tax_prepaid'],\\n        assets=sum(v for a,v in state.items() if roles[a] in ['asset','contra_asset']),\\n        payables=-state['payables'],debt=-state['debt'],\\n        equity=-sum(v for a,v in state.items() if roles[a]=='equity'),\\n        revenue=revenue,profit=profit,interest=interest,tax=tax,\\n        operating_cash=flows['operating'],investing_cash=flows['investing'],financing_cash=flows['financing'])\\n    check('balanced_'+period,sum(state.values())==0 and result['assets']==result['payables']+result['debt']+result['equity'],str(result))\\n    return result\\n\\ndef compare(name,actual,expected):\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 -B - <<'PY'\\nimport json\\nfrom pathlib import Path\\nx=json.loads(Path('docs/design/fixtures/northstar.json').read_text())\\nfor k in ['assumptions','forecast']: print(k,json.dumps(x[k]))\\nx=json.loads(Path('data/accounting-master/deliverables/P02/case.json').read_text())\\nfor k in ['acceptance','unidentified_histories','filing_availability']: print(k,json.dumps(x[k]))\\nprint('reconciliation ids',[(r.get('id'),r.get('status')) for r in x['reconciliations']])\\nPY\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 -B - <<'PY'\\nimport json\\nfrom pathlib import Path\\nx=json.loads(Path('docs/design/fixtures/northstar.json').read_text())\\nfor k in ['assumptions','forecast']: print(k,json.dumps(x[k]))\\nx=json.loads(Path('data/accounting-master/deliverables/P02/case.json').read_text())\\nfor k in ['acceptance','unidentified_histories','filing_availability']: print(k,json.dumps(x[k]))\\nprint('reconciliation ids',[(r.get('id'),r.get('status')) for r in x['reconciliations']])\\nPY\\\"\",\"aggregated_output\":\"assumptions {\\\"historical_resolution\\\": \\\"half-year aggregate flows; existence of intraperiod schedules required, not recovered invoices\\\", \\\"inventory\\\": \\\"one homogeneous good at cost 5; purchases before delivery; quantities equal costs/5\\\", \\\"sales\\\": \\\"delivery transfers control; no returns, services, variable consideration or foreign currency\\\", \\\"tax\\\": \\\"20% positive taxable profit, all expenses deductible, no deferred tax; excess payment is prepaid tax\\\", \\\"plant\\\": \\\"opening cost 100, annual depreciation 10; end-H1 addition 10 lives 5 years; end-H2 addition 12 lives 12 years; zero residuals\\\", \\\"debt\\\": \\\"100 throughout; fixed and floating both 5% in 2024; fixed 5%, floating resets to 7% in 2025; all maturities after forecast\\\", \\\"time\\\": \\\"half-year accrual fractions 1/2, annual 1; explicit teaching convention\\\", \\\"closing\\\": \\\"temporary accounts closed after each H1/H2; annual income uses movements excluding closing\\\", \\\"universe\\\": \\\"no omitted company, OCI, acquisition, tax or off-balance-sheet operations inside this synthetic package\\\"}\\nforecast {\\\"start\\\": \\\"2025-01-01\\\", \\\"end_exclusive\\\": \\\"2026-01-01\\\", \\\"demand_units\\\": \\\"30\\\", \\\"price\\\": \\\"10\\\", \\\"unit_cost\\\": \\\"5\\\", \\\"target_inventory_units\\\": \\\"8\\\", \\\"current_sales_collection_fraction\\\": \\\"0.9\\\", \\\"legacy_receivable_collections\\\": \\\"10\\\", \\\"old_payables_paid\\\": \\\"30\\\", \\\"new_purchases_paid\\\": \\\"130\\\", \\\"payroll\\\": \\\"50\\\", \\\"capex_at_period_end\\\": \\\"20\\\", \\\"dividend\\\": \\\"8\\\", \\\"tax_rate\\\": \\\"0.2\\\", \\\"funding_limit\\\": \\\"0\\\"}\\nacceptance {\\\"accounting_validity\\\": \\\"selected displayed identities only; no compliance determination\\\", \\\"empirical_forecast_validity\\\": \\\"not evaluated; no forecast generated\\\", \\\"human_acceptance\\\": \\\"pending\\\", \\\"implemented\\\": \\\"bounded reusable source/context/reconciliation adapter\\\", \\\"specified_behavior\\\": \\\"reviewed P02 plan\\\", \\\"tested_invariants\\\": \\\"see result.md for executed tests\\\"}\\nunidentified_histories [{\\\"id\\\": \\\"debt_and_swaps\\\", \\\"next_action\\\": \\\"Obtain series certificates and public hedge terms; never equate derivative notional with floating-rate debt exposure.\\\", \\\"probability\\\": null, \\\"status\\\": \\\"not_identified\\\", \\\"supports\\\": [{\\\"document\\\": \\\"annual\\\", \\\"end\\\": 212884, \\\"ending_pdf_page\\\": 47, \\\"extraction_path\\\": \\\"docs/design/cases/apple/annual-2024.txt\\\", \\\"extraction_sha256\\\": \\\"caaf182340d3846ff54cf967a2d3da7dce82505170665943ea7227e6bed8336e\\\", \\\"offset_unit\\\": \\\"Unicode code points\\\", \\\"original_path\\\": \\\"docs/design/cases/apple/annual-2024.pdf\\\", \\\"original_sha256\\\": \\\"ec74758cd767465362c641cf2fd5d8fedd477aed2bf7f62117e67610435dcb88\\\", \\\"pdf_page\\\": 46, \\\"printed_page\\\": 43, \\\"quote\\\": \\\"Note 9 \\\\u2013 Debt\\\\n\\\\nCommercial Paper\\\\nThe Company issues unsecured short-term promissory notes pursuant to a commercial paper program. The Company uses net proceeds from the commercial\\\\npaper program for general corporate purposes, including dividends and share repurchases. As of September 28, 2024 and September 30, 2023, the Company\\\\nhad $10.0 billion and $6.0 billion of commercial paper outstanding, respectively, with maturities generally less than nine months. The weighted-average interest\\\\nrate of the Company\\\\u2019s commercial paper was 5.00% and 5.28% as of September 28, 2024 and September 30, 2023, respectively. The following table provides a\\\\nsummary of cash flows associated with the issuance and maturities of commercial paper for 2024, 2023 and 2022 (in millions):\\\\n                                                                                                                 2024                    2023                         2022\\\\nMaturities 90 days or less:\\\\n    Proceeds from/(Repayments of) commercial paper, net                                              $                  3,960   $               (1,333) $                     5,264\\\\n\\\\nMaturities greater than 90 days:\\\\n    Proceeds from commercial paper                                                                                         \\\\u2014                        \\\\u2014                         5,948\\\\n    Repayments of commercial paper                                                                                         \\\\u2014                    (2,645)                      (7,257)\\\\n         Proceeds from/(Repayments of) commercial paper, net                                                               \\\\u2014                    (2,645)                      (1,309)\\\\n\\\\n\\\\n              Total proceeds from/(repayments of) commercial paper, net                              $                  3,960   $               (3,978) $                     3,955\\\\n\\\\n\\\\n\\\\nTerm Debt\\\\nThe Company has outstanding Notes, which are senior unsecured obligations with interest payable in arrears. The following table provides a summary of the\\\\nCompany\\\\u2019s term debt as of September 28, 2024 and September 30, 2023:\\\\n                                                                                                         2024                                              2023\\\\n                                                                Maturities             Amount                     Effective               Amount                    Effective\\\\n                                                              (calendar year)        (in millions)              Interest Rate           (in millions)             Interest Rate\\\\n2013 \\\\u2013 2023 debt issuances:\\\\n    Fixed-rate 0.000% \\\\u2013 4.850% notes                           2024 \\\\u2013 2062       $           97,341             0.03% \\\\u2013 6.65%       $         106,572             0.03% \\\\u2013 6.72%\\\\n         Total term debt principal                                                           97,341                                           106,572\\\\n\\\\n    Unamortized premium/(discount) and issuance costs, net                                     (321)                                               (356)\\\\n    Hedge accounting fair value adjustments                                                    (358)                                             (1,113)\\\\n         Total term debt                                                                     96,662                                           105,103\\\\n    Less: Current portion of term debt                                                      (10,912)                                           (9,822)\\\\n         Total non-current portion of term debt                                  $           85,750                                 $           95,281\\\\n\\\\n\\\\nTo manage interest rate risk on certain of its U.S. dollar\\\\u2013denominated fixed-rate notes, the Company uses interest rate swaps to effectively convert the fixed\\\\ninterest rates to floating interest rates on a portion of these notes. Additionally, to manage foreign exchange rate risk on certain of its foreign currency\\\\u2013\\\\ndenominated notes, the Company uses cross-currency swaps to effectively convert these notes to U.S. dollar\\\\u2013denominated notes.\\\\n\\\\nThe effective interest rates for the Notes include the interest on the Notes, amortization of the discount or premium and, if applicable, adjustments related to\\\\nhedging.\\\\n\\\\nThe future principal payments for the Company\\\\u2019s Notes as of September 28, 2024, are as follows (in millions):\\\\n\\\\n2025                                                                                                                                                       $                 10,930\\\\n2026                                                                                                                                                                         12,342\\\\n2027                                                                                                                                                                          9,936\\\\n2028                                                                                                                                                                          7,800\\\\n2029                                                                                                                                                                          5,153\\\\nThereafter                                                                                                                                                                   51,180\\\\n    Total term debt principal                                                                                                                              $                 97,341\\\\n\\\\n\\\\n\\\\n\\\\n                                                                 Apple Inc. | 2024 Form 10-K | 43\\\\n\\\\fAs of September 28, 2024 and September 30, 2023, the fair value of the Company\\\\u2019s Notes, based on Level 2 inputs, was $88.4 billion and $90.8 billion,\\\\nrespectively.\\\\n\\\\n\\\\n\\\", \\\"start\\\": 206863}, {\\\"document\\\": \\\"annual\\\", \\\"end\\\": 184808, \\\"ending_pdf_page\\\": 41, \\\"extraction_path\\\": \\\"docs/design/cases/apple/annual-2024.txt\\\", \\\"extraction_sha256\\\": \\\"caaf182340d3846ff54cf967a2d3da7dce82505170665943ea7227e6bed8336e\\\", \\\"offset_unit\\\": \\\"Unicode code points\\\", \\\"original_path\\\": \\\"docs/design/cases/apple/annual-2024.pdf\\\", \\\"original_sha256\\\": \\\"ec74758cd767465362c641cf2fd5d8fedd477aed2bf7f62117e67610435dcb88\\\", \\\"pdf_page\\\": 39, \\\"printed_page\\\": 36, \\\"quote\\\": \\\"Note 4 \\\\u2013 Financial Instruments\\\\n\\\\nCash, Cash Equivalents and Marketable Securities\\\\nThe following tables show the Company\\\\u2019s cash, cash equivalents and marketable securities by significant investment category as of September 28, 2024 and\\\\nSeptember 30, 2023 (in millions):\\\\n                                                                                                             2024\\\\n                                                                                                                             Cash and               Current             Non-Current\\\\n                                                 Adjusted        Unrealized         Unrealized              Fair               Cash                Marketable           Marketable\\\\n                                                  Cost             Gains             Losses                Value            Equivalents            Securities            Securities\\\\nCash                                         $      27,199   $             \\\\u2014    $            \\\\u2014     $         27,199     $         27,199       $               \\\\u2014    $               \\\\u2014\\\\nLevel 1:\\\\n Money market funds                                    778                \\\\u2014                  \\\\u2014                 778                     778                     \\\\u2014                    \\\\u2014\\\\n Mutual funds                                          515               105                 (3)               617                      \\\\u2014                     617                   \\\\u2014\\\\n     Subtotal                                        1,293               105                 (3)              1,395                    778                    617                   \\\\u2014\\\\nLevel 2 (1):\\\\n U.S. Treasury securities                           16,150                45               (516)             15,679                     212              4,087                  11,380\\\\n U.S. agency securities                              5,431                \\\\u2014                (272)              5,159                     155                703                   4,301\\\\n Non-U.S. government securities                     17,959                93               (484)             17,568                   1,158             10,810                   5,600\\\\n Certificates of deposit and time deposits             873                \\\\u2014                  \\\\u2014                  873                     387                478                       8\\\\n Commercial paper                                    1,066                \\\\u2014                  \\\\u2014                1,066                      28              1,038                      \\\\u2014\\\\n Corporate debt securities                          65,622               270             (1,953)             63,939                      26             16,027                  47,886\\\\n Municipal securities                                  412                \\\\u2014                  (7)                405                      \\\\u2014                 190                     215\\\\n Mortgage- and asset-backed securities              24,595               175             (1,403)             23,367                      \\\\u2014               1,278                  22,089\\\\n    Subtotal                                       132,108               583             (4,635)            128,056                   1,966              34,611                 91,479\\\\n        Total (2)(3)                         $     160,600   $           688    $        (4,638)   $        156,650     $         29,943       $        35,228      $           91,479\\\\n\\\\n\\\\n\\\\n\\\\n                                                                   Apple Inc. | 2024 Form 10-K | 36\\\\n\\\\f                                                                                                                  2023\\\\n                                                                                                                                 Cash and           Current           Non-Current\\\\n                                                        Adjusted         Unrealized         Unrealized          Fair               Cash            Marketable         Marketable\\\\n                                                         Cost              Gains             Losses            Value            Equivalents        Securities          Securities\\\\nCash                                                $      28,359    $             \\\\u2014    $            \\\\u2014     $      28,359    $         28,359   $             \\\\u2014    $                \\\\u2014\\\\nLevel 1:\\\\n Money market funds                                           481                  \\\\u2014                 \\\\u2014               481                481                 \\\\u2014                      \\\\u2014\\\\n Mutual funds and equity securities                           442                  12               (26)             428                 \\\\u2014                 428                     \\\\u2014\\\\n   Subtotal                                                   923                  12               (26)             909                481                428                     \\\\u2014\\\\nLevel 2 (1):\\\\n U.S. Treasury securities                                  19,406                  \\\\u2014             (1,292)          18,114                  35             5,468                 12,611\\\\n U.S. agency securities                                     5,736                  \\\\u2014               (600)           5,136                  36               271                  4,829\\\\n Non-U.S. government securities                            17,533                  6             (1,048)          16,491                  \\\\u2014             11,332                  5,159\\\\n Certificates of deposit and time deposits                  1,354                  \\\\u2014                 \\\\u2014             1,354               1,034               320                     \\\\u2014\\\\n Commercial paper                                             608                  \\\\u2014                 \\\\u2014               608                  \\\\u2014                608                     \\\\u2014\\\\n Corporate debt securities                                 76,840                  6             (5,956)          70,890                  20            12,627                 58,243\\\\n Municipal securities                                         628                  \\\\u2014                (26)             602                  \\\\u2014                192                    410\\\\n Mortgage- and asset-backed securities                     22,365                  6             (2,735)          19,636                  \\\\u2014                344                 19,292\\\\n    Subtotal                                              144,470                  18           (11,657)        132,831                1,125            31,162                100,544\\\\n          Total (3)                                 $     173,752    $             30   $       (11,683)   $    162,099     $         29,965   $        31,590    $           100,544\\\\n\\\\n\\\\n    (1)    The valuation techniques used to measure the fair values of the Company\\\\u2019s Level 2 financial instruments, which generally have counterparties with high credit\\\\n           ratings, are based on quoted market prices or model-driven valuations using significant inputs derived from or corroborated by observable market data.\\\\n    (2)    As of September 28, 2024, cash and cash equivalents included $2.6 billion held in escrow and restricted from general use. These restricted cash and cash\\\\n           equivalents were designated to settle the Company\\\\u2019s obligation related to the State Aid Decision (refer to Note 7, \\\\u201cIncome Taxes\\\\u201d).\\\\n    (3)    As of September 28, 2024 and September 30, 2023, total marketable securities included $13.2 billion and $13.8 billion, respectively, held in escrow and\\\\n           restricted from general use. The September 28, 2024 restricted marketable securities were designated to settle the Company\\\\u2019s obligation related to the State Aid\\\\n           Decision (refer to Note 7, \\\\u201cIncome Taxes\\\\u201d).\\\\n\\\\n\\\\nAs of September 28, 2024, 86% of the Company\\\\u2019s non-current marketable debt securities other than mortgage- and asset-backed securities had maturities\\\\nbetween 1 and 5 years, 10% between 5 and 10 years, and 4% greater than 10 years. As of September 28, 2024, 14% of the Company\\\\u2019s non-current mortgage-\\\\nand asset-backed securities had maturities between 1 and 5 years, 9% between 5 and 10 years, and 77% greater than 10 years.\\\\n\\\\nThe Company\\\\u2019s investments in marketable debt securities have been classified and accounted for as available-for-sale. The Company classifies marketable debt\\\\nsecurities as either current or non-current based on each instrument\\\\u2019s underlying maturity.\\\\n\\\\n\\\\nDerivative Instruments and Hedging\\\\nThe Company may use derivative instruments to partially offset its business exposure to foreign exchange and interest rate risk. However, the Company may\\\\nchoose not to hedge certain exposures for a variety of reasons including accounting considerations or the prohibitive economic cost of hedging particular\\\\nexposures. There can be no assurance the hedges will offset more than a portion of the financial impact resulting from movements in foreign exchange or\\\\ninterest rates.\\\\n\\\\nThe Company classifies cash flows related to derivative instruments in the same section of the Consolidated Statements of Cash Flows as the items being\\\\nhedged, which are generally classified as operating activities.\\\\n\\\\n\\\\nForeign Exchange Rate Risk\\\\nTo protect gross margins from fluctuations in foreign exchange rates, the Company may use forwards, options or other instruments, and may designate these\\\\ninstruments as cash flow hedges. The Company generally hedges portions of its forecasted foreign currency exposure associated with revenue and inventory\\\\npurchases, typically for up to 12 months.\\\\n\\\\n\\\\n\\\\n                                                                           Apple Inc. | 2024 Form 10-K | 37\\\\n\\\\fTo protect the Company\\\\u2019s foreign currency\\\\u2013denominated term debt or marketable securities from fluctuations in foreign exchange rates, the Company may use\\\\nforwards, cross-currency swaps or other instruments. The Company designates these instruments as either cash flow or fair value hedges. As of September 28,\\\\n2024, the maximum length of time over which the Company is hedging its exposure to the variability in future cash flows for term debt\\\\u2013related foreign currency\\\\ntransactions is 18 years.\\\\n\\\\nThe Company may also use derivative instruments that are not designated as accounting hedges to protect gross margins from certain fluctuations in foreign\\\\nexchange rates, as well as to offset a portion of the foreign currency gains and losses generated by the remeasurement of certain assets and liabilities\\\\ndenominated in non-functional currencies.\\\\n\\\\n\\\\nInterest Rate Risk\\\\nTo protect the Company\\\\u2019s term debt or marketable securities from fluctuations in interest rates, the Company may use interest rate swaps, options or other\\\\ninstruments. The Company designates these instruments as either cash flow or fair value hedges.\\\\n\\\\n\\\\nThe notional amounts of the Company\\\\u2019s outstanding derivative instruments as of September 28, 2024 and September 30, 2023 were as follows (in millions):\\\\n                                                                                                                         2024                   2023\\\\nDerivative instruments designated as accounting hedges:\\\\n    Foreign exchange contracts                                                                                   $              64,069   $              74,730\\\\n    Interest rate contracts                                                                                      $              14,575   $              19,375\\\\n\\\\nDerivative instruments not designated as accounting hedges:\\\\n    Foreign exchange contracts                                                                                   $              91,493   $          104,777\\\\n\\\\n\\\\nThe carrying amounts of the Company\\\\u2019s hedged items in fair value hedges as of September 28, 2024 and September 30, 2023 were as follows (in millions):\\\\n                                                                                                                         2024                    2023\\\\nHedged assets/(liabilities):\\\\n   Current and non-current marketable securities                                                                 $                 \\\\u2014 $                14,433\\\\n   Current and non-current term debt                                                                             $            (13,505) $             (18,247)\\\\n\\\\n\\\\nAccounts Receivable\\\\n\\\\nTrade Receivables\\\\nThe Company\\\\u2019s third-party cellular network carriers accounted for 38% and 41% of total trade receivables as of September 28, 2024 and September 30, 2023,\\\\nrespectively. The Company requires third-party credit support or collateral from certain customers to limit credit risk.\\\\n\\\\n\\\\nVendor Non-Trade Receivables\\\\nThe Company has non-trade receivables from certain of its manufacturing vendors resulting from the sale of components to these vendors who manufacture\\\\nsubassemblies or assemble final products for the Company. The Company purchases these components directly from suppliers. The Company does not reflect\\\\nthe sale of these components in products net sales. Rather, the Company recognizes any gain on these sales as a reduction of products cost of sales when the\\\\nrelated final products are sold by the Company. As of September 28, 2024, the Company had two vendors that individually represented 10% or more of total\\\\nvendor non-trade receivables, which accounted for 44% and 23%. As of September 30, 2023, the Company had two vendors that individually represented 10%\\\\nor more of total vendor non-trade receivables, which accounted for 48% and 23%.\\\\n\\\\n\\\\n\\\\n                                                                Apple Inc. | 2024 Form 10-K | 38\\\\n\\\", \\\"start\\\": 171112}, {\\\"document\\\": \\\"interim\\\", \\\"end\\\": 32650, \\\"extraction_path\\\": \\\"docs/design/cases/apple/interim-2025q1.txt\\\", \\\"extraction_sha256\\\": \\\"ab8e06fc35957f43a355d0d1d11d57d203b494a4008edb39cff162e984ef633b\\\", \\\"offset_unit\\\": \\\"Unicode code points\\\", \\\"original_path\\\": \\\"docs/design/cases/apple/interim-2025q1.html\\\", \\\"original_sha256\\\": \\\"2f7629f0733f75b3155dd52f7ae6a8724468e3cde1a9ce32fbce96d98f1ec27e\\\", \\\"quote\\\": \\\"Note 6 \\\\u2013\\\\nDebt\\\\nCommercial Paper\\\\nThe Company issues unsecured short-term promissory notes pursuant to a commercial paper program. The Company uses net proceeds from the commercial paper program for general corporate purposes, including dividends and share repurchases. As of December\\\\u00a028, 2024 and September\\\\u00a028, 2024, the Company had $\\\\n2.0\\\\nbillion and $\\\\n10.0\\\\nbillion of commercial paper outstanding, respectively.\\\\nTerm Debt\\\\nAs of December\\\\u00a028, 2024 and September\\\\u00a028, 2024, the Company had outstanding fixed-rate notes with varying maturities for an aggregate carrying amount of $\\\\n94.8\\\\nbillion\\\\nand $\\\\n96.7\\\\nbillion, respectively (collectively the \\\\u201cNotes\\\\u201d). As of December\\\\u00a028, 2024 and September\\\\u00a028, 2024, the fair value of the Company\\\\u2019s Notes, based on Level 2 inputs, was\\\\n$\\\\n82.7\\\\nbillion and $\\\\n88.4\\\\nbillion, respectively.\\\\n\\\", \\\"start\\\": 31835}, {\\\"document\\\": \\\"interim\\\", \\\"end\\\": 31216, \\\"extraction_path\\\": \\\"docs/design/cases/apple/interim-2025q1.txt\\\", \\\"extraction_sha256\\\": \\\"ab8e06fc35957f43a355d0d1d11d57d203b494a4008edb39cff162e984ef633b\\\", \\\"offset_unit\\\": \\\"Unicode code points\\\", \\\"