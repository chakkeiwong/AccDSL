{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,130p' tests/test_accounting_p02.py\nsed -n '130,265p' tests/test_accounting_p02.py\"","aggregated_output":"\"\"\"Deterministic real-input checks for the bounded Apple P02 case.\n\nThe tests deliberately exercise the retained annual PDF/text and interim HTML\nthrough the reusable case adapter.  Expected identities below are stated from\nthe filing rows themselves; they are not copied from a generated case result.\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport unittest\n\nfrom scripts import apple_case_v1 as case\n\n\nROOT = Path(__file__).resolve().parents[1]\nOUT = ROOT / \"data/accounting-master/deliverables/P02\"\nCASE_PATH = OUT / \"case.json\"\nANNUAL_TEXT = ROOT / \"docs/design/cases/apple/annual-2024.txt\"\nINTERIM_HTML = ROOT / \"docs/design/cases/apple/interim-2025q1.html\"\n\n\nclass AccountingP02Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.case_data = json.loads(CASE_PATH.read_text())\n        cls.by_id = {o[\"id\"]: o for o in cls.case_data[\"observations\"]}\n\n    def test_real_inputs_build_and_independent_annual_arithmetic(self):\n        built = case.build_case()\n        self.assertEqual(len(built[\"notes\"]), 23)\n        self.assertEqual(built[\"coverage\"][\"annual_notes\"], 13)\n        self.assertEqual(built[\"coverage\"][\"interim_notes\"], 10)\n        self.assertEqual(built[\"acceptance\"][\"empirical_forecast_validity\"],\n                         \"not evaluated; no forecast generated\")\n\n        annual = ANNUAL_TEXT.read_text()\n        debt_row = re.search(\n            r\"Total term debt principal.*?97,341.*?\\n.*?\"\n            r\"Unamortized premium/\\(discount\\) and issuance costs, net.*?\\(321\\).*?\\n.*?\"\n            r\"Hedge accounting fair value adjustments.*?\\(358\\).*?\\n.*?\"\n            r\"Total term debt\\s+96,662\",\n            annual,\n            re.S,\n        )\n        self.assertIsNotNone(debt_row)\n        # Independent displayed-million arithmetic from the retained PDF text.\n        self.assertEqual(Fraction(97341) - Fraction(321) - Fraction(358),\n                         Fraction(96662))\n        self.assertEqual(\n            Fraction(10912) + Fraction(85750),\n            Fraction(96662),\n        )\n        self.assertIn(\"30,737\", annual)\n        self.assertIn(\"29,965\", annual)\n\n        # The independent retained HTML contains the actual tagged facts used\n        # by the interim reader, including the rounded narrative debt fact.\n        interim = INTERIM_HTML.read_text()\n        self.assertIn('name=\"us-gaap:LongTermDebt\"', interim)\n        self.assertIn('>94.8</ix:nonFraction>', interim)\n\n    def test_cli_check_rebuilds_case_from_sources(self):\n        result = subprocess.run(\n            [\"python3\", \"-B\", \"scripts/apple_case_v1.py\", \"--check\",\n             \"--output-dir\", \"data/accounting-master/deliverables/P02\"],\n            cwd=ROOT, text=True, capture_output=True, check=False,\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        report = json.loads(result.stdout)\n        self.assertEqual(report[\"status\"], \"pass\")\n        self.assertEqual(report[\"notes\"], 23)\n        self.assertGreater(report[\"anchors\"], 500)\n\n    def test_note_inventory_and_boundary_mutations_are_rejected(self):\n        annual = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                               case.APPLE + \"annual-2024.txt\", pdf=True)\n        self.assertEqual(len(case.discover_notes(annual, 13)), 13)\n        duplicate = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                  case.APPLE + \"annual-2024.txt\", pdf=True)\n        duplicate.text = duplicate.text.replace(\"Note 2 –\", \"Note 1 –\", 1)\n        with self.assertRaises(case.CaseError):\n            case.discover_notes(duplicate, 13)\n        broken_boundary = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                        case.APPLE + \"annual-2024.txt\", pdf=True)\n        broken_boundary.text = broken_boundary.text.replace(\n            \"Report of Independent Registered\", \"Report marker removed\")\n        with self.assertRaises(case.CaseError):\n            case.discover_notes(broken_boundary, 13)\n\n    def test_anchor_quote_hash_and_metadata_revalidation_reject_mutations(self):\n        mutated = copy.deepcopy(self.case_data)\n        anchor = mutated[\"notes\"][0][\"anchor\"]\n        anchor[\"quote\"] = anchor[\"quote\"] + \" altered\"\n        with self.assertRaises(case.CaseError):\n            case.validate_anchors(mutated)\n\n        mutated = copy.deepcopy(self.case_data)\n        anchor = mutated[\"notes\"][0][\"anchor\"]\n        anchor[\"extraction_sha256\"] = \"0\" * 64\n        with self.assertRaises(case.CaseError):\n            case.validate_anchors(mutated)\n\n        mutated = copy.deepcopy(self.case_data)\n        mutated[\"observations\"][0][\"displayed_literal\"] = \"1\"\n        with self.assertRaises(case.CaseError):\n            case.validate_case(mutated)\n\n    def test_context_scale_sign_and_measurement_substitutions_reject(self):\n        assets = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.assets\"])\n        liabilities = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.liabilities\"])\n        equity = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.equity\"])\n\n        wrong_scale = copy.deepcopy(assets)\n        wrong_scale[\"scale\"] = 9\n        with self.assertRaises(case.CaseError):\n            case.validate_value(wrong_scale)\n\n        wrong_sign = copy.deepcopy(assets)\n        wrong_sign[\"value_usd\"] = \"-364980000000\"\n        with self.assertRaises(case.CaseError):\n            case.validate_value(wrong_sign)\n\n        wrong_perimeter = copy.deepcopy(equity)\n        wrong_perimeter[\"context\"][\"perimeter\"] = \"standalone\"\n        with self.assertRaises(case.CaseError):\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.perimeter\", \"balance\",\n                           [liabilities, wrong_perimeter], assets)\n\n        fair_value = copy.deepcopy(self.by_id[\"interim.debt.2024-12-28.fair_value\"])\n        current = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_current\"])\n        noncurrent = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_noncurrent\"])\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.measurement\", \"rounded_debt\",\n                           [current, noncurrent], fair_value)\n\n    def test_cash_perimeter_and_revenue_axis_substitutions_reject(self):\n        opening = copy.deepcopy(self.by_id[\"annual.cf.2024.opening\"])\n        closing = copy.deepcopy(self.by_id[\"annual.cf.2024.closing\"])\n        flows = [copy.deepcopy(self.by_id[f\"annual.cf.2024.{k}\"])\n                 for k in (\"operating\", \"investing\", \"financing\")]\n        balance_sheet_cash = copy.deepcopy(self.by_id[\"annual.bs.2023-09-30.cash\"])\n        # 30,737 is the cash-flow opening balance; 29,965 is the prior\n        # balance-sheet cash-only figure.  The latter has the wrong perimeter.\n        self.assertEqual(Fraction(opening[\"displayed_literal\"].replace(\",\", \"\")),\n                         Fraction(30737))\n        self.assertEqual(Fraction(balance_sheet_cash[\"displayed_literal\"].replace(\",\", \"\")),\n                         Fraction(29965))\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.cash.perimeter\", \"cash_flow\",\n                           [balance_sheet_cash] + flows, closing)\n\n        product = [copy.deepcopy(self.by_id[f\"annual.product.2024.{i}\"])\n                   for i in range(5)]\n        product_total = copy.deepcopy(self.by_id[\"annual.revenue.2024\"])\n        self.assertEqual(case.reconcile(\"ok.product\", \"partition\", product,\n                                        product_total, partition=\"product\")[\"status\"],\n                         \"pass\")\n        product[0][\"context\"][\"dimensions\"] = {\n            \"us-gaap:StatementBusinessSegmentsAxis\": \"aapl:AmericasSegmentMember\"\n        }\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.product.axis\", \"partition\", product,\n                           product_total, partition=\"product\")\n\n    def test_inline_fact_context_and_unit_ids_are_required(self):\n        interim = case.Document(\"interim\", case.APPLE + \"interim-2025q1.html\",\n                                case.APPLE + \"interim-2025q1.txt\")\n        reader = case.InlineReader(interim)\n        fact = copy.copy(reader.facts[0])\n        fact[\"contextref\"] = \"missing-context\"\n        with self.assertRaises(case.CaseError):\n            reader.parse(fact)\n        fact = copy.copy(reader.facts[0])\n        fact[\"unitref\"] = \"missing-unit\"\n        with self.assertRaises(case.CaseError):\n            reader.parse(fact)\n\n    def test_rounding_compatibility_and_incompatibility_are_distinct(self):\n        current = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_current\"])\n        noncurrent = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_noncurrent\"])\n        rounded = copy.deepcopy(self.by_id[\"interim.debt.2024-12-28.rounded\"])\n        passing = case.reconcile(\"ok.rounded\", \"rounded_debt\",\n                                 [current, noncurrent], rounded)\n        self.assertTrue(passing[\"rounding_compatible\"])\n        self.assertFalse(passing[\"displayed_identity\"])\n\n        incompatible = copy.deepcopy(rounded)\n        incompatible[\"displayed_literal\"] = \"95.1\"\n        incompatible[\"value_usd\"] = \"95100000000\"\n        incompatible[\"rounding_interval_usd\"] = case.interval(\n            Fraction(\"95100000000\"), Fraction(\"100000000\"))\n        source = incompatible[\"source_readings\"][0][\"fact\"]\n        source[\"quote\"] = source[\"quote\"].replace(\">94.8<\", \">95.1<\")\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.rounded\", \"rounded_debt\",\n                           [current, noncurrent], incompatible)\n\n    def test_external_obligations_and_unidentified_histories_remain_explicit(self):\n        external = self.case_data[\"external\"]\n        self.assertTrue(external[\"partIII_and_package_obligations\"])\n        self.assertTrue(any(\"proxy\" in x.get(\"target\", \"\").lower()\n                            for x in external[\"partIII_and_package_obligations\"]))\n        self.assertTrue(any(x.get(\"contents_status\") ==\n                            \"internal_target_missing_in_retained_html\"\n                            for x in external[\"exhibit_inventory\"]))\n        views = case.version_view(self.case_data[\"filing_availability\"],\n                                  \"2024-11-01\", scope=\"retained_bytes\")\n        self.assertEqual({x[\"availability\"] for x in views[\"versions\"]},\n                         {\"unknown\"})\n        self.assertEqual(\n            {x[\"status\"] for x in self.case_data[\"unidentified_histories\"]},\n            {\"not_identified\"},\n        )\n        self.assertEqual(\n            self.case_data[\"representation_comparison\"][\"whole_document_equivalence\"],\n            False,\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '680,743p' scripts/apple_case_v1.py\nsed -n '849,897p' scripts/apple_case_v1.py\nsed -n '918,951p' scripts/apple_case_v1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '680,743p' scripts/apple_case_v1.py\nsed -n '849,897p' scripts/apple_case_v1.py\nsed -n '918,951p' scripts/apple_case_v1.py\"","aggregated_output":"def note_records(annual, interim, observations):\n    notes = discover_notes(annual, 13)+discover_notes(interim, 10)\n    inventory = json.loads((ROOT/APPLE/\"manifest.json\").read_text())[\"notes\"]\n    require([(n[\"id\"], n[\"title\"]) for n in notes] == [(n[\"id\"], n[\"title\"]) for n in inventory],\n            \"note inventory disagreement\")\n    for note in notes:\n        areas, interpretation, unknown = NOTE_MEANING[note[\"title\"]]\n        note.update(disposition=\"partially_mapped\" if note[\"number\"] in (1, 2, 4) else \"unresolved_meaning_retained\",\n                    affected_model_areas=areas, interpretation=interpretation,\n                    unresolved_meaning=unknown, semantic_completion=False, linked_quantities=[],\n                    qualifications=\"The full bounded source passage is retained; only the stated interpretation is applied.\")\n        a = note[\"anchor\"]\n        for obs in observations:\n            for source in walk_anchors(obs[\"source_readings\"]):\n                if source.get(\"extraction_path\") == a[\"extraction_path\"] and a[\"start\"] <= source[\"start\"] < a[\"end\"]:\n                    note[\"linked_quantities\"].append(obs[\"id\"])\n                    break\n        # Inline fact locations live in HTML, not in the independent text extraction.\n        # Match the fact's literal/concept within this note's corresponding ix:textBlock.\n        if a[\"document\"] == \"interim\":\n            prefixes = {2: [\"interim.product.\"], 4: [\"interim.notional.\"],\n                        6: [\"interim.debt.\"], 10: [\"interim.segment.\"]}.get(note[\"number\"], [])\n            note[\"linked_quantities\"] = [o[\"id\"] for o in observations if any(o[\"id\"].startswith(p) for p in prefixes)]\n        note[\"linked_quantities\"] = sorted(set(note[\"linked_quantities\"]))\n        if note[\"linked_quantities\"]:\n            note[\"disposition\"] = \"selected_quantities_mapped_with_unresolved_remainder\"\n        targets = sorted(set(int(n) for n in re.findall(r\"Note\\s+(\\d+)\", a[\"quote\"])))\n        note[\"cross_references\"] = [dict(target=f\"{a['document']}.note.{n}\",\n                                         relation=\"literal note reference\", status=\"source_present; meaning not necessarily executed\")\n                                    for n in targets if n != note[\"number\"]]\n        require(all(t[\"target\"] in {n[\"id\"] for n in notes} for t in note[\"cross_references\"]), \"unresolved internal note target\")\n    by_id = {n[\"id\"]: n for n in notes}\n    by_id[\"annual.note.9\"][\"cross_references\"].append(dict(target=\"annual.note.4\", relation=\"analyst link: debt and interest-rate swaps\", status=\"source_present\"))\n    by_id[\"interim.note.1\"][\"cross_references\"].append(dict(target=\"annual.note.1\", relation=\"explicit read-with-2024-10-K qualification\", status=\"source_present\"))\n    contingency = by_id[\"interim.note.9\"]\n    contingency[\"assertion\"] = dict(kind=\"reported_management_assessment\", speaker=\"Apple management\",\n        subject=\"asserted legal and other claims\", modal_operator=\"not at least a reasonable possibility\",\n        assessed_event=\"material loss, or material loss greater than a recorded accrual\",\n        unresolved_outcomes=True, probability=None, liability_amount=None,\n        anchor=interim.find(r\"The Company is subject to various legal proceedings.*?asserted legal and other claims\\.\",\n                            (contingency[\"anchor\"][\"start\"], contingency[\"anchor\"][\"end\"]), re.S))\n    return notes\n\n\ndef supported_excerpt(doc, pattern, bounds=None):\n    return doc.find(pattern, bounds, re.S)\n\n\ndef rendered_row_match(doc, label, literal, occurrence=0):\n    \"\"\"Anchor a displayed row/value in an issuer-rendered HTML extraction.\n\n    The issuer-linked HTML retained for the publication/version check is a\n    rendered filing, not an inline-XBRL instance.  It therefore cannot be\n    parsed with ``InlineReader``.  This helper deliberately binds only the\n    visible label/value pair and records the exact occurrence; it does not\n    promote the rendered copy to a second accounting source.\n    \"\"\"\n    pattern = re.escape(label) + r\"\\s+(?:\\$\\s+)?\" + re.escape(literal)\n    matches = list(re.finditer(pattern, doc.text, re.S))\n    require(len(matches) > occurrence, f\"rendered row missing: {label} {literal}\")\n    m = matches[occurrence]\n    return doc.anchor(m.start(), m.end())\n\n\ndef external_records(annual, interim, docs):\n    proxy, reg, official = [docs[k] for k in (\"proxy-2025\", \"registration-2021\", \"annual-2024-official\")]\n    exhibits = exhibit_records(annual, official, interim)\n    obligations = []\n    proxy_patterns = {\n        10: r\"Board Independence\\nApple’s Corporate Governance Guidelines.*?applicable rules of The Nasdaq Stock Market LLC.*?\\(“Nasdaq”\\)\\.\",\n        11: r\"Compensation Discussion and Analysis\\nThis Compensation.*?paid to our named executive officers\\.\",\n        12: r\"Security\\nOwnership of Certain Beneficial Owners and Management\\nThe\\nfollowing table.*?\\(the “Table Date”\\)\",\n        13: r\"Related Party Policy and Transactions\\nThe Board has.*?\\$120,000 in a single fiscal year\",\n        14: r\"Audit Fees\\n\\(1\\).*?Total\\n30,270,822\\n25,403,329\",\n    }\n    lo, hi = annual.page(52)\n    for item, pat in proxy_patterns.items():\n        start = annual.find(r\"Item \"+str(item)+r\"\\.[^\\n]+\", (lo, hi))[\"start\"]\n        stop = annual.text.find(\"Item \"+str(item+1)+\".\", start, hi) if item < 14 else hi\n        obligations.append(dict(id=f\"annual.partIII.item{item}\", target=\"2025 proxy, accession 0001308179-25-000008\",\n                                incorporation=annual.anchor(start, stop), support=proxy.find(pat, flags=re.S),\n                                status=\"target_acquired_selected_passage_inspected\",\n                                unresolved=\"Complete item-level semantics, exceptions and references beyond the selected passage remain unmodelled.\",\n                                consequence=\"Proxy information cannot be backdated to the annual filing.\",\n                                next_route=\"Inspect remaining sections in the retained proxy and its exact incorporated targets.\"))\n    title = reg.find(r\"Exhibit 4\\.1\\nApple Inc\\..*?Dated as of October\\s+28, 2021\", flags=re.S)\n    terms = reg.find(r\"Section\\s+301\\.\\nAmount\\nUnlimited; Issuable in Series.*?Section\\s+302\\.\", flags=re.S)\n    # The retained issuer extraction omits the indenture's section numbers,\n    # but preserves the substantive heading and the following covenants.\n    defaults = reg.find(r\"Events of Default\\n.*?Discharge, Defeasance and Covenant Defeasance\", flags=re.S)\n    for e in exhibits:\n        if e[\"id\"] == \"annual.exhibit.4.26\":\n            e.update(contents_status=\"acquired_in_registration_2021; selected_sections_inspected\", acquired_support=title,\n                     section_301=terms, section_501=defaults,\n                     missing_terms=\"Series-specific officer certificates, outstanding balances, amendments and swap confirmations/allocation.\")\n    # Source content after the annual report includes filed exhibits; 4.1 is not a missing external indenture.\n    securities = annual.find(r\"(?m)^[ \\t]*4\\.1[^\\n]*Description of Securities of the Registrant\\.\")\n    obligations.append(dict(id=\"annual.exhibit.4.1.in_pdf\", target=\"Description of Securities, filed exhibit 4.1\",\n                            support=securities, status=\"heading_and_contents_retained_in_pdf\",\n                            unresolved=\"Description is not the complete incorporated indentures and series certificates.\",\n                            consequence=\"General descriptions do not identify all current debt terms.\",\n                            next_route=\"Inspect specific 4.2–4.28 index targets for contract reconstruction.\"))\n    omissions = annual.find(r\"Certain instruments defining the rights of holders.*?copies of any such instruments\\.\", annual.page(56), re.S)\n    obligations.append(dict(id=\"omitted_debt_instruments\", target=\"Instruments omitted under Item 601(b)(4)(iii)\", support=omissions,\n                            status=\"expressly_omitted_from_filing\", unresolved=\"Instrument identities and complete terms not specified by this index.\",\n                            consequence=\"No complete debt-contract inventory is established.\",\n                            next_route=\"Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach.\"))\n    return dict(partIII_and_package_obligations=obligations, exhibit_inventory=exhibits,\n                agreement_interpretation=dict(status=\"selected_contract_sections_only\", support=[title, terms, defaults],\n                    interpretation=\"Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.\",\n                    missing=\"2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule.\"))\n\n\ndef build_case():\n    annual, interim, docs, bindings, acquisitions = load_sources()\n    observations, bridges, calendar = collect_observations(annual, interim)\n    notes = note_records(annual, interim, observations)\n    # A selected-table check relates representations, not whole-document\n    # publication vintage.  The issuer-linked HTML is rendered filing text,\n    # so bind visible label/value rows instead of treating it as a second\n    # inline-XBRL instance.  The accounting observations remain sourced from\n    # the retained annual/interim documents above.\n    rendered_specs = [\n        (\"annual.bs.2024-09-28.assets\", \"Total assets\", \"364,980\", 0),\n        (\"annual.bs.2024-09-28.liabilities\", \"Total liabilities\", \"308,030\", 0),\n        (\"annual.bs.2024-09-28.equity\", \"Total shareholders’ equity\", \"56,950\", 0),\n        (\"annual.bs.2024-09-28.debt_current\", \"Term debt\", \"10,912\", 0),\n        (\"annual.bs.2024-09-28.debt_noncurrent\", \"Term debt\", \"85,750\", 0),\n        (\"annual.revenue.2024\", \"Total net sales\", \"391,035\", 0),\n    ]\n    rendered_checks = []\n    for oid, label, literal, occurrence in rendered_specs:\n        annual_observation = next(o for o in observations if o[\"id\"] == oid)\n        rendered_checks.append(dict(\n            id=\"issuer_html.\" + oid,\n            annual_observation=oid,\n            label=label,\n            displayed_literal=literal,\n            source=rendered_row_match(docs[\"annual-2024-official\"], label, literal, occurrence),\n            status=\"visible_row_match_only\",\n            interpretation=\"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\",\n            source_value_usd=annual_observation[\"value_usd\"],\n        ))\n    matched = [x[\"annual_observation\"] for x in rendered_checks]\n    policy = policy_records(annual, interim, notes)\n    external = external_records(annual, interim, docs)\n    records = filing_records()\n","exit_code":0,"status":"completed"}}
