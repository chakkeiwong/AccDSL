one,\n               label=None):\n        candidates = []\n        for f in self.facts:\n            if f.get(\"name\") != concept:\n                continue\n            c = self.resolve(f.get(\"contextref\"), \"xbrli:context\")\n            parsed_ctx = self.parse_context(c)\n            if parsed_ctx == ctx:\n                candidates.append(self.parse(f))\n        require(candidates, f\"missing required fact/context {concept} {ctx}\")\n        first = candidates[0]\n        for c in candidates:\n            require(c[\"value\"] == first[\"value\"] and c[\"quantum\"] == first[\"quantum\"], \"conflicting repeated readings\")\n            require(c[\"scale\"] == scale and c[\"raw\"][\"decimals\"] == decimals, \"wrong presentation scale/precision\")\n        if label:\n            require(any(label in c[\"raw\"][\"rendered_text\"] for c in candidates), \"rendered label not found\")\n        return observation(oid, concept, first[\"value\"], first[\"literal\"], scale, first[\"quantum\"],\n                           ctx, measurement, [c[\"raw\"] for c in candidates], partition=partition)\n\n\ndef same_context(obs, ignore=()):\n    require(obs, \"no operands\")\n    base = {k: v for k, v in obs[0][\"context\"].items() if k not in ignore}\n    require(all({k: v for k, v in x[\"context\"].items() if k not in ignore} == base for x in obs),\n            \"entity/currency/perimeter/basis/period/dimensions mismatch\")\n    require(base.get(\"entity\") == ENTITY and base.get(\"perimeter\") == \"consolidated\" and\n            base.get(\"currency\") == \"USD\" and base.get(\"basis\") == \"US GAAP\" and\n            base.get(\"entity_scheme\") == \"http://www.sec.gov/CIK\", \"unsupported case context\")\n\n\ndef validate_value(obs):\n    \"\"\"Check value, precision and sign against the retained numeric reading.\"\"\"\n    value = Fraction(obs[\"value_usd\"])\n    require(obs[\"rounding_interval_usd\"] == interval(value, obs[\"presentation_quantum_usd\"]),\n            \"altered rounding interval\")\n    require(abs(value) == abs(number(obs[\"displayed_literal\"])*power10(obs[\"scale\"])),\n            \"literal/scale/value mismatch\")\n    require(obs[\"source_readings\"], \"missing numeric source\")\n    for source in obs[\"source_readings\"]:\n        if \"cell\" in source:\n            require(value == number(source[\"cell\"][\"quote\"])*MILLION and obs[\"scale\"] == 6 and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == MILLION, \"annual cell/value mismatch\")\n        elif \"fact\" in source:\n            fact = BeautifulSoup(source[\"fact\"][\"quote\"], \"html.parser\").find(\"ix:nonfraction\")\n            require(fact is not None, \"missing inline source\")\n            sign = -1 if fact.get(\"sign\") == \"-\" else 1\n            require(value == number(fact.get_text(strip=True))*power10(int(fact.get(\"scale\", \"0\")))*sign,\n                    \"inline source/value mismatch\")\n            require(obs[\"scale\"] == int(fact.get(\"scale\", \"0\")) and\n                    Fraction(obs[\"presentation_quantum_usd\"]) == power10(-int(fact[\"decimals\"])),\n                    \"inline precision mismatch\")\n        else:\n            raise CaseError(\"unsupported numeric reading\")\n\n\ndef supported_excerpt(doc, pattern, bounds=None):\n    return doc.find(pattern, bounds, re.S)\n\n\ndef rendered_row_match(doc, label, literal, occurrence=0):\n    \"\"\"Anchor a displayed row/value in an issuer-rendered HTML extraction.\n\n    The issuer-linked HTML retained for the publication/version check is a\n    rendered filing, not an inline-XBRL instance.  It therefore cannot be\n    parsed with ``InlineReader``.  This helper deliberately binds only the\n    visible label/value pair and records the exact occurrence; it does not\n    promote the rendered copy to a second accounting source.\n    \"\"\"\n    pattern = re.escape(label) + r\"\\s+(?:\\$\\s+)?\" + re.escape(literal)\n    matches = list(re.finditer(pattern, doc.text, re.S))\n    require(len(matches) > occurrence, f\"rendered row missing: {label} {literal}\")\n    m = matches[occurrence]\n    return doc.anchor(m.start(), m.end())\n\n\n                            consequence=\"No complete debt-contract inventory is established.\",\n                            next_route=\"Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach.\"))\n    return dict(partIII_and_package_obligations=obligations, exhibit_inventory=exhibits,\n                agreement_interpretation=dict(status=\"selected_contract_sections_only\", support=[title, terms, defaults],\n                    interpretation=\"Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.\",\n                    missing=\"2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule.\"))\n\n\ndef unidentified_records(notes):\n    n = {r[\"id\"]: r for r in notes}\n    specs = [\n        (\"debt_and_swaps\", [\"annual.note.9\", \"annual.note.4\", \"interim.note.6\", \"interim.note.4\"],\n         \"Annual interest-rate notional and interim notional are disclosed but contract allocation, resets, hedge coverage and net economic exposure remain unidentified.\",\n         \"Obtain series certificates and public hedge terms; never equate derivative notional with floating-rate debt exposure.\"),\n        (\"debt_movements\", [\"annual.note.9\", \"interim.note.6\"],\n         \"Carrying differences cannot be identified solely from cash issuance/repayment; FX and noncash measurement changes remain separate unknowns.\",\n         \"Reconstruct movements only with sourced FX, hedge, discount and noncash adjustments.\"),\n        (\"asset_cohorts\", [\"annual.note.5\", \"interim.note.5\"],\n         \