{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,245p' tests/test_accounting_p02.py\"","aggregated_output":"\"\"\"Deterministic real-input checks for the bounded Apple P02 case.\n\nThe tests deliberately exercise the retained annual PDF/text and interim HTML\nthrough the reusable case adapter.  Expected identities below are stated from\nthe filing rows themselves; they are not copied from a generated case result.\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport unittest\n\nfrom scripts import apple_case_v1 as case\n\n\nROOT = Path(__file__).resolve().parents[1]\nOUT = ROOT / \"data/accounting-master/deliverables/P02\"\nCASE_PATH = OUT / \"case.json\"\nANNUAL_TEXT = ROOT / \"docs/design/cases/apple/annual-2024.txt\"\nINTERIM_HTML = ROOT / \"docs/design/cases/apple/interim-2025q1.html\"\n\n\nclass AccountingP02Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.case_data = json.loads(CASE_PATH.read_text())\n        cls.by_id = {o[\"id\"]: o for o in cls.case_data[\"observations\"]}\n\n    def test_real_inputs_build_and_independent_annual_arithmetic(self):\n        built = case.build_case()\n        self.assertEqual(len(built[\"notes\"]), 23)\n        self.assertEqual(built[\"coverage\"][\"annual_notes\"], 13)\n        self.assertEqual(built[\"coverage\"][\"interim_notes\"], 10)\n        self.assertEqual(built[\"acceptance\"][\"empirical_forecast_validity\"],\n                         \"not evaluated; no forecast generated\")\n\n        annual = ANNUAL_TEXT.read_text()\n        debt_row = re.search(\n            r\"Total term debt principal.*?97,341.*?\\n.*?\"\n            r\"Unamortized premium/\\(discount\\) and issuance costs, net.*?\\(321\\).*?\\n.*?\"\n            r\"Hedge accounting fair value adjustments.*?\\(358\\).*?\\n.*?\"\n            r\"Total term debt\\s+96,662\",\n            annual,\n            re.S,\n        )\n        self.assertIsNotNone(debt_row)\n        # Independent displayed-million arithmetic from the retained PDF text.\n        self.assertEqual(Fraction(97341) - Fraction(321) - Fraction(358),\n                         Fraction(96662))\n        self.assertEqual(\n            Fraction(10912) + Fraction(85750),\n            Fraction(96662),\n        )\n        self.assertIn(\"30,737\", annual)\n        self.assertIn(\"29,965\", annual)\n\n        # The independent retained HTML contains the actual tagged facts used\n        # by the interim reader, including the rounded narrative debt fact.\n        interim = INTERIM_HTML.read_text()\n        self.assertIn('name=\"us-gaap:LongTermDebt\"', interim)\n        self.assertIn('>94.8</ix:nonFraction>', interim)\n\n    def test_cli_check_rebuilds_case_from_sources(self):\n        result = subprocess.run(\n            [\"python3\", \"-B\", \"scripts/apple_case_v1.py\", \"--check\",\n             \"--output-dir\", \"data/accounting-master/deliverables/P02\"],\n            cwd=ROOT, text=True, capture_output=True, check=False,\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        report = json.loads(result.stdout)\n        self.assertEqual(report[\"status\"], \"pass\")\n        self.assertEqual(report[\"notes\"], 23)\n        self.assertGreater(report[\"anchors\"], 500)\n\n    def test_note_inventory_and_boundary_mutations_are_rejected(self):\n        annual = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                               case.APPLE + \"annual-2024.txt\", pdf=True)\n        self.assertEqual(len(case.discover_notes(annual, 13)), 13)\n        duplicate = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                  case.APPLE + \"annual-2024.txt\", pdf=True)\n        duplicate.text = duplicate.text.replace(\"Note 2 –\", \"Note 1 –\", 1)\n        with self.assertRaises(case.CaseError):\n            case.discover_notes(duplicate, 13)\n        broken_boundary = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                        case.APPLE + \"annual-2024.txt\", pdf=True)\n        broken_boundary.text = broken_boundary.text.replace(\n            \"Report of Independent Registered\", \"Report marker removed\")\n        with self.assertRaises(case.CaseError):\n            case.discover_notes(broken_boundary, 13)\n\n    def test_anchor_quote_hash_and_metadata_revalidation_reject_mutations(self):\n        mutated = copy.deepcopy(self.case_data)\n        anchor = mutated[\"notes\"][0][\"anchor\"]\n        anchor[\"quote\"] = anchor[\"quote\"] + \" altered\"\n        with self.assertRaises(case.CaseError):\n            case.validate_anchors(mutated)\n\n        mutated = copy.deepcopy(self.case_data)\n        anchor = mutated[\"notes\"][0][\"anchor\"]\n        anchor[\"extraction_sha256\"] = \"0\" * 64\n        with self.assertRaises(case.CaseError):\n            case.validate_anchors(mutated)\n\n        mutated = copy.deepcopy(self.case_data)\n        mutated[\"observations\"][0][\"displayed_literal\"] = \"1\"\n        with self.assertRaises(case.CaseError):\n            case.validate_case(mutated)\n\n    def test_context_scale_sign_and_measurement_substitutions_reject(self):\n        assets = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.assets\"])\n        liabilities = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.liabilities\"])\n        equity = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.equity\"])\n\n        wrong_scale = copy.deepcopy(assets)\n        wrong_scale[\"scale\"] = 9\n        with self.assertRaises(case.CaseError):\n            case.validate_value(wrong_scale)\n\n        wrong_sign = copy.deepcopy(assets)\n        wrong_sign[\"value_usd\"] = \"-364980000000\"\n        with self.assertRaises(case.CaseError):\n            case.validate_value(wrong_sign)\n\n        wrong_perimeter = copy.deepcopy(equity)\n        wrong_perimeter[\"context\"][\"perimeter\"] = \"standalone\"\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.perimeter\", \"balance\",\n                           [liabilities, wrong_perimeter], assets)\n\n        fair_value = copy.deepcopy(self.by_id[\"interim.debt.2024-12-28.fair_value\"])\n        current = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_current\"])\n        noncurrent = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_noncurrent\"])\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.measurement\", \"rounded_debt\",\n                           [current, noncurrent], fair_value)\n\n    def test_cash_perimeter_and_revenue_axis_substitutions_reject(self):\n        opening = copy.deepcopy(self.by_id[\"annual.cf.2024.opening\"])\n        closing = copy.deepcopy(self.by_id[\"annual.cf.2024.closing\"])\n        flows = [copy.deepcopy(self.by_id[f\"annual.cf.2024.{k}\"])\n                 for k in (\"operating\", \"investing\", \"financing\")]\n        balance_sheet_cash = copy.deepcopy(self.by_id[\"annual.bs.2023-09-30.cash\"])\n        # 30,737 is the cash-flow opening balance; 29,965 is the prior\n        # balance-sheet cash-only figure.  The latter has the wrong perimeter.\n        self.assertEqual(Fraction(opening[\"displayed_literal\"].replace(\",\", \"\")),\n                         Fraction(30737))\n        self.assertEqual(Fraction(balance_sheet_cash[\"displayed_literal\"].replace(\",\", \"\")),\n                         Fraction(29965))\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.cash.perimeter\", \"cash_flow\",\n                           [balance_sheet_cash] + flows, closing)\n\n        product = [copy.deepcopy(self.by_id[f\"annual.product.2024.{i}\"])\n                   for i in range(5)]\n        product_total = copy.deepcopy(self.by_id[\"annual.revenue.2024\"])\n        self.assertEqual(case.reconcile(\"ok.product\", \"partition\", product,\n                                        product_total, partition=\"product\")[\"status\"],\n                         \"pass\")\n        product[0][\"context\"][\"dimensions\"] = {\n            \"us-gaap:StatementBusinessSegmentsAxis\": \"aapl:AmericasSegmentMember\"\n        }\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.product.axis\", \"partition\", product,\n                           product_total, partition=\"product\")\n\n    def test_inline_fact_context_and_unit_ids_are_required(self):\n        interim = case.Document(\"interim\", case.APPLE + \"interim-2025q1.html\",\n                                case.APPLE + \"interim-2025q1.txt\")\n        reader = case.InlineReader(interim)\n        fact = copy.copy(reader.facts[0])\n        fact[\"contextref\"] = \"missing-context\"\n        with self.assertRaises(case.CaseError):\n            reader.parse(fact)\n        fact = copy.copy(reader.facts[0])\n        fact[\"unitref\"] = \"missing-unit\"\n        with self.assertRaises(case.CaseError):\n            reader.parse(fact)\n\n    def test_rounding_compatibility_and_incompatibility_are_distinct(self):\n        current = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_current\"])\n        noncurrent = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_noncurrent\"])\n        rounded = copy.deepcopy(self.by_id[\"interim.debt.2024-12-28.rounded\"])\n        passing = case.reconcile(\"ok.rounded\", \"rounded_debt\",\n                                 [current, noncurrent], rounded)\n        self.assertTrue(passing[\"rounding_compatible\"])\n        self.assertFalse(passing[\"displayed_identity\"])\n\n        incompatible = copy.deepcopy(rounded)\n        incompatible[\"displayed_literal\"] = \"95.1\"\n        incompatible[\"value_usd\"] = \"95100000000\"\n        incompatible[\"rounding_interval_usd\"] = case.interval(\n            Fraction(\"95100000000\"), Fraction(\"100000000\"))\n        source = incompatible[\"source_readings\"][0][\"fact\"]\n        source[\"quote\"] = source[\"quote\"].replace(\">94.8<\", \">95.1<\")\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.rounded\", \"rounded_debt\",\n                           [current, noncurrent], incompatible)\n\n    def test_external_obligations_and_unidentified_histories_remain_explicit(self):\n        external = self.case_data[\"external\"]\n        self.assertTrue(external[\"partIII_and_package_obligations\"])\n        self.assertTrue(any(\"proxy\" in x.get(\"target\", \"\").lower()\n                            for x in external[\"partIII_and_package_obligations\"]))\n        self.assertTrue(any(x.get(\"contents_status\") ==\n                            \"internal_target_missing_in_retained_html\"\n                            for x in external[\"exhibit_inventory\"]))\n        views = case.version_view(self.case_data[\"filing_availability\"],\n                                  \"2024-11-01\", scope=\"retained_bytes\")\n        self.assertEqual({x[\"availability\"] for x in views[\"versions\"]},\n                         {\"unknown\"})\n        self.assertEqual(\n            {x[\"status\"] for x in self.case_data[\"unidentified_histories\"]},\n            {\"not_identified\"},\n        )\n        self.assertEqual(\n            self.case_data[\"representation_comparison\"][\"whole_document_equivalence\"],\n            False,\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '918,1008p' scripts/apple_case_v1.py\npython - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('data/accounting-master/deliverables/P02/case.json'); d=json.loads(p.read_text())\nfor k in ['coverage','acceptance','representation_comparison']:\n print(k,json.dumps(d[k]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '918,1008p' scripts/apple_case_v1.py\npython - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('data/accounting-master/deliverables/P02/case.json'); d=json.loads(p.read_text())\nfor k in ['coverage','acceptance','representation_comparison']:\n print(k,json.dumps(d[k]))\nPY\"","aggregated_output":"def build_case():\n    annual, interim, docs, bindings, acquisitions = load_sources()\n    observations, bridges, calendar = collect_observations(annual, interim)\n    notes = note_records(annual, interim, observations)\n    # A selected-table check relates representations, not whole-document\n    # publication vintage.  The issuer-linked HTML is rendered filing text,\n    # so bind visible label/value rows instead of treating it as a second\n    # inline-XBRL instance.  The accounting observations remain sourced from\n    # the retained annual/interim documents above.\n    rendered_specs = [\n        (\"annual.bs.2024-09-28.assets\", \"Total assets\", \"364,980\", 0),\n        (\"annual.bs.2024-09-28.liabilities\", \"Total liabilities\", \"308,030\", 0),\n        (\"annual.bs.2024-09-28.equity\", \"Total shareholders’ equity\", \"56,950\", 0),\n        (\"annual.bs.2024-09-28.debt_current\", \"Term debt\", \"10,912\", 0),\n        (\"annual.bs.2024-09-28.debt_noncurrent\", \"Term debt\", \"85,750\", 0),\n        (\"annual.revenue.2024\", \"Total net sales\", \"391,035\", 0),\n    ]\n    rendered_checks = []\n    for oid, label, literal, occurrence in rendered_specs:\n        annual_observation = next(o for o in observations if o[\"id\"] == oid)\n        rendered_checks.append(dict(\n            id=\"issuer_html.\" + oid,\n            annual_observation=oid,\n            label=label,\n            displayed_literal=literal,\n            source=rendered_row_match(docs[\"annual-2024-official\"], label, literal, occurrence),\n            status=\"visible_row_match_only\",\n            interpretation=\"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\",\n            source_value_usd=annual_observation[\"value_usd\"],\n        ))\n    matched = [x[\"annual_observation\"] for x in rendered_checks]\n    policy = policy_records(annual, interim, notes)\n    external = external_records(annual, interim, docs)\n    records = filing_records()\n    out = dict(schema_version=\"accdsl.apple_case.v1\", plan_sha256=PLAN_HASH,\n        scope=\"Retained Apple FY2024 annual, FY2025 Q1 interim and disclosed comparatives; selected numerical bridges only.\",\n        source_bindings=bindings, source_pins=PINS, p01_register=dict(path=REGISTER, sha256=file_hash(REGISTER)),\n        source_acquisition=acquisitions, fiscal_calendar=calendar, policies=policy,\n        observations=observations, notes=notes, reconciliations=bridges, external=external,\n        filing_availability=records, unidentified_histories=unidentified_records(notes),\n        rounding_model=dict(arithmetic=\"exact rational USD\", model=\"closed half-unit nearest-rounding intervals\",\n                            issuer_tie_rule=\"unknown\", inference=\"compatibility only; no distribution or identified underlying exact amounts\"),\n        representation_comparison=dict(matched_observations=matched, rendered_row_checks=rendered_checks,\n                                       whole_document_equivalence=False, mirror_publication_date=None,\n                                       historical_byte_vintage=\"not established\"),\n        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n        mapping_contract=dict(kind=\"explicit case annotations\", context_source=\"Report policies, table headings and original inline contexts\",\n            annual_dates=\"Fiscal year-end table headings plus Note 1 week lengths; duration starts are derived, not calendar-year substitutions.\",\n            partitions=\"Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.\",\n            measurements=\"Debt principal, carrying amount, fair value and derivative notional remain distinct.\",\n            supported_transformations=\"Only the recorded partition aggregation, gross/net signed addition, comparative equality and dated cash movement bridges.\"),\n        acceptance=dict(specified_behavior=\"reviewed P02 plan\", implemented=\"bounded reusable source/context/reconciliation adapter\",\n                        tested_invariants=\"see result.md for executed tests\", accounting_validity=\"selected displayed identities only; no compliance determination\",\n                        empirical_forecast_validity=\"not evaluated; no forecast generated\", human_acceptance=\"pending\"))\n    out[\"anchor_count\"] = validate_anchors(out)\n    return out\n\n\ndef validate_case(candidate):\n    \"\"\"Rebuild from independently pinned sources, rejecting supplied metadata edits.\"\"\"\n    validate_anchors(candidate)\n    expected = build_case()\n    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n    return {\"status\": \"pass\", \"observations\": len(expected[\"observations\"]),\n            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n            \"anchors\": expected[\"anchor_count\"]}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--output-dir\", default=\"data/accounting-master/deliverables/P02\")\n    parser.add_argument(\"--check\", action=\"store_true\", help=\"read-only rebuild and comparison\")\n    args = parser.parse_args()\n    target = ROOT / args.output_dir / \"case.json\"\n    if args.check:\n        report = validate_case(json.loads(target.read_text()))\n    else:\n        case = build_case()\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(case, ensure_ascii=False, indent=2, sort_keys=True)+\"\\n\")\n        report = dict(status=\"built\", **case[\"coverage\"])\n    print(json.dumps(report, sort_keys=True))\n\n\nif __name__ == \"__main__\":\n    main()\ncoverage {\"annual_notes\": 13, \"checked_bridges\": 34, \"fully_formalised_notes\": 0, \"interim_notes\": 10, \"notes_with_explicit_unresolved_meaning\": 23, \"notes_with_linked_quantities\": 9, \"numeric_observations\": 125, \"semantic_coverage\": \"not measured by note count\"}\nacceptance {\"accounting_validity\": \"selected displayed identities only; no compliance determination\", \"empirical_forecast_validity\": \"not evaluated; no forecast generated\", \"human_acceptance\": \"pending\", \"implemented\": \"bounded reusable source/context/reconciliation adapter\", \"specified_behavior\": \"reviewed P02 plan\", \"tested_invariants\": \"see result.md for executed tests\"}\nrepresentation_comparison {\"historical_byte_vintage\": \"not established\", \"matched_observations\": [\"annual.bs.2024-09-28.assets\", \"annual.bs.2024-09-28.liabilities\", \"annual.bs.2024-09-28.equity\", \"annual.bs.2024-09-28.debt_current\", \"annual.bs.2024-09-28.debt_noncurrent\", \"annual.revenue.2024\"], \"mirror_publication_date\": null, \"rendered_row_checks\": [{\"annual_observation\": \"annual.bs.2024-09-28.assets\", \"displayed_literal\": \"364,980\", \"id\": \"issuer_html.annual.bs.2024-09-28.assets\", \"interpretation\": \"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\", \"label\": \"Total assets\", \"source\": {\"document\": \"annual-2024-official\", \"end\": 139466, \"extraction_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.txt\", \"extraction_sha256\": \"52994e20bd190ab19d986c5b8b30de24816aeec509d918a8752507d37479bf87\", \"offset_unit\": \"Unicode code points\", \"original_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.html\", \"original_sha256\": \"e8fc9ecabfa4ab91e05eab06dac16302afc4253d9164207815b3a75ac7d39c1a\", \"quote\": \"Total assets\\n$\\n364,980\", \"start\": 139444}, \"source_value_usd\": \"364980000000\", \"status\": \"visible_row_match_only\"}, {\"annual_observation\": \"annual.bs.2024-09-28.liabilities\", \"displayed_literal\": \"308,030\", \"id\": \"issuer_html.annual.bs.2024-09-28.liabilities\", \"interpretation\": \"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\", \"label\": \"Total liabilities\", \"source\": {\"document\": \"annual-2024-official\", \"end\": 139898, \"extraction_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.txt\", \"extraction_sha256\": \"52994e20bd190ab19d986c5b8b30de24816aeec509d918a8752507d37479bf87\", \"offset_unit\": \"Unicode code points\", \"original_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.html\", \"original_sha256\": \"e8fc9ecabfa4ab91e05eab06dac16302afc4253d9164207815b3a75ac7d39c1a\", \"quote\": \"Total liabilities\\n308,030\", \"start\": 139873}, \"source_value_usd\": \"308030000000\", \"status\": \"visible_row_match_only\"}, {\"annual_observation\": \"annual.bs.2024-09-28.equity\", \"displayed_literal\": \"56,950\", \"id\": \"issuer_html.annual.bs.2024-09-28.equity\", \"interpretation\": \"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\", \"label\": \"Total shareholders\\u2019 equity\", \"source\": {\"document\": \"annual-2024-official\", \"end\": 140260, \"extraction_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.txt\", \"extraction_sha256\": \"52994e20bd190ab19d986c5b8b30de24816aeec509d918a8752507d37479bf87\", \"offset_unit\": \"Unicode code points\", \"original_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.html\", \"original_sha256\": \"e8fc9ecabfa4ab91e05eab06dac16302afc4253d9164207815b3a75ac7d39c1a\", \"quote\": \"Total shareholders\\u2019 equity\\n56,950\", \"start\": 140227}, \"source_value_usd\": \"56950000000\", \"status\": \"visible_row_match_only\"}, {\"annual_observation\": \"annual.bs.2024-09-28.debt_current\", \"displayed_literal\": \"10,912\", \"id\": \"issuer_html.annual.bs.2024-09-28.debt_current\", \"interpretation\": \"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\", \"label\": \"Term debt\", \"source\": {\"document\": \"annual-2024-official\", \"end\": 139685, \"extraction_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.txt\", \"extraction_sha256\": \"52994e20bd190ab19d986c5b8b30de24816aeec509d918a8752507d37479bf87\", \"offset_unit\": \"Unicode code points\", \"original_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.html\", \"original_sha256\": \"e8fc9ecabfa4ab91e05eab06dac16302afc4253d9164207815b3a75ac7d39c1a\", \"quote\": \"Term debt\\n10,912\", \"start\": 139669}, \"source_value_usd\": \"10912000000\", \"status\": \"visible_row_match_only\"}, {\"annual_observation\": \"annual.bs.2024-09-28.debt_noncurrent\", \"displayed_literal\": \"85,750\", \"id\": \"issuer_html.annual.bs.2024-09-28.debt_noncurrent\", \"interpretation\": \"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\", \"label\": \"Term debt\", \"source\": {\"document\": \"annual-2024-official\", \"end\": 139775, \"extraction_path\": \"docs/design/cases/apple/p02-v1/annual-2024-official.txt\