{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '849,917p' scripts/apple_case_v1.py\nsed -n '680,723p' scripts/apple_case_v1.py\"","aggregated_output":"def external_records(annual, interim, docs):\n    proxy, reg, official = [docs[k] for k in (\"proxy-2025\", \"registration-2021\", \"annual-2024-official\")]\n    exhibits = exhibit_records(annual, official, interim)\n    obligations = []\n    proxy_patterns = {\n        10: r\"Board Independence\\nApple’s Corporate Governance Guidelines.*?applicable rules of The Nasdaq Stock Market LLC.*?\\(“Nasdaq”\\)\\.\",\n        11: r\"Compensation Discussion and Analysis\\nThis Compensation.*?paid to our named executive officers\\.\",\n        12: r\"Security\\nOwnership of Certain Beneficial Owners and Management\\nThe\\nfollowing table.*?\\(the “Table Date”\\)\",\n        13: r\"Related Party Policy and Transactions\\nThe Board has.*?\\$120,000 in a single fiscal year\",\n        14: r\"Audit Fees\\n\\(1\\).*?Total\\n30,270,822\\n25,403,329\",\n    }\n    lo, hi = annual.page(52)\n    for item, pat in proxy_patterns.items():\n        start = annual.find(r\"Item \"+str(item)+r\"\\.[^\\n]+\", (lo, hi))[\"start\"]\n        stop = annual.text.find(\"Item \"+str(item+1)+\".\", start, hi) if item < 14 else hi\n        obligations.append(dict(id=f\"annual.partIII.item{item}\", target=\"2025 proxy, accession 0001308179-25-000008\",\n                                incorporation=annual.anchor(start, stop), support=proxy.find(pat, flags=re.S),\n                                status=\"target_acquired_selected_passage_inspected\",\n                                unresolved=\"Complete item-level semantics, exceptions and references beyond the selected passage remain unmodelled.\",\n                                consequence=\"Proxy information cannot be backdated to the annual filing.\",\n                                next_route=\"Inspect remaining sections in the retained proxy and its exact incorporated targets.\"))\n    title = reg.find(r\"Exhibit 4\\.1\\nApple Inc\\..*?Dated as of October\\s+28, 2021\", flags=re.S)\n    terms = reg.find(r\"Section\\s+301\\.\\nAmount\\nUnlimited; Issuable in Series.*?Section\\s+302\\.\", flags=re.S)\n    # The retained issuer extraction omits the indenture's section numbers,\n    # but preserves the substantive heading and the following covenants.\n    defaults = reg.find(r\"Events of Default\\n.*?Discharge, Defeasance and Covenant Defeasance\", flags=re.S)\n    for e in exhibits:\n        if e[\"id\"] == \"annual.exhibit.4.26\":\n            e.update(contents_status=\"acquired_in_registration_2021; selected_sections_inspected\", acquired_support=title,\n                     section_301=terms, section_501=defaults,\n                     missing_terms=\"Series-specific officer certificates, outstanding balances, amendments and swap confirmations/allocation.\")\n    # Source content after the annual report includes filed exhibits; 4.1 is not a missing external indenture.\n    securities = annual.find(r\"(?m)^[ \\t]*4\\.1[^\\n]*Description of Securities of the Registrant\\.\")\n    obligations.append(dict(id=\"annual.exhibit.4.1.in_pdf\", target=\"Description of Securities, filed exhibit 4.1\",\n                            support=securities, status=\"heading_and_contents_retained_in_pdf\",\n                            unresolved=\"Description is not the complete incorporated indentures and series certificates.\",\n                            consequence=\"General descriptions do not identify all current debt terms.\",\n                            next_route=\"Inspect specific 4.2–4.28 index targets for contract reconstruction.\"))\n    omissions = annual.find(r\"Certain instruments defining the rights of holders.*?copies of any such instruments\\.\", annual.page(56), re.S)\n    obligations.append(dict(id=\"omitted_debt_instruments\", target=\"Instruments omitted under Item 601(b)(4)(iii)\", support=omissions,\n                            status=\"expressly_omitted_from_filing\", unresolved=\"Instrument identities and complete terms not specified by this index.\",\n                            consequence=\"No complete debt-contract inventory is established.\",\n                            next_route=\"Inspect issuer/SEC public filings for identifiable instruments; do not infer terms or initiate outreach.\"))\n    return dict(partIII_and_package_obligations=obligations, exhibit_inventory=exhibits,\n                agreement_interpretation=dict(status=\"selected_contract_sections_only\", support=[title, terms, defaults],\n                    interpretation=\"Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.\",\n                    missing=\"2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule.\"))\n\n\ndef unidentified_records(notes):\n    n = {r[\"id\"]: r for r in notes}\n    specs = [\n        (\"debt_and_swaps\", [\"annual.note.9\", \"annual.note.4\", \"interim.note.6\", \"interim.note.4\"],\n         \"Annual interest-rate notional and interim notional are disclosed but contract allocation, resets, hedge coverage and net economic exposure remain unidentified.\",\n         \"Obtain series certificates and public hedge terms; never equate derivative notional with floating-rate debt exposure.\"),\n        (\"debt_movements\", [\"annual.note.9\", \"interim.note.6\"],\n         \"Carrying differences cannot be identified solely from cash issuance/repayment; FX and noncash measurement changes remain separate unknowns.\",\n         \"Reconstruct movements only with sourced FX, hedge, discount and noncash adjustments.\"),\n        (\"asset_cohorts\", [\"annual.note.5\", \"interim.note.5\"],\n         \"Gross/net balances do not identify vintages, remaining useful lives, additions and retirements.\",\n         \"Retain alternative cohort histories until transaction or asset-register evidence supports a narrower family.\"),\n        (\"contingent_outcomes\", [\"annual.note.12\", \"interim.note.9\"],\n         \"Management's loss assessment and commitment amounts do not provide a loss probability measure or a zero liability.\",\n         \"Maintain unresolved outcomes and revisit dated legal disclosures; do not assign equal or confidence-derived probabilities.\"),\n    ]\n    return [dict(id=key, supports=[n[k][\"anchor\"] for k in ids], unresolved=meaning, next_action=action,\n                 status=\"not_identified\", probability=None) for key, ids, meaning, action in specs]\n\n\ndef note_records(annual, interim, observations):\n    notes = discover_notes(annual, 13)+discover_notes(interim, 10)\n    inventory = json.loads((ROOT/APPLE/\"manifest.json\").read_text())[\"notes\"]\n    require([(n[\"id\"], n[\"title\"]) for n in notes] == [(n[\"id\"], n[\"title\"]) for n in inventory],\n            \"note inventory disagreement\")\n    for note in notes:\n        areas, interpretation, unknown = NOTE_MEANING[note[\"title\"]]\n        note.update(disposition=\"partially_mapped\" if note[\"number\"] in (1, 2, 4) else \"unresolved_meaning_retained\",\n                    affected_model_areas=areas, interpretation=interpretation,\n                    unresolved_meaning=unknown, semantic_completion=False, linked_quantities=[],\n                    qualifications=\"The full bounded source passage is retained; only the stated interpretation is applied.\")\n        a = note[\"anchor\"]\n        for obs in observations:\n            for source in walk_anchors(obs[\"source_readings\"]):\n                if source.get(\"extraction_path\") == a[\"extraction_path\"] and a[\"start\"] <= source[\"start\"] < a[\"end\"]:\n                    note[\"linked_quantities\"].append(obs[\"id\"])\n                    break\n        # Inline fact locations live in HTML, not in the independent text extraction.\n        # Match the fact's literal/concept within this note's corresponding ix:textBlock.\n        if a[\"document\"] == \"interim\":\n            prefixes = {2: [\"interim.product.\"], 4: [\"interim.notional.\"],\n                        6: [\"interim.debt.\"], 10: [\"interim.segment.\"]}.get(note[\"number\"], [])\n            note[\"linked_quantities\"] = [o[\"id\"] for o in observations if any(o[\"id\"].startswith(p) for p in prefixes)]\n        note[\"linked_quantities\"] = sorted(set(note[\"linked_quantities\"]))\n        if note[\"linked_quantities\"]:\n            note[\"disposition\"] = \"selected_quantities_mapped_with_unresolved_remainder\"\n        targets = sorted(set(int(n) for n in re.findall(r\"Note\\s+(\\d+)\", a[\"quote\"])))\n        note[\"cross_references\"] = [dict(target=f\"{a['document']}.note.{n}\",\n                                         relation=\"literal note reference\", status=\"source_present; meaning not necessarily executed\")\n                                    for n in targets if n != note[\"number\"]]\n        require(all(t[\"target\"] in {n[\"id\"] for n in notes} for t in note[\"cross_references\"]), \"unresolved internal note target\")\n    by_id = {n[\"id\"]: n for n in notes}\n    by_id[\"annual.note.9\"][\"cross_references\"].append(dict(target=\"annual.note.4\", relation=\"analyst link: debt and interest-rate swaps\", status=\"source_present\"))\n    by_id[\"interim.note.1\"][\"cross_references\"].append(dict(target=\"annual.note.1\", relation=\"explicit read-with-2024-10-K qualification\", status=\"source_present\"))\n    contingency = by_id[\"interim.note.9\"]\n    contingency[\"assertion\"] = dict(kind=\"reported_management_assessment\", speaker=\"Apple management\",\n        subject=\"asserted legal and other claims\", modal_operator=\"not at least a reasonable possibility\",\n        assessed_event=\"material loss, or material loss greater than a recorded accrual\",\n        unresolved_outcomes=True, probability=None, liability_amount=None,\n        anchor=interim.find(r\"The Company is subject to various legal proceedings.*?asserted legal and other claims\\.\",\n                            (contingency[\"anchor\"][\"start\"], contingency[\"anchor\"][\"end\"]), re.S))\n    return notes\n\n\n","exit_code":0,"status":"completed"}}
