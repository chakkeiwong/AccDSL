{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '930,1030p' scripts/apple_case_v1.py\"","aggregated_output":"        (\"annual.bs.2024-09-28.equity\", \"Total shareholders’ equity\", \"56,950\", 0),\n        (\"annual.bs.2024-09-28.debt_current\", \"Term debt\", \"10,912\", 0),\n        (\"annual.bs.2024-09-28.debt_noncurrent\", \"Term debt\", \"85,750\", 0),\n        (\"annual.revenue.2024\", \"Total net sales\", \"391,035\", 0),\n    ]\n    rendered_checks = []\n    for oid, label, literal, occurrence in rendered_specs:\n        annual_observation = next(o for o in observations if o[\"id\"] == oid)\n        rendered_checks.append(dict(\n            id=\"issuer_html.\" + oid,\n            annual_observation=oid,\n            label=label,\n            displayed_literal=literal,\n            source=rendered_row_match(docs[\"annual-2024-official\"], label, literal, occurrence),\n            status=\"visible_row_match_only\",\n            interpretation=\"Selected rendered-row agreement supports representation checking; it does not establish whole-document equivalence or historical byte vintage.\",\n            source_value_usd=annual_observation[\"value_usd\"],\n        ))\n    matched = [x[\"annual_observation\"] for x in rendered_checks]\n    policy = policy_records(annual, interim, notes)\n    external = external_records(annual, interim, docs)\n    records = filing_records()\n    out = dict(schema_version=\"accdsl.apple_case.v1\", plan_sha256=PLAN_HASH,\n        scope=\"Retained Apple FY2024 annual, FY2025 Q1 interim and disclosed comparatives; selected numerical bridges only.\",\n        source_bindings=bindings, source_pins=PINS, p01_register=dict(path=REGISTER, sha256=file_hash(REGISTER)),\n        source_acquisition=acquisitions, fiscal_calendar=calendar, policies=policy,\n        observations=observations, notes=notes, reconciliations=bridges, external=external,\n        filing_availability=records, unidentified_histories=unidentified_records(notes),\n        rounding_model=dict(arithmetic=\"exact rational USD\", model=\"closed half-unit nearest-rounding intervals\",\n                            issuer_tie_rule=\"unknown\", inference=\"compatibility only; no distribution or identified underlying exact amounts\"),\n        representation_comparison=dict(matched_observations=matched, rendered_row_checks=rendered_checks,\n                                       whole_document_equivalence=False, mirror_publication_date=None,\n                                       historical_byte_vintage=\"not established\"),\n        coverage=dict(annual_notes=13, interim_notes=10, notes_with_linked_quantities=sum(bool(n[\"linked_quantities\"]) for n in notes),\n                      notes_with_explicit_unresolved_meaning=len(notes), numeric_observations=len(observations),\n                      checked_bridges=len(bridges), fully_formalised_notes=0, semantic_coverage=\"not measured by note count\"),\n        mapping_contract=dict(kind=\"explicit case annotations\", context_source=\"Report policies, table headings and original inline contexts\",\n            annual_dates=\"Fiscal year-end table headings plus Note 1 week lengths; duration starts are derived, not calendar-year substitutions.\",\n            partitions=\"Product and geographic segment totals are reconciled separately; no product-by-geography cross-tab is identified.\",\n            measurements=\"Debt principal, carrying amount, fair value and derivative notional remain distinct.\",\n            supported_transformations=\"Only the recorded partition aggregation, gross/net signed addition, comparative equality and dated cash movement bridges.\"),\n        acceptance=dict(specified_behavior=\"reviewed P02 plan\", implemented=\"bounded reusable source/context/reconciliation adapter\",\n                        tested_invariants=\"see result.md for executed tests\", accounting_validity=\"selected displayed identities only; no compliance determination\",\n                        empirical_forecast_validity=\"not evaluated; no forecast generated\", human_acceptance=\"pending\"))\n    out[\"anchor_count\"] = validate_anchors(out)\n    return out\n\n\ndef validate_case(candidate):\n    \"\"\"Rebuild from independently pinned sources, rejecting supplied metadata edits.\"\"\"\n    validate_anchors(candidate)\n    expected = build_case()\n    require(candidate == expected, \"case differs from source-derived rebuild (values, metadata, notes or obligations)\")\n    return {\"status\": \"pass\", \"observations\": len(expected[\"observations\"]),\n            \"notes\": len(expected[\"notes\"]), \"reconciliations\": len(expected[\"reconciliations\"]),\n            \"anchors\": expected[\"anchor_count\"]}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--output-dir\", default=\"data/accounting-master/deliverables/P02\")\n    parser.add_argument(\"--check\", action=\"store_true\", help=\"read-only rebuild and comparison\")\n    args = parser.parse_args()\n    target = ROOT / args.output_dir / \"case.json\"\n    if args.check:\n        report = validate_case(json.loads(target.read_text()))\n    else:\n        case = build_case()\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(case, ensure_ascii=False, indent=2, sort_keys=True)+\"\\n\")\n        report = dict(status=\"built\", **case[\"coverage\"])\n    print(json.dumps(report, sort_keys=True))\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('data/accounting-master/deliverables/P02/case.json'); d=json.loads(p.read_text());\nprint('keys',d.keys()); print('external',json.dumps(d['external'],indent=2)[:9000]); print('repr',json.dumps(d['representation_comparison'],indent=2)[:3000]); print('notes')\nfor n in d['notes']: print(n['id'], n['title'], len(n.get('linked_quantities',[])),n.get('linked_quantities',[])[:4])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('data/accounting-master/deliverables/P02/case.json'); d=json.loads(p.read_text());\nprint('keys',d.keys()); print('external',json.dumps(d['external'],indent=2)[:9000]); print('repr',json.dumps(d['representation_comparison'],indent=2)[:3000]); print('notes')\nfor n in d['notes']: print(n['id'], n['title'], len(n.get('linked_quantities',[])),n.get('linked_quantities',[])[:4])\nPY\"","aggregated_output":"keys dict_keys(['acceptance', 'anchor_count', 'coverage', 'external', 'filing_availability', 'fiscal_calendar', 'mapping_contract', 'notes', 'observations', 'p01_register', 'plan_sha256', 'policies', 'reconciliations', 'representation_comparison', 'rounding_model', 'schema_version', 'scope', 'source_acquisition', 'source_bindings', 'source_pins', 'unidentified_histories'])\nexternal {\n  \"agreement_interpretation\": {\n    \"interpretation\": \"Section 301 leaves series-specific principal/payment dates, interest terms and optional redemption to further instruments. Section 501 defines events of default with conditions; this case does not assert a default occurred.\",\n    \"missing\": \"2013/2018 indentures and series certificates remain external; the 2021 base indenture does not identify Apple's current swap reset schedule.\",\n    \"status\": \"selected_contract_sections_only\",\n    \"support\": [\n      {\n        \"document\": \"registration-2021\",\n        \"end\": 97845,\n        \"extraction_path\": \"docs/design/cases/apple/p02-v1/registration-2021.txt\",\n        \"extraction_sha256\": \"0736f98e4676e0111803445efce78b9bf4c3db33b1730feaa8272445edc46285\",\n        \"offset_unit\": \"Unicode code points\",\n        \"original_path\": \"docs/design/cases/apple/p02-v1/registration-2021.html\",\n        \"original_sha256\": \"bed77c1fa9b7e873523daa6e0fa9e05dc9791aa547d1b944d4af0742b3fa04df\",\n        \"quote\": \"Exhibit 4.1\\nApple Inc.\\nas Issuer\\nand\\nThe Bank of New York Mellon\\nTrust Company, N.A.,\\nas Trustee\\nINDENTURE\\nDated as of October\\u00a028, 2021\",\n        \"start\": 97710\n      },\n      {\n        \"document\": \"registration-2021\",\n        \"end\": 162742,\n        \"extraction_path\": \"docs/design/cases/apple/p02-v1/registration-2021.txt\",\n        \"extraction_sha256\": \"0736f98e4676e0111803445efce78b9bf4c3db33b1730feaa8272445edc46285\",\n        \"offset_unit\": \"Unicode code points\",\n        \"original_path\": \"docs/design/cases/apple/p02-v1/registration-2021.html\",\n        \"original_sha256\": \"bed77c1fa9b7e873523daa6e0fa9e05dc9791aa547d1b944d4af0742b3fa04df\",\n        \"quote\": \"Section\\u00a0301.\\nAmount\\nUnlimited; Issuable in Series\\n.\\nThe aggregate principal amount of Securities which may be authenticated and delivered under this\\nIndenture is unlimited.\\nThe Securities may be issued in one or more series. There shall be established in or pursuant to (a)\\u00a0a\\nBoard Resolution or pursuant to authority granted by a Board Resolution and, subject to Section\\u00a0303, set forth, or determined in the manner provided, in an Officer\\u2019s Certificate, or (b)\\u00a0one or more indentures supplemental hereto,\\nprior to the issuance of Securities of any series:\\n(1)\\nthe title of the Securities of the series (which shall distinguish the Securities of the series from Securities of any\\nother series);\\n(2)\\nthe limit, if any, on the aggregate principal amount of the Securities of the series which may be authenticated and\\ndelivered under this Indenture (except for Securities authenticated and delivered upon registration of transfer of, or in exchange for, or in lieu of, other Securities of the series pursuant to Section\\u00a0304, Section\\u00a0305, Section\\u00a0306,\\nSection\\u00a0906, Section\\u00a01107 or Section\\u00a01405 and except for any Securities which, pursuant to Section\\u00a0303, are deemed never to have been authenticated and delivered hereunder);\\nprovided\\n,\\nhowever\\n, that the authorized\\naggregate principal amount of such series may from time to time be increased above such amount by a Board Resolution to such effect;\\n(3)\\nthe price or prices at which the Securities will be sold;\\n(4)\\nthe Person to whom any interest on a Security of the series shall be payable, if other than the Person in whose name\\nthat Security (or one or more Predecessor Securities) is registered at the close of business on the Regular Record Date for such interest;\\n(5)\\nthe date or dates on which the principal and premium, if any, of any Securities of the series is payable or the method\\nused to determine or extend those dates;\\n(6)\\nthe rate or rates at which any Securities of the series shall bear interest, if any, or the method by which such rate\\nor rates shall be determined, the date or dates from which any such interest shall accrue, or the method by which such date or dates shall be determined, the Interest Payment Dates on which any such interest shall be payable and the Regular Record\\nDate, if any, for any such interest payable on any Interest Payment Date, or the method by which such date or dates shall be determined, and the basis upon which interest shall be calculated if other than that of a\\n360-day\\nyear of twelve\\n30-day\\nmonths, the right, if any, to extend or defer interest payments and the duration of such extension or deferral;\\n(7)\\nthe place or places where the principal of and any premium and interest on any Securities of the series shall be\\npayable, the place or places where the Securities of such series may be presented for registration of transfer or exchange, the place or places where notices and demands to or upon the Company in respect of the Securities of such series may be made\\nand the manner in which any payment may be made;\\n(8)\\nthe period or periods within which or the date or dates on which, the price or prices at which, the currency or\\ncurrency units in which, and the terms and conditions upon which any Securities of the series may be redeemed, in whole or in part, at the option of the Company and, if other than by a Board Resolution, the manner in which any election by the\\nCompany to redeem the Securities shall be evidenced;\\n(9)\\nthe obligation or the right, if any, of the Company to redeem or purchase any Securities of the series pursuant to any\\nsinking fund, amortization or analogous provisions or at the option of the Holder thereof and the period or periods within which, the price or prices at which, the currency or currency units in which, and the terms and conditions upon which any\\nSecurities of the series shall be redeemed or purchased, in whole or in part, pursuant to such obligation;\\n(10)\\nif other than denominations of $2,000 and any integral multiple of $1,000 in excess thereof, the denominations in\\nwhich any Securities of the series shall be issuable;\\n(11)\\nif other than the Trustee, the identity of each Security Registrar and/or Paying Agent;\\n12\\n(12)\\nif the amount of principal of or premium, if any, or interest on any Securities of the series may be determined with\\nreference to a financial or economic measure or index or pursuant to a formula, the manner in which such amounts shall be determined;\\n(13)\\nif other than the currency of the United States of America, the currency, currencies or currency units in which the\\nprincipal of or premium, if any, or interest on any Securities of the series shall be payable and the manner of determining the equivalent thereof in the currency of the United States of America for any purpose, including for purposes of the\\ndefinition of \\u201c\\nOutstanding\\n\\u201d in Section\\u00a0101;\\n(14)\\nif the principal of or premium, if any, or interest on any Securities of the series is to be payable, at the election\\nof the Company or the Holder thereof, in one or more currencies or