{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' scripts/apple_case_v1.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Bounded, source-bound Apple case. No acquisition or forecasting at build time.\n\nMappings below are annotations; numbers are read from pinned source bytes.\nAll amounts used by the arithmetic engine are exact rational USD amounts.\nRevalidation rebuilds from sources, so editing an observation's metadata cannot\nchange its source meaning. This is a case adapter, not a general XBRL processor.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom datetime import date, datetime, timedelta, timezone\nfrom fractions import Fraction\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\n\nfrom bs4 import BeautifulSoup\n\nROOT = Path(__file__).resolve().parents[1]\nAPPLE = \"docs/design/cases/apple/\"\nNEW = APPLE + \"p02-v1/\"\nREGISTER = \"data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json\"\nINDEX = \"data/financial-report-benchmark/landing/apple/21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42.json\"\nPLAN_HASH = \"916a4c80553bebee3ca0b6399ba8d4e54a6f5d3bd2975cda75815b95e8f45f59\"\nPINS = {\n    APPLE + \"annual-2024.pdf\": \"ec74758cd767465362c641cf2fd5d8fedd477aed2bf7f62117e67610435dcb88\",\n    APPLE + \"annual-2024.txt\": \"caaf182340d3846ff54cf967a2d3da7dce82505170665943ea7227e6bed8336e\",\n    APPLE + \"interim-2025q1.html\": \"2f7629f0733f75b3155dd52f7ae6a8724468e3cde1a9ce32fbce96d98f1ec27e\",\n    APPLE + \"interim-2025q1.txt\": \"ab8e06fc35957f43a355d0d1d11d57d203b494a4008edb39cff162e984ef633b\",\n    APPLE + \"manifest.json\": \"f25b63803d8a7e136befa10d68b935f521aa42ffc95663b6c26d792b0e4e5fc7\",\n    INDEX: \"21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42\",\n}\nMILLION = 10**6\nENTITY = \"0000320193\"\nPRODUCTS = [\"iPhone\", \"Mac\", \"iPad\", \"Wearables, Home and Accessories\", \"Services\"]\nSEGMENTS = [\"Americas\", \"Europe\", \"Greater China\", \"Japan\", \"Rest of Asia Pacific\"]\nPRODUCT_MEMBERS = [\"aapl:IPhoneMember\", \"aapl:MacMember\", \"aapl:IPadMember\",\n                   \"aapl:WearablesHomeandAccessoriesMember\", \"us-gaap:ServiceMember\"]\nSEGMENT_MEMBERS = [\"aapl:AmericasSegmentMember\", \"aapl:EuropeSegmentMember\",\n                   \"aapl:GreaterChinaSegmentMember\", \"aapl:JapanSegmentMember\",\n                   \"aapl:RestOfAsiaPacificSegmentMember\"]\nREV = \"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"\nCF_BAL = \"us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents\"\n\n\nclass CaseError(ValueError):\n    \"\"\"A source or interpretation fails the supported case contract.\"\"\"\n\n\ndef require(condition, message):\n    if not condition:\n        raise CaseError(message)\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef file_hash(path):\n    return sha((ROOT / path).read_bytes())\n\n\ndef power10(n):\n    return Fraction(10)**n\n\n\ndef number(literal):\n    s = re.sub(r\"[\\s$]\", \"\", literal)\n    if s in (\"—\", \"–\"):\n        return Fraction(0)\n    require(bool(re.fullmatch(r\"(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\", s)) or\n            bool(re.fullmatch(r\"\\((?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\\)\", s)), \"unsupported numeric literal: \" + literal)\n    s = s.replace(\",\", \"\")\n    return -Fraction(s[1:-1]) if s.startswith(\"(\") else Fraction(s)\n\n\ndef interval(value, quantum):\n    v, q = Fraction(value), Fraction(quantum)\n    require(q > 0, \"precision must be positive\")\n    return [str(v-q/2), str(v+q/2)]\n\n\ndef interval_sum(observations, coefficients=None):\n    coefs = coefficients or [1]*len(observations)\n    require(len(coefs) == len(observations), \"coefficient count\")\n    lo = hi = Fraction(0)\n    for obs, c in zip(observations, coefs):\n        a, b = map(Fraction, obs[\"rounding_interval_usd\"])\n        lo += min(c*a, c*b)\n        hi += max(c*a, c*b)\n    return lo, hi\n\n\ndef compatible(left, right):\n    return max(Fraction(left[0]), Fraction(right[0])) <= min(Fraction(left[1]), Fraction(right[1]))\n\n\nclass Document:\n    def __init__(self, identity, original, extraction, pdf=False):\n        self.identity, self.original, self.extraction, self.pdf = identity, original, extraction, pdf\n        self.original_hash, self.extraction_hash = file_hash(original), file_hash(extraction)\n        self.text = (ROOT/extraction).read_text()\n\n    def anchor(self, start, end):\n        require(0 <= start < end <= len(self.text), \"anchor range\")\n        out = dict(document=self.identity, original_path=self.original,\n                   original_sha256=self.original_hash, extraction_path=self.extraction,\n                   extraction_sha256=self.extraction_hash, offset_unit=\"Unicode code points\",\n                   start=start, end=end, quote=self.text[start:end])\n        if self.pdf:\n            page_start = self.text.rfind(\"\\f\", 0, start)+1\n            page_end = self.text.find(\"\\f\", start)\n            page = self.text[page_start:page_end if page_end >= 0 else len(self.text)]\n            m = re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| (\\d+)\", page)\n            out.update(pdf_page=self.text.count(\"\\f\", 0, start)+1,\n                       printed_page=int(m[1]) if m else None,\n                       ending_pdf_page=self.text.count(\"\\f\", 0, end-1)+1)\n        return out\n\n    def find(self, pattern, bounds=None, flags=0):\n        start, end = bounds or (0, len(self.text))\n        matches = list(re.finditer(pattern, self.text[start:end], flags))\n        require(len(matches) == 1, f\"{self.identity}: expected unique span {pattern!r}, got {len(matches)}\")\n        m = matches[0]\n        return self.anchor(start+m.start(), start+m.end())\n\n    def page(self, printed):\n        offset = 0\n        for page in self.text.split(\"\\f\"):\n            if re.search(r\"Apple Inc\\. \\| 2024 Form 10-K \\| \" + str(printed) + r\"\\s*$\", page):\n                return offset, offset+len(page)\n            offset += len(page)+1\n        raise CaseError(\"printed page missing\")\n\n    def binding(self):\n        return dict(id=self.identity, original_path=self.original, original_sha256=self.original_hash,\n                    extraction_path=self.extraction, extraction_sha256=self.extraction_hash)\n\n\ndef discover_notes(doc, expected):\n    matches = list(re.finditer(r\"(?m)^[\\f \\t]*Note (\\d+)\\s*[–-]\\s*([^\\n]+)\", doc.text))\n    require([int(m[1]) for m in matches] == list(range(1, expected+1)), \"missing, duplicate or reordered notes\")\n    marker = \"Report of Independent Registered\" if doc.pdf else \"Item 2.\"\n    out = []\n    for i, m in enumerate(matches):\n        end = matches[i+1].start() if i+1 < len(matches) else doc.text.find(marker, m.end())\n        require(end > m.end(), \"final note boundary missing\")\n        start = m.start() + len(m[0])-len(m[0].lstrip())\n        out.append(dict(id=f\"{doc.identity}.note.{m[1]}\", number=int(m[1]), title=m[2].strip(),\n                        anchor=doc.anchor(start, end), heading=doc.anchor(start, m.end())))\n    return out\n\n\ndef context(period, dimensions=None):\n    return dict(entity=ENTITY, entity_scheme=\"http://www.sec.gov/CIK\", perimeter=\"consolidated\",\n                basis=\"US GAAP\", currency=\"USD\", period=period, dimensions=dimensions or {})\n\n\ndef observation(oid, concept, value, literal, scale, quantum, ctx, measurement, anchors, **extra):\n    out = dict(id=oid, concept=concept, displayed_literal=literal, scale=scale,\n               value_usd=str(value), presentation_quantum_usd=str(quantum), context=ctx,\n               measurement=measurement, rounding_interval_usd=interval(value, quantum),\n               source_readings=anchors, status=\"extracted_reading\", **extra)\n    return out\n\n\ndef annual_row(doc, label, column, ctx, concept, measurement, bounds, columns,\n               header, oid, partition=None):\n    # A row is selected by its label within a scoped table, never by its value.\n    a = doc.find(r\"^[ \\t]*\" + re.escape(label) + r\"[ \\t]{2,}[^\\n]+\", bounds, re.M)\n    line = a[\"quote\"]\n    begin = line.index(label)+len(label)\n    tokens = list(re.finditer(r\"\\(?[\\d,]+(?:\\.\\d+)?\\)?|—\", line[begin:]))\n    require(len(tokens) == columns, f\"{label}: ambiguous table columns\")\n    token = tokens[column]\n    start = a[\"start\"]+begin+token.start()\n    literal = token[0]\n    return observation(oid, concept, number(literal)*MILLION, literal, 6, MILLION,\n                       ctx, measurement, [dict(row=a, cell=doc.anchor(start, start+len(literal)),\n                                               table_header=header, column_index=column)], partition=partition)\n\n\nclass InlineReader:\n    \"\"\"Strict subset of inline-XBRL used in this case, retaining raw ID anchors.\"\"\"\n    def __init__(self, doc):\n        self.doc = doc\n        self.raw = (ROOT/doc.original).read_text()\n        self.soup = BeautifulSoup(self.raw, \"html.parser\")\n        self.ids = {}\n        for el in self.soup.find_all(id=True):\n            require(el[\"id\"] not in self.ids, \"duplicate HTML/XBRL id\")\n            self.ids[el[\"id\"]] = el\n        self.facts = self.soup.find_all(\"ix:nonfraction\")\n\n    def raw_anchor(self, el):\n        # Exact original bytes (ASCII-compatible UTF-8 text offsets), not soup serialization.\n        pattern = r\"<\" + re.escape(el.name) + r\"\\b[^>]*\\bid=[\\\"']\" + re.escape(el[\"id\"]) + r\"[\\\"'][^>]*>.*?</\" + re.escape(el.name) + r\">\"\n        matches = list(re.finditer(pattern, self.raw, re.S | re.I))\n        require(len(matches) == 1, \"raw ID anchor missing/ambiguous\")\n        m = matches[0]\n        return dict(path=self.doc.original, sha256=self.doc.original_hash,\n                    start=m.start(), end=m.end(), quote=m[0], offset_unit=\"Unicode code points\", id=el[\"id\"])\n\n    def resolve(self, ref, tag):\n        require(ref in self.ids and self.ids[ref].name == tag, f\"broken {tag} reference {ref}\")\n        return self.ids[ref]\n\n    def parse_context(self, el):\n        identifier = el.find_all(\"xbrli:identifier\")\n        require(len(identifier) == 1, \"ambiguous entity\")\n        require(identifier[0].get(\"scheme\") == \"http://www.sec.gov/CIK\", \"unsupported entity scheme\")\n        period = el.find(\"xbrli:period\")\n        require(period is not None, \"missing period\")\n        tags = [n for n in period.children if getattr(n, \"name\", None)]\n        names = [n.name for n in tags]\n        require(names in [[\"xbrli:instant\"], [\"xbrli:startdate\", \"xbrli:enddate\"]], \"unsupported period\")\n        dates = [date.fromisoformat(n.get_text()).isoformat() for n in tags]\n        require(len(dates) == 1 or dates[0] <= dates[1], \"reversed period\")\n        p = dict(instant=dates[0]) if len(dates) == 1 else dict(start=dates[0], end=dates[1])\n        require(not el.find(\"xbrldi:typedmember\") and not el.find(\"xbrli:scenario\"), \"unsupported context content\")\n        dims = {}\n        for d in el.find_all(\"xbrldi:explicitmember\"):\n            require(d.get(\"dimension\") and d[\"dimension\"] not in dims, \"duplicate/missing dimension\")\n            dims[d[\"dimension\"]] = d.get_text()\n        out = context(p, dims)\n        out[\"entity\"] = identifier[0].get_text()\n        return out\n\n    def parse(self, fact):\n        cid, uid = fact.get(\"contextref\"), fact.get(\"unitref\")\n        c, u = self.resolve(cid, \"xbrli:context\"), self.resolve(uid, \"xbrli:unit\")\n        ctx = self.parse_context(c)\n        measures = u.find_all(\"xbrli:measure\")\n        require(len(measures) == 1 and measures[0].get_text() == \"iso4217:USD\" and\n                not u.find(\"xbrli:divide\"), \"unsupported currency/unit\")\n        require(fact.get(\"sign\") in [None, \"-\"], \"unsupported sign\")\n        require(not fact.get(\"xsi:nil\") and not fact.get(\"continuedat\"), \"nil/continued numeric unsupported\")\n        require(re.fullmatch(r\"-?\\d+\", fact.get(\"scale\", \"0\")) is not None, \"invalid scale\")\n        require(re.fullmatch(r\"-?\\d+\", fact.get(\"decimals\", \"\")) is not None, \"unsupported precision\")\n        scale, decimals = int(fact.get(\"scale\", \"0\")), int(fact[\"decimals\"])\n        require(-12 <= scale <= 12 and -12 <= decimals <= 12, \"unbounded scale/precision\")\n        fmt, lit = fact.get(\"format\"), fact.get_text(strip=True)\n        if fmt == \"ixt:fixed-zero\":\n            require(lit in (\"—\", \"–\", \"0\"), \"invalid zero transform\")\n            v = Fraction(0)\n        elif fmt == \"ixt:num-dot-decimal\":\n            require(re.fullmatch(r\"(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\", lit) is not None, \"invalid decimal transform\")\n            v = number(lit)\n        elif fmt is None:\n            require(re.fullmatch(r\"\\d+(?:\\.\\d+)?\", lit) is not None, \"unformatted nonnumeric fact\")\n            v = Fraction(lit)\n        else:\n            raise CaseError(\"unsupported inline transform \" + fmt)\n        v *= power10(scale) * (-1 if fact.get(\"sign\") == \"-\" else 1)\n        row = fact.find_parent(\"tr\")\n        # Selected monetary rows must agree with the visual sign, unless narrative.\n        cell = fact.find_parent(\"td\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' tests/test_accounting_p02.py\"","aggregated_output":"\"\"\"Deterministic real-input checks for the bounded Apple P02 case.\n\nThe tests deliberately exercise the retained annual PDF/text and interim HTML\nthrough the reusable case adapter.  Expected identities below are stated from\nthe filing rows themselves; they are not copied from a generated case result.\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport unittest\n\nfrom scripts import apple_case_v1 as case\n\n\nROOT = Path(__file__).resolve().parents[1]\nOUT = ROOT / \"data/accounting-master/deliverables/P02\"\nCASE_PATH = OUT / \"case.json\"\nANNUAL_TEXT = ROOT / \"docs/design/cases/apple/annual-2024.txt\"\nINTERIM_HTML = ROOT / \"docs/design/cases/apple/interim-2025q1.html\"\n\n\nclass AccountingP02Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.case_data = json.loads(CASE_PATH.read_text())\n        cls.by_id = {o[\"id\"]: o for o in cls.case_data[\"observations\"]}\n\n    def test_real_inputs_build_and_independent_annual_arithmetic(self):\n        built = case.build_case()\n        self.assertEqual(len(built[\"notes\"]), 23)\n        self.assertEqual(built[\"coverage\"][\"annual_notes\"], 13)\n        self.assertEqual(built[\"coverage\"][\"interim_notes\"], 10)\n        self.assertEqual(built[\"acceptance\"][\"empirical_forecast_validity\"],\n                         \"not evaluated; no forecast generated\")\n\n        annual = ANNUAL_TEXT.read_text()\n        debt_row = re.search(\n            r\"Total term debt principal.*?97,341.*?\\n.*?\"\n            r\"Unamortized premium/\\(discount\\) and issuance costs, net.*?\\(321\\).*?\\n.*?\"\n            r\"Hedge accounting fair value adjustments.*?\\(358\\).*?\\n.*?\"\n            r\"Total term debt\\s+96,662\",\n            annual,\n            re.S,\n        )\n        self.assertIsNotNone(debt_row)\n        # Independent displayed-million arithmetic from the retained PDF text.\n        self.assertEqual(Fraction(97341) - Fraction(321) - Fraction(358),\n                         Fraction(96662))\n        self.assertEqual(\n            Fraction(10912) + Fraction(85750),\n            Fraction(96662),\n        )\n        self.assertIn(\"30,737\", annual)\n        self.assertIn(\"29,965\", annual)\n\n        # The independent retained HTML contains the actual tagged facts used\n        # by the interim reader, including the rounded narrative debt fact.\n        interim = INTERIM_HTML.read_text()\n        self.assertIn('name=\"us-gaap:LongTermDebt\"', interim)\n        self.assertIn('>94.8</ix:nonFraction>', interim)\n\n    def test_cli_check_rebuilds_case_from_sources(self):\n        result = subprocess.run(\n            [\"python3\", \"-B\", \"scripts/apple_case_v1.py\", \"--check\",\n             \"--output-dir\", \"data/accounting-master/deliverables/P02\"],\n            cwd=ROOT, text=True, capture_output=True, check=False,\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        report = json.loads(result.stdout)\n        self.assertEqual(report[\"status\"], \"pass\")\n        self.assertEqual(report[\"notes\"], 23)\n        self.assertGreater(report[\"anchors\"], 500)\n\n    def test_note_inventory_and_boundary_mutations_are_rejected(self):\n        annual = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                               case.APPLE + \"annual-2024.txt\", pdf=True)\n        self.assertEqual(len(case.discover_notes(annual, 13)), 13)\n        duplicate = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                  case.APPLE + \"annual-2024.txt\", pdf=True)\n        duplicate.text = duplicate.text.replace(\"Note 2 –\", \"Note 1 –\", 1)\n        with self.assertRaises(case.CaseError):\n            case.discover_notes(duplicate, 13)\n        broken_boundary = case.Document(\"annual\", case.APPLE + \"annual-2024.pdf\",\n                                        case.APPLE + \"annual-2024.txt\", pdf=True)\n        broken_boundary.text = broken_boundary.text.replace(\n            \"Report of Independent Registered\", \"Report marker removed\")\n        with self.assertRaises(case.CaseError):\n            case.discover_notes(broken_boundary, 13)\n\n    def test_anchor_quote_hash_and_metadata_revalidation_reject_mutations(self):\n        mutated = copy.deepcopy(self.case_data)\n        anchor = mutated[\"notes\"][0][\"anchor\"]\n        anchor[\"quote\"] = anchor[\"quote\"] + \" altered\"\n        with self.assertRaises(case.CaseError):\n            case.validate_anchors(mutated)\n\n        mutated = copy.deepcopy(self.case_data)\n        anchor = mutated[\"notes\"][0][\"anchor\"]\n        anchor[\"extraction_sha256\"] = \"0\" * 64\n        with self.assertRaises(case.CaseError):\n            case.validate_anchors(mutated)\n\n        mutated = copy.deepcopy(self.case_data)\n        mutated[\"observations\"][0][\"displayed_literal\"] = \"1\"\n        with self.assertRaises(case.CaseError):\n            case.validate_case(mutated)\n\n    def test_context_scale_sign_and_measurement_substitutions_reject(self):\n        assets = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.assets\"])\n        liabilities = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.liabilities\"])\n        equity = copy.deepcopy(self.by_id[\"annual.bs.2024-09-28.equity\"])\n\n        wrong_scale = copy.deepcopy(assets)\n        wrong_scale[\"scale\"] = 9\n        with self.assertRaises(case.CaseError):\n            case.validate_value(wrong_scale)\n\n        wrong_sign = copy.deepcopy(assets)\n        wrong_sign[\"value_usd\"] = \"-364980000000\"\n        with self.assertRaises(case.CaseError):\n            case.validate_value(wrong_sign)\n\n        wrong_perimeter = copy.deepcopy(equity)\n        wrong_perimeter[\"context\"][\"perimeter\"] = \"standalone\"\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.perimeter\", \"balance\",\n                           [liabilities, wrong_perimeter], assets)\n\n        fair_value = copy.deepcopy(self.by_id[\"interim.debt.2024-12-28.fair_value\"])\n        current = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_current\"])\n        noncurrent = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_noncurrent\"])\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.measurement\", \"rounded_debt\",\n                           [current, noncurrent], fair_value)\n\n    def test_cash_perimeter_and_revenue_axis_substitutions_reject(self):\n        opening = copy.deepcopy(self.by_id[\"annual.cf.2024.opening\"])\n        closing = copy.deepcopy(self.by_id[\"annual.cf.2024.closing\"])\n        flows = [copy.deepcopy(self.by_id[f\"annual.cf.2024.{k}\"])\n                 for k in (\"operating\", \"investing\", \"financing\")]\n        balance_sheet_cash = copy.deepcopy(self.by_id[\"annual.bs.2023-09-30.cash\"])\n        # 30,737 is the cash-flow opening balance; 29,965 is the prior\n        # balance-sheet cash-only figure.  The latter has the wrong perimeter.\n        self.assertEqual(Fraction(opening[\"displayed_literal\"].replace(\",\", \"\")),\n                         Fraction(30737))\n        self.assertEqual(Fraction(balance_sheet_cash[\"displayed_literal\"].replace(\",\", \"\")),\n                         Fraction(29965))\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.cash.perimeter\", \"cash_flow\",\n                           [balance_sheet_cash] + flows, closing)\n\n        product = [copy.deepcopy(self.by_id[f\"annual.product.2024.{i}\"])\n                   for i in range(5)]\n        product_total = copy.deepcopy(self.by_id[\"annual.revenue.2024\"])\n        self.assertEqual(case.reconcile(\"ok.product\", \"partition\", product,\n                                        product_total, partition=\"product\")[\"status\"],\n                         \"pass\")\n        product[0][\"context\"][\"dimensions\"] = {\n            \"us-gaap:StatementBusinessSegmentsAxis\": \"aapl:AmericasSegmentMember\"\n        }\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.product.axis\", \"partition\", product,\n                           product_total, partition=\"product\")\n\n    def test_inline_fact_context_and_unit_ids_are_required(self):\n        interim = case.Document(\"interim\", case.APPLE + \"interim-2025q1.html\",\n                                case.APPLE + \"interim-2025q1.txt\")\n        reader = case.InlineReader(interim)\n        fact = copy.copy(reader.facts[0])\n        fact[\"contextref\"] = \"missing-context\"\n        with self.assertRaises(case.CaseError):\n            reader.parse(fact)\n        fact = copy.copy(reader.facts[0])\n        fact[\"unitref\"] = \"missing-unit\"\n        with self.assertRaises(case.CaseError):\n            reader.parse(fact)\n\n    def test_rounding_compatibility_and_incompatibility_are_distinct(self):\n        current = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_current\"])\n        noncurrent = copy.deepcopy(self.by_id[\"interim.bs.2024-12-28.debt_noncurrent\"])\n        rounded = copy.deepcopy(self.by_id[\"interim.debt.2024-12-28.rounded\"])\n        passing = case.reconcile(\"ok.rounded\", \"rounded_debt\",\n                                 [current, noncurrent], rounded)\n        self.assertTrue(passing[\"rounding_compatible\"])\n        self.assertFalse(passing[\"displayed_identity\"])\n\n        incompatible = copy.deepcopy(rounded)\n        incompatible[\"displayed_literal\"] = \"95.1\"\n        incompatible[\"value_usd\"] = \"95100000000\"\n        incompatible[\"rounding_interval_usd\"] = case.interval(\n            Fraction(\"95100000000\"), Fraction(\"100000000\"))\n        source = incompatible[\"source_readings\"][0][\"fact\"]\n        source[\"quote\"] = source[\"quote\"].replace(\">94.8<\", \">95.1<\")\n        with self.assertRaises(case.CaseError):\n            case.reconcile(\"bad.rounded\", \"rounded_debt\",\n                           [current, noncurrent], incompatible)\n\n    def test_external_obligations_and_unidentified_histories_remain_explicit(self):\n        external = self.case_data[\"external\"]\n        self.assertTrue(external[\"partIII_and_package_obligations\"])\n        self.assertTrue(any(\"proxy\" in x.get(\"target\", \"\").lower()\n                            for x in external[\"partIII_and_package_obligations\"]))\n        self.assertTrue(any(x.get(\"contents_status\") ==\n                            \"internal_target_missing_in_retained_html\"\n                            for x in external[\"exhibit_inventory\"]))\n        views = case.version_view(self.case_data[\"filing_availability\"],\n                                  \"2024-11-01\", scope=\"retained_bytes\")\n        self.assertEqual({x[\"availability\"] for x in views[\"versions\"]},\n                         {\"unknown\"})\n        self.assertEqual(\n            {x[\"status\"] for x in self.case_data[\"unidentified_histories\"]},\n            {\"not_identified\"},\n        )\n        self.assertEqual(\n            self.case_data[\"representation_comparison\"][\"whole_document_equivalence\"],\n            False,\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
