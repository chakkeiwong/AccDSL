{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat docs/design/fixtures/borrowing.acc docs/design/spec/core-0.lark'","aggregated_output":"module BorrowingExample version \"1\";\nuse DemoDebt version \"1\";\nsource note7 = external(\"synthetic-note-7\");\nentity Acme functional USD;\nbook Local entity Acme basis DemoDebt version \"1\";\naccount Cash : Asset book Local;\naccount Debt : Liability book Local;\naccount InterestExpense : Expense book Local;\naccount Retained : Equity book Local;\nopening after2025 for Local from external(\"after-2025-close\");\nobservation debt : Money<USD> instant @2025-12-31 = 100 USD from note7;\nsymbol alpha : Real in [0, 1] because \"Fixed-rate proportion not disclosed\";\ncontract loans : DebtMix book Local {\n  principal = value(debt);\n  fixed_fraction = alpha;\n  fixed_rate = 0.05 per year;\n  initial_floating_rate = 0.05 per year;\n}\nalternative allFixed { assume alpha == 1; }\nalternative allFloating { assume alpha == 0; }\nscenario rateShock { set market_rate = constant(0.07 per year); }\nreport statements for Local { mapping = external(\"DemoDebt.statements.v1\"); }\n// Normative Core 0 syntax, Lark EBNF. UTF-8 input; ASCII identifiers.\n// Longest token wins; keywords cannot be declaration identifiers.\nstart: \"module\" NAME \"version\" STRING \";\" declaration*\n?declaration: use | source | entity | book | account | observation | symbol\n            | choice | binding | constraint | alternative | contract | event\n            | rule | scenario | report | opening\nuse: \"use\" NAME \"version\" STRING \";\"\nsource: \"source\" NAME \"=\" expr \";\"\nentity: \"entity\" NAME \"functional\" NAME \";\"\nbook: \"book\" NAME \"entity\" NAME \"basis\" NAME \"version\" STRING \";\"\naccount: \"account\" NAME \":\" NAME \"book\" NAME \";\"\nobservation: \"observation\" NAME \":\" type time_spec \"=\" expr \"from\" NAME \";\"\ntime_spec: \"instant\" DATE | \"period\" DATE \"to\" DATE\nsymbol: \"symbol\" NAME \":\" type \"in\" domain \"because\" STRING \";\"\ndomain: \"[\" expr \",\" expr \"]\" | \"{\" expr (\",\" expr)* \"}\"\nchoice: \"choice\" NAME \"in\" \"{\" NAME (\",\" NAME)* \"}\" \"because\" STRING \";\"\nbinding: \"let\" NAME [\":\" type] \"=\" expr \";\"\nconstraint: \"constraint\" NAME \":\" expr \";\"\nalternative: \"alternative\" NAME \"{\" assumption* \"}\"\nassumption: \"assume\" expr \";\"\ncontract: \"contract\" NAME \":\" NAME \"book\" NAME \"{\" field* \"}\"\nfield: NAME \"=\" expr \";\"\nevent: \"event\" NAME \"(\" [parameters] \")\" \"book\" NAME \";\"\nparameters: NAME \":\" type (\",\" NAME \":\" type)*\nrule: \"rule\" NAME \"for\" NAME \"as\" NAME [\"overrides\" NAME (\",\" NAME)*] \"when\" expr \"{\" rule_statement* \"}\"\n?rule_statement: binding | require | post\nrequire: \"require\" expr \";\"\npost: \"post\" \"{\" posting+ \"}\"\nposting: SIDE NAME expr \";\"\nscenario: \"scenario\" NAME \"{\" setting* \"}\"\nsetting: \"set\" NAME \"=\" expr \";\"\nreport: \"report\" NAME \"for\" NAME \"{\" field* \"}\"\nopening: \"opening\" NAME \"for\" NAME \"from\" expr \";\"\ntype: NAME [\"<\" type (\",\" type)* \">\"]\n?expr: disjunction\n?disjunction: conjunction (OR conjunction)*\n?conjunction: comparison (AND comparison)*\n?comparison: sum [COMPARE sum]\n?sum: product (ADD product)*\n?product: unary (MUL unary)*\n?unary: UNARY unary | postfix\n?postfix: atom (\".\" NAME)*\n?atom: number | STRING | DATE | BOOL | call | NAME | \"(\" expr \")\" | array | record\ncall: NAME \"(\" [expr (\",\" expr)*] \")\"\nnumber: NUMBER [NAME | \"per\" \"year\"]\narray: \"[\" [expr (\",\" expr)*] \"]\"\nrecord: \"{\" [record_field (\",\" record_field)*] \"}\"\nrecord_field: NAME \":\" expr\nSIDE: \"debit\" | \"credit\"\nOR: \"or\"\nAND: \"and\"\nUNARY: \"-\" | \"not\"\nCOMPARE: \"==\" | \"!=\" | \"<=\" | \">=\" | \"<\" | \">\"\nADD: \"+\" | \"-\"\nMUL: \"*\" | \"/\"\nBOOL.2: \"true\" | \"false\"\nDATE: /@[0-9]{4}-[0-9]{2}-[0-9]{2}/\nNAME: /[A-Za-z_][A-Za-z0-9_]*/\nNUMBER: /(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?/\nSTRING: /\"(?:[^\"\\\\\\x00-\\x1f]|\\\\(?:[\"\\\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"/\n%import common.WS\n%ignore WS\n%ignore /\\/\\/[^\\n]*/\n","exit_code":0,"status":"completed"}}
