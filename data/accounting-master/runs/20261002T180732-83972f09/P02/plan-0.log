{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport json,hashlib\nfrom pathlib import Path\np=Path('data/financial-report-benchmark/landing/apple/21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42.json');d=json.loads(p.read_text());print('keys',list(d));r=d.get('filings',{}).get('recent',{})\nfor i,f in enumerate(r.get('form',[])):\n if f in ('10-K','10-Q','DEF 14A') and r['filingDate'][i]>='2024-10-01' and r['filingDate'][i]<='2025-02-01':\n  print({k:v[i] for k,v in r.items() if k in ['form','filingDate','acceptanceDateTime','reportDate','accessionNumber','primaryDocument']})\nm=json.loads(Path('docs/design/cases/apple/manifest.json').read_text());reg=json.loads(Path('data/accounting-master/runs/20261002T180732-83972f09/P01/source-work-register.json').read_text())\nfor a,b in [('annual-2024.pdf','apple-2024-annual'),('interim-2025q1.html','apple-2025-q1')]:\n x=next(r for r in reg['records'] if r['document_id']==b);y=next(r for r in m['documents'] if r['id']==a); print(a,'same bytes as P01',x['original_sha256']==y['sha256'])\nprint('landing hash',hashlib.sha256(p.read_bytes()).hexdigest())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
