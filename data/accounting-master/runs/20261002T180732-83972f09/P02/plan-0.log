28\", \"url\": \"https://d18rn0p25nwr6d.cloudfront.net/CIK-0000320193/560c1a67-aab8-4c20-9369-cb0d660daf2f.html\"}, \"historical_byte_vintage\": \"not_established_by_this_inventory\", \"semantic_status\": \"not_annotated\", \"gold_label\": false, \"package_closure\": \"not_established\", \"unresolved\": [\"report-specific entity/perimeter and jurisdiction interpretation\", \"cell and narrative meaning\", \"incorporated source obligations\", \"revision/translation relationships\", \"historical byte-vintage availability\"]}\nresiduals 1\nAPPLE documents [{\"id\": \"annual-2024.pdf\", \"url\": \"https://www.annualreports.com/HostedData/AnnualReportArchive/a/NASDAQ_AAPL_2024.pdf\", \"local_path\": \"docs/design/cases/apple/annual-2024.pdf\", \"sha256\": \"ec74758cd767465362c641cf2fd5d8fedd477aed2bf7f62117e67610435dcb88\", \"access_date\": \"2026-10-02\", \"availability_precision\": \"filing day; exact EDGAR acceptance time not established here\"}, {\"id\": \"interim-2025q1.html\", \"url\": \"https://www.sec.gov/Archives/edgar/data/320193/000032019325000008/aapl-20241228.htm\", \"local_path\": \"docs/design/cases/apple/interim-2025q1.html\", \"sha256\": \"2f7629f0733f75b3155dd52f7ae6a8724468e3cde1a9ce32fbce96d98f1ec27e\", \"access_date\": \"2026-10-02\", \"availability_precision\": \"filing day; exact EDGAR acceptance time not established here\"}]\nNOTES\n{\"id\": \"annual.note.1\", \"number\": 1, \"title\": \"Summary of Significant Accounting Policies\", \"source\": \"annual\", \"start_character\": 160208, \"end_character\": 162656, \"pdf_page\": 37, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Calendar, consolidation and FIFO policy recorded; complete policy-to-rule conversion pending.\", \"internal_note_targets\": [\"1\"]}\n{\"id\": \"annual.note.2\", \"number\": 2, \"title\": \"Revenue\", \"source\": \"annual\", \"start_character\": 162656, \"end_character\": 169452, \"pdf_page\": 37, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Product/service and segment classifications overlap; performance obligations, deferrals, returns and transaction-price models pending.\", \"internal_note_targets\": [\"13\", \"2\"]}\n{\"id\": \"annual.note.3\", \"number\": 3, \"title\": \"Earnings Per Share\", \"source\": \"annual\", \"start_character\": 169452, \"end_character\": 171112, \"pdf_page\": 39, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Dated basic/diluted share denominators retained; dilution calculation unsupported in this marginal stress.\", \"internal_note_targets\": [\"3\"]}\n{\"id\": \"annual.note.4\", \"number\": 4, \"title\": \"Financial Instruments\", \"source\": \"annual\", \"start_character\": 171112, \"end_character\": 184808, \"pdf_page\": 39, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Interest-rate notional and hedge link structured; instrument schedules, valuation and OCI recycling remain unresolved.\", \"internal_note_targets\": [\"4\", \"7\"]}\n{\"id\": \"annual.note.5\", \"number\": 5, \"title\": \"Property, Plant and Equipment\", \"source\": \"annual\", \"start_character\": 184808, \"end_character\": 186313, \"pdf_page\": 41, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Gross/net bridge retained; asset-cohort ages and future depreciation not reconstructed.\", \"internal_note_targets\": [\"5\"]}\n{\"id\": \"annual.note.6\", \"number\": 6, \"title\": \"Consolidated Financial Statement Details\", \"source\": \"annual\", \"start_character\": 186313, \"end_character\": 188540, \"pdf_page\": 42, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Detailed balances retained; component movement models and recognition rules pending.\", \"internal_note_targets\": [\"6\"]}\n{\"id\": \"annual.note.7\", \"number\": 7, \"title\": \"Income Taxes\", \"source\": \"annual\", \"start_character\": 188540, \"end_character\": 201290, \"pdf_page\": 42, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Current/deferred/state-aid effects retained; no tax effect assumed only in the explicitly conditional marginal stress.\", \"internal_note_targets\": [\"4\", \"7\"]}\n{\"id\": \"annual.note.8\", \"number\": 8, \"title\": \"Leases\", \"source\": \"annual\", \"start_character\": 201290, \"end_character\": 206862, \"pdf_page\": 44, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Maturities and policy retained; discounting, modifications and rent forecasts unmodelled.\", \"internal_note_targets\": [\"8\"]}\n{\"id\": \"annual.note.9\", \"number\": 9, \"title\": \"Debt\", \"source\": \"annual\", \"start_character\": 206862, \"end_character\": 212884, \"pdf_page\": 45, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Principal/carrying/fair value and dates separated; rate/reset/hedge state incompletely disclosed.\", \"internal_note_targets\": [\"9\"]}\n{\"id\": \"annual.note.10\", \"number\": 10, \"title\": \"Shareholders\\u2019 Equity\", \"source\": \"annual\", \"start_character\": 212884, \"end_character\": 214227, \"pdf_page\": 47, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Repurchase authorisation is permission, not an obligatory future cash outflow; quantities and reserves retained.\", \"internal_note_targets\": [\"10\"]}\n{\"id\": \"annual.note.11\", \"number\": 11, \"title\": \"Share-Based Compensation\", \"source\": \"annual\", \"start_character\": 214227, \"end_character\": 219919, \"pdf_page\": 47, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Vesting/award terms and cash-tax settlements retained; compensation/dilution simulation unmodelled.\", \"internal_note_targets\": [\"11\"]}\n{\"id\": \"annual.note.12\", \"number\": 12, \"title\": \"Commitments, Contingencies and Supply Concentrations\", \"source\": \"annual\", \"start_character\": 219919, \"end_character\": 223668, \"pdf_page\": 48, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Qualitative/conditional obligations retained; no unsupported numeric haircut or probability.\", \"internal_note_targets\": [\"12\"]}\n{\"id\": \"annual.note.13\", \"number\": 13, \"title\": \"Segment Information and Geographic Data\", \"source\": \"annual\", \"start_character\": 223668, \"end_character\": 230610, \"pdf_page\": 49, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Overlapping product/geography aggregation retained; no cross-axis summation.\", \"internal_note_targets\": [\"13\"]}\n{\"id\": \"interim.note.1\", \"number\": 1, \"title\": \"Summary of Significant Accounting Policies\", \"source\": \"interim\", \"start_character\": 19740, \"end_character\": 21227, \"pdf_page\": null, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Calendar, consolidation and FIFO policy recorded; complete policy-to-rule conversion pending.\", \"internal_note_targets\": [\"1\"]}\n{\"id\": \"interim.note.2\", \"number\": 2, \"title\": \"Revenue\", \"source\": \"interim\", \"start_character\": 21227, \"end_character\": 22673, \"pdf_page\": null, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Product/service and segment classifications overlap; performance obligations, deferrals, returns and transaction-price models pending.\", \"internal_note_targets\": [\"10\", \"2\"]}\n{\"id\": \"interim.note.3\", \"number\": 3, \"title\": \"Earnings Per Share\", \"source\": \"interim\", \"start_character\": 22673, \"end_character\": 23258, \"pdf_page\": null, \"disposition\": \"retained_with_specific_obligation\", \"modelling_obligation\": \"Dated basic/diluted share denominators retained; dilution calculation unsupported in this marginal stress.\", \"internal_note_targets\": [\"3\"]}\n{\"id\": \"interim.note.4\