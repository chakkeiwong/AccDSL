apl4359751-def14a.htm'}\n{'accessionNumber': '0000320193-24-000123', 'filingDate': '2024-11-01', 'reportDate': '2024-09-28', 'acceptanceDateTime': '2024-11-01T14:01:36.000Z', 'form': '10-K', 'primaryDocument': 'aapl-20240928.htm'}\nannual-2024.pdf same bytes as P01 True\ninterim-2025q1.html same bytes as P01 True\nlanding hash 21eae1adf76b91a72eab511c0a96cd56f2053878b8c22df5bfdbfdbb0adfcc42\n","exit_code":0,"status":"completed"}}
