{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "const": "RetainedCompanyProgramDraft/1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "opening_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "packet_sha256",
        "opening_sha256"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "book_role": {
          "const": "legal"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity",
        "book_role",
        "currency",
        "case_id"
      ],
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end_exclusive": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start",
        "end_exclusive"
      ],
      "additionalProperties": false
    },
    "return_module_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "implementation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "implementation_sha256"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_pointer": {
            "type": "string",
            "minLength": 1
          },
          "event_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "review_findings": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "const": "unknown"
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "source_pointer",
          "event_sha256",
          "capability",
          "review_findings"
        ],
        "additionalProperties": false
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "const": "ReturnLegalAnnualReport/1"
        }
      },
      "required": [
        "capability",
        "method"
      ],
      "additionalProperties": false
    },
    "carry": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "next_end_exclusive": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "capability",
        "next_end_exclusive"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "name",
    "source",
    "context",
    "period",
    "return_module_sha256",
    "capabilities",
    "events",
    "report",
    "carry"
  ],
  "additionalProperties": false
}
